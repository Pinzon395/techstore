# ════════════════════════════════════════
#  .gitignore — Pixon PC
# ════════════════════════════════════════

# Dependencias Node
node_modules/

# Build de producción (se genera con npm run build)
dist/

# Base de datos SQLite — NO subir al repositorio
# (tiene datos de clientes: comentarios reales)
server/pixon.db
server/pixon.db-wal
server/pixon.db-shm

# Variables de entorno (si se añaden en el futuro)
.env
.env.local
.env.production

# Logs
*.log
npm-debug.log*

# Editor
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# Vite cache
.vite/
