# /etc/cloudflared/config.yml - do not commit the real tunnel credentials.
tunnel: REPLACE_WITH_VPS_TUNNEL_ID
credentials-file: /etc/cloudflared/REPLACE_WITH_VPS_TUNNEL_ID.json
ingress:
  - hostname: pixon.com.mx
    service: http://127.0.0.1:3000
  - hostname: www.pixon.com.mx
    service: http://127.0.0.1:3000
  - service: http_status:404
