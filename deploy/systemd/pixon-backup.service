[Unit]
Description=Pixon PC encrypted database and persistent-file backup
After=pixon.service mariadb.service

[Service]
Type=oneshot
User=pixon
Group=pixon
WorkingDirectory=/opt/pixon/current
EnvironmentFile=/opt/pixon/shared/.env
Environment=DATA_DIR=/opt/pixon/shared/data
ExecStart=/bin/bash scripts/hosting/backup-production.sh
Nice=10
