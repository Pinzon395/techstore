[Unit]
Description=Pixon PC offsite backup sync (no-op until R2_BACKUP_BUCKET is set)
After=pixon-backup.service

[Service]
Type=oneshot
User=pixon
Group=pixon
WorkingDirectory=/opt/pixon/current
EnvironmentFile=/opt/pixon/shared/.env
Environment=DATA_DIR=/opt/pixon/shared/data
ExecStart=/bin/bash scripts/hosting/backup-offsite-sync.sh
Nice=10
