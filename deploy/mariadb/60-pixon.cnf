# Copy to /etc/mysql/mariadb.conf.d/60-pixon.cnf only after checking the
# Hostinger image defaults. Conservative starting point for KVM 2 (8 GB RAM).
[mariadbd]
bind-address = 127.0.0.1
max_connections = 80
innodb_buffer_pool_size = 1G
innodb_buffer_pool_instances = 1
innodb_log_file_size = 256M
tmp_table_size = 32M
max_heap_table_size = 32M
skip-name-resolve
