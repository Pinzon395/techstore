{
  "name": "pixon-pc",
  "version": "2.1.0",
  "description": "Pixon PC — Técnico en Reparaciones Cancún. Sitio web + API MariaDB.",
  "scripts": {
    "dev": "cross-env PORT=3001 nodemon --watch server server/server.js",
    "dev:vite": "vite",
    "build": "vite build && node tools/generate-webp.mjs",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production node server/server.js",
    "test:navbar:visual": "playwright test tests/navbar-visual.spec.mjs --reporter=list",
    "test:navbar:debug": "playwright test tests/navbar-visual.spec.mjs --debug",
    "migrate:legacy": "node server/migrate-to-mariadb.js"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.4.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "isomorphic-dompurify": "^3.12.0",
    "lenis": "^1.3.23",
    "mysql2": "^3.22.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/node": "^10.1.0",
    "@playwright/test": "^1.59.1",
    "astro": "^6.3.1",
    "better-sqlite3": "^12.9.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14",
    "sharp": "^0.34.5",
    "svgo": "^4.0.1",
    "typescript": "^6.0.3",
    "vite": "^5.2.0",
    "vite-plugin-image-optimizer": "^2.0.3"
  }
}
