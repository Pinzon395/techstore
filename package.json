{
  "name": "pixon-pc",
  "version": "2.0.0",
  "description": "Pixon PC — Técnico en Reparaciones Cancún. Sitio web + API SQLite.",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/server.js",
    "dev:all": "concurrently -n VITE,API -c blue,green \"vite\" \"node server/server.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production node server/server.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "sharp": "^0.34.5",
    "svgo": "^4.0.1",
    "vite": "^5.2.0",
    "vite-plugin-image-optimizer": "^2.0.3"
  },
  "optionalDependencies": {
    "@better-sqlite3/windows-x64-msvc": "npm:null@*"
  }
}
