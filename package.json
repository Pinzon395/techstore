{
  "name": "pixon-pc",
  "version": "2.1.0",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20.0.0 <=22.x",
    "npm": ">=10.0.0"
  },
  "description": "Pixon PC - Técnico en reparaciones Cancún. Sitio web + API MariaDB.",
  "scripts": {
    "setup:local": "npm ci && npm run build",
    "dev": "cross-env PORT=3001 NODE_ENV=development nodemon --watch server server/server.js",
    "dev:astro": "astro dev",
    "check:encoding": "node scripts/check-encoding.js",
    "check:claims": "node tools/check-commercial-claims.mjs",
    "check:repair-pricing": "node tools/audit-repair-pricing.mjs",
    "check:i18n": "node tools/check-i18n-coverage.mjs",
    "check:db-encoding": "node scripts/check-db-encoding.js",
    "check:service-seo": "node tools/audit-service-seo.mjs",
    "check:service-mobile": "node tools/audit-service-mobile.mjs",
    "check:service-visual": "node tools/audit-service-css-screenshots.mjs final",
    "check:all-pages": "node tools/audit-all-pages.mjs",
    "check:inline-handlers": "node tools/audit-inline-handlers.mjs",
    "check:inline-styles": "node tools/audit-built-inline-styles.mjs",
    "check:links": "node tools/audit-internal-links.mjs",
    "check:indexation": "node tools/audit-indexation.mjs",
    "check:jsonld": "node tools/validate-jsonld.mjs",
    "check:images": "node tools/audit-image-weight.mjs",
    "check:images:inventory": "node tools/audit-image-inventory.mjs",
    "check:performance": "node tools/check-performance.mjs",
    "measure:cls": "node tools/measure-cls.mjs",
    "check": "node tools/audit-image-weight.mjs && npm run build && node tools/audit-built-csp.mjs",
    "verify": "npm run typecheck && npm run test:db:infra && npm run test:commerce && npm run test:appointments && npm run check && npm run check:jsonld && npm run check:repair-pricing && npm run check:indexation && npm run check:links && npm run check:all-pages && node tools/check-performance-guardrail.mjs",
    "check:release": "npm run typecheck && npm run test:db:infra && npm run test:commerce && npm run test:appointments && npm run test:admin-agenda-unit && npm run check:admin-ui && npm run build && npm run check:indexation && npm run check:jsonld && npm run check:repair-pricing && npm run check:links && npm run check:all-pages && npm run check:i18n && npm run check:claims",
    "typecheck": "astro check",
    "lint": "node scripts/check-encoding.js && node tools/check-i18n-coverage.mjs && node tools/audit-inline-handlers.mjs",
    "prebuild": "node scripts/check-encoding.js",
    "build": "node tools/generate-version.mjs && astro build && node tools/externalize-inline-js.mjs && node tools/fingerprint-admin-assets.mjs && node tools/prune-sibling-view-css.mjs && node tools/generate-sitemap.mjs && node tools/generate-webp.mjs",
    "fix": "node scripts/check-encoding.js --fix",
    "fix:encoding": "node scripts/check-encoding.js --fix",
    "preview": "astro preview",
    "start": "node server/server.js",
    "start:3001": "cross-env NODE_ENV=production PORT=3001 node server/server.js",
    "test:navbar:visual": "playwright test tests/navbar-visual.spec.mjs --reporter=list",
    "test:navbar:debug": "playwright test tests/navbar-visual.spec.mjs --debug",
    "migrate:legacy": "node server/migrate-to-mariadb.js",
    "monitor": "node server/monitor.js",
    "start:monitor": "node server/start-with-monitor.js",
    "backup:db": "node server/monitor.js --backup",
    "db:snapshot": "node scripts/db/snapshot-git.mjs",
    "db:snapshot:check": "node scripts/db/check-snapshot.mjs",
    "db:restore": "node scripts/db/restore-snapshot.mjs",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:migrate:plan": "node scripts/db/migrate.mjs --plan",
    "db:migrate:verify": "node scripts/db/migrate.mjs --verify",
    "db:commerce:verify": "node scripts/db/verify-commerce-schema.mjs",
    "db:backup:encrypted": "node scripts/db/backup-encrypted.mjs",
    "db:backup:verify": "node scripts/db/verify-backup.mjs",
    "db:backup:rekey": "node scripts/db/rekey-backup.mjs",
    "db:backup:restore": "node scripts/db/restore-encrypted.mjs",
    "preflight:linux": "node scripts/hosting/preflight-linux.mjs",
    "inventory:hosting": "node scripts/hosting/inventory.mjs",
    "test:hosting:restore": "node scripts/hosting/backup-restore-drill.mjs",
    "backup:production": "bash scripts/hosting/backup-production.sh",
    "deploy:production": "bash scripts/hosting/deploy-production.sh",
    "deploy:cf": "node tools/deploy-cloudflare.mjs",
    "deploy:cf:dry": "node tools/deploy-cloudflare.mjs --dry-run",
    "verify:prod": "node tools/verify-production-deploy.mjs",
    "db:test:setup": "cross-env NODE_ENV=test node scripts/db/setup-test-db.mjs --destructive",
    "test:db:infra": "node --test scripts/db/tests/migration-core.test.mjs scripts/db/tests/backup-format.test.mjs server/routes/health.routes.test.js",
    "test:commerce": "node --test server/modules/commerce/tests/domain.test.js server/modules/commerce/tests/infrastructure.test.js server/modules/commerce/tests/media.test.js server/modules/commerce/tests/money.test.js server/modules/commerce/tests/orders.test.js server/modules/commerce/tests/validation.test.js",
    "test:appointments": "node --test server/modules/appointments/tests/appointments.test.js",
    "test:admin-agenda-unit": "node --test tests/admin-agenda-ticket.test.mjs",
    "check:admin-ui": "node tools/audit-admin-ui-classes.mjs",
    "test:policy": "node --test tests/business-policy.test.mjs server/tests/locale-paths.test.js tests/english-commerce-gpu.test.mjs",
    "test:commerce:e2e": "cross-env NODE_ENV=test node scripts/e2e/commerce-real.mjs",
    "setup:git-hooks": "git config core.hooksPath .githooks",
    "preflight:production": "node tools/production-preflight.mjs",
    "release:build": "node tools/build-release.mjs",
    "smoke:postdeploy": "node tools/postdeploy-smoke.mjs",
    "e2e:admin": "node tools/e2e-admin-production.mjs",
    "e2e:calendar": "node tools/e2e-calendar-production.mjs"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.4.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "isomorphic-dompurify": "^3.12.0",
    "mysql2": "^3.24.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/node": "^10.1.0",
    "@playwright/test": "^1.59.1",
    "astro": "^6.3.1",
    "better-sqlite3": "^12.9.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14",
    "sharp": "^0.34.5",
    "svgo": "^4.0.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "body-parser": "1.20.8",
    "dompurify": "3.4.16",
    "esbuild": "0.28.1",
    "ip-address": "10.7.3",
    "undici": "7.30.0",
    "yaml": "2.8.3",
    "yaml-language-server": "1.23.0",
    "qs": "6.16.0",
    "mysql2": "$mysql2"
  }
}
