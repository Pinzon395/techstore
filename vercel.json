{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/reparaciones", "destination": "/pages/servicios/reparaciones.html" },
    { "source": "/reparacion-bisagras", "destination": "/pages/servicios/reparacion-bisagras.html" },
    { "source": "/reparacion-controles", "destination": "/pages/servicios/reparacion-controles.html" },
    { "source": "/ensambles", "destination": "/pages/servicios/ensambles.html" },
    { "source": "/mantenimiento-mac", "destination": "/pages/servicios/mantenimiento-mac.html" },
    { "source": "/formateo-optimizacion", "destination": "/pages/servicios/formateo-optimizacion.html" },
    { "source": "/optimizacion", "destination": "/pages/servicios/optimizacion.html" },
    { "source": "/paquetes", "destination": "/pages/servicios/paquetes.html" },
    { "source": "/catalogo", "destination": "/pages/info/catalogo.html" },
    { "source": "/contacto", "destination": "/pages/info/contacto.html" },
    { "source": "/comentarios", "destination": "/pages/info/comentarios.html" },
    { "source": "/preguntas-frecuentes", "destination": "/pages/info/preguntas-frecuentes.html" },
    { "source": "/privacidad", "destination": "/pages/legal/privacidad.html" },
    { "source": "/garantia", "destination": "/pages/legal/garantia.html" },
    { "source": "/admin", "destination": "/pages/admin/admin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
