{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/formateo-optimizacion", "destination": "/optimizacion", "permanent": true }
  ],
  "rewrites": [
    { "source": "/reparaciones", "destination": "/pages/servicios/reparaciones.html" },
    { "source": "/reparacion-bisagras", "destination": "/pages/servicios/reparacion-bisagras.html" },
    { "source": "/reparacion-controles", "destination": "/pages/servicios/reparacion-controles.html" },
    { "source": "/instalacion-windows", "destination": "/pages/servicios/instalacion-windows.html" },
    { "source": "/ensambles", "destination": "/pages/servicios/ensambles.html" },
    { "source": "/mantenimiento-mac", "destination": "/pages/servicios/mantenimiento-mac.html" },
    { "source": "/optimizacion", "destination": "/pages/servicios/optimizacion.html" },
    { "source": "/paquetes", "destination": "/pages/servicios/paquetes.html" },
    { "source": "/catalogo", "destination": "/pages/info/catalogo.html" },
    { "source": "/contacto", "destination": "/pages/info/contacto.html" },
    { "source": "/comentarios", "destination": "/pages/info/comentarios.html" },
    { "source": "/preguntas-frecuentes", "destination": "/pages/info/preguntas-frecuentes.html" },
    { "source": "/privacidad", "destination": "/pages/legal/privacidad.html" },
    { "source": "/garantia", "destination": "/pages/legal/garantia.html" },
    { "source": "/admin", "destination": "/pages/admin/admin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, s-maxage=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(reparaciones|reparacion-bisagras|reparacion-controles|instalacion-windows|ensambles|mantenimiento-mac|optimizacion|paquetes|catalogo|contacto|comentarios|preguntas-frecuentes|privacidad|garantia)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, s-maxage=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/cache-buster.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml|llms.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/(favicon.png|apple-touch-icon.png|LOGOCIRCULAR.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/styles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/scripts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
