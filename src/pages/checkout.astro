---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import storeCss from '../styles/store.css?url';
---
<Base title="Checkout | Pixon PC" description="Confirma tus datos y método de pago para crear tu pedido Pixon PC." canonical="https://pixon.com.mx/checkout" robots="noindex, nofollow" extraStyles={[storeCss]} preloadSprite={true}>
  <Navbar />
  <main class="store-page private-commerce-page checkout-page">
    <div class="store-shell"><Breadcrumb items={[{ label: 'Carrito', href: '/carrito' }, { label: 'Checkout' }]} /></div>
    <section class="store-shell" aria-labelledby="checkout-title">
      <header class="checkout-header"><p class="store-section-label">Pedido Pixon PC</p><h1 id="checkout-title">Confirma tu compra</h1><ol class="checkout-stepper" aria-label="Progreso"><li class="is-done">Carrito</li><li class="is-active">Datos</li><li>Pago</li><li>Confirmación</li></ol></header>
      <form id="checkout-form" class="checkout-layout" novalidate>
        <div class="checkout-form-card">
          <fieldset><legend>Datos de contacto</legend><div class="checkout-fields"><label><span>Nombre completo *</span><input name="name" autocomplete="name" maxlength="120" required /></label><label><span>Teléfono *</span><input name="phone" type="tel" autocomplete="tel" maxlength="24" required /></label><label class="span-2"><span>Correo electrónico *</span><input name="email" type="email" autocomplete="email" maxlength="190" required /></label></div></fieldset>
          <fieldset><legend>Entrega</legend><div class="checkout-options"><label><input type="radio" name="delivery_method" value="PICKUP" checked /><span><strong>Recoger en Pixon PC</strong><small>Cto. Hacienda Chimay, 77539 Cancún, Q.R.</small></span></label><label><input type="radio" name="delivery_method" value="LOCAL_DELIVERY" /><span><strong>Entrega local</strong><small>Coordinaremos cobertura y costo antes de preparar.</small></span></label><label><input type="radio" name="delivery_method" value="SERVICE_ON_SITE" /><span><strong>Servicio en sitio</strong><small>Disponible solo para servicios compatibles.</small></span></label></div><label class="checkout-note"><span>Notas de entrega</span><textarea name="delivery_note" maxlength="1000" rows="3"></textarea></label></fieldset>
          <fieldset><legend>Método de pago</legend><div class="checkout-options" id="checkout-payment-methods"><div class="cart-skeleton"></div></div><label class="checkout-note"><span>Cupón de descuento</span><input name="coupon_codes" autocomplete="off" maxlength="160" aria-describedby="checkout-coupon-help" placeholder="Ej. PIXON10" /><small id="checkout-coupon-help">Si tienes más de uno, sepáralos con coma. El servidor validará vigencia, prioridad y acumulación.</small></label></fieldset>
          <div class="checkout-message" id="checkout-message" role="alert" hidden></div>
        </div>
        <aside class="cart-summary checkout-summary"><h2>Tu pedido</h2><div id="checkout-items"></div><dl><div><dt>Subtotal</dt><dd id="checkout-subtotal">$0.00</dd></div><div><dt>Descuento estimado</dt><dd id="checkout-discount">-$0.00</dd></div><div class="cart-total"><dt>Total estimado</dt><dd id="checkout-total">$0.00</dd></div></dl><p>El servidor recalcula los importes y reserva inventario al confirmar.</p><button class="store-action store-action-primary" id="checkout-submit" type="submit">Crear pedido</button><a class="store-action store-action-secondary" href="/carrito">Volver al carrito</a></aside>
      </form>
    </section>
  </main>
  <Footer />
  <script src="/scripts/store-cart.js?v=20260812-1" is:inline defer></script>
  <script src="/scripts/checkout.js?v=20260812-2" is:inline defer></script>
</Base>
