---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/store/CartDrawer.astro';
import storeCss from '../styles/store.css?url';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': 'https://pixon.com.mx/tienda#webpage',
    name: 'Tienda de tecnología y servicios técnicos en Cancún | Pixon PC',
    description: 'Catálogo de equipos, hardware, servicios técnicos y paquetes de Pixon PC en Cancún.',
    url: 'https://pixon.com.mx/tienda',
    isPartOf: { '@id': 'https://pixon.com.mx/#website' },
    about: { '@id': 'https://pixon.com.mx/#business' },
    mainEntity: {
      '@type': 'OfferCatalog',
      name: 'Catálogo comercial Pixon PC',
      itemListOrder: 'https://schema.org/ItemListOrderDescending',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://pixon.com.mx/' },
      { '@type': 'ListItem', position: 2, name: 'Tienda', item: 'https://pixon.com.mx/tienda' },
    ],
  },
];
---

<Base
  title="Tienda de computadoras, hardware y servicios en Cancún | Pixon PC"
  description="Explora equipos, hardware, servicios técnicos y paquetes publicados por Pixon PC en Cancún. Consulta disponibilidad, condición y precio desde un catálogo actualizado."
  canonical="https://pixon.com.mx/tienda"
  image="/assets/images/tienda-hero-pixon.webp"
  ogTitle="Tienda Pixon PC | Equipos, hardware y servicios en Cancún"
  ogDescription="Publicaciones reales de tecnología y servicio técnico en Cancún, con precio, condición y disponibilidad visibles."
  schema={schema}
  extraStyles={[storeCss]}
  preloadSprite={true}
>
  <Navbar />

  <main class="store-page store-marketplace" aria-labelledby="catalog-title">
    <section class="store-catalog" id="catalogo-tienda" aria-labelledby="catalog-title">
      <div class="store-shell">
        <header class="store-catalog-header-bar">
          <div class="store-catalog-heading">
            <h1 id="catalog-title" tabindex="-1">Catálogo Pixon PC</h1>
            <p>Equipos, componentes y servicios técnicos en Cancún con disponibilidad y precios verificados.</p>
          </div>
          <div class="store-search-bar">
            <div class="store-search-field">
              <label for="store-search" class="sr-only">Buscar en la tienda</label>
              <div class="store-input-wrap">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <input id="store-search" name="q" type="search" autocomplete="off" maxlength="120" placeholder="Buscar laptops, componentes, SSD, servicios..." aria-autocomplete="list" aria-controls="store-suggestions" aria-expanded="false" />
                <div class="store-suggestions" id="store-suggestions" role="listbox" hidden></div>
              </div>
            </div>
            <button class="store-filter-toggle" id="store-filter-toggle" type="button" aria-expanded="false" aria-controls="store-filters">
              <i class="fa-solid fa-sliders" aria-hidden="true"></i>
              <span>Filtros</span>
            </button>
          </div>
        </header>

        <div class="store-catalog-layout">
          <aside class="store-catalog-sidebar" aria-label="Filtros del catálogo">
            <form class="store-filters" id="store-filters" aria-label="Filtrar publicaciones" novalidate>
              <div class="store-filters-top">
                <span class="store-filters-heading"><i class="fa-solid fa-sliders" aria-hidden="true"></i> Filtros</span>
                <button class="store-clear-filters" id="store-clear-filters" type="button">
                  <i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Limpiar
                </button>
              </div>

              <fieldset class="store-check-group">
                <legend><i class="fa-solid fa-shapes" aria-hidden="true"></i> Tipo</legend>
                <label class="store-check-option"><input type="checkbox" data-filter-group="type" value="PRODUCT" /><span>Productos</span></label>
                <label class="store-check-option"><input type="checkbox" data-filter-group="type" value="EQUIPMENT" /><span>Equipos completos</span></label>
                <label class="store-check-option"><input type="checkbox" data-filter-group="type" value="HARDWARE" /><span>Hardware / Partes</span></label>
                <label class="store-check-option"><input type="checkbox" data-filter-group="type" value="SERVICE" /><span>Servicios técnicos</span></label>
                <label class="store-check-option"><input type="checkbox" data-filter-group="type" value="BUNDLE" /><span>Paquetes</span></label>
                <select id="store-type" name="type" class="store-filter-source" tabindex="-1" aria-hidden="true">
                  <option value="">Todos</option>
                  <option value="EQUIPMENT">Equipos</option>
                  <option value="HARDWARE">Hardware</option>
                  <option value="PRODUCT">Productos</option>
                  <option value="SERVICE">Servicios</option>
                  <option value="BUNDLE">Paquetes</option>
                </select>
              </fieldset>

              <fieldset class="store-check-group">
                <legend><i class="fa-solid fa-certificate" aria-hidden="true"></i> Condición</legend>
                <label class="store-check-option"><input type="checkbox" data-filter-group="condition" value="NEW" /><span>Nuevo</span></label>
                <label class="store-check-option"><input type="checkbox" data-filter-group="condition" value="USED" /><span>Usado garantizado</span></label>
                <label class="store-check-option"><input type="checkbox" data-filter-group="condition" value="REFURBISHED" /><span>Reacondicionado</span></label>
                <label class="store-check-option"><input type="checkbox" data-filter-group="condition" value="OPEN_BOX" /><span>Caja abierta</span></label>
                <label class="store-check-option"><input type="checkbox" data-filter-group="condition" value="FOR_PARTS" /><span>Para refacciones</span></label>
                <select id="store-condition" name="condition" class="store-filter-source" tabindex="-1" aria-hidden="true">
                  <option value="">Cualquiera</option>
                  <option value="NEW">Nuevo</option>
                  <option value="USED">Usado</option>
                  <option value="REFURBISHED">Reacondicionado</option>
                  <option value="OPEN_BOX">Caja abierta</option>
                  <option value="FOR_PARTS">Para refacciones</option>
                  <option value="NOT_APPLICABLE">No aplica</option>
                </select>
              </fieldset>

              <fieldset class="store-check-group">
                <legend><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Disponibilidad</legend>
                <label class="store-check-option"><input type="checkbox" data-filter-group="availability" value="AVAILABLE" /><span>En stock Cancún</span></label>
                <label class="store-check-option"><input type="checkbox" data-filter-group="availability" value="UNAVAILABLE" /><span>Agotado / Pedido</span></label>
                <select id="store-availability" name="availability" class="store-filter-source" tabindex="-1" aria-hidden="true">
                  <option value="">Todas</option>
                  <option value="AVAILABLE">Disponible</option>
                  <option value="UNAVAILABLE">No disponible</option>
                </select>
              </fieldset>

              <label class="store-filter-field">
                <span><i class="fa-solid fa-tag" aria-hidden="true"></i> Marca</span>
                <input id="store-brand" name="brand" type="text" maxlength="100" placeholder="Ej. Lenovo, Asus, Kingston..." />
              </label>

              <div class="store-price-fields">
                <label class="store-filter-field">
                  <span>Precio mín</span>
                  <input id="store-min-price" name="minPrice" type="number" min="0" step="0.01" inputmode="decimal" placeholder="$ Mín" />
                </label>
                <label class="store-filter-field">
                  <span>Precio máx</span>
                  <input id="store-max-price" name="maxPrice" type="number" min="0" step="0.01" inputmode="decimal" placeholder="$ Máx" />
                </label>
              </div>

              <label class="store-filter-field">
                <span><i class="fa-solid fa-arrow-down-wide-short" aria-hidden="true"></i> Ordenar</span>
                <select id="store-sort" name="sort">
                  <option value="newest">Más recientes</option>
                  <option value="price_asc">Menor precio</option>
                  <option value="price_desc">Mayor precio</option>
                  <option value="name">Nombre A–Z</option>
                </select>
              </label>
            </form>
          </aside>

          <div class="store-results-column">
            <div class="store-category-row" id="store-category-row" aria-label="Categorías del catálogo">
              <button type="button" class="store-category-chip is-active" data-category="" aria-pressed="true">Todas las categorías</button>
            </div>

            <aside class="store-promotion-banner" id="store-promotion-banner" hidden>
              <div><span>Promoción vigente</span><strong id="store-promotion-title"></strong><p id="store-promotion-text"></p></div>
              <a href="/tienda/promociones">Ver promociones</a>
            </aside>

            <div class="store-results-bar">
              <p id="store-result-summary" aria-live="polite">Preparando catálogo…</p>
              <p class="store-live-note"><span aria-hidden="true"></span> Información consultada desde el catálogo</p>
            </div>

            <div class="store-state" id="store-loading" role="status" hidden>
              <span class="store-spinner" aria-hidden="true"></span>
              <p>Cargando publicaciones…</p>
            </div>

            <div class="store-state store-state-error" id="store-error" role="alert" hidden>
              <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
              <h3>No pudimos consultar el catálogo</h3>
              <p>La información no está disponible en este momento. Intenta de nuevo o escríbenos para confirmar existencias.</p>
              <button type="button" id="store-retry">Intentar de nuevo</button>
            </div>

            <div class="store-state" id="store-empty" hidden>
              <i class="fa-solid fa-box-open" aria-hidden="true"></i>
              <h3>No hay publicaciones con esos filtros</h3>
              <p>Prueba otra búsqueda o cuéntanos qué equipo, componente o servicio necesitas.</p>
              <div class="store-empty-actions">
                <button type="button" id="store-empty-clear">Ver todo el catálogo</button>
                <a href="https://wa.me/529986690777?text=Hola%20Pixon%20PC%2C%20no%20encontr%C3%A9%20lo%20que%20busco%20en%20la%20tienda." target="_blank" rel="noopener noreferrer">Consultar por WhatsApp</a>
              </div>
            </div>

            <div class="store-product-grid" id="store-product-grid" aria-live="polite"></div>

            <noscript>
              <div class="store-state">
                <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                <h3>Activa JavaScript para consultar el catálogo actualizado</h3>
                <p>También puedes confirmar publicaciones y disponibilidad directamente con Pixon PC.</p>
                <div class="store-empty-actions">
                  <a href="https://wa.me/529986690777?text=Hola%20Pixon%20PC%2C%20quiero%20consultar%20el%20cat%C3%A1logo%20de%20la%20tienda." target="_blank" rel="noopener noreferrer">Consultar por WhatsApp</a>
                  <a href="/contacto">Ir a contacto</a>
                </div>
              </div>
            </noscript>

            <nav class="store-pagination" id="store-pagination" aria-label="Paginación del catálogo" hidden>
              <button type="button" id="store-prev-page"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Anterior</button>
              <span id="store-page-label">Página 1</span>
              <button type="button" id="store-next-page">Siguiente <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
            </nav>
          </div>
        </div>
      </div>
    </section>
  </main>

  <dialog class="store-detail-dialog" id="store-detail-dialog" aria-labelledby="store-dialog-title">
    <div class="store-dialog-shell">
      <button class="store-dialog-close" id="store-dialog-close" type="button" aria-label="Cerrar detalle"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
      <h2 class="store-dialog-status-title" id="store-dialog-title">Detalle de la publicación</h2>
      <div id="store-dialog-content">
        <div class="store-state" role="status"><span class="store-spinner" aria-hidden="true"></span><p>Cargando detalle…</p></div>
      </div>
    </div>
  </dialog>

  <CartDrawer showLauncher={true} />
  <Footer />
  <script src="/scripts/store-cart.js?v=20260912-2" is:inline defer></script>
  <script src="/scripts/store.js?v=20260912-2" is:inline defer></script>
</Base>
