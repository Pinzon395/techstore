---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<Base
  title="Opiniones y Reseñas de Clientes | Pixon PC Cancún"
  description="Opiniones y reseñas reales de clientes de Pixon PC Cancún. Deja tu comentario sobre el servicio de reparación de computadoras y laptops. +300 clientes satisfechos."
  canonical="https://pixon.com.mx/comentarios"
  image="/LOGOCIRCULAR.png"
  schema={[
    {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "@id": "https://pixon.com.mx/#business",
        "name": "Pixon PC",
        "url": "https://pixon.com.mx",
        "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "5.0",
            "reviewCount": "9",
            "bestRating": "5",
            "worstRating": "1"
        },
        "review": [
            {
                "@type": "Review",
                "author": {
                    "@type": "Person",
                    "name": "Fred Uriostegui"
                },
                "datePublished": "2025-05-08",
                "reviewRating": {
                    "@type": "Rating",
                    "ratingValue": "4.5",
                    "bestRating": "5",
                    "worstRating": "1"
                },
                "reviewBody": "Muy buen servicio, reparación entregada a tiempo y de forma correcta.",
                "inLanguage": "es",
                "publisher": {
                    "@type": "Organization",
                    "name": "Facebook"
                }
            },
            {
                "@type": "Review",
                "author": {
                    "@type": "Person",
                    "name": "Deon Daboy"
                },
                "datePublished": "2025-05-15",
                "reviewRating": {
                    "@type": "Rating",
                    "ratingValue": "5",
                    "bestRating": "5",
                    "worstRating": "1"
                },
                "reviewBody": "Excelente servicio y comunicación; informa cada detalle con fotos y videos, logrando recuperar una laptop que parecía perdida.",
                "inLanguage": "es",
                "publisher": {
                    "@type": "Organization",
                    "name": "Facebook"
                }
            },
            {
                "@type": "Review",
                "author": {
                    "@type": "Person",
                    "name": "Joel Sonda"
                },
                "datePublished": "2025-05-22",
                "reviewRating": {
                    "@type": "Rating",
                    "ratingValue": "4.5",
                    "bestRating": "5",
                    "worstRating": "1"
                },
                "reviewBody": "Buen servicio con atención especializada; explica problemas claramente y ofrece soluciones según el presupuesto con honestidad.",
                "inLanguage": "es",
                "publisher": {
                    "@type": "Organization",
                    "name": "Facebook"
                }
            }
        ]
    }
]}
>
  <Navbar />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Comentarios' }]} />

    <div class="page-hero dark-bg-hero" style="padding-bottom:50px;">
        <div class="container text-center">
            <h1 class="page-hero__title">¿Qué opinan nuestros <span class="gradient-text-dark">clientes?</span></h1>
            <p class="page-hero__sub" style="max-width:700px; margin:0 auto 20px;">En Pixon PC valoramos la opinión de cada cliente. Aquí puedes leer experiencias reales de personas que confiaron en nuestro servicio de reparación en Cancún. Si ya fuiste atendido, tu opinión nos ayuda a seguir mejorando.</p>
            <div style="display:flex; gap:24px; justify-content:center; flex-wrap:wrap; margin-top:20px;">
                <div style="display:flex; align-items:center; gap:8px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:30px; padding:8px 18px;">
                    <i class="fa-solid fa-shield-halved" style="color:#3b82f6;"></i>
                    <span style="font-size:0.9rem; color:#cbd5e1; font-weight:600;">+300 clientes satisfechos</span>
                </div>
                <div style="display:flex; align-items:center; gap:8px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:30px; padding:8px 18px;">
                    <i class="fa-solid fa-star" style="color:#f59e0b;"></i>
                    <span style="font-size:0.9rem; color:#cbd5e1; font-weight:600;">★ 5.0 calificación promedio</span>
                </div>
                <div style="display:flex; align-items:center; gap:8px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:30px; padding:8px 18px;">
                    <i class="fa-solid fa-certificate" style="color:#10b981;"></i>
                    <span style="font-size:0.9rem; color:#cbd5e1; font-weight:600;">100% garantía por escrito</span>
                </div>
            </div>
        </div>
    </div>

    <section class="comments-section-container section-padding dark-bg" id="comentarios">
        <div class="container comments-section">
            <div class="section-title text-center">
                <h2>Reseñas de Clientes <span id="comments-live-indicator" title="Conectando..." style="display:none; align-items:center; gap:5px; font-size:0.7rem; font-weight:600; color:#10b981; background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.3); border-radius:20px; padding:3px 10px; vertical-align:middle;"><span style="width:7px;height:7px;background:#10b981;border-radius:50%;display:inline-block;"></span> En vivo</span></h2>
                <p>Déjanos un comentario y calificación sobre nuestro servicio.</p>
            </div>

            <!-- ═══ BOTÓN GOOGLE MAPS (T15 — placeholder hasta tener Google Business ID) ═══ -->
            <div class="text-center mb-4">
                <a href="https://maps.app.goo.gl/search/Pixon+PC+Cancun"
                   target="_blank" rel="noopener noreferrer"
                   class="btn btn-outline google-reviews-btn" id="btn-google-reviews">
                    <i class="fa-brands fa-google"></i> Ver / Dejar reseña en Google Maps
                </a>
                <p style="font-size:0.8rem; color:var(--text-muted); margin-top:8px;">
                    Busca "Pixon PC" en Google Maps para dejar tu reseña oficial.
                </p>
            </div>

            <div class="comment-form-container">
                <h4>Deja tu Comentario</h4>
                <div class="stars-input half" id="star-rating" role="radiogroup" aria-label="Calificación en estrellas">
                    {[1, 2, 3, 4, 5].map((base) => (
                      <span class="star-slot" data-base={base}>
                        <svg class="star-bg" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-star" /></svg>
                        <svg class="star-fg" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-star" /></svg>
                        <button type="button" class="star-zone left"  data-val={(base - 0.5).toString()} aria-label={`${base - 0.5} estrellas`}></button>
                        <button type="button" class="star-zone right" data-val={base.toString()}          aria-label={`${base} estrellas`}></button>
                      </span>
                    ))}
                    <span class="rating-label" aria-live="polite"></span>
                </div>
                <form id="addCommentForm">
                    <div class="form-group">
                        <input type="text" id="commenterName" placeholder="Tu Nombre" required autocomplete="name">
                    </div>
                    <div class="form-group mt-3">
                        <textarea id="commenterText" rows="3"
                            placeholder="Muy buen servicio, mi equipo quedó como nuevo..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary mt-3" id="submitCommentBtn">
                        <i class="fa-solid fa-paper-plane"></i> Publicar Comentario
                    </button>
                </form>
            </div>
            <div class="comments-marquee-container" id="commentsCarousel">
                <div class="comment-list" id="commentsBox"></div>
            </div>
            <div class="text-center mt-4">
                <button id="loadMoreComments" class="btn btn-outline" style="display:none;">
                    Ver más comentarios
                </button>
            </div>
        </div>
    </section>

    <!-- ═══ ESTADÍSTICAS ═══ -->
    <section class="section-padding" style="background:#fff;">
        <div class="container">
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number">7+</div>
                    <div class="stat-label">Años de experiencia</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">★ 5.0</div>
                    <div class="stat-label">Calificación promedio</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">100%</div>
                    <div class="stat-label">Garantía por escrito</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">+300</div>
                    <div class="stat-label">Clientes satisfechos</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══ UBICACIÓN (cargada desde componente compartido) ═══ -->

    <style>@media (max-width: 768px) { .ubicacion-grid-com { grid-template-columns: 1fr !important; } }</style>
  <Footer />


    <!-- ═══ Cookie Banner ═══ -->
</Base>

<script src="/scripts/comments.js" is:inline defer></script>
