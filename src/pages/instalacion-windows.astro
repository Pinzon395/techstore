    <!-- ‚"ê‚"ê‚"ê Scroll Reveal ‚"ê‚"ê‚"ê -->
    <script>
        (function () {
            var els = document.querySelectorAll('.wave-el');
            if (!els.length) return;
            var io = new IntersectionObserver(function (entries) {
                entries.forEach(function (e) {
                    if (e.isIntersecting) {
                        // Stagger siblings by index
                        if (!e.target.parentElement) return;
                        var siblings = e.target.parentElement.querySelectorAll('.wave-el');
                        var idx = Array.prototype.indexOf.call(siblings, e.target);
                        (e.target as HTMLElement).style.transitionDelay = (idx * 0.12) + 's';
                        e.target.classList.add('is-visible');
                        io.unobserve(e.target);
                    }
                });
            }, { threshold: 0.15 });
            els.forEach(function (el) { io.observe(el); });
        })();
    </script>
