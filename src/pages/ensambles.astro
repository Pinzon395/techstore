---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FaqSection from '../components/FaqSection.astro';
import CommentsSection from '../components/CommentsSection.astro';
import ServiceTicketSection from '../components/ServiceTicketSection.astro';
import ContactSection from '../components/ContactSection.astro';
import pcBuilderCatalog from '../data/pc-builder-catalog.json';

const pcBuilderMarginRate = pcBuilderCatalog.pricing.marginRate;
const pcBuilderAssemblyFee = Math.round((pcBuilderCatalog.pricing.assemblyFee || 1000) * 1.4);
const pcBuilderQuoteLockHours = pcBuilderCatalog.pricing.quoteLockHours;
const pcBuilderOptions = (category: string) => pcBuilderCatalog.components.filter((item) => item.category === category);
const pcBuilderSalePrice = (marketPrice: number) => Math.round(Number(marketPrice || 0) * (1 + pcBuilderMarginRate) * 1.4);
const pcBuilderFormatPrice = (price: number) => new Intl.NumberFormat('es-MX').format(price);
const pcBuilderOptionLabel = (item: any) => {
  const salePrice = pcBuilderSalePrice(item.marketPrice);
  if (item.id === 'gpu-integrated') return 'Sin gráficos dedicados (usar integrados)';
  return `${item.name} (+ $${pcBuilderFormatPrice(salePrice)})`;
};

const canonicalUrl = 'https://pixon.com.mx/ensambles';

const faqs = [
  {
    question: '¿Cuánto cuesta armar una PC en Cancún?',
    answer: 'El costo depende del uso previsto y del hardware seleccionado. Una PC de oficina o uso diario con procesador con gráficos integrados parte aproximadamente desde <strong>$11,200 a $15,400 MXN</strong>. Una PC Gamer o de diseño de entrada ronda los <strong>$18,200 a $23,800 MXN</strong>, configuraciones intermedias para 1440p y edición 4K entre <strong>$25,200 y $39,200 MXN</strong>, y estaciones de trabajo o gama alta superan los <strong>$49,000 MXN</strong>. Primero definimos tu objetivo y presupuesto para armar una propuesta a medida sin compromiso.'
  },
  {
    question: '¿Puedo llevar mis propios componentes?',
    answer: 'Sí. Si compraste tus piezas en plataformas como Amazon, Cyberpuerta, DDTech o tiendas oficiales, puedes traerlas a nuestro taller en Cancún. Revisamos compatibilidad previa, realizamos el ensamble con cable management profesional, actualización de BIOS, configuración de perfiles XMP/EXPO y pruebas de estabilidad térmica.'
  },
  {
    question: '¿Me ayudan a elegir las piezas antes de comprarlas?',
    answer: 'Totalmente. Puedes enviarnos la lista de componentes o tu presupuesto por WhatsApp antes de comprar. Validamos compatibilidad entre socket, chipset de motherboard, tipo de memoria RAM (DDR4 vs DDR5), dimensiones de la GPU en el gabinete, potencia y conectores de la fuente de poder.'
  },
  {
    question: '¿Arman PC Gamer?',
    answer: 'Sí. Diseñamos ensambles para gaming en 1080p, 1440p o 4K según tu presupuesto y títulos favoritos (Fortnite, Valorant, Warzone, GTA V, títulos AAA). Ajustamos la relación entre procesador y tarjeta gráfica con el fin de evitar cuellos de botella severos y maximizar la estabilidad de cuadros.'
  },
  {
    question: '¿Arman computadoras para oficina?',
    answer: 'Sí. Armamos computadoras de escritorio para administración, contabilidad, facturación, paquetes de Office, videollamadas y puntos de venta. Priorizamos procesadores eficientes, unidades de estado sólido NVMe ultrarrápidas, memoria suficiente y fuentes confiables para garantizar encendido rápido y operación silenciosa.'
  },
  {
    question: '¿Arman PC para edición y render?',
    answer: 'Sí. Seleccionamos plataformas optimizadas para software creativo como Adobe Premiere Pro, After Effects, Photoshop, Lightroom, DaVinci Resolve, Blender y V-Ray, equilibrando núcleos de CPU, aceleración GPU con abundante VRAM y memoria RAM de alta velocidad.'
  },
  {
    question: '¿Arman workstation?',
    answer: 'Sí. Construimos estaciones de trabajo para cargas profesionales pesadas: modelado CAD/BIM (AutoCAD, Revit, SketchUp, SolidWorks), renderizado arquitectónico (Lumion, Unreal Engine), simulaciones y cómputo GPU, priorizando estabilidad térmica sostenida y fuentes de alta eficiencia.'
  },
  {
    question: '¿Qué procesador me conviene, Intel o AMD?',
    answer: 'Depende de tus tareas principales y presupuesto. AMD Ryzen (AM4/AM5) ofrece excelente rendimiento por vatio, gráficos integrados destacados en series G y gran eficiencia en gaming con tecnología 3D V-Cache. Intel Core y Core Ultra ofrecen alto rendimiento mononúcleo y motores de codificación QuickSync muy útiles en edición de video. Evaluamos tu flujo antes de decidir.'
  },
  {
    question: '¿NVIDIA o AMD Radeon?',
    answer: 'NVIDIA GeForce RTX destaca en trazado de rayos (Ray Tracing), escalado DLSS, codificador NVENC para streaming y aceleración CUDA en suites profesionales (Adobe, Blender, IA). AMD Radeon RX ofrece excelente relación rendimiento/precio en rasterización nativa y mayor cantidad de memoria VRAM en rangos intermedios.'
  },
  {
    question: '¿Cuánta RAM necesito?',
    answer: 'Para oficina y tareas básicas recomendamos 16 GB. Para gaming actual en 1080p/1440p y multitarea moderada, 32 GB es el estándar recomendado para evitar saturación. Para edición 4K multicapa, render 3D complejo, virtualización o ingeniería pesada recomendamos 64 GB o más.'
  },
  {
    question: '¿Qué fuente necesita mi GPU?',
    answer: 'La potencia requerida se calcula sumando el consumo pico (TDP) del procesador, la tarjeta gráfica y periféricos, más un margen de seguridad del 20-30%. Tarjetas como RTX 4060 operan bien con fuentes confiables de 550W-650W, mientras que GPUs como RTX 4070 Ti SUPER o superiores requieren 750W-850W con certificación 80 Plus y conectores adecuados.'
  },
  {
    question: '¿Revisan compatibilidad antes del ensamble?',
    answer: 'Sí. Toda propuesta pasa por una verificación técnica de sockets, compatibilidad de BIOS con la generación de CPU instalada, estándar de RAM compatible con placa y procesador, longitud máxima de GPU frente al gabinete y altura o radiador de refrigeración.'
  },
  {
    question: '¿Instalan Windows y drivers?',
    answer: 'Sí. En ensambles completos realizamos la instalación limpia del sistema operativo Windows, configuramos la última versión estable de BIOS, activamos los perfiles de velocidad de memoria XMP/EXPO e instalamos los controladores más recientes del chipset, audio, red y tarjeta de video.'
  },
  {
    question: '¿Hacen pruebas antes de entregar?',
    answer: 'Sí. Cada equipo ensamblado se somete a pruebas de estabilidad y verificación térmica bajo carga controlada para comprobar temperaturas en el procesador y tarjeta gráfica, ausencia de reinicios y correcta operación de los ventiladores y sensores.'
  },
  {
    question: '¿El ensamble tiene garantía?',
    answer: 'Sí. Los componentes adquiridos mediante Pixon PC cuentan con garantía directa en taller y mano de obra por escrito, además del respaldo de garantía oficial de cada fabricante (1 a 3 años según componente). En ensambles con piezas provistas por el cliente, la garantía aplica sobre la mano de obra del ensamble y diagnóstico técnico.'
  },
  {
    question: '¿Puedo actualizar la PC después?',
    answer: 'Totalmente. Diseñamos las computadoras utilizando componentes con factor de forma estándar (ATX, Micro-ATX, fuentes ATX, slots PCIe y M.2 universales). Esto permite añadir más almacenamiento, ampliar memoria RAM o renovar la tarjeta gráfica en el futuro sin restricciones propietarias.'
  },
  {
    question: '¿Atienden Zona Hotelera?',
    answer: 'Sí. Brindamos servicio a clientes residentes, hoteles y oficinas en la Zona Hotelera de Cancún, coordinando cotización previa, ensamble en taller y opciones de entrega o recolección programada con cita.'
  }
];
---

<Base
  title="Armado de PC en Cancún | Gamer, Oficina y Workstation | Pixon PC"
  description="Armado de PC a medida en Cancún para gaming, oficina, programación, edición, render y workstation. Elegimos hardware compatible según uso y presupuesto."
  canonical={canonicalUrl}
  image="/assets/images/responsive/ensamble-pc-gamer-cancun.webp"
  schema={[
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Armado y Ensamble de PC a Medida en Cancún",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Pixon PC",
        "telephone": "+529986690777",
        "url": "https://pixon.com.mx",
        "email": "pixonpc@gmail.com",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Cto. Hacienda Chimay",
          "addressLocality": "Cancún",
          "addressRegion": "Quintana Roo",
          "postalCode": "77539",
          "addressCountry": "MX"
        }
      },
      "areaServed": [
        {
          "@type": "City",
          "name": "Cancún"
        }
      ],
      "serviceType": "Armado de computadoras personalizadas, ensamble de PC Gamer, computadoras de oficina y workstations",
      "url": canonicalUrl,
      "description": "Servicio profesional de armado y ensamble de computadoras de escritorio en Cancún. Equipos a medida para gaming, oficina, desarrollo, edición de video, arquitectura y render 3D con verificación de compatibilidad."
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://pixon.com.mx/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Armado de PC",
          "item": canonicalUrl
        }
      ]
    }
  ]}
>
  <Navbar />

  <main id="main-content" class="ensambles-page">
    <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Armado de PC a Medida' }]} />

    <!-- =========================================================================
         1. HERO SECTION WITH INTERACTIVE ASSEMBLY ANIMATION
    ========================================================================== -->
    <header class="ensambles-hero" aria-labelledby="hero-title">
      <div class="container ensambles-hero__grid">
        <div class="ensambles-hero__content">
          <p class="hero-eyebrow">
            <i class="fa-solid fa-microchip" aria-hidden="true"></i> ENSAMBLE DE COMPUTADORAS · HARDWARE · CANCÚN
          </p>
          <h1 id="hero-title" class="ensambles-hero__title">
            Armado de PC a Medida en Cancún
          </h1>
          <p class="ensambles-hero__lead">
            Armamos computadoras de escritorio según lo que realmente necesitas: PC Gamer, oficina, trabajo, programación, edición, streaming, arquitectura, render y workstation.
          </p>
          <p class="ensambles-hero__sublead">
            Seleccionamos CPU, GPU, RAM, almacenamiento, motherboard, fuente y refrigeración verificando compatibilidad, presupuesto y posibilidad de actualización.
          </p>

          <div class="ensambles-hero__actions">
            <a href="#builder" class="btn btn-primary ensambles-btn-primary">
              <i class="fa-solid fa-wrench" aria-hidden="true"></i> Armar mi PC
            </a>
            <a
              href="https://wa.me/529986690777?text=Hola%20Pixon%20PC%2C%20quiero%20cotizar%20el%20armado%20de%20una%20PC%20a%20medida%20en%20Canc%C3%BAn."
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline ensambles-btn-whatsapp"
            >
              <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Cotizar por WhatsApp
            </a>
          </div>

          <div class="ensambles-hero__trust-grid" aria-label="Beneficios del servicio">
            <div class="trust-badge">
              <i class="fa-solid fa-desktop" aria-hidden="true"></i>
              <span>PC Gamer y oficina</span>
            </div>
            <div class="trust-badge">
              <i class="fa-solid fa-microchip" aria-hidden="true"></i>
              <span>Intel · AMD · NVIDIA · Radeon</span>
            </div>
            <div class="trust-badge">
              <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
              <span>Compatibilidad antes de comprar</span>
            </div>
            <div class="trust-badge">
              <i class="fa-solid fa-gauge-high" aria-hidden="true"></i>
              <span>Pruebas después del ensamble</span>
            </div>
          </div>
        </div>

        <!-- Visual Stage: Pure SVG / CSS Custom Assembly Animation -->
        <div class="ensambles-hero__visual-wrap">
          <!-- Profile Selector Pills -->
          <div class="hero-profile-switch" role="tablist" aria-label="Perfiles de uso para el ensamble">
            <button type="button" class="profile-chip active" data-profile="gaming" role="tab" aria-selected="true">
              <i class="fa-solid fa-gamepad" aria-hidden="true"></i> Gaming
            </button>
            <button type="button" class="profile-chip" data-profile="oficina" role="tab" aria-selected="false">
              <i class="fa-solid fa-briefcase" aria-hidden="true"></i> Trabajo
            </button>
            <button type="button" class="profile-chip" data-profile="creacion" role="tab" aria-selected="false">
              <i class="fa-solid fa-video" aria-hidden="true"></i> Creación
            </button>
            <button type="button" class="profile-chip" data-profile="workstation" role="tab" aria-selected="false">
              <i class="fa-solid fa-cubes" aria-hidden="true"></i> Workstation
            </button>
          </div>

          <!-- SVG Assembly Visual Container -->
          <div class="hero-assembly-card" id="hero-pc-stage">
            <svg viewBox="0 0 540 400" class="assembly-svg" aria-hidden="true" focusable="false">
              <defs>
                <linearGradient id="chassisGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#1e293b" />
                  <stop offset="100%" stop-color="#0b1120" />
                </linearGradient>
                <linearGradient id="moboGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#0f172a" />
                  <stop offset="100%" stop-color="#1e3a5f" />
                </linearGradient>
                <linearGradient id="gpuGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#2563eb" />
                  <stop offset="100%" stop-color="#1d4ed8" />
                </linearGradient>
                <linearGradient id="airflowCyan" x1="0%" y1="100%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.9" />
                  <stop offset="100%" stop-color="#06b6d4" stop-opacity="0.1" />
                </linearGradient>
                <filter id="glowCyan" x="-20%" y="-20%" width="140%" height="140%">
                  <feDropShadow dx="0" dy="0" stdDeviation="4" flood-color="#38bdf8" flood-opacity="0.8" />
                </filter>
              </defs>

              <!-- Chassis Outer Shell with Glass Frame -->
              <rect x="60" y="30" width="420" height="340" rx="18" fill="url(#chassisGrad)" stroke="#334155" stroke-width="2" />
              <!-- Inner Component Bay -->
              <rect x="75" y="45" width="390" height="310" rx="10" fill="#070d18" stroke="#1e293b" stroke-width="1.5" />

              <!-- Step 1: Motherboard Backbone -->
              <g class="part-layer part-mobo">
                <rect x="120" y="65" width="310" height="210" rx="8" fill="url(#moboGrad)" stroke="#2563eb" stroke-width="1.2" stroke-dasharray="3 3" />
                <rect x="135" y="80" width="60" height="30" rx="4" fill="#1e293b" stroke="#475569" stroke-width="1" />
                <line x1="120" y1="180" x2="430" y2="180" stroke="#1e3a5f" stroke-width="1" stroke-dasharray="2 4" />
              </g>

              <!-- Step 2: CPU Socket & Processor -->
              <g class="part-layer part-cpu">
                <rect x="230" y="85" width="65" height="65" rx="5" fill="#334155" stroke="#60a5fa" stroke-width="1.5" />
                <rect x="242" y="97" width="41" height="41" rx="3" fill="#0284c7" />
                <circle cx="262" cy="117" r="6" fill="#e0f2fe" opacity="0.9" />
              </g>

              <!-- Step 3: RAM Modules (Dual Channel) -->
              <g class="part-layer part-ram">
                <rect x="315" y="80" width="10" height="75" rx="2" fill="#38bdf8" filter="url(#glowCyan)" />
                <rect x="332" y="80" width="10" height="75" rx="2" fill="#38bdf8" filter="url(#glowCyan)" />
              </g>

              <!-- Step 4: NVMe M.2 SSD Slot -->
              <g class="part-layer part-ssd">
                <rect x="220" y="165" width="85" height="18" rx="3" fill="#1e293b" stroke="#10b981" stroke-width="1.2" />
                <text x="230" y="178" fill="#10b981" font-size="8" font-family="monospace" font-weight="700">M.2 NVMe</text>
              </g>

              <!-- Step 5: CPU Cooler / Heatsink -->
              <g class="part-layer part-cooler">
                <circle cx="262" cy="117" r="32" fill="#0f172a" stroke="#38bdf8" stroke-width="2" />
                <g class="fan-blades-cpu">
                  <path d="M 262 100 Q 275 110 262 117 Q 249 110 262 100 Z" fill="#38bdf8" opacity="0.8" />
                  <path d="M 279 117 Q 269 130 262 117 Q 269 104 279 117 Z" fill="#38bdf8" opacity="0.8" />
                  <path d="M 262 134 Q 249 124 262 117 Q 275 124 262 134 Z" fill="#38bdf8" opacity="0.8" />
                  <path d="M 245 117 Q 255 104 262 117 Q 255 130 245 117 Z" fill="#38bdf8" opacity="0.8" />
                </g>
                <circle cx="262" cy="117" r="8" fill="#1e293b" stroke="#60a5fa" stroke-width="1" />
              </g>

              <!-- Step 6: Dedicated GPU / Video Card -->
              <g class="part-layer part-gpu">
                <rect x="140" y="195" width="260" height="60" rx="8" fill="url(#gpuGrad)" stroke="#60a5fa" stroke-width="1.5" />
                <!-- Dual GPU Fans -->
                <circle cx="205" cy="225" r="18" fill="#0f172a" stroke="#93c5fd" stroke-width="1.2" class="fan-spin" />
                <circle cx="295" cy="225" r="18" fill="#0f172a" stroke="#93c5fd" stroke-width="1.2" class="fan-spin" />
                <rect x="360" y="210" width="30" height="30" rx="4" fill="#0f172a" stroke="#3b82f6" stroke-width="1" />
              </g>

              <!-- Step 7: Power Supply Unit (PSU Shroud) -->
              <g class="part-layer part-psu">
                <rect x="75" y="290" width="390" height="65" rx="4" fill="#0f172a" stroke="#334155" stroke-width="1.5" />
                <rect x="90" y="305" width="130" height="38" rx="6" fill="#1e293b" stroke="#475569" stroke-width="1" />
                <text x="105" y="328" fill="#94a3b8" font-size="10" font-weight="700" font-family="sans-serif">80+ POWER</text>
              </g>

              <!-- Step 8: Clean Cable Management Traces -->
              <g class="part-layer part-cables">
                <path d="M 220 305 Q 220 280 260 280 L 375 280 Q 380 280 380 255" fill="none" stroke="#64748b" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="6 2" />
                <path d="M 200 305 Q 200 240 145 240 L 140 240" fill="none" stroke="#475569" stroke-width="2" stroke-linecap="round" />
                <path d="M 210 305 Q 210 150 420 150 L 420 110" fill="none" stroke="#334155" stroke-width="2.5" stroke-linecap="round" />
              </g>

              <!-- Step 9: Smooth Airflow Vector Trails -->
              <g class="part-layer part-airflow" opacity="0.6">
                <!-- Intake from front/bottom (right/bottom) -->
                <path d="M 450 140 C 400 140 330 117 294 117" fill="none" stroke="url(#airflowCyan)" stroke-width="2" stroke-dasharray="8 6" class="flow-path-1" />
                <path d="M 450 225 C 380 225 350 225 320 225" fill="none" stroke="url(#airflowCyan)" stroke-width="2" stroke-dasharray="8 6" class="flow-path-2" />
                <!-- Exhaust through rear/top (left/top) -->
                <path d="M 230 117 C 190 117 140 90 90 90" fill="none" stroke="#38bdf8" stroke-width="1.8" stroke-dasharray="6 4" class="flow-path-3" />
                <path d="M 140 215 C 110 215 95 180 90 140" fill="none" stroke="#38bdf8" stroke-width="1.8" stroke-dasharray="6 4" class="flow-path-3" />
              </g>
            </svg>

            <!-- Diagnostic Live Pill Overlay -->
            <div class="assembly-status-bar">
              <span class="status-indicator-dot"></span>
              <span class="status-text">ENSAMBLE VERIFICADO · COMPATIBLE</span>
              <span class="status-badge-chip">STABLE</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Hero 5-Step Process Timeline Bar -->
      <div class="container ensambles-timeline-wrap">
        <div class="ensambles-timeline" aria-label="Pasos para armar tu PC con Pixon PC">
          <div class="timeline-step">
            <span class="step-num">01</span>
            <span class="step-name">Uso y presupuesto</span>
          </div>
          <div class="timeline-step">
            <span class="step-num">02</span>
            <span class="step-name">Compatibilidad</span>
          </div>
          <div class="timeline-step">
            <span class="step-num">03</span>
            <span class="step-name">Ensamble</span>
          </div>
          <div class="timeline-step">
            <span class="step-num">04</span>
            <span class="step-name">Configuración</span>
          </div>
          <div class="timeline-step">
            <span class="step-num">05</span>
            <span class="step-name">Pruebas</span>
          </div>
        </div>
      </div>
    </header>

    <!-- =========================================================================
         2. SECTION: CONFIGURADOR DE PC INTERACTIVO (MODO RECOMENDADO + MODO AVANZADO)
    ========================================================================== -->
    <section
      id="builder"
      class="section-padding builder-section"
      data-assembly-fee={pcBuilderAssemblyFee}
      data-margin-rate={pcBuilderMarginRate}
      data-quote-lock-hours={pcBuilderQuoteLockHours}
    >
      <div class="container">
        <div class="section-header text-center builder-header">
          <span class="section-badge badge--cyan"><i class="fa-solid fa-sliders"></i> Configurador Interactivo</span>
          <h2 class="builder-title">Arma tu PC a la Carta en Cancún</h2>
          <p class="builder-subtitle">
            Elige el camino que mejor se adapte a ti: déjanos recomendarte la mejor configuración según tu uso o selecciona cada componente pieza por pieza.
          </p>
          <p id="builder-price-status" class="builder-status-text" aria-live="polite">
            Precios de referencia de mercado actualizados con ensamble garantizado y pruebas de estabilidad térmica en Cancún. Piezas sujetas a disponibilidad y confirmación por WhatsApp.
          </p>
        </div>

        <!-- Mode Toggle Tabs -->
        <div class="builder-mode-tabs" role="tablist" aria-label="Modo de configuración">
          <button type="button" class="mode-tab active" id="tab-mode-recommended" onclick="switchBuilderMode('recommended')" role="tab" aria-selected="true">
            <i class="fa-solid fa-wand-magic-sparkles"></i> Modo Recomendado (Por Uso y Presupuesto)
          </button>
          <button type="button" class="mode-tab" id="tab-mode-advanced" onclick="switchBuilderMode('advanced')" role="tab" aria-selected="false">
            <i class="fa-solid fa-microchip"></i> Modo Avanzado (Selector de Piezas)
          </button>
        </div>

        <!-- PANEL 1: MODO RECOMENDADO (ASISTENTE GUIADO) -->
        <div id="panel-recommended" class="builder-panel active">
          <div class="rec-wizard-grid">
            <div class="rec-wizard-left">
              <h3 class="wizard-step-title">1. ¿Para qué utilizarás principalmente tu PC?</h3>
              <div class="rec-use-options">
                <button type="button" class="rec-opt-btn active" data-use="gaming" onclick="selectRecommendedUse('gaming')">
                  <i class="fa-solid fa-gamepad"></i>
                  <div>
                    <strong>Gaming</strong>
                    <p>Fortnite, Valorant, Warzone, AAA a 1080p, 1440p o 4K</p>
                  </div>
                </button>
                <button type="button" class="rec-opt-btn" data-use="oficina" onclick="selectRecommendedUse('oficina')">
                  <i class="fa-solid fa-briefcase"></i>
                  <div>
                    <strong>Oficina & Negocio</strong>
                    <p>Excel, facturación, contabilidad, videollamadas, navegación</p>
                  </div>
                </button>
