    margin: 0 auto;
  }

  /* 1. HERO SECTION */
  .ensambles-hero {
    background: linear-gradient(135deg, #071F3A 0%, #0c2b4e 50%, #071526 100%);
    color: #ffffff;
    padding: 60px 0 30px;
    position: relative;
    overflow: hidden;
  }

  .ensambles-hero::before {
    content: '';
    position: absolute;
    top: -100px;
    right: -100px;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.18) 0%, rgba(7, 31, 58, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .ensambles-hero__grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 40px;
    position: relative;
    z-index: 2;
  }

  .ensambles-hero__content {
    flex: 1.1;
    min-width: 300px;
    max-width: 620px;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.35);
    color: #7dd3fc !important;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    margin-bottom: 16px;
  }

  .ensambles-hero__title {
    font-size: clamp(2.3rem, 4.5vw, 3.6rem);
    font-weight: 800;
    line-height: 1.12;
    margin-bottom: 16px;
    color: #ffffff !important;
  }

  .ensambles-hero__lead {
    font-size: 1.12rem;
    color: #e2e8f0 !important;
    line-height: 1.6;
    margin-bottom: 12px;
  }

  .ensambles-hero__sublead {
    font-size: 0.98rem;
    color: #94a3b8 !important;
    line-height: 1.55;
    margin-bottom: 28px;
  }

  .ensambles-hero__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .ensambles-btn-primary {
    padding: 14px 26px;
    font-size: 1rem;
    font-weight: 800;
    border-radius: 12px;
    background: linear-gradient(135deg, #2563eb, #3b82f6);
    color: #ffffff !important;
    box-shadow: 0 10px 25px -8px rgba(37, 99, 235, 0.5);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .ensambles-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -8px rgba(37, 99, 235, 0.6);
  }

  .ensambles-btn-whatsapp {
    padding: 14px 24px;
    font-size: 1rem;
    font-weight: 700;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff !important;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .ensambles-btn-whatsapp:hover {
    background: rgba(37, 211, 102, 0.15);
    border-color: #25d366;
    color: #25d366 !important;
  }

  .ensambles-hero__trust-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
  }

  .trust-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 0.86rem;
    font-weight: 600;
  }

  .trust-badge i {
    color: #38bdf8;
    font-size: 1rem;
  }

  .trust-badge span {
    color: #cbd5e1 !important;
  }

  /* Hero Visual & Interactive Animation */
  .ensambles-hero__visual-wrap {
    flex: 1;
    min-width: 320px;
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hero-profile-switch {
    display: flex;
    gap: 6px;
    background: rgba(15, 23, 42, 0.6);
    padding: 6px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow-x: auto;
  }

  .profile-chip {
    flex: 1;
    min-width: 75px;
    padding: 8px 10px;
    border-radius: 8px;
    background: transparent;
    border: none;
    color: #94a3b8;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .profile-chip:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  .profile-chip.active {
    background: #2563eb;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4);
  }

  .hero-assembly-card {
    background: #0f172a;
    border-radius: 20px;
    border: 1px solid #1e293b;
    padding: 16px;
    box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.6);
    position: relative;
    overflow: hidden;
  }

  .assembly-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Keyframe animations for SVG Assembly */
  .fan-spin, .fan-blades-cpu {
    transform-origin: 262px 117px;
    animation: rotateFan 4s linear infinite;
  }

  .fan-spin:nth-child(2) {
    transform-origin: 205px 225px;
  }

  .fan-spin:nth-child(3) {
    transform-origin: 295px 225px;
  }

  @keyframes rotateFan {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .flow-path-1, .flow-path-2, .flow-path-3 {
    animation: flowDash 2.5s linear infinite;
  }

  @keyframes flowDash {
    to { stroke-dashoffset: -28; }
  }

  .assembly-status-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid #1e293b;
    padding: 8px 14px;
    border-radius: 8px;
    margin-top: 10px;
    font-size: 0.78rem;
  }

  .status-indicator-dot {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 8px #10b981;
    display: inline-block;
  }

  .status-text {
    color: #cbd5e1 !important;
    font-weight: 700;
  }

  .status-badge-chip {
    background: rgba(16, 185, 129, 0.18);
    color: #10b981 !important;
    padding: 2px 8px;
    border-radius: 6px;
    font-weight: 800;
    font-size: 0.72rem;
  }

  /* Timeline */
  .ensambles-timeline-wrap {
    margin-top: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 24px;
  }

  .ensambles-timeline {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .timeline-step {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .step-num {
    width: 32px;
    height: 32px;
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8 !important;
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.82rem;
  }

  .step-name {
    color: #e2e8f0 !important;
    font-size: 0.9rem;
    font-weight: 700;
  }

  /* 3. CLUSTERS INTRO */
  .clusters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }

  .cluster-card {
    background: #ffffff;
    padding: 30px;
    border-radius: 18px;
    border: 1px solid #e2e8f0;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .cluster-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px -10px rgba(7, 31, 58, 0.1);
  }

  .cluster-card__icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    margin-bottom: 18px;
  }

  .cluster-card h3 {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 10px;
    color: var(--azul-oscuro) !important;
  }

  .cluster-card p {
    font-size: 0.95rem;
    color: #475569 !important;
    line-height: 1.55;
    margin: 0;
  }

  /* 4. USECASES STACK & SUB-TIERS */
  .usecases-stack {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .usecase-card {
    background: #f8fafc;
    border-radius: 20px;
    border: 1px solid #e2e8f0;
    padding: 36px;
  }

  .usecase-card__header {
    margin-bottom: 24px;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 20px;
  }

  .usecase-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 14px;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .gaming-tag { background: #ede9fe; color: #6d28d9 !important; }
  .office-tag { background: #e0f2fe; color: #0369a1 !important; }
  .dev-tag { background: #ecfdf5; color: #047857 !important; }
  .video-tag { background: #fef3c7; color: #b45309 !important; }
  .render-tag { background: #fee2e2; color: #b91c1c !important; }
  .ws-tag { background: #f1f5f9; color: #334155 !important; }
  .stream-tag { background: #fdf2f8; color: #be185d !important; }
  .ia-tag { background: #e0e7ff; color: #4338ca !important; }

  .usecase-card h3 {
    font-size: 1.55rem;
    font-weight: 800;
    color: var(--azul-oscuro) !important;
    margin-bottom: 8px;
  }

  .usecase-card__desc {
    font-size: 1.05rem;
    color: #475569 !important;
    margin: 0;
  }

  .sub-tiers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }

  .sub-tier-item {
    background: #ffffff;
    padding: 20px;
    border-radius: 14px;
    border: 1px solid #e2e8f0;
  }

  .sub-tier-item h4 {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--azul-oscuro) !important;
    margin-bottom: 8px;
  }

  .sub-tier-item p {
    font-size: 0.9rem;
    color: #475569 !important;
    line-height: 1.5;
    margin: 0;
  }

  .usecases-twin-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }

  .usecase-card-compact {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 28px;
  }

  .usecase-card-compact h3 {
    font-size: 1.3rem;
    font-weight: 800;
    margin: 10px 0 8px;
    color: var(--azul-oscuro) !important;
  }

  .usecase-card-compact p {
    font-size: 0.95rem;
    color: #475569 !important;
    line-height: 1.55;
    margin: 0;
  }

  /* 5. HARDWARE GRID */
  .hardware-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }

  .hw-card {
    background: #ffffff;
    padding: 28px;
    border-radius: 18px;
    border: 1px solid #e2e8f0;
  }

  .hw-card--full {
    grid-column: 1 / -1;
  }

  .hw-card__icon {
    font-size: 1.8rem;
    color: #2563eb;
    margin-bottom: 14px;
  }

  .hw-card h3 {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--azul-oscuro) !important;
    margin-bottom: 10px;
  }

  .hw-card p {
    font-size: 0.94rem;
    color: #475569 !important;
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .hw-subitems {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hw-subitems-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }

  .hw-subitem {
    background: #f8fafc;
    padding: 12px 16px;
    border-radius: 10px;
    border: 1px solid #edf2f7;
  }

  .hw-subitem h4 {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--azul-oscuro) !important;
    margin-bottom: 4px;
  }

  .hw-subitem span {
    font-size: 0.85rem;
    color: #64748b !important;
    line-height: 1.4;
  }

  .hw-note {
    font-size: 0.85rem !important;
    color: #2563eb !important;
    background: #eff6ff;
    padding: 8px 12px;
    border-radius: 8px;
    margin: 0 !important;
  }

  /* 6. PRICING TIERS */
  .pricing-tiers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-bottom: 24px;
  }

  .pricing-tier-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 24px;
    display: flex;
    flex-direction: column;
  }

  .pricing-tier-card--popular {
    border: 2px solid #2563eb;
    background: #ffffff;
    box-shadow: 0 12px 30px -8px rgba(37, 99, 235, 0.15);
  }

  .pricing-tier-badge {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 12px;
    background: #e2e8f0;
    color: #475569 !important;
    margin-bottom: 12px;
  }

  .badge--pop {
    background: #2563eb;
    color: #ffffff !important;
  }

  .pricing-tier-card h3 {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--azul-oscuro) !important;
    margin-bottom: 10px;
  }

  .price-range {
    font-size: 1.4rem;
    font-weight: 800;
    color: #071F3A !important;
    margin-bottom: 12px;
  }

  .price-range .currency {
    font-size: 0.8rem;
    color: #64748b !important;
    font-weight: 600;
  }

  .tier-desc {
    font-size: 0.88rem;
    color: #475569 !important;
    line-height: 1.5;
    margin-bottom: 18px;
  }

  .tier-features {
    list-style: none;
    padding: 0;
    margin: auto 0 0;
  }

  .tier-features li {
    font-size: 0.84rem;
    color: #334155 !important;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .tier-features li i {
    color: #10b981;
    font-size: 0.8rem;
  }

  .pricing-disclaimer {
    font-size: 0.86rem;
    color: #64748b !important;
    font-style: italic;
  }

  /* 7. BUILDS GRID */
  .builds-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 26px;
  }

  .build-card {
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid #e2e8f0;
    overflow: hidden;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .build-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 35px -8px rgba(7, 31, 58, 0.12);
  }

  .build-card--featured {
    border: 2px solid #2563eb;
  }

  .build-card__media {
    position: relative;
    background: linear-gradient(180deg, #f1f5f9 0%, #ffffff 100%);
    padding: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-bottom: 1px solid #e2e8f0;
  }

  .build-card__media img {
    max-width: 100%;
    height: 190px;
    object-fit: contain;
    filter: drop-shadow(0 10px 15px rgba(0, 0, 0, 0.1));
  }

  .build-tag {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #e0e7ff;
    color: #4338ca !important;
    padding: 4px 10px;
    border-radius: 14px;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .tag--pop {
    background: #2563eb;
    color: #ffffff !important;
  }

  .build-card__body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .build-card__body h3 {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--azul-oscuro) !important;
    margin-bottom: 8px;
  }

  .build-summary {
    font-size: 0.88rem;
    color: #64748b !important;
    line-height: 1.45;
    margin-bottom: 16px;
    min-height: 48px;
  }

  .build-specs {
    background: #f8fafc;
    border-radius: 12px;
    padding: 14px;
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .spec-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.86rem;
    color: #334155 !important;
  }

  .spec-row i {
    color: #2563eb;
    width: 16px;
    font-size: 0.85rem;
  }

  .build-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: auto;
    border-top: 1px solid #f1f5f9;
    padding-top: 14px;
  }

  .price-label {
    display: block;
    font-size: 0.75rem;
    color: #64748b !important;
  }

  .price-amount {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--azul-oscuro) !important;
    line-height: 1;
  }

  .price-amount small {
    font-size: 0.8rem;
    font-weight: 600;
    color: #64748b !important;
  }

  .build-cta-btn {
    padding: 8px 16px;
    font-size: 0.88rem;
    border-radius: 10px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* 8. REAL CASE GALLERY */
  .real-case-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px;
    background: #f8fafc;
    border-radius: 24px;
    border: 1px solid #e2e8f0;
    padding: 40px;
  }

  .real-case-image-box {
    flex: 1;
    min-width: 300px;
    display: flex;
    justify-content: center;
  }

  .real-case-img {
    max-width: 100%;
    height: auto;
    max-height: 420px;
    border-radius: 18px;
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.15);
    border: 1px solid #e2e8f0;
  }

  .real-case-content {
    flex: 1.2;
    min-width: 300px;
  }

  .real-case-tag {
    display: inline-block;
    padding: 4px 12px;
    background: #e0f2fe;
    color: #0369a1 !important;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .real-case-content h3 {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--azul-oscuro) !important;
    margin-bottom: 12px;
  }

  .real-case-content p {
    font-size: 1rem;
    color: #475569 !important;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .real-case-specs-list {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 24px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
  }

  .case-spec-item {
    font-size: 0.88rem;
    color: #334155 !important;
    line-height: 1.4;
  }

  .case-spec-item strong {
    display: block;
    color: var(--azul-oscuro) !important;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* 9. CONFIGURADOR */
  .builder-section {
    --pc-bg: #F6F8FC;
    --pc-heading: #071B36;
    --pc-body: #64748B;
    --pc-muted: #718096;
    --pc-navy: #101A31;
    --pc-navy-card: #1C2940;
    --pc-light-text: #F8FAFC;
    --pc-card-text: #D7E6F5;
    --pc-cyan: #20B7FF;
    --pc-blue: #2563EB;
    --pc-selected-bg: #E8F5FF;
    --pc-selected-text: #0B2B46;

    background: var(--pc-bg);
    color: var(--pc-heading);
    position: relative;
    overflow: hidden;
  }

  .builder-header .builder-title {
    color: #071B36 !important;
    font-weight: 800;
  }

  .builder-header .builder-subtitle {
    color: #64748B !important;
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 680px;
    margin: 0 auto;
  }

  .builder-status-text {
    color: #718096 !important;
    font-size: 0.88rem;
    line-height: 1.5;
    max-width: 700px;
    margin: 12px auto 0;
  }

  .builder-mode-tabs {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }

  .mode-tab {
    padding: 12px 24px;
    border-radius: 30px;
    background: transparent;
    border: 1px solid #CBD5E1;
    color: #64748B !important;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .mode-tab i {
    color: inherit;
  }

  .mode-tab:hover:not(.active) {
    background: #EFF6FF;
    color: #1E40AF !important;
    border-color: #93C5FD;
  }

  .mode-tab.active {
    background: #2563EB;
    border-color: #2563EB;
    color: #FFFFFF !important;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
  }

  .mode-tab.active i {
    color: #FFFFFF !important;
  }

  .builder-panel {
    display: none;
  }

  .builder-panel.active {
    display: block;
  }

  /* Recommended Wizard */
  .rec-wizard-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
  }

  .rec-wizard-left {
    flex: 1.3;
    min-width: 320px;
  }

  .rec-wizard-right {
    flex: 1;
    min-width: 320px;
  }

  .wizard-step-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0F172A !important;
    margin-bottom: 16px;
  }

  .rec-use-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
  }

  .rec-opt-btn {
    background: #101A31;
    border: 1px solid #1E293B;
    border-radius: 14px;
    padding: 16px;
    text-align: left;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .rec-opt-btn i {
    font-size: 1.4rem;
    color: #20B7FF !important;
    margin-top: 2px;
    transition: color 0.2s ease;
  }

  .rec-opt-btn strong {
    display: block;
    color: #FFFFFF !important;
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 4px;
    transition: color 0.2s ease;
  }

  .rec-opt-btn p {
    color: #BFD0E5 !important;
    font-size: 0.8rem;
    margin: 0;
    line-height: 1.35;
    transition: color 0.2s ease;
  }

  .rec-opt-btn:hover:not(.active) {
    transform: translateY(-1px);
    border-color: #20B7FF;
    background: #16223D;
    box-shadow: 0 4px 14px rgba(16, 26, 49, 0.25);
  }

  .rec-opt-btn.active {
    background: #E8F5FF !important;
    border: 2px solid #22A7F0 !important;
    box-shadow: 0 4px 16px rgba(34, 167, 240, 0.2);
  }

  .rec-opt-btn.active i {
    color: #18A8F7 !important;
  }

  .rec-opt-btn.active strong {
    color: #0B2B46 !important;
    font-weight: 800;
  }

  .rec-opt-btn.active p {
    color: #42627A !important;
  }

  .budget-buttons-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .budget-btn {
    flex: 1;
    min-width: 100px;
    padding: 12px;
    border-radius: 10px;
    background: #111A30 !important;
    border: 1px solid #1E293B;
    color: #F8FAFC !important;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .budget-btn:hover:not(.active) {
    background: #1E293B !important;
    border-color: #38BDF8;
    color: #FFFFFF !important;
    transform: translateY(-1px);
  }

  .budget-btn.active {
    background: #2563EB !important;
    border-color: #3B82F6 !important;
    color: #FFFFFF !important;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
  }

  /* Recommendation Card */
  .rec-result-card {
    background: #1C2940;
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 16px 36px rgba(7, 31, 58, 0.2);
  }

  .rec-result-header {
    border-bottom: 1px solid rgba(148, 163, 184, 0.25);
    padding-bottom: 16px;
    margin-bottom: 20px;
  }

  #rec-badge-tier {
    display: inline-block;
    color: #38BDF8 !important;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .rec-result-header h3,
  #rec-build-name {
    font-size: 1.45rem;
    font-weight: 800;
    color: #FFFFFF !important;
    margin: 10px 0 6px;
  }

  .rec-result-header p,
  #rec-build-desc {
    font-size: 0.9rem;
    color: #C6D4E5 !important;
    line-height: 1.5;
    margin: 0;
  }

  .rec-specs-summary {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
  }

  .rec-spec-line {
    font-size: 0.9rem;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    line-height: 1.45;
  }

  .rec-spec-line i {
    color: #20B7FF !important;
    margin-top: 3px;
    width: 16px;
    flex-shrink: 0;
  }

  .rec-spec-line strong {
    color: #FFFFFF !important;
    font-weight: 700;
    min-width: 82px;
    flex-shrink: 0;
  }

  .rec-spec-line span,
  #rec-cpu-val,
  #rec-gpu-val,
  #rec-ram-val,
  #rec-ssd-val,
  #rec-base-val {
    color: #D7E6F5 !important;
    font-weight: 500;
  }

  .rec-price-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-top: 1px solid rgba(148, 163, 184, 0.25);
    padding-top: 16px;
    margin-bottom: 20px;
    gap: 12px;
  }

  .rec-price-label {
    font-size: 0.82rem;
    color: #9FB3C8 !important;
    display: block;
    margin-bottom: 4px;
  }

  .rec-price-total,
  #rec-price-val {
    font-size: 1.8rem;
    font-weight: 800;
    color: #FFFFFF !important;
    line-height: 1;
  }

  .rec-price-total small,
  #rec-price-val small {
    font-size: 0.9rem;
    color: #9FB3C8 !important;
    font-weight: 600;
  }

  .btn-rec-edit {
    font-size: 0.85rem;
    padding: 8px 14px;
    border: 1px solid #64748B !important;
    color: #F1F5F9 !important;
    background: transparent;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-rec-edit:hover {
    border-color: #20B7FF !important;
    color: #20B7FF !important;
    background: rgba(32, 183, 255, 0.08);
  }

  .btn-whatsapp-full {
    width: 100%;
    padding: 15px;
    border-radius: 12px;
    background: linear-gradient(90deg, #25D366, #128C7E);
    color: #FFFFFF !important;
    font-weight: 800;
    font-size: 1rem;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 8px 20px -6px rgba(37, 211, 102, 0.4);
  }

  .btn-whatsapp-full:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -6px rgba(37, 211, 102, 0.5);
  }

  /* Advanced Interactive Controls */
  .builder-interactive-layout {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
  }

  .builder-controls-col {
    flex: 1.4;
    min-width: 320px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .builder-cart-col {
    flex: 1;
    min-width: 320px;
  }

  .builder-field-card {
    background: #101A31;
    padding: 18px;
    border-radius: 14px;
    border: 1px solid #1E293B;
  }

  .builder-field-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .builder-field-label span {
    color: #FFFFFF !important;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .builder-field-label span i {
    color: #20B7FF !important;
  }

  .field-badge-ready {
    background: rgba(16, 185, 129, 0.15);
    color: #10B981 !important;
    font-size: 0.72rem;
    padding: 2px 8px;
    border-radius: 12px;
    font-weight: 800;
  }

  .builder-select {
    width: 100%;
    padding: 13px 14px;
    border-radius: 10px;
    background: #070D18;
    color: #F8FAFC !important;
    border: 1px solid #334155;
    font-size: 0.95rem;
    cursor: pointer;
    outline: none;
  }

  .builder-select:focus {
    border-color: #38BDF8;
  }

  /* Power Meter */
  .power-meter-box {
    background: #101A31;
    padding: 18px;
    border-radius: 14px;
    border: 1px solid #1E293B;
  }

  .power-meter-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }

  .power-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: #FFFFFF !important;
  }

  .power-title i {
    color: #20B7FF !important;
    margin-right: 6px;
  }

  .power-tier {
    font-weight: 800;
    font-size: 0.9rem;
    color: #94A3B8 !important;
  }

  .power-meter-track {
    width: 100%;
    height: 10px;
    background: #1E293B;
    border-radius: 6px;
    overflow: hidden;
  }

  .power-meter-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #3B82F6, #10B981);
    transition: width 0.4s ease-out, background 0.4s ease-out;
  }

  .power-desc-text {
    font-size: 0.82rem;
    color: #94A3B8 !important;
    margin: 8px 0 0;
    line-height: 1.45;
  }

  /* Cart Sticky Card */
  .cart-sticky-card {
    background: #1C2940;
    padding: 26px;
    border-radius: 18px;
    border: 1px solid rgba(56, 189, 248, 0.25);
    position: sticky;
    top: 130px;
    box-shadow: 0 16px 36px rgba(7, 31, 58, 0.2);
  }

  .cart-card-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: #FFFFFF !important;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(148, 163, 184, 0.25);
    padding-bottom: 14px;
    margin-bottom: 16px;
  }

  .cart-card-title span {
    color: #FFFFFF !important;
  }

  .cart-card-title span i {
    color: #20B7FF !important;
    margin-right: 6px;
  }

  .cart-count-pill {
    background: #2563EB;
    color: #FFFFFF !important;
    font-size: 0.72rem;
    padding: 3px 10px;
    border-radius: 20px;
    font-weight: 800;
  }

  .cart-items-list {
    list-style: none;
    padding: 0;
    margin: 0 0 16px 0;
    min-height: 50px;
  }

  .cart-item-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid rgba(148, 163, 184, 0.15);
    color: #D7E6F5 !important;
    font-size: 0.88rem;
  }

  .cart-item-row strong {
    color: #FFFFFF !important;
  }

  .cart-empty-msg {
    color: #94A3B8 !important;
    font-style: italic;
    font-size: 0.88rem;
    text-align: center;
    padding: 12px 0;
  }

  .cart-addons-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 12px;
    padding: 14px;
    margin-bottom: 18px;
  }

  .addons-title {
    font-size: 0.78rem;
    color: #38BDF8 !important;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 10px;
  }

  .addon-option-label {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    padding: 8px 10px;
    border-radius: 8px;
    border: 1px solid #334155;
    background: #101A31;
    margin-bottom: 8px;
  }

  .addon-checkbox {
    accent-color: #2563EB;
    width: 16px;
    height: 16px;
  }

  .addon-text {
    flex: 1;
  }

  .addon-text strong {
    display: block;
    color: #F8FAFC !important;
    font-size: 0.84rem;
  }

  .addon-text p {
    margin: 0;
    color: #94A3B8 !important;
    font-size: 0.74rem;
  }

  .addon-price {
    color: #10B981 !important;
    font-weight: 800;
    font-size: 0.84rem;
  }

  .addon-included-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 8px;
    border: 1px solid rgba(16, 185, 129, 0.3);
    background: rgba(16, 185, 129, 0.06);
  }

  .badge-free {
    background: rgba(16, 185, 129, 0.2);
    color: #10B981 !important;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 6px;
  }

  .cart-total-section {
    border-top: 1px solid rgba(148, 163, 184, 0.25);
    padding-top: 14px;
    margin-bottom: 14px;
  }

  .cart-total-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 4px;
  }

  .total-label {
    color: #9FB3C8 !important;
    font-size: 0.88rem;
  }

  .total-amount {
    font-size: 1.85rem;
    font-weight: 900;
    color: #FFFFFF !important;
    line-height: 1;
  }

  .total-amount small {
    font-size: 0.85rem;
    color: #9FB3C8 !important;
  }

  .cart-fine-print {
    font-size: 0.72rem;
    color: #94A3B8 !important;
    margin: 6px 0 0;
    line-height: 1.4;
  }

  .btn-cart-submit {
    width: 100%;
    padding: 15px;
    border-radius: 12px;
    background: linear-gradient(90deg, #2563EB, #3B82F6);
    color: #FFFFFF !important;
    font-weight: 800;
    font-size: 1rem;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-cart-submit.disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  /* Focus and Accessibility */
  .mode-tab:focus-visible,
  .rec-opt-btn:focus-visible,
  .budget-btn:focus-visible,
  .btn-rec-edit:focus-visible,
  .btn-whatsapp-full:focus-visible,
  .builder-select:focus-visible,
  .btn-cart-submit:focus-visible,
  .addon-checkbox:focus-visible {
    outline: 2px solid #2563EB;
    outline-offset: 2px;
  }

  .rec-opt-btn:focus-visible,
  .budget-btn:focus-visible,
  .btn-rec-edit:focus-visible,
  .btn-whatsapp-full:focus-visible {
    outline-color: #38BDF8;
  }

  /* Modal */
  .builder-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .modal-dialog-card {
    background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
    border-radius: 20px;
    border: 1px solid #334155;
    max-width: 480px;
    width: 100%;
    padding: 32px;
    position: relative;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
  }

  .modal-close-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    background: none;
    border: none;
    color: #64748b;
    font-size: 1.3rem;
    cursor: pointer;
  }

  .modal-header-icon {
    width: 56px;
    height: 56px;
    background: rgba(37, 99, 235, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #60a5fa;
    font-size: 1.5rem;
    margin: 0 auto 16px;
  }

  .modal-dialog-card h3 {
    font-size: 1.4rem;
    font-weight: 800;
    color: #ffffff !important;
    text-align: center;
    margin-bottom: 6px;
  }

  .modal-sub {
    font-size: 0.9rem;
    color: #94a3b8 !important;
    text-align: center;
    margin-bottom: 20px;
  }

  .modal-addon-item {
    background: #0f172a;
    border: 2px solid #475569;
    border-radius: 14px;
    padding: 16px;
    margin-bottom: 20px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .addon-check-box {
    width: 22px;
    height: 22px;
    border: 2px solid #64748b;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 0.7rem;
  }

  .modal-addon-info {
    flex: 1;
  }

  .modal-addon-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }

  .modal-addon-title-row strong {
    color: #e2e8f0 !important;
    font-size: 0.92rem;
  }

  .modal-addon-price {
    color: #8b5cf6 !important;
    font-weight: 800;
    font-size: 0.92rem;
  }

  .modal-addon-info p {
    color: #64748b !important;
    font-size: 0.8rem;
    margin: 0;
    line-height: 1.35;
  }

  .modal-actions-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* 10. COMPATIBILIDAD GRID */
  .compat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  .compat-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 28px;
  }

  .compat-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(37, 99, 235, 0.1);
    color: #2563eb;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    margin-bottom: 16px;
  }

  .compat-card h3 {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--azul-oscuro) !important;
    margin-bottom: 8px;
  }

  .compat-card p {
    font-size: 0.92rem;
    color: #475569 !important;
    line-height: 1.55;
    margin: 0;
  }

  /* 11. PROCESO STEPS */
  .process-steps-list {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .process-step-item {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 24px;
  }

  .step-badge-number {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #071F3A;
    color: #ffffff !important;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    font-weight: 800;
    flex-shrink: 0;
  }

  .step-content h3 {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--azul-oscuro) !important;
    margin-bottom: 6px;
  }

  .step-content p {
    font-size: 0.94rem;
    color: #475569 !important;
    line-height: 1.55;
    margin: 0;
  }

