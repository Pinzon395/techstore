  function money(value: number) {
    return (Number(value) || 0).toLocaleString('es-MX');
  }

  function selectedOption(sel: HTMLSelectElement | null) {
    if (!sel || sel.value === '' || sel.selectedIndex < 0) return null;
    return sel.options[sel.selectedIndex] || null;
  }

  function selectedPrice(sel: HTMLSelectElement | null) {
    const opt = selectedOption(sel);
    return parseInt(opt?.getAttribute('data-price') || '0', 10) || 0;
  }

  function updateBuilder() {
    const cpu = document.getElementById('b-cpu') as HTMLSelectElement | null;
    const gpu = document.getElementById('b-gpu') as HTMLSelectElement | null;
    const ram = document.getElementById('b-ram') as HTMLSelectElement | null;
    const ssd = document.getElementById('b-ssd') as HTMLSelectElement | null;
    const base = document.getElementById('b-base') as HTMLSelectElement | null;
    if (!cpu || !gpu || !ram || !ssd || !base) return;

    const warranty = document.getElementById('addon-warranty') as HTMLInputElement | null;
    const windows = document.getElementById('addon-windows') as HTMLInputElement | null;

    let total = 0;
    let summaryHtml = '';
    let count = 0;

    const slots = [
      { sel: cpu, id: 'cpu', icon: 'fa-microchip', label: 'CPU' },
      { sel: gpu, id: 'gpu', icon: 'fa-display', label: 'GPU' },
      { sel: ram, id: 'ram', icon: 'fa-memory', label: 'RAM' },
      { sel: ssd, id: 'ssd', icon: 'fa-hard-drive', label: 'SSD' },
      { sel: base, id: 'base', icon: 'fa-box', label: 'Base' }
    ];

    slots.forEach(({ sel, id, icon }) => {
      const badge = document.getElementById(id + '-badge');
      if (sel.value !== '') {
        const price = selectedPrice(sel);
        total += price;
        count++;
        const name = sel.options[sel.selectedIndex].getAttribute('data-name');
        summaryHtml += `<li style="margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;gap:10px;">
          <span style="display:flex;align-items:center;gap:8px;color:#cbd5e1;font-size:0.88rem;min-width:0;"><i class="fa-solid ${icon}" style="color:#38bdf8;width:14px;"></i><span style="overflow-wrap:anywhere;">${name}</span></span>
          <span style="color:#fff;white-space:nowrap;font-size:0.88rem;font-weight:700;">$${money(price)}</span>
        </li>`;
        if (badge) badge.style.display = 'inline-block';
      } else {
        if (badge) badge.style.display = 'none';
      }
    });

    const isComplete = slots.every(({ sel }) => sel.value !== '');
    if (isComplete) {
      const assemblyFee = parseInt((document.getElementById('builder') as HTMLElement | null)?.getAttribute('data-assembly-fee') || '1400', 10) || 1400;
      total += assemblyFee;
      summaryHtml += `<li style="margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;border-top:1px dashed #334155;padding-top:10px;margin-top:5px;">
        <span style="color:#cbd5e1;font-size:0.88rem;"><i class="fa-solid fa-screwdriver-wrench" style="color:#38bdf8;width:14px;margin-right:8px;"></i>Ensamble Profesional + Pruebas</span>
        <span style="color:#fff;font-size:0.88rem;font-weight:700;">$${money(assemblyFee)}</span>
      </li>`;
    }

    if (warranty && warranty.checked) {
      total += 1120;
      summaryHtml += `<li style="margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;">
        <span style="color:#10b981;font-size:0.88rem;"><i class="fa-solid fa-shield-halved" style="width:14px;margin-right:8px;"></i>Garantía Extendida +6m</span>
        <span style="color:#10b981;font-size:0.88rem;font-weight:700;">$1,120</span>
      </li>`;
    }
    if (windows && windows.checked) {
      total += 700;
      summaryHtml += `<li style="margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;">
        <span style="color:#10b981;font-size:0.88rem;"><i class="fa-brands fa-windows" style="width:14px;margin-right:8px;"></i>Instalación Windows 11</span>
        <span style="color:#10b981;font-size:0.88rem;font-weight:700;">$700</span>
      </li>`;
    }

    if (summaryHtml === '') {
      summaryHtml = '<li class="cart-empty-msg">Aún no has seleccionado componentes...</li>';
    }

    const builderSummary = document.getElementById('builder-summary');
    const builderTotal = document.getElementById('builder-total');
    if (builderSummary) builderSummary.innerHTML = summaryHtml;
    if (builderTotal) builderTotal.innerHTML = '$' + money(total) + ' <small>MXN</small>';
    const cc = document.getElementById('cart-count');
    if (cc) cc.textContent = count + (count === 1 ? ' pieza' : ' piezas');

    // Power Meter & Compatibility Calculations
    const powerBar = document.getElementById('power-bar');
    const powerLabel = document.getElementById('power-label');
    const powerDesc = document.getElementById('power-desc');

    const perfOf = (sel: HTMLSelectElement | null) => {
      if (!sel || sel.value === '' || sel.selectedIndex < 0) return 0;
      return parseInt(sel.options[sel.selectedIndex].getAttribute('data-perf') || '0') || 0;
    };
    const dataAttr = (sel: HTMLSelectElement | null, attr: string) => {
      if (!sel || sel.value === '' || sel.selectedIndex < 0) return '0';
      return sel.options[sel.selectedIndex].getAttribute(attr) || '0';
    };

    if (powerBar && powerLabel && powerDesc) {
      if (count === 0) {
        powerBar.style.width = '0%';
        powerBar.style.background = 'linear-gradient(90deg,#3b82f6,#10b981)';
        powerLabel.textContent = 'Sin selección';
        powerLabel.style.color = '#64748b';
        powerDesc.textContent = 'Selecciona componentes para ver el rendimiento estimado.';
      } else {
        const cpuPerf = perfOf(cpu);
        const gpuPerf = perfOf(gpu);
        const ramPerf = perfOf(ram);
        const ssdPerf = perfOf(ssd);
        const basePerf = perfOf(base);

        let score = (gpuPerf * 0.50) + (cpuPerf * 0.28) + (ramPerf * 0.10) + (basePerf * 0.08) + (ssdPerf * 0.04);

        const gpuDedicated = dataAttr(gpu, 'data-dedicated') === '1';
        const cpuHasIgpu = dataAttr(cpu, 'data-igpu') === '1';
        const ramGB = parseInt(dataAttr(ram, 'data-gb')) || 0;
        const psuWatts = parseInt(dataAttr(base, 'data-watts')) || 0;
        const gpuPsu = parseInt(dataAttr(gpu, 'data-recommended-psu')) || 0;
        const cpuSocket = dataAttr(cpu, 'data-socket');
        const basePlatform = dataAttr(base, 'data-platform');

        if (gpu.value !== '' && !gpuDedicated && cpu.value !== '' && !cpuHasIgpu) {
          score = Math.min(score, 8);
        }

        score = Math.max(0, Math.min(100, Math.round(score)));

        let tierText = '', tierColor = '', tierGradient = '', tierDesc = '';
        if (score >= 80) {
          tierGradient = 'linear-gradient(90deg,#8b5cf6,#d946ef)';
          tierText = 'Ultra / 4K';
          tierColor = '#d946ef';
          tierDesc = '144+ FPS en 1440p Ultra. Listo para 4K y flujos profesionales.';
        } else if (score >= 60) {
          tierGradient = 'linear-gradient(90deg,#3b82f6,#10b981)';
          tierText = 'Gama Alta / 1440p';
          tierColor = '#10b981';
          tierDesc = '1440p Ultra estable; 1080p competitivo a alta frecuencia de refresco.';
        } else if (score >= 40) {
          tierGradient = 'linear-gradient(90deg,#0ea5e9,#2dd4bf)';
          tierText = 'Gama Media / 1080p';
          tierColor = '#2dd4bf';
          tierDesc = '1080p High-Ultra y eSports a alta tasa de cuadros.';
        } else if (score >= 20) {
          tierGradient = 'linear-gradient(90deg,#0ea5e9,#3b82f6)';
          tierText = 'Gama Entrada';
          tierColor = '#60a5fa';
          tierDesc = '1080p Medium en juegos modernos; eSports sin problemas.';
        } else {
          tierGradient = 'linear-gradient(90deg,#64748b,#94a3b8)';
          tierText = 'Básica / Oficina';
          tierColor = '#94a3b8';
          tierDesc = 'Tareas diarias, oficina, facturación y juegos ligeros.';
        }

        const isPartial = count < 5;
        const missing = [];
        if (cpu.value === '') missing.push('CPU');
        if (gpu.value === '') missing.push('GPU');
        if (ram.value === '') missing.push('RAM');
        if (ssd.value === '') missing.push('SSD');
        if (base.value === '') missing.push('Kit Base');

        powerBar.style.width = score + '%';
        powerBar.style.background = tierGradient;
        powerLabel.textContent = (isPartial ? 'Parcial ⬢ ' : '') + tierText;
        powerLabel.style.color = tierColor;

        const warns: string[] = [];
        if (gpu.value !== '' && !gpuDedicated && cpu.value !== '' && !cpuHasIgpu) {
          warns.push('Sin GPU dedicada y CPU sin gráficos integrados: no habrá salida de video. Elige un procesador con iGPU o añade una tarjeta gráfica.');
        }
        if (gpuPsu > 0 && psuWatts > 0 && psuWatts < gpuPsu) {
          warns.push('La tarjeta gráfica seleccionada recomienda fuente de ' + gpuPsu + 'W o superior. Te sugerimos subir a un Kit Base con mayor potencia.');
        }
        const ramMemoryType = dataAttr(ram, 'data-memory-type');
        const baseMemoryType = dataAttr(base, 'data-memory-type');

        if (cpuSocket && basePlatform && !basePlatform.includes(cpuSocket)) {
          warns.push('Incompatibilidad CPU / Placa: socket ' + cpuSocket + ' no empareja con la plataforma ' + basePlatform + '.');
        }
        if (cpuSocket === 'AM4' && ramMemoryType === 'DDR5') {
          warns.push('Incompatibilidad RAM: Los procesadores AMD AM4 utilizan memoria DDR4.');
        }
        if (cpuSocket === 'AM5' && ramMemoryType === 'DDR4') {
          warns.push('Incompatibilidad RAM: La plataforma AMD AM5 requiere memoria DDR5.');
        }
        if (cpuSocket === 'LGA1851' && ramMemoryType === 'DDR4') {
          warns.push('Incompatibilidad RAM: Intel Core Ultra requiere memoria DDR5.');
        }
        if (baseMemoryType && ramMemoryType && baseMemoryType !== ramMemoryType) {
          warns.push('Incompatibilidad Kit Base y RAM: El kit es para ' + baseMemoryType + ' pero seleccionaste ' + ramMemoryType + '.');
        }

        let descHtml = '<strong style="color:#cbd5e1;">Score: ' + score + '/100</strong> · ' + tierDesc;
        if (isPartial) {
          descHtml += '<br><span style="color:#38bdf8;">Falta seleccionar: ' + missing.join(', ') + '.</span>';
        }
        if (warns.length) {
          descHtml += '<br><span style="color:#f59e0b;font-weight:700;">Atención técnica: ' + warns.join(' · ') + '</span>';
        }
        powerDesc.innerHTML = descHtml;
      }
    }

    const btn = document.getElementById('builder-btn');
    if (btn) {
      if (isComplete) {
        btn.classList.remove('disabled');
        btn.innerHTML = 'Continuar Configuración <i class="fa-solid fa-arrow-right" style="margin-left:5px;"></i>';
      } else {
        btn.classList.add('disabled');
        btn.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> Rellena todos los campos';
      }
    }
  }

  (window as any).updateBuilder = updateBuilder;

  // Cross-sell modal
  let crossSellSelected = false;

  (window as any).showCrossSellModal = function () {
    const m = document.getElementById('cross-sell-modal');
    if (m) m.style.display = 'flex';
  };
  (window as any).closeCrossSellModal = function () {
    const m = document.getElementById('cross-sell-modal');
    if (m) m.style.display = 'none';
  };
  (window as any).toggleAddon = function (addonId: string) {
    crossSellSelected = !crossSellSelected;
    const container = document.getElementById('addon-' + addonId);
    const check = document.getElementById('addon-kit-check');
    if (!container || !check) return;
    const icon = check.querySelector('i');
    if (crossSellSelected) {
      container.style.borderColor = '#8b5cf6';
      container.style.background = 'rgba(139,92,246,0.1)';
      check.style.borderColor = '#8b5cf6';
      check.style.background = '#8b5cf6';
      if (icon) icon.style.display = 'block';
    } else {
      container.style.borderColor = '#475569';
      container.style.background = '#0f172a';
      check.style.borderColor = '#64748b';
      check.style.background = 'transparent';
      if (icon) icon.style.display = 'none';
    }
  };

  (window as any).finishConfigWithAddons = function () {
    (window as any).closeCrossSellModal();
    const cpu = document.getElementById('b-cpu') as HTMLSelectElement | null;
    const gpu = document.getElementById('b-gpu') as HTMLSelectElement | null;
    const ram = document.getElementById('b-ram') as HTMLSelectElement | null;
    const ssd = document.getElementById('b-ssd') as HTMLSelectElement | null;
    const base = document.getElementById('b-base') as HTMLSelectElement | null;
    const warranty = document.getElementById('addon-warranty') as HTMLInputElement | null;
    const windows = document.getElementById('addon-windows') as HTMLInputElement | null;
    if (!cpu || !gpu || !ram || !ssd || !base) return;

    let msg = 'Hola Pixon PC! Armé una PC personalizada en su configurador y deseo cotizar disponibilidad:\n\n';
    const appendComponent = (label: string, sel: HTMLSelectElement) => {
      if (!sel.value) return;
      const opt = sel.options[sel.selectedIndex];
      const name = opt.getAttribute('data-name') || '';
      const price = parseInt(opt.getAttribute('data-price') || '0', 10) || 0;
      msg += `${label}: ${name} - $${price.toLocaleString('es-MX')} MXN\n`;
    };
    appendComponent('CPU', cpu);
    appendComponent('GPU', gpu);
    appendComponent('RAM', ram);
    appendComponent('SSD', ssd);
    appendComponent('Kit Base', base);

    const assemblyFee = parseInt((document.getElementById('builder') as HTMLElement | null)?.getAttribute('data-assembly-fee') || '1400', 10) || 1400;
    msg += 'Ensamble y Pruebas: $' + assemblyFee.toLocaleString('es-MX') + ' MXN\n';

    if (warranty && warranty.checked) msg += 'Garantía Extendida +6m: $1,120 MXN\n';
    if (windows && windows.checked) msg += 'Instalación Windows 11: $700 MXN\n';
    if (crossSellSelected) msg += 'Kit Periféricos RGB: $839 MXN\n';

    const totalText = (document.getElementById('builder-total') as HTMLElement | null)?.innerText.replace(/[^\d]/g, '') || '0';
    let finalTotal = parseInt(totalText) || 0;
    if (crossSellSelected) finalTotal += 839;

    msg += '\nTotal Estimado: $' + finalTotal.toLocaleString('es-MX') + ' MXN\n';
    msg += 'Favor de confirmar disponibilidad de componentes en Cancún.';

    const url = 'https://wa.me/529986690777?text=' + encodeURIComponent(msg);
    if ((window as any).smartWaRedirect) (window as any).smartWaRedirect(url);
    else window.open(url, '_blank');
  };

  document.addEventListener('DOMContentLoaded', () => {
    renderRecommendedResult();
  });
</script>
