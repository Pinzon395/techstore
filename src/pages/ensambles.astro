  .biz-card-icon {
    font-size: 2rem;
    color: #2563eb;
    margin-bottom: 16px;
  }

  .biz-card h2 {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--azul-oscuro) !important;
    margin-bottom: 12px;
  }

  .biz-card p {
    font-size: 0.95rem;
    color: #475569 !important;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .biz-checklist {
    list-style: none;
    padding: 0;
    margin: 0 0 24px 0;
  }

  .biz-checklist li {
    font-size: 0.9rem;
    color: #334155 !important;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
