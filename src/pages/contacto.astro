---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import DeviceButtons from '../components/DeviceButtons.astro';
import FaqSection from '../components/FaqSection.astro';
import CommentsSection from '../components/CommentsSection.astro';
import { buildBreadcrumbSchema, buildFAQSchema } from '../lib/schema';

const faqs = [
  { question: '¿En qué horario están disponibles?', answer: 'Lunes a domingo de <strong>9:00 a 19:00</strong>. Por WhatsApp respondemos hasta más tarde si tu caso es urgente. Llegamos a domicilio toda Cancún y zonas conurbadas.' },
  { question: '¿Hacen recolección a domicilio?', answer: 'Sí. Recolectamos y entregamos en Cancún sin costo adicional para servicios de $800 MXN o más. Para servicios menores el envío redondo cuesta $100 MXN.' },
  { question: '¿Aceptan tarjeta o transferencia?', answer: 'Aceptamos efectivo, transferencia bancaria, OXXO y depósito. Para servicios mayores a $5000 MXN podemos cotizar pago a 15-30 días si tu empresa lo requiere.' },
  { question: '¿Dan factura?', answer: 'Sí, <strong>CFDI 4.0</strong> para personas físicas y morales. Solicítala al momento del servicio o hasta 30 días después.' },
];

const schema = [
  buildBreadcrumbSchema([
    { label: 'Inicio', href: '/' },
    { label: 'Contacto', href: '/contacto' },
  ]),
  buildFAQSchema(faqs),
];
---

<Base
  title="Contacto y Ubicación Cancún | Pixon PC"
  description="Contacta a Pixon PC en Cancún. WhatsApp +52 998 669 0777. Ubicados en Haciendas, Cancún, Q. Roo. Reparación de computadoras con cita. English Spoken."
  canonical="https://pixon.com.mx/contacto"
  image="/LOGOCIRCULAR.png"
  schema={schema}
>
  <Navbar />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Contacto' }]} />

    <div class="page-hero dark-bg-hero">
        <div class="container text-center">
            <h1 class="page-hero__title">Ubicación y <span class="gradient-text-dark">Contacto</span></h1>
            <p class="page-hero__sub">Encuéntranos en Cancún, Quintana Roo. Respuesta rápida por WhatsApp. English Spoken.</p>
        </div>
    </div>

    <!-- 1. VISTA: TARJETAS DE CONTACTO PRINCIPAL -->
    <section class="section-padding" style="background: #f8fafc; margin-top: -40px; position: relative; z-index: 10;">
        <div class="container">
            <div class="contact-cards-grid">
                <!-- Card 1: WhatsApp -->
                <div style="background: #fff; padding: 40px 30px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); text-align: center; border-bottom: 4px solid #25d366; transition: transform 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                    <div class="contact-card__icon-box">
                        <i class="fa-brands fa-whatsapp"></i>
                    </div>
                    <h3 style="font-size: 1.4rem; color: #0f172a; margin-bottom: 10px;">Chat Directo</h3>
                    <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 20px;">Cotizaciones rápidas y dudas técnicas por WhatsApp.</p>
                    <a href="https://wa.me/529986690777?text=Hola%2C%20quiero%20una%20cotizaci%C3%B3n" target="_blank" rel="noopener noreferrer" class="btn" style="background: #25d366; color: white; width: 100%; border-radius: 12px; font-weight: bold;">Contactar por WhatsApp</a>
                </div>

                <!-- Card 2: Ubicación -->
                <div style="background: #fff; padding: 40px 30px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); text-align: center; border-bottom: 4px solid #3b82f6; transition: transform 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                    <div class="contact-card__icon-box">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>
                    <h3 style="font-size: 1.4rem; color: #0f172a; margin-bottom: 10px;">Taller Físico</h3>
                    <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 20px;">Haciendas Real del Caribe,<br>Cancún, Q. Roo 77539.</p>
                    <a href="https://wa.me/529986690777?text=Hola%2C%20quiero%20confirmar%20la%20ubicaci%C3%B3n%20del%20taller" target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="width: 100%; border-radius: 12px; color: #3b82f6; border-color: #3b82f6;">Consultar ubicación</a>
                </div>

                <!-- Card 3: Horarios -->
                <div style="background: #fff; padding: 40px 30px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); text-align: center; border-bottom: 4px solid #8b5cf6; transition: transform 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                    <div class="contact-card__icon-box">
                        <i class="fa-solid fa-clock"></i>
                    </div>
                    <h3 style="font-size: 1.4rem; color: #0f172a; margin-bottom: 10px;">Atención</h3>
                    <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 20px;">Lunes a Domingo<br><strong style="color:#0f172a;">Trabajamos bajo previa cita</strong></p>
                    <a href="https://wa.me/529986690777?text=Quiero%20agendar%20una%20cita%20para%20llevar%20mi%20equipo" target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="width: 100%; border-radius: 12px; color: #8b5cf6; border-color: #8b5cf6;">Agendar revisión</a>
                </div>

                <!-- Card 4: Correo -->
                <div style="background: #fff; padding: 40px 30px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); text-align: center; border-bottom: 4px solid #0ea5e9; transition: transform 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                    <div class="contact-card__icon-box">
                        <i class="fa-solid fa-envelope"></i>
                    </div>
                    <h3 style="font-size: 1.4rem; color: #0f172a; margin-bottom: 10px;">Correo</h3>
                    <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 20px;">Envía fotos, datos del equipo o detalles del problema por email.</p>
                    <a href="mailto:pixonpc@gmail.com" class="btn btn-outline" style="width: 100%; border-radius: 12px; color: #0ea5e9; border-color: #0ea5e9;">pixonpc@gmail.com</a>
                </div>
            </div>
        </div>
    </section>

    <DeviceButtons
      title="¿Qué equipo necesitas reparar hoy?"
      description="Selecciona tu dispositivo para dirigirte al área correspondiente y darte prioridad."
      devices={[
        { icon: 'fa-solid fa-laptop', label: 'Laptop', waText: 'Quiero%20reparar%20una%20Laptop', color: '#3b82f6' },
        { icon: 'fa-solid fa-desktop', label: 'PC / Gamer', waText: 'Quiero%20reparar%20una%20PC%20Gamer', color: '#8b5cf6' },
        { icon: 'fa-solid fa-mobile-screen-button', label: 'Celular', waText: 'Quiero%20reparar%20un%20Celular', color: '#10b981' },
        { icon: 'fa-solid fa-gamepad', label: 'Consola', waText: 'Quiero%20reparar%20una%20Consola', color: '#f59e0b' },
        { icon: 'fa-solid fa-print', label: 'Impresora', waText: 'Quiero%20reparar%20una%20Impresora', color: '#ef4444' },
      ]}
      extraLinks={[
        { href: '/instalacion-windows', label: 'Optimización de Software', icon: 'fa-solid fa-rocket' },
        { href: '/reparacion-bisagras', label: 'Reparación de Bisagras', icon: 'fa-solid fa-tools' },
      ]}
    />

    <!-- 3. VISTA: PROCESO CORPORATIVO / AUDITORÍA (Confianza) -->
    <section class="section-padding" style="background: #f8fafc;">
        <div class="container">
            <div class="section-title text-center" style="margin-bottom: 40px;">
                <h2 style="font-size: 2rem; color: #0f172a;">Protocolo de Ingreso</h2>
                <p style="color: #64748b; max-width: 600px; margin: 0 auto;">Aplicamos estándares corporativos para proteger la integridad de tu equipo y tu información.</p>
            </div>
            
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px; position: relative;">
                <!-- Process 1 -->
                <div style="background: #fff; padding: 30px; border-radius: 16px; border: 1px solid #e2e8f0; position: relative; box-shadow: 0 4px 15px rgba(0,0,0,0.02);">
                    <div style="width: 40px; height: 40px; background: #3b82f6; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 1.2rem; position: absolute; top: -20px; left: 30px; border: 4px solid #f8fafc;">1</div>
                    <h4 style="font-size: 1.2rem; color: #0f172a; margin-top: 10px; margin-bottom: 10px;"><i class="fa-solid fa-clipboard-check" style="color: #3b82f6; margin-right: 8px;"></i>Recepción y Registro</h4>
                    <p style="color: #64748b; font-size: 0.95rem; margin: 0;">Se toma evidencia fotográfica del estado en el que llega el equipo y se emite un folio digital de servicio con tus datos.</p>
                </div>
                <!-- Process 2 -->
                <div style="background: #fff; padding: 30px; border-radius: 16px; border: 1px solid #e2e8f0; position: relative; box-shadow: 0 4px 15px rgba(0,0,0,0.02);">
                    <div style="width: 40px; height: 40px; background: #3b82f6; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 1.2rem; position: absolute; top: -20px; left: 30px; border: 4px solid #f8fafc;">2</div>
                    <h4 style="font-size: 1.2rem; color: #0f172a; margin-top: 10px; margin-bottom: 10px;"><i class="fa-solid fa-microscope" style="color: #3b82f6; margin-right: 8px;"></i>Diagnóstico Preciso</h4>
                    <p style="color: #64748b; font-size: 0.95rem; margin: 0;">Los técnicos evalúan el hardware y software. Te enviamos el reporte y presupuesto exacto vía WhatsApp para tu aprobación.</p>
                </div>
                <!-- Process 3 -->
                <div style="background: #fff; padding: 30px; border-radius: 16px; border: 1px solid #e2e8f0; position: relative; box-shadow: 0 4px 15px rgba(0,0,0,0.02);">
                    <div style="width: 40px; height: 40px; background: #3b82f6; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 1.2rem; position: absolute; top: -20px; left: 30px; border: 4px solid #f8fafc;">3</div>
                    <h4 style="font-size: 1.2rem; color: #0f172a; margin-top: 10px; margin-bottom: 10px;"><i class="fa-solid fa-check-double" style="color: #3b82f6; margin-right: 8px;"></i>Ejecución y Entrega</h4>
                    <p style="color: #64748b; font-size: 0.95rem; margin: 0;">Reparamos el dispositivo documentando el proceso. Se realizan pruebas de estrés corporativas antes de entregarlo.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. VISTA: B2B CORPORATIVO -->
    <section class="section-padding" style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%); color: white;">
        <div class="container">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px; align-items: center;">
                <div>
                    <span style="display:inline-block; background:rgba(255,255,255,0.1); color:#60a5fa; padding:6px 14px; border-radius:20px; font-size:0.8rem; font-weight:700; margin-bottom:15px; border: 1px solid rgba(255,255,255,0.2);">PIXON PC B2B</span>
                    <h2 style="font-size: 2.2rem; margin-bottom: 20px;">Soporte TI para Empresas y Oficinas</h2>
                    <p style="color: #cbd5e1; font-size: 1.05rem; line-height: 1.6; margin-bottom: 20px;">
                        Actuamos como tu brazo tecnológico. Realizamos auditorías de hardware, mantenimiento preventivo de flotillas, estructuración de redes y soporte corporativo en Cancún. Facturamos todos nuestros servicios.
                    </p>
                    <ul style="list-style: none; padding: 0; margin: 0 0 25px 0;">
                        <li style="margin-bottom: 10px; display: flex; align-items: center; gap: 10px;"><i class="fa-solid fa-file-invoice" style="color: #60a5fa;"></i> Facturación Electrónica (CFDI)</li>
                        <li style="margin-bottom: 10px; display: flex; align-items: center; gap: 10px;"><i class="fa-solid fa-shield-halved" style="color: #60a5fa;"></i> Contratos de Confidencialidad (NDA)</li>
                        <li style="display: flex; align-items: center; gap: 10px;"><i class="fa-solid fa-users-gear" style="color: #60a5fa;"></i> Pólizas de Mantenimiento Anual</li>
                    </ul>
                    <button onclick="smartWaRedirect('https://wa.me/529986690777?text=Hola%2C%20represento%20a%20una%20empresa%20y%20me%20interesa%20su%20servicio%20B2B')" class="btn" style="background: white; color: #0f172a; font-weight: bold; border-radius: 30px; padding: 12px 28px;">
                        <i class="fa-solid fa-briefcase"></i> Contactar a Ventas B2B
                    </button>
                </div>
                <div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 40px; border-radius: 24px; text-align: center; backdrop-filter: blur(10px);">
                    <i class="fa-solid fa-building-shield" style="font-size: 5rem; color: #3b82f6; margin-bottom: 20px;"></i>
                    <h3 style="font-size: 1.5rem; margin-bottom: 15px;">¿Tienes más de 5 equipos?</h3>
                    <p style="color: #94a3b8; font-size: 0.95rem; margin-bottom: 0;">Solicita una auditoría de cortesía para evaluar el estado térmico y de rendimiento de la infraestructura tecnológica de tu empresa.</p>
                </div>
            </div>
        </div>
    </section>

    <FaqSection
      title="Preguntas frecuentes sobre nuestros servicios"
      description="Lo más preguntado antes de contactarnos."
      items={faqs}
      viewMoreHref="/preguntas-frecuentes"
      viewMoreLabel="Ver todas las preguntas"
    />

    <CommentsSection viewMoreHref="/comentarios" />

    <!-- ═══ UBICACIÓN (cargada desde componente compartido) ═══ -->
<style>
  .contact-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
  }

  .contact-card__icon-box {
    width: 56px;
    height: 56px;
    margin: 0 auto 20px;
    border-radius: 14px;
    background: #eaf2ff;
    color: #3b82f6;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 56px;
  }

  .contact-card__icon-box i {
    font-size: 24px;
    color: #3b82f6;
  }

  @media (max-width: 640px) {
    .contact-cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
  <Footer />
</Base>
