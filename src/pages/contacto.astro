  }
  .cp-hero__signals span {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #38536d !important;
  }

  /* Technical Console (Hero Right Column) */
  .cp-console {
    position: relative;
    border: 1px solid rgba(133, 204, 239, 0.18);
    border-radius: 12px;
    padding: 24px;
    background: rgba(6, 25, 45, 0.9);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
  }
  .cp-console :is(strong, span, p, small, a) {
