    display: flex;
    align-items: center;
    gap: 6px;
    color: #8ce8c4 !important;
    font-size: 0.72rem;
    font-weight: 800;
  }
  .cp-console__status i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #35d39a;
  }
  .cp-console__route {
    display: grid;
    grid-template-columns: 36px 1fr 36px 1fr 36px;
    align-items: center;
    margin: 24px 0;
  }
  .route-node {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    color: #8eabc5 !important;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    font-size: 0.84rem;
  }
  .route-node--active {
    color: #071f3a !important;
    background: var(--cp-accent);
    border-color: var(--cp-accent);
  }
  .route-line {
    height: 1px;
    background: rgba(255, 255, 255, 0.15);
    position: relative;
  }
  .route-line i {
    position: absolute;
    width: 6px;
    height: 6px;
    right: 30%;
    top: -2.5px;
    border-radius: 50%;
    background: var(--cp-accent);
  }
  .cp-console__row {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 12px;
  }
  .cp-console__row span {
    color: #8daac3 !important;
    font-size: 0.75rem;
  }
  .cp-console__row strong {
    font-size: 0.8rem;
    font-weight: 700;
  }
  .cp-console__message {
    padding: 12px 14px;
    border-left: 2px solid var(--cp-accent);
    background: rgba(66, 197, 245, 0.05);
    border-radius: 0 8px 8px 0;
