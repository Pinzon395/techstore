---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FaqSection from '../components/FaqSection.astro';
import SpriteIcon from '../components/LocalSpriteIcon.astro';
import CommentsSection from '../components/CommentsSection.astro';
import ContactSection from '../components/ContactSection.astro';
import { buildBreadcrumbSchema, buildFAQSchema } from '../lib/schema';

const faqs = [
  { question: '¿Necesito cita para llevar mi equipo?', answer: 'Sí. Trabajamos con cita previa para recibir tu equipo con orden y revisar disponibilidad de los técnicos.' },
  { question: '¿Es mejor crear ticket o mandar WhatsApp?', answer: 'Para reparar un equipo, lo mejor es crear ticket: queda registrado, tiene folio y puedes consultar el avance. WhatsApp es ideal para dudas rápidas o enviar fotos de la falla antes de acudir.' },
  { question: '¿El ticket tiene costo?', answer: 'Crear el ticket no tiene costo. El diagnóstico o revisión se confirma según el tipo de equipo y la falla reportada.' },
  { question: '¿El 10% de descuento aplica a todo?', answer: 'No. Aplica sobre mano de obra del servicio elegible después del diagnóstico. No aplica en refacciones, traslados fuera de zona base o trabajos de terceros.' },
  { question: '¿Puedo llevar mi equipo sin avisar?', answer: 'Lo recomendable es confirmar disponibilidad por WhatsApp antes de trasladarte para asegurar atención inmediata.' },
  { question: '¿Atienden empresas en Cancún?', answer: 'Sí. Pixon PC atiende empresas, oficinas y negocios en Cancún. Ofrecemos soporte B2B por lote, pólizas de mantenimiento y factura CFDI.' },
  { question: '¿Dan factura?', answer: 'Sí, se puede solicitar CFDI al momento del servicio sin costo adicional.' },
  { question: '¿Puedo consultar el avance de mi reparación?', answer: 'Sí. Creando un ticket con tu cuenta puedes ver el estado en tiempo real: recibido, en diagnóstico, en reparación o listo para entrega.' },
  { question: '¿Cuánto tarda una reparación de laptop o PC?', answer: 'Depende de la falla. Una limpieza o mantenimiento preventivo puede entregarse el mismo día. Cambio de pantalla, batería o instalación de Windows suele tardar 1 a 2 días hábiles. Reparaciones de placa madre o situaciones con daño por líquido pueden tardar entre 3 y 6 días hábiles, dependiendo de la disponibilidad de refacciones en Cancún.' },
  { question: '¿Atienden en Zona Hotelera, Huayacán y otras zonas de Cancún?', answer: 'El taller está ubicado en Haciendas, Cancún. Para recolección y entrega a domicilio cubrimos Cancún Centro, Zona Hotelera, Cumbres, Huayacán, Bonfil, Polígono Sur, Supermanzanas, Puerto Juárez, Bonampak y Av. Tulum. Consulta disponibilidad y costo de traslado por WhatsApp antes de agendar.' },
];

const schema = [
  buildBreadcrumbSchema([
    { label: 'Inicio', href: '/' },
    { label: 'Contacto', href: '/contacto' },
  ]),
  buildFAQSchema(faqs),
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contacto Pixon PC – Soporte Técnico en Cancún",
    "description": "Página de contacto oficial de Pixon PC en Cancún. Crea tu ticket de reparación, agenda diagnóstico y contacta por WhatsApp o correo para laptops, PC, celulares, consolas e impresoras.",
    "url": "https://pixon.com.mx/contacto",
    "mainEntity": {
      "@type": "LocalBusiness",
      "@id": "https://pixon.com.mx/#business",
      "name": "Pixon PC",
      "telephone": "+529986690777",
      "email": "pixonpc@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Cto. Hacienda Chimay",
        "addressLocality": "Cancún",
        "addressRegion": "Quintana Roo",
        "postalCode": "77539",
        "addressCountry": "MX"
      },
      "openingHoursSpecification": [{
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
        "description": "Con cita previa – Lunes a Domingo"
      }]
    }
  }
];

const Icon = SpriteIcon;
const waNum = '529986690777';
const waDefault = `https://wa.me/${waNum}?text=Hola%20Pixon%20PC%2C%20necesito%20revisar%20un%20equipo.`;
const waLocation = `https://wa.me/${waNum}?text=Hola%20Pixon%20PC%2C%20quiero%20confirmar%20ubicaci%C3%B3n%20y%20cita.`;
const waData = `https://wa.me/${waNum}?text=Hola%20Pixon%20PC%2C%20quiero%20revisar%20un%20equipo.%20Tipo%3A%20%0AMarca%20y%20modelo%3A%20%0AFalla%3A%20%0ADesde%20cu%C3%A1ndo%3A%20%0A%C2%BFSe%20moj%C3%B3%20o%20golpe%C3%B3%3F%3A%20`;
const ticketUrl = '/tickets';
const authUrl = '/auth/google?returnTo=%2Ftickets';
const authContactUrl = '/auth/google?returnTo=%2Fcontacto';
---

<Base
  title="Contacto Pixon PC Cancún | Ticket de Reparación, Diagnóstico y Soporte Técnico"
  description="Contacta a Pixon PC en Cancún: crea tu ticket de reparación de laptop, PC, celular o consola, agenda diagnóstico técnico y obtén 10% de descuento al registrarte. Atención en Haciendas, Zona Hotelera, Cumbres, Huayacán y toda la ciudad."
  canonical="https://pixon.com.mx/contacto"
  image="/LOGOCIRCULAR.png"
  schema={schema}
  bodyClass="light-theme cp-page"
>
  <Navbar />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Contacto' }]} />

  <main class="cp-main">
    <!-- SECCION 1 — HERO (Light theme layout, dark blue typography) -->
    <section class="cp-hero">
      <div class="cp-shell cp-hero__grid">
        <div class="cp-hero__copy">
          <span class="cp-kicker"><i></i> Diagnóstico Técnico Especializado en Cancún</span>
          <h1>Contacta a Pixon PC en Cancún – Diagnóstico y Reparación Técnica</h1>
          <p>Ofrecemos servicio técnico profesional para computadoras, laptops, consolas y celulares con atención en <strong>Cancún Centro, Zona Hotelera, Huayacán, Cumbres, Bonfil, Polígono Sur</strong> y supermanzanas aledañas. Registra tu equipo en línea para obtener seguimiento o chatea directamente con un técnico.</p>
          
          <div class="cp-hero__actions">
            <a class="cp-btn cp-btn--primary" href={ticketUrl}><Icon name="ticket" /> Crear ticket de reparación</a>
            <a class="cp-btn cp-btn--ghost" href={waDefault} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /> Hablar por WhatsApp</a>
          </div>
          
          <a class="cp-hero__login" href={authContactUrl}><Icon name="arrow-right" /> Iniciar sesión con Google para obtener 10% de descuento</a>
          
          <div class="cp-hero__signals" aria-label="Indicadores de atención">
            <span><Icon name="clock" /> Atención con cita previa</span>
            <span><Icon name="location-dot" /> Cto. Hacienda Chimay, Cancún</span>
            <span><Icon name="shield-halved" /> Diagnóstico antes de reparar</span>
          </div>
        </div>
        
        <div class="cp-console" aria-label="Panel de contacto Pixon PC">
          <div class="cp-console__top">
            <div class="cp-console__brand">
              <img src="/LOGOCIRCULAR.png" alt="Pixon PC" width="44" height="44" />
              <div>
                <strong>Pixon PC</strong>
                <span>Centro de Soporte Local</span>
              </div>
            </div>
            <span class="cp-console__status"><i></i> Disponible</span>
          </div>
          
          <div class="cp-console__route">
            <span class="route-node"><Icon name="mobile-screen" /></span>
            <span class="route-line"><i></i></span>
            <span class="route-node route-node--active"><Icon name="screwdriver-wrench" /></span>
            <span class="route-line"><i></i></span>
            <span class="route-node"><Icon name="circle-check" /></span>
          </div>
          
          <div class="cp-console__row">
            <span><Icon name="clock" /> Proceso sugerido:</span>
            <strong>Crea tu ticket en línea antes de acudir</strong>
          </div>
          
          <div class="cp-console__message">
            <small>Atención optimizada</small>
            <p>Envíanos marca, modelo y falla del equipo para agilizar la cotización previa del diagnóstico.</p>
          </div>
          
          <div class="cp-console__details">
            <a href={`tel:+52${waNum}`}><Icon name="phone" /><span><small>Teléfono</small>+52 998 669 0777</span></a>
            <a href="mailto:pixonpc@gmail.com"><Icon name="paper-plane" /><span><small>Correo</small>pixonpc@gmail.com</span></a>
            <a href="https://maps.google.com/?q=Cto.+Hacienda+Chimay+77539+Cancún+Q.R." target="_blank" rel="noopener noreferrer"><Icon name="location-dot" /><span><small>Ubicación</small>Cto. Hacienda Chimay, 77539 Cancún, Q.R.</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCION 2 — 10% DESCUENTO (Now in Position 2: Light themed, dark blue text) -->
    <section class="cp-discount" aria-labelledby="discount-title">
      <div class="cp-shell cp-discount__grid">
        <div class="cp-discount__visual">
          <div class="discount-number">
            <strong>10%</strong>
            <span>en servicio elegible</span>
          </div>
        </div>
        <div class="cp-discount__copy">
          <span class="cp-label cp-label--amber">Beneficio de Registro</span>
          <h2 id="discount-title">Recibe 10% de descuento al registrar tu equipo en línea</h2>
          <p>Al iniciar sesión con tu cuenta antes de crear tu ticket técnico, obtienes de forma automática un 10% de descuento en la mano de obra del servicio elegible. El beneficio se valida directamente tras concluir el diagnóstico del equipo en nuestro taller en Cancún.</p>
          <p class="cp-discount__legal">Aplica únicamente en la mano de obra del servicio técnico contratado. No aplica sobre el costo de refacciones, traslados a domicilio fuera de la zona de cobertura base, o integraciones de terceros.</p>
          <div class="cp-discount__actions">
            <a class="cp-btn cp-btn--amber" href={authUrl}><Icon name="arrow-right" /> Iniciar sesión y crear ticket</a>
            <a class="cp-btn cp-btn--outline-dark" href={ticketUrl}>Crear ticket sin iniciar sesión <Icon name="arrow-right" /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCION 3 — TICKET (Now in Position 3: Redesigned 2x2 visual card grid, light background) -->
    <section class="cp-ticket" aria-labelledby="ticket-title">
      <div class="cp-shell cp-ticket__grid">
        <div class="cp-ticket__intro">
          <span class="cp-label">Entrada Digital</span>
          <h2 id="ticket-title">Tu reparación de PC y laptop empieza mejor con un ticket de servicio</h2>
          <p>Registra tu orden de soporte técnico desde tu cuenta para asegurar una bitácora detallada de revisión, evitar la pérdida de detalles en chats de WhatsApp y consultar el estatus en tiempo real.</p>
          
          <div class="cp-ticket__benefits">
            <article class="benefit-card">
              <Icon name="ticket" />
              <h3>Folio Único de Servicio</h3>
              <p>Tu orden queda guardada con la marca, modelo, falla inicial y accesorios con los que ingresa.</p>
            </article>
            
            <article class="benefit-card">
              <Icon name="chart-line" />
              <h3>Seguimiento de Avance</h3>
              <p>Monitorea en tiempo real las fases de diagnóstico, refacción autorizada y pruebas finales.</p>
            </article>
            
            <article class="benefit-card">
              <Icon name="microscope" />
              <h3>Diagnóstico de Hardware</h3>
              <p>El técnico recibe toda la descripción previa del síntoma antes de abrir el equipo físico.</p>
            </article>
            
            <article class="benefit-card">
              <Icon name="circle-check" />
              <h3>Control y Transparencia</h3>
              <p>Evita sorpresas: no realizamos reparaciones ni cambios de piezas sin tu autorización expresa.</p>
            </article>
          </div>
          
          <div class="cp-ticket__actions">
            <a class="cp-btn cp-btn--primary" href={ticketUrl}><Icon name="ticket" /> Crear mi ticket ahora</a>
            <a class="cp-btn cp-btn--outline" href="/cuenta"><Icon name="user" /> Ya tengo cuenta</a>
          </div>
        </div>
        
        <div class="cp-ticket__mockup" aria-label="Visualización de ticket de soporte">
          <div class="ticket-mockup__head">
            <span class="ticket-mockup__id"><Icon name="ticket" /> PX-2026-001</span>
            <span class="ticket-mockup__badge">Recibido</span>
          </div>
          <dl class="ticket-mockup__body">
            <div><dt>Equipo</dt><dd>Laptop / PC Gamer / Celular</dd></div>
            <div><dt>Estado</dt><dd>Pendiente de diagnóstico</dd></div>
            <div><dt>Zona de Origen</dt><dd>Cancún Centro</dd></div>
            <div><dt>Canal de Soporte</dt><dd>WhatsApp + Cuenta en línea</dd></div>
          </dl>
          <div class="ticket-mockup__flare" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <!-- SECCION 4 — SELECTOR DE EQUIPO (Grid of device specialties) -->
    <section class="cp-devices" aria-labelledby="devices-title">
      <div class="cp-shell">
        <header class="cp-heading">
          <span class="cp-label">Soporte Especializado</span>
          <h2 id="devices-title">Soporte especializado: ¿Qué equipo necesitas reparar hoy en Cancún?</h2>
          <p>Haz clic en tu dispositivo para ingresar al área técnica correspondiente y registrar los datos precisos de la falla.</p>
        </header>
        
        <div class="device-grid">
          <article class="device-card">
            <div class="device-card__icon"><Icon name="laptop" /><span></span></div>
            <div class="device-card__content">
              <h3>Reparación de Laptops</h3>
              <p>Mantenimiento preventivo, cambio de pantallas, teclados, baterías, reparación de bisagras rotas, reinstalación de Windows y rescate de equipos lentos.</p>
              <a href="/servicios/laptop/">Ver reparación de laptop <Icon name="arrow-right" /></a>
            </div>
          </article>
          
          <article class="device-card">
            <div class="device-card__icon"><Icon name="desktop" /><span></span></div>
            <div class="device-card__content">
              <h3>Soporte para PC y Equipos Gamer</h3>
              <p>Actualización de componentes, ensamble a medida, fallas de fuente de poder, tarjetas de video, sobrecalentamiento y limpieza de metal líquido.</p>
              <a href="/servicios/pc/">Ver reparación de PC <Icon name="arrow-right" /></a>
            </div>
          </article>
          
          <article class="device-card">
            <div class="device-card__icon"><Icon name="mobile-screen-button" /><span></span></div>
            <div class="device-card__content">
              <h3>Reparación de Celulares</h3>
              <p>Diagnóstico de iPhone, Samsung, Xiaomi. Cambio de pantallas, centros de carga, baterías infladas, restauración de software y daños por humedad.</p>
              <a href="/servicios/telefono/">Ver reparación de celular <Icon name="arrow-right" /></a>
            </div>
          </article>
          
          <article class="device-card">
            <div class="device-card__icon"><Icon name="gamepad" /><span></span></div>
            <div class="device-card__content">
              <h3>Soporte para Consolas</h3>
              <p>Servicio técnico para PlayStation 5, Xbox Series X/S y Nintendo Switch. Limpieza profunda, re-pastado térmico, reparación de HDMI y fuentes de poder.</p>
              <a href="/servicios/consola/">Ver reparación de consolas <Icon name="arrow-right" /></a>
            </div>
          </article>
          
          <article class="device-card">
            <div class="device-card__icon"><Icon name="print" /><span></span></div>
            <div class="device-card__content">
              <h3>Mantenimiento de Impresoras</h3>
              <p>Corrección de atascos de papel, rodillos gastados, limpieza de cabezales de inyección, configuración inalámbrica y mantenimiento general de tanques de tinta.</p>
              <a href="/servicios/impresora/">Ver reparación de impresoras <Icon name="arrow-right" /></a>
            </div>
          </article>
          
          <article class="device-card">
            <div class="device-card__icon"><Icon name="building" /><span></span></div>
            <div class="device-card__content">
              <h3>Soporte B2B para Empresas</h3>
              <p>Mantenimiento correctivo y preventivo programado para flotillas de cómputo, diagnóstico de redes cableadas/WiFi y pólizas mensuales para oficinas locales.</p>
              <a href="/b2b/">Ver soporte para empresas <Icon name="arrow-right" /></a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- SECCION 5 — CANALES (Cards detailing communication channels) -->
    <section class="cp-channels" aria-labelledby="channels-title">
      <div class="cp-shell">
        <header class="cp-heading">
          <span class="cp-label">Canales de Atención</span>
          <h2 id="channels-title">Canales de atención directa para soporte técnico y cotizaciones</h2>
          <p>Para brindarte el servicio más rápido posible, elige la vía de contacto que mejor se adapte a tu requerimiento actual.</p>
        </header>
        
        <div class="channel-grid">
          <article class="channel">
            <div class="channel__symbol"><Icon name="ticket" /><i></i></div>
            <span class="channel__number">01</span>
            <h3>Creación de Ticket</h3>
            <p>La vía ideal si requieres ingresar un equipo a revisión física en taller. Garantiza un folio único para rastrear tu diagnóstico e historial de reparaciones.</p>
            <span class="channel__ideal">Recomendado para: Soporte técnico y diagnósticos</span>
            <a href={ticketUrl}>Crear ticket de servicio <Icon name="arrow-right" /></a>
          </article>
          
          <article class="channel">
            <div class="channel__symbol"><Icon name="whatsapp" /><i></i></div>
            <span class="channel__number">02</span>
            <h3>WhatsApp Técnico</h3>
            <p>Perfecto para resolver consultas inmediatas sobre precios estimados, enviar fotos y videos de la falla, y coordinar citas de entrega o recolección de equipos.</p>
            <span class="channel__ideal">Recomendado para: Dudas rápidas y envío de evidencias</span>
            <a href={waDefault} target="_blank" rel="noopener noreferrer">Mandar WhatsApp <Icon name="arrow-right" /></a>
          </article>
          
          <article class="channel">
            <div class="channel__symbol"><Icon name="location-dot" /><i></i></div>
            <span class="channel__number">03</span>
            <h3>Cita en Taller</h3>
            <p>Agenda tu espacio antes de acudir. Atendemos de forma programada para darte una atención personalizada, evitando tiempos muertos o traslados en vano.</p>
            <span class="channel__ideal">Recomendado para: Entrega y retiro presencial de equipos</span>
            <a href={waLocation} target="_blank" rel="noopener noreferrer">Agendar cita de entrega <Icon name="arrow-right" /></a>
          </article>
          
          <article class="channel">
            <div class="channel__symbol"><Icon name="paper-plane" /><i></i></div>
            <span class="channel__number">04</span>
            <h3>Correo Empresarial</h3>
            <p>Canal corporativo para la recepción de licitaciones, solicitudes de cotización formal de soporte por volumen, facturación de servicios y pólizas de soporte B2B.</p>
            <span class="channel__ideal">Recomendado para: Oficinas y requerimientos administrativos</span>
            <a href="mailto:pixonpc@gmail.com">Escribir correo <Icon name="arrow-right" /></a>
          </article>
        </div>
      </div>
    </section>

    <!-- SECCION 6 — PROTOCOLO (Ingreso seguro description) -->
    <section class="cp-protocol" aria-labelledby="protocol-title">
      <div class="cp-shell cp-protocol__grid">
        <div class="protocol-copy">
          <span class="cp-label">Seguridad de Ingreso</span>
          <h2 id="protocol-title">Protocolo de ingreso seguro: Diagnóstico y control de equipo en Cancún</h2>
          <p>Tu equipo no ingresa a ciegas. Seguimos una metodología clara y estructurada para garantizar el cuidado físico e informático de todos tus dispositivos.</p>
          <a class="cp-btn cp-btn--outline" href={ticketUrl}><Icon name="clipboard-check" /> Registrar equipo nuevo</a>
        </div>
        
        <ol class="protocol-list">
          <li>
            <span>01</span>
            <div>
              <Icon name="camera-retro" />
              <h3>Recepción e Inventario</h3>
              <p>Tomamos registro fotográfico de las condiciones estéticas de la laptop o PC, así como de los cables y accesorios entregados.</p>
            </div>
          </li>
          <li>
            <span>02</span>
            <div>
              <Icon name="microscope" />
              <h3>Pruebas y Diagnóstico Técnico</h3>
              <p>Revisamos minuciosamente el hardware y software en busca de la raíz de la falla (temperatura, sectores dañados de disco, cortos en placa madre).</p>
            </div>
          </li>
          <li>
            <span>03</span>
            <div>
              <Icon name="file-contract" />
              <h3>Presupuesto e Autorización</h3>
              <p>Te enviamos por WhatsApp o correo el diagnóstico con el desglose exacto de mano de obra y refacciones sugeridas para tu aprobación.</p>
            </div>
          </li>
          <li>
            <span>04</span>
            <div>
              <Icon name="circle-check" />
              <h3>Ejecución y Control de Calidad</h3>
              <p>Efectuamos la reparación técnica aprobada y corremos pruebas de estrés técnico durante horas para asegurar la estabilidad del equipo.</p>
            </div>
          </li>
          <li>
            <span>05</span>
            <div>
              <Icon name="hand-holding-heart" />
              <h3>Entrega y Consejos de Cuidado</h3>
              <p>Entregamos tu equipo reparado junto con un reporte de lo realizado y recomendaciones técnicas para maximizar su vida útil.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- SECCION 7 — CASOS COMUNES -->
    <section class="cp-cases" aria-labelledby="cases-title">
      <div class="cp-shell">
        <header class="cp-heading">
          <span class="cp-label">Fallas Habituales</span>
          <h2 id="cases-title">Fallas comunes de hardware y software en computadoras y consolas</h2>
          <p>Si identificas alguno de estos problemas en tu equipo, puedes registrarlo directamente en tu ticket técnico para agilizar el diagnóstico previo.</p>
        </header>
        
        <div class="cases-grid">
          <article class="case-card">
            <h3>Lentitud Extrema en Laptop / PC</h3>
            <p>Problema típico causado por discos duros mecánicos desgastados, falta de memoria RAM, exceso de archivos temporales o infecciones por virus informáticos.</p>
            <a href={ticketUrl}>Registrar ticket de equipo lento <Icon name="arrow-right" /></a>
          </article>
          
          <article class="case-card">
            <h3>Computadora No Enciende o No Da Video</h3>
            <p>Se asocia comúnmente a fallas de la fuente de poder, estática acumulada en memorias RAM, problemas del procesador o cortocircuitos en la tarjeta madre.</p>
            <a href={ticketUrl}>Crear ticket por falta de encendido <Icon name="arrow-right" /></a>
          </article>
          
          <article class="case-card">
            <h3>Consola Se Apaga por Sobrecalentamiento</h3>
            <p>El apagón repentino en consolas PS5 o Xbox ocurre por obstrucción de polvo en los disipadores o resecamiento del compuesto de metal líquido/pasta térmica.</p>
            <a href={ticketUrl}>Registrar ticket de consola <Icon name="arrow-right" /></a>
          </article>
          
          <article class="case-card">
            <h3>Impresora con Atasco de Hojas</h3>
            <p>Falla originada por desgaste de las gomas de tracción, engranes rotos, sensores de papel sucios o uso de cartuchos/tóner con fugas de insumos.</p>
            <a href={ticketUrl}>Registrar ticket de impresora <Icon name="arrow-right" /></a>
          </article>
        </div>
      </div>
    </section>

    <!-- SECCION 8 — B2B SUPPORT -->
    <section class="cp-b2b" aria-labelledby="b2b-title">
      <div class="cp-shell cp-b2b__grid">
        <div class="cp-b2b__copy">
          <span class="cp-label">Pólizas de TI y Empresas</span>
          <h2 id="b2b-title">Soporte B2B y mantenimiento de TI para empresas en Cancún</h2>
          <p>Mantenemos las computadoras y redes de tu negocio operando sin interrupciones. Atendemos oficinas, corporativos y locales comerciales en las zonas de mayor movimiento empresarial: <strong>Puerto Cancún, Avenida Tulum, Avenida Bonampak, Cumbres, Huayacán</strong> y el centro de Cancún.</p>
          
          <ul class="b2b-list">
            <li><Icon name="circle-check" /> Diagnóstico y mantenimiento correctivo por volumen de computadoras</li>
            <li><Icon name="circle-check" /> Configuración y mantenimiento preventivo periódico de flotillas de laptops</li>
            <li><Icon name="circle-check" /> Diseño, instalación y diagnóstico de redes estructuradas y WiFi de oficina</li>
            <li><Icon name="circle-check" /> Respaldo técnico de información corporativa y servidores locales</li>
            <li><Icon name="circle-check" /> Facturación formal CFDI por todos los servicios de soporte</li>
          </ul>
          
          <div class="cp-b2b__actions">
            <a class="cp-btn cp-btn--dark" href="/b2b/"><Icon name="building-shield" /> Solicitar cotización empresarial</a>
            <a class="cp-btn cp-btn--outline" href="mailto:pixonpc@gmail.com?subject=Solicitud%20de%20soporte%20técnico%20empresarial"><Icon name="paper-plane" /> Correo B2B</a>
          </div>
        </div>
        
        <aside class="cp-b2b__aside">
          <div class="b2b-aside__symbol"><Icon name="building-shield" /><span></span><i></i></div>
          <strong>¿Cuentas con más de 5 equipos?</strong>
          <p>Agenda una visita técnica inicial de diagnóstico de red y estado de computadoras en tu oficina para detectar equipos lentos y riesgos de discos duros antes de que afecten tus operaciones.</p>
          <a class="cp-btn cp-btn--dark cp-btn--full" href="/b2b/">Saber más de B2B <Icon name="arrow-right" /></a>
        </aside>
      </div>
    </section>

    <!-- SECCION 9 — UBICACIÓN Y CONTACTO (contenedor compartido) -->
    <ContactSection id="ubicacion" />

    <!-- SECCION 10 — CHECKLIST DE DATOS -->
    <section class="cp-checklist" aria-labelledby="checklist-title">
      <div class="cp-shell cp-checklist__grid">
        <div class="cp-checklist__copy">
          <h2 id="checklist-title">Checklist: ¿Qué enviar antes de traer tu equipo a revisión?</h2>
          <p>Para acelerar la entrega de un presupuesto aproximado o preparar las herramientas necesarias antes de tu visita técnica, envíanos los siguientes detalles:</p>
          
          <ul class="checklist-items">
            <li><Icon name="circle-check" /> <strong>Tipo de dispositivo:</strong> Si es laptop, PC armada, consola de videojuegos o smartphone.</li>
            <li><Icon name="circle-check" /> <strong>Marca y Modelo exacto:</strong> Localizable en la etiqueta inferior o en la caja del dispositivo.</li>
            <li><Icon name="circle-check" /> <strong>Síntomas del problema:</strong> Desde cuándo ocurre la falla y qué eventos la detonan.</li>
            <li><Icon name="circle-check" /> <strong>Antecedentes físicos:</strong> Si el equipo sufrió alguna caída, derrame de líquidos o fue revisado previamente por otro taller.</li>
            <li><Icon name="circle-check" /> <strong>Fotos o Videos:</strong> Evidencia visual del error en pantalla o ruidos inusuales.</li>
            <li><Icon name="circle-check" /> <strong>Factura fiscal:</strong> Especificar al momento si requieres factura por el servicio de soporte.</li>
          </ul>
          
          <a class="cp-btn cp-btn--primary" href={waData} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /> Enviar datos de diagnóstico por WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- SECCION 11 — FAQ (Astro component call) -->
    <FaqSection 
      title="Preguntas frecuentes antes de contactarnos" 
      description="Resolvemos tus dudas habituales sobre soporte técnico, diagnóstico previo, formas de pago y tiempos de entrega de equipos en Cancún." 
      items={faqs} 
      viewMoreHref="/preguntas-frecuentes" 
      viewMoreLabel="Ver todas las preguntas frecuentes" 
    />

    <!-- SECCION 12 — RESEÑAS (contenedor real con form + base de datos) -->
    <CommentsSection
      id="resenas"
      viewMoreHref="/comentarios"
      viewMoreLabel="Ver todas las opiniones"
      title="¿Qué opinan nuestros clientes de Pixon PC en Cancún?"
      description="Lee los testimonios reales de usuarios que han reparado laptops, PC, celulares y consolas con nosotros. Déjanos tu opinión después de tu servicio."
    />

    <!-- SECCION 13 — CTA FINAL (Light background and dark blue text) -->
    <section class="cp-final" aria-labelledby="final-title">
      <div class="cp-shell cp-final__inner">
        <span class="cp-label">¿Comenzamos el diagnóstico?</span>
        <h2 id="final-title">Inicia el diagnóstico de tu equipo con soporte profesional</h2>
        <p>Registra tu ticket de reparación para asegurar tu orden técnica, o escríbenos directamente por WhatsApp para coordinar tu cita o solicitar una cotización inicial de soporte.</p>
        
        <div class="cp-final__actions">
          <a class="cp-btn cp-btn--primary" href={ticketUrl}><Icon name="ticket" /> Crear mi ticket técnico</a>
          <a class="cp-btn cp-btn--ghost" href={waDefault} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /> Mandar un WhatsApp</a>
          <a class="cp-btn cp-btn--outline" href={authUrl}><Icon name="arrow-right" /> Iniciar sesión para 10% de descuento</a>
        </div>
        
        <div class="cp-final__data">
          <strong>Pixon PC</strong>
          <span>Cto. Hacienda Chimay, 77539 Cancún, Q.R.</span>
          <a href={`tel:+52${waNum}`}>+52 998 669 0777</a>
          <a href="mailto:pixonpc@gmail.com">pixonpc@gmail.com</a>
        </div>
      </div>
    </section>
  </main>

  <!-- SECCION 14 — STICKY MOBILE CTA -->
  <nav class="cp-sticky" aria-label="Botones de contacto rápido móvil">
    <a href={waDefault} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /> WhatsApp</a>
    <a href={ticketUrl}><Icon name="ticket" /> Crear ticket</a>
  </nav>

  <Footer />
</Base>

<style>
  :global(.cp-page) {
    --cp-ink: #071f3a;
    --cp-blue: #0b65d8;
    --cp-cyan: #31b7ee;
    --cp-line: #cbd9e8;
    --cp-soft: #edf5fb;
    --cp-accent: #42c5f5;
    background: #f7fbfe;
  }
  
  /* Breadcrumb Custom Styling: White background, dark blue text (Inicio > Contacto) */
  :global(.cp-page .breadcrumb-container) {
    background: #ffffff !important;
    border-bottom: 1px solid var(--cp-line) !important;
  }
  :global(.cp-page .breadcrumb) {
    background: #ffffff !important;
    color: #071f3a !important;
  }
  :global(.cp-page .breadcrumb-container *) {
    color: #071f3a !important;
  }

  :global(.cp-page .tc-svg) {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
    vertical-align: -0.125em;
  }

  /* Core typography defaults for high readability */
  .cp-main :is(h2, h3, h4, p, span, li, a:not(.cp-btn), small, strong) {
    color: #071f3a;
  }

  .cp-shell {
    width: min(1200px, calc(100% - 32px));
    margin-inline: auto;
  }

  /* Modern button system with active micro-interactions (Emil Kowalski) */
  .cp-btn {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 24px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-weight: 800;
    font-size: 0.88rem;
    text-decoration: none;
    cursor: pointer;
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1), background-color 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }
  .cp-btn:active {
    transform: scale(0.97);
  }
  
  .cp-btn--primary {
    background: var(--cp-accent);
    color: #05233d !important;
  }
  .cp-btn--ghost {
    border-color: rgba(7, 31, 58, 0.25);
    color: #071f3a !important;
    background: rgba(7, 31, 58, 0.03);
  }
  .cp-btn--dark {
    background: #071f3a;
    color: #fff !important;
  }
  .cp-btn--outline {
    border: 1px solid var(--cp-line);
    background: #fff;
    color: #071f3a !important;
  }
  .cp-btn--outline-dark {
    border: 1px solid #071f3a;
    background: transparent;
    color: #071f3a !important;
  }
  .cp-btn--outline-light {
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: transparent;
    color: #fff !important;
  }
  .cp-btn--amber {
    background: #d97706;
    color: #fff !important;
  }
  .cp-btn--full {
    width: 100%;
  }

  .cp-label {
    display: block;
    color: var(--cp-blue) !important;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .cp-label--amber {
    color: #b45309 !important;
  }

  /* SECCION 1 — HERO (Light theme background with dark blue typography) */
  .cp-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(60px, 8vw, 100px) 0 70px;
    background: #f4f8fb;
    border-bottom: 1px solid #dbe7f1;
  }
  .cp-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: 
      linear-gradient(rgba(11, 101, 216, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(11, 101, 216, 0.03) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(circle at 70% 30%, black 20%, transparent 80%);
    pointer-events: none;
  }
  .cp-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 40px;
    align-items: center;
  }
  .cp-hero__copy :is(h1, p, span, small, strong, a:not(.cp-btn)) {
    color: #071f3a !important;
  }
  .cp-kicker {
    color: var(--cp-blue) !important;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .cp-kicker i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #35d39a;
    box-shadow: 0 0 0 4px rgba(53, 211, 154, 0.25);
  }
  .cp-hero h1 {
    margin: 16px 0;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .cp-hero__copy p {
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    line-height: 1.65;
    color: #38536d !important;
    margin-bottom: 24px;
    max-width: 65ch;
  }
  .cp-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 18px;
