---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ServiceTicketSection from '../../components/ServiceTicketSection.astro';
import FaqSection from '../../components/FaqSection.astro';
import CommentsSection from '../../components/CommentsSection.astro';
import ContactSection from '../../components/ContactSection.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/LocalSpriteIcon.astro';

const canonical = '/blogs/reparacion-bisagras-carcasas-laptop-cancun';
const whatsappText = encodeURIComponent('Hola Pixon PC, tengo una laptop con la bisagra o carcasa rota y quiero cotizar la reparación con fotos en Cancún.');

const cases = [
  {
    before: '/assets/images/responsive/AntesBisagra.webp',
    after: '/assets/images/responsive/DespuesBisagra.webp',
    title: 'HP Pavilion / Serie 240: Anclajes Superiores Arrancados',
    brand: 'HP',
    problem: 'Tornillos de la tapa trasera (Top Cover) desprendidos por bisagra agarrotada. La carcasa se abría 2 cm al levantar la pantalla.',
    solution: 'Reconstrucción con matriz epóxica bicomponente de grado industrial, reinstalación de insertos roscados de latón y calibración de torque al 60% de tensión original.',
    saving: 'Ahorro del 75% frente a importación de tapa original.',
  },
  {
    before: '/assets/images/responsive/AntesBisagra2.webp',
    after: '/assets/images/responsive/DespuesBisagra2.webp',
    title: 'Dell Inspiron 15: Separación en Marco y Palmrest',
    brand: 'Dell',
    problem: 'Postes de fijación en Palmrest (teclado) quebrados. Peligro inminente de corte sobre el cable flex de video eDP.',
    solution: 'Desarme milimétrico, resguardo del cable de video, refuerzo estructural en esquinas y alineación al ras sin tornillos pasantes antiestéticos.',
    saving: 'Entrega en 24 horas y pantalla 100% protegida.',
  },
  {
    before: '/assets/images/responsive/AntesBisagra3.webp',
    after: '/assets/images/responsive/DespuesBisagra3.webp',
    title: 'Lenovo IdeaPad / Legion: Bisagra Trabada por Humedad',
    brand: 'Lenovo',
    problem: 'Resequedad y salinidad costera en los ejes de acero. La fuerza de palanca reventó la base inferior (Bottom Case).',
    solution: 'Desoxidación por inmersión, lubricación con grasa sintética de alta viscosidad, ajuste micrométrico de tuercas de tensión y anclaje epóxico reforzado.',
    saving: 'Apertura suave con un solo dedo y garantía de 90 días.',
  },
];

const symptoms = [
  {
    level: 'Fase 1 · Alerta Temprana',
    status: 'Riesgo Moderado',
    statusColor: '#d97706',
    icon: 'triangle-exclamation',
    title: 'Tapa rígida, crujidos o click al abrir',
    desc: 'La grasa interna de la bisagra de acero se secó por el calor y salinidad de Cancún. El metal ofrece demasiada resistencia y transmite toda la torsión al plástico de la carcasa.',
    action: 'Calibración y lubricación de torque preventivo antes de que arranque los postes.',
  },
  {
    level: 'Fase 2 · Daño Estructural',
    status: 'Riesgo Alto',
    statusColor: '#ea580c',
    icon: 'wrench',
    title: 'Carcasa abierta, tornillo suelto o esquina que se separa',
    desc: 'Los postes plásticos internos (torretas) ya se fracturaron. Al mover la pantalla se observa cómo la tapa se infla y se abre en cuña, forzando los anclajes vecinos.',
    action: 'Reconstrucción epóxica con insertos de latón para evitar que el daño llegue al display.',
  },
  {
    level: 'Fase 3 · Peligro Crítico',
    status: 'Riesgo Extremo',
    statusColor: '#dc2626',
    icon: 'shield-halved',
    title: 'Bisagra zafada, cable flex visible o pantalla que parpadea',
    desc: 'El bracket metálico está completamente suelto y está presionando directamente el cable flex de video (eDP) o torsionando el cristal del panel LCD/OLED.',
    action: '¡No forzar la pantalla! Requiere intervención inmediata para no romper el display de $2,000+ MXN.',
  },
];

const brands = [
  { name: 'HP', models: 'Pavilion 14/15, 240/250 G7/G8/G9, Envy x360, Victus 15/16, OMEN' },
  { name: 'Dell', models: 'Inspiron 15 3501/3511/3520/5502, Vostro 3400/3500, Dell G15 5510/5515/5520, Latitude' },
  { name: 'Lenovo', models: 'IdeaPad 3, IdeaPad 5, IdeaPad Gaming 3, Legion 5/7, ThinkPad E14/E15' },
  { name: 'Acer', models: 'Nitro 5 (AN515), Aspire 3, Aspire 5, Swift 3, Predator Helios 300' },
  { name: 'Asus & MSI', models: 'TUF Gaming F15/A15, ROG Strix, VivoBook 14/15, MSI GF63 Thin, Katana GF66' },
  { name: 'Huawei & MacBook', models: 'MateBook D14, MateBook D15, MacBook Pro/Air (ajuste de embrague/clutch cover)' },
];

const process = [
  {
    num: '01',
    title: 'Diagnóstico Estructural y Chequeo de Flex',
    desc: 'Evaluamos el estado de la tapa (Top Cover), bisel (Bezel), palmrest y base (Bottom Case). Verificamos que el cable flex de video y antenas Wi-Fi no tengan cortes ni puntos de presión.',
  },
  {
    num: '02',
    title: 'Desarme Cuidadoso sin Romper Grapas',
    desc: 'Desensamblamos el marco con herramientas plásticas antiestáticas, aislando la pantalla LCD/OLED para protegerla contra ralladuras, flexiones o polvo.',
  },
  {
    num: '03',
    title: 'Desoxidación y Calibración de Torque',
    desc: 'En Cancún el óxido y salitre endurecen el acero. Limpiamos las bisagras, aplicamos lubricante sintético y calibramos la tensión para una apertura suave y duradera.',
  },
  {
    num: '04',
    title: 'Reconstrucción con Matriz Epóxica e Insertos',
    desc: 'Colocamos insertos roscados de latón moleteado (brass inserts) alineados a la altura exacta de fábrica y los fundimos con resina epóxica de alta resistencia mecánica.',
  },
  {
    num: '05',
    title: 'Curado Polimérico y Prueba de Fatiga (50 Ciclos)',
    desc: 'Respetamos los tiempos de curado térmico. Reensamblamos con ajuste al ras y sometemos el equipo a más de 50 pruebas de apertura y cierre antes de la entrega.',
  },
];

const faqs = [
  {
    question: '¿Por qué se rompen tanto las bisagras de laptop en Cancún?',
    answer: 'Por una combinación de diseño y clima: la mayoría de laptops modernas usan carcasas delgadas de plástico ABS con postes muy finos. En Cancún, la alta humedad relativa y la salinidad ambiental oxidan y resecan la grasa de los ejes de acero de la bisagra, haciendo que se endurezca (se agarrote). Al intentar abrir la pantalla con una sola mano, la palanca ejerce una fuerza de torsión brutal que arranca de raíz los postes de plástico.',
  },
  {
    question: '¿Conviene reparar con resina epóxica o comprar la carcasa completa?',
    answer: 'En más del 90% de los casos, la reconstrucción estructural con resina epóxica e insertos de latón es la mejor opción: cuesta entre 60% y 80% menos que una carcasa original, se realiza en 24 a 48 horas (sin esperar semanas de importación) y queda con mayor resistencia mecánica que el plástico original de fábrica.',
  },
  {
    question: '¿Por qué no debo usar Kola Loka (cianocrilato) o Plastiacero casero?',
    answer: 'El cianocrilato (Kola Loka) es extremadamente rígido y cristaliza: ante la primera flexión de la pantalla se quiebra de nuevo. Además, sus vapores empañan y dañan el display de forma irreversible, y el pegamento líquido puede filtrarse al eje de la bisagra bloqueándola por completo. El Plastiacero casero aplicado sin desarmar estorba el cierre y genera bultos antiestéticos.',
  },
  {
    question: '¿Qué pasa si sigo usando mi laptop con la bisagra rota?',
    answer: 'El riesgo es inminente y costoso: cada vez que abres o cierras la tapa, el metal afilado de la bisagra zafada se mueve sobre el cable flex de video (eDP) y antenas Wi-Fi. Si el flex se corta o hace corto, puede quemar la línea de backlight en la tarjeta madre o romper el cristal del display LCD, elevando el costo de reparación de $800 a más de $3,000 MXN.',
  },
  {
    question: '¿La reparación deja tornillos pasantes o marcas feas en la tapa exterior?',
    answer: 'No. En Pixon PC realizamos un trabajo 100% estético por la parte interna. No perforamos la tapa exterior con tornillos pasantes ni remaches visibles. La laptop conserva su apariencia original al ras, abriendo y cerrando con suavidad.',
  },
  {
    question: '¿Cuánto cuesta reparar la bisagra o carcasa de una laptop en Cancún?',
    answer: 'El costo promedio de reconstrucción estructural y calibración de bisagras en Pixon PC va desde $700 hasta $1,200 MXN, dependiendo de si el daño es en una o ambas bisagras y si involucra la tapa superior (Top Cover) o el Palmrest. Incluye diagnóstico de flex, calibración de torque y garantía por escrito.',
  },
  {
    question: '¿Cuánto tiempo tarda la reparación de bisagras en Pixon PC?',
    answer: 'La mayoría de reparaciones se completan en 24 a 48 horas hábiles. Este tiempo nos permite realizar un desarmado minucioso, curado térmico completo de la resina epóxica (para máxima dureza) y pruebas rigurosas de apertura.',
  },
  {
    question: '¿Cómo puedo cotizar la reparación de mi bisagra por WhatsApp?',
    answer: 'Envíanos 2 o 3 fotos de la zona rota (con la laptop abierta y de lado), menciona la marca y modelo de tu equipo, y dinos si la pantalla sigue dando video. Podemos darte una orientación visual inicial; el diagnóstico técnico inicia desde $600 MXN.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Reparación de Bisagras y Carcasas de Laptop en Cancún',
    serviceType: 'Reparación y Reconstrucción Estructural de Laptops',
    url: `https://pixon.com.mx${canonical}`,
    description: 'Servicio técnico especializado en reparación y reconstrucción de bisagras rotas, carcasas desprendidas, postes quebrados y ajuste de tensión para laptops en Cancún.',
    provider: {
      '@type': 'LocalBusiness',
      name: 'Pixon PC',
      telephone: '+52 998 669 0777',
      email: 'pixonpc@gmail.com',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Cto. Hacienda Chimay',
        postalCode: '77539',
        addressLocality: 'Cancún',
        addressRegion: 'Quintana Roo',
        addressCountry: 'MX',
      },
      priceRange: '$$',
      image: 'https://pixon.com.mx/assets/images/responsive/DespuesBisagra.webp',
    },
    areaServed: [
      { '@type': 'City', name: 'Cancún' },
      { '@type': 'State', name: 'Quintana Roo' },
      { '@type': 'AdministrativeArea', name: 'Zona Hotelera' },
      { '@type': 'AdministrativeArea', name: 'Huayacán' },
      { '@type': 'AdministrativeArea', name: 'Cumbres' },
      { '@type': 'AdministrativeArea', name: 'Puerto Cancún' },
      { '@type': 'AdministrativeArea', name: 'Polígono Sur' },
      { '@type': 'AdministrativeArea', name: 'Bonfil' },
      { '@type': 'AdministrativeArea', name: 'Supermanzanas' },
      { '@type': 'AdministrativeArea', name: 'Haciendas' },
    ],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Servicios de Carcasas y Bisagras',
      itemListElement: [
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Reconstrucción de bisagras con resina epóxica e insertos de latón',
          },
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Calibración y lubricación de torque en bisagras de laptop',
          },
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Cambio de bisagras originales y reemplazo de carcasas',
          },
        },
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Cómo se repara la bisagra y carcasa rota de una laptop',
    description: 'Protocolo técnico profesional para reconstruir anclajes y calibrar bisagras de laptop en Cancún.',
    step: process.map((p, idx) => ({
      '@type': 'HowToStep',
      position: idx + 1,
      name: p.title,
      text: p.desc,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://pixon.com.mx/' },
      { '@type': 'ListItem', position: 2, name: 'Blogs', item: 'https://pixon.com.mx/blogs' },
      { '@type': 'ListItem', position: 3, name: 'Reparación de Bisagras en Cancún', item: `https://pixon.com.mx${canonical}` },
    ],
  },
];
---

<Base
  title="Reparación de Bisagras y Carcasas de Laptop en Cancún | Pixon PC"
  description="Reparación y reconstrucción de bisagras, carcasas y postes rotos de laptop en Cancún. Evita romper pantalla o cable flex. Refuerzo epóxico con garantía y fotos."
  canonical={canonical}
  image="/assets/images/responsive/DespuesBisagra.webp"
  schema={schema}
  bodyClass="service-page hinge-blog-page"
>
  <Navbar />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Blogs', href: '/blogs' }, { label: 'Reparación de bisagras y carcasas' }]} />

  <!-- HERO SECTION CONTEXTUALIZADO, COMPACTO Y DE ALTO IMPACTO -->
  <header class="hb-hero">
    <div class="hb-hero__bg-grid" aria-hidden="true"></div>
    <div class="hb-hero__ambient-glow" aria-hidden="true"></div>

    <div class="hb-shell hb-hero__grid">
      <div class="hb-hero__content">
        <div class="hb-hero__pill">
          <span class="hb-pill-dot"></span>
          <span>Taller Especializado en Cancún · Hardware & Carcasas</span>
        </div>

        <h1>Reparación de Bisagras y Carcasas de Laptop en Cancún</h1>

        <p class="hb-hero__lead">
          ¿La tapa truena, se levanta de una esquina o se abrió la carcasa? Reconstruimos los postes internos con <strong>resina epóxica de alta resistencia</strong> y calibramos la tensión antes de que la fuerza rompa tu <strong>pantalla o cable flex</strong>.
        </p>

        <!-- Proof Badges -->
        <div class="hb-hero__stats">
          <div class="hb-stat-item">
            <span class="hb-stat-num">98%</span>
            <span class="hb-stat-label">Éxito en reconstrucción</span>
          </div>
          <div class="hb-stat-divider" aria-hidden="true"></div>
          <div class="hb-stat-item">
            <span class="hb-stat-num">Hasta 80%</span>
            <span class="hb-stat-label">Ahorro vs carcasa</span>
          </div>
          <div class="hb-stat-divider" aria-hidden="true"></div>
          <div class="hb-stat-item">
            <span class="hb-stat-num">24–48h</span>
            <span class="hb-stat-label">Tiempo promedio</span>
          </div>
          <div class="hb-stat-divider" aria-hidden="true"></div>
          <div class="hb-stat-item">
            <span class="hb-stat-num">90 Días</span>
            <span class="hb-stat-label">Garantía por escrito</span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="hb-actions">
          <a class="hb-btn hb-btn--wa" href={`https://wa.me/529986690777?text=${whatsappText}`} target="_blank" rel="noopener noreferrer">
            <Icon name="whatsapp" /> Cotizar con fotos por WhatsApp
          </a>
          <a class="hb-btn hb-btn--ghost" href="#ticket-bisagras">
            <Icon name="clipboard-list" /> Solicitar revisión
          </a>
        </div>

        <div class="hb-hero__note">
          <Icon name="circle-check" /> <span>Diagnóstico visual rápido · Sin tornillos pasantes · Cancún y Riviera Maya</span>
        </div>
      </div>

      <!-- Compact Before/After Preview Card in Hero -->
      <div class="hb-hero__showcase">
        <div class="hb-showcase-card">
          <div class="hb-showcase-badge">
            <span class="pulse-icon"></span> Caso Real en Cancún: HP Pavilion
          </div>
          <div class="hb-showcase-split">
            <div class="hb-showcase-pane">
              <span class="hb-pane-tag hb-pane-tag--before">Antes</span>
              <img src="/assets/images/responsive/AntesBisagra.webp" alt="Laptop con bisagra rota y carcasa desprendida en Cancún" width="1170" height="1557" loading="eager" decoding="async" />
            </div>
            <div class="hb-showcase-pane">
              <span class="hb-pane-tag hb-pane-tag--after">Después</span>
              <img src="/assets/images/responsive/DespuesBisagra.webp" alt="Reparación terminada de bisagra con resina epóxica en Cancún" width="1170" height="1557" loading="eager" decoding="async" />
            </div>
          </div>
          <div class="hb-showcase-footer">
            <div class="hb-showcase-detail">
              <strong>Anclaje interno 100% reforzado</strong>
              <p>Insertos de latón fundidos en resina epóxica con ajuste suave de apertura.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="hb-main">

    <!-- SECCIÓN: ANATOMÍA DE LA FALLA Y CAUSAS REALES EN CANCÚN -->
    <section class="hb-section hb-anatomy" id="por-que-se-rompe">
      <div class="hb-shell">
        <div class="hb-section-header text-center">
          <span class="hb-tagline"><Icon name="laptop" /> Análisis Técnico de Hardware</span>
          <h2>¿Por Qué se Rompe la Bisagra de una Laptop en Cancún?</h2>
          <p class="hb-lead">
            El problema casi nunca es el metal de la bisagra en sí, sino el plástico donde se atornilla y los efectos del clima tropical costero.
          </p>
        </div>

        <div class="hb-anatomy-grid">
          <article class="hb-card hb-card--interactive">
            <div class="hb-card__icon hb-card__icon--blue">
              <Icon name="temperature-high" />
            </div>
            <h3>1. Salinidad y Humedad de Cancún</h3>
            <p>
              El ambiente caribeño oxida los rodamientos de acero de la bisagra y seca la grasa lubricante de fábrica. Esto incrementa drásticamente la resistencia de giro: la bisagra se pone <strong>dura o trabada</strong>.
            </p>
            <div class="hb-card__callout">
              <strong>Efecto:</strong> La fuerza necesaria para abrir la tapa se triplica, forzando la estructura plástica.
            </div>
          </article>

          <article class="hb-card hb-card--interactive">
            <div class="hb-card__icon hb-card__icon--amber">
              <Icon name="wrench" />
            </div>
            <h3>2. Postes Plásticos Frágiles (Torretas)</h3>
            <p>
              Los fabricantes fijan las bisagras metálicas mediante tuercas de latón embutidas en tubos plásticos de apenas 1.2 mm de grosor. Al levantar la pantalla desde una esquina, el <strong>efecto palanca</strong> arranca los postes de raíz.
            </p>
            <div class="hb-card__callout">
              <strong>Efecto:</strong> La carcasa se abre en cuña y los tornillos giran en falso o se caen.
            </div>
          </article>

          <article class="hb-card hb-card--interactive">
            <div class="hb-card__icon hb-card__icon--red">
              <Icon name="shield-halved" />
            </div>
            <h3>3. Riesgo Crítico: Cable Flex y Pantalla</h3>
            <p>
              Por la esquina de la bisagra corre el <strong>cable flex de video (eDP/LVDS)</strong> y las antenas Wi-Fi. Al zafarse la bisagra, el metal afilado pellizca el cable, provocando parpadeos, líneas o un cortocircuito a la tarjeta madre.
            </p>
            <div class="hb-card__callout">
              <strong>Peligro:</strong> Seguir forzando la laptop puede romper el cristal del display LCD/OLED.
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- SECCIÓN: SEMÁFORO DE GRAVEDAD / DIAGNÓSTICO -->
    <section class="hb-section hb-severity" id="niveles-de-dano">
      <div class="hb-shell">
        <div class="hb-section-header">
          <span class="hb-tagline"><Icon name="triangle-exclamation" /> Diagnóstico de Urgencia</span>
          <h2>Identifica la Fase de Daño de tu Laptop</h2>
          <p class="hb-lead">
            Entre más rápido atiendas una bisagra dura o desprendida, menor será el costo y evitarás daños irreparables a tu pantalla.
          </p>
        </div>

        <div class="hb-severity-list">
          {symptoms.map((s) => (
            <article class="hb-severity-card">
              <div class="hb-severity-card__badge" style={`background:${s.statusColor}15; color:${s.statusColor}; border-color:${s.statusColor}40;`}>
                <Icon name={s.icon} />
                <span>{s.level} · {s.status}</span>
              </div>
              <div class="hb-severity-card__content">
                <h3>{s.title}</h3>
                <p>{s.desc}</p>
                <div class="hb-severity-card__action">
                  <strong>Recomendación técnica:</strong> {s.action}
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="hb-inline-cta">
          <div>
            <strong>¿Tu laptop presenta alguno de estos síntomas?</strong>
            <p>No la fuerces al abrir o cerrar. Envíanos fotos por WhatsApp para una orientación visual inicial.</p>
          </div>
          <a class="hb-btn hb-btn--wa" href={`https://wa.me/529986690777?text=${whatsappText}`} target="_blank" rel="noopener noreferrer">
            <Icon name="whatsapp" /> Enviar fotos por WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- SECCIÓN: GALERÍA ANTES Y DESPUÉS -->
    <section class="hb-section hb-cases" id="casos-reales">
      <div class="hb-shell">
        <div class="hb-section-header text-center">
          <span class="hb-tagline"><Icon name="camera-retro" /> Evidencia Fotográfica Real</span>
          <h2>Casos Reales en Taller: Antes vs. Después</h2>
          <p class="hb-lead">
            Reparaciones estructurales ejecutadas en nuestro laboratorio en Cancún con acabado estético al ras, sin tornillos pasantes ni remaches.
          </p>
        </div>

        <div class="hb-case-grid">
          {cases.map((item) => (
            <article class="hb-case-card">
              <div class="hb-case-media">
                <div class="hb-case-pane">
                  <span class="hb-case-tag hb-case-tag--before">Antes</span>
                  <img src={item.before} alt={`Antes de reparación de ${item.title} en Cancún`} width="1170" height="1557" loading="lazy" decoding="async" />
                </div>
                <div class="hb-case-pane">
                  <span class="hb-case-tag hb-case-tag--after">Después</span>
                  <img src={item.after} alt={`Reparación finalizada de ${item.title} en Pixon PC Cancún`} width="1170" height="1557" loading="lazy" decoding="async" />
                </div>
              </div>

              <div class="hb-case-body">
                <div class="hb-case-brand-tag">{item.brand}</div>
                <h3>{item.title}</h3>
                <p class="hb-case-problem"><strong>Falla:</strong> {item.problem}</p>
                <p class="hb-case-solution"><strong>Trabajo:</strong> {item.solution}</p>
                <div class="hb-case-benefit">
