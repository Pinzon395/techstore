---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ServiceTicketSection from '../../components/ServiceTicketSection.astro';
import FaqSection from '../../components/FaqSection.astro';
import CommentsSection from '../../components/CommentsSection.astro';
import ContactSection from '../../components/ContactSection.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/LocalSpriteIcon.astro';

const canonical = '/blogs/reparacion-bisagras-carcasas-laptop-cancun/';
const whatsappText = encodeURIComponent('Hola Pixon PC, tengo una laptop con bisagra o carcasa rota y quiero cotizar reparacion en Cancun.');

const cases = [
  {
    before: '/assets/images/responsive/AntesBisagra.webp',
    after: '/assets/images/responsive/DespuesBisagra.webp',
    title: 'Anclaje interno desprendido',
    detail: 'Reconstrucción del soporte de la bisagra con resina epóxica, ajuste de tensión y prueba de apertura.',
  },
  {
    before: '/assets/images/responsive/AntesBisagra2.webp',
    after: '/assets/images/responsive/DespuesBisagra2.webp',
    title: 'Carcasa abierta cerca de pantalla',
    detail: 'Refuerzo del poste, cierre de separación y acabado limpio para evitar presión sobre display y flex.',
  },
  {
    before: '/assets/images/responsive/AntesBisagra3.webp',
    after: '/assets/images/responsive/DespuesBisagra3.webp',
    title: 'Bisagra forzada por tapa rígida',
    detail: 'Reparación estructural y calibración para que la tapa abra sin tronar ni levantar la cubierta.',
  },
];

const process = [
  ['Diagnóstico de daño', 'Revisamos base, tapa, postes, tornillos, flex de pantalla y tensión real de la bisagra.'],
  ['Desarme controlado', 'Abrimos sin forzar la carcasa para no romper pestañas, cable de pantalla o conectores.'],
  ['Reconstrucción y refuerzo', 'Usamos resina epóxica, anclaje y técnica según el tipo de plástico y zona rota.'],
  ['Ajuste de tensión', 'La bisagra no debe quedar floja ni demasiado dura. El ajuste evita que vuelva a tronar.'],
  ['Acabado y prueba', 'Validamos apertura, cierre, alineación y apariencia antes de entregar el equipo.'],
];

const faqs = [
  {
    question: '¿Conviene reparar la bisagra de una laptop o cambiar la carcasa completa?',
    answer: 'Depende del modelo, disponibilidad de pieza y zona rota. Muchas veces la reparación estructural ahorra dinero y evita esperar una carcasa difícil de conseguir, pero primero revisamos si el daño permite un refuerzo seguro.',
  },
  {
    question: '¿La resina epóxica queda más resistente que la carcasa original?',
    answer: 'En reparaciones compatibles buscamos que el anclaje quede más firme que el plástico dañado de fábrica. No prometemos el mismo resultado en todos los modelos porque cambia el material, la tensión y el daño previo.',
  },
  {
    question: '¿Cuánto puedo ahorrar reparando la carcasa?',
    answer: 'En algunos modelos el ahorro puede acercarse al 80% frente a comprar tapa, palmrest o carcasa completa. El porcentaje depende del precio de la pieza y del nivel de daño.',
  },
  {
    question: '¿Cuánto tarda una reparación de bisagras en Cancún?',
    answer: 'Muchas reparaciones se resuelven entre 24 y 48 horas hábiles. Si hay daño en pantalla, flex, tornillos barridos o falta una pieza, el tiempo puede cambiar.',
  },
  {
    question: '¿Qué pasa si sigo usando la laptop con la bisagra rota?',
    answer: 'La presión puede romper pantalla, flex de video, tapa, base o conectores internos. Si truena, se abre o se levanta una esquina, conviene dejar de forzarla y revisarla.',
  },
  {
    question: '¿Puedo crear un ticket con fotos?',
    answer: 'Sí. Lo ideal es enviar fotos de la bisagra abierta, vista lateral, modelo de laptop y explicar si truena, se separó o ya no cierra correctamente.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Reparación de bisagras y carcasas de laptop en Cancún',
    serviceType: 'Reparación estructural de laptop',
    url: `https://pixon.com.mx${canonical}`,
    description: 'Guía y servicio de reparación de bisagras, carcasas y anclajes de laptop en Cancún con diagnóstico, refuerzo y acabado profesional.',
    provider: { '@id': 'https://pixon.com.mx/#business' },
    areaServed: [{ '@type': 'City', name: 'Cancún' }, { '@type': 'State', name: 'Quintana Roo' }],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<Base
  title="Reparación de bisagras y carcasas de laptop en Cancún | Pixon PC"
  description="Guía de reparación de bisagras y carcasas de laptop en Cancún. Antes y después, resina epóxica, señales de daño, ahorro posible y cuándo crear ticket."
  canonical={canonical}
  image="/assets/images/responsive/DespuesBisagra.webp"
  schema={schema}
  bodyClass="service-page hinge-blog-page"
>
  <Navbar />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Blogs', href: '/blogs' }, { label: 'Reparación de bisagras' }]} />

  <header class="hb-hero">
    <div class="hb-hero__media" aria-hidden="true">
      <img src="/assets/images/responsive/AntesBisagra.webp" alt="" width="1170" height="1557" loading="eager" decoding="async" />
      <img src="/assets/images/responsive/DespuesBisagra.webp" alt="" width="1170" height="1557" loading="eager" decoding="async" />
    </div>
    <div class="hb-hero__shade"></div>
    <div class="hb-shell hb-hero__content">
      <span>Estética y resistencia</span>
      <h1>Reparación de bisagras y carcasas de laptop en Cancún</h1>
      <p>Si la carcasa truena, se separó o la pantalla abre con presión, revisamos el daño antes de que rompa display, flex o base.</p>
      <div class="hb-actions">
        <a class="hb-btn" href={`https://wa.me/529986690777?text=${whatsappText}`} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /> Cotizar por WhatsApp</a>
        <a class="hb-btn hb-btn--ghost" href="#ticket-bisagras"><Icon name="clipboard-list" /> Crear ticket</a>
      </div>
    </div>
  </header>

  <main class="hb-main">
    <section class="hb-section hb-intro">
      <div class="hb-shell hb-split">
        <div>
          <span class="hb-icon"><Icon name="laptop" /></span>
          <h2>¿Por qué se rompe una bisagra de laptop?</h2>
          <h3>El problema casi nunca es solo la bisagra</h3>
          <p>Cuando una laptop truena al abrir, normalmente ya hay postes internos rotos, plástico fatigado, tornillos barridos o tensión excesiva. Si se sigue usando, la fuerza se transmite a la pantalla, al flex de video y a la tapa.</p>
          <h3>Reparación local con diagnóstico en Cancún</h3>
          <p>En Pixon PC revisamos si conviene reconstruir con resina epóxica, reforzar el anclaje, cambiar pieza o ajustar tensión. No todas las carcasas se reparan igual.</p>
        </div>
        <aside class="hb-summary">
          <strong>Señales de alerta</strong>
          <ul>
            <li><Icon name="circle-check" /> La tapa se levanta de una esquina.</li>
            <li><Icon name="circle-check" /> Se escucha un crujido al abrir.</li>
            <li><Icon name="circle-check" /> La pantalla no queda alineada.</li>
            <li><Icon name="circle-check" /> Hay tornillos sueltos o plástico roto.</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="hb-section hb-cases">
      <div class="hb-shell">
        <header class="hb-heading">
          <Icon name="camera-retro" />
          <div>
            <h2>Antes y después: bisagra rota vs reparación terminada</h2>
            <p>La meta es que la laptop vuelva a abrir y cerrar con firmeza, sin dejar un acabado improvisado.</p>
          </div>
        </header>
        <div class="hb-case-grid">
          {cases.map((item) => (
            <article class="hb-case">
              <div class="hb-compare">
                <figure>
                  <span class="hb-badge hb-badge--before">Antes</span>
                  <img src={item.before} alt={`Antes de ${item.title} en laptop reparada en Cancún`} width="1170" height="1557" loading="lazy" decoding="async" />
                </figure>
                <figure>
                  <span class="hb-badge hb-badge--after">Después</span>
                  <img src={item.after} alt={`Después de ${item.title} reparado por Pixon PC en Cancún`} width="1170" height="1557" loading="lazy" decoding="async" />
                </figure>
              </div>
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="hb-section hb-benefits">
      <div class="hb-shell hb-benefits__grid">
        <article>
          <Icon name="shield-halved" />
          <h2>Más resistencia cuando el anclaje es reparable</h2>
          <p>La reconstrucción busca reforzar la zona donde el plástico ya cedió. También ajustamos la tensión para que la fuerza no vuelva al mismo punto.</p>
        </article>
        <article>
          <Icon name="piggy-bank" />
          <h2>Ahorro frente a carcasa nueva</h2>
          <p>En ciertos modelos puedes ahorrar hasta 80% frente a comprar carcasa completa, especialmente cuando la pieza es escasa o tarda en llegar.</p>
        </article>
        <article>
          <Icon name="eye" />
          <h2>Acabado limpio y profesional</h2>
          <p>No se trata solo de pegar. Cuidamos alineación, cierre, apariencia y funcionamiento real de apertura.</p>
        </article>
      </div>
    </section>

    <section class="hb-section hb-process">
      <div class="hb-shell">
        <header class="hb-heading">
          <Icon name="screwdriver-wrench" />
          <div>
            <h2>Cómo reparamos bisagras y carcasas en Pixon PC</h2>
            <p>El proceso cambia según marca y daño, pero siempre empieza con diagnóstico y termina con prueba de apertura.</p>
          </div>
        </header>
        <ol class="hb-process__list">
          {process.map(([title, text], index) => (
            <li>
              <strong>{String(index + 1).padStart(2, '0')}</strong>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="hb-section hb-local">
      <div class="hb-shell hb-local__grid">
        <div>
          <span class="hb-icon"><Icon name="location-dot" /></span>
          <h2>Reparación de bisagras para laptop en Cancún</h2>
          <h3>Atención para marcas comunes y equipos de trabajo</h3>
          <p>Revisamos laptops HP, Dell, Lenovo, Acer, Asus, MSI y otras marcas. Atendemos Cancún Centro, Zona Hotelera, Huayacán, Cumbres, Bonfil, Polígono Sur, Puerto Cancún, Av. Tulum, Bonampak, Puerto Juárez, Supermanzanas y Haciendas.</p>
          <h3>Cuándo dejar de usar la laptop</h3>
          <p>Si la tapa se levanta, truena o la pantalla se mueve de forma irregular, no sigas forzándola. Un daño de carcasa puede terminar en pantalla rota.</p>
        </div>
        <address>
          <strong>Pixon PC</strong>
          <span>Cto. Hacienda Chimay, 77539 Cancún, Q.R.</span>
          <a href="tel:+529986690777">+52 998 669 0777</a>
          <a href="mailto:pixonpc@gmail.com">pixonpc@gmail.com</a>
        </address>
      </div>
    </section>

    <ServiceTicketSection
      id="ticket-bisagras"
      defaultDevice="Laptop con bisagra o carcasa dañada"
      defaultService="Reparación de bisagras y carcasas de laptop"
      sourcePage="/blogs/reparacion-bisagras-carcasas-laptop-cancun"
    />

    <FaqSection
      id="faq-bisagras-blog"
      title="Preguntas frecuentes sobre bisagras y carcasas de laptop"
      description="Respuestas directas sobre reparación, resina epóxica, ahorro posible, tiempos y cuándo dejar de usar el equipo."
      items={faqs}
      viewMoreHref="/preguntas-frecuentes"
      viewMoreLabel="Ver más preguntas"
      ariaLabel="Preguntas frecuentes sobre reparación de bisagras de laptop en Cancún"
      backgroundColor="#eef6fc"
      titleColor="#071F3A"
      descriptionColor="#294963"
      questionColor="#071F3A"
    />

    <section class="hb-final">
      <div class="hb-shell hb-final__grid">
        <div>
          <span>Evita que el daño llegue a pantalla</span>
          <h2>Cotiza la reparación de tu bisagra con fotos</h2>
          <p>Envíanos fotos de la zona rota, modelo de laptop y síntoma. Te decimos si conviene reparación, refuerzo o cambio de carcasa antes de intervenir.</p>
          <div class="hb-actions">
            <a class="hb-btn" href={`https://wa.me/529986690777?text=${whatsappText}`} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /> Enviar fotos por WhatsApp</a>
            <a class="hb-btn hb-btn--light" href="/reparacion-bisagras"><Icon name="arrow-right" /> Ver servicio y precios</a>
          </div>
        </div>
        <figure>
          <img src="/assets/images/responsive/DespuesBisagra2.webp" alt="Reparación terminada de carcasa y bisagra de laptop en Cancún" width="1170" height="1557" loading="lazy" decoding="async" />
        </figure>
      </div>
    </section>

    <CommentsSection viewMoreHref="/comentarios" />
    <ContactSection />
  </main>
  <Footer />
</Base>

<style is:global>
  .hinge-blog-page :where(.hb-main,.hb-section,.hb-final){--ink:#071F3A;--muted:#294963;--blue:#1479D4;--green:#0f9f6e;--ice:#eef6fc;--line:#cbdce8;color:var(--ink)}
  .hinge-blog-page .hb-shell{width:min(1180px,calc(100% - 32px));margin:0 auto}
  .hinge-blog-page .hb-main :where(h2,h3,p,li,span,strong,a,address){color:var(--ink)}
  .hinge-blog-page .tc-svg{display:block;width:18px;height:18px;fill:currentColor;flex:0 0 auto}
  .hb-hero{position:relative;min-height:760px;display:grid;align-items:end;overflow:hidden;background:#071F3A}
  .hb-hero__media{position:absolute;inset:0;display:grid;grid-template-columns:1fr 1fr}
  .hb-hero__media img{width:100%;height:100%;object-fit:cover}
  .hb-hero__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,15,29,.96),rgba(3,15,29,.78) 55%,rgba(3,15,29,.32))}
  .hb-hero__content{position:relative;padding:150px 0 62px}
  .hb-hero span{color:#bce0fb;font-size:.78rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}
  .hb-hero h1{max-width:910px;margin:14px 0 18px;color:#fff;font-family:var(--font-heading);font-size:clamp(2.35rem,5.4vw,5rem);font-style:italic;font-weight:850;line-height:1.02;text-wrap:balance}
  .hb-hero p{max-width:690px;margin:0;color:rgba(255,255,255,.86);font-size:clamp(1rem,1.55vw,1.12rem);font-weight:600;line-height:1.68}
  .hb-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}
  .hb-btn{display:inline-flex;min-height:48px;align-items:center;justify-content:center;gap:9px;padding:12px 18px;border:1px solid var(--blue);border-radius:8px;background:var(--blue);color:#fff!important;font-weight:850;text-decoration:none;transition:transform 160ms cubic-bezier(.23,1,.32,1),background-color 160ms ease,border-color 160ms ease}
  .hb-btn--ghost{border-color:rgba(255,255,255,.52);background:rgba(7,31,58,.62)}
  .hb-btn--light{border-color:#fff;background:#fff;color:var(--ink)!important}
  .hb-btn:active{transform:scale(.97)}
  .hb-section{padding:clamp(56px,8vw,96px) 0;background:#fff}
  .hb-split,.hb-local__grid,.hb-final__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.86fr);gap:clamp(30px,6vw,76px);align-items:center}
  .hb-section h2,.hb-final h2{margin:0 0 16px;font-family:var(--font-heading);font-size:clamp(2rem,4vw,3.35rem);font-style:italic;font-weight:850;line-height:1.06;text-wrap:balance}
  .hb-section h3{margin:20px 0 8px;font-size:1.08rem;line-height:1.28;text-wrap:balance}
  .hb-section p,.hb-summary li,.hb-heading p,.hb-final p{max-width:72ch;margin:0;color:var(--muted);font-weight:560;line-height:1.72}
  .hb-icon{display:grid;width:44px;height:44px;margin-bottom:16px;place-items:center;border-radius:8px;background:#dff2fb;color:var(--blue)}
  .hb-summary{padding:28px;border:1px solid #acd3e8;border-radius:8px;background:#f8fcff}
  .hb-summary strong{display:block;margin-bottom:14px;font-size:1.12rem}
  .hb-summary ul{display:grid;gap:12px;margin:0;padding:0;list-style:none}
  .hb-summary li{display:flex;align-items:center;gap:10px;font-weight:750}
  .hb-summary .tc-svg{color:var(--green)}
  .hb-cases,.hb-process{background:var(--ice)}
  .hb-heading{display:grid;grid-template-columns:48px minmax(0,820px);gap:16px;align-items:start;margin-bottom:30px}
  .hb-heading>.tc-svg{box-sizing:border-box;width:44px;height:44px;max-width:44px;max-height:44px;padding:12px;border-radius:8px;background:var(--blue);color:#fff}
  .hb-case-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .hb-case{display:flex;flex-direction:column;padding:16px;border:1px solid var(--line);border-radius:12px;background:#fff;transition:transform 220ms cubic-bezier(.2,0,.2,1),box-shadow 220ms ease,border-color 220ms ease}
  .hb-case:hover{transform:translateY(-4px);box-shadow:0 14px 28px -6px rgba(7,31,58,.09);border-color:#b5d2e6}
  .hb-compare{display:grid;grid-template-columns:1fr 1fr;gap:2px;overflow:hidden;border-radius:10px;background:var(--line)}
  .hb-compare figure{position:relative;margin:0;background:#d9e7f0;overflow:hidden}
  .hb-compare img{display:block;width:100%;aspect-ratio:16/10;max-height:210px;object-fit:cover;object-position:center;transition:transform 320ms cubic-bezier(.2,0,.2,1)}
  .hb-case:hover .hb-compare img{transform:scale(1.04)}
  .hb-badge{position:absolute;top:8px;left:8px;z-index:2;padding:4px 8px;border-radius:6px;font-size:.68rem;font-weight:850;letter-spacing:.05em;text-transform:uppercase;pointer-events:none}
  .hb-badge--before{background:rgba(7,31,58,.88);backdrop-filter:blur(4px);color:#fff!important;border:1px solid rgba(255,255,255,.2)}
  .hb-badge--after{background:var(--green);color:#fff!important;box-shadow:0 2px 6px rgba(15,159,110,.3)}
  .hb-case h3{margin:14px 0 6px;color:var(--ink);font-family:var(--font-heading);font-size:1.12rem;font-weight:850;line-height:1.28;text-wrap:balance}
  .hb-case p{margin:0;color:var(--muted);font-size:.9rem;line-height:1.55;font-weight:560}
  .hb-benefits__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line)}
  .hb-benefits article{padding:clamp(24px,4vw,42px);background:#fff}
  .hb-benefits article>.tc-svg{width:28px;height:28px;margin-bottom:18px;color:var(--green)}
  .hb-benefits h2{font-size:clamp(1.55rem,2.8vw,2.35rem)}
  .hb-process__list{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;margin:0;padding:0;background:var(--line);list-style:none}
  .hb-process__list li{display:grid;min-height:220px;align-content:start;gap:18px;padding:22px;background:#fff}
  .hb-process__list strong{font-size:1.55rem;color:var(--blue)!important}
  .hb-process__list h3{margin-top:0}
  .hb-local{background:#fff}
  .hb-local address{display:grid;gap:12px;padding:26px;border-radius:8px;background:#e7f4fb;font-style:normal}
  .hb-local address a{color:var(--blue)!important;text-decoration:none;font-weight:800}
  .hb-final{padding:clamp(64px,8vw,104px) 0;background:#dcecf7}
  .hb-final>div>div>span{color:var(--blue)!important;font-weight:850;text-transform:uppercase;font-size:.78rem;letter-spacing:.08em}
  .hb-final figure{margin:0;overflow:hidden;border-radius:8px;background:#d6e8f2}
  .hb-final img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}
  @media(hover:hover) and (pointer:fine){.hb-btn:hover{transform:translateY(-2px);background:#0e68b8}.hb-btn--light:hover{background:#eff8fd;border-color:#eff8fd}}
  @media(max-width:980px){.hb-split,.hb-local__grid,.hb-final__grid{grid-template-columns:1fr}.hb-case-grid,.hb-benefits__grid{grid-template-columns:1fr}.hb-process__list{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:640px){.hb-hero{min-height:720px}.hb-hero__media{grid-template-columns:1fr}.hb-hero__media img:first-child{display:none}.hb-hero__content{padding-top:130px}.hb-actions,.hb-actions .hb-btn{width:100%}.hb-heading{grid-template-columns:42px 1fr}.hb-heading>.tc-svg{width:40px;height:40px;max-width:40px;max-height:40px;padding:11px}.hb-process__list{grid-template-columns:1fr}.hb-process__list li{min-height:auto}.hb-section{padding:52px 0}}
  @media(prefers-reduced-motion:reduce){.hb-btn{transition:none}}
</style>
