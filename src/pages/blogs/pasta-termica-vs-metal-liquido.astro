---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ServiceTicketSection from '../../components/ServiceTicketSection.astro';
import FaqSection from '../../components/FaqSection.astro';
import CommentsSection from '../../components/CommentsSection.astro';
import ContactSection from '../../components/ContactSection.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/LocalSpriteIcon.astro';

const canonical = '/blogs/pasta-termica-vs-metal-liquido';
const whatsappText = encodeURIComponent('Hola, quiero agendar un diagnóstico térmico para saber si mi equipo necesita pasta térmica, limpieza o metal líquido.');

const faqs = [
  { question: '¿Qué es mejor, pasta térmica o metal líquido?', answer: 'No existe una respuesta universal. La pasta térmica es compatible con la mayoría de PC, laptops y consolas, tiene bajo riesgo eléctrico y facilita el mantenimiento. El metal líquido puede transferir más calor, pero solo conviene cuando el diseño del equipo, los materiales del disipador y el aislamiento permiten aplicarlo con seguridad.' },
  { question: '¿El metal líquido puede dañar mi laptop?', answer: 'Sí, si se derrama sobre componentes, se aplica sobre aluminio, se usa demasiado o no se aísla la zona. También puede reaccionar con ciertos materiales. Por eso revisamos el modelo, el disipador y el sistema de contención antes de recomendar metal líquido para una laptop.' },
  { question: '¿Cuándo conviene cambiar la pasta térmica?', answer: 'Cuando las pruebas muestran temperatura elevada, pérdida de frecuencia, ventiladores constantes o compuesto seco y mal distribuido. Cambiarla por calendario sin revisar ventiladores, polvo, pads y presión del disipador puede no resolver el problema.' },
  { question: '¿El metal líquido aumenta los FPS?', answer: 'No directamente. Si el procesador o la gráfica reducen frecuencia por thermal throttling, mejorar la transferencia térmica puede ayudar a sostener el rendimiento. Si el límite es GPU, CPU, RAM, configuración o el propio juego, aplicar metal líquido no aumentará los FPS.' },
  { question: '¿Pueden aplicar metal líquido en consolas?', answer: 'Revisamos consolas que utilizan metal líquido de fábrica y sistemas con pasta térmica. No convertimos automáticamente cualquier consola a metal líquido; primero confirmamos arquitectura, sellos, estado del disipador y causa real de la temperatura.' },
  { question: '¿Cuánto dura una pasta térmica de buena calidad?', answer: 'Depende de temperatura, ciclos de uso, presión, diseño del disipador y calidad del compuesto. En lugar de prometer un número fijo de años, recomendamos revisar cuando cambian ruido, temperatura o rendimiento.' },
  { question: '¿El metal líquido conduce electricidad?', answer: 'Sí. Es una aleación metálica y puede provocar un corto circuito si toca componentes fuera del chip. Por eso solo se aplica con aislamiento adecuado, cantidad controlada y en equipos con un diseño compatible.' },
  { question: '¿Los thermal pads y la pasta térmica hacen lo mismo?', answer: 'No. La pasta térmica cubre el contacto entre el chip principal (CPU o GPU) y el disipador. Los thermal pads cubren componentes que no tocan directamente el disipador, como memorias VRAM o el VRM. Ambos suelen coexistir en el mismo equipo.' },
];

const comparison = [
  ['Transferencia térmica', 'Buena para la mayoría de equipos', 'Muy alta en diseños compatibles'],
  ['Conductividad eléctrica', 'Generalmente no conductora', 'Conductora: riesgo de corto si se derrama'],
  ['Riesgo', 'Bajo si se aplica correctamente', 'Alto sin aislamiento o compatibilidad'],
  ['Compatibilidad', 'Prácticamente universal', 'Solo diseños y materiales compatibles'],
  ['Aluminio', 'Compatible', 'No recomendado: puede deteriorarlo'],
  ['Cobre', 'Compatible', 'Compatible en la mayoría de casos'],
  ['Níquel / recubrimientos', 'Compatible', 'Depende del recubrimiento y espesor'],
  ['CPU', 'Uso estándar en la mayoría de equipos', 'Solo con IHS o disipador compatible'],
  ['GPU', 'Uso estándar, combinada con thermal pads', 'Uso avanzado; exige aislamiento'],
  ['Laptop gamer', 'Opción segura y mantenible', 'Depende del diseño y el fabricante'],
  ['PS5', 'Usada en algunas revisiones', 'De fábrica en la interfaz del APU'],
  ['Facilidad de mantenimiento', 'Sencilla, tolerante a variaciones', 'Delicada; exige limpieza y control'],
  ['Durabilidad', 'Depende del compuesto y los ciclos térmicos', 'Depende del sellado y la estabilidad del equipo'],
  ['Aplicación', 'Cantidad controlada, tolerante', 'Cantidad mínima; aislamiento obligatorio'],
  ['Precio relativo', 'Depende del compuesto: de accesible a premium', 'Generalmente mayor por material y mano de obra'],
  ['Usuario recomendado', 'Uso general, oficina y gaming estándar', 'Usuarios avanzados con equipo compatible'],
];

const decisionRows = [
  ['PC de oficina', 'Pasta térmica', 'RECOMENDADO'],
  ['PC gamer', 'Pasta premium o PTM según el diseño', 'DEPENDE'],
  ['Laptop convencional', 'Pasta térmica o material original', 'RECOMENDADO'],
  ['Laptop gamer', 'Material original, PTM o pasta adecuada', 'DEPENDE'],
  ['Laptop con metal líquido de fábrica', 'Mantener la arquitectura original', 'RIESGO ALTO'],
  ['GPU', 'Pasta térmica + pads o putty según diseño', 'DEPENDE'],
  ['PS5', 'Metal líquido donde lo define el diseño', 'DEPENDE'],
];

const serviceLinks = [
  ['/servicios/laptop/pasta-termica', 'fa-temperature-half', 'Cambio de pasta térmica en Cancún', 'Limpieza, revisión de ventilación y aplicación según el equipo.'],
  ['/blogs/aplicacion-metal-liquido-cancun', 'fa-flask', 'Aplicación de metal líquido en Cancún', 'Evaluación de compatibilidad de disipador, aislamiento eléctrico y renovación en taller.'],
  ['/servicios/pc/limpieza-profunda', 'fa-fan', 'Limpieza interna de laptop y PC', 'Retiro de polvo en disipadores, ventiladores, filtros y gabinete.'],
  ['/servicios/pc/tarjeta-video-gpu#mantenimiento-gpu', 'fa-microchip', 'Pasta y pads térmicos de GPU', 'Revisión de chip, hotspot, memorias, VRM y espesores compatibles.'],
  ['/servicios/laptop/mantenimiento-preventivo', 'fa-laptop', 'Mantenimiento de laptop gamer', 'Servicio térmico para equipos con CPU y GPU dedicados.'],
  ['/servicios/pc/refrigeracion', 'fa-wind', 'Revisión de ventiladores', 'Diagnóstico de ruido, RPM, bombas, airflow y montaje.'],
];

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Service',
    name: 'Diagnóstico térmico: pasta térmica vs metal líquido',
    serviceType: 'Diagnóstico y mantenimiento térmico para PC, laptop, GPU y consolas',
    url: `https://pixon.com.mx${canonical}`,
    description: 'Comparativa, diagnóstico térmico, limpieza interna, cambio de pasta térmica y aplicación controlada de metal líquido en Cancún.',
    provider: { '@id': 'https://pixon.com.mx/#business' },
    areaServed: [{ '@type': 'City', name: 'Cancún' }, { '@type': 'State', name: 'Quintana Roo' }],
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })),
  },
];
---

<Base
  title="Pasta térmica vs metal líquido: ¿cuál conviene? | Pixon PC"
  description="Compara pasta térmica vs metal líquido: temperatura, seguridad, riesgos, duración y uso en PC, laptops gamer, GPU y PS5. Guía técnica de Pixon PC."
  canonical={canonical}
  image="/assets/images/mantenimiento-pastaternima-thermalpads.webp"
  schema={schema}
  bodyClass="service-page thermal-compare-page"
>
  <Navbar />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Blogs', href: '/blogs' }, { label: 'Pasta térmica vs metal líquido' }]} />

  <header class="tc-hero">
    <div class="tc-shell tc-hero__grid">
      <div class="tc-hero__copy">
        <span class="tc-eyebrow">GUÍA TÉRMICA · PIXON PC</span>
        <h1>Pasta térmica vs metal líquido</h1>
        <p class="tc-hero__sub">¿Cuál enfría mejor y cuál conviene realmente?</p>
        <p class="tc-hero__lead">
          Comparamos transferencia térmica, seguridad y compatibilidad en PC, laptops gamer, GPU y consolas.<br class="tc-br-desktop" />
          No elegimos por moda: medimos antes de intervenir.
        </p>

        <div class="tc-conclusions" role="region" aria-label="Conclusiones técnicas inmediatas">
          <article class="tc-decision-card tc-decision-card--paste">
            <div class="tc-decision-card__top">
              <span class="tc-decision-tag tc-decision-tag--paste">Para la mayoría</span>
              <strong class="tc-decision-name">Pasta térmica</strong>
            </div>
            <p class="tc-decision-desc">Segura, dieléctrica y universal en cualquier disipador de aluminio o cobre.</p>
          </article>

          <article class="tc-decision-card tc-decision-card--metal">
            <div class="tc-decision-card__top">
              <span class="tc-decision-tag tc-decision-tag--metal">Mayor transferencia</span>
              <strong class="tc-decision-name">Metal líquido</strong>
            </div>
            <p class="tc-decision-desc">Máxima disipación térmica (73+ W/mK) en hardware de alto rendimiento compatible.</p>
          </article>

          <article class="tc-decision-card tc-decision-card--risk">
            <div class="tc-decision-card__top">
              <span class="tc-decision-tag tc-decision-tag--risk">Mayor riesgo</span>
              <strong class="tc-decision-name">Metal líquido</strong>
            </div>
            <p class="tc-decision-desc">Conductor eléctrico: corroe aluminio y exige barrera de aislamiento físico.</p>
          </article>
        </div>

        <div class="tc-hero__ctas">
          <a class="tc-btn" href="#comparativa">Ver comparativa técnica</a>
          <a class="tc-btn tc-btn--ghost" href="#ticket-termico">Solicitar diagnóstico térmico</a>
        </div>
      </div>

      <div class="tc-bench" role="region" aria-label="Laboratorio de simulación térmica comparativa">
        <input type="radio" name="tc-bench-mode" id="tc-mode-split" class="tc-bench__radio" checked />
        <input type="radio" name="tc-bench-mode" id="tc-mode-paste" class="tc-bench__radio" />
        <input type="radio" name="tc-bench-mode" id="tc-mode-metal" class="tc-bench__radio" />

        <div class="tc-bench__header">
          <div class="tc-bench__title">
            <span class="tc-bench__status-dot"></span>
            <span>BANCO TÉRMICO · ANÁLISIS DE INTERFAZ</span>
          </div>
          <div class="tc-bench__tabs" role="tablist" aria-label="Modo de visualización comparativa">
            <label for="tc-mode-split" class="tc-bench__tab" tabindex="0">Comparativa dual</label>
            <label for="tc-mode-paste" class="tc-bench__tab" tabindex="0">Pasta térmica</label>
            <label for="tc-mode-metal" class="tc-bench__tab" tabindex="0">Metal líquido</label>
          </div>
        </div>

        <div class="tc-bench__display">
          <svg class="tc-bench__svg" viewBox="0 0 560 238" aria-label="Diagrama técnico comparativo de transferencia térmica">
            <defs>
              <pattern id="tc-grid" width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#dce6ee" stroke-width="0.75" />
              </pattern>
              <linearGradient id="tc-g-copper" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#9a3412" />
                <stop offset="30%" stop-color="#ea580c" />
                <stop offset="60%" stop-color="#fb923c" />
                <stop offset="85%" stop-color="#c2410c" />
                <stop offset="100%" stop-color="#7c2d12" />
              </linearGradient>
              <linearGradient id="tc-g-coldplate" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#0f2f4d" />
                <stop offset="50%" stop-color="#163e63" />
                <stop offset="100%" stop-color="#0a2239" />
              </linearGradient>
              <linearGradient id="tc-g-paste-mat" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#64748b" />
                <stop offset="50%" stop-color="#475569" />
                <stop offset="100%" stop-color="#334155" />
              </linearGradient>
              <linearGradient id="tc-g-liquid-metal" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#94a3b8" />
                <stop offset="25%" stop-color="#f8fafc" />
                <stop offset="50%" stop-color="#cbd5e1" />
                <stop offset="75%" stop-color="#ffffff" />
                <stop offset="100%" stop-color="#64748b" />
              </linearGradient>
              <linearGradient id="tc-g-ihs" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#cbd5e1" />
                <stop offset="50%" stop-color="#94a3b8" />
                <stop offset="100%" stop-color="#64748b" />
              </linearGradient>
              <linearGradient id="tc-g-die" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#0f172a" />
                <stop offset="100%" stop-color="#020617" />
              </linearGradient>
              <pattern id="tc-barrier-hatch" width="8" height="8" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
                <line x1="0" y1="0" x2="0" y2="8" stroke="#d97706" stroke-width="2.5" />
              </pattern>
              <filter id="tc-glow-paste" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="0" stdDeviation="2" flood-color="#f97316" flood-opacity="0.6"/>
              </filter>
              <filter id="tc-glow-metal" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="0" stdDeviation="2" flood-color="#ef4444" flood-opacity="0.8"/>
              </filter>
            </defs>

            <!-- Technical grid backdrop -->
            <rect x="15" y="6" width="530" height="226" rx="6" fill="#f8fafc" stroke="#dce6ee" stroke-width="1" />
            <rect x="15" y="6" width="530" height="226" rx="6" fill="url(#tc-grid)" />

            <!-- TOP: HEATSINK COOLER -->
            <g class="tc-elem tc-elem--cooler">
              <!-- Cooling fin lines -->
              <g stroke="#cbd5e1" stroke-width="1.5">
                <line x1="28" y1="20" x2="532" y2="20" />
                <line x1="28" y1="27" x2="532" y2="27" />
                <line x1="28" y1="34" x2="532" y2="34" />
                <line x1="28" y1="41" x2="532" y2="41" />
                <line x1="28" y1="48" x2="532" y2="48" />
                <line x1="28" y1="55" x2="532" y2="55" />
              </g>

              <!-- Left heatpipes (Pasta) -->
              <g class="tc-side-elem tc-side-elem--paste">
                <rect x="75" y="14" width="18" height="46" rx="3" fill="url(#tc-g-copper)" stroke="#7c2d12" stroke-width="1" />
                <rect x="140" y="14" width="18" height="46" rx="3" fill="url(#tc-g-copper)" stroke="#7c2d12" stroke-width="1" />
                <rect x="205" y="14" width="18" height="46" rx="3" fill="url(#tc-g-copper)" stroke="#7c2d12" stroke-width="1" />
              </g>
              <!-- Right heatpipes (Metal) -->
              <g class="tc-side-elem tc-side-elem--metal">
                <rect x="337" y="14" width="18" height="46" rx="3" fill="url(#tc-g-copper)" stroke="#7c2d12" stroke-width="1" />
                <rect x="402" y="14" width="18" height="46" rx="3" fill="url(#tc-g-copper)" stroke="#7c2d12" stroke-width="1" />
                <rect x="467" y="14" width="18" height="46" rx="3" fill="url(#tc-g-copper)" stroke="#7c2d12" stroke-width="1" />
              </g>

              <!-- Cooler title pill -->
              <rect x="190" y="6" width="180" height="15" rx="3" fill="#071f3a" />
              <text x="280" y="17" fill="#93c5fd" font-size="7.5" font-weight="800" letter-spacing="0.08em" text-anchor="middle" font-family="system-ui, sans-serif">DISIPADOR · HEATPIPES Y ALETAS</text>

              <!-- Coldplate block -->
              <rect x="28" y="60" width="504" height="34" rx="4" fill="url(#tc-g-coldplate)" stroke="#071f3a" stroke-width="1.5" />
              <line x1="28" y1="93" x2="532" y2="93" stroke="#38bdf8" stroke-width="1" stroke-opacity="0.7" />

              <text x="140" y="79" fill="#93c5fd" font-size="8.5" font-weight="800" letter-spacing="0.05em" text-anchor="middle" font-family="system-ui, sans-serif">BASE COBRE / NÍQUEL</text>
              <text x="402" y="79" fill="#93c5fd" font-size="8.5" font-weight="800" letter-spacing="0.05em" text-anchor="middle" font-family="system-ui, sans-serif">BASE COBRE / NÍQUEL</text>
            </g>

            <!-- CENTER: THERMAL INTERFACE LAYER (TIM) -->
            <!-- Left: Pasta Térmica (Thicker layer ~0.10mm, y=94 to 114) -->
            <g class="tc-side-elem tc-side-elem--paste">
              <rect x="40" y="94" width="228" height="20" rx="3" fill="url(#tc-g-paste-mat)" stroke="#334155" stroke-width="1" />
              <g stroke="#64748b" stroke-width="1" stroke-dasharray="2 3" opacity="0.6">
                <line x1="50" y1="100" x2="258" y2="100" />
                <line x1="50" y1="107" x2="258" y2="107" />
              </g>
              <text x="154" y="107" fill="#f1f5f9" font-size="8.5" font-weight="800" letter-spacing="0.06em" text-anchor="middle" font-family="system-ui, sans-serif">PASTA TÉRMICA (CAPA ~0.10 mm)</text>
              <path d="M 32 94 L 36 94 M 34 94 L 34 114 M 32 114 L 36 114" stroke="#64748b" stroke-width="1" />
              <text x="29" y="106" fill="#475569" font-size="7.5" font-weight="700" text-anchor="end" font-family="system-ui, sans-serif">~0.1 mm</text>
            </g>

            <!-- Right: Metal Líquido (Ultra-thin layer ~0.02mm, y=94 to 102) -->
            <g class="tc-side-elem tc-side-elem--metal">
              <rect x="292" y="94" width="174" height="8" rx="2" fill="url(#tc-g-liquid-metal)" stroke="#94a3b8" stroke-width="1" />
              <line x1="295" y1="97" x2="463" y2="97" stroke="#ffffff" stroke-width="1.5" opacity="0.9" />
              <text x="378" y="101" fill="#071f3a" font-size="7.5" font-weight="900" letter-spacing="0.05em" text-anchor="middle" font-family="system-ui, sans-serif">METAL LÍQUIDO (~0.02 mm)</text>
              <!-- Barrier gasket -->
              <rect x="470" y="94" width="50" height="22" rx="3" fill="url(#tc-barrier-hatch)" stroke="#d97706" stroke-width="1.5" />
              <text x="495" y="127" fill="#b45309" font-size="7" font-weight="800" letter-spacing="0.04em" text-anchor="middle" font-family="system-ui, sans-serif">BARRERA AISLANTE</text>
            </g>

            <!-- BOTTOM: CPU/GPU DIE & SUBSTRATE -->
            <g class="tc-elem tc-elem--die">
              <!-- Left IHS -->
              <g class="tc-side-elem tc-side-elem--paste">
                <rect x="40" y="114" width="228" height="32" rx="2" fill="url(#tc-g-ihs)" stroke="#475569" stroke-width="1" />
                <text x="154" y="134" fill="#1e293b" font-size="8.5" font-weight="800" letter-spacing="0.05em" text-anchor="middle" font-family="system-ui, sans-serif">IHS / DIFUSOR TÉRMICO (NÍQUEL)</text>
              </g>
              <!-- Right Silicon Die -->
              <g class="tc-side-elem tc-side-elem--metal">
                <rect x="292" y="102" width="174" height="44" rx="2" fill="url(#tc-g-die)" stroke="#0ea5e9" stroke-width="1" />
                <g stroke="#0284c7" stroke-width="1" opacity="0.6">
                  <line x1="305" y1="116" x2="453" y2="116" />
                  <line x1="305" y1="126" x2="453" y2="126" />
                  <line x1="305" y1="136" x2="453" y2="136" />
                </g>
                <text x="378" y="128" fill="#38bdf8" font-size="8.5" font-weight="800" letter-spacing="0.05em" text-anchor="middle" font-family="system-ui, sans-serif">DIE DE SILICIO (CONTACTO DIRECTO)</text>
              </g>

              <!-- Substrate PCB -->
              <rect x="28" y="146" width="504" height="26" rx="3" fill="#064e3b" stroke="#043327" stroke-width="1.5" />
              <!-- SMD components positioned at extremes, leaving center completely clear -->
              <g fill="#f59e0b">
                <rect x="42" y="153" width="7" height="12" rx="1" />
                <rect x="54" y="153" width="7" height="12" rx="1" />
                <rect x="66" y="153" width="7" height="12" rx="1" />
                <rect x="480" y="153" width="7" height="12" rx="1" />
                <rect x="492" y="153" width="7" height="12" rx="1" />
                <rect x="504" y="153" width="7" height="12" rx="1" />
              </g>
              <!-- BGA Solder Balls -->
              <g fill="#94a3b8" opacity="0.8">
                <circle cx="45" cy="176" r="2.5" />
                <circle cx="75" cy="176" r="2.5" />
                <circle cx="105" cy="176" r="2.5" />
                <circle cx="135" cy="176" r="2.5" />
                <circle cx="165" cy="176" r="2.5" />
                <circle cx="195" cy="176" r="2.5" />
                <circle cx="225" cy="176" r="2.5" />
                <circle cx="255" cy="176" r="2.5" />
                <circle cx="305" cy="176" r="2.5" />
                <circle cx="335" cy="176" r="2.5" />
                <circle cx="365" cy="176" r="2.5" />
                <circle cx="395" cy="176" r="2.5" />
                <circle cx="425" cy="176" r="2.5" />
                <circle cx="455" cy="176" r="2.5" />
                <circle cx="485" cy="176" r="2.5" />
                <circle cx="515" cy="176" r="2.5" />
              </g>
              <text x="280" y="163" fill="#6ee7b7" font-size="8.5" font-weight="800" letter-spacing="0.08em" text-anchor="middle" font-family="system-ui, sans-serif">SUSTRATO PCB · PAQUETE DEL PROCESADOR</text>
            </g>

            <!-- CENTER SPLIT AXIS -->
            <g class="tc-split-axis">
              <line x1="280" y1="16" x2="280" y2="182" stroke="#0ea5e9" stroke-width="1.5" stroke-dasharray="4 3" />
              <rect x="266" y="86" width="28" height="16" rx="4" fill="#071f3a" stroke="#0ea5e9" stroke-width="1.5" />
              <text x="280" y="97" fill="#38bdf8" font-size="8.5" font-weight="900" text-anchor="middle" font-family="system-ui, sans-serif">VS</text>
            </g>

            <!-- ANIMATED THERMAL FLOW VECTORS -->
            <!-- Left: Pasta Térmica (Steady, uniform) -->
            <g class="tc-side-elem tc-side-elem--paste">
              <g class="tc-heat-flow tc-heat-flow--paste">
                <g class="tc-heat-pulse tc-heat-pulse--p1">
                  <circle cx="84" cy="138" r="3.5" fill="#f97316" filter="url(#tc-glow-paste)" />
                  <path d="M 84 138 L 84 84" stroke="#f97316" stroke-width="2" stroke-linecap="round" stroke-dasharray="3 3" opacity="0.75" />
                </g>
