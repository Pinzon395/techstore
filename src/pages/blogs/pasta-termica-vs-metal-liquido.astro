<style is:global>
  :global(.thermal-compare-page section[id]){content-visibility:visible!important;contain:none!important}
  :global(.thermal-compare-page .tc-main>section){padding-top:20px!important;padding-bottom:20px!important}
  .tc-main,.tc-hero,.tc-final{--ink:#071F3A;--blue:#1479D4;--muted:#294963;--line:#cbdce8;--ice:#eef6fc;color:var(--ink)}
  .tc-shell{width:min(1180px,calc(100% - (var(--page-gutter) * 2)));margin:0 auto}.tc-section{padding:20px 0;content-visibility:visible!important;contain:none!important}.tc-section :where(h2,h3,p,li,span,strong,a,td,th){color:var(--ink)}.tc-svg{display:block;width:18px;height:18px;max-width:22px;max-height:22px;fill:currentColor;flex:0 0 auto}
  .tc-section h2,.tc-final h2{margin:0 0 18px;font-family:var(--font-heading);font-size:clamp(2rem,3.8vw,3.45rem);font-style:italic;font-weight:800;line-height:1.08;text-wrap:balance}.tc-section h3,.tc-final h3{margin:22px 0 8px;font-size:1.08rem;line-height:1.3;text-wrap:balance}.tc-section p,.tc-final p{max-width:72ch;margin:0;color:var(--muted);font-weight:500;line-height:1.72}.tc-split,.tc-feature-grid,.tc-metal__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(340px,.88fr);gap:clamp(36px,7vw,88px);align-items:center}.tc-split--reverse>figure{grid-column:1;grid-row:1}.tc-split--reverse>.tc-copy{grid-column:2;grid-row:1}.tc-icon{display:grid;width:42px;height:42px;margin-bottom:16px;place-items:center;border-radius:8px;color:var(--blue);background:#dceffc}.tc-icon>.tc-svg{width:18px;height:18px}.tc-icon--dark{color:#fff;background:var(--ink)}
  .tc-media{margin:0;overflow:hidden;border-radius:8px;background:#dce8f1}.tc-media img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}.tc-media--tall img{aspect-ratio:4/5}.tc-media figcaption{padding:12px 15px;color:var(--muted);font-size:.82rem;font-weight:650}.tc-heading{display:grid;grid-template-columns:48px minmax(0,780px);gap:16px;align-items:start;margin-bottom:24px}.tc-heading>.tc-svg{box-sizing:border-box;width:42px;height:42px;max-width:42px;max-height:42px;padding:11px;border-radius:8px;color:#fff;background:var(--blue)}.tc-heading h2{margin-top:0}
  .tc-plain-list{display:grid;gap:10px;margin:16px 0;padding:0;list-style:none;max-width:72ch}.tc-plain-list li{position:relative;padding-left:20px;color:var(--muted);font-weight:500;line-height:1.6}.tc-plain-list li::before{content:"";position:absolute;left:0;top:.65em;width:7px;height:7px;border-radius:50%;background:var(--blue)}

  /* Hero v3 — Thermal Engineering Laboratory Bench */
  .tc-hero{position:relative;padding:clamp(28px,3.8vw,48px) 0 clamp(32px,4vw,52px);background:linear-gradient(180deg,#f8fafc 0%,#eef4f8 100%);border-bottom:1px solid var(--line)}
  .tc-hero__grid{display:grid;grid-template-columns:minmax(0,.44fr) minmax(320px,.56fr);gap:clamp(24px,3.5vw,48px);align-items:center}
  .tc-eyebrow{display:inline-block;color:var(--blue);font-size:.76rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase}
  .tc-hero h1{max-width:14ch;margin:10px 0 4px;color:var(--ink);font-family:var(--font-heading);font-size:clamp(2.1rem,3.4vw,2.9rem);font-style:italic;font-weight:800;line-height:1.05;text-wrap:balance}
  .tc-hero__sub{max-width:24ch;margin:0 0 10px;color:var(--ink);font-family:var(--font-heading);font-size:clamp(1.05rem,1.5vw,1.25rem);font-weight:700;line-height:1.28;text-wrap:balance}
  .tc-hero__lead{max-width:46ch;margin:0 0 12px;color:var(--muted);font-size:.92rem;line-height:1.55}
  .tc-br-desktop{display:inline}

  /* Mini conclusiones / Decision Badges */
  .tc-conclusions{display:grid;gap:8px;margin:14px 0 18px;max-width:480px}
  .tc-decision-card{display:grid;gap:3px;padding:8px 12px;border-radius:8px;background:#fff;border:1px solid #d8e5ef;box-shadow:0 1px 3px rgba(7,31,58,.04);transition:transform 160ms ease,border-color 160ms ease}
  .tc-decision-card:hover{border-color:#9ec2db;transform:translateX(2px)}
  .tc-decision-card__top{display:flex;align-items:center;gap:9px}
  .tc-decision-tag{padding:2px 7px;border-radius:4px;font-size:.65rem;font-weight:800;letter-spacing:.03em;text-transform:uppercase;white-space:nowrap}
  .tc-decision-tag--paste{color:#1e3a5f;background:#e2edf6}
  .tc-decision-tag--metal{color:#854d0e;background:#fef3c7}
  .tc-decision-tag--risk{color:#991b1b;background:#fee2e2}
  .tc-decision-name{color:var(--ink);font-size:.9rem;font-weight:800}
  .tc-decision-desc{margin:0!important;color:var(--muted);font-size:.81rem;line-height:1.38}

  /* CTAs */
  .tc-hero__ctas{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:16px}
  .tc-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:11px 20px;border:1px solid var(--blue);border-radius:8px;color:#fff!important;background:var(--blue);font-weight:800;text-decoration:none;transition:transform 160ms cubic-bezier(.23,1,.32,1),background-color 160ms ease}
  .tc-btn--ghost{border-color:var(--ink);background:transparent;color:var(--ink)!important}
  .tc-btn:active{transform:scale(.97)}
  .tc-btn:focus-visible,.tc-bench__tab:focus-visible{outline:2px solid var(--blue);outline-offset:2px}

  /* Laboratory Bench Enclosure */
  .tc-bench{position:relative;border-radius:12px;background:#fff;border:1px solid #c9dbe7;box-shadow:0 8px 28px rgba(7,31,58,.08);overflow:hidden;display:grid}
  .tc-bench__radio{position:absolute;opacity:0;width:1px;height:1px;pointer-events:none}
  .tc-bench__header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;padding:9px 14px;background:#f1f6fa;border-bottom:1px solid #dce6ee}
  .tc-bench__title{display:inline-flex;align-items:center;gap:7px;color:var(--ink);font-size:.7rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .tc-bench__status-dot{width:8px;height:8px;border-radius:50%;background:#10b981;box-shadow:0 0 0 2px rgba(16,185,129,.25);animation:tc-pulse 2s infinite ease-in-out}
  @keyframes tc-pulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.2);opacity:.75}}
  .tc-bench__tabs{display:flex;gap:3px;padding:3px;border-radius:20px;background:#e2ebf1}
  .tc-bench__tab{padding:5px 11px;border-radius:16px;color:var(--muted);font-size:.72rem;font-weight:750;letter-spacing:.02em;cursor:pointer;user-select:none;transition:background-color 160ms ease,color 160ms ease;white-space:nowrap}
  .tc-bench__tab:hover{color:var(--ink)}

  /* Tab Active States */
  #tc-mode-split:checked ~ .tc-bench__header label[for="tc-mode-split"],
  #tc-mode-paste:checked ~ .tc-bench__header label[for="tc-mode-paste"],
  #tc-mode-metal:checked ~ .tc-bench__header label[for="tc-mode-metal"]{background:#fff;color:var(--ink);box-shadow:0 1px 4px rgba(7,31,58,.16);font-weight:800}

  #tc-mode-split:focus-visible ~ .tc-bench__header label[for="tc-mode-split"],
  #tc-mode-paste:focus-visible ~ .tc-bench__header label[for="tc-mode-paste"],
  #tc-mode-metal:focus-visible ~ .tc-bench__header label[for="tc-mode-metal"]{outline:2px solid var(--blue);outline-offset:2px}

  /* Bench Display and SVG */
  .tc-bench__display{padding:10px 12px 2px;background:#fff}
  .tc-bench__svg{display:block;width:100%;height:auto;max-height:340px}
  .tc-side-elem{transition:opacity 220ms ease,filter 220ms ease}

  /* Interaction Modes */
  #tc-mode-paste:checked ~ .tc-bench__display .tc-side-elem--paste{opacity:1}
  #tc-mode-paste:checked ~ .tc-bench__display .tc-side-elem--metal{opacity:.22;filter:grayscale(80%)}
  #tc-mode-paste:checked ~ .tc-bench__specs .tc-bench-spec--paste{border-color:var(--blue);box-shadow:0 0 0 1px var(--blue),0 4px 12px rgba(20,121,212,.1);background:#f0f7fd}
  #tc-mode-paste:checked ~ .tc-bench__specs .tc-bench-spec--metal{opacity:.45}

  #tc-mode-metal:checked ~ .tc-bench__display .tc-side-elem--metal{opacity:1}
  #tc-mode-metal:checked ~ .tc-bench__display .tc-side-elem--paste{opacity:.22;filter:grayscale(80%)}
  #tc-mode-metal:checked ~ .tc-bench__specs .tc-bench-spec--metal{border-color:#d97706;box-shadow:0 0 0 1px #d97706,0 4px 12px rgba(217,119,6,.12);background:#fffbeb}
  #tc-mode-metal:checked ~ .tc-bench__specs .tc-bench-spec--paste{opacity:.45}

  /* Thermal flow animations — Only transform & opacity */
  @keyframes tc-flow-paste{0%{transform:translateY(0);opacity:0}25%{opacity:.95}75%{opacity:.95}100%{transform:translateY(-50px);opacity:0}}
  @keyframes tc-flow-metal{0%{transform:translateY(0);opacity:0}20%{opacity:1}70%{opacity:1}100%{transform:translateY(-58px);opacity:0}}

  .tc-heat-pulse--p1{animation:tc-flow-paste 3.2s ease-in-out infinite 0s}
  .tc-heat-pulse--p2{animation:tc-flow-paste 3.2s ease-in-out infinite .7s}
  .tc-heat-pulse--p3{animation:tc-flow-paste 3.2s ease-in-out infinite 1.4s}

