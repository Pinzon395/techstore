  <script>
    document.querySelectorAll<HTMLElement>('[data-climate-simulator]').forEach((simulator) => {
      const toggle = simulator.querySelector<HTMLButtonElement>('.climate-sim-toggle');
      if (!toggle) return;

      toggle.addEventListener('click', () => {
        const paused = simulator.classList.toggle('is-paused');
        toggle.setAttribute('aria-pressed', String(paused));
        toggle.setAttribute('aria-label', paused ? 'Reanudar secuencia visual' : 'Pausar secuencia visual');
        const label = toggle.querySelector<HTMLElement>('.climate-sim-toggle__label');
        if (label) label.textContent = paused ? 'Reanudar' : 'Pausar';
      });

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(([entry]) => {
          simulator.classList.toggle('is-offscreen', !entry?.isIntersecting);
        }, { rootMargin: '120px 0px', threshold: 0.01 });
        observer.observe(simulator);
      }
    });
  </script>

