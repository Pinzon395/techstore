  }

  .climate-hero p {
    font-size: clamp(0.96rem, 1.18vw, 1.08rem);
    line-height: 1.66;
    color: rgba(255, 255, 255, 0.92) !important;
    margin: 0 0 24px;
  }

  .climate-hero p strong {
    color: #38bdf8;
  }

  .climate-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .climate-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    padding: 11px 20px;
    border-radius: 8px;
    border: 1px solid var(--blue);
    background: var(--blue);
    color: #ffffff !important;
    font-size: 0.90rem;
    font-weight: 800;
    text-decoration: none;
    cursor: pointer;
    line-height: 1;
    transition: transform 160ms cubic-bezier(0.2, 0.8, 0.2, 1), background-color 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .climate-btn:hover {
    background: #0f66b5;
    border-color: #60a5fa;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(20, 121, 212, 0.45);
  }

  .climate-btn--ghost {
    border-color: rgba(255, 255, 255, 0.35);
    background: rgba(7, 31, 58, 0.65);
    color: #ffffff !important;
  }

  .climate-btn--ghost:hover {
    background: rgba(20, 121, 212, 0.25);
    border-color: #38bdf8;
    transform: translateY(-2px);
  }

  .climate-btn--ghost-dark {
    border-color: var(--ink);
    background: transparent;
    color: var(--ink) !important;
  }

  .climate-btn--ghost-dark:hover {
    background: var(--ink);
    color: #ffffff !important;
    transform: translateY(-2px);
  }

  .climate-hero__facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin: 32px 0 0;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .climate-hero__facts div {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .climate-hero__facts dt {
    font-family: monospace;
    font-size: clamp(1.15rem, 1.6vw, 1.45rem);
    font-weight: 850;
    color: #38bdf8;
    line-height: 1;
  }

  .climate-hero__facts dd {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.3;
  }

  /* ============================================================
     SIMULADOR PCB — ciclo narrativo único de 10 segundos
     Condensación → contaminación → puente → arco → daño
     ============================================================ */
  .climate-stage-box {
    --sim-cycle: 10s;
    position: relative;
    width: min(100%, 590px);
    max-width: 590px;
    margin: 0 auto;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgba(84, 199, 248, 0.34);
    border-radius: 14px;
    background: #050c16;
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.48), 0 0 0 1px rgba(255, 255, 255, 0.025) inset;
  }

  .climate-stage-box::before {
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    box-shadow: 0 0 70px rgba(56, 189, 248, 0.08) inset;
    content: '';
    pointer-events: none;
  }

  .climate-sim-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 62px;
    padding: 11px 15px;
    border-bottom: 1px solid rgba(91, 174, 218, 0.2);
    background: linear-gradient(180deg, rgba(7, 17, 29, 0.99), rgba(3, 10, 18, 0.99));
  }

  .climate-sim-status {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 10px;
  }

  .climate-sim-status > div {
    display: grid;
    min-width: 0;
    gap: 2px;
  }

  .climate-sim-status span:not(.climate-sim-pulse) {
    color: #6f8aa5 !important;
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.61rem;
    font-weight: 800;
    letter-spacing: 0.13em;
  }

  .climate-sim-status strong {
    overflow: hidden;
    color: #e8f3fa;
    font-size: 0.74rem;
    font-weight: 760;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .climate-sim-pulse {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    border: 2px solid rgba(56, 189, 248, 0.22);
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.08), 0 0 12px rgba(56, 189, 248, 0.62);
    animation: simHeaderPulse var(--sim-cycle) linear infinite;
  }

  .climate-sim-badge {
    flex: 0 0 auto;
    padding: 5px 8px;
    border: 1px solid rgba(56, 189, 248, 0.22);
    border-radius: 5px;
    background: rgba(56, 189, 248, 0.08);
    color: #7dd3fc !important;
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.61rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .climate-sim-controls {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    gap: 7px;
  }

  .climate-sim-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 29px;
    padding: 5px 8px;
    border: 1px solid rgba(145, 174, 199, 0.24);
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.035);
    color: #b8c7d6;
    font-size: 0.63rem;
    font-weight: 760;
    cursor: pointer;
    transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease;
  }

  .climate-sim-toggle:hover {
    border-color: rgba(125, 211, 252, 0.52);
    background: rgba(56, 189, 248, 0.09);
    color: #eaf8ff;
  }

  .climate-sim-toggle:focus-visible {
    outline: 2px solid #7dd3fc;
    outline-offset: 2px;
  }

  .climate-sim-toggle__icon {
    position: relative;
    width: 9px;
    height: 10px;
    flex: 0 0 auto;
  }

  .climate-sim-toggle__icon::before,
  .climate-sim-toggle__icon::after {
    position: absolute;
    top: 1px;
    bottom: 1px;
    width: 2px;
    border-radius: 1px;
    background: currentColor;
    content: '';
  }

  .climate-sim-toggle__icon::before { left: 1px; }
  .climate-sim-toggle__icon::after { right: 1px; }

  .climate-sim-toggle[aria-pressed='true'] .climate-sim-toggle__icon::before {
    inset: 0;
    width: 0;
    height: 0;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    border-left: 8px solid currentColor;
    border-radius: 0;
    background: transparent;
  }

  .climate-sim-toggle[aria-pressed='true'] .climate-sim-toggle__icon::after {
    display: none;
  }

  .climate-stage-box:is(.is-paused, .is-offscreen) *,
  .climate-stage-box:is(.is-paused, .is-offscreen) *::before,
  .climate-stage-box:is(.is-paused, .is-offscreen) *::after {
    animation-play-state: paused !important;
  }

  .climate-stage-screen {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(circle at 68% 44%, rgba(31, 102, 76, 0.17), transparent 36%),
      radial-gradient(circle at 50% 0%, rgba(23, 74, 110, 0.2), transparent 55%),
      #030a12;
  }

  .climate-stage-screen::after {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(180deg, transparent 0%, rgba(255, 255, 255, 0.018) 49%, transparent 51%);
    background-size: 100% 5px;
    content: '';
    opacity: 0.32;
    pointer-events: none;
  }

  .climate-hw-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .climate-hw-svg :is(.sim-clock-hand, .sim-short-flash, .sim-spark-burst, .sim-particle, .sim-char-mark, .sim-sulfate-core, .sim-drop-ripple, .sim-falling-drop, .sim-microdrop, .sim-hotspot) {
    transform-box: fill-box;
  }

  .sim-board-mark,
  .sim-net-label,
  .sim-passives text,
  .sim-chip-title,
  .sim-chip-sub,
  .sim-ion-panel text,
  .sim-alert-title,
  .sim-alert-copy {
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  }

  .sim-board-mark { fill: #67d09a; font-size: 7.2px; font-weight: 700; letter-spacing: 0.45px; opacity: 0.54; }
  .sim-passives rect:not(:first-child) { fill: #8a4a08; stroke: #d49318; stroke-width: 1.1; }
  .sim-passives text { fill: #9cacc0; font-size: 8px; font-weight: 700; }
  .sim-net-label { fill: #8092a9; font-size: 7.6px; font-weight: 800; letter-spacing: 0.55px; }
  .sim-net-label--power { fill: #e7a827; }
  .sim-chip-title { fill: #e8f3fa; font-size: 8.7px; font-weight: 850; }
  .sim-chip-sub { fill: #55c8f7; font-size: 7.7px; font-weight: 760; }

  .sim-controller > rect:first-child {
    animation: controllerState var(--sim-cycle) linear infinite;
  }

  .sim-current-flow {
    fill: none;
    stroke-dasharray: 4 13;
    stroke-linecap: round;
    stroke-width: 2.2;
    opacity: 0;
    animation: currentFlow var(--sim-cycle) linear infinite;
  }

  .sim-current-flow--power { stroke: #fff0a8; }
  .sim-current-flow--ground { stroke: #b8d4ec; animation-direction: reverse; }

  .sim-clock-hand {
    transform-origin: 50% 100%;
    animation: clockSpin var(--sim-cycle) linear infinite;
  }

  .sim-clock-ring { animation: ringProgress var(--sim-cycle) linear infinite; }
  .sim-status-led { animation: statusLedPulse var(--sim-cycle) linear infinite; }
  .sim-phase-label { opacity: 0; }
  .sim-phase-label--1 { animation: phaseLabel1 var(--sim-cycle) step-end infinite; }
  .sim-phase-label--2 { animation: phaseLabel2 var(--sim-cycle) step-end infinite; }
  .sim-phase-label--3 { animation: phaseLabel3 var(--sim-cycle) step-end infinite; }
  .sim-phase-label--4 { animation: phaseLabel4 var(--sim-cycle) step-end infinite; }
  .sim-phase-title { fill: #eaf7ff; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 9.2px; font-weight: 850; letter-spacing: 0.3px; }
  .sim-phase-copy { fill: #94a8bc; font-size: 7.8px; }

  .sim-falling-drop {
    transform-origin: 50% 100%;
    animation: dropFall var(--sim-cycle) cubic-bezier(0.42, 0, 0.7, 1) infinite;
  }

  .sim-microdrop { fill: #7dd3fc; opacity: 0; }
  .sim-microdrop--1 { animation: microDropOne var(--sim-cycle) ease-in infinite; }
  .sim-microdrop--2 { animation: microDropTwo var(--sim-cycle) ease-in infinite; }
  .sim-drop-puddle { fill: #38bdf8; opacity: 0; animation: puddleSettle var(--sim-cycle) ease-out infinite; }
  .sim-drop-ripple { fill: none; stroke: #7dd3fc; stroke-width: 1.5; opacity: 0; transform-origin: center; }
  .ripple-1 { animation: rippleOne var(--sim-cycle) ease-out infinite; }
  .ripple-2 { animation: rippleTwo var(--sim-cycle) ease-out infinite; }
  .ripple-3 { animation: rippleThree var(--sim-cycle) ease-out infinite; }

  .sim-ion-panel { opacity: 0; animation: ionPanelState var(--sim-cycle) ease-in-out infinite; }
  .sim-ion-panel text { fill: #b9c9d8; font-size: 7.4px; font-weight: 800; }
  .sim-ion-panel .sim-ion--chloride { fill: #7dd3fc; }
  .sim-ion-panel .sim-ion--copper { fill: #f3ad36; }
  .sim-ion-panel .sim-ion-state { fill: #46dc9a; font-size: 6.4px; animation: ionStatePulse var(--sim-cycle) ease-in-out infinite; }

  .sim-sulfate-core {
    transform-origin: center;
    animation: sulfateCoreGrow var(--sim-cycle) ease-out infinite;
  }

  .sim-sulfate-tendril-1,
  .sim-sulfate-tendril-2 {
    fill: none;
    stroke: #34d399;
    stroke-dasharray: 44;
    stroke-linecap: round;
    stroke-width: 5;
    animation: tendrilCreep var(--sim-cycle) ease-out infinite;
  }

  .sim-sulfate-tendril-2 { animation-delay: -0.18s; }
  .sim-sulfate-bridge {
    fill: none;
    stroke: #8af0c5;
    stroke-dasharray: 55;
    stroke-linecap: round;
    stroke-width: 6;
    animation: bridgeConnect var(--sim-cycle) ease-in-out infinite;
  }

  .sim-salt-crystal { transform-box: fill-box; transform-origin: center; animation: saltSparkle var(--sim-cycle) ease-in-out infinite; }
  .sim-salt-crystal.c2 { animation-delay: -0.2s; }
  .sim-salt-crystal.c3 { animation-delay: -0.35s; }
  .sim-salt-crystal.c4 { animation-delay: -0.5s; }
  .sim-hotspot { opacity: 0; transform-origin: center; animation: hotspotLock var(--sim-cycle) ease-in-out infinite; }

  .sim-short-flash {
    transform-origin: center;
    animation: shortFlash var(--sim-cycle) ease-out infinite;
  }

  .sim-spark-burst { transform-origin: center; animation: sparkBurst var(--sim-cycle) ease-out infinite; }
  .sim-particle { fill: #fff7c2; opacity: 0; animation: particleFly var(--sim-cycle) ease-out infinite; }
  .sim-particle.p1 { --dx: -42px; --dy: -48px; }
  .sim-particle.p2 { --dx: 46px; --dy: -38px; fill: #ffffff; }
  .sim-particle.p3 { --dx: -49px; --dy: 31px; fill: #f59e0b; }
  .sim-particle.p4 { --dx: 44px; --dy: 37px; fill: #38bdf8; }
  .sim-particle.p5 { --dx: 7px; --dy: -58px; }
  .sim-particle.p6 { --dx: 13px; --dy: 54px; }

  .sim-char-mark { transform-origin: center; animation: burnChar var(--sim-cycle) ease-out infinite; }
  .sim-burn-crust,
  .sim-burn-cracks,
  .sim-burned-pins { opacity: 0; animation: burnDetails var(--sim-cycle) ease-out infinite; }
  .sim-smoke-trail {
    fill: none;
    stroke: #a9b7c5;
    stroke-linecap: round;
    stroke-width: 3.2;
    opacity: 0;
    animation: smokeDrift var(--sim-cycle) ease-out infinite;
  }
  .sim-smoke-trail.s2 { animation-delay: -0.18s; stroke: #d2d9df; stroke-width: 2.5; }
  .sim-alert-banner { opacity: 0; animation: alertBanner var(--sim-cycle) cubic-bezier(0.2, 0.8, 0.2, 1) infinite; }
  .sim-alert-title { fill: #fff1f2; font-size: 8.4px; font-weight: 850; letter-spacing: 0.4px; }
  .sim-alert-copy { fill: #fda4af; font-size: 7px; }

  @keyframes simHeaderPulse {
    0%, 18% { background: #38bdf8; box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.08), 0 0 12px rgba(56, 189, 248, 0.62); }
    20%, 63% { background: #f59e0b; box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.08), 0 0 12px rgba(245, 158, 11, 0.5); }
    64%, 94% { background: #ef4444; box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.09), 0 0 14px rgba(239, 68, 68, 0.65); }
    96%, 100% { background: #38bdf8; }
  }

  @keyframes currentFlow {
    0%, 7% { opacity: 0; stroke-dashoffset: 34; }
    10%, 61% { opacity: 0.86; stroke-dashoffset: -40; }
    64% { opacity: 1; }
    70%, 95% { opacity: 0.08; stroke-dashoffset: -80; }
    98%, 100% { opacity: 0; }
  }

  @keyframes controllerState {
    0%, 63% { stroke: #3abff4; }
    65%, 70% { stroke: #fff7c2; }
    73%, 95% { stroke: #ef4444; }
    98%, 100% { stroke: #3abff4; }
  }

  @keyframes clockSpin {
    0% { transform: rotate(0); }
    18% { transform: rotate(54deg); }
    52% { transform: rotate(210deg); }
    64% { transform: rotate(285deg); }
    72%, 94% { transform: rotate(360deg); }
    98%, 100% { transform: rotate(0); }
  }

  @keyframes ringProgress {
    0% { stroke: #38bdf8; stroke-dashoffset: 119.4; }
    18% { stroke: #38bdf8; stroke-dashoffset: 98; }
    52% { stroke: #f59e0b; stroke-dashoffset: 54; }
    64% { stroke: #fbbf24; stroke-dashoffset: 30; }
    72%, 94% { stroke: #ef4444; stroke-dashoffset: 0; }
    98%, 100% { stroke: #38bdf8; stroke-dashoffset: 119.4; }
  }

  @keyframes statusLedPulse {
    0%, 18% { fill: #38bdf8; }
    19%, 63% { fill: #f59e0b; }
    64%, 94% { fill: #ef4444; }
    96%, 100% { fill: #38bdf8; }
  }

  @keyframes phaseLabel1 { 0%, 18% { opacity: 1; } 19%, 100% { opacity: 0; } }
  @keyframes phaseLabel2 { 0%, 18% { opacity: 0; } 19%, 51% { opacity: 1; } 52%, 100% { opacity: 0; } }
  @keyframes phaseLabel3 { 0%, 51% { opacity: 0; } 52%, 63% { opacity: 1; } 64%, 100% { opacity: 0; } }
  @keyframes phaseLabel4 { 0%, 63% { opacity: 0; } 64%, 95% { opacity: 1; } 96%, 100% { opacity: 0; } }

  @keyframes dropFall {
    0% { opacity: 0; transform: translateY(-18px) scale(0.86); }
    4% { opacity: 1; }
    14% { opacity: 1; transform: translateY(126px) scale(1); }
    16% { opacity: 0.95; transform: translateY(137px) scale(1.45, 0.34); }
    18%, 100% { opacity: 0; transform: translateY(138px) scale(1.8, 0.12); }
  }

  @keyframes microDropOne { 0%, 5% { opacity: 0; transform: translateY(-8px); } 9% { opacity: 0.65; } 17%, 100% { opacity: 0; transform: translateY(70px); } }
  @keyframes microDropTwo { 0%, 8% { opacity: 0; transform: translateY(-7px); } 12% { opacity: 0.5; } 19%, 100% { opacity: 0; transform: translateY(78px); } }
  @keyframes puddleSettle { 0%, 15% { opacity: 0; transform: scaleX(0.2); } 18% { opacity: 0.78; transform: scaleX(1); } 28%, 91% { opacity: 0.36; } 98%, 100% { opacity: 0; } }
  @keyframes rippleOne { 0%, 15% { opacity: 0; transform: scale(0.25); } 17% { opacity: 0.9; } 25%, 100% { opacity: 0; transform: scale(2.2); } }
  @keyframes rippleTwo { 0%, 16% { opacity: 0; transform: scale(0.25); } 19% { opacity: 0.65; } 29%, 100% { opacity: 0; transform: scale(1.75); } }
  @keyframes rippleThree { 0%, 18% { opacity: 0; transform: scale(0.25); } 21% { opacity: 0.42; } 33%, 100% { opacity: 0; transform: scale(1.5); } }

  @keyframes ionPanelState { 0%, 18% { opacity: 0; } 25%, 62% { opacity: 1; } 70%, 94% { opacity: 0.34; } 98%, 100% { opacity: 0; } }
  @keyframes ionStatePulse { 0%, 24% { opacity: 0; } 34%, 62% { opacity: 1; } 70%, 100% { opacity: 0.35; } }
  @keyframes sulfateCoreGrow { 0%, 17% { opacity: 0; transform: scale(0.1); } 24% { opacity: 0.62; transform: scale(0.48); } 49% { opacity: 0.92; transform: scale(0.92); } 64%, 91% { opacity: 0.96; transform: scale(1.08); } 98%, 100% { opacity: 0; transform: scale(0.1); } }
  @keyframes tendrilCreep { 0%, 25% { opacity: 0; stroke-dashoffset: 44; } 31% { opacity: 0.72; } 54%, 91% { opacity: 1; stroke-dashoffset: 0; } 98%, 100% { opacity: 0; stroke-dashoffset: 44; } }
  @keyframes bridgeConnect { 0%, 50% { opacity: 0; stroke-dashoffset: 55; } 56% { opacity: 0.62; } 63%, 91% { opacity: 1; stroke-dashoffset: 0; } 98%, 100% { opacity: 0; stroke-dashoffset: 55; } }
  @keyframes saltSparkle { 0%, 27% { opacity: 0; transform: scale(0); } 38% { opacity: 0.75; transform: scale(0.8); } 57%, 91% { opacity: 1; transform: scale(1); } 98%, 100% { opacity: 0; transform: scale(0); } }
  @keyframes hotspotLock { 0%, 48% { opacity: 0; transform: scale(1.2) rotate(0); } 54%, 63% { opacity: 0.82; transform: scale(1) rotate(36deg); } 69%, 100% { opacity: 0; transform: scale(0.72) rotate(60deg); } }

  @keyframes shortFlash { 0%, 63% { opacity: 0; transform: scale(0.18); } 64% { opacity: 1; transform: scale(1.2); } 66% { opacity: 0.24; transform: scale(0.82); } 68% { opacity: 0.82; transform: scale(1); } 71%, 100% { opacity: 0; transform: scale(0.18); } }
  @keyframes sparkBurst { 0%, 63% { opacity: 0; transform: scale(0) rotate(0); } 64% { opacity: 1; transform: scale(1.16) rotate(0); } 67% { opacity: 0.78; transform: scale(1.42) rotate(28deg); } 69% { opacity: 1; transform: scale(0.88) rotate(46deg); } 72%, 100% { opacity: 0; transform: scale(0) rotate(70deg); } }
  @keyframes particleFly { 0%, 63% { opacity: 0; transform: translate(0, 0) scale(0.5); } 64% { opacity: 1; } 70% { opacity: 0.75; } 73%, 100% { opacity: 0; transform: translate(var(--dx), var(--dy)) scale(0.15); } }

  @keyframes burnChar { 0%, 67% { opacity: 0; transform: scale(0.2); } 71% { opacity: 0.94; transform: scale(0.9); } 78%, 94% { opacity: 0.98; transform: scale(1); } 98%, 100% { opacity: 0; transform: scale(0.2); } }
  @keyframes burnDetails { 0%, 68% { opacity: 0; } 73%, 94% { opacity: 0.96; } 98%, 100% { opacity: 0; } }
  @keyframes smokeDrift { 0%, 70% { opacity: 0; transform: translateY(8px) scale(0.85); } 74% { opacity: 0.58; } 84% { opacity: 0.26; transform: translateY(-18px) scale(1.16); } 93%, 100% { opacity: 0; transform: translateY(-34px) scale(1.35); } }
  @keyframes alertBanner { 0%, 69% { opacity: 0; transform: translate(270px, 268px); } 73%, 94% { opacity: 1; transform: translate(270px, 260px); } 98%, 100% { opacity: 0; transform: translate(270px, 268px); } }

  /* Barra narrativa inferior */
  .climate-sim-footer {
    padding: 13px 15px 15px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    background: #030a12;
  }

  .climate-sim-progress {
    height: 2px;
    margin-bottom: 11px;
    overflow: hidden;
    border-radius: 999px;
    background: #172536;
  }

  .climate-sim-progress span {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: linear-gradient(90deg, #38bdf8 0 18%, #f59e0b 40%, #34d399 58%, #ef4444 74% 100%);
    animation: simProgress var(--sim-cycle) linear infinite;
  }

  @keyframes simProgress { 0% { transform: scaleX(0); } 94% { transform: scaleX(1); } 98%, 100% { transform: scaleX(0); } }

