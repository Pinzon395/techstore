<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.mp-tab');
    const machines = document.querySelectorAll('.mp-machine');
    const devices = ['laptop', 'pc', 'console'];
    let currentIndex = 0;
    let autoTimer = null;

    function activateDevice(deviceName) {
      tabs.forEach((tab) => {
        const isMatch = tab.getAttribute('data-device') === deviceName;
        tab.classList.toggle('mp-tab--active', isMatch);
        tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
        tab.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
      });

      machines.forEach((m) => {
        const isMatch = m.getAttribute('data-device') === deviceName;
        if (isMatch) {
          m.classList.remove('mp-machine--active');
          void m.offsetWidth; // Reflow para reiniciar animaciones CSS sincronizadas
          m.classList.add('mp-machine--active');
        } else {
          m.classList.remove('mp-machine--active');
        }
      });

      currentIndex = devices.indexOf(deviceName);
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const device = tab.getAttribute('data-device');
        if (device) {
          activateDevice(device);
          resetAutoCycle();
        }
      });
    });

    function nextDevice() {
      currentIndex = (currentIndex + 1) % devices.length;
      activateDevice(devices[currentIndex]);
    }

    function resetAutoCycle() {
      if (autoTimer) clearInterval(autoTimer);
      autoTimer = setInterval(nextDevice, 12000);
    }

    resetAutoCycle();
  });
</script>
