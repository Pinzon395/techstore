      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle at 60% 30%, #000 30%, transparent 80%);
  }

  .mp-hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }
  .mp-hero__glow--cyan {
    top: -60px;
    left: -40px;
    width: 440px;
    height: 440px;
    background: rgba(20, 121, 212, 0.22);
  }
  .mp-hero__glow--navy {
    bottom: 20px;
    right: -60px;
    width: 460px;
    height: 460px;
    background: rgba(16, 185, 129, 0.15);
  }

  .mp-hero__container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);
    gap: clamp(28px, 4.5vw, 56px);
    align-items: center;
  }

  .mp-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(7, 31, 58, 0.85);
    border: 1px solid rgba(56, 189, 248, 0.35);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #bce0fb !important;
    margin-bottom: 14px;
  }

  .mp-eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }

  .mp-hero h1 {
    font-family: var(--font-heading, system-ui, sans-serif);
    font-size: clamp(1.75rem, 3.1vw, 2.55rem);
    font-weight: 850;
    line-height: 1.14;
    letter-spacing: -0.02em;
    color: #ffffff !important;
    margin: 0 0 16px;
    text-wrap: balance;
  }

  .mp-hero__lead {
    font-size: clamp(0.96rem, 1.2vw, 1.06rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9) !important;
    margin: 0 0 12px;
    max-width: 62ch;
  }

  .mp-hero__sublead {
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.74) !important;
    margin: 0 0 24px;
    max-width: 60ch;
  }

  .mp-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-bottom: 24px;
  }

  .mp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 800;
    text-decoration: none;
    cursor: pointer;
    transition: transform 180ms ease, background-color 180ms ease, box-shadow 180ms ease;
  }

  .mp-btn--primary {
    background: #25d366;
    color: #032b13 !important;
    border: 1px solid #20ba5a;
    box-shadow: 0 8px 20px -6px rgba(37, 211, 102, 0.6);
  }
  .mp-btn--primary:hover {
    background: #20ba5a;
    transform: translateY(-2px);
  }

  .mp-btn--outline {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(8px);
  }
  .mp-btn--outline:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
  }

  .mp-btn--text {
    background: transparent;
    color: #93c5fd !important;
    border: 1px solid transparent;
    padding: 10px 14px;
  }
  .mp-btn--text:hover {
    color: #ffffff !important;
    text-decoration: underline;
  }

  .mp-btn--ghost {
    background: transparent;
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.4);
  }
  .mp-btn--ghost:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .mp-btn--sm {
    min-height: 38px;
    padding: 8px 14px;
    font-size: 0.82rem;
  }

  .mp-btn--lg {
    min-height: 50px;
    padding: 13px 26px;
    font-size: 0.98rem;
  }

  .mp-btn--block {
    width: 100%;
  }

  .mp-hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .mp-hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.76rem;
    font-weight: 700;
    color: #e0f2fe !important;
  }
  .mp-hero-chip .tc-svg {
    width: 14px;
    height: 14px;
    color: #38bdf8;
  }

  /* ============================================================
     MOTION DESIGN HERO: HARDWARE 2.5D (LAPTOP, PC, CONSOLA)
     ============================================================ */
  .mp-stage-box {
    position: relative;
    border-radius: 16px;
    background: radial-gradient(circle at 50% 30%, #0d2238 0%, #040e1b 100%);
    border: 1px solid rgba(56, 189, 248, 0.22);
    box-shadow: 0 25px 60px -15px rgba(2, 8, 20, 0.65), 0 0 0 1px rgba(56, 189, 248, 0.12);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .mp-stage-screen {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 11;
    min-height: 290px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-image: radial-gradient(rgba(56, 189, 248, 0.08) 1px, transparent 1px);
    background-size: 18px 18px;
  }

  .mp-machine {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 450ms ease, transform 450ms cubic-bezier(0.22, 0.61, 0.36, 1);
    transform: scale(0.96);
  }

  .mp-machine--active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: scale(1);
  }

  .mp-hw-svg {
    width: 86%;
    height: auto;
    max-height: 88%;
    display: block;
    overflow: visible;
  }

  /* Selector accesible de modelos de hardware */
  .mp-stage-tabs {
    display: flex;
    background: rgba(3, 11, 22, 0.95);
    border-top: 1px solid rgba(56, 189, 248, 0.15);
  }

  .mp-tab {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 8px;
    font-size: 0.78rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.6) !important;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: all 180ms ease;
    position: relative;
  }
  .mp-tab:hover {
    color: #ffffff !important;
    background: rgba(56, 189, 248, 0.06);
  }
  .mp-tab--active {
    color: #38bdf8 !important;
    border-bottom-color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
  }
  .mp-tab .tc-svg {
    width: 15px;
    height: 15px;
  }

  /* Timeline de 5 fases horizontal */
  .mp-stage-timeline {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 4px;
    padding: 6px 10px 8px;
    background: rgba(2, 7, 15, 0.95);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .mp-step-pill {
    position: relative;
    padding: 5px 2px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.03);
    text-align: center;
    overflow: hidden;
  }

  .mp-step-pill span {
    position: relative;
    z-index: 1;
    font-size: 0.66rem;
    font-weight: 750;
    color: rgba(255, 255, 255, 0.65) !important;
    white-space: nowrap;
  }

  .mp-step-progress {
    position: absolute;
    inset: 0;
    background: rgba(20, 121, 212, 0.45);
    transform-origin: left;
    transform: scaleX(0);
  }

  .mp-step-pill--1 .mp-step-progress { animation: mp-tl-step-1 12s linear infinite; }
  .mp-step-pill--2 .mp-step-progress { animation: mp-tl-step-2 12s linear infinite; }
  .mp-step-pill--3 .mp-step-progress { animation: mp-tl-step-3 12s linear infinite; }
  .mp-step-pill--4 .mp-step-progress { animation: mp-tl-step-4 12s linear infinite; }
  .mp-step-pill--5 .mp-step-progress { animation: mp-tl-step-5 12s linear infinite; }

  @keyframes mp-tl-step-1 { 0% { transform: scaleX(0); } 20%, 98% { transform: scaleX(1); } 99%, 100% { transform: scaleX(0); } }
  @keyframes mp-tl-step-2 { 0%, 20% { transform: scaleX(0); } 40%, 98% { transform: scaleX(1); } 99%, 100% { transform: scaleX(0); } }
  @keyframes mp-tl-step-3 { 0%, 40% { transform: scaleX(0); } 60%, 98% { transform: scaleX(1); } 99%, 100% { transform: scaleX(0); } }
  @keyframes mp-tl-step-4 { 0%, 60% { transform: scaleX(0); } 80%, 98% { transform: scaleX(1); } 99%, 100% { transform: scaleX(0); } }
  @keyframes mp-tl-step-5 { 0%, 80% { transform: scaleX(0); } 98% { transform: scaleX(1); } 99%, 100% { transform: scaleX(0); } }

  .mp-tab-sub {
    display: block;
    font-size: 0.64rem;
    font-weight: 600;
    opacity: 0.7;
    margin-top: 1px;
    letter-spacing: 0.02em;
  }

  /* ============================================================
     ANIMACIONES TÉCNICAS SVG ULTRA-PROFESIONALES (PIXON PC)
     ============================================================ */
  .fan {
    transform-box: fill-box;
    transform-origin: center;
    animation: spin 1.1s linear infinite;
  }
  .f-slow { animation-duration: 2.2s; }
  .f-fast { animation-duration: 0.65s; }
  .f-med  { animation-duration: 1.5s; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .rgb { animation: rgbCycle 5s linear infinite; }
  @keyframes rgbCycle { to { filter: hue-rotate(360deg); } }

  .p { transform-box: fill-box; opacity: 0; }

  /* Laptop: polvo entra por abajo, pasa la turbina y sale por las aletas */
  .lp1 { animation: lpDust 3s linear infinite; }
  .lp2 { animation: lpDust 3s 0.5s linear infinite; }
  .lp3 { animation: lpDust 3s 1s linear infinite; }
  .lp4 { animation: lpDust 3s 1.5s linear infinite; }
  .lp5 { animation: lpDust 3s 2s linear infinite; }
  .lp6 { animation: lpDust 3s 2.5s linear infinite; }
  @keyframes lpDust {
    0%   { transform: translate(0, 0); opacity: 0; }
    12%  { opacity: 0.9; }
    42%  { transform: translate(-46px, -34px); opacity: 0.85; }
    68%  { transform: translate(-108px, -30px); opacity: 0.7; }
    100% { transform: translate(-176px, -26px); opacity: 0; }
  }

  /* Aire limpio saliendo de la laptop */
  .la1 { animation: lpAir 1.8s linear infinite; }
  .la2 { animation: lpAir 1.8s 0.6s linear infinite; }
  .la3 { animation: lpAir 1.8s 1.2s linear infinite; }
  @keyframes lpAir {
    0%   { transform: translate(0, 0); opacity: 0; }
    25%  { opacity: 0.85; }
    100% { transform: translate(-56px, -4px); opacity: 0; }
  }

  /* Calor que se disipa sobre el CPU */
  .sh {
    fill: none;
    stroke: #f97316;
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0;
    animation: shimmer 2.6s ease-in-out infinite;
  }
  .sh2 { animation-delay: 0.8s; }
  .sh3 { animation-delay: 1.6s; }
  @keyframes shimmer {
    0%   { transform: translateY(4px); opacity: 0; }
    35%  { opacity: 0.65; }
    100% { transform: translateY(-14px); opacity: 0; }
  }

  /* Barra de temperatura que baja tras el mantenimiento */
  .tfill {
    transform-box: fill-box;
    transform-origin: left center;
    animation: coolDown 5.5s ease-in-out infinite;
  }
  @keyframes coolDown {
    0%, 12%  { transform: scaleX(1); fill: #ef4444; }
    55%, 75% { transform: scaleX(0.42); fill: #22c55e; }
    100%     { transform: scaleX(1); fill: #ef4444; }
  }

  /* Flujo de calor dinámico por el heatpipe */
  .pipeFlow {
    fill: none;
    stroke: #ffd9a0;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: 6 14;
    animation: pipeMove 1.2s linear infinite;
    opacity: 0.9;
  }
  @keyframes pipeMove { to { stroke-dashoffset: -20; } }

  /* PC: aire entrando por el frente y saliendo por radiador y escape */
  .pa1 { animation: pcFlowA 4.2s linear infinite; }
  .pa2 { animation: pcFlowA 4.2s 0.9s linear infinite; }
  .pa3 { animation: pcFlowA 4.2s 1.8s linear infinite; }
  .pa4 { animation: pcFlowA 4.2s 2.7s linear infinite; }
  @keyframes pcFlowA {
    0%   { transform: translate(0, 0); opacity: 0; }
    10%  { opacity: 0.9; }
    45%  { transform: translate(150px, 0); opacity: 0.85; }
    75%  { transform: translate(215px, -14px); opacity: 0.6; }
    100% { transform: translate(258px, -18px); opacity: 0; }
  }

  .pb1 { animation: pcFlowB 4.6s 0.4s linear infinite; }
  .pb2 { animation: pcFlowB 4.6s 1.7s linear infinite; }
  .pb3 { animation: pcFlowB 4.6s 3s linear infinite; }
  @keyframes pcFlowB {
    0%   { transform: translate(0, 0); opacity: 0; }
    10%  { opacity: 0.9; }
    40%  { transform: translate(120px, 0); opacity: 0.85; }
    75%  { transform: translate(170px, -120px); opacity: 0.6; }
    100% { transform: translate(195px, -190px); opacity: 0; }
  }

  /* Bomba AIO CPU con anillo pulsante */
  .pump {
    transform-box: fill-box;
    transform-origin: center;
    animation: pumpPulse 2s ease-in-out infinite;
  }
  @keyframes pumpPulse {
    0%, 100% { transform: scale(1); opacity: 0.85; }
    50%      { transform: scale(1.14); opacity: 1; filter: drop-shadow(0 0 6px #38bdf8); }
  }

  .pulseDot { animation: dotPulse 1.8s ease-in-out infinite; }

  /* Consola: polvo aspirado por abajo, aire limpio por túnel superior */
  .cd1 { animation: csDust 3.6s linear infinite; }
  .cd2 { animation: csDust 3.6s 0.9s linear infinite; }
  .cd3 { animation: csDust 3.6s 1.8s linear infinite; }
  .cd4 { animation: csDust 3.6s 2.7s linear infinite; }
  @keyframes csDust {
    0%   { transform: translate(0, 0); opacity: 0; }
    15%  { opacity: 0.9; }
    60%  { transform: translate(18px, -120px); opacity: 0.75; }
    100% { transform: translate(26px, -195px); opacity: 0; }
  }

  .ca1 { animation: csAir 2.4s linear infinite; }
  .ca2 { animation: csAir 2.4s 0.8s linear infinite; }
  .ca3 { animation: csAir 2.4s 1.6s linear infinite; }
  @keyframes csAir {
    0%   { transform: translate(0, 0); opacity: 0; }
    25%  { opacity: 0.85; }
    100% { transform: translate(0, -52px); opacity: 0; }
  }

  .led { animation: ledPulse 2.6s ease-in-out infinite; }
  @keyframes ledPulse {
    0%, 100% { opacity: 0.5; }
    50%      { opacity: 1; filter: drop-shadow(0 0 8px #38bdf8); }
  }

  .mote { animation: moteFloat 7s ease-in-out infinite; }
  .mote2 { animation-duration: 9s; animation-delay: 2s; }
  .mote3 { animation-duration: 11s; animation-delay: 4s; }
  @keyframes moteFloat {
    0%, 100% { transform: translate(0, 0); opacity: 0.25; }
    50%      { transform: translate(10px, -16px); opacity: 0.65; }
  }

  /* Leyendas dinámicas con indicadores luminosos */
  .legend {
    list-style: none;
    padding: 10px 18px 14px;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    background: rgba(3, 10, 20, 0.92);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.74rem;
    font-weight: 600;
    color: #94a3b8;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
  }
  .dot.air {
    background: #38bdf8;
    box-shadow: 0 0 8px #38bdf8;
    animation: dotPulse 1.6s ease-in-out infinite;
  }
  .dot.dust {
    background: #c9a06b;
    box-shadow: 0 0 6px rgba(201, 160, 107, 0.6);
    animation: dotPulse 1.6s 0.3s ease-in-out infinite;
  }
  .dot.heat {
    background: #f97316;
    box-shadow: 0 0 8px #f97316;
    animation: dotPulse 1.6s 0.6s ease-in-out infinite;
  }
  .dot.temp {
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    animation: dotPulse 1.6s 0.9s ease-in-out infinite;
  }
  @keyframes dotPulse {
    0%, 100% { opacity: 0.45; transform: scale(0.85); }
    50%      { opacity: 1; transform: scale(1.18); }
  }

  /* ============================================================
     ÍNDICE DE CONTENIDO COMPACTO (TABLE OF CONTENTS)
     ============================================================ */
  .mp-toc-bar {
    position: sticky;
    top: 0;
    z-index: 30;
    background: #ffffff;
    border-bottom: 1px solid var(--azul-borde);
    box-shadow: 0 4px 12px rgba(7, 31, 58, 0.04);
  }

  .mp-toc-shell {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
  }

  .mp-toc-title {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 850;
    color: var(--azul-oscuro) !important;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .mp-toc-title .tc-svg {
    width: 15px;
    height: 15px;
    color: var(--azul-medio);
  }

  .mp-toc-scroller {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: thin;
    padding-bottom: 2px;
    scroll-behavior: smooth;
  }

  .mp-toc-link {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--azul-muted) !important;
    text-decoration: none;
    padding: 4px 10px;
    border-radius: 6px;
    background: var(--azul-claro);
    white-space: nowrap;
    transition: background-color 150ms ease, color 150ms ease;
  }
  .mp-toc-link:hover {
    background: #dbeafe;
    color: var(--azul-oscuro) !important;
  }

  /* ============================================================
     SECCIONES GENERALES Y TIPOGRAFÍA EDITORIAL
     ============================================================ */
  .mp-section {
    padding: clamp(48px, 6vw, 76px) 0;
    background: #ffffff;
    scroll-margin-top: 70px;
  }
  .mp-section--alt {
    background: #f8fbfe;
    border-top: 1px solid var(--azul-borde);
    border-bottom: 1px solid var(--azul-borde);
  }

  .mp-section-header {
    max-width: 820px;
    margin-bottom: clamp(28px, 3.5vw, 44px);
  }

  .text-center {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .mp-kicker {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--azul-medio);
    margin-bottom: 8px;
  }
  .mp-kicker--light {
    color: #38bdf8;
  }

  .mp-section h2 {
    font-family: var(--font-heading, system-ui, sans-serif);
    font-size: clamp(1.6rem, 2.8vw, 2.3rem);
    font-weight: 850;
    line-height: 1.18;
    letter-spacing: -0.015em;
    color: var(--azul-oscuro);
    margin: 0 0 14px;
    text-wrap: balance;
  }

  .mp-lead {
    font-size: clamp(0.95rem, 1.15vw, 1.05rem);
    line-height: 1.62;
    color: var(--azul-muted);
    margin: 0;
  }

  .mp-lead--light {
    color: rgba(255, 255, 255, 0.88) !important;
    max-width: 64ch;
    margin: 0 auto 28px;
  }

  /* GRIDS Y TARJETAS */
  .mp-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .mp-cards-grid {
    display: grid;
    gap: 20px;
  }
  .mp-cards-grid--3 {
    grid-template-columns: repeat(3, 1fr);
  }
  .mp-cards-grid--4 {
    grid-template-columns: repeat(4, 1fr);
  }

  .mp-card {
    background: #ffffff;
    border: 1px solid var(--azul-borde);
    border-radius: 12px;
    padding: 24px;
    box-shadow: var(--sombra-suave);
    display: flex;
    flex-direction: column;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }
  .mp-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--sombra-card);
    border-color: #93c5fd;
  }

  .mp-card h3 {
    font-size: 1.14rem;
    font-weight: 850;
    color: var(--azul-oscuro);
    margin: 0 0 10px;
    line-height: 1.3;
  }

  .mp-card p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--azul-muted);
    margin: 0 0 12px;
  }
  .mp-card p:last-child {
    margin-bottom: 0;
  }

  .mp-card__header-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: var(--azul-claro);
    color: var(--azul-medio);
    display: grid;
    place-items: center;
    margin-bottom: 16px;
  }

  .mp-card--highlight {
    background: #f8fbfe;
    border: 2px solid #bfdbfe;
  }

  .mp-feature-card {
    background: #ffffff;
    border: 1px solid var(--azul-borde);
    border-radius: 12px;
    padding: 22px;
    box-shadow: var(--sombra-suave);
  }
