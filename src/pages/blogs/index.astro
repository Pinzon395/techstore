---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Footer from '../../components/Footer.astro';

const articles = [{
  href: '/blogs/pasta-termica-vs-metal-liquido',
  image: '/assets/images/mantenimiento-pastaternima-thermalpads.webp',
  alt: 'Comparativa de pasta térmica y metal líquido para computadoras en Cancún',
  category: 'Mantenimiento térmico',
  title: 'Pasta térmica vs metal líquido: cuál conviene para tu equipo',
  description: 'Comparamos seguridad, compatibilidad, riesgos y rendimiento en PC, laptops gamer, GPU, MacBook y consolas.',
}];
---

<Base
  title="Blogs de reparación y mantenimiento en Cancún | Pixon PC"
  description="Guías técnicas de Pixon PC sobre reparación, mantenimiento, temperatura, rendimiento, laptops, PC y consolas en Cancún."
  canonical="/blogs/"
  image="/assets/images/mantenimiento-pastaternima-thermalpads.webp"
  bodyClass="service-page blogs-page"
>
  <Navbar />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Blogs' }]} />

  <main class="blog-index">
    <header class="blog-index__hero">
      <div class="blog-shell">
        <span>Información técnica de Pixon PC</span>
        <h1>Blogs sobre reparación, mantenimiento y rendimiento</h1>
        <p>Explicaciones directas para entender síntomas, riesgos y opciones antes de reparar una PC, laptop, consola o equipo de trabajo en Cancún.</p>
      </div>
    </header>

    <section class="blog-index__articles" aria-labelledby="guias-title">
      <div class="blog-shell">
        <header class="blog-index__heading">
          <i class="fa-solid fa-book-open" aria-hidden="true"></i>
          <div>
            <h2 id="guias-title">Guías técnicas recientes</h2>
            <p>Contenido elaborado para ayudarte a distinguir cuándo necesitas mantenimiento, diagnóstico o una reparación especializada.</p>
          </div>
        </header>

        <div class="blog-grid">
          {articles.map((article) => (
            <article class="blog-entry">
              <a href={article.href} class="blog-entry__image" aria-label={`Leer ${article.title}`}>
                <img src={article.image} alt={article.alt} width="900" height="620" />
              </a>
              <div class="blog-entry__content">
                <span>{article.category}</span>
                <h2><a href={article.href}>{article.title}</a></h2>
                <p>{article.description}</p>
                <a class="blog-entry__link" href={article.href}>Leer guía <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .blog-index{--ink:#071F3A;--blue:#1479D4;--muted:#294963;color:var(--ink);background:#fff}.blog-shell{width:min(1180px,calc(100% - 32px));margin:0 auto}.blog-index :where(h1,h2,p,a,span){color:var(--ink)}
  .blog-index__hero{padding:clamp(130px,16vw,210px) 0 clamp(72px,9vw,110px);background:#e7f2fa}.blog-index__hero span{color:var(--blue);font-weight:800}.blog-index__hero h1{max-width:900px;margin:12px 0 18px;font-family:var(--font-heading);font-size:clamp(2.6rem,6vw,5.4rem);font-style:italic;font-weight:800;line-height:1.02;text-wrap:balance}.blog-index__hero p{max-width:720px;margin:0;color:var(--muted);font-size:1.08rem;line-height:1.72}
  .blog-index__articles{padding:clamp(68px,9vw,112px) 0}.blog-index__heading{display:grid;grid-template-columns:58px minmax(0,760px);gap:20px;margin-bottom:42px}.blog-index__heading>i{display:grid;width:54px;height:54px;place-items:center;border-radius:8px;color:#fff;background:var(--blue);font-size:1.3rem}.blog-index__heading h2{margin:0 0 8px;font-family:var(--font-heading);font-size:clamp(2rem,4vw,3.2rem);font-style:italic;line-height:1.08}.blog-index__heading p{margin:0;color:var(--muted);line-height:1.7}
  .blog-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:22px}.blog-entry{max-width:760px;overflow:hidden;border-radius:8px;background:#f1f7fb}.blog-entry__image{display:block;overflow:hidden}.blog-entry__image img{display:block;width:100%;aspect-ratio:16/10;object-fit:cover;transition:transform 220ms cubic-bezier(.23,1,.32,1)}.blog-entry__content{padding:24px}.blog-entry__content>span{color:var(--blue);font-size:.78rem;font-weight:800}.blog-entry h2{margin:10px 0;font-family:var(--font-heading);font-size:clamp(1.5rem,2.5vw,2.15rem);font-style:italic;line-height:1.1}.blog-entry h2 a{text-decoration:none}.blog-entry p{margin:0;color:var(--muted);line-height:1.65}.blog-entry__link{display:inline-flex;align-items:center;gap:8px;margin-top:19px;color:var(--blue)!important;font-weight:800;text-decoration:none;transition:transform 160ms cubic-bezier(.23,1,.32,1)}.blog-entry__link:active{transform:scale(.97)}
  @media(hover:hover) and (pointer:fine){.blog-entry:hover .blog-entry__image img{transform:scale(1.025)}.blog-entry__link:hover{transform:translateX(3px)}}
  @media(max-width:640px){.blog-index__heading{grid-template-columns:1fr}.blog-index__hero{padding-top:120px}}
  @media(prefers-reduced-motion:reduce){.blog-entry__image img,.blog-entry__link{transition:none}}
</style>
