---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ServiceTicketSection from '../../components/ServiceTicketSection.astro';
import FaqSection from '../../components/FaqSection.astro';
import CommentsSection from '../../components/CommentsSection.astro';
import ContactSection from '../../components/ContactSection.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/LocalSpriteIcon.astro';

const canonical = '/blogs/desarrollo-software-paginas-web-cancun/';
const whatsappText = encodeURIComponent('Hola Pixon PC, quiero cotizar el desarrollo de un proyecto de software o página web desde cero en Cancún.');

const pillars = [
  {
    icon: 'laptop',
    title: 'Desarrollo web desde cero',
    text: 'Creación de sitios y páginas web con código limpio (HTML5, CSS3, JavaScript/Astro) sin plantillas sobrecargadas ni plugins lentos.',
  },
  {
    icon: 'magnifying-glass-chart',
    title: 'Posicionamiento SEO en Google',
    text: 'Optimización de palabras clave locales para Cancún, arquitectura semántica, velocidad máxima de carga y datos estructurados Schema.org.',
  },
  {
    icon: 'mobile-screen-button',
    title: 'Diseño UI/UX Mobile First',
    text: 'Interfaces adaptadas perfectamente a celulares, con botones de conversión inmediata a WhatsApp, llamadas y formularios directos.',
  },
  {
    icon: 'gear',
    title: 'Sistemas a la medida',
    text: 'Plataformas web, catálogos interactivos, paneles de gestión y herramientas personalizadas según la necesidad de tu negocio.',
  },
];

const compareTable = [
  {
    feature: 'Velocidad de carga',
    template: 'Lenta (3 a 8 segundos por exceso de scripts)',
    custom: 'Ultrarrápida (menos de 1 segundo, 100/100 en Lighthouse)',
  },
  {
    feature: 'Indexación en Google Search',
    template: 'Difícil por código basura e imágenes pesadas',
    custom: 'Optimizada desde el día 1 con SEO local en Cancún',
  },
  {
    feature: 'Seguridad y mantenimiento',
    template: 'Vulnerable a fallas de plugins y hackeos',
    custom: 'Código robusto, seguro y sin dependencias innecesarias',
  },
  {
    feature: 'Diseño y adaptabilidad',
    template: 'Genérico, rígido y parecido a miles de sitios',
    custom: '100% único, personalizado para la marca y el usuario',
  },
];

const process = [
  ['Análisis de palabras clave y negocio', 'Investigamos la intención de búsqueda local en Cancún y definimos la arquitectura del proyecto.'],
  ['Diseño de interfaz UI/UX', 'Estructuramos prototipos enfocados en conversión, jerarquía clara y experiencia fluida en móviles.'],
  ['Programación desde cero', 'Escribimos código limpio, modular y mantenible sin arrastrar basura técnica de plantillas.'],
  ['Optimización para Google Search', 'Configuramos metas, títulos, Schema JSON-LD, sitemap y SEO local con coordenadas en Cancún.'],
  ['Pruebas, despliegue y mantenimiento', 'Validamos velocidad, compatibilidad y responsive antes de publicar tu sitio con soporte continuo.'],
];

const faqs = [
  {
    question: '¿Por qué conviene desarrollar una página web desde cero en lugar de usar plantillas?',
    answer: 'Las plantillas genéricas acumulan cientos de archivos y scripts que no usas, volviendo el sitio lento y difícil de posicionar en Google. El desarrollo desde cero garantiza código ligero, carga instantánea y optimización SEO exacta para tu mercado en Cancún.',
  },
  {
    question: '¿Cómo ayuda el SEO local para posicionar mi negocio en Cancún?',
    answer: 'Optimizamos tu sitio con palabras clave específicas de Cancún (como zonas, servicios y solución de problemas locales), datos estructurados para Google Search y tiempos de respuesta rápidos, permitiendo que clientes en Cancún te encuentren primero.',
  },
  {
    question: '¿Qué tipo de proyectos de software y sitios web desarrollan?',
    answer: 'Desarrollamos páginas corporativas, landing pages de alta conversión, plataformas de servicios, catálogos web, sistemas de gestión interna y aplicaciones web personalizadas.',
  },
  {
    question: '¿Mi sitio web será 100% compatible con teléfonos móviles?',
    answer: 'Sí. Todos nuestros proyectos son diseñados bajo el enfoque Mobile First, asegurando navegación intuitiva, botones táctiles y lectura impecable en cualquier pantalla.',
  },
  {
    question: '¿Cuánto tiempo tarda el desarrollo de un proyecto web desde cero?',
    answer: 'El tiempo varía según la complejidad del proyecto. Una página o landing de alta conversión suele completarse en pocos días, mientras que sistemas o plataformas a la medida toman más tiempo previa definición de requerimientos.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Desarrollo de software y creación de páginas web en Cancún',
    serviceType: 'Ingeniería de Software y Desarrollo Web',
    url: `https://pixon.com.mx${canonical}`,
    description: 'Servicios de ingeniería de software, creación de páginas web desde cero y optimización para Google Search con SEO local en Cancún por Pixon PC.',
    provider: { '@id': 'https://pixon.com.mx/#business' },
    areaServed: [{ '@type': 'City', name: 'Cancún' }, { '@type': 'State', name: 'Quintana Roo' }],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<Base
  title="Desarrollo de Software y Páginas Web desde Cero en Cancún | Pixon PC"
  description="Creación de páginas web, sistemas a la medida e ingeniería de software desde cero en Cancún. Optimización para Google Search, SEO local y código ultrarrápido."
  canonical={canonical}
  image="/assets/images/desarrollo-software-cancun.webp"
  schema={schema}
  bodyClass="service-page software-blog-page"
>
  <Navbar />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Blogs', href: '/blogs' }, { label: 'Desarrollo de software en Cancún' }]} />

  <header class="sw-hero">
    <div class="sw-hero__media" aria-hidden="true">
      <img src="/assets/images/desarrollo-software-cancun.webp" alt="Desarrollo de software y páginas web en Cancún por Pixon PC" width="1200" height="900" loading="eager" decoding="async" />
    </div>
    <div class="sw-hero__shade"></div>
    <div class="sw-shell sw-hero__content">
      <span>Ingeniería de Software & SEO Local</span>
      <h1>Desarrollo de software y creación de páginas web desde cero en Cancún</h1>
      <p>Construimos sitios web, sistemas a la medida y plataformas digitales optimizadas para Google Search, con velocidad máxima y diseño enfocado en convertir visitas en clientes reales.</p>
      <div class="sw-actions">
        <a class="sw-btn" href={`https://wa.me/529986690777?text=${whatsappText}`} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /> Cotizar proyecto por WhatsApp</a>
        <a class="sw-btn sw-btn--ghost" href="#ticket-software"><Icon name="clipboard-list" /> Crear ticket de proyecto</a>
      </div>
      <div class="sw-hero__facts">
        <div>
          <dt>100%</dt>
          <dd>Código limpio desde cero</dd>
        </div>
        <div>
          <dt>SEO</dt>
          <dd>Optimizado para Google Search</dd>
        </div>
        <div>
          <dt>Mobile</dt>
          <dd>Diseño táctil ultrarrápido</dd>
        </div>
      </div>
    </div>
  </header>

  <main class="sw-main">
    <section class="sw-section sw-intro">
      <div class="sw-shell sw-split">
        <div>
          <span class="sw-icon"><Icon name="laptop" /></span>
          <h2>Software a la medida vs plantillas genéricas</h2>
          <h3>Tu presencia digital en Cancún merece más que una plantilla lenta</h3>
          <p>Muchas empresas en Cancún compran sitios web creados en plataformas pesadas que tardan en cargar, no aparecen en Google y fallan en teléfonos móviles. En Pixon PC aplicamos ingeniería de software real para desarrollar proyectos desde cero con código optimizado.</p>
          <h3>Posicionamiento en Google Search con intención local</h3>
          <p>Escribimos cada línea de código pensando en velocidad, accesibilidad y estructura SEO local. Tu página web cargará en milisegundos y estará lista para competir por las búsquedas de tus clientes en Cancún.</p>
        </div>
        <aside class="sw-summary">
          <strong>Ventajas clave de un desarrollo desde cero</strong>
          <ul>
            <li><Icon name="circle-check" /> Velocidad de carga inferior a 1 segundo.</li>
            <li><Icon name="circle-check" /> Estructura semántica para Google Search.</li>
            <li><Icon name="circle-check" /> Adaptación total a la identidad de tu marca.</li>
            <li><Icon name="circle-check" /> Integración con WhatsApp y sistemas directos.</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="sw-section sw-pillars">
      <div class="sw-shell">
        <header class="sw-heading">
          <Icon name="screwdriver-wrench" />
          <div>
            <h2>Servicios de desarrollo de software en Cancún</h2>
            <p>Soluciones digitales estructuradas desde la arquitectura técnica hasta el posicionamiento orgánico en motores de búsqueda.</p>
          </div>
        </header>
        <div class="sw-pillar-grid">
          {pillars.map((item) => (
            <article class="sw-pillar-card">
              <span class="sw-pillar-icon"><Icon name={item.icon} /></span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="sw-section sw-compare-sec">
      <div class="sw-shell">
        <header class="sw-heading">
          <Icon name="shield-halved" />
          <div>
            <h2>Comparativa: Plantilla tradicional vs Desarrollo desde cero</h2>
            <p>Descubre por qué el código hecho a la medida ofrece mejores resultados comerciales y SEO para tu empresa en Cancún.</p>
          </div>
        </header>
        <div class="sw-table-wrapper">
          <table class="sw-compare-table">
            <thead>
              <tr>
                <th>Característica</th>
                <th>Plantilla tradicional</th>
                <th>Desarrollo desde cero (Pixon PC)</th>
              </tr>
            </thead>
            <tbody>
              {compareTable.map((row) => (
                <tr>
                  <strong>{row.feature}</strong>
                  <td class="sw-td-bad">{row.template}</td>
                  <td class="sw-td-good">{row.custom}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="sw-section sw-process">
      <div class="sw-shell">
        <header class="sw-heading">
          <Icon name="gear" />
          <div>
            <h2>Metodología de desarrollo web en Pixon PC</h2>
            <p>Proceso transparente y estructurado para entregar sistemas y sitios web de alto rendimiento.</p>
          </div>
        </header>
        <ol class="sw-process__list">
          {process.map(([title, text], index) => (
            <li>
              <strong>{String(index + 1).padStart(2, '0')}</strong>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="sw-section sw-local">
      <div class="sw-shell sw-local__grid">
        <div>
          <span class="sw-icon"><Icon name="location-dot" /></span>
          <h2>Ingeniería de software y desarrollo web en Cancún</h2>
          <h3>Atención para negocios, profesionales y empresas locales</h3>
          <p>Desarrollamos soluciones digitales para proyectos en Cancún Centro, Zona Hotelera, Huayacán, Cumbres, Bonfil, Polígono Sur, Puerto Cancún, Av. Tulum, Bonampak, Puerto Juárez, Supermanzanas y Haciendas.</p>
          <h3>Impulsa tu presencia digital con código profesional</h3>
          <p>No dejes la imagen de tu negocio en manos de soluciones lentas o genéricas. Hablemos sobre los objetivos de tu proyecto y creemos una solución a la medida.</p>
        </div>
        <address>
          <strong>Pixon PC</strong>
          <span>Cto. Hacienda Chimay, 77539 Cancún, Q.R.</span>
          <a href="tel:+529986690777">+52 998 669 0777</a>
          <a href="mailto:pixonpc@gmail.com">pixonpc@gmail.com</a>
        </address>
      </div>
    </section>

    <ServiceTicketSection
      id="ticket-software"
      defaultDevice="Proyecto Web / Software a la medida"
      defaultService="Desarrollo de software y creación de página web en Cancún"
      title="Crear ticket para cotización de proyecto web"
      subtitle="Envíanos los detalles de tu idea, tipo de sitio, funciones necesarias o requisitos para asesorarte y enviarte una propuesta formal."
    />

    <FaqSection
      id="faq-software-cancun"
      title="Preguntas frecuentes sobre desarrollo web y SEO en Cancún"
      description="Respuestas directas sobre ventajas del código desde cero, tiempos de entrega, posicionamiento en Google Search y mantenimiento."
      items={faqs}
      viewMoreHref="/preguntas-frecuentes"
      viewMoreLabel="Ver más preguntas frecuentes"
      ariaLabel="Preguntas frecuentes sobre desarrollo de software y SEO en Cancún"
      backgroundColor="#f0f7fd"
      titleColor="#071F3A"
      descriptionColor="#294963"
      questionColor="#071F3A"
    />

    <section class="sw-final">
      <div class="sw-shell sw-final__grid">
        <div>
          <span>Lleva tu negocio al siguiente nivel digital</span>
          <h2>Cotiza tu sitio web o sistema desde cero con Pixon PC</h2>
          <p>Cuéntanos qué necesitas y diseñamos una solución rápida, segura y posicionada en Google Search para Cancún.</p>
          <div class="sw-actions">
            <a class="sw-btn" href={`https://wa.me/529986690777?text=${whatsappText}`} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /> Contactar por WhatsApp</a>
            <a class="sw-btn sw-btn--ghost-dark" href="#ticket-software"><Icon name="clipboard-list" /> Crear ticket de desarrollo</a>
          </div>
        </div>
        <figure>
          <img src="/assets/images/desarrollo-software-cancun.webp" alt="Ingeniería de software y desarrollo web en Cancún" width="1200" height="900" loading="lazy" decoding="async" />
        </figure>
      </div>
    </section>

    <CommentsSection viewMoreHref="/comentarios" />
    <ContactSection />
  </main>
  <Footer />
</Base>

<style is:global>
  .software-blog-page :where(.sw-main,.sw-section,.sw-final){--ink:#071F3A;--muted:#294963;--blue:#1479D4;--green:#0f9f6e;--ice:#eef6fc;--line:#cbdce8;color:var(--ink)}
  .software-blog-page .sw-shell{width:min(1180px,calc(100% - 32px));margin:0 auto}
  .software-blog-page .sw-main :where(h2,h3,p,li,span,strong,a,dt,dd,address,th,td){color:var(--ink)}
  .software-blog-page .tc-svg{display:block;width:18px;height:18px;fill:currentColor;flex:0 0 auto}
  
  .sw-hero{position:relative;min-height:clamp(540px,62vh,680px);display:grid;align-items:end;overflow:hidden;background:#071F3A}
  .sw-hero__media{position:absolute;inset:0}
  .sw-hero__media img{width:100%;height:100%;object-fit:cover;object-position:center}
  .sw-hero__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,15,29,.97),rgba(3,15,29,.8) 55%,rgba(3,15,29,.25))}
  .sw-hero__content{position:relative;padding:125px 0 44px}
  .sw-hero span{color:#bce0fb;font-size:.78rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}
  .sw-hero h1{max-width:920px;margin:12px 0 16px;color:#fff!important;font-family:var(--font-heading);font-size:clamp(2.25rem,5.2vw,4.8rem);font-style:italic;font-weight:850;line-height:1.03;text-wrap:balance}
  .sw-hero p{max-width:680px;margin:0;color:rgba(255,255,255,.88)!important;font-size:clamp(1rem,1.5vw,1.12rem);font-weight:600;line-height:1.68}
  
  .sw-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
  .sw-btn{display:inline-flex;min-height:48px;align-items:center;justify-content:center;gap:9px;padding:12px 18px;border:1px solid var(--blue);border-radius:8px;background:var(--blue);color:#fff!important;font-weight:850;text-decoration:none;transition:transform 160ms cubic-bezier(.2,0,.2,1),background-color 160ms ease}
  .sw-btn--ghost{border-color:rgba(255,255,255,.52);background:rgba(7,31,58,.62)}
  .sw-btn--ghost-dark{border-color:var(--ink);background:transparent;color:var(--ink)!important}
  .sw-btn:active{transform:scale(.97)}
  
  .sw-hero__facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));max-width:760px;margin:32px 0 0;border-top:1px solid rgba(255,255,255,.24)}
  .sw-hero__facts div{padding:14px 18px 0 0}
  .sw-hero__facts dt{color:#bce0fb!important;font-size:clamp(1.4rem,2.8vw,2.1rem);font-weight:850;line-height:1}
  .sw-hero__facts dd{margin:4px 0 0;color:#fff!important;font-weight:700;font-size:.88rem}
  
  .sw-section{padding:clamp(40px,5vw,64px) 0;background:#fff}
  .sw-split,.sw-local__grid,.sw-final__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.86fr);gap:clamp(24px,5vw,56px);align-items:center}
  .sw-section h2,.sw-final h2{margin:0 0 14px;font-family:var(--font-heading);font-size:clamp(1.9rem,3.6vw,3.1rem);font-style:italic;font-weight:850;line-height:1.06;text-wrap:balance}
  .sw-section h3{margin:18px 0 8px;font-size:1.08rem;line-height:1.28;text-wrap:balance}
  .sw-section p,.sw-summary li,.sw-heading p,.sw-final p{max-width:72ch;margin:0;color:var(--muted);font-weight:560;line-height:1.72}
  
  .sw-icon{display:grid;width:44px;height:44px;margin-bottom:14px;place-items:center;border-radius:8px;background:#dff2fb;color:var(--blue)}
  .sw-summary{padding:24px;border:1px solid #acd3e8;border-radius:10px;background:#f8fcff}
  .sw-summary strong{display:block;margin-bottom:12px;font-size:1.1rem;color:var(--ink)}
  .sw-summary ul{display:grid;gap:10px;margin:0;padding:0;list-style:none}
  .sw-summary li{display:flex;align-items:center;gap:10px;font-weight:750;color:var(--ink)}
  .sw-summary .tc-svg{color:var(--green)}
  
  .sw-pillars,.sw-process{background:var(--ice)}
  .sw-heading{display:grid;grid-template-columns:44px minmax(0,820px);gap:16px;align-items:start;margin-bottom:26px}
  .sw-heading>.tc-svg{box-sizing:border-box;width:44px;height:44px;padding:12px;border-radius:8px;background:var(--blue);color:#fff}
  
  .sw-pillar-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  .sw-pillar-card{display:flex;flex-direction:column;padding:20px;border:1px solid var(--line);border-radius:12px;background:#fff;transition:transform 220ms cubic-bezier(.2,0,.2,1),box-shadow 220ms ease,border-color 220ms ease}
  .sw-pillar-card:hover{transform:translateY(-4px);box-shadow:0 12px 28px -6px rgba(7,31,58,.09);border-color:#b5d2e6}
  .sw-pillar-icon{display:grid;width:40px;height:40px;margin-bottom:14px;place-items:center;border-radius:8px;background:#dff2fb;color:var(--blue)}
  .sw-pillar-card h3{margin:0 0 6px;font-size:1.08rem;font-weight:850;color:var(--ink)}
  .sw-pillar-card p{margin:0;font-size:.9rem;line-height:1.55;color:var(--muted)}
  
  .sw-table-wrapper{overflow-x:auto;border:1px solid var(--line);border-radius:12px;background:#fff}
  .sw-compare-table{width:100%;border-collapse:collapse;text-align:left}
  .sw-compare-table th,.sw-compare-table td{padding:14px 18px;border-bottom:1px solid var(--line);font-size:.92rem}
  .sw-compare-table th{background:#eaf4fb;font-weight:850;color:var(--ink)}
  .sw-compare-table tr:last-child td{border-bottom:none}
  .sw-td-bad{color:#a82c2c!important;font-weight:600}
  .sw-td-good{color:#087f56!important;font-weight:750}
  
  .sw-process__list{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;margin:0;padding:0;background:var(--line);list-style:none;border-radius:12px;overflow:hidden}
  .sw-process__list li{display:grid;min-height:190px;align-content:start;gap:16px;padding:20px;background:#fff}
  .sw-process__list strong{font-size:1.55rem;color:var(--blue)!important}
  .sw-process__list h3{margin-top:0}
  
  .sw-local{background:#fff}
  .sw-local address{display:grid;gap:12px;padding:24px;border-radius:10px;background:#e7f4fb;font-style:normal}
  .sw-local address a{color:var(--blue)!important;text-decoration:none;font-weight:800}
  
  .sw-final{padding:clamp(44px,5.5vw,72px) 0;background:#dcecf7}
  .sw-final>div>div>span{color:var(--blue)!important;font-weight:850;text-transform:uppercase;font-size:.78rem;letter-spacing:.08em}
  .sw-final figure{margin:0;overflow:hidden;border-radius:12px;background:#d6e8f2}
  .sw-final img{display:block;width:100%;aspect-ratio:16/10;max-height:240px;object-fit:cover;object-position:center}
  
  @media(hover:hover) and (pointer:fine){.sw-btn:hover{transform:translateY(-2px);background:#0e68b8}.sw-btn--ghost-dark:hover{background:var(--ink);color:#fff!important}}
  @media(max-width:980px){.sw-pillar-grid{grid-template-columns:repeat(2,1fr)}.sw-process__list{grid-template-columns:repeat(2,1fr)}.sw-split,.sw-local__grid,.sw-final__grid{grid-template-columns:1fr;gap:28px}}
  @media(max-width:640px){.sw-hero{min-height:620px}.sw-hero__content{padding-top:120px}.sw-hero__facts,.sw-pillar-grid,.sw-process__list{grid-template-columns:1fr}.sw-heading{grid-template-columns:40px 1fr;gap:12px}.sw-actions,.sw-actions .sw-btn{width:100%}.software-blog-page .sw-section{padding:36px 0}.sw-process__list li{min-height:auto}}
  @media(prefers-reduced-motion:reduce){.sw-btn{transition:none}}
</style>
