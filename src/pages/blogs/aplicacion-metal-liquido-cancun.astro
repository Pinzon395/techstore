    object-fit: cover;
    object-position: 50% 45%;
    display: block;
  }

  /* En móvil: CERO tarjetas superpuestas que tapen la foto real */
  @media (max-width: 999px) {
    .lm-stage-badges {
      display: none !important;
    }
    .lm-visual-media {
      aspect-ratio: 16 / 10;
      min-height: 220px;
      max-height: 290px;
    }
  }

  /* En desktop (>= 1000px): Badges laterales elegantes que no tapan el centro de aplicación */
  @media (min-width: 1000px) {
    .lm-stage-badges {
      position: absolute;
      inset: 10px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      align-content: end;
      pointer-events: none;
    }

    .lm-stage-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 10px;
      border-radius: 7px;
      background: rgba(7, 31, 58, 0.88);
      border: 1px solid rgba(56, 189, 248, 0.35);
      backdrop-filter: blur(8px);
    }
    .lm-stage-badge i {
      color: #38bdf8;
      font-size: 0.9rem;
    }
    .lm-stage-badge div {
      display: flex;
      flex-direction: column;
      gap: 1px;
    }
    .lm-stage-badge strong {
      color: #ffffff !important;
      font-size: 0.7rem;
      font-family: 'Kanit', sans-serif;
      line-height: 1.15;
    }
    .lm-stage-badge span {
      color: #bae6fd !important;
      font-size: 0.62rem;
      line-height: 1.1;
    }
  }

  .lm-visual-caption {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.74rem;
    color: #94a3b8 !important;
  }
  .lm-caption-step {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #e2e8f0 !important;
    font-weight: 700;
  }
  .lm-step-num {
    display: inline-grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #0284c7;
    color: #ffffff !important;
    font-size: 0.65rem;
  }
  .lm-caption-sep {
    color: #64748b !important;
    font-weight: 800;
  }

  /* Desktop 2-column layout (52% copy / 48% visual) */
  @media (min-width: 1000px) {
    .lm-hero {
      padding: clamp(42px, 5vw, 64px) 0;
      min-height: auto;
      display: grid;
      align-items: center;
    }
    .lm-hero__grid {
      grid-template-areas:
        "eyebrow media"
        "title   media"
        "summary media"
        "actions media"
        "trust   media";
      grid-template-columns: 1.1fr 0.9fr;
      column-gap: clamp(36px, 4.5vw, 56px);
      row-gap: 14px;
    }
  }

  /* ============================================================
     SECCIONES: RITMO VERTICAL COMPACTO (~20px A 36px)
  ============================================================ */
  .lm-section {
    padding: clamp(24px, 3.5vw, 40px) 0;
    border-bottom: 1px solid var(--border-subtle);
    transition: var(--theme-transition);
  }
  .lm-section--soft {
    background: var(--surface-alt);
  }

  .lm-heading {
    max-width: 820px;
    margin-bottom: 22px;
  }
  .lm-heading--center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .lm-kicker {
    display: inline-block;
    color: var(--accent) !important;
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .lm-section h2 {
    margin: 0 0 10px;
    font-family: 'Kanit', sans-serif;
    font-size: clamp(1.75rem, 2.8vw, 2.45rem);
    line-height: 1.14;
    color: var(--heading);
    text-wrap: balance;
  }

  .lm-heading p {
    margin: 0;
    font-size: 0.96rem;
    line-height: 1.62;
    color: var(--text-secondary) !important;
  }

  /* ============================================================
     1. EDITORIAL SPLIT
  ============================================================ */
  .lm-editorial-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: start;
  }
  @media (min-width: 960px) {
    .lm-editorial-split {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 44px;
    }
  }

  .lm-editorial-copy p {
    font-size: 0.95rem;
    line-height: 1.68;
    margin: 0 0 14px;
  }

  .lm-highlight-box {
    background: var(--accent-light, #f0f9ff);
    border-left: 4px solid var(--accent, #0284c7);
    border-radius: 0 8px 8px 0;
    padding: 16px 20px;
    margin-top: 18px;
  }
  .lm-highlight-box h4 {
    margin: 0 0 6px;
    font-family: 'Kanit', sans-serif;
    font-size: 1.05rem;
    color: var(--accent, #0369a1) !important;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .lm-highlight-box p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary) !important;
  }

  .lm-spec-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 22px;
    box-shadow: var(--px-shadow-sm);
  }
  .lm-spec-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 14px;
  }
  .lm-spec-head i {
    font-size: 1.35rem;
    color: var(--accent);
  }
  .lm-spec-head h3 {
    margin: 0;
    font-family: 'Kanit', sans-serif;
    font-size: 1.18rem;
    color: var(--heading);
  }
  .lm-spec-list {
    list-style: none;
    padding: 0;
    margin: 0 0 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .lm-spec-list li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.86rem;
  }
  .lm-spec-list strong {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted) !important;
  }
  .lm-spec-list span {
    font-weight: 700;
    color: var(--text-primary);
  }
  .lm-spec-footer {
    padding-top: 12px;
    border-top: 1px solid var(--border-subtle);
  }
  .lm-spec-footer p {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-secondary) !important;
  }

  /* ============================================================
     2. CARDS GRID & WARNING CALLOUT
  ============================================================ */
  .lm-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    margin-bottom: 24px;
  }
  @media (min-width: 768px) {
    .lm-cards-grid--3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .lm-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .lm-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--px-shadow-sm);
    border-color: var(--accent);
  }
  .lm-card-icon i {
    font-size: 1.45rem;
    color: var(--accent);
  }
  .lm-card h3 {
    margin: 0;
    font-family: 'Kanit', sans-serif;
    font-size: 1.15rem;
    line-height: 1.25;
    color: var(--heading);
  }
  .lm-card p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.58;
    color: var(--text-secondary) !important;
  }

  .lm-callout-warning {
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-left: 4px solid #f59e0b;
    border-radius: 10px;
    padding: 18px 22px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .lm-cw-icon i {
    font-size: 1.6rem;
    color: #d97706;
  }
  .lm-cw-text h3 {
    margin: 0 0 6px;
    font-family: 'Kanit', sans-serif;
    font-size: 1.15rem;
    color: #92400e !important;
  }
  .lm-cw-text p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #78350f !important;
  }
  .lm-cw-text a {
    color: var(--accent) !important;
    font-weight: 800;
    text-decoration: underline;
  }

  /* ============================================================
     3. FACTORY VS CONVERSION (2 COLUMNAS)
  ============================================================ */
  .lm-factory-vs-conversion {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  @media (min-width: 860px) {
    .lm-factory-vs-conversion {
      grid-template-columns: 1fr 1fr;
    }
  }

  .lm-fvc-col {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .lm-fvc-col--factory { border-top: 4px solid #16a34a; }
  .lm-fvc-col--conversion { border-top: 4px solid #f59e0b; }

  .lm-fvc-head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .lm-fvc-tag {
    align-self: flex-start;
    padding: 3px 7px;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: #dcfce7;
    color: #166534 !important;
  }
  .lm-fvc-tag--caution {
    background: #fef3c7;
    color: #92400e !important;
  }
  .lm-fvc-head h3 {
    margin: 0;
    font-family: 'Kanit', sans-serif;
    font-size: 1.22rem;
    color: var(--heading);
  }
  .lm-fvc-sub {
    margin: 0;
    font-size: 0.82rem;
    color: var(--text-muted) !important;
  }

  .lm-fvc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .lm-fvc-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .lm-fvc-list li i {
    margin-top: 3px;
    font-size: 0.95rem;
    flex-shrink: 0;
  }
  .lm-fvc-col--factory li i { color: #16a34a; }
  .lm-fvc-col--conversion li i { color: #f59e0b; }
  .lm-fvc-list div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .lm-fvc-list strong {
    font-size: 0.9rem;
    color: var(--heading);
  }
  .lm-fvc-list span {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--text-secondary) !important;
  }

  /* ============================================================
     4. COMPATIBILIDAD DE MATERIALES (GRID)
  ============================================================ */
  .lm-materials-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 22px;
  }
  @media (min-width: 860px) {
    .lm-materials-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .lm-mat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .lm-mat-card.status-optimal { border-top: 4px solid #16a34a; }
  .lm-mat-card.status-caution { border-top: 4px solid #f59e0b; }
  .lm-mat-card.status-prohibited { border-top: 4px solid #dc2626; }

  .lm-mat-pill {
    display: inline-block;
    padding: 3px 7px;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 4px;
  }
  .status-optimal .lm-mat-pill { background: #dcfce7; color: #166534 !important; }
  .status-caution .lm-mat-pill { background: #fef3c7; color: #92400e !important; }
  .status-prohibited .lm-mat-pill { background: #fee2e2; color: #991b1b !important; }

  .lm-mat-card h3 {
    margin: 0;
    font-family: 'Kanit', sans-serif;
    font-size: 1.15rem;
    line-height: 1.25;
    color: var(--heading);
  }
  .lm-mat-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.86rem;
    line-height: 1.55;
  }
  .lm-mat-body strong {
    color: var(--heading) !important;
  }
  .lm-mat-body p {
    margin: 0;
    color: var(--text-secondary);
  }

  .lm-aluminum-alert {
    background: #fef2f2;
    border: 1.5px solid #fecaca;
    border-radius: 10px;
    padding: 20px 24px;
  }
  .lm-aa-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #dc2626;
    color: #ffffff !important;
    padding: 3px 8px;
    border-radius: 5px;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }
  .lm-aluminum-alert h3 {
    margin: 0 0 6px;
    font-family: 'Kanit', sans-serif;
    font-size: 1.2rem;
    color: #991b1b !important;
  }
  .lm-aluminum-alert p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.62;
    color: #7f1d1d !important;
  }

  /* ============================================================
     5. AISLAMIENTO ELÉCTRICO SPLIT
  ============================================================ */
  .lm-isolation-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: start;
  }
  @media (min-width: 960px) {
    .lm-isolation-split {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 44px;
    }
  }

  .lm-iso-copy p {
    font-size: 0.95rem;
    line-height: 1.68;
    margin: 0 0 14px;
  }

  .lm-iso-steps {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 18px;
  }
  .lm-iso-step {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 14px 16px;
  }
  .lm-iso-num {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--accent);
    color: #ffffff !important;
    font-weight: 900;
    font-size: 0.8rem;
    flex-shrink: 0;
  }
  .lm-iso-step strong {
    font-size: 0.92rem;
    margin-bottom: 2px;
    display: block;
    color: var(--heading);
  }
  .lm-iso-step p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-secondary) !important;
  }

  .lm-diy-warning-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
    box-shadow: var(--px-shadow-sm);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .lm-diy-warning-card i {
    font-size: 2.2rem;
    color: #f59e0b;
  }
  .lm-diy-warning-card h3 {
    margin: 0;
    font-family: 'Kanit', sans-serif;
    font-size: 1.2rem;
    color: var(--heading);
  }
  .lm-diy-warning-card p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-secondary) !important;
  }
  .lm-diy-warning-card a {
    color: var(--accent) !important;
    font-weight: 700;
    text-decoration: underline;
  }
  .lm-diy-footer {
    margin-top: 8px;
    padding-top: 10px;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent) !important;
  }

  /* ============================================================
     6. EVALUATION FLOW (6 PASOS)
  ============================================================ */
  .lm-eval-flow {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
  .lm-eval-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .lm-eval-idx {
    font-family: 'Kanit', sans-serif;
    font-size: 1.3rem;
    font-weight: 900;
    color: var(--accent) !important;
  }
  .lm-eval-card h4 {
    margin: 0;
    font-family: 'Kanit', sans-serif;
    font-size: 1.08rem;
    color: var(--heading);
  }
  .lm-eval-card p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-secondary) !important;
  }
  .lm-eval-card--action {
    background: var(--accent-light);
    border-color: var(--accent);
  }
  .lm-eval-card--action a {
    color: var(--accent) !important;
    font-weight: 800;
    text-decoration: underline;
  }

  /* ============================================================
     7. TIMELINE TÉCNICA (6 FASES)
  ============================================================ */
  .lm-timeline {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 768px) {
    .lm-timeline {
      grid-template-columns: 1fr 1fr;
    }
  }

  .lm-timeline-item {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 20px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .lm-timeline-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }
  .lm-tb-num {
    font-family: 'Kanit', sans-serif;
    font-size: 1.05rem;
    font-weight: 900;
    color: var(--accent) !important;
  }
  .lm-timeline-badge i {
    font-size: 1.15rem;
    color: var(--accent);
  }
  .lm-timeline-content h3 {
    margin: 0 0 4px;
    font-family: 'Kanit', sans-serif;
    font-size: 1.12rem;
    color: var(--heading);
  }
  .lm-timeline-content p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--text-secondary) !important;
  }

  /* ============================================================
     8. LAPTOP GAMER SPLIT
  ============================================================ */
  .lm-split-feature {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .lm-split-feature {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 44px;
    }
  }

  .lm-sf-copy p {
    font-size: 0.95rem;
    line-height: 1.68;
    margin: 0 0 14px;
  }

  .lm-sf-bullets {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 16px;
  }
  .lm-sfb-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .lm-sfb-item i {
    color: var(--accent);
    font-size: 1.05rem;
    margin-top: 3px;
    flex-shrink: 0;
  }
  .lm-sfb-item div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .lm-sfb-item strong {
    font-size: 0.9rem;
    color: var(--heading);
  }
  .lm-sfb-item p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-secondary) !important;
  }
  .lm-sfb-item a {
    color: var(--accent) !important;
    text-decoration: underline;
    font-weight: 700;
  }

  .lm-sf-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
    box-shadow: var(--px-shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .lm-sfc-icon i {
    font-size: 2rem;
    color: var(--accent);
  }
  .lm-sf-card h3 {
    margin: 0;
    font-family: 'Kanit', sans-serif;
    font-size: 1.25rem;
    color: var(--heading);
  }
  .lm-sf-card p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-secondary) !important;
  }
  .lm-sfc-disclaimer {
    background: var(--surface-soft);
    border-left: 3px solid var(--accent);
    padding: 8px 12px;
    border-radius: 0 6px 6px 0;
    font-size: 0.8rem;
    color: var(--text-secondary) !important;
    line-height: 1.45;
  }

  /* ============================================================
     10. TABLA COMPARATIVA
  ============================================================ */
  .lm-table-wrap {
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: var(--px-shadow-sm);
  }
  .lm-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 700px;
  }
  .lm-table th {
