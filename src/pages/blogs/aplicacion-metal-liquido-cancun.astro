---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ServiceTicketSection from '../../components/ServiceTicketSection.astro';
import FaqSection from '../../components/FaqSection.astro';
import CommentsSection from '../../components/CommentsSection.astro';
import ContactSection from '../../components/ContactSection.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/LocalSpriteIcon.astro';

const canonical = '/blogs/aplicacion-metal-liquido-cancun';
const whatsappText = encodeURIComponent('Hola Pixon PC, quiero revisar si mi laptop gamer o PC es compatible con metal liquido y necesito diagnostico termico.');

const faqs = [
  {
    question: '¿El metal líquido es mejor que la pasta térmica?',
    answer: 'Puede transferir más calor en equipos compatibles, pero no siempre es la mejor opción. Primero se revisan materiales, disipador, presión, aislamiento, ventilación y causa real de la temperatura.',
  },
  {
    question: '¿Cuánto baja la temperatura con metal líquido?',
    answer: 'En algunos equipos compatibles se han visto mejoras importantes, incluso de 15°C a 30°C, pero no es una promesa universal. El resultado depende del modelo, estado del disipador, ventiladores, pads, consumo y ambiente de uso.',
  },
  {
    question: '¿El metal líquido puede dañar mi laptop?',
    answer: 'Sí, si se aplica sin control, si toca componentes, si se usa sobre aluminio o si no hay contención. Por eso en Pixon PC solo se recomienda después de diagnóstico, aislamiento y prueba final.',
  },
  {
    question: '¿Conviene para cualquier laptop gamer?',
    answer: 'No. Algunas laptops gamer funcionan mejor con pasta térmica premium y limpieza profunda. El metal líquido se considera cuando el diseño, el disipador y las mediciones justifican el riesgo.',
  },
  {
    question: '¿También aplican metal líquido en PC de escritorio?',
    answer: 'Sí, revisamos PC gamer y estaciones de trabajo en Cancún. Antes de aplicar confirmamos bloque o disipador compatible, presión, consumo, airflow del gabinete y temperaturas bajo carga.',
  },
  {
    question: '¿Puedo crear ticket para cotizar este servicio?',
    answer: 'Sí. En el ticket puedes indicar modelo, procesador, GPU, temperaturas, apagados, ruido, FPS y trabajos previos. Con eso damos el siguiente paso y confirmamos si requiere diagnóstico en taller.',
  },
];

const process = [
  ['01', 'Diagnóstico térmico', 'Medimos temperatura, frecuencia, consumo, ruido y estabilidad en reposo y carga.'],
  ['02', 'Compatibilidad', 'Confirmamos cobre o níquel, diseño del disipador, presión y zonas sensibles.'],
  ['03', 'Aislamiento', 'Protegemos componentes cercanos antes de trabajar con un material conductor.'],
  ['04', 'Aplicación controlada', 'Usamos cantidad mínima necesaria y distribución uniforme sobre el die o IHS.'],
  ['05', 'Prueba final', 'Validamos temperatura, throttling, ventiladores y comportamiento sostenido.'],
];

const signals = [
  ['temperature-high', 'CPU o GPU al límite', 'Temperaturas altas bajo carga, ventiladores constantes o picos que se repiten.'],
  ['gauge-high', 'Thermal throttling', 'Frecuencias que bajan al jugar, renderizar o trabajar con cargas pesadas.'],
  ['fan', 'Ruido excesivo', 'Ventiladores al máximo aunque el equipo esté limpio o recién encendido.'],
  ['bolt', 'Apagados por protección', 'El equipo se apaga o reinicia cuando sube el consumo térmico.'],
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Aplicación de metal líquido en Cancún para laptop gamer y PC',
    serviceType: 'Diagnóstico térmico y aplicación controlada de metal líquido',
    url: `https://pixon.com.mx${canonical}`,
    description: 'Aplicación controlada de metal líquido en Cancún para laptops gamer y PC de alto rendimiento con diagnóstico, aislamiento y prueba final.',
    provider: { '@id': 'https://pixon.com.mx/#business' },
    areaServed: [{ '@type': 'City', name: 'Cancún' }, { '@type': 'State', name: 'Quintana Roo' }],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<Base
  title="Aplicación de metal líquido en Cancún | Laptop gamer y PC | Pixon PC"
  description="Aplicación controlada de metal líquido en Cancún para laptops gamer y PC de alto rendimiento. Diagnóstico térmico, aislamiento y pruebas antes de intervenir."
  canonical={canonical}
  image="/assets/images/mantenimiento-metal-liquido-cancun.webp"
  schema={schema}
  bodyClass="service-page liquid-metal-page"
>
  <Navbar />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Blogs', href: '/blogs' }, { label: 'Aplicación de metal líquido en Cancún' }]} />

  <header class="lm-hero">
    <img src="/assets/images/responsive/mantenimiento-metal-liquido-cancun.webp" alt="Aplicación de metal líquido en CPU de laptop gamer en Cancún por Pixon PC para reducir temperatura" width="3024" height="3024" loading="eager" decoding="async" />
    <div class="lm-hero__shade"></div>
    <div class="lm-shell lm-hero__content">
      <span>Servicio premium en Cancún</span>
      <h1>Aplicación de metal líquido en Cancún para laptops gamer y PC de alto rendimiento</h1>
      <p>Una intervención térmica avanzada para equipos compatibles. Diagnosticamos, aislamos y probamos antes de recomendarla.</p>
      <div class="lm-actions">
        <a class="lm-btn" href={`https://wa.me/529986690777?text=${whatsappText}`} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /> Solicitar servicio</a>
        <a class="lm-btn lm-btn--ghost" href="#ticket-metal-liquido"><Icon name="clipboard-list" /> Crear ticket</a>
      </div>
      <dl class="lm-facts">
        <div><dt>Enfoque</dt><dd>CPU, GPU y laptops gamer</dd></div>
        <div><dt>Decisión</dt><dd>Solo con diagnóstico</dd></div>
        <div><dt>Zona</dt><dd>Cancún, Quintana Roo</dd></div>
      </dl>
    </div>
  </header>

  <main class="lm-main">
    <section class="lm-section lm-intro">
      <div class="lm-shell lm-split">
        <div class="lm-copy">
          <span class="lm-icon"><Icon name="flask" /></span>
          <h2>Metal líquido: más transferencia térmica, más responsabilidad técnica</h2>
          <h3>No es una pasta térmica común</h3>
          <p>El metal líquido puede conducir mucho más calor que muchas pastas térmicas tradicionales, pero también conduce electricidad. Por eso no debe aplicarse por moda, por un video o por una temperatura aislada.</p>
          <h3>Ideal para equipos que ya demostraron límite térmico</h3>
          <p>En Pixon PC revisamos laptops gamer y PC de alto rendimiento cuando hay apagados, pérdida de frecuencia, thermal throttling o temperaturas sostenidas. Si el equipo no es compatible, proponemos una alternativa más segura.</p>
        </div>
        <aside class="lm-panel">
          <strong>Lectura técnica rápida</strong>
          <p>La mejora puede ser alta en sistemas compatibles, pero depende de disipador, presión, ventilación, consumo y estado interno.</p>
          <ul>
            <li><Icon name="circle-check" /> Diagnóstico antes de aplicar</li>
            <li><Icon name="circle-check" /> Aislamiento de componentes cercanos</li>
            <li><Icon name="circle-check" /> Pruebas térmicas al finalizar</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="lm-section lm-symptoms">
      <div class="lm-shell">
        <header class="lm-heading">
          <Icon name="temperature-high" />
          <div>
            <h2>Cuándo puede tener sentido aplicar metal líquido</h2>
            <p>Primero buscamos evidencia. La meta no es vender el material más extremo, sino resolver el límite térmico real.</p>
          </div>
        </header>
        <div class="lm-signal-grid">
          {signals.map(([icon, title, text]) => (
            <article>
              <Icon name={icon} />
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="lm-section lm-proof">
      <div class="lm-shell lm-proof__grid">
        <figure>
          <img src="/assets/images/laptop-gamer-rogstrix.webp" alt="Laptop gamer con diagnóstico térmico en Cancún antes de aplicar metal líquido" width="1200" height="900" loading="lazy" />
        </figure>
        <div class="lm-copy">
          <span class="lm-icon lm-icon--dark"><Icon name="temperature-high" /></span>
          <h2>Reducción de temperatura sin prometer resultados sin diagnóstico</h2>
          <h3>Mejoras posibles en casos compatibles</h3>
          <p>En equipos adecuados, una aplicación correcta puede ayudar a reducir entre 15°C y 30°C, sostener frecuencia y disminuir thermal throttling. Ese rango no se promete sin medir el equipo.</p>
          <h3>Lo que también revisamos</h3>
          <p>Un mal ventilador, pads incorrectos, presión irregular, polvo o un disipador dañado pueden limitar el resultado aunque se use el mejor material térmico. Por eso la intervención incluye revisión del sistema completo.</p>
        </div>
      </div>
    </section>

    <section class="lm-section lm-warning">
      <div class="lm-shell lm-warning__grid">
        <div>
          <span class="lm-icon lm-icon--dark"><Icon name="triangle-exclamation" /></span>
          <h2>Riesgos que se controlan antes de tocar tu equipo</h2>
          <p>El metal líquido exige aislamiento, cantidad precisa y materiales compatibles. No se usa sobre aluminio y no se recomienda si el diseño no tiene contención adecuada.</p>
        </div>
        <div class="lm-risk-list">
          <article><strong>Material conductor</strong><span>Una fuga puede causar corto si toca componentes o pistas cercanas.</span></article>
          <article><strong>Compatibilidad con disipador</strong><span>Confirmamos cobre o níquel antes de aprobar el servicio.</span></article>
          <article><strong>Mantenimiento delicado</strong><span>El equipo requiere inspección futura y cuidado al mover o abrir.</span></article>
        </div>
      </div>
    </section>

    <section class="lm-section lm-process">
      <div class="lm-shell">
        <header class="lm-heading">
          <Icon name="screwdriver-wrench" />
          <div>
            <h2>Proceso Pixon PC para metal líquido en Cancún</h2>
            <p>El servicio se decide con datos, no con suposiciones. Cada paso reduce riesgo y deja claro qué se hizo.</p>
          </div>
        </header>
        <ol class="lm-process__list">
          {process.map(([step, title, text]) => (
            <li>
              <strong>{step}</strong>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="lm-section lm-local">
      <div class="lm-shell lm-local__grid">
        <div>
          <span class="lm-icon"><Icon name="location-dot" /></span>
          <h2>Servicio técnico local para laptops gamer y PC en Cancún</h2>
          <h3>Atención para equipos de alto rendimiento</h3>
          <p>Atendemos equipos de Cancún Centro, Zona Hotelera, Huayacán, Cumbres, Bonfil, Polígono Sur, Puerto Cancún, Av. Tulum, Bonampak, Puerto Juárez, Supermanzanas y Haciendas.</p>
          <h3>Cuándo elegir ticket o WhatsApp</h3>
          <p>Usa ticket si ya tienes modelo, temperaturas y síntomas. Usa WhatsApp si necesitas explicar el caso rápido antes de traer el equipo.</p>
        </div>
        <address>
          <strong>Pixon PC</strong>
          <span>Cto. Hacienda Chimay, 77539 Cancún, Q.R.</span>
          <a href="tel:+529986690777">+52 998 669 0777</a>
          <a href="mailto:pixonpc@gmail.com">pixonpc@gmail.com</a>
        </address>
      </div>
    </section>

    <ServiceTicketSection
      id="ticket-metal-liquido"
      defaultDevice="Laptop gamer / PC de alto rendimiento"
      defaultService="Diagnóstico térmico y aplicación de metal líquido"
      sourcePage="/blogs/aplicacion-metal-liquido-cancun"
    />

    <FaqSection
      id="faq-metal-liquido"
      title="Preguntas frecuentes sobre metal líquido en Cancún"
      description="Respuestas claras sobre compatibilidad, seguridad, temperatura y diagnóstico antes de aplicar metal líquido."
      items={faqs}
      viewMoreHref="/preguntas-frecuentes"
      viewMoreLabel="Ver más preguntas"
      ariaLabel="Preguntas frecuentes sobre aplicación de metal líquido en Cancún"
      backgroundColor="#eef6fc"
      titleColor="#071F3A"
      descriptionColor="#294963"
      questionColor="#071F3A"
    />

    <section class="lm-final">
      <div class="lm-shell lm-final__grid">
        <div>
          <span>Especialistas en enfriamiento extremo en Cancún</span>
          <h2>Solicita diagnóstico antes de aplicar metal líquido</h2>
          <p>Cuéntanos modelo, temperaturas, apagados y trabajos previos. Si el equipo es compatible, te explicamos alcance, riesgos y cotización antes de intervenir.</p>
          <div class="lm-actions">
            <a class="lm-btn" href={`https://wa.me/529986690777?text=${whatsappText}`} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /> Solicitar servicio</a>
            <a class="lm-btn lm-btn--light" href="/servicios/laptop/pasta-termica"><Icon name="arrow-right" /> Ver servicio térmico</a>
            <a class="lm-btn lm-btn--light" href="#ticket-metal-liquido"><Icon name="clipboard-list" /> Crear ticket</a>
          </div>
        </div>
        <figure>
          <img src="/assets/images/mantenimiento-metal-liquido-cancun.webp" alt="Aplicación controlada de metal líquido por Pixon PC en Cancún" width="1200" height="900" loading="lazy" />
        </figure>
      </div>
    </section>

    <CommentsSection viewMoreHref="/comentarios" />
    <ContactSection />
  </main>
  <Footer />
</Base>

<style is:global>
  .liquid-metal-page :where(.lm-main, .lm-section, .lm-final){--ink:#071F3A;--muted:#294963;--blue:#1479D4;--cyan:#59C7E8;--ice:#eef6fc;--line:#c9dceb;color:var(--ink)}
  .liquid-metal-page .lm-shell{width:min(1180px,calc(100% - (var(--page-gutter) * 2)));margin:0 auto}
  .liquid-metal-page .lm-main :where(h2,h3,p,li,span,strong,a,dt,dd,address){color:var(--ink)}
  .liquid-metal-page .lm-section{padding:clamp(40px,5vw,64px) 0;background:#fff}
  .liquid-metal-page .lm-svg,.liquid-metal-page .tc-svg{display:block;width:18px;height:18px;fill:currentColor;flex:0 0 auto}
  .lm-hero{position:relative;display:grid;min-height:clamp(540px,60vh,660px);align-items:end;overflow:hidden;background:#071F3A}
  .lm-hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .lm-hero__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,15,29,.97),rgba(3,15,29,.78) 52%,rgba(3,15,29,.2))}
  .lm-hero__content{position:relative;padding:120px 0 44px}
  .lm-hero span{color:#AEEBFF;font-weight:850;text-transform:uppercase;font-size:.78rem;letter-spacing:.08em}
  .lm-hero h1{max-width:940px;margin:14px 0 18px;color:#fff;font-family:var(--font-heading);font-size:clamp(2.35rem,5.5vw,5rem);font-style:italic;font-weight:850;line-height:1.02;text-wrap:balance}
  .lm-hero p{max-width:680px;margin:0;color:rgba(255,255,255,.86);font-size:clamp(1rem,1.6vw,1.13rem);font-weight:600;line-height:1.68}
  .lm-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}
  .lm-btn{display:inline-flex;min-height:48px;align-items:center;justify-content:center;gap:9px;padding:12px 18px;border:1px solid var(--blue);border-radius:8px;background:var(--blue);color:#fff!important;font-weight:850;text-decoration:none;transition:transform 160ms cubic-bezier(.23,1,.32,1),background-color 160ms ease,border-color 160ms ease}
  .lm-btn--ghost{border-color:rgba(255,255,255,.48);background:rgba(7,31,58,.62)}
  .lm-btn--light{border-color:#fff;background:#fff;color:var(--ink)!important}
  .lm-btn:active{transform:scale(.97)}
  .lm-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));max-width:780px;margin:32px 0 0;border-top:1px solid rgba(255,255,255,.26)}
  .lm-facts div{padding:14px 18px 0 0}
  .lm-facts dt{color:#AEEBFF;font-size:.76rem;font-weight:850}
  .lm-facts dd{margin:4px 0 0;color:#fff;font-weight:800}
  .lm-split,.lm-proof__grid,.lm-warning__grid,.lm-local__grid,.lm-final__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.86fr);gap:clamp(24px,5vw,56px);align-items:center}
  .lm-copy h2,.lm-heading h2,.lm-local h2,.lm-final h2{margin:0 0 14px;font-family:var(--font-heading);font-size:clamp(1.9rem,3.6vw,3.1rem);font-style:italic;font-weight:850;line-height:1.06;text-wrap:balance}
  .lm-copy h3,.lm-local h3,.lm-process h3,.lm-signal-grid h3{margin:18px 0 8px;font-size:1.08rem;line-height:1.28;text-wrap:balance}
  .lm-copy p,.lm-heading p,.lm-panel p,.lm-risk-list span,.lm-local p,.lm-final p,.lm-process p,.lm-signal-grid p{max-width:72ch;margin:0;color:var(--muted);font-weight:560;line-height:1.72}
  .lm-icon{display:grid;width:44px;height:44px;margin-bottom:14px;place-items:center;border-radius:8px;background:#dff2fb;color:var(--blue)}
  .lm-icon--dark{background:var(--ink);color:#fff}
  .lm-panel{position:relative;overflow:hidden;padding:24px;border:1px solid #accde4;border-radius:10px;background:linear-gradient(135deg,#f8fcff,#e3f4fb)}
  .lm-panel strong{display:block;margin-bottom:10px;font-size:1.12rem}
  .lm-panel ul{display:grid;gap:10px;margin:18px 0 0;padding:0;list-style:none}
  .lm-panel li{display:flex;gap:10px;align-items:center;font-weight:800}
  .lm-panel li .tc-svg{color:var(--blue)}
  .lm-symptoms{background:var(--ice)!important}
  .lm-heading{display:grid;grid-template-columns:48px minmax(0,780px);gap:16px;align-items:start;margin-bottom:24px}
  .lm-heading>.tc-svg{box-sizing:border-box;width:44px;height:44px;max-width:44px;max-height:44px;padding:12px;border-radius:8px;background:var(--blue);color:#fff}
  .lm-signal-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
  .lm-signal-grid article{padding:20px;border-radius:10px;background:#fff;border:1px solid var(--line)}
  .lm-signal-grid article>.tc-svg{width:25px;height:25px;color:var(--blue)}
  .lm-signal-grid h3{margin-top:16px}
  .lm-proof{background:#fff}
  .lm-proof figure{margin:0;overflow:hidden;border-radius:12px;background:#d6e8f2;display:flex;align-items:center}
  .lm-proof img{display:block;width:100%;height:auto;max-height:360px;aspect-ratio:4/3;object-fit:cover;object-position:center;border-radius:12px}
  .lm-final figure{margin:0;overflow:hidden;border-radius:12px;background:#d6e8f2}
  .lm-final img{display:block;width:100%;aspect-ratio:16/10;max-height:240px;object-fit:cover;object-position:center;border-radius:12px}
  .lm-warning{background:#dcecf7!important}
  .lm-warning .lm-icon{background:#071F3A;color:#fff}
  .lm-risk-list{display:grid;gap:1px;background:var(--line)}
  .lm-risk-list article{display:grid;gap:7px;padding:20px;background:#fff}
  .lm-process{background:#f8fbfd}
  .lm-process__list{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;margin:0;padding:0;background:var(--line);list-style:none}
  .lm-process__list li{display:grid;min-height:190px;align-content:start;gap:16px;padding:20px;background:#fff}
  .lm-process__list strong{font-size:1.55rem;color:var(--blue)!important}
  .lm-process__list h3{margin-top:0}
  .lm-local{background:#fff}
  .lm-local address{display:grid;gap:12px;padding:24px;border-radius:10px;background:#e7f4fb;font-style:normal}
  .lm-local address a{color:var(--blue)!important;text-decoration:none;font-weight:800}
  .lm-final{padding:clamp(44px,5.5vw,72px) 0;background:#dcecf7}
  .lm-final>div>div>span{color:var(--blue)!important;font-weight:850;text-transform:uppercase;font-size:.78rem;letter-spacing:.08em}
  @media(hover:hover) and (pointer:fine){.lm-btn:hover{transform:translateY(-2px);background:#0e68b8}.lm-btn--light:hover{background:#eaf7fd;border-color:#eaf7fd}}
  @media(max-width:980px){.lm-signal-grid{grid-template-columns:repeat(2,1fr)}.lm-process__list{grid-template-columns:repeat(2,1fr)}.lm-split,.lm-proof__grid,.lm-warning__grid,.lm-local__grid,.lm-final__grid{grid-template-columns:1fr;gap:28px}}
  @media(max-width:640px){.lm-hero{min-height:640px}.lm-hero__content{padding-top:120px}.lm-facts,.lm-signal-grid,.lm-process__list{grid-template-columns:1fr}.lm-heading{grid-template-columns:42px 1fr;gap:12px}.lm-heading>.tc-svg{width:40px;height:40px;max-width:40px;max-height:40px;padding:11px}.lm-actions,.lm-actions .lm-btn{width:100%}.liquid-metal-page .lm-section{padding:36px 0}.lm-process__list li{min-height:auto}}
  @media(prefers-reduced-motion:reduce){.lm-btn{transition:none}}
</style>
