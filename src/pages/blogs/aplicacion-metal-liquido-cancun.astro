---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ServiceTicketSection from '../../components/ServiceTicketSection.astro';
import FaqSection from '../../components/FaqSection.astro';
import CommentsSection from '../../components/CommentsSection.astro';
import ContactSection from '../../components/ContactSection.astro';
import Footer from '../../components/Footer.astro';

const canonical = '/blogs/aplicacion-metal-liquido-cancun';

// WhatsApp prefill exacto según directriz obligatoria (regla 74)
const whatsappPrefill = encodeURIComponent(
  'Hola Pixon PC.\nQuiero revisar si mi equipo es compatible con metal líquido.\n\nEquipo:\nLaptop / PC / GPU / Otro\n\nMarca y modelo:\n\nMaterial actual:\nMetal líquido de fábrica /\nPasta térmica /\nNo sé\n\nProblema:\nTemperatura /\nThrottling /\nRuido /\nMantenimiento /\nIntervención anterior /\nOtro\n\n¿Ha sido abierto anteriormente?\nSí / No / No sé'
);
const whatsappUrl = `https://wa.me/529986690777?text=${whatsappPrefill}`;

// 22 Preguntas Frecuentes Técnicas Exhaustivas
const faqs = [
  {
    question: '¿Qué es el metal líquido y de qué está compuesto?',
    answer: 'Es una aleación metálica eutéctica de galio, indio y estaño (comúnmente conocida como Galinstan) que permanece en estado líquido a temperatura ambiente. Se utiliza como material de interfaz térmica (TIM) de ultra alto rendimiento entre el silicio y el disipador.',
  },
  {
    question: '¿El metal líquido es mejor que la pasta térmica convencional?',
    answer: 'Ofrece una conductividad térmica significativamente superior (alrededor de 73 W/m·K frente a los 8.5–14 W/m·K de las mejores pastas cerámicas o basadas en óxidos metálicos). Sin embargo, "mejor" depende del sistema: solo es recomendable cuando el disipador es químicamente compatible (níquel o cobre), existe sellado perimetral y el límite térmico proviene estrictamente de la interfaz.',
  },
  {
    question: '¿Es conductor de electricidad?',
    answer: 'Sí, absolutamente. A diferencia de la pasta térmica no capacitiva, el metal líquido conduce la corriente eléctrica. Cualquier gota desprendida hacia los condensadores cerámicos SMD o pistas de la placa madre puede provocar un cortocircuito catastrófico instantáneo. Por ello su aplicación exige aislamiento dieléctrico perimetral.',
  },
  {
    question: '¿Puede dañar una laptop?',
    answer: 'Puede dañarla gravemente si se aplica en exceso, si el disipador es de aluminio, si no se coloca una barrera aislante o si el chasis sufre torsión sin contención. Si se aplica en un equipo compatible con barrera de espuma de alta densidad y microdosificación milimétrica, opera con plena estabilidad mecánica.',
  },
  {
    question: '¿Se puede utilizar sobre disipadores de aluminio?',
    answer: '¡Bajo ninguna circunstancia! El galio reacciona químicamente con el aluminio mediante un proceso de fragilización intergranular por metal líquido (LME). Destruye la estructura cristalina del aluminio en cuestión de horas o días, convirtiéndolo en un polvo quebradizo que inutiliza el disipador.',
  },
  {
    question: '¿Se puede utilizar sobre disipadores de cobre puro?',
    answer: 'Sí es compatible, pero ocurre un fenómeno físico llamado amalgamación superficial o "tinning": el cobre absorbe lentamente moléculas de galio, formando una capa gris mate superficial. Esto no corroe el cobre, pero en la primera aplicación suele requerir una inspección y reaplicación a mediano plazo para reponer el galio absorbido antes de estabilizarse.',
  },
  {
    question: '¿Por qué se recomienda cobre niquelado como material ideal?',
    answer: 'Fabricantes de referencia térmica como Thermal Grizzly recomiendan el cobre con baño de níquel galvanizado porque el níquel actúa como barrera pasivadora contra la difusión del galio. Evita la absorción superficial, mantiene intacto el brillo del bloque y garantiza la máxima longevidad del compuesto sin necesidad de pulidos correctivos.',
  },
  {
    question: '¿Todas las laptops gamer pueden usar metal líquido?',
    answer: 'No. Muchas laptops gamer de gama media o chasis plástico tienen disipadores con aletas o bases mixtas con aluminio expuesto, o bien carecen de la presión de contacto Z necesaria para retener una sustancia fluida. En esos equipos, una pasta térmica de alta viscosidad anti pump-out o una almohadilla de cambio de fase (PTM7950) es una opción técnicamente superior y segura.',
  },
  {
    question: '¿Conviene convertir una laptop que venía de fábrica con pasta térmica a metal líquido?',
    answer: 'No lo recomendamos por defecto. Convertir un equipo requiere crear manualmente barreras de sellado epóxico y juntas de contención que de origen no existían. Solo se evalúa en equipos con disipadores 100% de cobre o níquel que demuestran un estrangulamiento térmico intratable por otros medios.',
  },
  {
    question: '¿Es diferente renovar metal líquido que venía de fábrica?',
    answer: 'Sí. Equipos como las series ASUS ROG Strix o Zephyrus vienen con una barrera perimetral de espuma de fábrica y disipadores niquelados diseñados para este material. El servicio consiste en retirar el metal oxidado o desplazado, renovar la barrera si está impregnada y aplicar una cantidad calibrada del compuesto original.',
  },
  {
    question: '¿El metal líquido puede escurrirse dentro del equipo?',
    answer: 'Puede migrar si se aplicó un volumen excesivo, si los tornillos del disipador no ejercen presión uniforme o si la laptop viaja constantemente en vertical sin una junta de contención intacta. Por esta razón, en Pixon PC aplicamos microcantidades esparcidas a nivel microscópico ("wetting") en ambas caras sin dejar acumulaciones libres.',
  },
  {
    question: '¿El metal líquido puede manchar la superficie del disipador?',
    answer: 'En cobre directo deja una amalgama superficial que cambia su coloración a plateada. En cobre niquelado la superficie suele limpiarse por completo con solventes químicos especiales y pulidor suave sin dejar residuos abrasivos.',
  },
  {
    question: '¿El cambio a metal líquido aumenta los FPS en juegos?',
    answer: 'No añade potencia mágica ni crea FPS que el chip no pueda generar. Lo que hace es eliminar el thermal throttling: si tu procesador o tarjeta gráfica reducían su frecuencia de 4.5 GHz a 2.8 GHz debido al calor extremo, estabilizar la disipación permite sostener las frecuencias máximas, evitando caídas bruscas de cuadros (stuttering) y tirones.',
  },
  {
    question: '¿Reduce el thermal throttling de manera definitiva?',
    answer: 'Reduce el estrangulamiento térmico siempre y cuando el disipador, los ventiladores y el flujo de aire ambiental sean capaces de desalojar los vatios que el chip transfiere. Si los radiadores están tapados de polvo o los ventiladores no giran a sus RPM normales, el calor se transferirá al bloque pero no saldrá del chasis.',
  },
  {
    question: '¿También se aplica metal líquido en la GPU (tarjeta gráfica)?',
    answer: 'En laptops con metal líquido de fábrica en ambos chips (como ciertos modelos ROG), se renueva en ambos. En conversiones personalizadas o GPUs de escritorio, se analiza minuciosamente porque el silicio de la GPU está rodeado de decenas de componentes SMD muy sensibles y los disipadores a menudo tienen tolerancias de montaje más complejas.',
  },
  {
    question: '¿Se debe cambiar junto con los thermal pads?',
    answer: 'El metal líquido se aplica única y exclusivamente sobre los núcleos de silicio (die del procesador y GPU). Los chips de memoria VRAM y las etapas de potencia VRM requieren thermal pads de silicón o masilla térmica (Thermal Putty). Durante el servicio revisamos que los pads no impidan el asentamiento plano del bloque sobre el silicio.',
  },
  {
    question: '¿Cada cuánto se debe revisar el metal líquido?',
    answer: 'No existe un calendario fijo universal de 6 o 12 meses. En un equipo con disipador niquelado y sellado de fábrica en buen estado, el compuesto puede durar años sin degradarse. La revisión se justifica cuando la telemetría muestra un incremento en el delta de temperatura entre núcleos o aumento en las revoluciones de los ventiladores.',
  },
  {
    question: '¿Se puede usar metal líquido en una PC de escritorio gamer?',
    answer: 'Sí, típicamente sobre el IHS (difusor térmico integrado) en procesadores desbloqueados para overclocking o estaciones de trabajo de renderizado continuo, siempre que el bloque de refrigeración líquida o cooler por aire posea base de cobre niquelado.',
  },
  {
    question: '¿Atienden laptops que ya traen metal líquido de fábrica desbordado o desplazado?',
    answer: 'Sí. Es un problema común en laptops que han sufrido golpes o han trabajado en vertical: el metal se acumula en un borde del silicio, dejando zonas del chip sin contacto ("hotspots"). Limpiamos el compuesto desplazado, inspeccionamos la barrera y reaplicamos con técnica de tensión superficial uniforme.',
  },
  {
    question: '¿Qué pasa si otro técnico aplicó demasiado metal líquido sin aislar?',
    answer: 'En Pixon PC recibimos equipos para descontaminación térmica de emergencia. Desarmamos el ensamble bajo microscopio estereoscópico, retiramos las esferas de galio libres con jeringas de succión capilar y limpiamos químicamente cada componente SMD antes de evaluar si la placa sufrió daños.',
  },
  {
    question: '¿Atienden mantenimiento de metal líquido en PlayStation 5 (PS5)?',
    answer: 'Sí, la PS5 utiliza metal líquido de fábrica sobre el SoC. Contamos con un protocolo específico para limpiar la oxidación superficial, reponer el compuesto y sellar el disipador original. Para este servicio, contamos con una sección dedicada a mantenimiento de PS5.',
  },
  {
    question: '¿Cuánto cuesta y cuánto tarda la aplicación de metal líquido en Cancún?',
    answer: 'El costo y tiempo dependen estrictamente del modelo: no requiere el mismo trabajo renovar una laptop ASUS ROG con barreras de fábrica que limpiar un equipo con derrame previo o acondicionar una PC personalizada. Realizamos un diagnóstico inicial para confirmar compatibilidad de materiales antes de cotizar.',
  },
];

// Fases del Proceso Profesional en Taller
const workshopPhases = [
  {
    phase: '01',
    name: 'Triage y Baseline Térmico',
    summary: 'Registramos temperaturas en reposo y bajo estrés controlado, frecuencias de reloj y comportamiento PWM de los ventiladores para tener una medición de referencia objetiva.',
    icon: 'fa-chart-line',
  },
  {
    phase: '02',
    name: 'Desmontaje ESD y Diagnóstico Químico',
    summary: 'En banco antiestático desconectamos alimentación y batería. Inspeccionamos la base del disipador para confirmar microscópicamente que sea cobre niquelado o cobre puro, descartando cualquier aleación de aluminio.',
    icon: 'fa-shield-halved',
  },
  {
    phase: '03',
    name: 'Aislamiento Dieléctrico de Precisión',
    summary: 'Aplicamos laca aislante dieléctrica de alta temperatura (conformal coating) sobre todos los condensadores SMD perimetrales al die de silicio. Reforzamos con cinta Kapton y barrera física de contención.',
    icon: 'fa-microchip',
  },
  {
    phase: '04',
    name: 'Dosificación y Esparcido Microscópico',
    summary: 'Utilizamos microcánula para dispensar una cantidad milimétrica de aleación (Thermal Grizzly Conductonaut). Frotamos mecánicamente sobre el silicio y la base del disipador hasta lograr una película de adherencia completa sin gotas sueltas.',
    icon: 'fa-droplet',
  },
  {
    phase: '05',
    name: 'Asentamiento con Torque Progresivo',
    summary: 'Alineamos el bloque térmico en un solo movimiento perpendicular y ajustamos la tornillería en patrón de cruz con torque calibrado para evitar que el fluido sea expulsado por presión desigual.',
    icon: 'fa-wrench',
  },
  {
    phase: '06',
    name: 'Estrés de Validación y Curva Acústica',
    summary: 'Sometemos el procesador y gráfica a pruebas de carga sostenida (Cinebench / FurMark). Monitoreamos que la dispersión térmica sea homogénea y que las frecuencias se sostengan sin thermal throttling.',
    icon: 'fa-temperature-arrow-down',
  },
];

