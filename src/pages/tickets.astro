---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TicketFormSection from '../components/TicketFormSection.astro';

const defaultDevice = Astro.url.searchParams.get('device') || '';
const defaultService = Astro.url.searchParams.get('service') || '';
const sourcePage = Astro.url.searchParams.get('source') || '/tickets';

const ticketSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Orden de Servicio Técnico | Pixon PC Cancún',
  description: 'Registra la orden de servicio para tu laptop, computadora, celular o consola en taller Pixon PC Cancún. Diagnóstico en 2 horas y garantía por escrito.',
  url: 'https://pixon.com.mx/tickets',
  isPartOf: { '@type': 'WebSite', name: 'Pixon PC', url: 'https://pixon.com.mx' },
};
---

<Base
  title="Orden de servicio técnico en Cancún | Pixon PC"
  description="Registra tu orden de servicio técnico para laptop, PC gamer, celular o soporte en Cancún. Diagnóstico inicial en 2 horas y garantía por escrito."
  canonical="/tickets"
  image="/assets/images/taller-pixon.webp"
  schema={[ticketSchema]}
>
  <link rel="stylesheet" href="/styles/public-availability.css" />
  <Navbar />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Orden de servicio' }]} />

  <!-- ═══════════════════════════════════════════════════════════════
       HERO PROFESIONAL: ORDEN DE SERVICIO TÉCNICO (PIXON PC CANCÚN)
  ═══════════════════════════════════════════════════════════════ -->
  <section class="order-hero" aria-labelledby="order-hero-title">
    <div class="container order-hero-container">
      
      <!-- Badge de Estado en Vivo con Microanimación -->
      <div class="order-live-badge">
        <span class="live-pulse" aria-hidden="true">
          <span class="pulse-ring"></span>
          <span class="pulse-dot"></span>
        </span>
        <span>Taller activo en Cancún · Recepción abierta de 11:00 AM a 10:00 PM</span>
      </div>

      <h1 id="order-hero-title">Registro y Orden de Servicio Técnico</h1>
      <p class="order-hero-lead">
        Ingresa tu equipo a nuestro taller especializado en Cancún. Asignación inmediata de técnico, diagnóstico en menos de 2 horas y seguimiento digital sin filas ni esperas.
      </p>

      <!-- 4 Puntos Clave de Rapidez y Confianza con Checks -->
      <div class="order-checks-grid" role="list">
        <div class="order-check-item" role="listitem">
          <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
          <div>
            <strong>Diagnóstico en 2 horas</strong>
            <span>Revisión inicial rápida y evidencia clara</span>
          </div>
        </div>
        <div class="order-check-item" role="listitem">
          <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
          <div>
            <strong>Recepción 11:00 AM - 10:00 PM</strong>
            <span>Atención continua de Lunes a Sábado</span>
          </div>
        </div>
        <div class="order-check-item" role="listitem">
          <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
          <div>
            <strong>Folio y seguimiento WhatsApp</strong>
            <span>Estatus en tiempo real de tu reparación</span>
          </div>
        </div>
        <div class="order-check-item" role="listitem">
          <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
          <div>
            <strong>Garantía por escrito</strong>
            <span>Refacciones de calidad y mano de obra</span>
          </div>
        </div>
      </div>

      <!-- Acciones de Navegación Rápida -->
      <div class="order-hero-actions">
        <a href="#ticket-form" class="btn btn-primary order-btn-cta">
          <i class="fa-solid fa-file-pen" aria-hidden="true"></i> Registrar equipo en taller
        </a>
        <a href="#disponibilidad" class="btn btn-outline order-btn-secondary">
          <i class="fa-solid fa-calendar-check" aria-hidden="true"></i> Ver turnos disponibles
        </a>
        <a
          href="https://wa.me/529986690777?text=Hola%20Pixon%20PC%2C%20quiero%20ingresar%20un%20equipo%20a%20su%20taller%20en%20Canc%C3%BAn"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp order-btn-wa"
          aria-label="Contactar a Pixon PC por WhatsApp"
        >
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp directo
        </a>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       SECCIÓN 2: DISPONIBILIDAD EN TIEMPO REAL (TALLER CANCÚN)
  ═══════════════════════════════════════════════════════════════ -->
  <section class="pac-section" aria-labelledby="pac-section-title" id="disponibilidad">
    <div class="container pac-section-inner">
      
      <!-- Columna Informativa de Taller -->
      <div class="pac-section-copy">
        <div class="pac-kicker">
          <i class="fa-solid fa-clock" aria-hidden="true"></i>
          <span>Atención con cita confirmada</span>
        </div>
        <h2 id="pac-section-title">Disponibilidad de Recepción en Taller</h2>
        <p>
          Consulta los turnos libres para recibir o entregar tu laptop, computadora o celular en nuestras instalaciones de Cancún. Pre-selecciona tu día y horario para agilizar el ingreso de tu equipo.
        </p>

        <!-- Tarjeta de Información Operativa -->
        <div class="pac-info-card">
          <div class="pac-info-row">
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            <div>
              <strong>Ubicación del Taller:</strong>
              <span>Cto. Hacienda Chimay, 77539 Cancún, Q.R.</span>
            </div>
          </div>
          <div class="pac-info-row">
            <i class="fa-solid fa-door-open" aria-hidden="true"></i>
            <div>
              <strong>Horario de Atención:</strong>
              <span>Lunes a Sábado: 11:00 AM a 10:00 PM</span>
            </div>
          </div>
          <div class="pac-info-row">
            <i class="fa-solid fa-bolt" aria-hidden="true"></i>
            <div>
              <strong>Recepción Inmediata:</strong>
              <span>Ingreso sin filas con folio asignado al momento</span>
            </div>
          </div>
        </div>

        <ul class="pac-bullets">
          <li><i class="fa-solid fa-circle-check" aria-hidden="true"></i> <span>Revisión inicial en menos de 2 horas hábiles</span></li>
          <li><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> <span>Garantía por escrito en refacciones y servicio</span></li>
          <li><i class="fa-solid fa-envelope-circle-check" aria-hidden="true"></i> <span>Notificación por WhatsApp y correo electrónico</span></li>
        </ul>
      </div>

      <!-- Columna del Calendario Interactivo -->
      <div class="pac-calendar-col">
        <div class="pac-calendar-wrapper">
          <div data-pac-calendar id="pac-inline-calendar" aria-label="Calendario de disponibilidad de citas y turnos en taller"></div>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       SECCIÓN 3: FORMULARIO OFICIAL DE ORDEN DE SERVICIO
  ═══════════════════════════════════════════════════════════════ -->
  <TicketFormSection
    id="ticket-form"
    sourcePage={sourcePage}
    defaultDevice={defaultDevice}
    defaultService={defaultService}
    title="Datos de tu Orden de Servicio"
    subtitle="Ingresa la marca, modelo y falla de tu equipo. Asignaremos prioridad y generaremos tu folio de atención técnica."
  />

  <Footer />

  <script src="/scripts/public-availability.js" defer></script>
</Base>

<style>
  /* ═══════════════════════════════════════════════════════════════
     HERO ESTILOS PROFESIONALES
  ═══════════════════════════════════════════════════════════════ */
  .order-hero {
    padding: 64px 0 54px;
    background: linear-gradient(135deg, #071F3A 0%, #0c2b50 50%, #0f3666 100%);
    color: #ffffff;
    position: relative;
    overflow: hidden;
  }
  .order-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -20%;
    width: 140%;
    height: 200%;
    background: radial-gradient(circle at 50% 20%, rgba(34, 211, 238, 0.08) 0%, transparent 60%);
    pointer-events: none;
  }
  .order-hero-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Badge de Pulso en Vivo */
  .order-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.09);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    padding: 6px 16px;
    font-size: 0.82rem;
    font-weight: 700;
    color: #93c5fd;
    margin-bottom: 20px;
    backdrop-filter: blur(8px);
  }
  .live-pulse {
    position: relative;
    display: inline-flex;
    width: 10px;
    height: 10px;
  }
  .pulse-ring {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: #10b981;
    opacity: 0.75;
    animation: livePulseRing 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
  }
  .pulse-dot {
    position: relative;
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 8px #10b981;
  }
  @keyframes livePulseRing {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(2.2); opacity: 0; }
    100% { transform: scale(2.2); opacity: 0; }
  }

  .order-hero h1 {
    margin: 0 auto 16px;
    max-width: 820px;
    font-family: var(--font-heading, system-ui, sans-serif);
    font-size: clamp(2.1rem, 4.2vw, 3.4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #ffffff;
  }
  .order-hero-lead {
    margin: 0 auto 28px;
    max-width: 720px;
    font-size: clamp(1.02rem, 1.8vw, 1.15rem);
    font-weight: 500;
    line-height: 1.65;
    color: #dbeafe;
  }

  /* Grid de 4 Puntos Clave */
  .order-checks-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    max-width: 840px;
    width: 100%;
    margin: 0 auto 32px;
  }
  .order-check-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: 12px 16px;
    text-align: left;
    backdrop-filter: blur(6px);
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .order-check-item:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(34, 211, 238, 0.35);
  }
  .order-check-item i {
    color: #10b981;
    font-size: 1.25rem;
    margin-top: 2px;
    flex-shrink: 0;
  }
  .order-check-item div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .order-check-item strong {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.25;
  }
  .order-check-item span {
    font-size: 0.8rem;
    font-weight: 500;
    color: #cbd5e1;
    line-height: 1.35;
  }

  /* Acciones */
  .order-hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
  }
  .order-btn-cta {
    background: #059669;
    color: #ffffff;
    border: 1px solid #10b981;
    font-weight: 800;
    padding: 12px 24px;
    border-radius: 10px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.96rem;
    box-shadow: 0 4px 14px rgba(5, 150, 105, 0.35);
    transition: all 0.18s ease;
  }
  .order-btn-cta:hover {
    background: #047857;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(5, 150, 105, 0.45);
    color: #ffffff;
  }
  .order-btn-secondary {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    font-weight: 700;
    padding: 12px 20px;
    border-radius: 10px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.94rem;
    transition: all 0.18s ease;
  }
  .order-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: #ffffff;
    color: #ffffff;
    transform: translateY(-2px);
  }
  .order-btn-wa {
    background: #25d366;
    color: #ffffff;
    border: 1px solid #22bf5b;
    font-weight: 700;
    padding: 12px 20px;
    border-radius: 10px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.94rem;
    transition: all 0.18s ease;
  }
  .order-btn-wa:hover {
    background: #1eb954;
    color: #ffffff;
    transform: translateY(-2px);
  }

  /* ═══════════════════════════════════════════════════════════════
     SECCIÓN DISPONIBILIDAD (PULIDA, ELEGANTE Y COMPLETA)
  ═══════════════════════════════════════════════════════════════ */
  .pac-section {
    padding: 68px 0;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }
  .pac-section-inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 44px;
    align-items: start;
  }
  .pac-kicker {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    color: #1e40af;
    border-radius: 999px;
    padding: 5px 12px;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    margin-bottom: 14px;
  }
  .pac-section-copy h2 {
    margin: 0 0 14px;
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    font-weight: 800;
    color: #071F3A;
    line-height: 1.15;
  }
  .pac-section-copy p {
    color: #071F3A;
    font-size: 1.02rem;
    line-height: 1.65;
    margin: 0 0 24px;
    opacity: 0.92;
  }

  /* Info Card */
  .pac-info-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 18px 20px;
    margin-bottom: 24px;
    box-shadow: 0 2px 10px rgba(7, 31, 58, 0.05);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .pac-info-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .pac-info-row i {
    color: #0284c7;
    font-size: 1.1rem;
    margin-top: 2px;
    flex-shrink: 0;
  }
  .pac-info-row div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .pac-info-row strong {
    font-size: 0.88rem;
    color: #071F3A;
    font-weight: 700;
  }
  .pac-info-row span {
    font-size: 0.85rem;
    color: #071F3A;
    opacity: 0.85;
  }

  .pac-bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pac-bullets li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #071F3A;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .pac-bullets li i {
    color: #059669;
    font-size: 1rem;
    flex-shrink: 0;
  }

  .pac-calendar-col {
    display: flex;
    justify-content: center;
    width: 100%;
  }
  .pac-calendar-wrapper {
    width: 100%;
    max-width: 440px;
  }

  /* ═══════════════════════════════════════════════════════════════
     RESPONSIVE (MOBILE FIRST)
  ═══════════════════════════════════════════════════════════════ */
  @media (max-width: 900px) {
    .pac-section-inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .order-checks-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .order-hero {
      padding: 44px 0 36px;
    }
    .pac-section {
      padding: 44px 0;
    }
  }

  @media (max-width: 480px) {
    .order-hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .order-btn-cta,
    .order-btn-secondary,
    .order-btn-wa {
      width: 100%;
      justify-content: center;
    }
  }
</style>
