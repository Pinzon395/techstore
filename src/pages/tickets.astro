---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TicketFormSection from '../components/TicketFormSection.astro';

const defaultDevice = Astro.url.searchParams.get('device') || '';
const defaultService = Astro.url.searchParams.get('service') || '';
const sourcePage = Astro.url.searchParams.get('source') || '/tickets';

const ticketSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Crear ticket de servicio técnico | Pixon PC Cancún',
  description: 'Crea un ticket para reparación de computadoras, laptops, celulares, consolas o soporte técnico empresarial en Cancún.',
  url: 'https://pixon.com.mx/tickets',
  isPartOf: { '@type': 'WebSite', name: 'Pixon PC', url: 'https://pixon.com.mx' },
};
---

<Base
  title="Crear ticket de servicio técnico | Pixon PC Cancún"
  description="Crea un ticket de servicio técnico en Pixon PC Cancún para laptops, computadoras, celulares, consolas y soporte empresarial."
  canonical="/tickets"
  image="/assets/images/taller-pixon.webp"
  schema={[ticketSchema]}
>
  <link rel="stylesheet" href="/styles/public-availability.css" />
  <Navbar />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Tickets' }]} />

  <section class="ticket-page-hero">
    <div class="container">
      <span>Seguimiento ordenado</span>
      <h1>Crear ticket de servicio técnico</h1>
      <p>Registra tu equipo, falla y datos de contacto. Revisamos tu solicitud y te respondemos con el siguiente paso en menos de 2 horas hábiles.</p>
      <div class="ticket-page-points">
        <strong>Diagnóstico claro</strong>
        <strong>Fotos y evidencia</strong>
        <strong>Garantía por escrito</strong>
      </div>

      <!-- Disponibilidad en tiempo real: compact hero strip -->
      <div class="ticket-hero-avail">
        <div data-pac-hero id="pac-hero-strip" aria-label="Disponibilidad en tiempo real"></div>
      </div>
    </div>
  </section>

  <!-- Calendario de disponibilidad en tiempo real -->
  <section class="pac-section" aria-labelledby="pac-section-title" id="disponibilidad">
    <div class="container pac-section-inner">
      <div class="pac-section-copy">
        <h2 id="pac-section-title">Disponibilidad en tiempo real</h2>
        <p>Consulta qué días y horarios tiene disponibles Pixon PC. Selecciona un espacio para pre-cargar la fecha en el formulario de servicio.</p>
        <ul class="pac-bullets">
          <li><i class="fa-solid fa-circle-check"></i> Sin registro previo</li>
          <li><i class="fa-solid fa-lock"></i> Privacidad garantizada</li>
          <li><i class="fa-solid fa-rotate"></i> Actualizado en tiempo real</li>
        </ul>
      </div>
      <div class="pac-calendar-col">
        <div data-pac-calendar id="pac-inline-calendar" aria-label="Calendario de disponibilidad de citas"></div>
      </div>
    </div>
  </section>

  <TicketFormSection
    id="ticket-form"
    sourcePage={sourcePage}
    defaultDevice={defaultDevice}
    defaultService={defaultService}
    title="Cuéntanos qué necesita tu equipo"
    subtitle="El formulario nos ayuda a clasificar prioridad, tipo de equipo y datos de contacto sin saturar el home."
  />

  <Footer />

  <script src="/scripts/public-availability.js" defer></script>
</Base>

<style>
  .ticket-page-hero{padding:70px 0 44px;background:linear-gradient(135deg,#0f172a,#1e3a8a);color:#fff;text-align:center}
  .ticket-page-hero,.ticket-page-hero *{font-family:var(--font-main);font-style:normal;letter-spacing:0}
  .ticket-page-hero span{display:inline-flex;margin-bottom:10px;color:#bfdbfe;font-weight:700;text-transform:uppercase;font-size:.78rem}
  .ticket-page-hero h1{margin:0 auto 12px;max-width:760px;font-family:var(--font-heading);font-size:clamp(2rem,4vw,3.4rem);font-weight:700;line-height:1.05}
  .ticket-page-hero p{margin:0 auto;color:#dbeafe;max-width:720px;font-size:1.08rem;font-weight:500;line-height:1.6}
  .ticket-page-points{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:22px}
  .ticket-page-points strong{border:1px solid rgba(255,255,255,.22);border-radius:999px;padding:8px 12px;background:rgba(255,255,255,.08);font-size:.9rem;font-weight:700}

  /* Hero availability strip */
  .ticket-hero-avail{margin-top:28px;display:flex;justify-content:center}
  .ticket-hero-avail #pac-hero-strip{width:100%;max-width:460px}

  /* Public calendar section */
  .pac-section{padding:64px 0;background:#f8fafc;border-bottom:1px solid #e2e8f0}
  .pac-section-inner{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}
  .pac-section-copy h2{margin:0 0 12px;font-size:clamp(1.5rem,2.5vw,2rem);font-weight:800;color:#071F3A;line-height:1.1}
  .pac-section-copy p{color:#334155;font-size:1rem;line-height:1.65;margin:0 0 20px}
  .pac-bullets{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px}
  .pac-bullets li{display:flex;align-items:center;gap:10px;color:#071F3A;font-size:.92rem;font-weight:600}
  .pac-bullets li i{color:#059669;font-size:.9rem}
  .pac-calendar-col{display:flex;justify-content:center}

  @media(max-width:768px){
    .pac-section-inner{grid-template-columns:1fr;gap:28px}
    .pac-section{padding:40px 0}
    .ticket-hero-avail{margin-top:20px;padding:0 12px;}
  }
</style>
