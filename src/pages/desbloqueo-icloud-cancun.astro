---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import DesbloqueoIcloudView from '../components/views/DesbloqueoIcloudView.astro';

const category = { slug: 'telefono', name: 'Telefonía / Celulares' };
const service = { slug: 'desbloqueo-icloud', label: 'Desbloqueo de iCloud' };

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', href: '/servicios' },
  { label: 'iPhone', href: '/servicios/telefono/reparacion-iphone' },
  { label: 'Desbloqueo de iCloud en Cancún' },
];

const pageTitle = "Desbloqueo de iCloud y Quitar Cuenta iPhone en Cancún | Pixon PC";
const pageDescription = "Diagnóstico técnico de IMEI, eliminación de cuenta Apple ID y restablecimiento de pantalla de activación para iPhone en Cancún. Atención presencial en Cancún Centro, Huayacán y Q. Roo.";
const canonicalUrl = "https://pixon.com.mx/desbloqueo-icloud-cancun";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Desbloqueo de iCloud y Quitar Cuenta iPhone en Cancun",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Pixon PC",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Cto. Hacienda Chimay",
        "addressLocality": "Cancún",
        "addressRegion": "Q.R.",
        "postalCode": "77539",
        "addressCountry": "MX"
      },
      "telephone": "+529986690777",
      "email": "pixonpc@gmail.com",
      "url": "https://pixon.com.mx"
    },
    "areaServed": [
      { "@type": "City", "name": "Cancún" },
      { "@type": "AdministrativeArea", "name": "Cancún Centro" },
      { "@type": "AdministrativeArea", "name": "Huayacán" },
      { "@type": "AdministrativeArea", "name": "Cumbres" },
      { "@type": "AdministrativeArea", "name": "Zona Hotelera" }
    ],
    "description": pageDescription,
    "url": canonicalUrl
  }
];
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  schema={schema}
>
  <div class="icloud-page" style="background-color: #071F3A;">
    <Navbar />
    
    <Breadcrumb items={breadcrumbs} />
    
    <main>
      <DesbloqueoIcloudView category={category} service={service} />
    </main>
  </div>
</Base>

<style is:global>
  .icloud-page .breadcrumb-container {
    background-color: #071F3A !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
    padding: 0.75rem 0 !important;
    margin-top: 72px;
  }
  @media (max-width: 768px) {
    .icloud-page .breadcrumb-container {
      margin-top: 70px;
    }
  }
  .icloud-page .breadcrumb a {
    color: #60a5fa !important;
    font-weight: 500;
  }
  .icloud-page .breadcrumb a:hover {
    color: #93c5fd !important;
    text-decoration: underline;
  }
  .icloud-page .breadcrumb span {
    color: rgba(255, 255, 255, 0.85) !important;
  }
  .icloud-page .breadcrumb li + li::before {
    color: rgba(255, 255, 255, 0.4) !important;
  }
</style>
