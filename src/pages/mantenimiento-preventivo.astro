---
// Static fallback for installations that serve `dist/` directly.
// Express sends the permanent 301 redirect before static files.
const destination = '/mantenimiento-preventivo-computadora';
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={`https://pixon.com.mx${destination}`} />
    <title>Redirigiendo a mantenimiento preventivo | Pixon PC</title>
    <script>window.location.replace('/mantenimiento-preventivo-computadora');</script>
  </head>
  <body>
    <p>Redirigiendo a <a href={destination}>mantenimiento preventivo de computadora</a>&hellip;</p>
  </body>
</html>
