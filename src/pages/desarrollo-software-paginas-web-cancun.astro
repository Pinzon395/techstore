  .sd-hero__glow--2{bottom:40px;right:-80px;width:460px;height:460px;background:rgba(15,159,110,.14)}

  .sd-hero__grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(380px,.95fr);gap:clamp(28px,4.5vw,60px);align-items:center;min-height:clamp(600px,74vh,780px);padding:clamp(112px,10vw,144px) 0 54px}
