              <path class="sd-wire-line" d="M220 50 C 270 50, 270 120, 330 120" stroke="#21a9f3" stroke-width="2" stroke-dasharray="4 4" />
              <circle cx="110" cy="50" r="4" fill="#21a9f3" />
              <circle cx="240" cy="120" r="4" fill="#0f9f6e" />
              <circle cx="330" cy="120" r="4" fill="#1479D4" />
            </svg>
            <div class="sd-blueprint__meta">
              <span>Arquitectura Modular</span>
