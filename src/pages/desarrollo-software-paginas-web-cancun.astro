  /* Timeline de fases con barra de progreso sincronizada a 24 segundos */
  .sd-cockpit__timeline{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;padding:8px 12px;background:rgba(0,0,0,.22);border-bottom:1px solid rgba(255,255,255,.08)}
  .sd-phase-pill{position:relative;padding:6px 4px;border-radius:6px;background:rgba(255,255,255,.04);text-align:center;overflow:hidden}
  .sd-phase-pill span{position:relative;z-index:1;font-size:.68rem;font-weight:750;color:rgba(255,255,255,.75)!important;white-space:nowrap}
  .sd-phase-bar{position:absolute;inset:0;background:rgba(20,121,212,.4);transform-origin:left;transform:scaleX(0)}
  .sd-phase-pill--1 .sd-phase-bar{animation:sd-bar-1 24s linear infinite}
  .sd-phase-pill--2 .sd-phase-bar{animation:sd-bar-2 24s linear infinite}
  .sd-phase-pill--3 .sd-phase-bar{animation:sd-bar-3 24s linear infinite}
  .sd-phase-pill--4 .sd-phase-bar{animation:sd-bar-4 24s linear infinite}

  /* Escenario con altura fija y crossfade fluido */
  .sd-cockpit__stage{position:relative;height:340px;padding:16px;overflow:hidden}
  .sd-scene{position:absolute;inset:16px;display:flex;flex-direction:column;justify-content:center;opacity:0;pointer-events:none;transition:transform 600ms cubic-bezier(.16,1,.3,1)}
  .sd-scene--blueprint{animation:sd-scene-1 24s cubic-bezier(.16,1,.3,1) infinite}
  .sd-scene--code{animation:sd-scene-2 24s cubic-bezier(.16,1,.3,1) infinite}
  .sd-scene--vitals{animation:sd-scene-3 24s cubic-bezier(.16,1,.3,1) infinite}
  .sd-scene--search{animation:sd-scene-4 24s cubic-bezier(.16,1,.3,1) infinite}

  /* Escena 1: Blueprint */
  .sd-blueprint__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;position:relative;z-index:2}
  .sd-arch-node{padding:10px 12px;border:1px solid rgba(255,255,255,.14);border-radius:10px;background:rgba(7,31,58,.82);box-shadow:0 8px 24px -12px rgba(0,0,0,.6)}
  .sd-arch-tag{display:inline-block;padding:2px 6px;border-radius:4px;background:rgba(33,169,243,.18);color:#7ccdfa!important;font-size:.65rem;font-weight:800;text-transform:uppercase}
  .sd-arch-node strong{display:block;margin:4px 0 2px;color:#fff!important;font-size:.82rem;font-weight:800}
  .sd-arch-node small{display:block;color:rgba(255,255,255,.65)!important;font-size:.7rem}
  .sd-blueprint__wires{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:1}
  .sd-wire-line{animation:sd-dash 1.6s linear infinite}
  .sd-blueprint__meta{display:flex;justify-content:space-between;margin-top:14px;padding-top:10px;border-top:1px dashed rgba(255,255,255,.14);font-size:.7rem;font-weight:700;color:#96bfd9!important}

  /* Escena 2: Código IDE */
  .sd-code-box{height:100%;display:flex;flex-direction:column;border:1px solid rgba(255,255,255,.14);border-radius:12px;background:#030f1c;overflow:hidden}
  .sd-code-box__tab{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:rgba(255,255,255,.05);border-bottom:1px solid rgba(255,255,255,.08)}
  .sd-code-box__file{font-family:monospace;font-size:.75rem;color:#bce0fb!important;font-weight:700}
  .sd-code-box__type{font-size:.66rem;padding:2px 6px;border-radius:4px;background:#1479D4;color:#fff!important;font-weight:800}
  .sd-code-box__content{flex:1;margin:0;padding:12px 14px;font-family:Consolas,Menlo,Monaco,monospace;font-size:.74rem;line-height:1.55;color:#e8f8ff!important;overflow:hidden}
  .c-kw{color:#7ccdfa;font-weight:700}.c-var{color:#e8f8ff}.c-fn{color:#fed156}.c-prop{color:#93c5fd}.c-str{color:#a7f3d0}.c-bool{color:#f87171}
  .sd-code-box__footer{display:flex;justify-content:space-between;padding:6px 12px;background:rgba(255,255,255,.03);border-top:1px solid rgba(255,255,255,.06);font-size:.7rem;font-weight:750}
