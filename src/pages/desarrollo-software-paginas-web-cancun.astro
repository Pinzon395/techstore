  .sd-vitals-badge{padding:3px 8px;border-radius:999px;background:rgba(16,185,129,.2);border:1px solid #10b981;color:#10b981!important;font-size:.72rem;font-weight:900}
  .sd-vitals-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:12px 0}
  .sd-metric-card{padding:10px;border-radius:8px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);text-align:center}
  .sd-metric-card__val{display:block;font-size:1.3rem;font-weight:900;line-height:1}
  .sd-metric-card__lbl{display:block;margin:5px 0 6px;color:rgba(255,255,255,.75)!important;font-size:.68rem;font-weight:700}
