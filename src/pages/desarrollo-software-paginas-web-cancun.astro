  .sd-serp-sitelinks span{padding:2px 6px;border-radius:4px;background:rgba(255,255,255,.07);color:#bce0fb!important;font-size:.65rem;font-weight:750}

  .sd-lead-alert{display:flex;align-items:center;gap:12px;margin-top:10px;padding:10px 12px;border:1px solid rgba(16,185,129,.4);border-radius:10px;background:rgba(16,185,129,.12);backdrop-filter:blur(6px)}
  .sd-lead-alert__icon{display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:#10b981;color:#fff!important;flex:0 0 auto}
  .sd-lead-alert__icon .tc-svg{width:18px;height:18px;fill:#fff}
  .sd-lead-alert__info{flex:1;min-width:0}
  .sd-lead-alert__info strong{display:block;color:#fff!important;font-size:.78rem;font-weight:850}
  .sd-lead-alert__info span{display:block;color:rgba(255,255,255,.8)!important;font-size:.7rem;text-overflow:ellipsis;white-space:nowrap;overflow:hidden}
