  .sd-hero h1{max-width:680px;margin:12px 0 14px;color:#fff!important;font-family:var(--font-heading);font-size:clamp(1.65rem,2.8vw,2.45rem);font-style:italic;font-weight:850;line-height:1.15;letter-spacing:-.025em;text-wrap:balance}
