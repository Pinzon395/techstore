      <div class="sd-hero__glow sd-hero__glow--1"></div>
      <div class="sd-hero__glow sd-hero__glow--2"></div>
    </div>

    <div class="sd-shell sd-hero__grid">
      <div class="sd-hero__copy">
        <div class="sd-badge-live">
          <span class="sd-pulse-dot" aria-hidden="true"></span>
          <span>Ingeniería de Software · Web · SEO · Cancún</span>
        </div>

