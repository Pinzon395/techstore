</Base>

<style is:global>
  .software-blog-page{--sd-ink:#071F3A;--sd-muted:#294963;--sd-blue:#1479D4;--sd-cyan:#21a9f3;--sd-green:#0f9f6e;--sd-ice:#f0f7fd;--sd-soft:#f7fbfe;--sd-line:#cbdce8;--sd-warn:#b7791f;color:var(--sd-ink)}
