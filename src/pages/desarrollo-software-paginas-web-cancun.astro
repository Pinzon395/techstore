  /* Escena 3: Vitals Board */
  .sd-vitals-board{height:100%;display:flex;flex-direction:column;justify-content:space-between;padding:14px;border:1px solid rgba(255,255,255,.14);border-radius:12px;background:rgba(7,31,58,.82)}
