  .sd-metric-card__bar div{height:100%;background:#10b981;border-radius:999px}
  .sd-vitals-checklist{display:grid;gap:6px;font-size:.73rem;color:rgba(255,255,255,.85)!important;padding-top:10px;border-top:1px solid rgba(255,255,255,.1)}
  .sd-vitals-checklist div{display:flex;align-items:center;gap:6px}

  /* Escena 4: Google Serp y Lead Alert */
  .sd-serp-preview{padding:12px 14px;border:1px solid rgba(255,255,255,.14);border-radius:12px;background:#030f1c}
  .sd-serp-url{display:flex;align-items:center;gap:6px;font-size:.7rem;color:rgba(255,255,255,.65)!important}
  .sd-google-g{display:grid;place-items:center;width:16px;height:16px;border-radius:50%;background:#fff;color:#1a73e8;font-size:.65rem;font-weight:900}
  .sd-serp-title{margin:4px 0 3px;font-size:.85rem;color:#93c5fd!important;font-weight:800;line-height:1.2}
