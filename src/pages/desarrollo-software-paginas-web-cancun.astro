  .software-blog-page section.sd-section{content-visibility:visible!important;contain-intrinsic-size:none!important}

  /* HERO REDISEÑADO CON ALTA INGENIERÍA Y TIEMPO FLUIDO */
  .sd-hero{position:relative;overflow:hidden;background:#051426;color:#fff;isolation:isolate}
