  /* Cockpit footer telemetry */
  .sd-cockpit__footer{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(255,255,255,.1);border-top:1px solid rgba(255,255,255,.1)}
  .sd-cockpit__stat{padding:8px 10px;background:rgba(7,31,58,.9);text-align:center}
  .sd-cockpit__stat small{display:block;color:#96bfd9!important;font-size:.64rem;text-transform:uppercase;letter-spacing:.04em}
  .sd-cockpit__stat strong{display:block;margin-top:2px;color:#fff!important;font-size:.74rem;font-weight:800}

  /* KEYFRAMES ORQUESTADOS (24 SEGUNDOS TOTAL = 6S POR FASE) */
  @keyframes sd-dot-pulse{0%,100%{box-shadow:0 0 0 0 rgba(15,159,110,.7)}50%{box-shadow:0 0 0 6px rgba(15,159,110,0)}}
  @keyframes sd-dash{to{stroke-dashoffset:-16}}

  /* Escena 1: 0% a 25% (0s - 6s) */
  @keyframes sd-scene-1{
    0%{opacity:0;transform:translateY(8px) scale(.99);pointer-events:none}
    2%,23%{opacity:1;transform:none;pointer-events:auto}
    25%,100%{opacity:0;transform:translateY(-8px) scale(.99);pointer-events:none}
  }
  /* Escena 2: 25% a 50% (6s - 12s) */
  @keyframes sd-scene-2{
    0%,24%{opacity:0;transform:translateY(8px) scale(.99);pointer-events:none}
    26%,48%{opacity:1;transform:none;pointer-events:auto}
    50%,100%{opacity:0;transform:translateY(-8px) scale(.99);pointer-events:none}
  }
  /* Escena 3: 50% a 75% (12s - 18s) */
  @keyframes sd-scene-3{
    0%,49%{opacity:0;transform:translateY(8px) scale(.99);pointer-events:none}
    51%,73%{opacity:1;transform:none;pointer-events:auto}
    75%,100%{opacity:0;transform:translateY(-8px) scale(.99);pointer-events:none}
  }
  /* Escena 4: 75% a 100% (18s - 24s) */
  @keyframes sd-scene-4{
    0%,74%{opacity:0;transform:translateY(8px) scale(.99);pointer-events:none}
    76%,98%{opacity:1;transform:none;pointer-events:auto}
    100%{opacity:0;transform:translateY(-8px) scale(.99);pointer-events:none}
  }

  /* Barras de progreso secuenciales */
  @keyframes sd-bar-1{
    0%{transform:scaleX(0)}
    23%,98%{transform:scaleX(1)}
    99%,100%{transform:scaleX(0)}
  }
  @keyframes sd-bar-2{
    0%,24%{transform:scaleX(0)}
    48%,98%{transform:scaleX(1)}
    99%,100%{transform:scaleX(0)}
  }
  @keyframes sd-bar-3{
    0%,49%{transform:scaleX(0)}
    73%,98%{transform:scaleX(1)}
    99%,100%{transform:scaleX(0)}
  }
  @keyframes sd-bar-4{
    0%,74%{transform:scaleX(0)}
    98%{transform:scaleX(1)}
    99%,100%{transform:scaleX(0)}
  }

  @media(hover:hover) and (pointer:fine){
    .sd-btn:hover{transform:translateY(-2px)}
    .sd-family:hover,.sd-card:hover{border-color:#aacfe6;box-shadow:0 14px 28px -22px rgba(7,31,58,.28)}
    .sd-trust-card:hover{border-color:rgba(255,255,255,.28);background:rgba(255,255,255,.08)}
  }
  @media(max-width:1100px){
    .sd-card-grid--wide{grid-template-columns:repeat(3,1fr)}
    .sd-process{grid-template-columns:repeat(3,1fr)}
    .sd-callout{grid-template-columns:1fr}
  }
  @media(max-width:920px){
    .sd-hero__grid,.sd-two-col,.sd-final__grid{grid-template-columns:1fr}
    .sd-hero__copy{max-width:100%}
    .sd-cockpit{margin-top:14px}
    .sd-family-grid,.sd-card-grid,.sd-tech-grid{grid-template-columns:repeat(2,1fr)}
    .sd-panel{position:static}
  }
  @media(max-width:640px){
    .sd-hero__grid{min-height:auto;padding:106px 0 44px}
    .sd-hero h1{font-size:clamp(1.5rem,7vw,1.95rem)}
    .sd-actions,.sd-actions .sd-btn{width:100%}
    .sd-trust-row{grid-template-columns:1fr}
    .sd-cockpit__timeline{grid-template-columns:repeat(2,1fr);gap:6px}
    .sd-cockpit__stage{height:380px}
    .sd-blueprint__grid{grid-template-columns:1fr}
    .sd-vitals-metrics{grid-template-columns:1fr}
    .sd-cockpit__footer{grid-template-columns:repeat(2,1fr)}
    .sd-family-grid,.sd-card-grid,.sd-card-grid--wide,.sd-mini-grid,.sd-tech-grid,.sd-process{grid-template-columns:1fr}
    .sd-process li{min-height:auto}
    .sd-section{padding:36px 0}
  }
  @media(max-width:380px){
    .software-blog-page .sd-shell{width:min(100% - 20px,1180px)}
    .sd-btn{padding-inline:12px}
    .sd-cockpit__stage{height:410px}
  }
  @media(prefers-reduced-motion:reduce){
    .sd-pulse-dot,.sd-wire-line,.sd-scene,.sd-phase-bar{animation:none}
    .sd-scene--blueprint{opacity:1;position:static}
    .sd-scene--code,.sd-scene--vitals,.sd-scene--search{display:none}
    .sd-btn{transition:none}
  }
</style>
