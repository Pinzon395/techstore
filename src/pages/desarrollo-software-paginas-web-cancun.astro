  .sd-btn--primary{background:var(--sd-blue);color:#fff!important;box-shadow:0 10px 24px -12px rgba(20,121,212,.9)}
  .sd-btn--ghost{border-color:rgba(255,255,255,.32);background:rgba(255,255,255,.07);color:#fff!important}
  .sd-btn--plain{border-color:rgba(255,255,255,.2);background:transparent;color:#dcecf7!important}
  .sd-btn--light{background:#fff;color:var(--sd-ink)!important}
  .sd-btn:focus-visible,.sd-section-nav a:focus-visible,.sd-link:focus-visible{outline:3px solid var(--sd-cyan);outline-offset:3px}
  .sd-btn:active{transform:scale(.98)}

  /* Trust row horizontal */
  .sd-trust-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:28px;max-width:620px}
  .sd-trust-card{display:flex;align-items:center;gap:12px;padding:10px 14px;border:1px solid rgba(255,255,255,.12);border-radius:10px;background:rgba(255,255,255,.05);backdrop-filter:blur(6px)}
  .sd-trust-card__num{display:grid;place-items:center;width:28px;height:28px;border-radius:6px;background:rgba(20,121,212,.3);color:#bce0fb!important;font-size:.74rem;font-weight:900;flex:0 0 auto}
