                </div>
            </div>
        </div>
    </section>
    <!-- ═══ NUEVA SECCIÓN 1: MANTENIMIENTO PROFESIONAL - LAYOUT SPLIT PREMIUM ═══ -->
    <section class="section-padding svc-full-section dark-premium-section" style="background:#030719;">
        <!-- Añadimos un pseudo-elemento o divisor suave si es necesario, pero el fondo sólido soluciona el texto invisible -->
