---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FaqSection from '../components/FaqSection.astro';
import CommentsSection from '../components/CommentsSection.astro';

const faqs = [
  { question: '¿Reparan joystick drift de PS5 / Xbox / Switch?', answer: 'Sí. Reparamos drift en DualSense (PS5), DualShock 4 (PS4), Xbox Series X/S, Xbox One y Joy-Con de Nintendo Switch. Reemplazamos el módulo de joystick original o instalamos versión mejorada anti-drift.' },
  { question: '¿Cuánto cuesta reparar un control?', answer: '<strong>$450 a $850 MXN</strong> según consola y daño. Joystick drift simple: $450. Reemplazo de gatillos, botones o reparación de placa: hasta $850. Cotización exacta sin compromiso al diagnóstico.' },
  { question: '¿Cuánto tarda la reparación?', answer: '24 a 72 horas dependiendo de stock de piezas. Joystick drift estándar lo entregamos al día siguiente. Reparaciones de placa o piezas especiales pueden tomar 5-7 días.' },
  { question: '¿Hay garantía?', answer: 'Sí. <strong>3 meses por escrito</strong> sobre la reparación. Si el módulo nuevo presenta drift dentro de ese plazo, lo reemplazamos sin costo.' },
];
---

<Base
