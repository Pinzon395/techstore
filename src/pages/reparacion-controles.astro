---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ServiceTicketSection from '../components/ServiceTicketSection.astro';
import FaqSection from '../components/FaqSection.astro';
import CommentsSection from '../components/CommentsSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/LocalSpriteIcon.astro';

const canonical = '/reparacion-controles';
const whatsappMsg = encodeURIComponent('Hola Pixon PC, quiero cotizar la reparación de mi control (Drift / Botones / Puerto de carga / Batería) en Cancún.');

const faqs = [
  {
    question: '¿Reparan joystick drift de PS5, Xbox y Nintendo Switch en Cancún?',
    answer: 'Sí. Diagnosticamos y reparamos el molesto stick drift en controles DualSense de PS5, DualShock 4 de PS4, Xbox Series X/S, Xbox One (incluyendo modelos Elite) y Joy-Con o Pro Controller de Nintendo Switch. Instalamos potenciómetros de precisión ALPS o sensores electromagnéticos de Efecto Hall.'
  },
  {
    question: '¿Cuánto cuesta reparar un control de consola en Cancún?',
    answer: 'El costo varía según el modelo de control y la falla. Una reparación estándar de joystick drift o sustitución de micro-switches RB/LB / L1/R1 suele ir de $450 a $850 MXN. Si requiere reemplazo de batería, reparación de pista o puerto USB-C, te damos cotización exacta tras el diagnóstico gratis.'
  },
  {
    question: '¿Cuánto tiempo tarda la reparación de un control?',
    answer: 'En Pixon PC Cancún realizamos el servicio en un lapso de 24 a 48 horas. Contamos con stock continuo de refacciones ALPS, botones RB/LB, membranas, resortes y conectores USB-C para que no te quedes días sin jugar.'
  },
  {
    question: '¿Ofrecen garantía por la reparación del mando?',
    answer: 'Sí, otorgamos 3 meses de garantía por escrito en todas las intervenciones de hardware. Si el módulo reemplazado presenta alguna desviación en la zona muerta durante el plazo de garantía, lo reajustamos o cambiamos sin costo.'
  },
  {
    question: '¿Qué diferencia hay entre potenciómetros ALPS y sensores Effect Hall?',
    answer: 'Los potenciómetros ALPS son los módulos analógicos originales de fábrica que utilizan carbón conductivo. Los sensores de Efecto Hall utilizan imanes magnéticos sin contacto físico, lo que elimina el desgaste mecánico y previene la aparición de drift a futuro.'
  },
  {
    question: '¿Reparan controles de ediciones especiales o Elite?',
    answer: 'Sí. Atendemos controles Xbox Elite Series 1 y 2, DualSense Edge, controles de edición especial (Halo, Zelda, Spider-Man, Starfield, etc.) cuidando minuciosamente la estética, clips y carcasas para no dejar marcas de apertura.'
  },
  {
    question: '¿Qué incluye la limpieza ultrasónica y mantenimiento preventivo?',
    answer: 'Desarmamos completamente el mando, lavamos carcasas y membranas en tina ultrasónica, desinfectamos la suciedad del sudor acumulado, aplicamos alcohol isopropílico técnico en la tarjeta lógica y lubricamos los ejes del joystick.'
  },
  {
    question: '¿Es necesario llevar la consola al taller o solo el control?',
    answer: 'Solo necesitas traer tu control. En nuestro taller contamos con consolas de prueba de cada marca (PS5, PS4, Xbox Series, Switch) y software de calibración por computadora para probar cada botón y eje analógico.'
  }
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `https://pixon.com.mx${canonical}`
    },
    headline: 'Reparación de Controles Xbox, PlayStation y Nintendo en Cancún',
    description: 'Servicio técnico especializado en reparación de controles en Cancún. Joystick drift, botones RB/LB L1/R1, puertos USB-C, baterías y mantenimiento preventivo.',
    image: 'https://pixon.com.mx/assets/images/responsive/gaming_controllers_collection.webp',
    author: {
      '@type': 'Organization',
      name: 'Pixon PC',
      url: 'https://pixon.com.mx'
    },
    publisher: {
      '@type': 'Organization',
      name: 'Pixon PC',
      logo: {
        '@type': 'ImageObject',
        url: 'https://pixon.com.mx/assets/images/LOGOCIRCULAR.png'
      }
    },
    datePublished: '2026-08-03'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Reparación de Controles en Cancún',
    serviceType: 'Reparación de Joystick Drift, Botones, Puerto de Carga y Baterías de Controles',
    url: `https://pixon.com.mx${canonical}`,
    description: 'Taller especializado en reparación de mandos DualSense PS5, DualShock 4, Xbox Series, Xbox One, Nintendo Switch Joy-Con y Pro Controller en Cancún.',
    provider: {
      '@type': 'LocalBusiness',
      name: 'Pixon PC',
      telephone: '+529986690777',
      email: 'pixonpc@gmail.com',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Cto. Hacienda Chimay',
        addressLocality: 'Cancún',
        addressRegion: 'Q.R.',
        postalCode: '77539',
        addressCountry: 'MX'
      }
    },
    areaServed: [{ '@type': 'City', name: 'Cancún' }, { '@type': 'State', name: 'Quintana Roo' }]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer }
    }))
  }
];
---

<Base
  title="Reparación de Controles en Cancún | Drift, Botones y Batería Pixon PC"
  description="Servicio técnico especializado en reparación de controles Xbox, PlayStation y Nintendo en Cancún. Joystick drift ALPS/Hall Effect, botones RB/LB L1/R1, puertos USB-C y baterías."
  canonical={canonical}
  image="/assets/images/responsive/gaming_controllers_collection.webp"
  schema={schema}
  bodyClass="service-page ctrl-page"
>
  <Navbar />
  <Breadcrumb items={[
    { label: 'Inicio', href: '/' },
    { label: 'Servicios', href: '/servicios' },
    { label: 'Consolas', href: '/servicios/consola' },
    { label: 'Reparación de Controles' }
  ]} />

  <!-- HERO PRINCIPAL (H1 ÚNICO EN LA PÁGINA) -->
  <header class="tc-hero">
    <img src="/assets/images/responsive/gaming_controllers_collection.webp" alt="Reparación de controles Xbox PlayStation y Nintendo Switch en Cancún" width="1600" height="900" loading="eager" />
    <div class="tc-hero__shade"></div>
    <div class="tc-shell tc-hero__content">
      <span class="tc-kicker"><i class="fa-solid fa-gamepad"></i> Taller Especializado en Cancún</span>
      <h1>Reparación de Controles Xbox, PlayStation y Nintendo en Cancún</h1>
      <p class="hero-lead">
        ¿Tu control se mueve solo, los botones no responden o dejó de cargar? En <strong>Pixon PC Cancún</strong> solucionamos el joystick drift, botones RB/LB, L1/R1, gatillos, puertos USB-C y baterías degradadas con refacciones ALPS de alta precisión y sensores de Efecto Hall.
      </p>
      <div class="tc-actions">
        <a class="tc-btn" href={`https://wa.me/529986690777?text=${whatsappMsg}`} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" /> Cotizar por WhatsApp
        </a>
        <a class="tc-btn tc-btn--ghost" href="#ticket-control">
          <Icon name="clipboard-list" /> Crear ticket de revisión
        </a>
      </div>
      <dl class="tc-hero__facts">
        <div><dt>Soporte</dt><dd>PS5, PS4, Xbox Series, One, Switch</dd></div>
        <div><dt>Tecnología</dt><dd>Módulos ALPS / Efecto Hall Magnético</dd></div>
        <div><dt>Garantía</dt><dd>3 meses por escrito en taller físico</dd></div>
      </dl>
    </div>
  </header>

  <main class="tc-main">

    <!-- SECCIÓN DE SERVICIOS PRINCIPALES (REQUERIDA CON TEXTOS Y AZUL OSCURO #071F3A) -->
    <section class="tc-section tc-services-overview">
      <div class="tc-shell">
        <header class="tc-heading">
          <Icon name="screwdriver-wrench" />
          <div>
            <h2>Diagnóstico y Reparación de Controles: Fallas Comunes</h2>
            <p>Solucionamos los problemas de hardware más frecuentes en controles gamer de todas las generaciones en Cancún.</p>
          </div>
        </header>

        <div class="ctrl-grid-cards">
          
          <!-- Joystick Drift -->
          <article class="ctrl-card">
            <div class="ctrl-card__icon"><i class="fa-solid fa-gamepad"></i></div>
            <h3>Reparación de Joystick Drift en Cancún</h3>
            <p>
              El personaje se mueve solo o la cámara gira sin que lo toques. Es el clásico <strong>stick drift</strong>, causado por el desgaste del potenciómetro analógico. Lo reemplazamos por uno de calidad ALPS y tu control vuelve a tener precisión milimétrica.
            </p>
          </article>

          <!-- Botones RB/LB y L1/R1 -->
          <article class="ctrl-card">
            <div class="ctrl-card__icon"><i class="fa-regular fa-circle-dot"></i></div>
            <h3>Reparación de Botones RB/LB y L1/R1</h3>
            <p>
              Los bumpers son los que más sufren el uso intenso. Si tus disparos fallan o el RB/LB de Xbox o L1/R1 de PlayStation ya no registra, cambiamos los micro-switches o las piezas plásticas dañadas para que nunca más pierdas una partida por culpa del control.
            </p>
          </article>

          <!-- Puerto de Carga -->
          <article class="ctrl-card">
            <div class="ctrl-card__icon"><i class="fa-solid fa-plug"></i></div>
            <h3>Reparación de Puerto de Carga USB-C / Micro-USB</h3>
            <p>
              ¿Solo prende si acomodas el cable en cierto ángulo? Reparamos o sustituimos el conector USB-C o Micro-USB directamente en la placa. Solución definitiva, sin parches temporales.
            </p>
          </article>

          <!-- Reemplazo de Batería -->
          <article class="ctrl-card">
            <div class="ctrl-card__icon"><i class="fa-solid fa-battery-half"></i></div>
            <h3>Reemplazo y Cambio de Batería de Control</h3>
            <p>
              Una batería degradada que no retiene la carga arruina la experiencia de juego. Instalamos baterías de ciclo completo compatibles con tu modelo de control para que dure toda la sesión sin interrupciones.
            </p>
          </article>

          <!-- Limpieza Ultrasónica -->
          <article class="ctrl-card">
            <div class="ctrl-card__icon"><i class="fa-solid fa-broom"></i></div>
            <h3>Limpieza Ultrasónica y Mantenimiento Preventivo</h3>
            <p>
              El sudor, el polvo y los residuos atrapados en las membranas hacen que los botones se peguen o pierdan sensibilidad. Nuestro mantenimiento preventivo alarga significativamente la vida de tu mando.
            </p>
          </article>

          <!-- Reparación de Gatillos -->
          <article class="ctrl-card">
            <div class="ctrl-card__icon"><i class="fa-solid fa-gun"></i></div>
            <h3>Reparación de Gatillos (Triggers) y Palancas</h3>
            <p>
              Gatillos con resistencia irregular, que se traban o regresan solos son un problema frecuente en controles de alto uso. Reemplazamos resortes, ejes y piezas internas para restaurar la respuesta original de los triggers.
            </p>
          </article>

        </div>
      </div>
    </section>

    <!-- TECNOLOGÍA MÓDULOS: ALPS VS HALL EFFECT -->
    <section class="tc-section tc-tech-comparison">
      <div class="tc-shell tc-split">
        <div class="tc-copy">
          <span class="tc-icon"><Icon name="microchip" /></span>
          <h2>Innovación en Reparaciones: Sensores de Efecto Hall vs. ALPS</h2>
          <h3>¿Por qué aparece el Stick Drift y cómo lo solucionamos?</h3>
          <p>
            Los controles de fábrica (DualSense, Xbox Series, Joy-Con) utilizan potenciómetros analógicos mecánicos. Con la fricción continua de las partidas, la pista de carbón interna se desgasta, dejando residuos que envían señales falsas al procesador.
          </p>
          <p>En Pixon PC Cancún te ofrecemos dos alternativas de reparación según tu presupuesto y nivel competitivo:</p>
          <ul class="custom-checklist">
            <li><i class="fa-solid fa-check"></i> <strong>Módulos Analógicos ALPS OEM:</strong> Mismas especificaciones de fábrica, ideales para restaurar el tacto y precisión original del mando.</li>
            <li><i class="fa-solid fa-check"></i> <strong>Joysticks de Efecto Hall (Magnéticos):</strong> Tecnología sin contacto físico que utiliza sensores electromagnéticos. ¡Olvídate del drift para siempre!</li>
          </ul>
        </div>
        <figure class="tc-media">
          <img src="/assets/images/responsive/control_repair_workshop.webp" alt="Taller de calibración de potenciómetros y sticks de control en Cancún" width="800" height="600" loading="lazy" />
          <figcaption>Reemplazamos módulos con calibración por software para garantizar zona muerta de 0% a 3%.</figcaption>
        </figure>
      </div>
    </section>

    <!-- SECCIÓN POR CONSOLA (DESGLOSE XBOX, PLAYSTATION, NINTENDO) -->
    <section class="tc-section tc-consoles-breakdown">
      <div class="tc-shell">
        <header class="tc-heading">
          <Icon name="gamepad" />
          <div>
            <h2>Reparación Especializada por Marca y Modelo de Consola</h2>
            <p>Atendemos de manera específica la arquitectura electrónica de cada mando gamer en Cancún.</p>
          </div>
        </header>

        <div class="models-grid">
          
          <!-- Xbox -->
          <div class="model-card">
            <div class="model-badge">Xbox Series X/S · One · Elite</div>
            <h3>Reparación de Controles Xbox en Cancún</h3>
            <p>
              Los mandos de Xbox suelen sufrir desgaste prematuro en los micro-switches táctiles de los bumpers RB/LB y drift en el stick izquierdo por uso frecuente en juegos de disparos y carreras.
            </p>
            <ul class="mini-checklist">
              <li><i class="fa-solid fa-circle-chevron-right"></i> Cambio de potenciómetro analógico o Hall Effect.</li>
              <li><i class="fa-solid fa-circle-chevron-right"></i> Sustitución de micro-switches RB y LB.</li>
              <li><i class="fa-solid fa-circle-chevron-right"></i> Reparación de puerto USB-C / Micro-USB desoldado.</li>
              <li><i class="fa-solid fa-circle-chevron-right"></i> Mantenimiento a gatillos LT/RT impulsivos.</li>
              <li><i class="fa-solid fa-circle-chevron-right"></i> Reparación de fallas en controles Xbox Elite 1 y 2.</li>
            </ul>
          </div>

          <!-- PlayStation -->
          <div class="model-card">
            <div class="model-badge">DualSense PS5 · DualShock 4</div>
            <h3>Reparación de Controles PlayStation en Cancún</h3>
            <p>
              El mando DualSense de PS5 incluye motores de vibración háptica y gatillos adaptativos mecánicos muy sensibles. La acumulación de sudor o caídas puede desalinear sus engranes internos.
            </p>
            <ul class="mini-checklist">
              <li><i class="fa-solid fa-circle-chevron-right"></i> Solución a stick drift en DualSense y DualShock 4.</li>
              <li><i class="fa-solid fa-circle-chevron-right"></i> Reemplazo de resortes y engranes de gatillos L2/R2.</li>
              <li><i class="fa-solid fa-circle-chevron-right"></i> Cambio de batería interna de litio de alta duración.</li>
              <li><i class="fa-solid fa-circle-chevron-right"></i> Reparación de puerto USB-C que no transfiere carga.</li>
              <li><i class="fa-solid fa-circle-chevron-right"></i> Limpieza ultrasónica de membranas de silicona.</li>
            </ul>
          </div>

          <!-- Nintendo Switch -->
          <div class="model-card">
            <div class="model-badge">Joy-Con · Switch OLED · Pro Controller</div>
            <h3>Reparación de Controles Nintendo Switch</h3>
            <p>
              Los Joy-Con de la Nintendo Switch son propensos al drift debido a sus potenciómetros de bajo perfil. También reparamos rieles de acoplamiento laterales y botones SL/SR.
            </p>
            <ul class="mini-checklist">
              <li><i class="fa-solid fa-circle-chevron-right"></i> Sustitución de palancas 3D Joy-Con anti-drift.</li>
              <li><i class="fa-solid fa-circle-chevron-right"></i> Cambio de flex de rieles de conexión laterales.</li>
              <li><i class="fa-solid fa-circle-chevron-right"></i> Reparación de botones SL/SR y LED indicadores.</li>
              <li><i class="fa-solid fa-circle-chevron-right"></i> Solución a fallas de batería en Joy-Con (L/R).</li>
              <li><i class="fa-solid fa-circle-chevron-right"></i> Reparación de joystick y botones en Switch Pro Controller.</li>
            </ul>
          </div>

        </div>
      </div>
    </section>

    <!-- PROCESO DE DIAGNÓSTICO EN 5 PASOS -->
    <section class="tc-section tc-process-section">
      <div class="tc-shell">
        <header class="tc-heading">
          <Icon name="list-check" />
          <div>
            <h2>Proceso de Diagnóstico y Calibración de Controles</h2>
            <p>Cinco pasos técnicos rigorosos para garantizar que tu mando regrese con respuesta perfecta.</p>
          </div>
        </header>
        <div class="tc-process-grid">
          <div class="tc-step-box">
            <span class="step-num">01</span>
            <h3>Prueba de Zona Muerta</h3>
            <p>Conectamos el mando a un probador de ejes por computadora para medir el porcentaje de drift y la respuesta de cada botón.</p>
          </div>
          <div class="tc-step-box">
            <span class="step-num">02</span>
            <h3>Apertura ESD Segura</h3>
            <p>Desarmamos la carcasa utilizando palancas plásticas antiestáticas para conservar clips internos y evitar marcas en la estructura.</p>
          </div>
          <div class="tc-step-box">
            <span class="step-num">03</span>
            <h3>Desoldadura y Reemplazo</h3>
            <p>Retiramos el módulo o micro-switch defectuoso con estación de aire caliente e instalamos el componente nuevo ALPS o Hall Effect.</p>
          </div>
          <div class="tc-step-box">
            <span class="step-num">04</span>
            <h3>Limpieza Ultrasónica</h3>
            <p>Lavamos carcasas, membranas y botones retirando sudor, grasa y suciedad acumulada para devolver la sensibilidad táctil.</p>
          </div>
          <div class="tc-step-box">
            <span class="step-num">05</span>
            <h3>Calibración y Pruebas</h3>
            <p>Re-calibramos el centro del analógico vía software y probamos la consola jugando durante 30 minutos continuos antes de la entrega.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- TABLA COMPARATIVA: REPARAR VS COMPRAR CONTROL NUEVO -->
    <section class="tc-section tc-comparison">
      <div class="tc-shell">
        <header class="tc-heading">
          <Icon name="scale-balanced" />
          <div>
            <h2>¿Conviene reparar tu control o comprar uno nuevo en Cancún?</h2>
            <p>Compara las ventajas económicas y de durabilidad de nuestro servicio técnico especializado.</p>
          </div>
        </header>
        <div class="tc-table-wrap">
          <table>
            <thead>
              <tr>
                <th>Factor</th>
                <th>Reparación Profesional en Pixon PC</th>
                <th>Comprar Control Nuevo</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Costo promedio</strong></td>
                <td>$450 – $850 MXN (Ahorro del 60% al 70%)</td>
                <td>$1,500 – $2,200 MXN (Precios de mandos originales)</td>
              </tr>
              <tr>
                <td><strong>Durabilidad de Sticks</strong></td>
                <td>Opción de instalar Efecto Hall (imanes anti-drift)</td>
                <td>Módulos de fábrica propensos a volver a tener drift</td>
              </tr>
              <tr>
                <td><strong>Ediciones Especiales</strong></td>
                <td>Conservas tu edición limitada o mando personalizado</td>
                <td>Diffíciles de conseguir o a sobreprecio en reventa</td>
              </tr>
              <tr>
                <td><strong>Garantía</strong></td>
                <td>3 meses por escrito directamente en Cancún</td>
                <td>Garantía limitada de tienda que exige envíos largos</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="tc-note">
          <strong>Recomendación Pixon PC:</strong> En el 90% de los casos, reparar tu control con un módulo nuevo de calidad ALPS o Efecto Hall es la alternativa más inteligente, duradera y económica.
        </p>
      </div>
    </section>

    <!-- COBERTURA LOCAL Y NAP CONSISTENTE (AZUL OSCURO #071F3A FUERA DEL HERO) -->
    <section class="tc-section tc-b2b">
      <div class="tc-shell tc-b2b__grid">
        <div>
          <span class="tc-icon tc-icon--dark"><Icon name="location-dot" /></span>
          <h2>Servicio técnico de controles cerca de ti en Cancún</h2>
          <h3>Atención rápida en taller físico y recolección disponible</h3>
          <p>
            Reparamos mandos de consolas para gamers y familias en todo Cancún: Cancún Centro, Zona Hotelera, Huayacán, Cumbres, Bonfil, Polígono Sur, Puerto Cancún, Av. Tulum, Bonampak, Puerto Juárez, Supermanzanas y Haciendas.
          </p>
          <p>
            No dejes que un botón atascado o el drift arruinen tus partidas. Tráenos tu control o contáctanos por WhatsApp para resolverlo hoy mismo.
          </p>
        </div>
        <aside>
          <strong>Pixon PC — Taller Cancún</strong>
          <span>Cto. Hacienda Chimay, 77539 Cancún, Q.R.</span>
          <a href="tel:+529986690777">+52 998 669 0777</a>
          <a href="mailto:pixonpc@gmail.com">pixonpc@gmail.com</a>
        </aside>
      </div>
    </section>

    <!-- FORMULARIO DE TICKET DE REVISIÓN -->
    <ServiceTicketSection
      id="ticket-control"
      defaultDevice="Control de consola (PS5 / Xbox / Switch)"
      defaultService="Reparación de joystick drift y botones"
      title="Crear ticket de revisión para control"
      subtitle="Escribe el modelo de tu mando y la falla que presenta (drift, botones, batería, puerto) para darte un presupuesto exacto."
    />

    <!-- PREGUNTAS FRECUENTES -->
    <FaqSection
      id="faq-controles"
      title="Preguntas frecuentes sobre reparación de controles en Cancún"
      description="Respuestas directas a las inquietudes más comunes sobre joystick drift, piezas y tiempos de entrega."
      items={faqs}
      viewMoreHref="/preguntas-frecuentes"
      viewMoreLabel="Ver todas las preguntas de consolas"
      ariaLabel="Preguntas frecuentes sobre reparación de controles en Cancún"
      backgroundColor="#f3f8fc"
      titleColor="#071F3A"
      descriptionColor="#294963"
      questionColor="#071F3A"
    />

    <!-- RESEÑAS DE CLIENTES -->
    <section class="tc-section tc-reviews">
      <div class="tc-shell">
        <header class="tc-heading">
          <Icon name="star" />
          <div>
            <h2>Gamers que repararon su control con Pixon PC en Cancún</h2>
            <p>Opiniones reales sobre nuestro servicio técnico de mandos Xbox, PlayStation y Nintendo.</p>
          </div>
        </header>
      </div>
    </section>
    <CommentsSection viewMoreHref="/comentarios" />

    <!-- CIERRE FINAL Y CONTACTO -->
    <section class="tc-final">
      <div class="tc-shell tc-final__grid">
        <div>
          <span>Precisión milimétrica restaurada</span>
          <h2>Recupera el control de tus juegos con Pixon PC Cancún</h2>
