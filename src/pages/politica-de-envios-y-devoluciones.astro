---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Footer from '../components/Footer.astro';

const updated = '21 de agosto de 2026';
const faqs = [
  {
    question: '¿La entrega a domicilio tiene costo en Cancún?',
    answer: 'No. La entrega en taller y la recolección o entrega a domicilio dentro de Cancún y el municipio de Benito Juárez no tienen costo adicional de envío.',
  },
  {
    question: '¿Qué debo confirmar antes de comprar un artículo?',
    answer: 'Antes de confirmar, validamos disponibilidad, condición, accesorios, compatibilidad, precio y la cobertura aplicable. Conserva tu comprobante de compra y cualquier condición documentada.',
  },
  {
    question: '¿Cómo se atiende una falla posterior al servicio?',
    answer: 'Una falla atribuible al trabajo o a una refacción instalada se revisa conforme a la política de garantía y al alcance documentado en el diagnóstico o comprobante de servicio.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Condiciones de entrega y garantía — Pixon PC',
    url: 'https://pixon.com.mx/politica-de-envios-y-devoluciones',
    dateModified: '2026-08-21',
    description: 'Condiciones de entrega, recolección y garantía de Pixon PC en Cancún.',
    publisher: { '@id': 'https://pixon.com.mx/#business' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<Base
  title="Condiciones de entrega y garantía | Pixon PC Cancún"
  description="Consulta las condiciones de entrega, recolección y garantía de Pixon PC en Cancún."
  canonical="/politica-de-envios-y-devoluciones"
  schema={schema}
>
  <Navbar />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Entregas y garantía' }]} />
  <main class="legal-page" id="envios-y-devoluciones">
    <div class="legal-container">
      <article class="legal-card">
        <h1>Condiciones de entrega y garantía</h1>
        <p class="legal-last-update">Última actualización: <strong>{updated}</strong></p>

        <h2>1. Entrega y recolección en Cancún</h2>
        <p>La entrega en taller y la recolección o entrega a domicilio dentro de Cancún y el municipio de Benito Juárez no generan un costo adicional de envío. La hora de atención se confirma antes de programar cualquier visita.</p>

        <h2>2. Tiempo de coordinación</h2>
        <p>La coordinación habitual se realiza el mismo día o al siguiente día hábil, según disponibilidad, horario y diagnóstico. No prometemos una fecha de reparación o entrega sin revisar el caso y confirmar refacciones cuando correspondan.</p>

        <h2>3. Confirmación de compra</h2>
        <p>Antes de confirmar una compra validamos disponibilidad, condición, accesorios, compatibilidad, precio y la cobertura que aplique al artículo. Conserva tu comprobante y las condiciones documentadas al momento de la entrega.</p>

        <h2>4. Servicios y garantía</h2>
        <p>Si existe una falla atribuible al trabajo o a una refacción instalada, se atiende conforme a la <a href="/politica-de-garantia">política de garantía</a> y al alcance documentado para el servicio.</p>

        <h2>5. Cómo solicitarlo</h2>
        <p>Escríbenos por <a href="https://wa.me/529986690777?text=Hola%20Pixon%20PC%2C%20quiero%20consultar%20una%20entrega%20o%20garantia." target="_blank" rel="noopener noreferrer">WhatsApp</a> con tu nombre, comprobante y una descripción breve. Te confirmaremos el siguiente paso antes de que lleves el artículo o coordinemos una visita.</p>

        <section class="warranty-faq" aria-label="Preguntas frecuentes de entregas y garantía">
          {faqs.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </section>
      </article>
    </div>
  </main>
  <Footer />
</Base>
