    height: auto;
    overflow: visible;
  }

  .lc-ship-path-active {
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
    animation: lc-shipping-route 12s ease-in-out infinite;
  }
  .lc-ship-courier {
    animation: lc-shipping-courier-travel 12s cubic-bezier(0.3, 0.05, 0.2, 1) infinite;
  }

  @keyframes lc-shipping-route {
    0%, 10% { stroke-dashoffset: 200; opacity: 0.2; }
    25%, 85% { stroke-dashoffset: 0; opacity: 1; }
    95%, 100% { stroke-dashoffset: -200; opacity: 0.2; }
  }
  @keyframes lc-shipping-courier-travel {
    0%, 10% { transform: translate(60px, 90px); }
    40%, 80% { transform: translate(460px, 90px); }
    95%, 100% { transform: translate(660px, 90px); }
  }

  .lapclean-card--dark {
    background: rgba(14, 45, 75, 0.65);
    border-color: rgba(56, 189, 248, 0.22);
