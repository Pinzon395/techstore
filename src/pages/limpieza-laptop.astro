  /* SVG Motion Graphics Elements (13-second loop) */
  .lc-screen-display {
    animation: lc-screen-glow-fx 13s ease-in-out infinite;
  }
  .lc-bottom-cover {
    transform-origin: center bottom;
    animation: lc-cover-explode 13s cubic-bezier(0.3, 0.05, 0.2, 1) infinite;
  }
  .lc-scanner-line {
    animation: lc-scan-sweep 13s ease-in-out infinite;
  }
  .lc-dust-particles {
    animation: lc-dust-blow 13s cubic-bezier(0.2, 0.7, 0.3, 1) infinite;
  }
  .lc-fan-blades {
    transform-box: fill-box;
    transform-origin: center;
    animation: lc-fans-spin 13s linear infinite;
  }
  .lc-thermal-die {
    animation: lc-thermal-compound-fx 13s ease-in-out infinite;
  }
  .lc-fin-block {
    animation: lc-fins-contrast 13s ease-in-out infinite;
  }
  .lc-air-stream {
    stroke-dasharray: 30 60;
    stroke-dashoffset: 90;
    animation: lc-airflow-run 13s linear infinite;
  }
  .lc-air-stream--2 { animation-delay: 90ms; }
  .lc-air-stream--3 { animation-delay: 180ms; }
  .lc-air-stream--4 { animation-delay: 120ms; }

  .lc-sheen-rect {
    animation: lc-sheen-sweep-fx 13s ease-in-out infinite;
  }
  .lc-sparkle {
    transform-box: fill-box;
    transform-origin: center;
    animation: lc-sparkle-fx 13s ease-in-out infinite;
  }
  .lc-sparkle--2 { animation-delay: 140ms; }
  .lc-success-badge {
    transform-box: fill-box;
    transform-origin: center;
    animation: lc-check-pop-fx 13s cubic-bezier(0.18, 0.9, 0.32, 1.25) infinite;
  }

  /* 8-Stage Keyframes Definitions */
  @keyframes lc-screen-glow-fx {
    0%, 40% { opacity: 0.65; }
    50%, 94% { opacity: 0.95; }
    98%, 100% { opacity: 0.65; }
  }

  /* Exploded View (15% - 30% lifts up, 76% - 87% fits back down) */
  @keyframes lc-cover-explode {
    0%, 14% { transform: translateY(0) scale(1); opacity: 0.95; }
    22%, 74% { transform: translateY(58px) scale(0.92); opacity: 0.15; }
    82%, 100% { transform: translateY(0) scale(1); opacity: 0.95; }
  }

  /* Diagnostic Scanner Line (30% - 40%) */
  @keyframes lc-scan-sweep {
    0%, 29% { opacity: 0; transform: translateY(-30px); }
    31% { opacity: 0.95; }
    38% { opacity: 0.95; transform: translateY(40px); }
    40%, 100% { opacity: 0; transform: translateY(45px); }
  }

  /* Dust Particles Cleared (40% - 65%) */
  @keyframes lc-dust-blow {
    0%, 39% { opacity: 0.95; transform: translate(0, 0) scale(1); }
    48% { opacity: 0.8; transform: translate(16px, -18px) scale(0.85); }
    58% { opacity: 0.3; transform: translate(42px, -36px) scale(0.45); }
    64%, 100% { opacity: 0; transform: translate(60px, -50px) scale(0); }
  }

  /* Fans Rotation */
  @keyframes lc-fans-spin {
    0%, 38% { transform: rotate(0deg); }
    42% { transform: rotate(180deg); }
    65% { transform: rotate(2520deg); }
    88%, 94% { transform: rotate(3240deg); }
    98%, 100% { transform: rotate(3420deg); }
  }

  /* Thermal Compound Color Shift (65% - 76%) */
  @keyframes lc-thermal-compound-fx {
    0%, 62% { stroke: #f59e0b; fill: #0b375b; }
    66%, 74% { stroke: #10b981; fill: #064e3b; }
    78%, 94% { stroke: #22d3ee; fill: #07355c; }
    98%, 100% { stroke: #f59e0b; fill: #0b375b; }
  }

  /* Heatsink Fin Contrast */
  @keyframes lc-fins-contrast {
    0%, 40% { stroke: #f59e0b; }
    55%, 94% { stroke: #38bdf8; }
    98%, 100% { stroke: #f59e0b; }
  }

  /* Airflow Streams */
  @keyframes lc-airflow-run {
    0%, 41% { opacity: 0; stroke-dashoffset: 90; }
    46% { opacity: 0.95; }
    82% { opacity: 0.95; stroke-dashoffset: -90; }
    88%, 100% { opacity: 0; stroke-dashoffset: -120; }
  }

  /* Sheen Sweep across Laptop (94% - 100%) */
  @keyframes lc-sheen-sweep-fx {
    0%, 93% { opacity: 0; transform: translateX(-180px) skewX(-20deg); }
    95% { opacity: 0.8; }
    98% { opacity: 0.8; transform: translateX(180px) skewX(-20deg); }
    100% { opacity: 0; transform: translateX(200px) skewX(-20deg); }
  }

  /* Corner Sparkles */
  @keyframes lc-sparkle-fx {
    0%, 93% { opacity: 0; transform: scale(0.2); }
    95%, 98% { opacity: 1; transform: scale(1.3) rotate(15deg); }
    100% { opacity: 0; transform: scale(0.2); }
  }

  /* Success Ready Check Badge Pop */
  @keyframes lc-check-pop-fx {
    0%, 93% { opacity: 0; transform: translateY(8px) scale(0.4); }
    95% { opacity: 1; transform: translateY(-3px) scale(1.15); }
    97%, 99% { opacity: 1; transform: translateY(0) scale(1); }
    100% { opacity: 0; transform: translateY(-3px) scale(0.85); }
  }

  /* 5-Step Process Timeline Container */
  .service-process {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
    margin: 4px 0 0;
    padding: 14px 10px 12px;
    list-style: none;
    background: rgba(6, 26, 48, 0.65);
    border: 1px solid rgba(56, 189, 248, 0.22);
    border-radius: 16px;
    backdrop-filter: blur(10px);
  }

  .service-process::before {
    position: absolute;
    top: 22px;
    left: 36px;
    right: 36px;
    height: 3px;
    content: '';
    background: rgba(14, 61, 102, 0.85);
    border-radius: 2px;
    z-index: 1;
  }

  .service-process::after {
    position: absolute;
    top: 22px;
    left: 36px;
    right: 36px;
    height: 3px;
    content: '';
    background: linear-gradient(90deg, #38bdf8, #22d3ee, #10b981);
    border-radius: 2px;
    z-index: 1;
    transform-origin: left;
    animation: lc-line-progress 13s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .process-step {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 2px;
    opacity: 0.55;
    transform: translateY(2px);
    transition: opacity 250ms ease, transform 250ms ease;
  }

  .process-step__indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-bottom: 5px;
  }

  .process-step__dot {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: #092644;
    border: 2.5px solid #1a517e;
    box-shadow: 0 0 0 3px rgba(6, 26, 48, 0.9);
    transition: background 250ms ease, border-color 250ms ease;
  }

  .process-step__num {
    color: #7dd3fc;
    font-family: monospace;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .process-step__info {
    min-width: 0;
    width: 100%;
  }
  .process-step__info strong {
    display: block;
    color: #ffffff;
    font-family: 'Kanit', sans-serif;
    font-size: 0.76rem;
    font-weight: 800;
    line-height: 1.15;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .process-step__info p {
    margin: 2px 0 0;
    color: #cbe9f4;
    font-size: 0.66rem;
    line-height: 1.25;
  }

  /* Timeline Sync Keyframes */
  @keyframes lc-line-progress {
    0%, 14% { transform: scaleX(0); }
    15%, 38% { transform: scaleX(0.25); }
    40%, 64% { transform: scaleX(0.5); }
    65%, 86% { transform: scaleX(0.75); }
    88%, 96% { transform: scaleX(1); }
    98%, 100% { transform: scaleX(0); }
  }

  .process-step--1 { animation: lc-step1-sync 13s ease-in-out infinite; }
  .process-step--2 { animation: lc-step2-sync 13s ease-in-out infinite; }
  .process-step--3 { animation: lc-step3-sync 13s ease-in-out infinite; }
  .process-step--4 { animation: lc-step4-sync 13s ease-in-out infinite; }
  .process-step--5 { animation: lc-step5-sync 13s ease-in-out infinite; }

  @keyframes lc-step1-sync {
    0%, 14% { opacity: 1; transform: translateY(0); }
    16%, 96% { opacity: 0.55; transform: translateY(2px); }
    98%, 100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes lc-step2-sync {
    0%, 14% { opacity: 0.55; transform: translateY(2px); }
    16%, 38% { opacity: 1; transform: translateY(0); }
    40%, 100% { opacity: 0.55; transform: translateY(2px); }
  }
  @keyframes lc-step3-sync {
    0%, 38% { opacity: 0.55; transform: translateY(2px); }
    40%, 64% { opacity: 1; transform: translateY(0); }
    66%, 100% { opacity: 0.55; transform: translateY(2px); }
  }
  @keyframes lc-step4-sync {
    0%, 64% { opacity: 0.55; transform: translateY(2px); }
    66%, 86% { opacity: 1; transform: translateY(0); }
    88%, 100% { opacity: 0.55; transform: translateY(2px); }
  }
  @keyframes lc-step5-sync {
    0%, 86% { opacity: 0.55; transform: translateY(2px); }
    88%, 96% { opacity: 1; transform: translateY(0); }
    98%, 100% { opacity: 0.55; transform: translateY(2px); }
  }

  /* ==================== COMMON SECTION STYLES ==================== */
  .lapclean-section {
    padding: clamp(52px, 7vw, 84px) 0;
  }
  .lapclean-section--alt {
    background: #f1f5f9;
  }

  .lapclean-heading {
