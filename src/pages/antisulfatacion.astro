---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FaqSection from '../components/FaqSection.astro';
import CommentsSection from '../components/CommentsSection.astro';
import ServiceTicketSection from '../components/ServiceTicketSection.astro';
import RelatedServicesSection from '../components/RelatedServicesSection.astro';
import { SERVICE_CATEGORIES } from '../data/services';

const pcCategory = SERVICE_CATEGORIES.find((category) => category.slug === 'pc');
const diagnosticService = pcCategory?.services.find((service) => service.slug === 'diagnostico');

const waMessage = encodeURIComponent('Hola, necesito revisión por sulfatación en Cancún. Mi equipo tuvo humedad, salitre o contacto con líquido y quiero saber si se puede rescatar.');

const faqs = [
  {
    question: '¿Qué es la sulfatación y por qué afecta tanto en Cancún?',
    answer: 'La sulfatación es corrosión en pistas, conectores y componentes electrónicos causada por humedad, salitre, residuos o líquido. En Cancún ocurre con más frecuencia por el clima costero, la humedad ambiental y equipos guardados cerca de ventanas, playa, aire acondicionado o zonas húmedas.',
  },
  {
    question: '¿Se puede recuperar una laptop o PC con placa sulfatada?',
    answer: 'Sí, en muchos casos se puede recuperar, pero depende del daño real. Primero revisamos placa, conectores, líneas de voltaje, pistas y componentes críticos. Si solo hay residuos o corrosión superficial, el tratamiento puede ser suficiente; si hay pistas comidas o componentes dañados, se cotiza reparación adicional.',
  },
  {
    question: '¿La antisulfatación es lo mismo que limpiar una laptop mojada?',
    answer: 'No. La limpieza por líquido atiende un derrame reciente para evitar corrosión. La antisulfatación se usa cuando ya existe oxidación, sulfato, falso contacto, pistas dañadas o daño avanzado por humedad. Es un trabajo más técnico porque puede requerir microscopio, baño ultrasónico, continuidad y reparación de pistas.',
  },
  {
    question: '¿Cuánto tarda el tratamiento de antisulfatación?',
    answer: 'Depende del equipo y nivel de daño. Un caso moderado puede tomar de 2 a 4 días hábiles, pero una placa con corrosión severa, fallas intermitentes o necesidad de reconstruir pistas puede tardar más. No se entrega solo porque enciende; se prueba estabilidad antes de recomendar entrega.',
  },
  {
    question: '¿Qué pasa si sigo usando el equipo con sulfatación?',
    answer: 'Usarlo puede empeorar el daño. La humedad y el sulfato pueden provocar cortos, falsos contactos, consumo anormal, daño de conectores, teclado, puertos o placa madre. Si el equipo tuvo líquido o señales de corrosión, lo mejor es apagarlo, no cargarlo y llevarlo a revisión.',
  },
  {
    question: '¿La protección antihumedad es permanente?',
    answer: 'No es permanente. Ayuda a proteger zonas intervenidas y reduce riesgo, pero Cancún sigue siendo un ambiente agresivo para electrónica. Recomendamos mantenimiento preventivo, evitar humedad directa, no guardar equipos en mochilas húmedas y revisar cada 6 a 12 meses si el equipo trabaja en zonas costeras.',
  },
  {
    question: '¿La antisulfatación garantiza que el equipo dure años?',
    answer: 'No se puede prometer eso cuando hubo daño por líquido o corrosión. El objetivo es detener el avance, recuperar funcionamiento cuando sea posible y rescatar información si el equipo está comprometido. Te explicamos el riesgo real antes de invertir en una reparación mayor.',
  },
];

const relatedItems = [
  { href: '/limpieza-laptop-liquido', icon: 'fa-droplet-slash', label: 'Limpieza por líquido', desc: 'Servicio urgente si acaba de caer agua, café, refresco o humedad sobre tu equipo.', cta: 'Ver servicio →' },
  { href: '/servicios/laptop/diagnostico', icon: 'fa-laptop-medical', label: 'Diagnóstico de laptop', desc: 'Revisamos pantalla, batería, teclado, carga, placa, temperatura y señales de humedad.', cta: 'Ver diagnóstico →' },
  { href: '/servicios/pc/diagnostico', icon: 'fa-desktop', label: 'Diagnóstico de PC', desc: 'Pruebas de fuente, RAM, SSD, placa, Windows, temperatura y daño por corrosión.', cta: 'Ver diagnóstico →' },
  { href: '/servicios/laptop/pasta-termica', icon: 'fa-temperature-three-quarters', label: 'Mantenimiento térmico', desc: 'Limpieza interna, pasta térmica y revisión de temperatura para laptops en Cancún.', cta: 'Ver servicio →' },
  { href: '/servicios/pc/limpieza-profunda', icon: 'fa-spray-can-sparkles', label: 'Limpieza profunda PC', desc: 'Retiro de polvo, revisión de conectores, fuente, ventiladores y humedad en PC.', cta: 'Ver servicio →' },
  { href: '/paquetes', icon: 'fa-box', label: 'Paquetes de mantenimiento', desc: 'Mantenimiento preventivo para laptops, PCs y equipos usados en clima húmedo.', cta: 'Ver paquetes →' },
  { href: '/servicios/laptop/cambio-teclado', icon: 'fa-keyboard', label: 'Cambio de teclado', desc: 'Útil cuando el líquido afectó teclado, flex, conector o matriz de teclas.', cta: 'Ver servicio →' },
  { href: '/servicios/laptop/cambio-bateria', icon: 'fa-battery-three-quarters', label: 'Cambio de batería', desc: 'Revisión de batería inflada, dañada por humedad o fallas de carga.', cta: 'Ver servicio →' },
  { href: '/reparaciones', icon: 'fa-screwdriver-wrench', label: 'Reparación general', desc: 'Reparaciones de laptop, PC, celulares, consolas e impresoras con diagnóstico claro.', cta: 'Ver reparaciones →' },
  { href: '/empresas', icon: 'fa-building-shield', label: 'Soporte B2B', desc: 'Mantenimiento preventivo y revisión de humedad para oficinas, hoteles y negocios.', cta: 'Ver B2B →' },
  { href: '/garantia', icon: 'fa-shield-halved', label: 'Garantía Pixon', desc: 'Conoce condiciones de garantía, límites por humedad y cobertura por servicio.', cta: 'Ver garantía →' },
  { href: '/contacto', icon: 'fa-location-dot', label: 'Ubicación y contacto', desc: 'Agenda revisión en Cancún y recibe orientación antes de mover tu equipo.', cta: 'Contactar →' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Antisulfatación en Cancún',
    serviceType: 'Tratamiento de sulfatación y corrosión en placas electrónicas',
    url: 'https://pixon.com.mx/antisulfatacion',
    description: 'Servicio de antisulfatación en Cancún para laptops, PCs, MacBook, consolas y equipos afectados por humedad, salitre, corrosión o líquidos.',
    provider: { '@id': 'https://pixon.com.mx/#business' },
    areaServed: [
      { '@type': 'City', name: 'Cancún' },
      { '@type': 'State', name: 'Quintana Roo' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<Base
  title="Antisulfatación en Cancún | Reparación por humedad y salitre"
  description="Antisulfatación en Cancún para laptops, PCs, MacBook y equipos con corrosión por humedad, salitre o líquidos. Baño ultrasónico, revisión de placa y diagnóstico claro."
  canonical="https://pixon.com.mx/antisulfatacion"
  image="/assets/images/reparacion-sulfatacion-cancun.jpeg"
  schema={schema}
>
  <Navbar />

  <main class="anti-page">
    <section class="anti-hero">
      <div class="container anti-hero-grid">
        <div class="anti-hero-copy">
          <span class="anti-kicker"><i class="fa-solid fa-droplet-slash"></i> Clima costero · Cancún</span>
          <h1>Antisulfatación en Cancún para laptops, PCs y placas con corrosión</h1>
          <h2>Tratamiento técnico contra humedad, salitre, líquido derramado, óxido verde y falsos contactos.</h2>
          <p>Si tu equipo se mojó, estuvo guardado en humedad, vive cerca del mar o empezó con fallas extrañas, revisamos placa, conectores, pistas, puertos y componentes antes de declarar pérdida total.</p>
          <div class="anti-hero-badges">
            <span>Baño ultrasónico</span>
            <span>Revisión con microscopio</span>
            <span>Placa y conectores</span>
            <span>Servicio local en Cancún</span>
          </div>
          <div class="anti-actions">
            <a class="anti-primary" href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank">
              <i class="fa-brands fa-whatsapp"></i> Revisar equipo sulfatado
            </a>
            <a class="anti-secondary" href="#diagnostico">Ver señales de daño</a>
          </div>
        </div>
        <aside class="anti-lab-card" aria-label="Resumen de antisulfatación">
          <img src="/assets/images/reparacion-sulfatacion-cancun.jpeg" alt="Reparación por antisulfatación en Cancún" loading="eager" />
          <div>
            <span>Diagnóstico visual</span>
            <strong>Humedad + salitre</strong>
            <p>En Cancún la corrosión puede avanzar aunque el equipo parezca seco. No lo cargues ni lo enciendas hasta revisarlo.</p>
          </div>
        </aside>
      </div>
    </section>

    <section class="anti-strip" aria-label="Resumen técnico">
      <div class="container anti-strip-grid">
        <article><strong>24-72 h</strong><span>primer avance según daño</span></article>
        <article><strong>Microscopio</strong><span>revisión de pistas y conectores</span></article>
        <article><strong>Ultrasónico</strong><span>limpieza química controlada</span></article>
        <article><strong>Cancún</strong><span>enfoque humedad y salitre</span></article>
      </div>
    </section>

    <section class="anti-section anti-light" id="diagnostico">
      <div class="container">
        <div class="anti-head">
          <span class="anti-eyebrow">Diagnóstico frecuente</span>
          <h2>Señales de sulfatación que vemos en equipos de Cancún</h2>
          <p>La corrosión no siempre aparece como “óxido verde” visible. A veces se nota como encendido intermitente, puertos fallando, carga inestable o equipo que murió después de varios días.</p>
        </div>
        <div class="anti-symptom-layout">
          <div class="anti-signal-panel">
            <h3>Si pasó esto, no lo sigas usando</h3>
            <p>Encender o cargar un equipo con humedad puede convertir una limpieza recuperable en reparación de placa.</p>
            <a href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank">Pedir revisión urgente</a>
          </div>
          <div class="anti-symptom-grid">
            {[
              ['No enciende después de humedad', 'Puede haber corto, consumo anormal o corrosión en líneas principales.'],
              ['Carga intermitente', 'El sulfato suele afectar centro de carga, flex, batería o conectores.'],
              ['Teclado o USB fallan', 'La humedad puede viajar por flex y conectores aunque el derrame haya sido pequeño.'],
              ['Ventilador enciende pero no da video', 'Revisamos placa, RAM, BIOS, GPU integrada y líneas dañadas.'],
              ['Manchas blancas o verdes', 'Son residuos de corrosión, minerales o salitre sobre contactos y soldaduras.'],
              ['Falla días después del derrame', 'Aunque se haya secado por fuera, la reacción química puede seguir avanzando.'],
            ].map(([title, text], index) => (
              <article>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{title}</h3>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="anti-section anti-dark">
      <div class="container anti-split">
        <div>
          <span class="anti-eyebrow">Por qué pasa</span>
          <h2>Humedad, salitre y corriente: la mezcla que destruye pistas</h2>
          <p>El daño por sulfatación aparece cuando humedad o líquido se combina con corriente eléctrica. El cobre, soldaduras y conectores empiezan a oxidarse; después llegan falsos contactos, líneas abiertas, cortos o componentes que dejan de responder.</p>
        </div>
        <div class="anti-cause-list">
          <article><i class="fa-solid fa-water"></i><div><h3>Humedad ambiental</h3><p>Equipos cerca de ventanas, aire acondicionado, terrazas o mochilas húmedas.</p></div></article>
          <article><i class="fa-solid fa-umbrella-beach"></i><div><h3>Salitre costero</h3><p>El aire de costa acelera corrosión en conectores, tornillos, puertos y placas.</p></div></article>
          <article><i class="fa-solid fa-mug-hot"></i><div><h3>Derrames</h3><p>Café, refresco, agua, alcohol y bebidas azucaradas dejan residuos conductivos.</p></div></article>
          <article><i class="fa-solid fa-bolt"></i><div><h3>Corriente activa</h3><p>Seguir cargando o prendiendo el equipo puede provocar corto y daño mayor.</p></div></article>
        </div>
      </div>
    </section>

    <section class="anti-section anti-light">
      <div class="container">
        <div class="anti-head">
          <span class="anti-eyebrow">Proceso técnico</span>
          <h2>Cómo trabajamos una placa sulfatada</h2>
          <p>No es solo “limpiar con alcohol”. Tratamos la corrosión por etapas para saber si el equipo puede recuperarse y qué piezas quedaron comprometidas.</p>
        </div>
        <div class="anti-process">
          {[
            ['01', 'Inspección', 'Revisamos zonas visibles, conectores, batería, puerto de carga, teclado, flex y señales de líquido.'],
            ['02', 'Desarmado seguro', 'Separamos placa y componentes para evitar que residuos sigan dañando piezas sanas.'],
            ['03', 'Baño ultrasónico', 'Usamos limpieza química controlada para remover residuos, sales y corrosión superficial.'],
            ['04', 'Secado controlado', 'No se entrega húmedo ni se prueba antes de completar secado y revisión visual.'],
            ['05', 'Continuidad y voltajes', 'Revisamos líneas críticas, consumo, cortos, conectores y pistas comprometidas.'],
            ['06', 'Prueba final', 'Probamos encendido, carga, teclado, puertos, temperatura y estabilidad según el equipo.'],
          ].map(([num, title, text]) => (
            <article>
              <strong>{num}</strong>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="anti-section anti-compare">
      <div class="container anti-compare-grid">
        <div>
          <span class="anti-eyebrow">Decisión correcta</span>
          <h2>¿Limpieza por líquido o antisulfatación?</h2>
          <p>El servicio correcto depende del tiempo que pasó, tipo de líquido, si se conectó a corriente y si ya existe corrosión visible o fallas intermitentes.</p>
        </div>
        <div class="anti-columns">
          <article>
            <h3>Limpieza por líquido si:</h3>
            <ul>
              <li>El derrame fue reciente</li>
              <li>El equipo aún no presenta óxido</li>
              <li>No se ha cargado después del incidente</li>
              <li>Queremos prevenir corrosión futura</li>
            </ul>
          </article>
          <article>
            <h3>Antisulfatación si:</h3>
            <ul>
              <li>Ya hay manchas verdes, blancas o negras</li>
              <li>Pasaron días o semanas con humedad</li>
              <li>Hay puertos, teclado o carga fallando</li>
              <li>La placa requiere revisión de pistas</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="anti-section anti-dark">
      <div class="container">
        <div class="anti-head anti-head-dark">
          <span class="anti-eyebrow">Equipos atendidos</span>
          <h2>Antisulfatación para laptops, PCs, MacBook, consolas y celulares</h2>
          <p>Cada equipo se abre de forma distinta y no todos tienen la misma posibilidad de recuperación. Revisamos riesgo, acceso a placa, piezas disponibles y prioridad de rescate de información.</p>
        </div>
        <div class="anti-device-grid">
          {[
            ['fa-laptop', 'Laptops Windows', 'HP, Dell, Lenovo, Asus, Acer y equipos usados en escuela, trabajo u oficina.'],
            ['fa-laptop-code', 'MacBook', 'Revisión de placa, top case, batería, teclado, trackpad y daño por líquido.'],
            ['fa-desktop', 'PC de escritorio', 'Placa madre, fuente, GPU, RAM, puertos, polvo pegado y sulfatación por humedad.'],
            ['fa-gamepad', 'Consolas', 'PS5, Xbox, Nintendo Switch, Steam Deck y portátiles con humedad o corrosión.'],
            ['fa-mobile-screen-button', 'Celulares', 'Conectores, flex, puerto de carga, audio, pantalla y señales de líquido.'],
            ['fa-print', 'Impresoras', 'Tarjetas, sensores, conectores y equipos expuestos a humedad en oficina o negocio.'],
          ].map(([icon, title, text]) => (
            <article>
              <i class={`fa-solid ${icon}`}></i>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="anti-section anti-light">
      <div class="container anti-rescue-grid">
        <div>
          <span class="anti-eyebrow">Prioridad real</span>
          <h2>Primero buscamos salvar información y estabilizar el equipo</h2>
          <p>Cuando una placa ya está sulfatada, la recuperación no siempre significa “quedó como nueva”. A veces el objetivo principal es recuperar archivos, estabilizar encendido, confirmar viabilidad o evitar gastar en una reparación que no conviene.</p>
        </div>
        <div class="anti-rescue-cards">
          <article><strong>01</strong><h3>Rescate de datos</h3><p>Si el equipo enciende, priorizamos respaldo antes de pruebas largas.</p></article>
          <article><strong>02</strong><h3>Viabilidad</h3><p>Te decimos si conviene reparar, limpiar, cambiar pieza o declarar pérdida.</p></article>
          <article><strong>03</strong><h3>Riesgo transparente</h3><p>El daño por líquido no se promete como reparación eterna. Se explica el riesgo real.</p></article>
        </div>
      </div>
    </section>

    <section class="anti-section anti-prevention">
      <div class="container anti-prevention-card">
        <div>
          <span class="anti-eyebrow">Prevención en Cancún</span>
          <h2>Cómo reducir sulfatación por clima, humedad y salitre</h2>
          <p>La prevención importa mucho más en Cancún que en ciudades secas. Si tu equipo trabaja en oficina con aire acondicionado, cerca de playa, hotel, local comercial o zona húmeda, conviene revisar conectores y limpieza interna con más frecuencia.</p>
        </div>
        <div class="anti-prevention-list">
          <span>No guardar laptops en mochilas húmedas</span>
          <span>Evitar ventanas, terrazas o piso</span>
          <span>No cargar después de derrame</span>
          <span>Revisar cada 6-12 meses</span>
          <span>Usar fundas secas y ventilación</span>
          <span>Atender líquido en las primeras horas</span>
        </div>
      </div>
    </section>

    <ServiceTicketSection
      defaultDevice="Laptop / PC"
      defaultService="Antisulfatación"
      sourcePage="/antisulfatacion"
      title="Crear ticket de antisulfatación"
      subtitle="Cuéntanos si hubo líquido, humedad, salitre o señales de corrosión. Te contactaremos para revisar viabilidad y siguiente paso."
    />

    <RelatedServicesSection
      items={relatedItems}
      title="Servicios relacionados con humedad, líquido y corrosión"
      eyebrow="Servicios complementarios"
      initialLimit={8}
    />

    <FaqSection
      id="faq"
      title="Preguntas frecuentes sobre antisulfatación en Cancún"
      description="Resolvemos dudas sobre sulfatación, humedad, salitre, líquido derramado, baño ultrasónico, reparación de pistas, tiempos y posibilidades reales de recuperación."
      items={faqs}
      ariaLabel="Preguntas frecuentes sobre antisulfatación en Cancún"
      viewMoreHref="/preguntas-frecuentes"
      viewMoreLabel="Ver más preguntas frecuentes"
      backgroundColor="#0B1120"
      titleColor="#F8FAFC"
      descriptionColor="#CBD5E1"
      questionColor="#F8FAFC"
      itemGap="10px"
      questionPadding="16px 18px"
      sectionClass="anti-faq"
    />

    <CommentsSection dark={true} viewMoreHref="/comentarios" viewMoreLabel="Ver todas las reseñas" />
  </main>

  <Footer />
</Base>

<style is:global>
  .anti-page {
    background: #07111f;
    color: #e2e8f0;
    letter-spacing: 0;
  }
  .anti-hero {
    position: relative;
    overflow: hidden;
    padding: 42px 0 54px;
    background:
      radial-gradient(circle at 12% 15%, rgba(16,185,129,.22), transparent 30%),
      radial-gradient(circle at 86% 18%, rgba(56,189,248,.18), transparent 30%),
      linear-gradient(135deg, #06111f 0%, #0b1120 54%, #102a25 100%);
  }
  .anti-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(148,163,184,.08) 1px, transparent 1px),
      linear-gradient(0deg, rgba(148,163,184,.06) 1px, transparent 1px);
    background-size: 44px 44px;
    opacity: .38;
  }
  .anti-hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, .9fr);
    gap: 34px;
    align-items: center;
  }
  .anti-kicker,
  .anti-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #5eead4;
    font-size: .78rem;
    font-weight: 950;
    letter-spacing: .02em;
    text-transform: uppercase;
  }
  .anti-hero h1 {
    margin: 12px 0 12px;
    color: #fff;
    font-size: clamp(2.15rem, 4.8vw, 4.6rem);
    line-height: .98;
    letter-spacing: 0;
  }
  .anti-hero h2 {
    margin: 0 0 14px;
    color: #ccfbf1;
    font-size: clamp(1.05rem, 2vw, 1.5rem);
    line-height: 1.3;
    font-weight: 900;
  }
  .anti-hero p {
    color: #cbd5e1;
    max-width: 780px;
    line-height: 1.7;
    font-size: 1.04rem;
  }
  .anti-hero-badges,
  .anti-actions,
  .anti-prevention-list,
  .anti-area-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }
  .anti-hero-badges {
    margin: 18px 0 22px;
  }
  .anti-hero-badges span {
    border: 1px solid rgba(94,234,212,.28);
    background: rgba(15,23,42,.66);
    color: #ecfeff;
    padding: 8px 11px;
    border-radius: 999px;
    font-weight: 850;
    font-size: .84rem;
  }
  .anti-primary,
  .anti-secondary,
  .anti-signal-panel a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    padding: 12px 18px;
    border-radius: 12px;
    font-weight: 900;
    text-decoration: none;
  }
  .anti-primary,
  .anti-signal-panel a {
    background: #10b981;
    color: #031b16;
    box-shadow: 0 16px 34px rgba(16,185,129,.24);
  }
  .anti-secondary {
    color: #e0f2fe;
    border: 1px solid rgba(226,232,240,.22);
    background: rgba(15,23,42,.64);
  }
  .anti-lab-card {
    overflow: hidden;
    border-radius: 26px;
    background: rgba(15,23,42,.78);
    border: 1px solid rgba(148,163,184,.18);
