---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CartDrawer from '../components/store/CartDrawer.astro';
import storeCss from '../styles/store.css?url';
---
<Base title="Carrito | Pixon PC" description="Revisa tu selección antes de comprar en Pixon PC." canonical="https://pixon.com.mx/carrito" robots="noindex, nofollow" extraStyles={[storeCss]} preloadSprite={true}>
  <Navbar />
  <main class="store-page private-commerce-page">
    <div class="store-shell"><Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Tienda', href: '/tienda' }, { label: 'Carrito' }]} /></div>
    <section class="store-shell cart-page" aria-labelledby="cart-title">
      <header><p class="store-section-label">Compra segura</p><h1 id="cart-title">Tu carrito</h1><p>Revalidaremos precio, promoción y disponibilidad con el servidor antes de continuar.</p></header>
      <div class="cart-layout">
        <div class="cart-items" id="cart-items" aria-live="polite"><div class="cart-skeleton"></div><div class="cart-skeleton"></div></div>
        <aside class="cart-summary">
          <h2>Resumen</h2>
          <dl><div><dt>Subtotal</dt><dd id="cart-subtotal">$0.00</dd></div><div><dt>Descuentos estimados</dt><dd id="cart-discount">-$0.00</dd></div><div class="cart-total"><dt>Total estimado</dt><dd id="cart-total">$0.00</dd></div></dl>
          <p id="cart-validation-note">Preparando validación…</p>
          <a class="store-action store-action-primary" id="cart-checkout" href="/checkout" aria-disabled="true">Continuar al checkout</a>
          <a class="store-action store-action-secondary" href="/tienda">Continuar comprando</a>
        </aside>
      </div>
      <div class="store-state" id="cart-empty" hidden><h2>Tu carrito está vacío</h2><p>Explora equipos, hardware, servicios y paquetes disponibles.</p><a href="/tienda">Ver la tienda</a></div>
    </section>
  </main>
  <CartDrawer />
  <Footer />
  <script src="/scripts/store-cart.js?v=20260819-1" is:inline defer></script>
  <script src="/scripts/cart-page.js?v=20260819-1" is:inline defer></script>
</Base>
