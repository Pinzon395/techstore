---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import storeCss from '../../styles/store.css?url';

export function getStaticPaths() {
  return [{ params: { folio: 'seguimiento' } }];
}
---
<Base title="Seguimiento de pedido | Pixon PC" description="Consulta el estado de tu pedido Pixon PC." canonical="https://pixon.com.mx/pedido/seguimiento" robots="noindex, nofollow" extraStyles={[storeCss]} preloadSprite={true}>
  <Navbar />
  <main class="store-page private-commerce-page order-page">
    <section class="store-shell order-shell" aria-labelledby="order-title">
      <header class="order-header"><p class="store-section-label">Seguimiento seguro</p><h1 id="order-title">Tu pedido Pixon PC</h1><p id="order-intro">Consulta con el correo usado al comprar. El folio por sí solo no permite acceder.</p></header>
      <form class="order-access" id="order-access-form"><label><span>Correo del pedido</span><input id="order-email" type="email" autocomplete="email" required /></label><button class="store-action store-action-primary" type="submit">Consultar pedido</button></form>
      <div class="order-loading" id="order-loading" hidden><div class="cart-skeleton"></div><div class="cart-skeleton"></div></div>
      <div class="checkout-message" id="order-error" role="alert" hidden></div>
      <div class="order-content" id="order-content" hidden>
        <section class="order-summary-card"><div><span>Folio</span><strong id="order-folio">—</strong></div><div><span>Estado</span><strong class="order-status" id="order-status">—</strong></div><div><span>Total</span><strong id="order-total">—</strong></div><div><span>Método</span><strong id="order-method">—</strong></div></section>
        <div class="order-grid">
          <div><section class="order-card"><h2>Resumen</h2><div id="order-items"></div></section><section class="order-card"><h2>Seguimiento</h2><ol class="order-timeline" id="order-timeline"></ol></section></div>
          <aside><section class="order-card" id="order-transfer" hidden><h2>Realiza tu transferencia</h2><dl id="order-transfer-details"></dl><div class="order-copy-actions"><button type="button" data-copy-field="account">Copiar cuenta</button><button type="button" data-copy-field="reference">Copiar referencia</button></div></section>
          <section class="order-card" id="order-proof"><h2>Comprobante de pago</h2><p>JPEG, PNG, WebP o PDF. Máximo 10 MB.</p><label class="proof-dropzone" id="proof-dropzone" for="proof-file"><strong>Arrastra tu comprobante o selecciónalo</strong><span id="proof-file-label">Ningún archivo seleccionado</span></label><input id="proof-file" type="file" accept="image/jpeg,image/png,image/webp,application/pdf" /><div class="proof-preview" id="proof-preview" aria-live="polite"></div><button class="store-action store-action-primary" id="proof-upload" type="button" disabled>Subir comprobante</button><p id="proof-status" aria-live="polite"></p></section>
          <section class="order-card"><h2>¿Necesitas ayuda?</h2><p>Usa el sistema de tickets existente y menciona tu folio.</p><a href="/tickets">Crear ticket de soporte</a></section></aside>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script src="/scripts/order-page.js?v=20260812-1" is:inline defer></script>
</Base>
