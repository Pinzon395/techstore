    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    margin-bottom: 14px;
  }

  .opt-remote-step h4 {
    font-size: 1.1rem;
    font-weight: 800;
    margin-bottom: 8px;
  }

  .opt-remote-step p {
    font-size: 0.9rem;
    color: #475569 !important;
    line-height: 1.5;
    margin: 0;
  }

  /* 12. METHODOLOGY STEPS */
  .opt-steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }

  .opt-step-box {
    background: #f8fafc;
    border: 1px solid var(--border-light);
    border-radius: 14px;
    padding: 22px;
  }

  .opt-step-box__idx {
    font-size: 2rem;
    font-weight: 900;
    color: #cbd5e1 !important;
    display: block;
    line-height: 1;
    margin-bottom: 8px;
  }

  .opt-step-box h3 {
    font-size: 1.15rem;
    font-weight: 800;
    color: #2563eb !important;
    margin-bottom: 8px;
  }

  .opt-step-box p {
    font-size: 0.9rem;
    color: #475569 !important;
    line-height: 1.5;
    margin: 0;
  }

  /* 13. PRICING */
  .opt-pricing-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 26px;
  }

  .opt-price-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 18px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
  }

  .opt-price-card--featured {
