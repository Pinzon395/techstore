---
import '../layouts/Base.astro';
import '../components/Navbar.astro';
import '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<Base
  title="Optimización de Equipos de Cómputo | Pixon PC"
  description="Optimización de equipos de cómputo remota y presencial. Mejora el rendimiento de tu PC o laptop sin comprar componentes nuevos."
  canonical="https://pixon.com.mx/optimizacion"
  image="/assets/images/optimizacion-pc-cancun.png"
  schema={[
    {
        "@context": "https://schema.org",
        "@type": "Service",
        "name": "Optimización de Equipos de Cómputo",
        "provider": {
            "@type": "LocalBusiness",
            "name": "Pixon PC",
            "url": "https://pixon.com.mx"
        },
        "areaServed": {
            "@type": "City",
            "name": "Cancun"
        },
        "serviceType": "Mantenimiento y Optimización de Software",
        "url": "https://pixon.com.mx/optimizacion",
        "description": "Optimización remota y presencial para PCs y laptops. Mejora el rendimiento, fps en juegos y tiempos de carga."
    },
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Inicio",
                "item": "https://pixon.com.mx/"
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": "Optimización",
                "item": "https://pixon.com.mx/optimizacion"
            }
        ]
    },
    {
        "@context": "https://schema.org/",
        "@type": "Service",
        "name": "Optimización de PC y Aceleración de Windows a Distancia",
        "description": "Servicio técnico 100% online y remoto para acelerar Windows 10/11, aumentar FPS, reducir latencia (Input Lag) y eliminar virus. Válido a nivel internacional.",
        "provider": {
            "@type": "LocalBusiness",
            "name": "Pixon PC",
            "url": "https://pixon.com.mx",
            "telephone": "+529986690777",
            "image": "https://pixon.com.mx/assets/logos/Logo.svg",
            "address": {
                "@type": "PostalAddress",
                "addressLocality": "Cancún",
                "addressRegion": "Quintana Roo",
                "addressCountry": "MX"
            }
        },
        "serviceType": "Remote Technical Support",
        "areaServed": [
            {
                "@type": "Country",
                "name": "Mexico"
            },
            {
                "@type": "Country",
                "name": "United States"
            },
            {
                "@type": "Country",
                "name": "Spain"
            },
            {
                "@type": "Country",
                "name": "Colombia"
            },
            {
                "@type": "Country",
                "name": "Argentina"
            },
            {
                "@type": "Country",
                "name": "Chile"
            },
            {
                "@type": "Country",
                "name": "Peru"
            }
        ],
        "offers": [
            {
                "@type": "Offer",
                "name": "Basic Tune-Up Remoto",
                "price": "20",
                "priceCurrency": "USD",
                "url": "https://pixon.com.mx/optimizacion",
                "description": "Limpieza profunda de archivos temporales, desactivación de programas de inicio y bloatware."
            },
            {
                "@type": "Offer",
                "name": "Pro Gamer Online",
                "price": "40",
                "priceCurrency": "USD",
                "url": "https://pixon.com.mx/optimizacion",
                "description": "Debloat profundo de Windows, optimización de registro, perfiles de energía para máximo desempeño y reducción de latencia (Input Lag)."
            },
            {
                "@type": "Offer",
                "name": "Elite Enthusiast",
                "price": "75",
                "priceCurrency": "USD",
                "url": "https://pixon.com.mx/optimizacion",
                "description": "Todo lo del paquete Pro Gamer más Undervolting a CPU/GPU, Overclocking seguro y Activación de XMP/EXPO."
            }
        ]
    }
]}
>
  <Navbar />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Optimización de Equipos' }]} />

    <!-- HERO -->
    <header class="page-hero"
        style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%); padding: 80px 0 60px; text-align: center; color: white;">
        <div class="container">
            <h1 style="font-size: clamp(2.2rem, 5vw, 3.5rem); margin-bottom: 20px;">Optimización de Equipos de Cómputo
            </h1>
            <p style="font-size: 1.1rem; max-width: 700px; margin: 0 auto 30px; color: #cbd5e1;">Exprime hasta la última
                gota de rendimiento de tu computadora. Eliminamos la lentitud, optimizamos el sistema y configuramos tu
                hardware para que trabaje al 100% sin gastar en piezas nuevas.</p>
        </div>
    </header>

    <!-- PAQUETES -->
    <section id="paquetes-optimizacion" style="background: #0F172A; color: white; position: relative; padding: 20px 0;">
        <div class="container" style="position: relative; z-index: 2; padding-top: 20px; padding-bottom: 20px;">
            <div class="section-title text-center">
                <h2 style="color: white; text-shadow: 0 2px 10px rgba(0,0,0,0.5);">Paquetes de Optimización de PC (Vía
                    Remota Internacional o Presencial)</h2>
                <p style="color: #cbd5e1;">Servicio técnico online para acelerar Windows, mejorar rendimiento, reducir
                    latencia y aumentar FPS en juegos. ¡Atendemos a todo el mundo! (Precios en USD).</p>
            </div>

            <div class="pricing-grid"
                style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; margin-top: 40px;">
                <!-- Basic -->
                <div class="pricing-card pack-basic"
                    style="background: rgba(255,255,255,0.03); border-radius: 16px; border: 1px solid rgba(255,255,255,0.1); padding: 30px; position: relative; color: #e2e8f0; transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;"
                    onmouseover="this.style.transform='translateY(-10px)'; this.style.boxShadow='0 15px 30px rgba(0,0,0,0.4)'; this.style.borderColor='rgba(255,255,255,0.3)';"
                    onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none'; this.style.borderColor='rgba(255,255,255,0.1)';">
                    <div class="card-header" style="margin-bottom: 20px;">
                        <h3 style="font-size: 1.5rem; color: #fff; margin-bottom: 5px;">Basic Tune-Up Remoto</h3>
                        <p style="color: #94a3b8; font-size: 0.9rem;">Ideal para acelerar equipos de oficina y estudio
                            lentos a distancia.</p>
                    </div>
                    <div class="price" style="margin-bottom: 20px;">
                        <h4 style="font-size: 2.5rem; color: #60a5fa; font-weight: 800; margin: 0;">$20 <span
                                class="currency" style="font-size: 1rem; color: #94a3b8;">USD</span></h4>
                    </div>
                    <ul class="pricing-features" style="list-style: none; padding: 0; margin-bottom: 30px;">
                        <li
                            style="margin-bottom: 12px; font-size: 0.9rem; display: flex; align-items: flex-start; gap: 10px;">
                            <i class="fa-solid fa-check" style="color: #34d399; margin-top: 3px;"></i> Limpieza profunda
                            de archivos temporales de Windows</li>
                        <li
                            style="margin-bottom: 12px; font-size: 0.9rem; display: flex; align-items: flex-start; gap: 10px;">
                            <i class="fa-solid fa-check" style="color: #34d399; margin-top: 3px;"></i> Desactivación de
                            programas de inicio y bloatware</li>
                        <li
                            style="margin-bottom: 12px; font-size: 0.9rem; display: flex; align-items: flex-start; gap: 10px;">
                            <i class="fa-solid fa-check" style="color: #34d399; margin-top: 3px;"></i> Eliminación de
                            malware y virus online</li>
                        <li
                            style="margin-bottom: 12px; font-size: 0.9rem; display: flex; align-items: flex-start; gap: 10px;">
                            <i class="fa-solid fa-check" style="color: #34d399; margin-top: 3px;"></i> Actualización de
                            drivers para solucionar lentitud</li>
                    </ul>
                    <button class="btn btn-outline"
                        style="width: 100%; border-color: rgba(255,255,255,0.2); color: white; transition: all 0.3s ease;"
                        onmouseover="this.style.background='rgba(255,255,255,0.1)';"
                        onmouseout="this.style.background='transparent';"
                        onclick="smartWaRedirect('https://wa.me/529986690777?text=Quiero%20el%20paquete%20Basic%20Tune-Up%20Remoto')">Elegir
                        Basic</button>
                </div>

                <!-- Pro -->
                <div class="pricing-card pack-pro"
                    style="background: rgba(59,130,246,0.1); backdrop-filter: blur(10px); border-radius: 16px; border: 2px solid #3b82f6; padding: 30px; position: relative; transform: scale(1.05); box-shadow: 0 0 20px rgba(59,130,246,0.3); color: white; transition: transform 0.3s ease, box-shadow 0.3s ease;"
                    onmouseover="this.style.transform='scale(1.05) translateY(-10px)'; this.style.boxShadow='0 20px 40px rgba(59,130,246,0.5), 0 0 30px rgba(59,130,246,0.4)';"
                    onmouseout="this.style.transform='scale(1.05)'; this.style.boxShadow='0 0 20px rgba(59,130,246,0.3)';">
                    <div
                        style="position: absolute; top: -14px; left: 50%; transform: translateX(-50%); background: linear-gradient(90deg, #2563eb, #3b82f6); color: #fff; padding: 6px 20px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; box-shadow: 0 4px 10px rgba(37,99,235,0.5);">
                        MÁS POPULAR</div>
                    <div class="card-header" style="margin-bottom: 20px;">
                        <h3 style="font-size: 1.5rem; color: #fff; margin-bottom: 5px;">Pro Gamer Online</h3>
                        <p style="color: #bfdbfe; font-size: 0.9rem;">Perfecto para maximizar FPS y fluidez en Warzone,
                            Valorant, Fortnite, etc.</p>
                    </div>
                    <div class="price" style="margin-bottom: 20px;">
                        <h4 style="font-size: 2.5rem; color: #60a5fa; font-weight: 800; margin: 0;">$40 <span
                                class="currency" style="font-size: 1rem; color: #bfdbfe;">USD</span></h4>
                    </div>
                    <ul class="pricing-features" style="list-style: none; padding: 0; margin-bottom: 30px;">
                        <li
                            style="margin-bottom: 12px; font-size: 0.9rem; display: flex; align-items: flex-start; gap: 10px;">
                            <i class="fa-solid fa-check" style="color: #34d399; margin-top: 3px;"></i> <strong>Todo lo
                                del paquete Basic</strong></li>
                        <li
                            style="margin-bottom: 12px; font-size: 0.9rem; display: flex; align-items: flex-start; gap: 10px;">
                            <i class="fa-solid fa-check" style="color: #34d399; margin-top: 3px;"></i> Debloat profundo
                            de Windows 10/11 (Quitar procesos inútiles)</li>
                        <li
                            style="margin-bottom: 12px; font-size: 0.9rem; display: flex; align-items: flex-start; gap: 10px;">
                            <i class="fa-solid fa-check" style="color: #34d399; margin-top: 3px;"></i> Optimización de
                            registro y telemetría para más rendimiento</li>
                        <li
                            style="margin-bottom: 12px; font-size: 0.9rem; display: flex; align-items: flex-start; gap: 10px;">
                            <i class="fa-solid fa-check" style="color: #34d399; margin-top: 3px;"></i> Configuración de
                            perfiles de energía ocultos para máximo desempeño</li>
                        <li
                            style="margin-bottom: 12px; font-size: 0.9rem; display: flex; align-items: flex-start; gap: 10px;">
                            <i class="fa-solid fa-check" style="color: #34d399; margin-top: 3px;"></i> Reducción de
                            latencia (Input Lag) y mejora de ping online</li>
                    </ul>
                    <button class="btn btn-primary"
                        style="width: 100%; transition: all 0.3s ease; background: linear-gradient(90deg, #2563eb, #3b82f6); border: none;"
                        onmouseover="this.style.boxShadow='0 0 15px #3b82f6';" onmouseout="this.style.boxShadow='none';"
                        onclick="smartWaRedirect('https://wa.me/529986690777?text=Quiero%20el%20paquete%20Pro%20Gamer%20de%20optimizacion%20remota')">Elegir
                        Pro Gamer</button>
                </div>

                <!-- Elite -->
                <div class="pricing-card pack-elite"
                    style="background: rgba(15,23,42,0.8); border-radius: 16px; border: 1px solid #334155; padding: 30px; position: relative; color: #fff; transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;"
                    onmouseover="this.style.transform='translateY(-10px)'; this.style.boxShadow='0 15px 30px rgba(0,0,0,0.6)'; this.style.borderColor='#60a5fa';"
                    onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none'; this.style.borderColor='#334155';">
                    <div class="card-header" style="margin-bottom: 20px;">
                        <h3 style="font-size: 1.5rem; color: #fff; margin-bottom: 5px;">Elite Enthusiast</h3>
                        <p style="color: #94a3b8; font-size: 0.9rem;">Para los más exigentes. Undervolt, Overclock y
                            hardware tuning a nivel experto.</p>
                    </div>
                    <div class="price" style="margin-bottom: 20px;">
                        <h4 style="font-size: 2.5rem; color: #60a5fa; font-weight: 800; margin: 0;">$75 <span
                                class="currency" style="font-size: 1rem; color: #94a3b8;">USD</span></h4>
                    </div>
                    <ul class="pricing-features"
                        style="list-style: none; padding: 0; margin-bottom: 30px; color: #cbd5e1;">
                        <li
                            style="margin-bottom: 12px; font-size: 0.9rem; display: flex; align-items: flex-start; gap: 10px;">
                            <i class="fa-solid fa-check" style="color: #60a5fa; margin-top: 3px;"></i> <strong>Todo lo
                                del paquete Pro Gamer</strong></li>
                        <li
                            style="margin-bottom: 12px; font-size: 0.9rem; display: flex; align-items: flex-start; gap: 10px;">
                            <i class="fa-solid fa-check" style="color: #60a5fa; margin-top: 3px;"></i> Undervolting a
                            CPU/GPU remoto para bajar temperaturas</li>
                        <li
                            style="margin-bottom: 12px; font-size: 0.9rem; display: flex; align-items: flex-start; gap: 10px;">
                            <i class="fa-solid fa-check" style="color: #60a5fa; margin-top: 3px;"></i> Overclocking
                            seguro y estable para exprimir tu hardware</li>
                        <li
                            style="margin-bottom: 12px; font-size: 0.9rem; display: flex; align-items: flex-start; gap: 10px;">
                            <i class="fa-solid fa-check" style="color: #60a5fa; margin-top: 3px;"></i> Activación de
                            XMP/EXPO y Resizable BAR en BIOS</li>
                        <li
                            style="margin-bottom: 12px; font-size: 0.9rem; display: flex; align-items: flex-start; gap: 10px;">
                            <i class="fa-solid fa-check" style="color: #60a5fa; margin-top: 3px;"></i> Creación de curva
                            de ventiladores personalizada</li>
                    </ul>
                    <button class="btn btn-outline"
                        style="width: 100%; border-color: #60a5fa; color: #60a5fa; transition: all 0.3s ease;"
                        onmouseover="this.style.background='rgba(96,165,250,0.1)';"
                        onmouseout="this.style.background='transparent';"
                        onclick="smartWaRedirect('https://wa.me/529986690777?text=Quiero%20el%20paquete%20Elite%20Enthusiast%20de%20optimizacion%20remota')">Elegir
                        Elite</button>
                </div>
            </div>
            <p class="text-center mt-4" style="color: #94a3b8; font-size: 0.9rem;"><em>Nota: Si los precios en dólares
                    americanos no coinciden con tu presupuesto, contáctanos y te damos una cotización local.</em></p>
        </div>
    </section>

    <!-- SEO SECTIONS -->
    <section
        style="background: #0F172A; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 100px; padding-bottom: 60px;">
        <div class="container">
            <div class="row" style="display: flex; flex-wrap: wrap; gap: 40px; margin-bottom: 60px;">
                <div class="col" style="flex: 1; min-width: 300px;">
                    <h2 style="font-size: 2rem; color: #f1f5f9; margin-bottom: 20px;">Optimización de PC Remota: Acelera
                        tu Windows a Distancia</h2>
                    <p style="color: #cbd5e1; font-size: 1.05rem; line-height: 1.7; margin-bottom: 15px;">
                        ¿Tu PC o Laptop se siente lenta? No importa en qué país del mundo te encuentres, nuestro
                        servicio de <strong style="color: #818cf8;">optimización de PC remota</strong> soluciona problemas de lentitud extrema.
                        Eliminamos "Bloatware" (programas preinstalados innecesarios), basura digital y servicios en
                        segundo plano que asfixian tu procesador y RAM.
                    </p>
                    <p style="color: #cbd5e1; font-size: 1.05rem; line-height: 1.7;">
                        Conectándonos de forma segura, un técnico especialista en <strong style="color: #818cf8;">aumentar FPS y reducir
                            latencia</strong> realiza un ajuste fino ("debloat") a tu Windows 10 u 11. Perfecto para
                        gamers que buscan eliminar el input lag y maximizar los fotogramas por segundo, o profesionales
                        que necesitan que su equipo vuele.
                    </p>
                </div>
                <div class="col" style="flex: 1; min-width: 300px;">
                    <h3 style="font-size: 1.5rem; color: #f1f5f9; margin-bottom: 20px;">Verificación de Hardware
                        Profesional</h3>
                    <div style="background: rgba(30,41,59,0.5); padding: 25px; border-radius: 16px; border: 1px solid rgba(99,102,241,0.2);">
                        <p style="color: #cbd5e1; font-size: 0.95rem; line-height: 1.6; margin-bottom: 15px;">
                            A veces, la lentitud no es solo software. Por eso, en todos nuestros paquetes realizamos una
                            revisión del estado de salud de tus componentes:
                        </p>
                        <ul style="list-style: none; padding: 0; margin: 0; color: #cbd5e1; font-size: 0.95rem;">
                            <li style="margin-bottom: 10px;"><i class="fa-solid fa-hard-drive"
                                    style="color: #60a5fa; width: 25px;"></i> <strong style="color:#f8fafc;">Salud del Almacenamiento:</strong>
                                Detectamos sectores defectuosos en tu HDD o SSD.</li>
                            <li style="margin-bottom: 10px;"><i class="fa-solid fa-memory"
                                    style="color: #60a5fa; width: 25px;"></i> <strong style="color:#f8fafc;">Test de Memoria RAM:</strong>
                                Evita pantallas azules por RAM defectuosa.</li>
                            <li><i class="fa-solid fa-temperature-full" style="color: #60a5fa; width: 25px;"></i>
                                <strong style="color:#f8fafc;">Temperaturas de CPU/GPU:</strong> Monitoreo para detectar problemas de
                                enfriamiento.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="row"
                style="display: flex; flex-wrap: wrap; gap: 40px; align-items: center; background: linear-gradient(135deg, rgba(30,41,59,0.8) 0%, rgba(15,23,42,0.9) 100%); padding: 40px; border-radius: 24px; border: 1px solid rgba(99,102,241,0.2);">
                <div class="col" style="flex: 1; min-width: 300px;">
                    <h2 style="font-size: 2rem; color: #818cf8; margin-bottom: 20px;">Servicio Técnico de Software
                        Online 100% Transparente</h2>
                    <p style="color: #cbd5e1; font-size: 1.05rem; line-height: 1.7; margin-bottom: 20px;">
                        Ofrecemos nuestro servicio de <strong style="color:#f8fafc;">limpieza de virus, reparación de software y aceleración de
                            PC de forma 100% remota</strong> a nivel internacional, utilizando herramientas seguras como
                        TeamViewer o AnyDesk.
                    </p>
                    <p style="color: #cbd5e1; font-size: 1.05rem; line-height: 1.7;">
                        Tú observas cada clic en tiempo real. Es el equivalente a tener a un experto en optimización
                        gaming sentado junto a ti, configurando tu registro, perfiles de energía, y eliminando malware
                        al instante, sin importar en qué ciudad o país residas.
                    </p>
                </div>
                <div class="col" style="flex: 1; min-width: 300px; text-align: center;">
                    <i class="fa-solid fa-network-wired" style="font-size: 6rem; color: #60a5fa; opacity: 0.8;"></i>
                </div>
            </div>

            <div style="margin-top: 60px;">
                <h3 style="font-size: 1.5rem; color: #f1f5f9; margin-bottom: 20px; text-align: center;">Beneficios Clave
                    de una PC Optimizada</h3>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
                    <div
                        style="background: rgba(30,41,59,0.5); border: 1px solid rgba(99,102,241,0.2); padding: 20px; border-radius: 12px; text-align: center;">
                        <i class="fa-solid fa-bolt" style="font-size: 2rem; color: #fcd34d; margin-bottom: 15px;"></i>
                        <h4 style="font-size: 1.1rem; color: #f8fafc; margin-bottom: 10px;">Mayor Fluidez</h4>
                        <p style="color: #94a3b8; font-size: 0.9rem;">Aplicaciones y navegadores responden de inmediato,
                            sin trabas frustrantes.</p>
                    </div>
                    <div
                        style="background: rgba(30,41,59,0.5); border: 1px solid rgba(99,102,241,0.2); padding: 20px; border-radius: 12px; text-align: center;">
                        <i class="fa-solid fa-gamepad"
                            style="font-size: 2rem; color: #a78bfa; margin-bottom: 15px;"></i>
                        <h4 style="font-size: 1.1rem; color: #f8fafc; margin-bottom: 10px;">FPS Más Altos</h4>
                        <p style="color: #94a3b8; font-size: 0.9rem;">Eliminamos el stuttering y aumentamos los cuadros
                            por segundo en tus juegos favoritos.</p>
                    </div>
                    <div
                        style="background: rgba(30,41,59,0.5); border: 1px solid rgba(99,102,241,0.2); padding: 20px; border-radius: 12px; text-align: center;">
                        <i class="fa-solid fa-shield-halved"
                            style="font-size: 2rem; color: #34d399; margin-bottom: 15px;"></i>
                        <h4 style="font-size: 1.1rem; color: #f8fafc; margin-bottom: 10px;">Mayor Privacidad</h4>
                        <p style="color: #94a3b8; font-size: 0.9rem;">Desactivamos la telemetría oculta que envía tus
                            datos de uso y consume ancho de banda.</p>
                    </div>
                    <div
                        style="background: rgba(30,41,59,0.5); border: 1px solid rgba(99,102,241,0.2); padding: 20px; border-radius: 12px; text-align: center;">
                        <i class="fa-solid fa-hourglass-start"
                            style="font-size: 2rem; color: #60a5fa; margin-bottom: 15px;"></i>
                        <h4 style="font-size: 1.1rem; color: #f8fafc; margin-bottom: 10px;">Inicio Rápido</h4>
                        <p style="color: #94a3b8; font-size: 0.9rem;">Tu computadora encenderá en segundos y estará
                            lista para usarse de inmediato.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

  <Footer />
</Base>

<script>
  const params = new URLSearchParams(window.location.search);
  const section = params.get('section');
  if (section) { const target = document.getElementById(section); if (target) setTimeout(() => target.scrollIntoView({ behavior: 'smooth' }), 300); }
  if (window.location.hash) { const target = document.querySelector(window.location.hash); if (target) setTimeout(() => target.scrollIntoView({ behavior: 'smooth' }), 300); }
</script>
