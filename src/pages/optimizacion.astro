    font-size: 0.82rem;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .opt-telemetry-label {
    color: #94a3b8 !important;
  }

  .opt-telemetry-val {
    font-family: monospace;
    font-size: 0.95rem;
    font-weight: 800;
  }

  .opt-progress-track {
    width: 100%;
    height: 8px;
    background: #1e293b;
    border-radius: 4px;
    overflow: hidden;
  }

  .opt-progress-bar {
    height: 100%;
    border-radius: 4px;
  }

  .opt-bar-fps {
    background: linear-gradient(90deg, #2563eb, #38bdf8);
  }

  .opt-bar-low {
    background: linear-gradient(90deg, #059669, #10b981);
  }

  .opt-sparkline-wrap {
    height: 36px;
    background: #1e293b;
    border-radius: 6px;
    overflow: hidden;
  }

  .opt-sparkline-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .opt-telemetry-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-top: 18px;
    margin-bottom: 16px;
  }

  .opt-metric-pill {
    background: #1e293b;
    border: 1px solid #334155;
    padding: 8px 6px;
    border-radius: 8px;
    text-align: center;
  }

  .opt-metric-pill__lbl {
    display: block;
    font-size: 0.68rem;
    font-weight: 700;
    color: #64748b !important;
    margin-bottom: 2px;
  }

  .opt-metric-pill__val {
    font-size: 0.85rem;
    font-weight: 800;
    color: #e2e8f0 !important;
