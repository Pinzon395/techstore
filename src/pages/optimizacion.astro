    font-weight: 700;
    color: #38bdf8 !important;
    margin-bottom: 8px;
  }

  .opt-lab-panel__footer span {
    color: #38bdf8 !important;
  }

  .opt-lab-panel__disclaimer {
    font-size: 0.72rem;
    color: #64748b !important;
    line-height: 1.4;
    margin: 0;
  }

  /* 2. SECTION COMMONS */
  .opt-section {
    padding: 65px 0;
  }

  .opt-section--white {
    background: #ffffff;
  }

  .opt-section--light {
    background: #f8fafc;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .opt-section-header {
    max-width: 820px;
    margin: 0 auto 40px;
  }

  .opt-section-badge {
    display: inline-block;
    padding: 4px 12px;
    background: rgba(37, 99, 235, 0.1);
    color: #2563eb !important;
    border: 1px solid rgba(37, 99, 235, 0.25);
    border-radius: 16px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .opt-section-badge--cyan {
