---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ServiceTicketSection from '../components/ServiceTicketSection.astro';
import CommentsSection from '../components/CommentsSection.astro';

const canonicalUrl = 'https://pixon.com.mx/optimizacion';

const problems = [
  {
    id: 'bajos-fps',
    badge: '01 · FPS',
    title: 'Bajos FPS',
    desc: 'Tu hardware parece suficiente, pero obtienes menos FPS de los esperados para tu procesador y tarjeta gráfica.',
    icon: 'fa-chart-line'
  },
  {
    id: 'fps-drops',
    badge: '02 · DROPS',
    title: 'FPS Drops',
    desc: 'El juego empieza fluido y de repente cae drásticamente en peleas, zonas abiertas o giros rápidos de cámara.',
    icon: 'fa-arrow-trend-down'
  },
  {
    id: 'stuttering',
    badge: '03 · PACING',
    title: 'Stuttering',
    desc: 'Tienes FPS promedio altos, pero el juego se siente trabado, con microtirones y frametimes irregulares.',
    icon: 'fa-wave-square'
  },
  {
    id: 'input-lag',
    badge: '04 · LATENCIA',
    title: 'Input Lag',
    desc: 'Mouse, teclado o monitor responden tarde. Sientes pesadez al apuntar o disparar en partidas competitivas.',
    icon: 'fa-computer-mouse'
  },
  {
    id: 'pc-lenta',
    badge: '05 · WINDOWS',
    title: 'PC Lenta',
    desc: 'Windows tarda en arrancar, se congela al abrir aplicaciones o satura recursos con procesos en segundo plano.',
    icon: 'fa-clock-rotate-left'
  },
  {
    id: 'gpu-poco-uso',
    badge: '06 · CARGA GPU',
    title: 'GPU con poco uso',
    desc: 'La tarjeta gráfica trabaja al 40%–60% mientras los FPS se estancan y no suben aunque bajes la calidad gráfica.',
    icon: 'fa-microchip'
  },
  {
    id: 'cpu-100',
    badge: '07 · CARGA CPU',
    title: 'CPU al 100%',
    desc: 'El procesador satura sus núcleos, provocando frametimes inestables, tirones constantes y limitación de gráficos.',
    icon: 'fa-gauge-high'
  },
  {
    id: 'ping-jitter',
    badge: '08 · RED',
    title: 'Ping / Jitter / Packet Loss',
    desc: 'Internet parece rápido en tests de velocidad, pero sufres picos de ping, teletransporte o pérdida de paquetes.',
    icon: 'fa-network-wired'
  }
];

const checkStack = [
  { step: '01', title: 'HARDWARE', items: 'CPU · GPU · RAM · SSD · voltajes · curvas térmicas y temperaturas' },
  { step: '02', title: 'WINDOWS', items: 'Procesos de fondo · inicio · servicios · planes de energía · integridad DISM/SFC' },
  { step: '03', title: 'DRIVERS', items: 'NVIDIA · AMD · Intel · chipset de motherboard · audio · adaptadores de red' },
  { step: '04', title: 'GAMING', items: 'Ajustes gráficos · FPS cap · VRAM · shaders · frame pacing · motores de juego' },
  { step: '05', title: 'INPUT & DISPLAY', items: 'Mouse · teclado · polling rate · puertos USB · frecuencia Hz del monitor' },
  { step: '06', title: 'NETWORK', items: 'Ping local · jitter · pérdida de paquetes · bufferbloat · adaptador Ethernet/WiFi' },
  { step: '07', title: 'STREAMING', items: 'OBS Studio · codificador NVENC/AMF/AV1 · overlays · replay buffer · bitrates' }
];

const gamesGroups = [
  {
    category: 'COMPETITIVE FPS',
    games: 'Valorant · Counter-Strike 2 · Fortnite · Warzone · Apex Legends · Rainbow Six Siege · Overwatch 2 · Marvel Rivals',
    note: 'Priorizamos frametimes planos, 1% lows elevados, mínima latencia DPC, polling rate estable y eliminación de procesos que saturan los hilos del CPU.'
  },
  {
    category: 'OPEN WORLD & MULTIPLAYER',
    games: 'GTA V / FiveM · Rust · Minecraft · Forza Horizon · Cyberpunk 2077',
    note: 'Ajustamos la gestión de VRAM, velocidad de lectura de texturas en SSD, estabilidad de memoria RAM en mapas masivos y compilación de shaders.'
  },
  {
    category: 'ESPORTS & OTROS',
    games: 'League of Legends · Rocket League · EA Sports FC · Juegos de Steam, Epic y Xbox PC',
    note: 'Configuramos sincronización de cuadros, límites de tasa de refresco, perfiles de energía sin micro-dormencias y compatibilidad de controladores.'
  }
];

const faqs = [
  {
    q: '¿Por qué mi PC tiene pocos FPS si tiene buena GPU?',
    a: 'Tener una buena tarjeta gráfica no garantiza altos FPS si existe un cuello de botella en el procesador, si la memoria RAM trabaja en single channel o a baja frecuencia sin XMP/EXPO, si hay thermal throttling por temperaturas altas, o si Windows tiene procesos consumiendo hilos de ejecución en segundo plano.'
  },
  {
    q: '¿Por qué mi GPU no llega al 100% de uso en juegos?',
    a: 'Si la tarjeta gráfica trabaja al 40%–70% y los FPS no son suficientes, generalmente el procesador no puede suministrar fotogramas con la rapidez requerida (cuello de botella de CPU), la memoria RAM tiene latencia elevada, el juego tiene un límite de FPS activado o la resolución es muy baja (1080p competitivo suele depender fuertemente de CPU y RAM).'
  },
  {
    q: '¿Por qué mi CPU está al 100% mientras juego?',
    a: 'Un procesador al 100% indica saturación total de núcleos e hilos. Ocurre por aplicaciones en segundo plano (grabación, navegadores, antivirus pesado), juegos con alta carga de físicas y entidades, shaders compilando en tiempo real o procesadores con pocos hilos frente a títulos modernos.'
  },
  {
    q: '¿Por qué tengo stuttering si mi contador marca FPS altos?',
    a: 'El stuttering (microtirones) ocurre por inconsistencia en el frametime, no por el promedio de FPS. Si tienes 140 FPS promedio pero cada dos segundos un cuadro tarda 35 ms en generarse (equivalente a 28 FPS instantáneos), el ojo percibe un corte molesto. Se soluciona estabilizando el frametime y elevando los 1% lows.'
  },
  {
    q: '¿Qué son los 1% lows y por qué importan más que los FPS máximos?',
    a: 'Los 1% lows representan el promedio del 1% de fotogramas más lentos durante una partida. Indican qué tan graves son las caídas en momentos críticos (explosiones, peleas de equipos). Un juego con 140 FPS y 1% low de 110 FPS se siente infinitamente más suave que uno con 200 FPS y 1% low de 40 FPS.'
  },
  {
    q: '¿Qué es el frametime?',
    a: 'El frametime es el tiempo exacto en milisegundos que tarda la computadora en renderizar y mostrar un único fotograma. A 60 FPS cada cuadro debe durar 16.6 ms; a 144 FPS, 6.9 ms. Si la línea de frametime es plana, la fluidez es perfecta; si tiene picos oscilantes, se perciben tirones.'
  },
  {
    q: '¿Cómo se reduce el input lag de forma real?',
    a: 'Se reduce asegurando que el monitor opere a su tasa máxima de hercios en Windows, limitando los FPS justo por debajo de la tasa de refresco (para no saturar el buffer de la GPU ni activar V-Sync tardío), usando tecnologías de sincronización de baja latencia (NVIDIA Reflex / AMD Anti-Lag), configurando el polling rate del mouse y evitando hubs USB saturados.'
  },
  {
    q: '¿Se puede optimizar una PC de gama baja?',
    a: 'Sí. En procesadores modestos, gráficos integrados (APU Ryzen o Intel UHD) y 8 GB de RAM, cada megabyte y ciclo de reloj cuenta. Eliminamos bloatware, optimizamos la memoria virtual, ajustamos VRAM compartida y configuramos tecnologías de reescalado como FSR para lograr estabilidad sin gastar en piezas nuevas.'
  },
  {
    q: '¿Vale la pena optimizar una PC de gama alta?',
    a: 'Totalmente. Muchas PCs con RTX 4070/4080 o procesadores Ryzen X3D rinden entre 15% y 30% por debajo de su potencial por RAM sin XMP, Resizable BAR desactivado en BIOS, overlays conflictivos de Discord/Steam, perfiles de energía mal asignados o pantallas de 240 Hz operando a 60 Hz en Windows.'
  },
  {
    q: '¿Por qué mi laptop gamer rinde menos conectada o se calienta tanto?',
    a: 'Las laptops gamer operan en chasis térmicamente limitados. Revisamos los modos de energía del fabricante, el switch MUX para saltar la GPU integrada (evitando el cuello de botella de Optimus), curvas de ventilación y desactivamos bloatware de monitoreo que compite por recursos de CPU.'
  },
  {
    q: '¿Por qué pierdo tantos FPS al grabar o hacer streaming con OBS?',
    a: 'Generalmente ocurre por codificar mediante CPU (x264) en lugar de utilizar el codificador dedicado por hardware de la GPU (NVENC, AMF o QuickSync), o por ejecutar OBS sin permisos de administrador (lo que impide que Windows otorgue prioridad de GPU al renderizador de la escena).'
  },
  {
    q: '¿Pueden arreglar mi ping en juegos online?',
    a: 'Podemos diagnosticar y corregir problemas dentro de tu PC y red local (bufferbloat, drivers de red, descargas de fondo, configuración del adaptador y estabilidad por cable Ethernet). Sin embargo, la distancia física al servidor del juego y las rutas de tu proveedor de internet (ISP) no pueden alterarse por software.'
  },
  {
    q: '¿Funciona para juegos como Valorant, Fortnite, Warzone, CS2 o FiveM?',
    a: 'Sí. Cada juego exige recursos de manera diferente. Ajustamos la configuración específica según el motor del juego: Warzone requiere gestión estricta de VRAM y shaders; Valorant y CS2 dependen de CPU y latencia DPC; Fortnite requiere optimización del modo de renderizado y compilación de texturas.'
  },
  {
    q: '¿Necesitan acceso a mis archivos personales o contraseñas?',
    a: 'No. No solicitamos ni accedemos a carpetas personales, fotos, documentos ni contraseñas. Toda la sesión se enfoca exclusivamente en herramientas de diagnóstico, panel de control de Windows, controladores y configuración de juegos.'
  },
  {
    q: '¿Puedo ver todo lo que hace el técnico en pantalla?',
    a: 'Sí, el 100% de la sesión es interactiva y visible en tu monitor en tiempo real. Tú ves cada ventana que se abre, cada medición y puedes tomar el control del mouse o finalizar la llamada y conexión en el segundo que desees.'
  },
  {
    q: '¿Necesito formatear o reinstalar Windows para que rinda bien?',
    a: 'En la gran mayoría de los casos no es necesario reinstalar. Limpiamos procesos, reparamos integridad de archivos de sistema con DISM/SFC y actualizamos controladores. Solo recomendamos reinstalación limpia si el sistema presenta corrupción irrecuperable de registro o daños severos por malware.'
  },
  {
    q: '¿La optimización remota puede dañar mi computadora?',
    a: 'No. No aplicamos modificaciones de voltaje riesgosas ni configuraciones fuera de las especificaciones seguras de los fabricantes. Cualquier ajuste avanzado (como undervolt térmico) se somete a pruebas de estrés de estabilidad térmica y de memoria antes de finalizar.'
  },
  {
    q: '¿Cuánto tiempo dura una sesión de optimización remota?',
    a: 'Una sesión típica toma entre 60 y 90 minutos según el paquete elegido. Incluye la medición previa de rendimiento (benchmark inicial), la aplicación paso a paso de los ajustes y la prueba final de verificación comparativa.'
  }
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${canonicalUrl}#service`,
    name: 'Optimización de PC Gaming Remota',
    serviceType: 'Remote PC Performance Tuning and Gaming Optimization',
    description: 'Servicio técnico remoto mundial de optimización de computadoras para videojuegos y Windows 10/11. Diagnóstico de bajos FPS, frametimes, stuttering, input lag y cuellos de botella.',
    provider: {
      '@type': 'LocalBusiness',
      name: 'Pixon PC',
      url: 'https://pixon.com.mx',
      telephone: '+529986690777',
      email: 'pixonpc@gmail.com',
      image: 'https://pixon.com.mx/LOGOCIRCULAR.png'
    },
    areaServed: [
      { '@type': 'Country', name: 'Worldwide' },
      { '@type': 'Country', name: 'Mexico' },
      { '@type': 'Country', name: 'Spain' },
      { '@type': 'Country', name: 'United States' },
      { '@type': 'Country', name: 'Argentina' },
      { '@type': 'Country', name: 'Colombia' },
      { '@type': 'Country', name: 'Chile' },
      { '@type': 'Country', name: 'Peru' }
    ],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Paquetes de Optimización Remota de PC',
      itemListElement: [
        {
          '@type': 'Offer',
          name: 'PC Speed (Trabajo y Productividad)',
          price: '20',
          priceCurrency: 'USD',
          description: 'Optimización de Windows 10/11, inicio, servicios, procesos de fondo, almacenamiento y fluidez.'
        },
        {
          '@type': 'Offer',
          name: 'Gaming Performance (Principal)',
          price: '40',
          priceCurrency: 'USD',
          description: 'Optimización integral para juegos: FPS, 1% lows, frametime, drivers, input lag, monitor Hz y benchmark before/after.'
        },
        {
          '@type': 'Offer',
          name: 'Advanced Tuning (Entusiastas)',
          price: '75',
          priceCurrency: 'USD',
          description: 'Todo lo de Gaming Performance más BIOS guiada (XMP/EXPO, Resizable BAR), análisis térmico profundo y pruebas de estabilidad.'
        }
      ]
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://pixon.com.mx/' },
      { '@type': 'ListItem', position: 2, name: 'Optimización de PC Gaming Remota', item: canonicalUrl }
    ]
  }
];
---

<Base
  title="Optimización PC Gaming Remota | FPS, Stuttering y Lag | Pixon PC"
  description="Optimización remota de PC Gaming y Windows 10/11. Diagnosticamos bajos FPS, stuttering, input lag, CPU/GPU, RAM, drivers, temperaturas y red. Servicio remoto mundial."
  canonical={canonicalUrl}
  schema={schema}
>
  <Navbar />

  <main id="main-content" class="opt-page">
    <div class="container opt-breadcrumb-wrap">
      <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Optimización PC Gaming Remota' }]} />
    </div>

    <!-- =========================================================================
         1. HERO SECTION: REMOTE PERFORMANCE LAB
    ========================================================================== -->
    <header class="opt-hero" aria-labelledby="hero-title">
      <div class="container opt-hero__grid">
        <!-- Hero Left Column -->
        <div class="opt-hero__content">
          <div class="opt-hero__eyebrow">
            <span class="opt-pulse-dot" aria-hidden="true"></span>
            <span>REMOTE PERFORMANCE LAB · PIXON PC</span>
          </div>

          <h1 id="hero-title" class="opt-hero__title">
            Optimización de PC Gaming Remota: corrige bajos FPS, stuttering, input lag y una PC que no rinde
          </h1>

          <p class="opt-hero__lead">
            Diagnóstico y optimización personalizada para PC de gama baja, media y alta. Revisamos Windows, CPU, GPU, RAM, drivers, temperaturas, red, periféricos y la configuración de tus juegos.
          </p>

          <p class="opt-hero__sublead">
            Tú ves el proceso completo en tu pantalla en tiempo real y comparamos el rendimiento antes y después con mediciones precisas.
          </p>

          <!-- Badges Grid -->
          <div class="opt-hero__badges" aria-label="Garantías del servicio">
            <div class="opt-badge">
              <i class="fa-solid fa-globe" aria-hidden="true"></i>
              <span>Servicio remoto mundial</span>
            </div>
            <div class="opt-badge">
              <i class="fa-brands fa-windows" aria-hidden="true"></i>
              <span>Windows 10 / 11</span>
            </div>
            <div class="opt-badge">
              <i class="fa-solid fa-language" aria-hidden="true"></i>
              <span>Español / English</span>
            </div>
            <div class="opt-badge">
              <i class="fa-solid fa-chart-simple" aria-hidden="true"></i>
              <span>Medición antes y después</span>
            </div>
          </div>

          <!-- Hero CTAs -->
          <div class="opt-hero__actions">
            <a href="#diagnostico" class="opt-btn opt-btn--primary">
              <i class="fa-solid fa-stethoscope" aria-hidden="true"></i> Diagnosticar mi PC
            </a>
            <a href="#que-revisamos" class="opt-btn opt-btn--secondary">
              <i class="fa-solid fa-microchip" aria-hidden="true"></i> Ver qué revisamos
            </a>
          </div>
        </div>

        <!-- Hero Right Column: Laboratory Telemetry Panel (CSS/SVG) -->
        <div class="opt-hero__visual" aria-hidden="true">
          <div class="opt-lab-panel">
            <div class="opt-lab-panel__header">
              <div class="opt-lab-panel__title-group">
                <span class="opt-lab-panel__terminal-dot"></span>
                <span class="opt-lab-panel__title">PIXON PERFORMANCE ANALYSIS</span>
              </div>
              <span class="opt-lab-panel__status-pill">LIVE TELEMETRY</span>
            </div>

            <!-- Telemetry Metrics Bars -->
            <div class="opt-telemetry-block">
              <div class="opt-telemetry-row">
                <span class="opt-telemetry-label">FPS PROMEDIO</span>
                <span class="opt-telemetry-val opt-color-cyan">147</span>
              </div>
              <div class="opt-progress-track">
                <div class="opt-progress-bar opt-bar-fps" style="width: 82%;"></div>
              </div>
            </div>

            <div class="opt-telemetry-block">
              <div class="opt-telemetry-row">
                <span class="opt-telemetry-label">1% LOW (ESTABILIDAD)</span>
                <span class="opt-telemetry-val opt-color-emerald">103</span>
              </div>
              <div class="opt-progress-track">
                <div class="opt-progress-bar opt-bar-low" style="width: 68%;"></div>
              </div>
            </div>

            <div class="opt-telemetry-block">
              <div class="opt-telemetry-row">
                <span class="opt-telemetry-label">FRAME TIME (CONSISTENCIA)</span>
                <span class="opt-telemetry-val opt-color-cyan">6.8 ms</span>
              </div>
              <div class="opt-sparkline-wrap">
                <svg viewBox="0 0 300 36" class="opt-sparkline-svg">
                  <path d="M 0 18 Q 40 16 80 18 T 160 17 T 240 18 T 300 17" fill="none" stroke="#38bdf8" stroke-width="2.5" />
                  <path d="M 0 18 Q 40 16 80 18 T 160 17 T 240 18 T 300 17 L 300 36 L 0 36 Z" fill="rgba(56, 189, 248, 0.08)" />
                </svg>
              </div>
            </div>

            <!-- Hardware Telemetry Matrix -->
            <div class="opt-telemetry-grid">
              <div class="opt-metric-pill">
                <span class="opt-metric-pill__lbl">GPU LOAD</span>
                <span class="opt-metric-pill__val">73%</span>
              </div>
              <div class="opt-metric-pill">
                <span class="opt-metric-pill__lbl">CPU LOAD</span>
                <span class="opt-metric-pill__val">61%</span>
              </div>
              <div class="opt-metric-pill">
                <span class="opt-metric-pill__lbl">RAM</span>
                <span class="opt-metric-pill__val">12.4 GB</span>
              </div>
              <div class="opt-metric-pill">
                <span class="opt-metric-pill__lbl">PING</span>
                <span class="opt-metric-pill__val">38 ms</span>
              </div>
            </div>

            <!-- Bottom Analysis Status -->
            <div class="opt-lab-panel__footer">
              <i class="fa-solid fa-magnifying-glass-chart" aria-hidden="true"></i>
              <span>ANALYZING BOTTLENECK · HARDWARE RECOGNIZED</span>
            </div>
            <p class="opt-lab-panel__disclaimer">
              Visualización técnica conceptual. En cada sesión medimos la telemetría real de tu equipo antes y después.
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- =========================================================================
         2. SECTION: PROBLEM SELECTOR ("¿Qué le pasa a tu PC?")
    ========================================================================== -->
    <section class="opt-section opt-section--white" id="problemas-frecuentes">
      <div class="container">
        <div class="opt-section-header text-center">
          <span class="opt-section-badge">DIAGNÓSTICO INICIAL</span>
          <h2>¿Qué le pasa a tu PC?</h2>
          <p class="opt-section-desc">
            Identifica el síntoma principal que experimentas en tus juegos o en Windows para atacar la causa raíz correcta.
          </p>
        </div>

        <div class="opt-problems-grid">
          {problems.map((p) => (
            <article class="opt-problem-card">
              <div class="opt-problem-card__top">
                <span class="opt-problem-card__badge">{p.badge}</span>
                <i class={`fa-solid ${p.icon} opt-problem-card__icon`} aria-hidden="true"></i>
              </div>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- =========================================================================
         3. SECTION: TU PC ES BUENA PERO NO RINDE
    ========================================================================== -->
    <section class="opt-section opt-section--light" id="cuello-de-botella">
      <div class="container">
        <div class="opt-section-header">
          <span class="opt-section-badge">ANÁLISIS DE HARDWARE</span>
          <h2>Tu PC Gamer tiene buen hardware. ¿Por qué no está rindiendo?</h2>
          <p class="opt-section-desc">
            Muchos usuarios compran tarjetas gráficas potentes y procesadores modernos pero sufren caídas de cuadros. No asumimos que necesitas gastar en piezas nuevas: primero auditamos qué factor está limitando el sistema.
          </p>
        </div>

        <div class="opt-two-col-grid">
          <div class="opt-two-col-content">
            <p>
              Un equipo de alto rendimiento es una cadena sincronizada. Si un solo eslabón falla, el rendimiento general se desploma. Entre los factores más comunes que encontramos en diagnóstico destacan:
            </p>
            <ul class="opt-check-list">
              <li><strong>Memoria RAM en Single Channel o a frecuencia base:</strong> Perfiles XMP o EXPO apagados en BIOS provocan que memorias DDR4/DDR5 funcionen a velocidades mínimas de fábrica, castigando los 1% lows.</li>
              <li><strong>Resizable BAR desactivado:</strong> La GPU no puede acceder a toda la memoria de video de forma directa desde la CPU, perdiendo entre 5% y 15% de FPS en juegos modernos.</li>
              <li><strong>Cuello de botella de CPU (CPU Bottleneck):</strong> La tarjeta gráfica trabaja al 40%–60% porque el procesador o sus hilos principales están saturados por tareas de fondo.</li>
              <li><strong>Thermal Throttling:</strong> Temperaturas superiores a 85°C–90°C obligan a procesadores y GPUs a bajar automáticamente sus frecuencias para evitar daños físicos.</li>
              <li><strong>Límites de energía y BIOS desactualizada:</strong> Perfiles de placa madre que limitan el consumo o no entregan estabilidad a los núcleos modernos.</li>
              <li><strong>Configuración incorrecta de monitor:</strong> Pantallas de 144 Hz o 240 Hz configuradas por error a 60 Hz en el panel de Windows.</li>
            </ul>
          </div>

          <!-- Visual Comparison: CPU vs GPU Bottleneck -->
          <div class="opt-two-col-visual" aria-label="Comparación de cuello de botella CPU frente a GPU">
            <div class="opt-case-card">
              <div class="opt-case-card__header">
                <span class="opt-case-tag opt-case-tag--warning">CASO A · CUELLO DE BOTELLA DE CPU</span>
              </div>
              <div class="opt-case-metrics">
                <div class="opt-case-metric">
                  <span class="opt-case-metric__label">CPU LOAD</span>
                  <strong class="opt-case-metric__val text-danger">98% (Saturado)</strong>
                </div>
                <div class="opt-case-metric">
                  <span class="opt-case-metric__label">GPU LOAD</span>
                  <strong class="opt-case-metric__val text-muted">54% (Subutilizada)</strong>
                </div>
              </div>
              <p class="opt-case-summary">
                La tarjeta gráfica espera datos del procesador. El juego presenta tirones bruscos y bajar los gráficos no incrementa los FPS.
              </p>
            </div>

            <div class="opt-case-card mt-3">
              <div class="opt-case-card__header">
                <span class="opt-case-tag opt-case-tag--success">CASO B · CARGA BALANCEADA EN GPU</span>
              </div>
              <div class="opt-case-metrics">
