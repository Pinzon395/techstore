    border-radius: 14px;
    padding: 24px;
    position: relative;
  }

  .opt-remote-step__num {
    width: 36px;
    height: 36px;
    background: #eff6ff;
    color: #2563eb !important;
    font-weight: 800;
    border-radius: 50%;
