const topicVisuals = [
  { metric: '1% LOW', symbols: ['fa-gauge-high', 'fa-microchip', 'fa-display'] },
  { metric: 'FRAME TIME', symbols: ['fa-wave-square', 'fa-stopwatch', 'fa-hard-drive'] },
  { metric: 'RESPUESTA', symbols: ['fa-computer-mouse', 'fa-keyboard', 'fa-desktop'] },
