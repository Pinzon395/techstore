import FaqSection from '../components/FaqSection.astro';
import CommentsSection from '../components/CommentsSection.astro';
import ServiceTicketSection from '../components/ServiceTicketSection.astro';

const faqs = [
  { question: `¿Mi PC ganará velocidad real con la optimización?`, answer: `Sí, cuando la lentitud viene de software, arranque saturado, malware, drivers o procesos en segundo plano. En equipos con disco mecánico la mejora por software tiene límite; si detectamos que el cuello de botella es hardware, te recomendamos SSD o RAM antes de prometer resultados irreales.` },
  { question: `¿Necesito comprar componentes nuevos?`, answer: `No siempre. La optimización básica limpia software, arranque, temporales, malware y servicios innecesarios sin tocar hardware. Si tu equipo sigue limitado por disco duro, poca RAM o temperatura, te explicamos qué componente sí cambiaría el rendimiento y cuál no vale la pena.` },
  { question: `¿Cuánto tiempo dura el efecto?`, answer: `Si mantienes buenos hábitos, no instalas software basura y mantienes protección activa, el efecto puede durar de 12 a 18 meses. Si el equipo se usa para gaming, descargas pesadas o muchas apps, conviene mantenimiento peri?dico para evitar que vuelva la lentitud.` },
  { question: `¿Pierdo mis programas o archivos?`, answer: `No. La optimización conserva tus archivos y programas; solo eliminamos basura, malware, temporales y procesos innecesarios. Si alguna acción pudiera afectar datos, configuración o sesiones, te lo avisamos antes de ejecutarla para que autorices.` },
  { question: `¿La optimización siempre aumenta los FPS?`, answer: `No prometemos una cifra fija. Puede mejorar estabilidad, uso de CPU, procesos de fondo y configuración, pero el límite final depende de procesador, tarjeta gráfica, RAM, temperatura, resolución y del propio juego.` },
  { question: `¿Pueden bajar mi ping desde Windows?`, answer: `Podemos corregir procesos que consumen red, drivers, WiFi, configuración y pérdida de paquetes local. No podemos reducir la distancia al servidor ni resolver saturación o rutas externas del proveedor de internet.` },
  { question: `¿También optimizan teclado, mouse y monitor para gaming?`, answer: `Sí. Revisamos frecuencia del monitor, V-Sync, límites de FPS, polling rate, aceleración del mouse, conexión USB y configuraciones que pueden aumentar la sensación de retraso.` },
];

