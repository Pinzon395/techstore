  .opt-price-badge {
    font-size: 0.72rem;
    font-weight: 800;
    color: #64748b !important;
    background: #f1f5f9;
    padding: 3px 8px;
    border-radius: 6px;
    display: inline-block;
    margin-bottom: 8px;
