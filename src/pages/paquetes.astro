---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AlertBox from '../components/AlertBox.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FaqSection from '../components/FaqSection.astro';
import CommentsSection from '../components/CommentsSection.astro';

const faqs = [
  { question: '¿Cuál es la diferencia entre el paquete Estándar y Pro Gamer?', answer: 'El paquete Estándar es para equipos de uso cotidiano (navegación, office). El Pro Gamer incluye limpieza de GPU, cambio de thermal pads y pasta térmica premium para equipos de uso intensivo como gaming o edición de video.' },
  { question: '¿Cada cuánto necesita mantenimiento mi equipo?', answer: 'En Cancún, por la humedad y el salitre, recomendamos cada 6 a 8 meses. En ambientes climatizados y secos puede estirarse hasta 12 meses.' },
  { question: '¿Hay garantía sobre los paquetes?', answer: 'Sí. Todos los paquetes incluyen garantía por escrito. Si tu equipo sale con fallas atribuibles al servicio, lo corregimos sin costo adicional. El plazo varía: 30 días Estándar, 60 días Pro, 90 días Elite.' },
  { question: '¿Tienen paquetes para empresas?', answer: 'Sí. Contamos con paquetes B2B para lotes de 6, 12 o más equipos con precios por volumen. Ideal para hoteles, agencias de viaje y oficinas en Cancún.' },
  { question: '¿Cuánto tarda cada servicio?', answer: 'Estándar: 2-4 horas mismo día. Pro Gamer: 24-48 horas. Elite: 2-4 días (incluye documentación detallada antes/después).' },
  { question: '¿Recolectan a domicilio?', answer: 'Sí, sin costo en Cancún para cualquier paquete. Coordinamos por WhatsApp horario de recolección y entrega en menos de 24 horas.' },
];
