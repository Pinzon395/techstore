---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Footer from '../components/Footer.astro';
import AlertBox from '../components/AlertBox.astro';
import FaqSection from '../components/FaqSection.astro';
import CommentsSection from '../components/CommentsSection.astro';
import ServiceTicketSection from '../components/ServiceTicketSection.astro';

const faqs = [
  { question: '¿Atienden empresas en la Zona Hotelera de Cancún?', answer: 'Sí. Atendemos empresas, oficinas y hoteles en la Zona Hotelera según agenda, tipo de servicio y cantidad de equipos. Para flotillas o soporte recurrente podemos coordinar visitas programadas, recepción por lote o atención por prioridad cuando la operación del negocio depende del equipo.' },
  { question: '¿Emiten factura CFDI?', answer: 'Sí. Emitimos CFDI 4.0 para empresas que necesitan facturar mantenimiento, soporte técnico, reparaciones, pólizas de servicio o trabajos por lote. También podemos entregar descripción clara del servicio para compras, administración o contabilidad.' },
  { question: '¿Pueden atender varios equipos al mismo tiempo?', answer: 'Sí. Trabajamos por lote para 5, 10, 20 o más equipos. Esto permite organizar tiempos, reducir costo por unidad y entregar reporte por equipo con diagnóstico, acciones realizadas y recomendaciones para futuras decisiones de TI.' },
  { question: '¿Tienen póliza mensual de soporte TI?', answer: 'Sí. Podemos ofrecer soporte mensual con mantenimiento preventivo, atención correctiva, canal directo y seguimiento según volumen de equipos. La póliza se arma según cantidad de laptops, PCs, impresoras, urgencia operativa y necesidad de atención en sitio.' },
  { question: '¿Atienden impresoras de oficina?', answer: 'Sí. Revisamos impresoras, atascos, tóner, tinta, conectividad, drivers, red e instalación compartida para varios usuarios. Es útil para oficinas, hoteles, despachos y comercios donde la impresión diaria impacta facturación, recepción o administración.' },
  { question: '¿El servicio es en sitio o en taller?', answer: 'Depende del plan, zona, cantidad de equipos y tipo de falla. Algunos servicios pueden hacerse en sitio, como configuración, red básica o revisión inicial; otros requieren taller para diagnóstico seguro, limpieza interna, reparación física o pruebas extendidas.' },
  { question: '¿Firman acuerdos de confidencialidad?', answer: 'Sí. Para empresas que manejan información sensible podemos trabajar con NDA o condiciones de confidencialidad. Esto aplica especialmente para despachos, hoteles, oficinas administrativas, equipos con datos de clientes o computadoras usadas por gerencia.' },
];

const localSearchNeeds = [
  {
    icon: 'fa-computer',
    title: 'Mantenimiento de computadoras para empresas en Cancun',
    text: 'Servicio para oficinas, hoteles, restaurantes, despachos y comercios que necesitan mantener PCs y laptops listas para trabajar todos los dias.'
  },
  {
    icon: 'fa-layer-group',
    title: 'Soporte TI por lote para 5, 10, 20 o mas equipos',
    text: 'Organizamos diagnostico, limpieza, optimizacion, formateo, instalacion de programas y reporte por equipo para flotillas empresariales.'
  },
  {
    icon: 'fa-print',
    title: 'Soporte de impresoras para oficina y negocio',
    text: 'Atendemos impresoras en red, drivers, atascos, toner, tinta, escaner e impresion compartida para areas administrativas.'
  },
  {
    icon: 'fa-network-wired',
    title: 'Red, WiFi y equipos compartidos',
    text: 'Revisamos puntos basicos de conectividad, impresoras compartidas, equipos lentos por red y configuraciones que frenan la operacion.'
  },
  {
    icon: 'fa-file-invoice-dollar',
    title: 'Factura CFDI y reportes para administracion',
    text: 'Documentamos diagnostico, acciones, recomendaciones, costo y cierre para compras, administracion, gerencia o contabilidad.'
  },
  {
    icon: 'fa-shield-halved',
    title: 'Soporte con confidencialidad para datos sensibles',
    text: 'Podemos trabajar con NDA o condiciones de confidencialidad para equipos con informacion de clientes, finanzas, reservas o direccion.'
  }
];

const businessZones = [
  'Zona Hotelera',
  'Centro de Cancun',
  'Av. Tulum',
  'Bonampak',
  'Puerto Cancun',
  'Cumbres',
  'Huayacan',
  'Bonfil',
  'Aeropuerto',
  'Parque Industrial',
  'Malecon Americas',
  'Plaza Las Americas',
  'Kabah',
  'Nichupte',
  'Region 97',
  'Region 510'
];

const businessScenarios = [
  { title: 'Hoteles y recepcion', text: 'Equipos de check-in, administracion, reservas, impresoras, escaner y estaciones que no pueden fallar en horas pico.' },
  { title: 'Oficinas administrativas', text: 'PCs, laptops, Windows, Office, correo, respaldos, impresoras y rendimiento estable para trabajo diario.' },
  { title: 'Restaurantes y comercios', text: 'Puntos de venta, impresoras, equipos de caja, laptops administrativas y soporte cuando una falla detiene ventas.' },
  { title: 'Despachos y consultorios', text: 'Equipos con informacion sensible, documentos, expedientes, facturacion, correo y respaldos con trato confidencial.' },
  { title: 'Escuelas y capacitacion', text: 'Mantenimiento por lote, instalacion de programas, optimizacion y preparacion de equipos para clases o laboratorios.' },
  { title: 'Agencias y turismo', text: 'Laptops de ventas, reservaciones, correo, impresoras y equipos administrativos con atencion local en Cancun.' }
];

const localSeoLinks = [
  { href: '/servicios/b2b/polizas-mantenimiento', label: 'Polizas de mantenimiento TI', text: 'Soporte recurrente, visitas programadas, tickets y reportes.' },
  { href: '/servicios/b2b/mantenimiento-flotilla', label: 'Mantenimiento de flotilla', text: 'Atencion por lote para computadoras, laptops e impresoras.' },
  { href: '/servicios/b2b/soporte-hoteles', label: 'Soporte TI para hoteles', text: 'Servicio para recepcion, administracion, reservas e impresoras.' },
  { href: '/servicios/redes/red-oficina', label: 'Redes y WiFi empresarial', text: 'Revision de conectividad, impresoras compartidas y red basica.' },
  { href: '/instalacion-windows', label: 'Instalacion de Windows', text: 'Preparacion de equipos nuevos o restaurados para personal.' },
  { href: '/servicios/impresora/conectividad', label: 'Impresoras de oficina', text: 'Drivers, atascos, toner, tinta, red y configuracion compartida.' }
];
---

<Base
  title="Soporte TI para empresas en Cancun | Mantenimiento B2B local"
  description="Soporte TI para empresas en Cancun: mantenimiento de computadoras, flotillas, polizas, impresoras, red, Windows, CFDI, reportes y atencion local para oficinas, hoteles y negocios."
  canonical="https://pixon.com.mx/empresas"
  image="/LOGOCIRCULAR.png"
  schema={[
    {
        "@context": "https://schema.org",
        "@type": "Service",
        "name": "Soporte TI B2B y Mantenimiento Corporativo",
        "provider": {
            "@type": "LocalBusiness",
            "name": "Pixon PC",
            "url": "https://pixon.com.mx"
        },
        "areaServed": {
            "@type": "City",
            "name": "Cancun"
        },
        "serviceType": "Soporte TI Empresarial",
        "url": "https://pixon.com.mx/empresas",
        "description": "Soporte TI para empresas en Cancun con mantenimiento de computadoras por lote, polizas, Windows, impresoras, red basica, CFDI, reportes y atencion local para oficinas, hoteles y negocios."
    },
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Inicio",
                "item": "https://pixon.com.mx/"
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": "Empresas B2B",
                "item": "https://pixon.com.mx/empresas"
            }
        ]
    },
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqs.map((item) => ({
            "@type": "Question",
            "name": item.question,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": item.answer.replace(/<[^>]*>/g, '')
            }
        }))
    }
]}
>
  <Navbar />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Soporte TI para Empresas B2B' }]} />

    <header class="page-hero b2b-hero-first">
        <div class="b2b-hero-gridline"></div>
        <div class="container b2b-hero-inner">
            <div class="b2b-hero-copy">
                <span class="b2b-hero-kicker"><i class="fa-solid fa-briefcase"></i> Pixon PC B2B · Soporte TI en Cancún</span>
                <h1>Soporte TI para empresas en Cancún</h1>
                <h2>Mantenimiento, soporte técnico y pólizas para oficinas, hoteles y negocios</h2>
                <p>
                    Actuamos como tu aliado tecnológico en Cancún. Atendemos computadoras, laptops, impresoras,
                    redes básicas, formateos, mantenimiento preventivo, soporte correctivo y preparación de equipos
                    para personal nuevo.
                </p>
                <p class="b2b-hero-secondary">
                    Ideal para oficinas, hoteles, despachos, escuelas, comercios, coworkings y empresas que necesitan
                    un proveedor técnico confiable, con factura, reportes y atención organizada.
                </p>
                <div class="b2b-hero-badges">
                    <span>CFDI 4.0</span>
                    <span>Contratos NDA</span>
                    <span>Pólizas mensuales</span>
                    <span>Atención por lote</span>
                    <span>Reporte por equipo</span>
                    <span>Soporte en Cancún</span>
                </div>
                <div class="b2b-hero-actions">
                    <button onclick="smartWaRedirect('https://wa.me/529986690777?text=Soy%20empresa%20y%20quiero%20contactar%20a%20ventas%20B2B%20para%20soporte%20TI%20en%20Canc%C3%BAn')" class="btn btn-primary">
                        Contactar a ventas B2B <i class="fa-solid fa-arrow-right"></i>
                    </button>
                    <button onclick="smartWaRedirect('https://wa.me/529986690777?text=Soy%20empresa%20y%20quiero%20solicitar%20una%20auditor%C3%ADa%20de%20cortes%C3%ADa%20para%20mis%20equipos')" class="btn btn-outline">
                        Solicitar auditoría de cortesía
                    </button>
                </div>
            </div>
            <aside class="b2b-hero-visual" aria-label="Soporte TI empresarial en Cancun con mantenimiento de computadoras, impresoras y hoteles">
                <div class="b2b-hero-photo b2b-photo-main">
                    <img src="/assets/images/soporte-hoteles-hero.webp" alt="Soporte TI para empresas y hoteles en Cancun" loading="eager" decoding="async" fetchpriority="high" />
                    <span>Soporte local B2B</span>
                </div>
                <div class="b2b-hero-photo-row">
                    <img src="/assets/images/mantenimiento-pc-escritorio.webp" alt="Mantenimiento de computadoras para empresas en Cancun" loading="eager" decoding="async" fetchpriority="high" />
                    <img src="/assets/images/reparacion-impresoras-cancun.webp" alt="Soporte de impresoras para oficinas en Cancun" loading="eager" decoding="async" fetchpriority="high" />
                </div>
                <div class="b2b-hero-audit-card">
                    <div>
                        <strong>5+ equipos</strong>
                        <span>diagnostico, reporte y cotizacion por volumen</span>
                    </div>
                    <button onclick="smartWaRedirect('https://wa.me/529986690777?text=Soy%20empresa%20con%20m%C3%A1s%20de%205%20equipos%20y%20quiero%20solicitar%20auditor%C3%ADa%20empresarial')" class="btn btn-primary">
                        Solicitar revision B2B
                    </button>
                </div>
            </aside>
        </div>
    </header>

    <section class="b2b-trust-section" id="confianza-corporativa">
        <div class="container">
            <div class="b2b-split-head">
                <div>
                    <span class="b2b-mini">Confianza para empresas</span>
                    <h2>Un proveedor TI para que tu operación no se detenga</h2>
                </div>
                <p>
                    Cuando una computadora falla en una empresa, no solo se daña un equipo: se detiene recepción,
                    ventas, administración, facturación o atención al cliente. Por eso trabajamos con procesos claros,
                    reportes, comunicación por WhatsApp y cotización antes de cualquier reparación.
                </p>
            </div>
            <div class="b2b-trust-grid">
                <article><i class="fa-solid fa-file-invoice"></i><h3>Factura y documentación</h3><p>Emitimos CFDI y entregamos reportes técnicos para administración, compras o gerencia.</p></article>
                <article><i class="fa-solid fa-triangle-exclamation"></i><h3>Soporte por prioridad</h3><p>Clasificamos tickets por urgencia para atender primero los equipos que afectan la operación.</p></article>
                <article><i class="fa-solid fa-layer-group"></i><h3>Atención por volumen</h3><p>Manejamos lotes de 5, 10, 20 o más equipos con precios y tiempos coordinados.</p></article>
                <article><i class="fa-brands fa-whatsapp"></i><h3>Comunicación clara</h3><p>Cada diagnóstico, costo y avance se confirma antes de continuar.</p></article>
            </div>
        </div>
    </section>

    <!-- TAREA 2: BANNER PREMIUM SIN OLA — SEGUNDA SECCIÓN -->
    <section class="b2b-local-intent-section" id="soporte-ti-empresas-cancun">
        <div class="container">
            <div class="b2b-section-center">
                <span class="b2b-mini">SEO local B2B</span>
                <h2>Soporte TI para empresas en Cancun cuando tu operacion depende de computadoras, red e impresoras</h2>
                <p>
                    Esta pagina responde a empresas que buscan un proveedor tecnico local: mantenimiento de computadoras,
                    soporte TI empresarial, polizas, flotillas, impresoras de oficina, Windows, red basica, CFDI y reportes en Cancun.
                </p>
            </div>
            <div class="b2b-local-grid">
                {localSearchNeeds.map((item) => (
                    <article>
                        <i class={`fa-solid ${item.icon}`}></i>
                        <h3>{item.title}</h3>
                        <p>{item.text}</p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="b2b-emergency-section" id="fallas-ti-empresas-cancun">
        <div class="container b2b-emergency-grid">
            <div class="b2b-emergency-copy">
                <span class="b2b-mini">Operacion primero</span>
                <h2>Cuando una empresa busca soporte tecnico en Cancun, normalmente ya hay una perdida operativa</h2>
                <p>
                    Una laptop lenta en ventas, una PC que no arranca en administracion, una impresora detenida en recepcion
                    o una red inestable en caja pueden costar mas que el mantenimiento. Priorizamos el equipo que detiene
                    la operacion y documentamos cada paso.
                </p>
                <div class="b2b-emergency-actions">
                    <a href="/servicios/b2b/mantenimiento-flotilla">Mantenimiento de flotilla</a>
                    <a href="/servicios/b2b/polizas-mantenimiento">Polizas TI</a>
                </div>
            </div>
            <div class="b2b-emergency-list">
                <article><b>01</b><h3>Equipos lentos o saturados</h3><p>Optimizacion, limpieza, revision de disco, RAM, arranque, temperatura y software innecesario.</p></article>
                <article><b>02</b><h3>Windows, correo y programas</h3><p>Restauracion, formateo, drivers, Office, navegadores, PDF, usuarios y configuracion para personal.</p></article>
                <article><b>03</b><h3>Impresoras y red compartida</h3><p>Drivers, WiFi/LAN, escaner, impresion por usuarios, atascos y fallas que afectan facturacion.</p></article>
                <article><b>04</b><h3>Seguimiento con evidencia</h3><p>Ticket, diagnostico, costo aprobado, reporte por equipo, recomendaciones y cierre documentado.</p></article>
            </div>
        </div>
    </section>

    <section class="b2b-local-zones-section" id="soporte-ti-zonas-cancun">
        <div class="container">
            <div class="b2b-split-head">
                <div>
                    <span class="b2b-mini">Busquedas por zona</span>
                    <h2>Soporte TI para empresas cerca de Zona Hotelera, Centro, Tulum, Bonampak, Cumbres y Huayacan</h2>
                </div>
                <p>
                    Si tu empresa busca tecnico de computadoras para oficina en Cancun, soporte de impresoras, mantenimiento
                    preventivo o poliza TI, podemos coordinar la atencion segun zona, volumen de equipos y urgencia.
                </p>
            </div>
            <div class="b2b-local-zone-cloud">
                {businessZones.map((zone) => <span>{zone}</span>)}
            </div>
        </div>
    </section>

    <section class="b2b-business-types-section" id="empresas-que-atendemos-cancun">
        <div class="container">
            <div class="b2b-section-center">
                <span class="b2b-mini">Giros empresariales</span>
                <h2>Soporte TI local para empresas que no pueden quedarse sin sistema</h2>
                <p>
                    Ajustamos el servicio al ritmo de cada negocio: turismo, oficina, administracion, caja, recepcion,
                    ventas, facturacion, capacitacion, gerencia o atencion al cliente.
                </p>
            </div>
            <div class="b2b-business-type-grid">
                {businessScenarios.map((item) => (
                    <article>
                        <h3>{item.title}</h3>
                        <p>{item.text}</p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="b2b-internal-links-section" id="servicios-ti-relacionados-cancun">
        <div class="container">
            <div class="b2b-split-head">
                <div>
                    <span class="b2b-mini">Arquitectura SEO</span>
                    <h2>Servicios relacionados para empresas que buscan soporte TI en Cancun</h2>
                </div>
                <p>
                    Conectamos esta vista con servicios especificos para que Google entienda mejor la oferta B2B:
                    polizas, flotillas, hoteles, red, Windows e impresoras.
                </p>
            </div>
            <div class="b2b-link-grid">
                {localSeoLinks.map((item) => (
                    <a href={item.href}>
                        <strong>{item.label}</strong>
                        <span>{item.text}</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                ))}
            </div>
        </div>
    </section>

    <section class="b2b-excelencia-section" style="text-align: center; position: relative; overflow: hidden;">
        <div class="premium-glow"></div>
        <div style="position: relative; z-index: 5; max-width: 800px; margin: 0 auto;">
            <span style="color: #fbbf24; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; font-size: 0.85rem; margin-bottom: 12px; display: block;">Excelencia Corporativa</span>
            <h2 style="font-size: clamp(2rem, 5vw, 4rem); font-weight: 900; margin-bottom: 20px; background: linear-gradient(135deg, #ffffff 30%, #fbbf24 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; letter-spacing: -2px; line-height: 1.1;">
                El estándar de oro en Soporte TI
            </h2>
            <p style="font-size: 1.2rem; color: #94a3b8; line-height: 1.7; margin-bottom: 40px; text-wrap: balance;">
                Potenciamos la infraestructura tecnológica de tu empresa con soluciones de alto nivel, contratos NDA y facturación inmediata. Tu tranquilidad operativa es nuestro compromiso.
            </p>
            <div style="display: flex; gap: 30px; justify-content: center; flex-wrap: wrap;">
                <div style="display: flex; align-items: center; gap: 10px; color: #fff; font-weight: 600; font-size: 1rem;">
                    <i class="fa-solid fa-crown" style="color: #fbbf24; font-size: 1.2rem;"></i> Servicio VIP
                </div>
                <div style="display: flex; align-items: center; gap: 10px; color: #fff; font-weight: 600; font-size: 1rem;">
                    <i class="fa-solid fa-bolt" style="color: #fbbf24; font-size: 1.2rem;"></i> Respuesta Inmediata
                </div>
                <div style="display: flex; align-items: center; gap: 10px; color: #fff; font-weight: 600; font-size: 1rem;">
                    <i class="fa-solid fa-shield-check" style="color: #fbbf24; font-size: 1.2rem;"></i> Seguridad Garantizada
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN DE PLANES PREMIUM (FONDO OSCURO + ORO) -->
    <section class="services section-padding" style="background: linear-gradient(180deg, #0c1a38 0%, #0a1f44 15%, #0a1f44 100%); position: relative; overflow: hidden;" id="paquetes">
        <!-- Decoración de fondo sutil -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: radial-gradient(circle at 20% 30%, rgba(201, 168, 76, 0.05) 0%, transparent 50%); pointer-events: none;"></div>
        
        <div class="container" style="position: relative; z-index: 2;">
            <div class="section-title text-center" style="margin-bottom: 60px;">
                <span style="display:inline-block; padding:5px 15px; background:rgba(201, 168, 76, 0.15); color:#c9a84c; border: 1px solid rgba(201, 168, 76, 0.3); border-radius:30px; font-weight:800; font-size:0.8rem; margin-bottom:15px; text-transform:uppercase; letter-spacing:1px;">
                    Planes B2B
                </span>
                <h2 style="font-size: clamp(2.2rem, 5vw, 3.5rem); font-weight:900; color: #ffffff; margin-bottom:15px; letter-spacing: -1px;">
                    Planes de soporte TI para empresas en <span style="color: #c9a84c;">Cancún</span>
                </h2>
                <p style="font-size: 1.2rem; color: #94a3b8; max-width: 700px; margin: 0 auto; line-height:1.6; text-wrap: balance;">
                    Elige entre mantenimiento por lote, soporte mensual, auditoría empresarial o plan anual. Si tu empresa tiene necesidades específicas, armamos una propuesta según cantidad de equipos, tipo de uso y urgencia operativa.
                </p>
            </div>
            
            <div class="b2b-grid">
                <!-- 1. Lote Estándar (From paquetes.html) -->
                <div class="pricing-card pack-basic">
                    <div class="popular-tag" style="background:var(--pack-basic);">6 equipos</div>
                    <div class="card-header">
                        <h3>Lote Estándar</h3>
                        <p>Equipos de uso cotidiano y administrativo</p>
                    </div>
                    <div class="price">
                        <p class="price-val" style="font-size:1.8rem; font-weight:800; color:var(--text-main); margin-bottom:0;">$2,400</p>
                        <span>MXN · pago único</span>
                    </div>
                    <p class="b2b-calc">$400 por equipo</p>
                    <div class="cpu-compat">
                        <p class="comp-title">PROCESADORES COMPATIBLES</p>
                        <span class="cpu-brand">Intel</span>
                        <div class="cpu-pills">
                            <span class="pill gray">Celeron</span> <span class="pill gray">Pentium</span> <span class="pill blue">Core i3</span>
                        </div>
                        <span class="cpu-brand" style="margin-top:5px;">AMD</span>
                        <div class="cpu-pills mb-3">
                            <span class="pill brown">Athlon</span> <span class="pill brown">Ryzen 3</span>
                        </div>
                        <div class="usage-dot green"><i class="fa-solid fa-circle"></i> Uso administrativo / ofimática</div>
                    </div>
                    <ul class="pricing-features text-left mt-3">
                        <li><i class="fa-solid fa-circle-check"></i> Mantenimiento preventivo completo (HW + SW)</li>
