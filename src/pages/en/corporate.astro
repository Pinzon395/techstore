---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import AlertBox from '../../components/AlertBox.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
---

<Base
  title="Soporte TI Corporativo y Mantenimiento B2B | Pixon PC"
  description="Soporte técnico TI para empresas, auditorías de hardware y mantenimiento preventivo de flotillas en Cancún. Facturación CFDI, NDA y Pólizas de mantenimiento."
  canonical="https://pixon.com.mx/en/corporate"
  image="/LOGOCIRCULAR.png"
  schema={[
    {
        "@context": "https://schema.org",
        "@type": "Service",
        "name": "Soporte TI B2B y Mantenimiento Corporativo",
        "provider": {
            "@type": "LocalBusiness",
            "name": "Pixon PC",
            "url": "https://pixon.com.mx"
        },
        "areaServed": {
            "@type": "City",
            "name": "Cancun"
        },
        "serviceType": "Soporte TI Empresarial",
        "url": "https://pixon.com.mx/empresas",
        "description": "Soporte técnico TI para empresas, auditorías de hardware y mantenimiento preventivo de flotillas en Cancún."
    },
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Inicio",
                "item": "https://pixon.com.mx/"
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": "Empresas B2B",
                "item": "https://pixon.com.mx/empresas"
            }
        ]
    },
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            {
                "@type": "Question",
                "name": "¿Emiten facturas y cómo es el proceso de pago?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí, todos nuestros servicios B2B son facturables e incluyen CFDI 4.0. Aceptamos transferencias bancarias y podemos adaptarnos a los procesos de pago de su departamento de contabilidad (ej. pago a 15 o 30 días para clientes de soporte mensual recurrente)."
                }
            },
            {
                "@type": "Question",
                "name": "¿Firman Acuerdos de Confidencialidad (NDA)?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Absolutamente. Firmamos un Non-Disclosure Agreement (NDA) antes de realizar cualquier auditoría, asegurando que la información de sus clientes, bases de datos y operaciones se mantiene estrictamente privada y segura."
                }
            },
            {
                "@type": "Question",
                "name": "¿El mantenimiento se realiza en nuestras instalaciones o en su taller?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Nos adaptamos a su flujo de trabajo. Para mantenimientos preventivos a gran escala, solemos recolectar lotes de equipos para no detener la operatividad de toda su oficina, trabajarlos en nuestro taller especializado y devolverlos al día siguiente. Si el problema es de red o infraestructura fija, acudimos directamente a sus instalaciones."
                }
            },
            {
                "@type": "Question",
                "name": "¿En la Póliza Mensual se incluyen las refacciones?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "No. Nuestra póliza mensual cubre el 100% de la mano de obra para mantenimientos preventivos y correctivos ilimitados. Si un equipo necesita un disco sólido nuevo, una pantalla o un teclado debido al desgaste, el costo de la pieza lo asume la empresa, pero nosotros realizamos la compra, gestión y la instalación sin costo adicional de mano de obra."
                }
            }
        ]
    }
]}
  lang="en"
>
  <Navbar lang="en" />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Soporte TI para Empresas B2B' }]} />

    <!-- H1 INVISIBLE PARA SEO -->
    <h1 class="sr-only">Soporte TI Corporativo y Mantenimiento B2B en Cancún — Pixon PC</h1>

    <!-- TAREA 1: HERO B2B — PRIMERA VISTA -->
    <header class="page-hero b2b-hero-first" style="position: relative; overflow: hidden;">
        <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 30px 30px;"></div>
        <div style="position: absolute; top: -100px; left: -100px; width: 400px; height: 400px; background: radial-gradient(circle, rgba(59,130,246,0.15) 0%, transparent 70%); filter: blur(40px); z-index: 1;"></div>
        <div class="container" style="position: relative; z-index: 2;">
            <div class="row" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 40px;">
                <div class="col-md-7" style="flex: 1; min-width: 300px;">
                    <span style="display: inline-block; padding: 6px 14px; background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); border-radius: 20px; font-size: 0.85rem; font-weight: 700; margin-bottom: 20px; text-transform: uppercase; letter-spacing: 1px;">
                        <i class="fa-solid fa-briefcase"></i> Pixon PC B2B
                    </span>
                    <h2 style="color: #ffffff; font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 800; line-height: 1.1; margin-bottom: 20px; text-wrap: balance;">
                        Soporte TI para <span style="background: linear-gradient(to right, #60a5fa, #3b82f6); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Empresas</span> y Oficinas
                    </h2>
                    <p style="color: #cbd5e1; font-size: 1.1rem; line-height: 1.6; margin-bottom: 30px; max-width: 600px;">
                        Actuamos como tu brazo tecnológico. Realizamos auditorías de hardware, mantenimiento preventivo de flotillas, estructuración de redes y soporte corporativo en Cancún.
                    </p>
                    <div style="display: flex; gap: 20px; margin-bottom: 35px; flex-wrap: wrap;">
                        <span style="color: #94a3b8; font-size: 0.95rem; display: flex; align-items: center; gap: 8px;">
                            <i class="fa-solid fa-file-invoice" style="color: #3b82f6;"></i> Facturación Electrónica (CFDI)
                        </span>
                        <span style="color: #94a3b8; font-size: 0.95rem; display: flex; align-items: center; gap: 8px;">
                            <i class="fa-solid fa-file-signature" style="color: #3b82f6;"></i> Contratos de Confidencialidad (NDA)
                        </span>
                        <span style="color: #94a3b8; font-size: 0.95rem; display: flex; align-items: center; gap: 8px;">
                            <i class="fa-solid fa-handshake" style="color: #3b82f6;"></i> Pólizas de Mantenimiento Anual
                        </span>
                    </div>
                    <div style="display: flex; gap: 15px; flex-wrap: wrap;">
                        <button onclick="smartWaRedirect('https://wa.me/529986690777?text=Soy%20empresa%20y%20quiero%20contactar%20a%20Ventas%20B2B')" class="btn btn-primary" style="padding: 14px 28px; font-size: 1rem; box-shadow: 0 10px 20px -10px rgba(59, 130, 246, 0.5);">
                            Contactar a Ventas B2B <i class="fa-solid fa-arrow-right" style="margin-left: 8px;"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-5" style="flex: 1; min-width: 280px; display: flex; justify-content: center;">
                    <div style="background: rgba(255, 255, 255, 0.04); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 24px; padding: 35px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); width: 100%; max-width: 420px;">
                        <div style="display: flex; justify-content: center; margin-bottom: 20px;">
                            <div style="width: 72px; height: 72px; border-radius: 50%; background: rgba(59, 130, 246, 0.2); display: flex; align-items: center; justify-content: center; border: 2px solid rgba(59, 130, 246, 0.5);">
                                <i class="fa-solid fa-magnifying-glass-chart" style="font-size: 28px; color: #60a5fa;"></i>
                            </div>
                        </div>
                        <h3 style="color: #ffffff; font-size: 1.4rem; text-align: center; margin-bottom: 12px;">¿Tienes más de 5 equipos?</h3>
                        <p style="color: #94a3b8; text-align: center; margin-bottom: 25px; font-size: 0.9rem; line-height: 1.6;">
                            Solicita una <strong style="color: #60a5fa;">auditoría de cortesía</strong> para evaluar el estado térmico y de rendimiento de la infraestructura tecnológica de tu empresa.
                        </p>
                        <button onclick="smartWaRedirect('https://wa.me/529986690777?text=Soy%20empresa%20con%20m%C3%A1s%20de%205%20equipos%20y%20deseo%20solicitar%20la%20auditor%C3%ADa%20de%20cortes%C3%ADa')" class="btn btn-outline" style="width: 100%; padding: 13px; border-color: rgba(255, 255, 255, 0.2); color: #ffffff;">
                            Solicitar Auditoría de Cortesía
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- TAREA 2: BANNER PREMIUM SIN OLA — SEGUNDA SECCIÓN -->
    <section class="b2b-excelencia-section" style="text-align: center; position: relative; overflow: hidden;">
        <div class="premium-glow"></div>
        <div style="position: relative; z-index: 5; max-width: 800px; margin: 0 auto;">
            <span style="color: #fbbf24; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; font-size: 0.85rem; margin-bottom: 12px; display: block;">Excelencia Corporativa</span>
            <h2 style="font-size: clamp(2rem, 5vw, 4rem); font-weight: 900; margin-bottom: 20px; background: linear-gradient(135deg, #ffffff 30%, #fbbf24 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; letter-spacing: -2px; line-height: 1.1;">
                El estándar de oro en Soporte TI
            </h2>
            <p style="font-size: 1.2rem; color: #94a3b8; line-height: 1.7; margin-bottom: 40px; text-wrap: balance;">
                Potenciamos la infraestructura tecnológica de tu empresa con soluciones de alto nivel, contratos NDA y facturación inmediata. Tu tranquilidad operativa es nuestro compromiso.
            </p>
            <div style="display: flex; gap: 30px; justify-content: center; flex-wrap: wrap;">
                <div style="display: flex; align-items: center; gap: 10px; color: #fff; font-weight: 600; font-size: 1rem;">
                    <i class="fa-solid fa-crown" style="color: #fbbf24; font-size: 1.2rem;"></i> Servicio VIP
                </div>
                <div style="display: flex; align-items: center; gap: 10px; color: #fff; font-weight: 600; font-size: 1rem;">
                    <i class="fa-solid fa-bolt" style="color: #fbbf24; font-size: 1.2rem;"></i> Respuesta Inmediata
                </div>
                <div style="display: flex; align-items: center; gap: 10px; color: #fff; font-weight: 600; font-size: 1rem;">
                    <i class="fa-solid fa-shield-check" style="color: #fbbf24; font-size: 1.2rem;"></i> Seguridad Garantizada
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN DE PLANES PREMIUM (FONDO OSCURO + ORO) -->
    <section class="services section-padding" style="background: linear-gradient(180deg, #0c1a38 0%, #0a1f44 15%, #0a1f44 100%); position: relative; overflow: hidden;" id="paquetes">
        <!-- Decoración de fondo sutil -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: radial-gradient(circle at 20% 30%, rgba(201, 168, 76, 0.05) 0%, transparent 50%); pointer-events: none;"></div>
        
        <div class="container" style="position: relative; z-index: 2;">
            <div class="section-title text-center" style="margin-bottom: 60px;">
                <span style="display:inline-block; padding:5px 15px; background:rgba(201, 168, 76, 0.15); color:#c9a84c; border: 1px solid rgba(201, 168, 76, 0.3); border-radius:30px; font-weight:800; font-size:0.8rem; margin-bottom:15px; text-transform:uppercase; letter-spacing:2px;">
                    Excelencia Corporativa
                </span>
                <h2 style="font-size: clamp(2.2rem, 5vw, 3.5rem); font-weight:900; color: #ffffff; margin-bottom:15px; letter-spacing: -1px;">
                    Planes de Soporte <span style="color: #c9a84c;">Premium</span>
                </h2>
                <p style="font-size: 1.2rem; color: #94a3b8; max-width: 700px; margin: 0 auto; line-height:1.6; text-wrap: balance;">
                    El estándar de oro en infraestructura tecnológica. Potenciamos tu empresa con soluciones de alto nivel y respuesta inmediata.
                </p>
            </div>
            
            <div class="b2b-grid">
                <!-- 1. Lote Estándar (From paquetes.html) -->
                <div class="pricing-card pack-basic">
                    <div class="popular-tag" style="background:var(--pack-basic);">6 equipos</div>
                    <div class="card-header">
                        <h3>Lote Estándar</h3>
                        <p>Equipos de uso cotidiano y administrativo</p>
                    </div>
                    <div class="price">
                        <p class="price-val" style="font-size:1.8rem; font-weight:800; color:var(--text-main); margin-bottom:0;">$2,400</p>
                        <span>MXN · pago único</span>
                    </div>
                    <p class="b2b-calc">$400 por equipo</p>
                    <div class="cpu-compat">
                        <p class="comp-title">PROCESADORES COMPATIBLES</p>
                        <span class="cpu-brand">Intel</span>
                        <div class="cpu-pills">
                            <span class="pill gray">Celeron</span> <span class="pill gray">Pentium</span> <span class="pill blue">Core i3</span>
                        </div>
                        <span class="cpu-brand" style="margin-top:5px;">AMD</span>
                        <div class="cpu-pills mb-3">
                            <span class="pill brown">Athlon</span> <span class="pill brown">Ryzen 3</span>
                        </div>
                        <div class="usage-dot green"><i class="fa-solid fa-circle"></i> Uso administrativo / ofimática</div>
                    </div>
                    <ul class="pricing-features text-left mt-3">
                        <li><i class="fa-solid fa-circle-check"></i> Mantenimiento preventivo completo (HW + SW)</li>
                        <li><i class="fa-solid fa-circle-check"></i> Limpieza física y revisión de antivirus</li>
                        <li><i class="fa-solid fa-circle-check"></i> Reporte por equipo al finalizar</li>
                        <li><i class="fa-solid fa-circle-check"></i> Optimización de equipo para mayor eficiencia</li>
                    </ul>
                    <AlertBox type="info">¿Tienes más de 6 equipos? Negociamos el precio fijo por lote a medida.</AlertBox>
                    <AlertBox type="success">Si un equipo sale con falla atribuible al servicio, lo atendemos sin costo.</AlertBox>
                    <button onclick="smartWaRedirect('https://wa.me/529986690777?text=Quiero%20consultar%20el%20lote%20est%C3%A1ndar')" class="btn btn-outline w-100">Consultar Lote ↗</button>
                </div>

                <!-- 2. Lote Premium (From paquetes.html) -->
                <div class="pricing-card pack-b2b-pro">
                    <div class="popular-tag" style="background:var(--secondary);">8 equipos</div>
                    <div class="card-header">
                        <h3>Lote Premium</h3>
                        <p>Equipos de alta exigencia y software especializado</p>
                    </div>
                    <div class="price">
                        <p class="price-val" style="font-size:1.8rem; font-weight:800; color:var(--text-main); margin-bottom:0;">$5,000</p>
                        <span>MXN · pago único</span>
                    </div>
                    <p class="b2b-calc">$625 por equipo</p>
                    <div class="cpu-compat">
                        <p class="comp-title">PROCESADORES COMPATIBLES</p>
                        <span class="cpu-brand">Intel</span>
                        <div class="cpu-pills">
                            <span class="pill blue">Core i5</span> <span class="pill blue">Core i7</span>
                        </div>
                        <span class="cpu-brand" style="margin-top:5px;">AMD</span>
                        <div class="cpu-pills mb-3">
                            <span class="pill brown">Ryzen 5</span> <span class="pill brown">Ryzen 7</span>
                        </div>
                        <div class="usage-dot blue"><i class="fa-solid fa-circle"></i> Trabajo intensivo · diseño · arquitectos</div>
                    </div>
                    <ul class="pricing-features text-left mt-3">
                        <li><i class="fa-solid fa-circle-check"></i> Todo el lote estándar incluido</li>
                        <li><i class="fa-solid fa-circle-check"></i> Optimización agresiva (RAM, disco, arranque)</li>
                        <li><i class="fa-solid fa-circle-check"></i> Pasta térmica de alta calidad en cada equipo</li>
                        <li><i class="fa-solid fa-circle-check"></i> Diagnóstico térmico y reporte fotográfico antes/después</li>
                        <li><i class="fa-solid fa-circle-check"></i> Optimización extrema</li>
                    </ul>
                    <AlertBox type="info">Lote personalizable para más de 8 equipos o precio fijo negociable.</AlertBox>
                    <AlertBox type="success">Garantía escrita: equipo dañado por el servicio, Pixon PC lo repara sin costo.</AlertBox>
                    <button onclick="smartWaRedirect('https://wa.me/529986690777?text=Quiero%20consultar%20el%20lote%20premium')" class="btn btn-primary w-100 pulse">Consultar Lote Premium ↗</button>
                </div>

                <!-- 3. Soporte Total Mensual (From paquetes.html) -->
                <div class="pricing-card pack-elite" style="border-top-color:#f59e0b;">
                    <div class="popular-tag" style="background:#f59e0b; color:#000;">Tu técnico fijo</div>
                    <div class="card-header">
                        <h3>Soporte Mensual</h3>
                        <p>Todo tipo de equipos · Pixon PC como tu área de TI</p>
                    </div>
                    <div class="price">
                        <p class="price-val" style="font-size:2rem; font-weight:800; color:var(--text-main); margin-bottom:0;">Desde <span style="font-size:2.5rem;">$2,000</span></p>
                        <span>MXN/mes · a cotizar según volumen</span>
                    </div>
                    <p class="b2b-calc" style="color:#d97706; font-weight:700;">Precio fijo mensual — cotizar según número de equipos</p>
                    <ul class="pricing-features text-left mt-3">
                        <li><i class="fa-solid fa-circle-check"></i> Mantenimiento preventivo mensual incluido</li>
                        <li><i class="fa-solid fa-circle-check"></i> Atención correctiva ilimitada (sin costo de mano de obra)</li>
                        <li><i class="fa-solid fa-circle-check"></i> Canal de contacto directo con técnico asignado</li>
                        <li><i class="fa-solid fa-circle-check"></i> Reporte mensual de estado de toda la flota</li>
                    </ul>
                    <AlertBox type="warning">Las piezas de repuesto <strong>NO están incluidas.</strong> La pieza corre por la empresa.</AlertBox>
                    <AlertBox type="success">Si el equipo se daña por negligencia, Pixon PC se hace responsable en contrato.</AlertBox>
                    <button onclick="smartWaRedirect('https://wa.me/529986690777?text=Quiero%20cotizar%20soporte%20mensual')" class="btn btn-secondary w-100">Cotizar Soporte Mensual ↗</button>
                </div>

                <!-- 4. Auditoría Empresarial (NEW!) -->
                <div class="pricing-card pack-basic" style="border-top-color:#10b981;">
                    <div class="popular-tag" style="background:#10b981; color:#fff;">Gratis*</div>
                    <div class="card-header">
                        <h3>Auditoría Empresarial</h3>
                        <p>Diagnóstico completo del estado de tu infraestructura</p>
                    </div>
                    <div class="price">
                        <p class="price-val" style="font-size:2.5rem; font-weight:800; color:#10b981; margin-bottom:0;">GRATIS</p>
                        <span>*Con contratación de plan B2B</span>
                    </div>
                    <p class="b2b-calc">Diagnóstico de cortesía</p>
                    <ul class="pricing-features text-left mt-3">
                        <li><i class="fa-solid fa-circle-check"></i> Diagnóstico térmico y de rendimiento por equipo</li>
                        <li><i class="fa-solid fa-circle-check"></i> Reporte ejecutivo con hallazgos y recomendaciones</li>
                        <li><i class="fa-solid fa-circle-check"></i> Evaluación de red e infraestructura</li>
                        <li><i class="fa-solid fa-circle-check"></i> Sin costo y sin compromiso inicial</li>
                    </ul>
                    <AlertBox type="info">Evaluamos cómo trabaja tu personal y tus equipos antes de proponer soluciones.</AlertBox>
                    <button onclick="smartWaRedirect('https://wa.me/529986690777?text=Quiero%20solicitar%20la%20auditor%C3%ADa%20empresarial')" class="btn btn-outline w-100" style="border-color:#10b981; color:#10b981;">Solicitar Auditoría ↗</button>
                </div>

                <!-- 5. Flotilla Corporativa (NEW!) -->
                <div class="pricing-card pack-b2b-pro" style="border-top-color:#8b5cf6;">
                    <div class="popular-tag" style="background:#8b5cf6;">12+ equipos</div>
                    <div class="card-header">
                        <h3>Flotilla Corporativa</h3>
                        <p>Para empresas con gran volumen de activos</p>
                    </div>
                    <div class="price">
                        <p class="price-val" style="font-size:2rem; font-weight:800; color:var(--text-main); margin-bottom:0;">Desde <span style="font-size:2.5rem;">$350</span></p>
                        <span>MXN por equipo</span>
                    </div>
                    <p class="b2b-calc">Cotizado por volumen</p>
                    <ul class="pricing-features text-left mt-3">
                        <li><i class="fa-solid fa-circle-check"></i> Todo lo del Lote Premium incluido</li>
                        <li><i class="fa-solid fa-circle-check"></i> Coordinador de cuenta dedicado</li>
                        <li><i class="fa-solid fa-circle-check"></i> Atención en sitio sin cargo extra</li>
                        <li><i class="fa-solid fa-circle-check"></i> Inventario detallado de activos tecnológicos</li>
                    </ul>
                    <AlertBox type="success">Cobertura prioritaria extendida y mantenimientos programables nocturnos.</AlertBox>
                    <button onclick="smartWaRedirect('https://wa.me/529986690777?text=Quiero%20cotizar%20el%20plan%20Flotilla%20Corporativa')" class="btn btn-primary w-100" style="background:#8b5cf6; border-color:#8b5cf6;">Cotizar Flotilla ↗</button>
                </div>

                <!-- 6. Plan Anual Elite (NEW!) -->
                <div class="pricing-card pack-elite" style="border-top-color:#0f172a; border-width:2px;">
                    <div class="popular-tag" style="background:#0f172a; color:#f59e0b;">★ Mayor Ahorro</div>
                    <div class="card-header">
                        <h3>Plan Anual Elite</h3>
                        <p>Tranquilidad operativa por 12 meses continuos</p>
                    </div>
                    <div class="price">
                        <p class="price-val" style="font-size:1.8rem; font-weight:800; color:var(--text-main); margin-bottom:0;">Desde <span style="font-size:2.2rem;">$18,000</span></p>
                        <span>MXN / AÑO</span>
                    </div>
                    <p class="b2b-calc" style="color:#d97706; font-weight:700;">Ahorra 2 meses vs la mensualidad</p>
                    <ul class="pricing-features text-left mt-3">
                        <li><i class="fa-solid fa-circle-check"></i> Todo el soporte mensual incluido × 12 meses</li>
                        <li><i class="fa-solid fa-circle-check"></i> 2 auditorías semestrales completas</li>
                        <li><i class="fa-solid fa-circle-check"></i> Prioridad absoluta en atención urgente (SLA &lt; 4 hrs)</li>
                        <li><i class="fa-solid fa-circle-check"></i> Póliza de garantía firmada por un año entero</li>
                    </ul>
                    <AlertBox type="warning">Pago único anual. Incluye todas las refacciones menores (cables, tornillería, pastas térmicas).</AlertBox>
                    <button onclick="smartWaRedirect('https://wa.me/529986690777?text=Quiero%20cotizar%20el%20Plan%20Anual%20Elite')" class="btn btn-secondary w-100" style="background:#0f172a; color:#f59e0b;">Cotizar Plan Anual ↗</button>
