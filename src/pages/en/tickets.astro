---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import TicketFormSection from '../../components/TicketFormSection.astro';

const defaultDevice = Astro.url.searchParams.get('device') || '';
const defaultService = Astro.url.searchParams.get('service') || '';
const sourcePage = Astro.url.searchParams.get('source') || '/en/tickets';

const ticketSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Create Service Ticket | Pixon PC Cancun',
  description: 'Create a repair ticket for computers, laptops, phones, consoles or business IT support in Cancun with written English support.',
  url: 'https://pixon.com.mx/en/tickets',
  isPartOf: { '@type': 'WebSite', name: 'Pixon PC', url: 'https://pixon.com.mx' },
};
---

<Base
  title="Create Service Ticket | Pixon PC Cancun"
  description="Create a technical service ticket at Pixon PC Cancun for laptops, computers, phones, consoles and business IT support with written English support."
  canonical="/en/tickets"
  image="/assets/images/taller-pixon.webp"
  schema={[ticketSchema]}
  lang="en"
>
  <Navbar />
  <Breadcrumb items={[{ label: 'Home', href: '/en' }, { label: 'Tickets' }]} />

  <section class="ticket-page-hero">
    <div class="container">
      <span>Structured tracking</span>
      <h1>Create technical service ticket</h1>
      <p>Register your device, symptom and contact details. We will review your request and reply with next steps in under 2 business hours.</p>
      <div class="ticket-page-points">
        <strong>Clear diagnosis</strong>
        <strong>Photos & evidence</strong>
        <strong>Written warranty</strong>
      </div>
    </div>
  </section>

  <TicketFormSection
    id="ticket-form"
    sourcePage={sourcePage}
    defaultDevice={defaultDevice}
    defaultService={defaultService}
    title="Tell us what your device needs"
    subtitle="This form helps us classify priority, device type, and contact details without cluttering the page."
  />

  <Footer />
</Base>

<style>
  .ticket-page-hero{padding:70px 0 44px;background:linear-gradient(135deg,#0f172a,#1e3a8a);color:#fff;text-align:center}
  .ticket-page-hero,.ticket-page-hero *{font-family:var(--font-main);font-style:normal;letter-spacing:0}
  .ticket-page-hero span{display:inline-flex;margin-bottom:10px;color:#bfdbfe;font-weight:700;text-transform:uppercase;font-size:.78rem}
  .ticket-page-hero h1{font-family:var(--font-heading);font-size:clamp(1.8rem,4vw,2.4rem);margin-bottom:12px;color:#fff}
  .ticket-page-hero p{max-width:680px;margin:0 auto 24px;color:#cbd5e1;line-height:1.6;font-size:1.02rem}
  .ticket-page-points{display:flex;justify-content:center;gap:14px;flex-wrap:wrap}
  .ticket-page-points strong{display:inline-flex;align-items:center;padding:8px 14px;border-radius:999px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15);font-size:.86rem;color:#f8fafc}
</style>
