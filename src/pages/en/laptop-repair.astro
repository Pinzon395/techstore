---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const canonical = 'https://pixon.com.mx/en/laptop-repair';
const description = 'Laptop repair in Cancun with written English support. We assess screens, batteries, charging, keyboards, overheating, liquid damage and Windows issues before quoting.';
const whatsappUrl = `https://wa.me/529986690777?text=${encodeURIComponent('Hi Pixon PC. I need laptop repair in Cancun. Model: ____. Problem: ____. Hotel or area: ____.')}`;
const schema = [{ '@context': 'https://schema.org', '@type': 'Service', '@id': `${canonical}#service`, name: 'Laptop Repair in Cancun', serviceType: 'Laptop repair', description, url: canonical, provider: { '@id': 'https://pixon.com.mx/#business' }, areaServed: { '@type': 'City', name: 'Cancun' } }];
---

<Base title="Laptop Repair in Cancun | English Support | Pixon PC" {description} canonical={canonical} lang="en" schema={schema} bodyClass="english-service-page">
  <Navbar lang="en" /><Breadcrumb items={[{ label: 'Home', href: '/en' }, { label: 'Laptop repair' }]} />
  <main><header class="english-service-hero"><div class="english-service-shell"><p class="eyebrow">Laptop repair · Cancun</p><h1>Laptop Repair in Cancun</h1><p>Screen, battery, charging, keyboard, overheating, liquid or Windows problem? We identify what the laptop needs and explain the available route in written English before work begins.</p><div class="actions"><a class="btn primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Message us on WhatsApp</a><a class="btn secondary" href="/en#communication-title">English support details</a></div><p class="note">Service by appointment · availability and logistics confirmed per case</p></div></header><section class="english-service-section"><div class="english-service-shell grid"><div><p class="eyebrow dark">Common laptop requests</p><h2>One symptom can have several causes</h2><p>We check the model, physical condition and behavior before recommending a screen, battery, charger, storage, cleaning or software route.</p></div><div class="cards"><article><h3>Screen or keyboard</h3><p>Display, hinges, keyboard, touchpad, cables and frame condition.</p></article><article><h3>Battery or charging</h3><p>Battery health, charger, port, USB-C or MagSafe behavior and power draw.</p></article><article><h3>Heat, liquid or Windows</h3><p>Cooling, fans, corrosion, startup, storage, drivers and data risks.</p></article></div></div></section><section class="english-service-section soft"><div class="english-service-shell grid"><div><h2>What to send before arranging service</h2><p>Share the exact model, the symptom, whether the laptop suffered a fall or liquid exposure, and your Cancun area. We confirm the next step before pickup or workshop reception.</p></div><div class="process"><h3>Helpful details</h3><ol><li>Brand and model from the bottom label or settings</li><li>Photo or short video of the symptom when useful</li><li>Whether it turns on, charges or shows an image</li><li>Hotel, condo, office or local area</li></ol></div></div></section><section class="english-service-final"><div class="english-service-shell"><h2>Need a laptop checked in Cancun?</h2><p>Send the model and symptoms. We will guide the diagnosis and quote process in writing.</p><a class="btn primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Start a laptop request</a></div></section></main><Footer lang="en" />
</Base>

<style>
  .english-service-page{color:#071F3A}.english-service-shell{width:min(calc(100% - (var(--page-gutter) * 2)),1180px);margin-inline:auto}.english-service-hero{padding:72px 0 58px;background:linear-gradient(135deg,#071F3A,#0b4162);color:#fff}.english-service-hero h1{max-width:780px;margin:0 0 16px;font-family:Kanit,sans-serif;font-size:clamp(2.3rem,6vw,4.4rem);line-height:1.05;color:#fff}.english-service-hero p:not(.eyebrow):not(.note){max-width:720px;font-size:1.08rem;line-height:1.7;color:#e8f7fb}.eyebrow{margin:0 0 12px;font-size:.76rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:#9de8f7}.eyebrow.dark{color:#1479D4}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}.btn{display:inline-flex;min-height:48px;align-items:center;justify-content:center;padding:12px 18px;border-radius:12px;font-weight:850;text-decoration:none}.btn.primary{background:#168b50;color:#fff}.btn.secondary{border:1px solid rgba(255,255,255,.45);color:#fff}.note{margin-top:18px;font-size:.86rem;color:#cbeaf1}.english-service-section{padding:clamp(52px,8vw,88px) 0}.english-service-section.soft{background:#eff9fc}.english-service-section h2,.english-service-final h2{margin:0 0 14px;color:#071F3A;font-family:Kanit,sans-serif;font-size:clamp(1.8rem,4vw,2.8rem);line-height:1.15}.english-service-section p,.english-service-section li,.english-service-final p{color:#071F3A;line-height:1.7}.grid{display:grid;gap:28px}.cards{display:grid;gap:14px}.cards article,.process{padding:22px;border:1px solid #b9dfe9;border-radius:16px;background:#fff}.cards h3,.process h3{margin:0 0 8px;color:#071F3A}.cards p{margin:0}.process ol{display:grid;gap:12px;padding-left:22px;margin:0}.english-service-final{padding:64px 0;background:#d9f3f8;text-align:center}.english-service-final p{max-width:620px;margin:0 auto 22px}.english-service-final .btn{width:min(100%,300px)}@media(min-width:760px){.grid{grid-template-columns:minmax(0,1fr) minmax(0,1.2fr)}.cards{grid-template-columns:repeat(3,1fr)}}
</style>
