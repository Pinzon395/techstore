<script>
  function smartWaRedirect(url: string) {
    const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
    if (isMobile) { window.location.href = url; } else { window.open(url, '_blank'); }
  }

</script>
