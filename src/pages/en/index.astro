---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { buildBreadcrumbSchema } from '../../lib/schema';
import { diagnosticCopy, emergencyPolicy } from '../../lib/business';

const canonical = 'https://pixon.com.mx/en';
const whatsappMessage = `Hi Pixon PC. I need help with a device while I am in Cancun.

Device:
Model:
Problem:
Hotel / area:
Checkout date:
How urgent is it?:
I prefer written communication in English.`;
const whatsappUrl = `https://wa.me/529986690777?text=${encodeURIComponent(whatsappMessage)}`;

const services = [
  { icon: 'fa-laptop', title: 'Laptop & PC Repair', copy: 'We assess no-power faults, overheating, screens, batteries, storage, RAM, hardware issues, Windows problems and performance concerns before recommending a repair.', href: '/en/laptop-repair', link: 'Laptop repair' },
  { icon: 'fa-mobile-screen-button', title: 'iPhone & Phone Repair', copy: 'For iPhone and Android devices, we can review screens, batteries, charging ports, cameras, audio and software symptoms. Model and parts availability are confirmed before work is approved.', href: '/en/phone-repair', link: 'Phone repair' },
  { icon: 'fa-droplet', title: 'Water Damage Repair', copy: 'Liquid exposure needs a careful diagnosis. Do not charge a wet device; message us with the model, what liquid was involved and whether the device still turns on.', href: '/en/liquid-damage', link: 'Water damage phone repair' },
  { icon: 'fa-gamepad', title: 'Game Console Repair', copy: 'We assess PS5, Xbox, Nintendo Switch and controller issues such as overheating, no power, HDMI faults, cleaning needs and joystick drift.', href: '/en/game-console-repair', link: 'Game console repair' },
  { icon: 'fa-apple-whole', title: 'MacBook Repair', copy: 'MacBook diagnostics can cover battery, display, charging, liquid exposure and software concerns. The repair scope depends on the exact model and findings.', href: '/en/macbook-repair', link: 'MacBook repair' },
  { icon: 'fa-microchip', title: 'Gaming PC Service', copy: 'For gaming computers, we can assess cooling, component upgrades, graphics issues, instability, cleanup and performance troubleshooting.', href: '/en/graphics-card-repair', link: 'Graphics card repair' },
];

const communicationSteps = [
  ['Written quotes in English', 'Send the device model and symptoms on WhatsApp. We explain the findings and quote in writing when the repair path is confirmed.'],
  ['Repair updates by WhatsApp', 'Updates, questions and availability checks can be handled by message, so you have a written record while you are away from home.'],
  ['Clear approval before additional work', 'We do not add work beyond the agreed scope without explaining it and asking for written approval first.'],
  ['Tell us your checkout date', 'If you fly home soon, say so in your first message. We plan the visit and the repair around the time you have left in Cancun.'],
];

const hotelVisitSteps = [
  ['Message us from your hotel', 'Send the device, model, problem, hotel name and the time that works for you. Photos or a short video help us bring the right tools.'],
  ['Get a closed price first', 'The visit price depends on the distance to your hotel and the type of service. You know the full amount, travel included, before you confirm.'],
  ['A technician comes to you', 'We meet you in your room, the lobby or the business center, following the access rules of each hotel or condo.'],
  ['Fixed on site or a written plan', 'If the repair can be done safely on site, we do it there. If it needs workshop equipment, we explain why in writing and you decide.'],
];

const vacationFixes = [
  { icon: 'fa-water', title: 'Phone dropped in the pool or the ocean', copy: 'Salt water corrodes fast. Turn the phone off, do not charge it and skip the rice. Message us right away: liquid cases are taken in immediately, no appointment.', href: '/en/liquid-damage', link: 'Water damage phone repair' },
  { icon: 'fa-mobile-screen', title: 'Cracked screen on day one', copy: 'Screens, batteries and charging ports are quoted directly by model, with no diagnosis fee, so you know the price before you decide.', href: '/en/phone-repair', link: 'Phone screen repair' },
  { icon: 'fa-plug-circle-xmark', title: 'Sand in the charging port', copy: 'Beach sand and humidity block charging ports. A careful cleaning often solves it; if the port is damaged, we quote the replacement first.', href: '/en/phone-repair', link: 'Charging port repair' },
  { icon: 'fa-laptop', title: 'Work laptop fails before a call', copy: 'For remote workers and business travelers: no power, no Wi-Fi, a blue screen or an update stuck at boot. We start with the symptom and tell you what it needs.', href: '/en/laptop-repair', link: 'Laptop repair' },
  { icon: 'fa-temperature-high', title: 'Overheating in the Cancun heat', copy: 'Heat and humidity make laptops and consoles shut down or slow down. Cleaning and new thermal paste can usually be done in one visit.', href: '/en/computer-repair', link: 'Computer repair' },
  { icon: 'fa-images', title: 'Vacation photos you cannot lose', copy: 'Before any repair on a device with photos or work files, tell us. We check whether the data can be backed up first and explain the risk in writing.', href: '/en/data-recovery', link: 'Data recovery' },
];

const onSiteRows = [
  ['Diagnosis and written quote', 'Yes', 'When it needs test equipment'],
  ['Laptop and PC cleaning, thermal paste', 'Yes, in most models', 'Models that need full disassembly'],
  ['Windows, software, Wi-Fi and setup', 'Yes', 'Not needed'],
  ['Phone screen, battery or charging port', 'Depends on the model and part', 'When the part must be ordered'],
  ['Liquid damage', 'First aid and advice', 'Yes: cleaning needs the workshop'],
  ['Board-level repair and soldering', 'No', 'Yes'],
];

const areaCards = [
  ['Cancun Hotel Zone', 'Hotels, resorts and condos along Blvd. Kukulcan, from km 0 to km 25. Share the hotel name and we confirm the visit time and price.'],
  ['Punta Cancun', 'The busiest part of the Hotel Zone, near the convention center. Visits follow the access rules of each property.'],
  ['Isla Dorada', 'Homes and condos in the Isla Dorada residential area of the Hotel Zone. We coordinate access details with you before the visit.'],
  ['Puerto Cancun', 'Condos, homes and offices between downtown and the Hotel Zone, a short drive from our workshop.'],
  ['Costa Mujeres', 'All-inclusive resorts north of Cancun. The visit price includes the extra distance, and you know it before you confirm.'],
  ['Playa Mujeres', 'Resorts and residences in Playa Mujeres. Send the property name and a time window that works for your stay.'],
  ['Downtown and Av. Tulum', 'Hotels and rentals in downtown Cancun, Av. Tulum, Av. Bonampak and Puerto Juarez.'],
  ['Vacation rentals', 'Airbnb and short-term rentals across Cancun. Share the area and building rules so we arrive prepared.'],
];

const guestChecklist = [
  'Your hotel name and room number, or where we can meet.',
  'The device type, exact model and what happened.',
  'Your checkout or flight date, if you leave soon.',
  'Whether the device holds photos or files you need to keep.',
  'The charger, if you have it with you.',
];

const conciergeCards = [
  ['For front desk and concierge teams', 'Guests often ask the front desk where to fix a phone or a laptop. Your team can send us the guest case by WhatsApp, and we reply to the guest in English.'],
  ['For hotel IT and operations', 'Front-desk computers, office PCs and networks are handled as a separate business request, with a written scope and quote.'],
];

const faqs = [
  ['Do you provide repair support in English?', 'Yes. Written English support is available for quotes, approvals, questions and repair updates by WhatsApp.'],
  ['Can you help me if I do not speak Spanish?', 'Yes. Send your device model and the issue by WhatsApp. We can keep the repair communication clear in written English.'],
  ['Can we communicate entirely through WhatsApp?', 'WhatsApp is the main channel for written English communication, including the device details, quote and repair updates.'],
  ['Do you send the repair quote in English?', 'When the repair scope is confirmed, we can send the quote and explanation in written English.'],
  ['Will you ask before performing additional work?', 'Yes. If the diagnosis finds additional work beyond the approved scope, we explain it and request written approval before continuing.'],
  ['Can a technician come to my hotel in Cancun?', 'Yes. We visit hotels, resorts, condos and vacation rentals in Cancun by appointment. Send the hotel name, the device and the problem by WhatsApp to schedule it.'],
  ['How much does a hotel visit cost?', 'It depends on the distance to your hotel and the type of service. We give you a closed price, travel included, before you confirm the visit, so there are no surprise charges.'],
  ['How fast can you come to my hotel?', 'It depends on the schedule and the distance. Tell us how urgent it is and when you check out, and we offer the closest available time. Liquid damage and devices that stopped working can also be brought to the workshop with no appointment.'],
  ['What if my hotel does not allow outside technicians in rooms?', 'We can meet you in the lobby, the business center or another common area, following the hotel rules.'],
  ['Can you fix it before my flight?', 'Tell us your flight date in your first message. If the repair cannot be finished in time, we tell you before you pay anything and suggest the safest option.'],
  ['Do you provide service in Cancun Hotel Zone?', 'Yes. We schedule visits along Blvd. Kukulcan, from km 0 to km 25, for hotel guests, condo residents and offices.'],
  ['Do you serve Costa Mujeres and Playa Mujeres?', 'Yes. Send us the exact resort or address. The extra distance is included in the closed price we give you before the visit.'],
  ['Can my hotel concierge contact you for me?', 'Yes. The front desk or concierge can send us your case by WhatsApp, and we continue the conversation with you in English.'],
  ['Can you help tourists staying at resorts?', 'Yes. Tourists, business travelers, expats and digital nomads can receive written English support while the repair is being assessed.'],
  ['Do you repair iPhones?', 'We assess iPhone issues such as batteries, screens, charging, cameras, audio and liquid exposure according to the model and diagnosis.'],
  ['Do you repair laptops and PCs?', 'Yes. We assess laptop and PC hardware, Windows, overheating, storage, memory, batteries, screens and no-power faults.'],
  ['Do you repair water-damaged phones?', 'We assess water-damaged phones and explain the findings before quoting. Do not charge the device after liquid exposure.'],
  ['Do you repair PS5, Xbox and Nintendo Switch?', 'We assess common console and controller issues, including overheating, cleaning, power, HDMI and joystick drift.'],
  ['How much does a repair cost?', 'The cost depends on the device, model, confirmed fault, required parts and repair scope. Send the details for a written quote after assessment.'],
  ['How long does a repair take?', 'Timing depends on the diagnosis, parts availability and testing needed. We confirm the estimated timing for your specific case before work begins.'],
  ['Do repairs include a warranty?', 'Yes. Repairs with original parts carry a 90-day written warranty against manufacturing defects. Preventive maintenance is tested at delivery, and if a temperature issue appears due to the thermal material we applied, we fix it at no cost. Liquid-damaged devices carry no warranty because the damage keeps progressing, but we take them in right away.'],
  ['How do I send my device model and problem?', 'Send a WhatsApp message with the device type, exact model, symptoms, photos or video if helpful, your Cancun area and how urgent the case is.'],
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${canonical}#service`,
    name: 'Computer Repair in Cancun with English Support',
    serviceType: 'Computer, laptop, phone and console repair',
    description: 'Computer, laptop, phone and console repair in Cancun with written English support, clear quotes and WhatsApp repair updates.',
    url: canonical,
    provider: { '@id': 'https://pixon.com.mx/#business' },
    areaServed: [
      { '@type': 'City', name: 'Cancun' }, { '@type': 'Place', name: 'Cancun Hotel Zone' }, { '@type': 'Place', name: 'Costa Mujeres' }, { '@type': 'Place', name: 'Playa Mujeres' }, { '@type': 'Place', name: 'Puerto Cancun' }, { '@type': 'Place', name: 'Punta Cancun' }, { '@type': 'Place', name: 'Isla Dorada' },
    ],
    availableChannel: [
      { '@type': 'ServiceChannel', name: 'Technician visit to your hotel, condo or vacation rental in Cancun' },
      { '@type': 'ServiceChannel', name: 'Pixon PC workshop in Cancun' },
    ],
  },
  buildBreadcrumbSchema([{ name: 'Home', url: '/en' }, { name: 'Computer Repair in Cancun', url: canonical }]),
].filter(Boolean) as object[];
---

<Base title="Computer & Phone Repair in Cancun | We Come to Your Hotel | Pixon PC" description="Laptop, phone and console repair in Cancun with English support. A technician visits your hotel in the Hotel Zone, Costa Mujeres or Playa Mujeres. Closed price first." canonical={canonical} lang="en" schema={schema} bodyClass="en-home-page">
  <Navbar lang="en" />
  <main>
    <header class="en-home-hero" aria-labelledby="en-home-title">
      <div class="en-home-shell en-home-hero__inner">
        <p class="en-home-eyebrow">Tech repair in Cancun · We come to your hotel</p>
        <h1 id="en-home-title">Computer and Phone Repair in Cancun, at Your Hotel</h1>
        <p class="en-home-lead">A quick fix so your vacation keeps going. Laptop, phone, iPhone and console repair with written English support, and a technician who visits your hotel, resort or vacation rental in Cancun.</p>
        <div class="en-home-actions"><a class="en-home-btn en-home-btn--whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Book a hotel visit on WhatsApp</a><a class="en-home-btn en-home-btn--secondary" href="#hotel-visit">How hotel visits work</a></div>
        <ul class="en-home-trust" aria-label="Service details"><li>Technician visits to your hotel</li><li>Closed price before the visit</li><li>English updates on WhatsApp</li><li>Free diagnosis if you repair (MXN $600 credited)</li><li>90-day warranty with original parts</li><li>Open 24/7 by appointment</li></ul>
      </div>
    </header>

    <section class="en-home-section" id="hotel-visit" aria-labelledby="hotel-visit-title">
      <div class="en-home-shell">
        <div class="en-home-section-copy en-home-section-copy--center"><p class="en-home-kicker">Service that comes to you</p><h2 id="hotel-visit-title">Computer and Phone Repair at Your Hotel in Cancun</h2><p>You are on vacation, not in a repair shop line. Send us a message from your room and a technician comes to your hotel, resort, condo or vacation rental, by appointment.</p></div>
        <ol class="en-home-steps">{hotelVisitSteps.map(([title, copy], index) => (<li class="en-home-step"><span class="en-home-step__num" aria-hidden="true">{index + 1}</span><h3>{title}</h3><p>{copy}</p></li>))}</ol>
        <div class="en-home-center-cta"><a class="en-home-btn en-home-btn--whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Ask for a hotel visit</a></div>
      </div>
    </section>

    <section class="en-home-section en-home-section--line" id="vacation-fixes" aria-labelledby="vacation-title">
      <div class="en-home-shell">
        <div class="en-home-section-copy en-home-section-copy--center"><p class="en-home-kicker">Quick fixes for your trip</p><h2 id="vacation-title">Quick Fixes So Your Vacation Keeps Going</h2><p>Common device problems on a beach trip. Each one starts with a clear message and a written answer before any work.</p></div>
        <div class="en-home-service-grid">{vacationFixes.map((fix) => (<article class="en-home-service-card"><span class="en-home-service-card__icon"><i class={`fa-solid ${fix.icon}`} aria-hidden="true"></i></span><h3>{fix.title}</h3><p>{fix.copy}</p><a href={fix.href}>{fix.link} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></article>))}</div>
      </div>
    </section>

    <section class="en-home-section en-home-section--soft" id="english-support" aria-labelledby="communication-title">
      <div class="en-home-shell en-home-intro-grid">
        <div class="en-home-section-copy"><p class="en-home-kicker">Written English support</p><h2 id="communication-title">Clear English communication from quote to delivery</h2><p>You do not need to speak Spanish to understand your repair. We can communicate with you in written English through WhatsApp, explain the diagnosis, send the quote, confirm what you authorize and keep you updated before any additional work is performed.</p><a class="en-home-text-link" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Send your device details in English <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div>
        <div class="en-home-approval-card"><span>How it works</span><ol><li><strong>1.</strong> You send the model, symptoms and Cancun area.</li><li><strong>2.</strong> We explain the diagnostic path and quote in writing.</li><li><strong>3.</strong> You approve the agreed repair before it begins.</li><li><strong>4.</strong> You receive written updates and delivery coordination.</li></ol></div>
      </div>
    </section>

    <section class="en-home-section" id="repair-services" aria-labelledby="services-title">
      <div class="en-home-shell"><div class="en-home-section-copy en-home-section-copy--center"><p class="en-home-kicker">Repair services</p><h2 id="services-title">Computer, Laptop and Phone Repair in Cancun</h2><p>Share the exact model and the issue you are seeing. We confirm the repair route after reviewing the case, not before.</p></div>
        <div class="en-home-service-grid">{services.map((service) => (<article class="en-home-service-card"><span class="en-home-service-card__icon"><i class={`fa-solid ${service.icon}`} aria-hidden="true"></i></span><h3>{service.title}</h3><p>{service.copy}</p>{service.href ? <a href={service.href}>{service.link} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a> : <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Request a written quote <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>}</article>))}</div>
      </div>
    </section>

    <section class="en-home-section en-home-section--line" aria-labelledby="support-title"><div class="en-home-shell"><div class="en-home-section-copy"><p class="en-home-kicker">For international visitors</p><h2 id="support-title">English Support for Tourists and Expats in Cancun</h2><p>Whether you are visiting for a few days, living in Cancun, working remotely or managing a trip, the goal is simple: you can follow the repair with clear written communication.</p></div><div class="en-home-feature-grid">{communicationSteps.map(([title, copy]) => (<article class="en-home-feature-card"><h3>{title}</h3><p>{copy}</p></article>))}</div></div></section>

    <section class="en-home-section" id="in-room-or-workshop" aria-labelledby="onsite-title">
      <div class="en-home-shell">
        <div class="en-home-section-copy en-home-section-copy--center"><p class="en-home-kicker">Honest scope before the visit</p><h2 id="onsite-title">What We Fix in Your Hotel Room and What Needs the Workshop</h2><p>Some repairs need a bench, a microscope or parts that are ordered by model. We tell you which case yours is before the visit, so the trip is never wasted.</p></div>
        <div class="en-home-table-wrap" tabindex="0" role="region" aria-labelledby="onsite-title">
          <table class="en-home-table">
            <thead><tr><th scope="col">Service</th><th scope="col">At your hotel</th><th scope="col">At the workshop</th></tr></thead>
            <tbody>{onSiteRows.map(([service, hotel, workshop]) => (<tr><th scope="row">{service}</th><td data-label="At your hotel">{hotel}</td><td data-label="At the workshop">{workshop}</td></tr>))}</tbody>
          </table>
        </div>
        <p class="en-home-table-note">{emergencyPolicy.en}</p>
      </div>
    </section>

    <section class="en-home-section en-home-section--navy" id="hotel-coordination" aria-labelledby="hotel-title"><div class="en-home-shell"><div class="en-home-section-copy en-home-section-copy--light"><p class="en-home-kicker">Hotel visits across Cancun</p><h2 id="hotel-title">Hotel Visits in the Hotel Zone, Costa Mujeres and Playa Mujeres</h2><p>We visit hotels, resorts, condos and vacation rentals across Cancun by appointment. The price of each visit depends on the distance and the service, and you get it in writing before you confirm.</p></div><div class="en-home-area-grid">{areaCards.map(([area, copy]) => (<article class="en-home-area-card"><h3>{area}</h3><p>{copy}</p></article>))}</div></div></section>

    <section class="en-home-section en-home-section--soft" id="before-the-visit" aria-labelledby="pickup-title"><div class="en-home-shell en-home-split"><div class="en-home-section-copy"><p class="en-home-kicker">A faster visit</p><h2 id="pickup-title">Before the Technician Arrives at Your Hotel</h2><p>A complete first message saves a lot of back and forth. With these details we can tell you the price, the time and whether the repair can be done in your room.</p><ul class="en-home-check-list">{guestChecklist.map((item) => (<li><i class="fa-solid fa-check" aria-hidden="true"></i> {item}</li>))}</ul></div><div class="en-home-note-card en-home-note-card--pay"><h3>What you pay, and when</h3><ul><li><strong>Hotel visit:</strong> closed price by distance and service, travel included, confirmed before the visit.</li><li><strong>Diagnosis:</strong> {diagnosticCopy.en.credit}</li><li><strong>Screens, batteries and charging ports:</strong> {diagnosticCopy.en.visibleFaults}</li><li><strong>Approval:</strong> no repair starts without your written OK.</li></ul></div></div></section>

    <section class="en-home-section" aria-labelledby="phone-title"><div class="en-home-shell en-home-content-grid"><div class="en-home-section-copy"><p class="en-home-kicker">Mobile devices</p><h2 id="phone-title">Phone and iPhone Repair in Cancun</h2><p>Phone issues can have more than one cause. We review the model, symptoms and history before quoting screens, batteries, charging, camera, audio or liquid damage work.</p><div class="en-home-inline-links"><a href="/en/phone-repair">Phone repair</a><a href="/en/liquid-damage">Water Damage Phone Repair</a><a href="/en/iphone-battery-replacement">iPhone Battery Replacement</a></div></div><div class="en-home-mini-grid"><article><h3>iPhone repair questions</h3><p>Send the model, issue and iOS message or battery health if relevant. We confirm parts and scope before approval.</p></article><article><h3>Water damage after a beach or pool day</h3><p>Do not charge it. Tell us whether it was fresh water, pool water or salt water and whether the phone still turns on.</p></article></div></div></section>

    <section class="en-home-section en-home-section--line" aria-labelledby="computer-title"><div class="en-home-shell en-home-content-grid"><div class="en-home-section-copy"><p class="en-home-kicker">Computers</p><h2 id="computer-title">Laptop and Computer Repair in Cancun</h2><p>From a laptop that will not turn on to a desktop that overheats, we start with the symptom and identify what the repair actually requires.</p><div class="en-home-inline-links"><a href="/en/computer-repair">Computer and PC repair</a><a href="/en/laptop-repair">Laptop repair</a></div></div><div class="en-home-mini-grid"><article><h3>Hardware and temperature issues</h3><p>We can assess screens, batteries, storage, RAM, fans, thermal performance and no-power faults.</p></article><article><h3>Windows and performance troubleshooting</h3><p>We can review Windows errors, malware symptoms, startup problems, optimization and installation needs after diagnosis.</p></article></div></div></section>

    <section class="en-home-section" aria-labelledby="console-title"><div class="en-home-shell en-home-content-grid"><div class="en-home-section-copy"><p class="en-home-kicker">Consoles</p><h2 id="console-title">Game Console Repair in Cancun</h2><p>We assess PlayStation, Xbox, Nintendo Switch and controller problems without turning the English hub into a console-only page.</p></div><div class="en-home-mini-grid"><article><h3>PS5, Xbox and Nintendo Switch</h3><p>Common requests include cleaning, overheating, HDMI, power and storage-related faults. The solution depends on the diagnosis.</p></article><article><h3>Controller repair</h3><p>For joystick drift, buttons, charging and connection issues, send the controller model and a short description of the behavior.</p></article></div></div></section>

    <section class="en-home-section en-home-section--soft" aria-labelledby="b2b-title"><div class="en-home-shell en-home-split"><div class="en-home-section-copy"><p class="en-home-kicker">Separate business request flow</p><h2 id="b2b-title">IT Support for Businesses and Hotels in Cancun</h2><p>Business, hotel and office requests are reviewed separately from personal-device repairs. Share the number of devices, location, issue and operational impact for a clearer next step.</p></div><div class="en-home-note-card"><h3>For a business or hotel request</h3><ul><li>Office computer and maintenance requests</li><li>Hotel IT and guest-device coordination</li><li>Onsite support by appointment</li><li>Written scope, quote and approval process</li></ul><a class="en-home-text-link" href="/en/business-it-support">Business IT support <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div></div><div class="en-home-shell en-home-feature-grid en-home-feature-grid--two">{conciergeCards.map(([title, copy]) => (<article class="en-home-feature-card"><h3>{title}</h3><p>{copy}</p></article>))}</div></section>

    <section class="en-home-section" aria-labelledby="faq-title"><div class="en-home-shell en-home-faq-shell"><div class="en-home-section-copy en-home-section-copy--center"><p class="en-home-kicker">Helpful details before you message</p><h2 id="faq-title">Frequently Asked Questions About Tech Repair in Cancun</h2></div><div class="en-home-faq-list">{faqs.map(([question, answer]) => (<details><summary>{question}</summary><p>{answer}</p></details>))}</div></div></section>

    <section class="en-home-final-cta" aria-labelledby="final-title"><div class="en-home-shell"><p class="en-home-eyebrow">Clear written English support</p><h2 id="final-title">Device trouble on vacation? We come to your hotel.</h2><p>Message Pixon PC with the device, model, problem, your hotel and your checkout date. You get the price and the next step in writing, in English.</p><a class="en-home-btn en-home-btn--whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Book a hotel visit on WhatsApp</a></div></section>
  </main>
  <Footer lang="en" />
</Base>

<style>
  .en-home-page { background: #fff; color: #071F3A; font-family: Arial, Helvetica, sans-serif; }
  .en-home-shell { width: min(100% - 32px, 1180px); margin-inline: auto; }
  .en-home-hero, .en-home-final-cta { background: radial-gradient(circle at 84% 18%, rgba(14, 165, 201, .28), transparent 30%), linear-gradient(135deg, #071F3A, #0b3255); color: #fff; }
  .en-home-hero { padding: clamp(48px, 7vw, 84px) 0 clamp(38px, 6vw, 66px); }
