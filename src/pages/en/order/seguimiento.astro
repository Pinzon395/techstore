---
import Base from '../../../layouts/Base.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import storeCss from '../../../styles/store.css?url';
---
<Base title="Order tracking | Pixon PC" description="Securely check your Pixon PC order." canonical="https://pixon.com.mx/en/order/seguimiento" robots="noindex, nofollow" extraStyles={[storeCss]} preloadSprite={true} lang="en">
  <Navbar />
  <main class="store-page private-commerce-page order-page"><section class="store-shell order-shell" aria-labelledby="order-title"><header class="order-header"><p class="store-section-label">Secure tracking</p><h1 id="order-title">Your Pixon PC order</h1><p id="order-intro">Check using the email used at purchase. A folio alone never grants access.</p></header><form class="order-access" id="order-access-form"><label><span>Order email</span><input id="order-email" type="email" autocomplete="email" required /></label><button class="store-action store-action-primary" type="submit">Check order</button></form><div class="order-loading" id="order-loading" hidden><div class="cart-skeleton"></div><div class="cart-skeleton"></div></div><div class="checkout-message" id="order-error" role="alert" hidden></div><div class="order-content" id="order-content" hidden><section class="order-summary-card"><div><span>Folio</span><strong id="order-folio">—</strong></div><div><span>Status</span><strong class="order-status" id="order-status">—</strong></div><div><span>Total</span><strong id="order-total">—</strong></div><div><span>Payment method</span><strong id="order-method">—</strong></div></section><div class="order-grid"><div><section class="order-card"><h2>Summary</h2><div id="order-items"></div></section><section class="order-card"><h2>Timeline</h2><ol class="order-timeline" id="order-timeline"></ol></section></div><aside><section class="order-card" id="order-transfer" hidden><h2>Complete your transfer</h2><dl id="order-transfer-details"></dl><div class="order-copy-actions"><button type="button" data-copy-field="account">Copy account</button><button type="button" data-copy-field="reference">Copy reference</button></div></section><section class="order-card" id="order-proof"><h2>Payment receipt</h2><p>JPEG, PNG, WebP or PDF. Maximum 10 MB.</p><label class="proof-dropzone" id="proof-dropzone" for="proof-file"><strong>Drag your receipt or click to select</strong><span id="proof-file-label">No file selected</span></label><input id="proof-file" type="file" accept="image/jpeg,image/png,image/webp,application/pdf" /><div class="proof-preview" id="proof-preview" aria-live="polite"></div><button class="store-action store-action-primary" id="proof-upload" type="button" disabled>Upload receipt</button><p id="proof-status" aria-live="polite"></p></section><section class="order-card"><h2>Need help?</h2><p>Use the support ticket system and mention your folio.</p><a href="/en/tickets">Create support ticket</a></section></aside></div></div></section></main>
  <Footer />
  <script src="/scripts/order-page.js?v=20260812-1" is:inline defer></script>
</Base>
