---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { buildBreadcrumbSchema } from '../../lib/schema';

const canonical = 'https://pixon.com.mx/en/iphone-battery-replacement';
const pageDescription = 'iPhone battery replacement in Cancun with written English support. Clear quotes, WhatsApp updates and hotel coordination subject to availability.';
const whatsappUrl = `https://wa.me/529986690777?text=${encodeURIComponent('Hi Pixon PC. I need an iPhone battery replacement in Cancun.\n\nDevice: iPhone\nModel:\nProblem / battery health:\nHotel / area:\nHow urgent is it?:\nI prefer written communication in English.')}`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${canonical}#service`,
    name: 'iPhone Battery Replacement in Cancun',
    serviceType: 'iPhone battery replacement and diagnostic',
    description: pageDescription,
    url: canonical,
    provider: { '@id': 'https://pixon.com.mx/#business' },
    areaServed: [
      { '@type': 'City', name: 'Cancun' },
      { '@type': 'Place', name: 'Cancun Hotel Zone' },
      { '@type': 'Place', name: 'Costa Mujeres' },
      { '@type': 'Place', name: 'Playa Mujeres' },
      { '@type': 'Place', name: 'Puerto Cancun' },
    ],
  },
  buildBreadcrumbSchema([
    { name: 'Home', url: '/en' },
    { name: 'iPhone Repair', url: '/en' },
    { name: 'iPhone Battery Replacement', url: canonical },
  ]),
].filter(Boolean) as object[];

const symptoms = [
  {
    icon: 'fa-battery-quarter',
    title: 'Fast Battery Drain',
    desc: 'Your iPhone drains within a few hours of normal use, loses 20% to 40% overnight, or cannot sustain a full day without multiple charges.',
  },
  {
    icon: 'fa-power-off',
    title: 'Sudden Shutdowns',
    desc: 'The phone powers off unexpectedly while showing 20%, 30%, or 50% battery when taking photos, recording 4K video, or launching apps.',
  },
  {
    icon: 'fa-temperature-arrow-up',
    title: 'Overheating While Charging',
    desc: 'The back or frame gets hot to the touch during charging, heavy gaming, or outdoor use under Cancun’s tropical weather and sun.',
  },
  {
    icon: 'fa-triangle-exclamation',
    title: 'Swollen / Expanded Battery',
    desc: 'The screen is pushing outwards, separating from the metal chassis, or showing internal pressure. Requires immediate safe removal.',
  },
  {
    icon: 'fa-gauge-high',
    title: 'iOS Service Alert & Throttling',
    desc: 'Settings > Battery displays "Service" or capacity below 80%, resulting in stuttering animations and reduced CPU peak performance.',
  },
  {
    icon: 'fa-chart-line-down',
    title: 'Erratic Percentage Jumps',
    desc: 'Battery level drops from 80% to 30% in minutes or jumps 25% instantly when plugging in the charger due to worn internal layers.',
  },
];

const supportedModels = [
  'iPhone 17 Pro Max', 'iPhone 17 Pro', 'iPhone 17', 'iPhone 17e', 'iPhone Air',
  'iPhone 16 Pro Max', 'iPhone 16 Pro', 'iPhone 16 Plus', 'iPhone 16',
  'iPhone 15 Pro Max', 'iPhone 15 Pro', 'iPhone 15 Plus', 'iPhone 15',
  'iPhone 14 Pro Max', 'iPhone 14 Pro', 'iPhone 14 Plus', 'iPhone 14',
  'iPhone 13 Pro Max', 'iPhone 13 Pro', 'iPhone 13 Mini', 'iPhone 13',
  'iPhone 12 Pro Max', 'iPhone 12 Pro', 'iPhone 12 Mini', 'iPhone 12',
  'iPhone 11 Pro Max', 'iPhone 11 Pro', 'iPhone 11',
  'iPhone XR', 'iPhone XS Max', 'iPhone XS', 'iPhone SE',
];

const processSteps = [
  { n: '01', title: 'Intake & Diagnostics', desc: 'We test current draw, iOS health metrics, charging port stability, and inspect for physical swelling or liquid contact.' },
  { n: '02', title: 'Clear Quote & Confirmation', desc: 'We provide a written quote based on the exact iPhone generation and confirmed repair scope before starting work.' },
  { n: '03', title: 'Precision Installation', desc: 'The approved replacement is installed using the procedure appropriate for the model and diagnosis.' },
  { n: '04', title: 'Housing and Seal Assessment', desc: 'The display, frame and seal condition are checked as part of the closing procedure; any limitation is explained before approval.' },
  { n: '05', title: 'Final Testing & Warranty', desc: 'Full testing of charging amperage, thermal stability, cameras, Face ID, and audio before delivery with written warranty.' },
];

const faqs = [
  ['How much does it cost to replace an iPhone battery in Cancun?', 'Pricing depends on the exact iPhone model, confirmed battery option and any additional issue found during assessment. Message us with the model for a clear written quote.'],
  ['How long does iPhone battery replacement take?', 'Timing depends on the exact model, parts availability, diagnosis and testing required. We confirm the expected timing before approved work begins.'],
  ['Can you coordinate service with my hotel in Cancun Hotel Zone or Costa Mujeres?', 'Hotel coordination may be available depending on the location, distance, schedule and repair case. Message us with the hotel or area to confirm the available option in writing.'],
  ['Will I lose my photos, apps, or data during the repair?', 'No. Battery replacement is a direct hardware service that does not wipe or restore your device. All your photos, messages, and settings remain untouched.'],
  ['Will Face ID or True Tone stop working after battery replacement?', 'No. We use professional micro-tools and delicate disassembly techniques that protect the TrueDepth sensor and screen flex cables. Face ID and True Tone remain fully functional.'],
  ['Will iOS show an "Unknown Part" message?', 'On iPhone XS and newer, iOS displays an informational notice in Settings indicating that the battery was replaced outside of Apple’s proprietary server pairing. This is completely standard, cosmetic only, and does NOT affect charging speed, battery lifespan, or daily performance.'],
  ['What should I do if my iPhone battery is swollen or lifting the screen?', 'Power off the phone immediately and do not plug it in. Do not press the screen down or puncture the device. Contact us right away for safe extraction and replacement.'],
  ['Do you provide a warranty for the replacement?', 'The applicable written warranty depends on the approved battery and service scope. We confirm the coverage with the quote before repair.'],
];
---

<Base
  title="iPhone Battery Replacement in Cancun | Pixon PC"
  description={pageDescription}
  canonical={canonical}
  lang="en"
  image="/assets/images/lavado-tarjeta-celular.webp"
  schema={schema}
  bodyClass="ib-en-page"
>
  <Navbar lang="en" />

  <main class="ib-en-main">
    <!-- HERO -->
    <header class="ib-en-hero" aria-labelledby="ib-en-hero-title">
      <div class="ib-en-shell ib-en-hero__grid">
        <div class="ib-en-hero__copy">
          <p class="ib-en-eyebrow"><i class="fa-brands fa-apple" aria-hidden="true"></i> English Support · Cancun & Hotel Zone</p>
          <h1 id="ib-en-hero-title">iPhone Battery Replacement in Cancun</h1>
          <p class="ib-en-lead">
            Is your iPhone draining too fast, overheating in the sun, shutting down unexpectedly, or displaying a battery service alert? We assess the device and explain the battery replacement options that fit the exact model and parts availability.
          </p>
          <div class="ib-en-chips">
            <span><i class="fa-solid fa-check"></i> Model confirmed before repair</span>
            <span><i class="fa-solid fa-check"></i> Written quote and approval</span>
            <span><i class="fa-solid fa-check"></i> Hotel coordination by availability</span>
            <span><i class="fa-solid fa-check"></i> Written English updates</span>
          </div>
          <div class="ib-en-actions">
            <a class="ib-en-btn ib-en-btn--primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
              <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Get a Quote on WhatsApp
            </a>
            <a class="ib-en-btn ib-en-btn--outline" href="#symptoms">
              Identify Symptoms <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
            </a>
          </div>
          <p class="ib-en-note"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i> Service by appointment · written English support on WhatsApp</p>
        </div>

        <aside class="ib-en-card" aria-label="iPhone Battery Diagnostic Simulation">
          <div class="ib-en-card__badge">Workshop Benchmark · Cancun</div>
          <div class="ib-en-metric">
            <div class="ib-en-batt-graphic">
              <div class="ib-en-batt-cap"></div>
              <div class="ib-en-batt-box">
                <div class="ib-en-batt-level"></div>
                <i class="fa-solid fa-bolt ib-en-batt-icon" aria-hidden="true"></i>
              </div>
            </div>
            <div class="ib-en-metric__text">
              <span class="ib-en-metric__label">iOS Battery Health</span>
              <strong class="ib-en-metric__val">74%</strong>
              <span class="ib-en-metric__status"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> Service Recommended</span>
            </div>
          </div>
          <ul class="ib-en-checklist">
            <li><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Current draw & consumption test</li>
            <li><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Precision heat-controlled opening</li>
            <li><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Housing and seal condition assessed before closing</li>
            <li><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Applicable warranty confirmed with the quote</li>
          </ul>
        </aside>
      </div>
    </header>

    <!-- HOTEL & TOURIST SERVICE CALLOUT -->
    <section class="ib-en-section ib-en-section--accent" aria-labelledby="tourist-title">
      <div class="ib-en-shell ib-en-two-col">
        <div>
          <p class="ib-en-kicker">Vacationing in Cancun?</p>
          <h2 id="tourist-title">iPhone battery died while staying at a Cancun resort?</h2>
          <p>
            Beach use, navigation, heat and a worn battery can make an existing battery problem more noticeable during a trip. Send your hotel name or area in Cancun Hotel Zone, Puerto Cancun, Costa Mujeres or Playa Mujeres so we can confirm the available diagnostic and coordination options.
          </p>
        </div>
        <div class="ib-en-callout">
          <h3>Hotel & Resort Coordination</h3>
          <p>Send your iPhone model, iOS battery health (if visible), and hotel or area by WhatsApp. We will confirm the available next step in writing.</p>
          <a class="ib-en-btn ib-en-btn--whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Message on WhatsApp (English)
          </a>
        </div>
      </div>
    </section>

    <!-- SYMPTOMS -->
    <section class="ib-en-section" id="symptoms" aria-labelledby="symptoms-title">
      <div class="ib-en-shell">
        <p class="ib-en-kicker">Diagnostic Indicators</p>
        <h2 id="symptoms-title">Common Signs of a Failing iPhone Battery</h2>
        <p class="ib-en-section-lead">If your iPhone displays any of the following symptoms, the internal lithium-ion cell has reached its chemical lifespan and requires replacement:</p>

        <div class="ib-en-grid-3">
          {symptoms.map((s) => (
            <article class="ib-en-sym-card">
              <div class="ib-en-sym-card__icon"><i class={`fa-solid ${s.icon}`} aria-hidden="true"></i></div>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- SWOLLEN BATTERY WARNING -->
    <section class="ib-en-section ib-en-section--danger" aria-labelledby="swollen-title">
      <div class="ib-en-shell">
        <p class="ib-en-kicker ib-en-kicker--alert"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> Safety Alert</p>
        <h2 id="swollen-title">Swollen iPhone Battery? Critical Safety Precautions</h2>
        <p class="ib-en-section-lead">If the screen is lifting on the left side or the back glass is separating, internal gas has expanded. Follow these steps immediately:</p>

        <div class="ib-en-safety-grid">
          <div class="ib-en-safety-box ib-en-safety-box--do">
            <h3><i class="fa-solid fa-circle-check" aria-hidden="true"></i> What YOU SHOULD do:</h3>
            <ul>
              <li>Disconnect from charger and power banks immediately.</li>
              <li>Turn off the iPhone if the touch screen is still responsive.</li>
              <li>Store the phone on a hard, non-flammable surface at room temperature.</li>
              <li>Bring it to our workshop as soon as possible for safe extraction.</li>
            </ul>
          </div>
          <div class="ib-en-safety-box ib-en-safety-box--dont">
            <h3><i class="fa-solid fa-circle-xmark" aria-hidden="true"></i> What YOU SHOULD NOT do:</h3>
            <ul>
              <li>DO NOT push the screen down or force it closed.</li>
              <li>DO NOT apply tape, glue, or clamps to hold the screen.</li>
              <li>DO NOT puncture, bend, or pierce the swollen battery.</li>
              <li>DO NOT continue charging with fast chargers.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- SUPPORTED MODELS -->
    <section class="ib-en-section ib-en-section--soft" aria-labelledby="models-title">
      <div class="ib-en-shell">
        <p class="ib-en-kicker">Full Compatibility</p>
        <h2 id="models-title">Supported iPhone Models in Cancun</h2>
        <p class="ib-en-section-lead">We maintain replacement batteries and diagnostic tools for all recent iPhone generations:</p>

        <div class="ib-en-pills-wrap">
          {supportedModels.map((m) => (
            <span class="ib-en-model-pill"><i class="fa-brands fa-apple" aria-hidden="true"></i> {m}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="ib-en-section" aria-labelledby="process-title">
      <div class="ib-en-shell">
        <p class="ib-en-kicker">Professional Protocol</p>
        <h2 id="process-title">Our 5-Step Battery Replacement Process</h2>

        <div class="ib-en-process-grid">
          {processSteps.map((step) => (
            <article class="ib-en-proc-card">
              <span class="ib-en-proc-num">{step.n}</span>
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQS -->
    <section class="ib-en-section ib-en-section--soft" aria-labelledby="faq-title">
      <div class="ib-en-shell ib-en-faq-shell">
        <p class="ib-en-kicker">Questions & Answers</p>
        <h2 id="faq-title">Frequently Asked Questions</h2>

        <div class="ib-en-faq-list">
          {faqs.map(([q, a]) => (
            <details class="ib-en-faq-item">
              <summary class="ib-en-faq-q">{q}</summary>
              <div class="ib-en-faq-a"><p>{a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA BANNER -->
    <section class="ib-en-cta-banner">
      <div class="ib-en-shell ib-en-cta-banner__inner">
        <div>
          <h2>Need an iPhone battery replacement in Cancun?</h2>
          <p>Send your iPhone model and location on WhatsApp for a written quote, repair scope and available next step.</p>
        </div>
        <a class="ib-en-btn ib-en-btn--whatsapp-lg" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Chat on WhatsApp Now
        </a>
        <p class="ib-en-crosslink"><a href="/servicios/telefono/cambio-bateria-iphone">View this service in Spanish</a> · <a href="/en">Back to English services</a></p>
      </div>
    </section>
  </main>

  <Footer lang="en" />
</Base>

<style>
.ib-en-page {
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  color: #071F3A;
  background: #f8fafc;
}
.ib-en-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}
.ib-en-hero {
  background:
    radial-gradient(circle at 85% 15%, rgba(59, 130, 246, 0.25), transparent 35%),
    linear-gradient(135deg, #050d1f, #0B1120 60%, #0f172a);
  color: #f8fafc;
  padding: clamp(48px, 6vw, 76px) 0;
}
.ib-en-hero__grid {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
  gap: clamp(28px, 4vw, 48px);
  align-items: center;
}
.ib-en-eyebrow {
  color: #38bdf8;
  font-size: 0.8rem;
  font-weight: 850;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 12px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.ib-en-hero h1 {
  font-family: 'Kanit', sans-serif;
  font-size: clamp(2.1rem, 4.2vw, 3.2rem);
  line-height: 1.15;
  margin: 0 0 14px;
  color: #ffffff;
}
.ib-en-lead {
  font-size: 1.05rem;
  line-height: 1.6;
  color: #cfe7f6;
  margin-bottom: 20px;
}
.ib-en-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 24px;
}
.ib-en-chips span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 999px;
  background: rgba(248, 250, 252, 0.06);
  border: 1px solid rgba(147, 197, 253, 0.18);
  color: #dbeafe;
  font-size: 0.8rem;
  font-weight: 700;
}
.ib-en-chips i {
  color: #4ade80;
}
.ib-en-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-bottom: 12px;
}
.ib-en-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 48px;
  padding: 12px 22px;
  border-radius: 12px;
  text-decoration: none;
  font-weight: 800;
  font-size: 0.94rem;
  transition: all 0.22s ease;
  border: 1px solid transparent;
}
.ib-en-btn--primary {
  background: #16a34a;
  color: #ffffff;
  box-shadow: 0 10px 28px rgba(22, 163, 74, 0.28);
}
.ib-en-btn--primary:hover {
  background: #15803d;
  transform: translateY(-2px);
}
.ib-en-btn--outline {
  border-color: rgba(147, 197, 253, 0.3);
  color: #dbeafe;
  background: rgba(248, 250, 252, 0.06);
}
.ib-en-btn--outline:hover {
  background: rgba(248, 250, 252, 0.12);
  border-color: #38bdf8;
}
.ib-en-btn--whatsapp {
  background: #16a34a;
  color: #ffffff;
  box-shadow: 0 8px 20px rgba(22, 163, 74, 0.25);
}
.ib-en-btn--whatsapp-lg {
  background: #16a34a;
  color: #ffffff;
  padding: 16px 28px;
  font-size: 1.05rem;
  box-shadow: 0 12px 30px rgba(22, 163, 74, 0.3);
}
.ib-en-note {
  font-size: 0.8rem;
  color: #94a3b8;
  display: flex;
  align-items: center;
  gap: 6px;
}

/* Card Visual */
.ib-en-card {
  background: linear-gradient(180deg, rgba(30, 41, 59, 0.7), rgba(15, 23, 42, 0.85));
  border: 1px solid rgba(56, 189, 248, 0.25);
  border-radius: 20px;
  padding: 24px;
  box-shadow: 0 24px 60px rgba(2, 6, 23, 0.45);
  backdrop-filter: blur(12px);
}
.ib-en-card__badge {
  font-size: 0.72rem;
  font-weight: 850;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #38bdf8;
  background: rgba(56, 189, 248, 0.12);
  padding: 4px 10px;
  border-radius: 999px;
  display: inline-block;
  margin-bottom: 16px;
}
.ib-en-metric {
  display: grid;
  grid-template-columns: 70px 1fr;
  gap: 16px;
  align-items: center;
  background: rgba(7, 19, 38, 0.7);
  border: 1px solid rgba(147, 197, 253, 0.14);
  border-radius: 16px;
  padding: 16px;
  margin-bottom: 18px;
}
.ib-en-batt-graphic {
  width: 48px;
  margin: 0 auto;
}
.ib-en-batt-cap {
  width: 16px;
  height: 5px;
  background: #64748b;
  border-radius: 2px 2px 0 0;
  margin: 0 auto;
}
.ib-en-batt-box {
  position: relative;
  width: 48px;
  height: 74px;
  border: 3px solid #64748b;
  border-radius: 8px;
  padding: 2px;
  background: #0a0f1d;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.ib-en-batt-level {
  width: 100%;
  height: 42%;
  background: linear-gradient(180deg, #f59e0b, #ef4444);
  border-radius: 4px;
}
.ib-en-batt-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #ffffff;
}
.ib-en-metric__label {
  font-size: 0.76rem;
  color: #94a3b8;
  text-transform: uppercase;
  font-weight: 700;
}
.ib-en-metric__val {
  font-size: 2.2rem;
  color: #f87171;
  font-family: 'Kanit', sans-serif;
  line-height: 1;
  margin: 4px 0;
}
.ib-en-metric__status {
  font-size: 0.8rem;
  color: #f59e0b;
  font-weight: 750;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.ib-en-checklist {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 10px;
}
.ib-en-checklist li {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.86rem;
  color: #dbeafe;
}
.ib-en-checklist i {
  color: #4ade80;
}

/* Sections */
.ib-en-section {
  padding: clamp(52px, 6vw, 84px) 0;
}
.ib-en-section--soft {
  background: #f1f5f9;
}
.ib-en-section--accent {
  background: #d9f3f8;
  color: #071F3A;
}
.ib-en-section--danger {
  background: #fff5f5;
  border-top: 1px solid #fecaca;
  border-bottom: 1px solid #fecaca;
}
.ib-en-kicker {
  font-size: 0.8rem;
  font-weight: 850;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #2563eb;
  margin-bottom: 8px;
}
.ib-en-section--accent .ib-en-kicker {
  color: #071F3A;
}
.ib-en-kicker--alert {
  color: #dc2626 !important;
}
.ib-en-section h2 {
  font-family: 'Kanit', sans-serif;
  font-size: clamp(1.75rem, 3.2vw, 2.45rem);
  margin: 0 0 12px;
  color: #071F3A;
}
.ib-en-section--accent h2 {
  color: #071F3A;
}
.ib-en-section-lead {
  font-size: 1rem;
  line-height: 1.6;
  color: #071F3A;
  max-width: 820px;
  margin-bottom: 32px;
}

/* Two col callout */
.ib-en-two-col {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
  gap: 36px;
  align-items: center;
}
.ib-en-two-col p {
  color: #071F3A;
  line-height: 1.65;
}
.ib-en-callout {
  background: #ffffff;
  border: 1px solid #9bcfdd;
  border-radius: 18px;
  padding: 24px;
  backdrop-filter: blur(8px);
}
.ib-en-callout h3 {
  font-family: 'Kanit', sans-serif;
  margin: 0 0 10px;
  color: #071F3A;
}
.ib-en-callout p {
  font-size: 0.9rem;
  margin-bottom: 18px;
}

/* Grids */
.ib-en-grid-3 {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 20px;
}
.ib-en-sym-card {
  background: #ffffff;
  border: 1px solid rgba(15, 42, 74, 0.1);
