---
import Base from '../../../layouts/Base.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import CartDrawer from '../../../components/store/CartDrawer.astro';
import storeCss from '../../../styles/store.css?url';
---
<Base title="Store item | Pixon PC" description="View live availability, condition and price in MXN." canonical="https://pixon.com.mx/en/store/item" robots="noindex, follow" extraStyles={[storeCss]} preloadSprite={true} lang="en">
  <Navbar />
  <main class="store-page store-detail-page runtime-product-page" data-runtime-product>
    <nav class="store-shell runtime-product-breadcrumb" aria-label="Breadcrumb"><a href="/en">Home</a><span aria-hidden="true">/</span><a href="/en/store">Store</a><span aria-hidden="true">/</span><span id="runtime-breadcrumb-name">Listing</span></nav>
    <section class="store-shell runtime-product-loading" id="runtime-product-loading" role="status"><span class="store-spinner" aria-hidden="true"></span><p>Loading price, details and availability…</p></section>
    <section class="store-shell runtime-product-error" id="runtime-product-error" hidden aria-labelledby="runtime-error-title"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><h2 id="runtime-error-title">We could not open this listing</h2><p id="runtime-error-message">This listing is unavailable or its address changed.</p><div><a class="store-action store-action-primary" href="/en/store">Back to store</a><a class="store-action store-action-secondary" href="/en/tickets">Create an inquiry ticket</a></div></section>
    <div id="runtime-product-content" hidden>
      <section class="product-detail" aria-labelledby="product-title"><div class="store-shell product-detail-grid"><div class="product-gallery"><div class="product-main-image"><img id="runtime-product-image" src="/assets/images/tienda-hero-pixon.webp" alt="" width="900" height="700" fetchpriority="high" decoding="async" /><span class="product-sold-stamp" id="runtime-sold-stamp" hidden>SOLD</span></div><div class="product-thumbnails" id="runtime-product-thumbnails" aria-label="Listing gallery" hidden></div></div><div class="product-buy-panel"><div class="product-badges" id="runtime-product-badges"></div><h1 id="product-title">Pixon PC store listing</h1><p class="product-lead" id="runtime-product-lead"></p><div class="product-price-block"><del id="runtime-product-original-price" hidden></del><strong id="runtime-product-price">Price on request</strong><span id="runtime-product-saving" hidden></span></div><dl class="product-quick-facts"><div><dt>Availability</dt><dd id="runtime-product-availability">Loading…</dd></div><div><dt>Condition</dt><dd id="runtime-product-condition">—</dd></div><div><dt>Warranty</dt><dd id="runtime-product-warranty">—</dd></div></dl><div class="product-buy-actions"><button class="store-action store-action-primary" id="runtime-add-to-cart" type="button" data-add-to-cart disabled>Checking availability…</button><a class="store-action store-action-secondary" id="runtime-product-whatsapp" href="https://wa.me/529986690777" target="_blank" rel="noopener noreferrer">Ask before buying</a></div><ul class="product-trust-list"><li>The server verifies price and stock at checkout.</li><li>Local Pixon PC service in Cancun.</li><li>Warranty terms are documented when applicable.</li></ul></div></div></section>
      <section class="store-shell product-information" aria-labelledby="runtime-product-specs-title"><article><h2 id="runtime-product-specs-title">Specifications and condition</h2><p id="runtime-product-description"></p><dl class="product-spec-table" id="runtime-product-attributes"></dl></article><aside><h2>Before you confirm</h2><p>Delivery includes only what this listing describes. Confirm accessories, compatibility, installation and service scope before payment.</p><a href="/en/tickets">Create an inquiry ticket</a></aside></section>
    </div>
  </main>
  <CartDrawer showLauncher={true} />
  <Footer />
  <script src="/scripts/store-cart.js?v=20260819-1" is:inline defer></script>
  <script src="/scripts/store-runtime-product.js?v=20260819-1" is:inline defer></script>
</Base>
