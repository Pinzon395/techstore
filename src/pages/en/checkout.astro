---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import storeCss from '../../styles/store.css?url';
---
<Base title="Checkout | Pixon PC" description="Confirm your details and payment method to complete your Pixon PC order." canonical="https://pixon.com.mx/en/checkout" robots="noindex, nofollow" extraStyles={[storeCss]} preloadSprite={true} lang="en">
  <Navbar />
  <main class="store-page private-commerce-page checkout-page">
    <div class="store-shell"><Breadcrumb items={[{ label: 'Home', href: '/en' }, { label: 'Cart', href: '/en/cart' }, { label: 'Checkout' }]} /></div>
    <section class="store-shell" aria-labelledby="checkout-title">
      <header class="checkout-header"><p class="store-section-label">Pixon PC Order</p><h1 id="checkout-title">Confirm your order</h1><ol class="checkout-stepper" aria-label="Progress"><li class="is-done">Cart</li><li class="is-active">Details</li><li>Payment</li><li>Confirmation</li></ol></header>
      <form id="checkout-form" class="checkout-layout" novalidate>
        <div class="checkout-form-card">
          <fieldset><legend>Contact information</legend><div class="checkout-fields"><label><span>Full name *</span><input name="name" autocomplete="name" maxlength="120" required /></label><label><span>Phone number *</span><input name="phone" type="tel" autocomplete="tel" maxlength="24" required /></label><label class="span-2"><span>Email address *</span><input name="email" type="email" autocomplete="email" maxlength="190" required /></label></div></fieldset>
          <fieldset><legend>Delivery</legend><div class="checkout-options"><label><input type="radio" name="delivery_method" value="PICKUP" checked /><span><strong>Pick up at Pixon PC</strong><small>Cto. Hacienda Chimay, 77539 Cancún, Q.R.</small></span></label><label><input type="radio" name="delivery_method" value="LOCAL_DELIVERY" /><span><strong>Local delivery</strong><small>We will coordinate coverage and delivery fee before preparing.</small></span></label><label><input type="radio" name="delivery_method" value="SERVICE_ON_SITE" /><span><strong>On-site service</strong><small>Available only for compatible services.</small></span></label></div><label class="checkout-note"><span>Delivery notes</span><textarea name="delivery_note" maxlength="1000" rows="3"></textarea></label></fieldset>
          <fieldset><legend>Payment method</legend><div class="checkout-options" id="checkout-payment-methods"><div class="cart-skeleton"></div></div><label class="checkout-note"><span>Discount coupon</span><input name="coupon_codes" autocomplete="off" maxlength="160" aria-describedby="checkout-coupon-help" placeholder="e.g. PIXON10" /><small id="checkout-coupon-help">If you have multiple, separate with a comma. The server validates validity, priority, and accumulation.</small></label></fieldset>
          <div class="checkout-message" id="checkout-message" role="alert" hidden></div>
        </div>
        <aside class="cart-summary checkout-summary"><h2>Your order</h2><div id="checkout-items"></div><dl><div><dt>Subtotal</dt><dd id="checkout-subtotal">$0.00</dd></div><div><dt>Estimated discount</dt><dd id="checkout-discount">-$0.00</dd></div><div class="cart-total"><dt>Estimated total</dt><dd id="checkout-total">$0.00</dd></div></dl><p>The server recalculates totals and reserves inventory upon confirmation.</p><p class="checkout-submit-note"><strong>This step does not charge your card yet.</strong> We will create the order as pending payment, send confirmation to your email, and Pixon PC will contact you with next steps.</p><button class="store-action store-action-primary" id="checkout-submit" type="submit">Place order and receive instructions</button><a class="store-action store-action-secondary" href="/en/cart">Back to cart</a></aside>
      </form>
    </section>
  </main>
  <Footer />
  <script src="/scripts/store-cart.js?v=20260819-1" is:inline defer></script>
  <script src="/scripts/checkout.js?v=20260819-1" is:inline defer></script>
</Base>
