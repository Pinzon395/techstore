---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CartDrawer from '../../components/store/CartDrawer.astro';
import storeCss from '../../styles/store.css?url';
---
<Base title="Cart | Pixon PC" description="Review your selection before purchasing at Pixon PC." canonical="https://pixon.com.mx/en/cart" robots="noindex, nofollow" extraStyles={[storeCss]} preloadSprite={true} lang="en">
  <Navbar />
  <main class="store-page private-commerce-page">
    <div class="store-shell"><Breadcrumb items={[{ label: 'Home', href: '/en' }, { label: 'Store', href: '/en/store' }, { label: 'Cart' }]} /></div>
    <section class="store-shell cart-page" aria-labelledby="cart-title">
      <header><p class="store-section-label">Secure purchase</p><h1 id="cart-title">Your cart</h1><p>We revalidate price, promotions and availability with the server before proceeding.</p></header>
      <div class="cart-layout">
        <div class="cart-items" id="cart-items" aria-live="polite"><div class="cart-skeleton"></div><div class="cart-skeleton"></div></div>
        <aside class="cart-summary">
          <h2>Summary</h2>
          <dl><div><dt>Subtotal</dt><dd id="cart-subtotal">$0.00</dd></div><div><dt>Estimated discounts</dt><dd id="cart-discount">-$0.00</dd></div><div class="cart-total"><dt>Estimated total</dt><dd id="cart-total">$0.00</dd></div></dl>
          <p id="cart-validation-note">Preparing validation…</p>
          <a class="store-action store-action-primary" id="cart-checkout" href="/en/checkout" aria-disabled="true">Proceed to checkout</a>
          <a class="store-action store-action-secondary" href="/en/store">Continue shopping</a>
        </aside>
      </div>
      <div class="store-state" id="cart-empty" hidden><h2>Your cart is empty</h2><p>Explore available equipment, hardware, services and packages.</p><a href="/en/store">Browse the store</a></div>
    </section>
  </main>
  <CartDrawer />
  <Footer />
  <script src="/scripts/store-cart.js?v=20260819-1" is:inline defer></script>
  <script src="/scripts/cart-page.js?v=20260819-1" is:inline defer></script>
</Base>
