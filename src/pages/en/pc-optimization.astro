      var country = document.getElementById('lead-country').value || '';
      var lang = document.getElementById('lead-lang').value || 'English';
      var cpu = document.getElementById('lead-cpu').value || '';
      var gpu = document.getElementById('lead-gpu').value || '';
      var ram = document.getElementById('lead-ram').value || '';
      var os = document.getElementById('lead-os').value || '';
      var game = document.getElementById('lead-game').value || '';
      var symptom = document.getElementById('lead-symptom').value || '';
      var fps = document.getElementById('lead-fps').value || 'Not specified';
      var net = document.getElementById('lead-net').value || '';

      var msg = 'Hello Pixon PC! I am requesting a diagnostic for remote PC optimization:\n\n' +
                '📍 Country: ' + country + ' (' + lang + ')\n' +
                '💻 Hardware: CPU: ' + cpu + ' | GPU: ' + gpu + ' | RAM: ' + ram + '\n' +
                '🪟 OS: ' + os + ' | Network: ' + net + '\n' +
                '🎮 Main Game / App: ' + game + '\n' +
                '⚠️ Primary Symptom: ' + symptom + '\n' +
                '📊 Current / Expected FPS: ' + fps + '\n\n' +
                'Source: pixon.com.mx/en/pc-optimization';

      var waUrl = 'https://wa.me/529986690777?text=' + encodeURIComponent(msg);
      if (window.smartWaRedirect) {
        window.smartWaRedirect(waUrl);
      } else {
        window.open(waUrl, '_blank');
      }
    });
  });
