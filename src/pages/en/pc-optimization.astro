    background: #1e293b;
    border-radius: 6px;
    padding: 6px 10px;
    border: 1px solid #334155;
  }

  .opt-frametime-svg {
    width: 100%;
    height: 28px;
    display: block;
  }

  .opt-hw-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid #1e293b;
    padding: 12px;
    border-radius: 10px;
  }

  .opt-hw-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .opt-hw-label {
    font-size: 0.74rem;
    font-weight: 700;
    color: #64748b !important;
  }

  .opt-hw-val {
    font-size: 0.88rem;
    font-weight: 800;
    font-family: monospace;
    color: #cbd5e1 !important;
  }

  .opt-lab-panel__footer {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 10px;
    border-top: 1px solid #1e293b;
    font-size: 0.72rem;
    font-weight: 800;
    color: #7dd3fc !important;
    letter-spacing: 0.5px;
  }

  .opt-disclaimer-note {
    font-size: 0.75rem;
    color: #94a3b8;
    margin-top: 8px;
    text-align: center;
    line-height: 1.3;
  }

  /* 2. GENERAL SECTION STYLES */
  .opt-section {
    padding: 65px 0;
    border-bottom: 1px solid var(--border-light);
  }

  .opt-section--white {
    background: #ffffff;
  }

  .opt-section--light {
    background: #f8fafc;
  }

  .opt-section-header {
    max-width: 800px;
    margin-bottom: 40px;
  }

  .opt-section-header.text-center {
    margin-left: auto;
    margin-right: auto;
  }

  .opt-section-badge {
    display: inline-block;
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 1.2px;
    color: #2563eb !important;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    padding: 4px 12px;
    border-radius: 14px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .opt-section-header h2 {
    font-family: var(--font-heading, 'Kanit', sans-serif);
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 14px;
  }

  .opt-section-desc {
    font-size: 1.05rem;
    color: #475569 !important;
    line-height: 1.6;
    margin: 0;
  }

  /* 3. PROBLEM SELECTOR GRID (8 CARDS) */
  .opt-problems-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
  }

  .opt-problem-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 14px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .opt-problem-card:hover {
    transform: translateY(-3px);
    border-color: #3b82f6;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.06);
  }

  .opt-problem-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .opt-problem-badge {
    font-size: 0.72rem;
    font-weight: 800;
    background: #f1f5f9;
    color: #475569 !important;
    padding: 3px 8px;
    border-radius: 6px;
    letter-spacing: 0.5px;
  }

  .opt-problem-icon {
    font-size: 1.25rem;
    color: #2563eb;
  }

  .opt-problem-card__title {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: 8px;
  }

  .opt-problem-card__desc {
    font-size: 0.88rem;
    color: #475569 !important;
    line-height: 1.5;
    margin: 0;
  }

  /* 4. BOTTLENECK & HARDWARE SECTION */
  .opt-two-col-layout {
    display: flex;
    gap: 40px;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .opt-text-block {
    flex: 1.2;
    min-width: 320px;
    font-size: 1rem;
    line-height: 1.65;
  }

  .opt-checklist {
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
  }

  .opt-checklist li {
    position: relative;
    padding-left: 28px;
    margin-bottom: 14px;
    font-size: 0.94rem;
    color: #334155 !important;
    line-height: 1.55;
  }

  .opt-checklist li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    color: #2563eb;
    font-weight: 900;
    font-size: 1.1rem;
  }

  .opt-visual-block {
    flex: 1;
    min-width: 320px;
  }

  .opt-comparison-box {
    background: #f8fafc;
    border: 1px solid var(--border-light);
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.04);
  }

  .opt-comparison-header {
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.8px;
    color: #64748b !important;
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 10px;
    margin-bottom: 16px;
  }

  .opt-case-comparison {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .opt-case-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 12px;
    padding: 16px;
  }

  .opt-case-card--cpu {
    border-left: 4px solid #ef4444;
  }

  .opt-case-card--gpu {
    border-left: 4px solid #10b981;
  }

  .opt-case-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .opt-case-tag {
    font-size: 0.68rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
    background: #0f172a;
    color: #ffffff !important;
  }

  .opt-case-title h4 {
    font-size: 0.96rem;
    font-weight: 800;
    margin: 0;
  }

  .opt-metric-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
    padding: 4px 0;
    border-bottom: 1px dashed #f1f5f9;
  }

  .opt-case-result {
    font-size: 0.82rem;
    color: #475569 !important;
    line-height: 1.45;
    margin: 10px 0 0;
  }

  .opt-comparison-note {
    margin-top: 16px;
    font-size: 0.78rem;
    color: #64748b !important;
    line-height: 1.4;
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }

  /* 5. HARDWARE TIERS */
  .opt-tiers-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .opt-tier-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 16px;
    padding: 30px;
    display: flex;
    gap: 28px;
    align-items: flex-start;
  }

  @media (max-width: 767px) {
    .opt-tier-card {
      flex-direction: column;
      gap: 16px;
      padding: 20px;
    }
  }

  .opt-tier-icon-wrap {
    width: 54px;
    height: 54px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #2563eb;
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .opt-tier-content {
    flex: 1;
  }

  .opt-tier-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    color: #2563eb !important;
    letter-spacing: 0.8px;
    margin-bottom: 8px;
  }

  .opt-tier-content h2 {
    font-size: 1.35rem;
    font-weight: 800;
    margin-bottom: 10px;
  }

  .opt-tier-content p {
    font-size: 0.94rem;
    color: #475569 !important;
    line-height: 1.6;
    margin-bottom: 14px;
  }

  .opt-tier-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 8px 20px;
  }

  .opt-tier-list li {
    font-size: 0.88rem;
    color: #334155 !important;
    position: relative;
    padding-left: 20px;
    line-height: 1.5;
  }

  .opt-tier-list li::before {
    content: '•';
    position: absolute;
    left: 4px;
    color: #2563eb;
    font-weight: 900;
    font-size: 1.1rem;
  }

  /* Real Work Hardware Evidence Block */
  .opt-hw-evidence-block {
    margin-top: 48px;
    padding-top: 40px;
    border-top: 1px solid var(--border-light);
  }

  .opt-hw-evidence-header {
    max-width: 780px;
    margin-bottom: 28px;
  }

  .opt-hw-evidence-header h3 {
    margin: 10px 0 12px;
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    font-weight: 800;
    color: #071F3A;
  }

  .opt-hw-evidence-header p {
    color: #071F3A;
    font-size: 0.96rem;
    line-height: 1.6;
    margin: 0;
  }

  .opt-hw-evidence-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .opt-hw-evidence-card {
    margin: 0;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(7, 31, 58, 0.06);
    display: flex;
    flex-direction: column;
  }

  .opt-hw-evidence-media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: #071F3A;
    overflow: hidden;
  }

  .opt-hw-evidence-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 300ms ease;
  }

  .opt-hw-evidence-card:hover .opt-hw-evidence-media img {
    transform: scale(1.03);
  }

  .opt-hw-evidence-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    background: rgba(7, 31, 58, 0.88);
    backdrop-filter: blur(6px);
    color: #38bdf8;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    padding: 5px 10px;
    border-radius: 6px;
    border: 1px solid rgba(56, 189, 248, 0.4);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .opt-hw-evidence-caption {
    padding: 16px 20px;
    font-size: 0.88rem;
    color: #071F3A;
    line-height: 1.55;
    background: #ffffff;
    border-top: 1px solid #e1eff5;
    flex-grow: 1;
  }

  .opt-hw-evidence-caption strong {
    color: #071F3A;
  }

  @media (max-width: 768px) {
    .opt-hw-evidence-grid {
      grid-template-columns: 1fr;
    }
  }

  /* 6. FRAMETIME COMPARISON */
  .opt-frametime-comparison {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
    margin-top: 30px;
  }

  .opt-pacing-card {
    border-radius: 16px;
    padding: 26px;
    border: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .opt-pacing-card--before {
    background: #fff8f8;
    border-color: #fecaca;
  }

  .opt-pacing-card--after {
    background: #f0fdf4;
    border-color: #bbf7d0;
  }

  .opt-pacing-header h4 {
    font-size: 1.2rem;
    font-weight: 800;
    margin: 8px 0 0;
  }

  .opt-status-tag {
    font-size: 0.72rem;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 6px;
    display: inline-block;
  }

  .opt-status-tag--bad {
    background: #fee2e2;
    color: #b91c1c !important;
  }

  .opt-status-tag--good {
    background: #dcfce7;
    color: #15803d !important;
  }

  .opt-pacing-metrics {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .opt-metric-pill {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 0.82rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .opt-metric-pill strong {
    font-size: 1rem;
    font-family: monospace;
  }

  .opt-metric-pill--bad strong {
    color: #dc2626 !important;
  }

  .opt-metric-pill--good strong {
    color: #16a34a !important;
  }

  .opt-graph-container {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 12px;
    padding: 16px;
  }

  .opt-graph-title {
    font-size: 0.76rem;
    font-weight: 800;
    color: #64748b !important;
    margin-bottom: 8px;
  }

  .opt-pacing-svg {
    width: 100%;
    height: 70px;
    display: block;
  }

  .opt-graph-footer {
    font-size: 0.8rem;
    font-weight: 700;
    margin-top: 10px;
    line-height: 1.4;
  }

  /* 7. TECHNICAL GRID (PILLARS) */
  .opt-technical-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 22px;
  }

  .opt-tech-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 14px;
    padding: 24px;
    display: flex;
    flex-direction: column;
  }

  .opt-tech-card__icon {
    width: 44px;
    height: 44px;
    background: #eff6ff;
    color: #2563eb;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    margin-bottom: 16px;
  }

  .opt-tech-card h3 {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .opt-tech-card p {
    font-size: 0.88rem;
    color: #475569 !important;
    line-height: 1.5;
    margin-bottom: 12px;
  }

  .opt-tech-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .opt-tech-card li {
    font-size: 0.84rem;
    color: #334155 !important;
    line-height: 1.45;
    margin-bottom: 8px;
    position: relative;
    padding-left: 16px;
  }

  .opt-tech-card li::before {
    content: '›';
    position: absolute;
    left: 2px;
    top: 0;
    color: #2563eb;
    font-weight: 900;
    font-size: 1rem;
  }

  /* 8. AUDIT STACK (7 LAYERS) */
  .opt-stack-container {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .opt-stack-row {
    background: #f8fafc;
    border: 1px solid var(--border-light);
    border-radius: 12px;
    padding: 16px 22px;
    display: flex;
    align-items: center;
    gap: 20px;
    transition: border-color 0.2s ease;
  }

  .opt-stack-row:hover {
    border-color: #3b82f6;
  }

  @media (max-width: 640px) {
    .opt-stack-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }

  .opt-stack-step {
    font-size: 1.1rem;
    font-weight: 900;
    font-family: monospace;
    color: #2563eb;
    background: #eff6ff;
    padding: 4px 10px;
    border-radius: 8px;
  }

  .opt-stack-title {
    font-size: 0.95rem;
    font-weight: 800;
    min-width: 140px;
    letter-spacing: 0.5px;
  }

  .opt-stack-items {
    font-size: 0.88rem;
    color: #475569 !important;
    flex: 1;
    line-height: 1.45;
  }

  /* 9. GAMES GRID */
  .opt-games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-bottom: 24px;
  }

  .opt-game-group-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 14px;
    padding: 22px;
  }

  .opt-game-cat {
    font-size: 0.72rem;
    font-weight: 800;
    color: #2563eb !important;
    letter-spacing: 0.8px;
    display: block;
    margin-bottom: 8px;
  }

  .opt-game-names {
    font-size: 1.1rem;
    font-weight: 800;
    margin-bottom: 10px;
    line-height: 1.35;
  }

  .opt-game-note {
    font-size: 0.86rem;
    color: #475569 !important;
    line-height: 1.5;
    margin: 0;
  }

  .opt-callout-box {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 12px;
    padding: 18px 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--azul-oscuro);
  }

  .opt-callout-icon {
    font-size: 1.6rem;
    color: #2563eb;
    flex-shrink: 0;
  }

  /* 10. TRUST SECTION */
  .opt-trust-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }

  .opt-trust-card {
    border-radius: 16px;
    padding: 28px;
    border: 1px solid var(--border-light);
  }

  .opt-trust-card--danger {
    background: #fffafa;
    border-color: #fee2e2;
  }

  .opt-trust-card--success {
    background: #f8fdfa;
    border-color: #dcfce7;
  }

  .opt-trust-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
  }

  .opt-trust-header h3 {
    font-size: 1.08rem;
    font-weight: 800;
    margin: 0;
    letter-spacing: 0.5px;
  }

  .opt-trust-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .opt-trust-list li {
    font-size: 0.9rem;
    line-height: 1.55;
    margin-bottom: 12px;
    position: relative;
    padding-left: 20px;
    color: #334155 !important;
  }

  .opt-trust-card--danger li::before {
    content: '✕';
    position: absolute;
    left: 0;
    color: #ef4444;
    font-weight: 900;
  }

  .opt-trust-card--success li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: #10b981;
    font-weight: 900;
  }

  /* 11. WORKFLOW DIAGRAM & GUARANTEES */
  .opt-workflow-diagram {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 16px;
    padding: 26px;
    margin-bottom: 30px;
    flex-wrap: wrap;
  }

  .opt-flow-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 6px;
    flex: 1;
    min-width: 140px;
  }

  .opt-node-icon {
    width: 48px;
    height: 48px;
    background: #eff6ff;
    color: #2563eb;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
  }

  .opt-node-title {
    font-size: 0.9rem;
    font-weight: 800;
  }

  .opt-node-desc {
    font-size: 0.76rem;
    color: #64748b !important;
  }

  .opt-flow-arrow {
    color: #94a3b8;
    font-size: 1.1rem;
  }

  @media (max-width: 767px) {
    .opt-flow-arrow {
      display: none;
    }
  }

  .opt-remote-guarantees {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 24px;
  }

  .opt-guarantee-item {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 14px;
    padding: 22px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .opt-guarantee-item i {
    font-size: 1.3rem;
    color: #2563eb;
    margin-top: 2px;
    flex-shrink: 0;
  }

  .opt-guarantee-item strong {
    display: block;
    font-size: 0.96rem;
    margin-bottom: 6px;
  }

  .opt-guarantee-item p {
    font-size: 0.86rem;
    color: #475569 !important;
    line-height: 1.5;
    margin: 0;
  }

  .opt-bios-box {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 14px;
    padding: 22px;
  }

  .opt-bios-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
    color: #1e40af;
  }

  .opt-bios-header h4 {
    font-size: 1rem;
    font-weight: 800;
    margin: 0;
  }

  .opt-bios-box p {
    font-size: 0.88rem;
    color: #334155 !important;
    line-height: 1.55;
    margin: 0;
  }

  /* 12. METHODOLOGY */
  .opt-method-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }

  .opt-method-card {
