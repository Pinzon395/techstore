---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import WaterDamageHeroVisual from '../../components/WaterDamageHeroVisual.astro';
import { buildBreadcrumbSchema } from '../../lib/schema';

const canonical = 'https://pixon.com.mx/en/liquid-damage';
const pageDescription = 'Water damage phone repair in Cancun for ocean, salt water, pool and fresh water incidents. Hotel pickup coordination in Cancun Hotel Zone and Costa Mujeres.';
const whatsappUrl = `https://wa.me/529986690777?text=${encodeURIComponent('Hi Pixon PC. My phone got wet. I am in: ____. Phone model: ____. Liquid: ____. When it happened: ____.')}`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${canonical}#service`,
    name: 'Water Damage Phone Repair in Cancun',
    serviceType: 'Water damage phone repair',
    description: pageDescription,
    url: canonical,
    provider: { '@id': 'https://pixon.com.mx/#business' },
    areaServed: [
      { '@type': 'City', name: 'Cancun' },
      { '@type': 'Place', name: 'Cancun Hotel Zone' },
      { '@type': 'Place', name: 'Costa Mujeres' },
      { '@type': 'Place', name: 'Playa Mujeres' },
    ],
  },
  buildBreadcrumbSchema([
    { name: 'Home', url: '/en' },
    { name: 'Phone repair', url: '/en' },
    { name: 'Water damage phone repair', url: canonical },
  ]),
].filter(Boolean) as object[];

const faqs = [
  ['What should I do if my phone falls in the ocean in Cancun?', 'Keep it powered off, do not charge it and do not keep testing it. Tell us whether it was salt water, pool water or fresh water so we can guide the next step.'],
  ['Is salt water worse than fresh water for a phone?', 'Salt water leaves conductive and corrosive residue. Fresh water can also reach the port, flexes, battery, display and board, so neither should be treated as harmless.'],
  ['Can you pick up my phone from my hotel in Cancun?', 'We can coordinate reception or pickup according to the hotel, area and type of damage. Message us with the hotel or area; a room number is not required.'],
  ['Do you offer phone repair service in Cancun Hotel Zone?', 'Yes. We coordinate local service for guests and residents in Cancun Hotel Zone. Severe liquid damage, board work and ultrasonic cleaning normally require workshop handling.'],
  ['Should I charge a wet phone to test it?', 'No. Applying power while moisture or residue remains can worsen a short. Keep it disconnected until it has been assessed.'],
  ['Does rice fix a water-damaged phone?', 'No. Rice does not remove residue or corrosion and particles can enter the ports. Avoid heat, compressed air and repeated power tests too.'],
  ['Can you recover photos from a water-damaged phone?', 'We can assess a data-priority route. Recovery depends on the condition of the board and storage, so no result is promised before inspection.'],
  ['How much does water damage phone repair cost in Cancun?', 'There is no fixed price for every case. The quote depends on the liquid, elapsed time, power attempts, affected parts and whether board work or data recovery is needed.'],
  ['How long does water damage repair take?', 'The timing depends on the condition and tests required. We explain the expected next step after receiving enough information to assess the case.'],
];
---

<Base
  title="Water Damage Phone Repair in Cancun | English Support | Pixon PC"
  description={pageDescription}
  canonical={canonical}
  lang="en"
  image="/assets/images/lavado-tarjeta-celular.webp"
  schema={schema}
  bodyClass="water-english-page"
>
  <Navbar lang="en" />
  <main class="water-english-page__main">
    <header class="water-english-hero" aria-labelledby="water-english-title">
      <div class="water-english-shell water-english-hero__grid">
        <div class="water-english-copy">
          <p class="water-english-eyebrow"><i class="fa-solid fa-language" aria-hidden="true"></i> English support in Cancun</p>
          <h1 id="water-english-title">Water Damage Phone Repair in Cancun</h1>
          <p class="water-english-lead">Dropped your phone in the ocean, salt water, pool or fresh water while staying in Cancun? Keep it powered off. We assess liquid damage, corrosion and charging issues, coordinating local service and hotel pickup when appropriate.</p>
          <div class="water-english-actions">
            <a class="water-english-btn water-english-btn--primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> My phone got wet in Cancun</a>
            <a class="water-english-btn water-english-btn--outline" href="#what-to-do">What should I do now?</a>
          </div>
          <p class="water-english-note"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i> Service by appointment · written English support and pickup coordination subject to availability</p>
        </div>
        <div class="water-english-visual"><WaterDamageHeroVisual lang="en" /></div>
      </div>
    </header>

    <section class="water-english-section water-english-section--soft" aria-labelledby="hotel-english-title">
      <div class="water-english-shell water-english-two-col">
        <div>
          <p class="water-english-kicker">For tourists, hotel guests and expats</p>
          <h2 id="hotel-english-title">Water-damaged phone while staying at a Cancun hotel?</h2>
          <p>If it happened at the beach, in the ocean, at a resort pool, during an excursion, in the rain or after a drink spill, message us with your hotel or area. We coordinate reception or pickup in Cancun, Costa Mujeres and Playa Mujeres, and explain when the phone needs workshop inspection.</p>
        </div>
        <div class="water-english-callout">
          <h3>Hotel pickup in Cancun and Costa Mujeres</h3>
          <p>Send the hotel or area, phone model, liquid and time of the incident. Availability and any pickup charge depend on distance and the case; do not share a room number in a public form.</p>
          <a class="water-english-btn water-english-btn--whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Coordinate hotel pickup</a>
        </div>
      </div>
    </section>

    <section class="water-english-section" id="what-to-do" aria-labelledby="what-to-do-title">
      <div class="water-english-shell">
        <p class="water-english-kicker">First steps</p>
        <h2 id="what-to-do-title">What to do after your phone gets wet</h2>
        <div class="water-english-step-grid">
          <article><span>01</span><h3>Do not connect it</h3><p>Remove the charger and accessories. Do not charge it to see if it still works.</p></article>
          <article><span>02</span><h3>Power it off</h3><p>If it is still on and can be powered off safely, turn it off and stop testing it.</p></article>
          <article><span>03</span><h3>Do not shake it</h3><p>Dry only the outside with a soft cloth. Avoid rice, heat and compressed air.</p></article>
        </div>
      </div>
    </section>

    <section class="water-english-section water-english-section--navy" aria-labelledby="water-types-title">
      <div class="water-english-shell water-english-two-col">
        <div>
          <p class="water-english-kicker">The liquid matters</p>
          <h2 id="water-types-title">Ocean, salt water, pool and fresh water damage</h2>
          <p>Salt, chlorine and drink residue can remain after the outside looks dry. Water can reach the charging port, flexes, display, battery, cameras, microphone or board. The inspection route depends on what happened and whether power was applied afterward.</p>
        </div>
        <ul class="water-english-checks">
          <li><i class="fa-solid fa-water" aria-hidden="true"></i> Phone dropped in ocean or sea</li>
          <li><i class="fa-solid fa-person-swimming" aria-hidden="true"></i> Phone dropped in hotel pool</li>
          <li><i class="fa-solid fa-cloud-rain" aria-hidden="true"></i> Rain, humidity or fresh water</li>
          <li><i class="fa-solid fa-bolt" aria-hidden="true"></i> Charging warning, black screen or heat</li>
        </ul>
      </div>
    </section>

    <section class="water-evidence-section" aria-labelledby="evidence-english-title">
      <div class="water-english-shell">
        <div class="water-evidence-header">
          <p class="water-english-kicker">Bench Diagnostics Evidence in Cancun</p>
          <h2 id="evidence-english-title">Optical Microscope Diagnostics & Board-Level Repair</h2>
          <p class="water-evidence-desc">Real photos from Pixon PC private diagnostics bench showing severe liquid corrosion and separated logic board microcomponents under high-magnification inspection.</p>
        </div>
        <div class="water-evidence-grid">
          <figure class="water-evidence-card">
            <div class="water-evidence-img-wrap">
              <span class="water-evidence-badge"><i class="fa-solid fa-microscope" aria-hidden="true"></i> REAL PIXON PC REPAIR</span>
              <picture>
                <source media="(max-width: 640px)" srcset="/assets/images/real-work/iphone-sulfatado-dano-liquido-microsoldadura-sm.webp 420w, /assets/images/real-work/iphone-sulfatado-dano-liquido-microsoldadura-md.webp 720w" sizes="(max-width: 640px) 100vw, 560px" />
                <source srcset="/assets/images/real-work/iphone-sulfatado-dano-liquido-microsoldadura.webp" />
                <img src="/assets/images/real-work/iphone-sulfatado-dano-liquido-microsoldadura.webp" alt="Liquid corrosion and oxidation on logic board microcomponents under microscope" width="960" height="1280" loading="lazy" decoding="async" />
              </picture>
            </div>
            <figcaption class="water-evidence-caption">
              <strong>Severe liquid corrosion:</strong> Oxidation on microscopic SMD components. Ultrasonic cleaning and short-circuit diagnosis are performed before applying power.
            </figcaption>
          </figure>
          <figure class="water-evidence-card">
            <div class="water-evidence-img-wrap">
              <span class="water-evidence-badge"><i class="fa-solid fa-microscope" aria-hidden="true"></i> REAL PIXON PC REPAIR</span>
              <picture>
                <source media="(max-width: 640px)" srcset="/assets/images/real-work/motherboard-iphone-microcomponentes-reparacion-sm.webp 420w, /assets/images/real-work/motherboard-iphone-microcomponentes-reparacion-md.webp 720w" sizes="(max-width: 640px) 100vw, 560px" />
                <source srcset="/assets/images/real-work/motherboard-iphone-microcomponentes-reparacion.webp" />
                <img src="/assets/images/real-work/motherboard-iphone-microcomponentes-reparacion.webp" alt="Separated sandwich logic board layer showing microcomponents during diagnostic inspection" width="960" height="1280" loading="lazy" decoding="async" />
              </picture>
            </div>
            <figcaption class="water-evidence-caption">
              <strong>Sandwich logic board inspection:</strong> Layer separation to diagnose damaged main power lines and perform micro-soldering for device stability and data recovery.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="water-english-section" aria-labelledby="process-english-title">
      <div class="water-english-shell water-english-two-col">
        <div>
          <p class="water-english-kicker">Technical assessment</p>
          <h2 id="process-english-title">How we assess a water-damaged phone</h2>
        </div>
        <ol class="water-english-process">
          <li><strong>Incident history</strong><span>Model, liquid, elapsed time and power attempts.</span></li>
          <li><strong>Safe inspection</strong><span>Battery disconnection, LCI, ports, flexes and visible residue.</span></li>
          <li><strong>Electrical diagnosis</strong><span>Corrosion, board lines, consumption and affected modules.</span></li>
          <li><strong>Quote before work</strong><span>Cleaning, module repair, board work or data priority only with your approval.</span></li>
        </ol>
      </div>
    </section>

    <section class="water-english-section water-english-section--soft" aria-labelledby="faq-english-title">
      <div class="water-english-shell water-english-faq">
        <p class="water-english-kicker">Clear answers</p>
        <h2 id="faq-english-title">Water damage phone repair FAQ</h2>
        {faqs.map(([question, answer]) => (
          <details><summary>{question}</summary><p>{answer}</p></details>
        ))}
      </div>
    </section>

    <section class="water-english-final" aria-labelledby="final-english-title">
      <div class="water-english-shell">
        <h2 id="final-english-title">My phone got wet in Cancun</h2>
        <p>Tell us what liquid reached it, where you are staying and whether your photos or files are the priority. We will explain the next step before any intervention.</p>
        <a class="water-english-btn water-english-btn--whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Contact Pixon PC on WhatsApp</a>
        <p class="water-english-crosslink"><a href="/servicios/telefono/celular-mojado">View this service in Spanish</a> · <a href="/en">Back to English services</a></p>
      </div>
    </section>
  </main>
  <Footer lang="en" />
</Base>

<style>
  .water-english-page__main { color: #071F3A; background: #fff; }
  .water-english-page__main *, .water-english-page__main h1, .water-english-page__main h2, .water-english-page__main h3, .water-english-page__main p { box-sizing: border-box; }
  .water-english-shell { width: min(1180px, calc(100% - (var(--page-gutter) * 2))); margin-inline: auto; }
  .water-english-hero { padding: 76px 0 64px; background: linear-gradient(135deg, #06172c, #0a4166 58%, #06233f); color: #fff; }
  .water-english-hero__grid, .water-english-two-col { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, .78fr); gap: clamp(30px, 6vw, 78px); align-items: center; }
  .water-english-copy h1 { max-width: 650px; margin: 0; color: #fff; font-family: var(--font-heading, sans-serif); font-size: clamp(2.8rem, 4.6vw, 4.65rem); line-height: .95; letter-spacing: -.04em; font-style: normal !important; text-wrap: balance; }
  .water-english-eyebrow, .water-english-kicker { margin: 0 0 13px; color: #2cbdd3; font-size: .78rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .water-english-lead { max-width: 680px; margin: 22px 0 0; color: #d5eef7; font-size: 1.08rem; line-height: 1.7; }
  .water-english-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .water-english-btn { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; gap: 9px; padding: 13px 19px; border-radius: 10px; font-weight: 900; text-decoration: none; transition: transform 160ms ease, background-color 160ms ease; }
  .water-english-btn:hover { transform: translateY(-2px); }
  .water-english-btn:focus-visible { outline: 3px solid #f7c948; outline-offset: 3px; }
  .water-english-btn--primary, .water-english-btn--whatsapp { background: #25D366; color: #042b1a; }
  .water-english-btn--primary:hover, .water-english-btn--whatsapp:hover { background: #53e486; }
  .water-english-btn--outline { border: 1px solid rgba(201, 236, 246, .45); color: #fff; }
  .water-english-btn--outline:hover { background: rgba(255,255,255,.1); }
  .water-english-note { display: flex; gap: 8px; align-items: center; margin: 18px 0 0; color: #b8d8e3; font-size: .82rem; }
  .water-english-note i { color: #55d1e0; }
  .water-english-section { padding: clamp(60px, 8vw, 96px) 0; background: #fff; }
  .water-english-section--soft { background: #f5fafc; }
  .water-english-section--navy { background: #d9f3f8; }
  .water-english-section--navy h2, .water-english-section--navy p, .water-english-section--navy .water-english-kicker { color: #071F3A; }
  .water-english-section h2, .water-english-final h2 { margin: 0; color: #071F3A; font-family: var(--font-heading, sans-serif); font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1.05; letter-spacing: -.025em; }
  .water-english-section p { color: #071F3A; font-size: 1rem; line-height: 1.7; }
  .water-english-callout { padding: 25px; border: 1px solid #b9dfe8; border-radius: 18px; background: #fff; box-shadow: 0 16px 34px rgba(7,31,58,.08); }
  .water-english-callout h3 { margin: 0; color: #071F3A; font-family: var(--font-heading, sans-serif); font-size: 1.4rem; }
  .water-english-callout p { margin: 12px 0 20px; font-size: .92rem; }
  .water-english-step-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin-top: 32px; border-block: 1px solid #d5e4eb; }
  .water-english-step-grid article { padding: 25px 20px; border-right: 1px solid #d5e4eb; }
  .water-english-step-grid article:last-child { border-right: 0; }
  .water-english-step-grid span { color: #0b91a6; font-size: .75rem; font-weight: 900; letter-spacing: .1em; }
  .water-english-step-grid h3 { margin: 12px 0 0; color: #071F3A; font-size: 1.2rem; }
  .water-english-step-grid p { margin: 7px 0 0; font-size: .92rem; }
  .water-english-checks { display: grid; gap: 13px; padding: 0; margin: 0; list-style: none; }
  .water-english-checks li { display: flex; gap: 11px; align-items: center; color: #071F3A; font-weight: 800; }
  .water-english-checks i { width: 24px; color: #071F3A; text-align: center; }
  .water-english-process { display: grid; gap: 13px; padding: 0; margin: 0; list-style: none; counter-reset: english-process; }
  .water-english-process li { display: grid; grid-template-columns: minmax(140px, .6fr) 1fr; gap: 15px; padding-bottom: 13px; border-bottom: 1px solid #dbe6ec; counter-increment: english-process; }
  .water-english-process li::before { content: '0' counter(english-process); grid-row: span 2; color: #0b91a6; font-size: .75rem; font-weight: 900; }
  .water-english-process strong { margin-left: -41px; color: #071F3A; }
  .water-english-process span { color: #071F3A; font-size: .9rem; line-height: 1.45; }
  .water-english-faq { max-width: 840px; }
  .water-english-faq details { border-bottom: 1px solid #ccdce5; }
  .water-english-faq summary { padding: 18px 0; color: #071F3A; cursor: pointer; font-weight: 900; list-style-position: outside; }
  .water-english-faq details p { padding: 0 0 17px 22px; margin: 0; font-size: .94rem; }
  .water-english-final { padding: 76px 0; background: #eff9fc; text-align: center; }
  .water-english-final h2 { color: #071F3A; }
  .water-english-final p { max-width: 680px; margin: 17px auto 24px; color: #071F3A; line-height: 1.65; }
  .water-evidence-section { padding: clamp(56px, 7vw, 84px) 0; background: #f8fcfe; border-block: 1px solid #ddecfa; }
  .water-evidence-header { max-width: 760px; margin-bottom: 32px; }
  .water-evidence-desc { color: #071F3A; font-size: 1rem; line-height: 1.6; margin-top: 8px; }
  .water-evidence-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .water-evidence-card { margin: 0; background: #fff; border: 1px solid #c9dfea; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 28px rgba(7,31,58,0.06); display: flex; flex-direction: column; }
  .water-evidence-img-wrap { position: relative; aspect-ratio: 4 / 3; background: #071F3A; overflow: hidden; }
  .water-evidence-img-wrap img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; transition: transform 0.3s ease; }
  .water-evidence-card:hover .water-evidence-img-wrap img { transform: scale(1.03); }
  .water-evidence-badge { position: absolute; top: 12px; left: 12px; z-index: 2; background: rgba(7, 31, 58, 0.88); backdrop-filter: blur(6px); color: #2cbdd3; font-size: 0.68rem; font-weight: 900; letter-spacing: 0.08em; padding: 5px 10px; border-radius: 6px; border: 1px solid rgba(44, 189, 211, 0.4); display: inline-flex; align-items: center; gap: 6px; }
  .water-evidence-caption { padding: 18px 20px; font-size: 0.88rem; color: #071F3A; line-height: 1.55; border-top: 1px solid #e1eff5; background: #ffffff; flex-grow: 1; }
  .water-evidence-caption strong { color: #071F3A; }

  @media (max-width: 760px) {
    .water-evidence-grid { grid-template-columns: 1fr; }
    .water-english-hero__grid, .water-english-two-col { grid-template-columns: 1fr; }
    .water-english-copy { order: 1; }
    .water-english-visual { order: 2; }
    .water-english-step-grid { grid-template-columns: 1fr; }
    .water-english-step-grid article { border-right: 0; border-bottom: 1px solid #d5e4eb; }
    .water-english-step-grid article:last-child { border-bottom: 0; }
  }
  @media (min-width: 761px) and (max-width: 900px) {
    .water-english-hero__grid { grid-template-columns: 1fr; }
    .water-english-copy { order: 1; }
    .water-english-visual { order: 2; width: min(100%, 660px); margin-inline: auto; }
  }
  @media (max-width: 540px) {
    .water-english-shell { width:min(1180px,calc(100% - (var(--page-gutter) * 2))); }
    .water-english-hero { padding-top: 50px; }
    .water-english-copy h1 { font-size: clamp(2.35rem, 12vw, 3.5rem); }
    .water-english-actions, .water-english-actions .water-english-btn { width: 100%; }
    .water-english-note { align-items: flex-start; }
    .water-english-process li { grid-template-columns: 32px 1fr; }
    .water-english-process li::before { grid-row: auto; }
    .water-english-process strong { margin-left: 0; }
  }
</style>
