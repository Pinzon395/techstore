---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FaqSection from '../../components/FaqSection.astro';
const faqs = [
  { question: '¿Cada cuánto necesita mantenimiento mi Mac?', answer: 'En Cancún, por la humedad y el salitre, recomendamos cada 6 a 8 meses. En ambientes climatizados y secos puede estirarse hasta 12 meses.' },
  { question: '¿Reparan MacBooks con falla de placa en Cancún?', answer: 'Sí. Ofrecemos microsoldadura para equipos que Apple ya no atiende. Podemos reparar circuitos dañados por humedad, corrosión o sobrevoltaje.' },
  { question: '¿Cuánto cuesta el mantenimiento de un MacBook?', answer: 'El diagnóstico es gratuito. El costo varía según el modelo y servicio requerido. Contáctanos por WhatsApp para una cotización sin compromiso.' },
  { question: '¿Mi Mac se calienta mucho, es normal?', answer: 'No. El calentamiento excesivo indica que los ductos de ventilación están tapados o la pasta térmica se secó. Nuestro mantenimiento puede bajar la temperatura entre 15°C y 30°C.' },
];
---

<Base
  title="Mantenimiento Avanzado Mac y PC | Pixon"
  description="Mantenimiento interno profesional para Mac en Cancún. Limpieza técnica de precisión, revisión de tarjeta madre y aplicación de pasta térmica premium."
  canonical="https://pixon.com.mx/en/mac-maintenance"
  image="/assets/images/responsive/mantenimiento-macbook-cancun.webp"
  schema={[
    {
        "@context": "https://schema.org",
        "@type": "Service",
        "name": "Mantenimiento y Reparacion de MacBook en Cancun",
        "provider": {
            "@type": "LocalBusiness",
            "name": "Pixon PC",
            "url": "https://pixon.com.mx"
        },
        "areaServed": {
            "@type": "City",
            "name": "Cancun"
        },
        "serviceType": "Mantenimiento y reparacion de Mac",
        "url": "https://pixon.com.mx/mantenimiento-mac",
        "description": "Servicio tecnico especializado en MacBook Air MacBook Pro e iMac en Cancun. Limpieza pasta termica bateria y reparaciones de hardware."
    },
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            {
                "@type": "Question",
                "name": "Reparan MacBook en Cancun?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Si, en Pixon PC realizamos mantenimiento y reparacion de MacBook Air, MacBook Pro e iMac en Cancun con tecnicos especializados."
                }
            },
            {
                "@type": "Question",
                "name": "Cuanto cuesta el mantenimiento de un MacBook?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "El diagnostico es gratuito. El costo varia segun el servicio requerido. Contactanos por WhatsApp para cotizacion sin compromiso."
                }
            }
        ]
    },
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Inicio",
                "item": "https://pixon.com.mx/"
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": "Mantenimiento Mac",
                "item": "https://pixon.com.mx/mantenimiento-mac"
            }
        ]
    }
]}
  lang="en"
>
  <Navbar lang="en" />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Mantenimiento Especializado' }]} />

    <!-- HERO -->
    <header class="mac-hero">
        <div class="hero-grid"></div>
        <div class="container mac-hero-content">
            <div class="mac-badge-glass">
                <i class="fa-solid fa-fire-flame-simple"></i> Alta Ingeniería para Mac
            </div>
            <h1 style="font-size: clamp(2.5rem, 4vw, 4rem);">Cuidado profesional para MacBook y iMac</h1>
            <p>La humedad, el polvo y el uso continuo pueden afectar el rendimiento de tu Mac sin que lo notes de
                inmediato. Nuestro servicio de mantenimiento de Mac en Cancún está pensado para devolverle estabilidad,
                temperatura adecuada y mejor respuesta al equipo mediante una limpieza interna profesional y una
                revisión técnica detallada.</p>
            <div style="display:flex; gap:20px; justify-content:center; align-items:center; flex-wrap:wrap;">
                <button
                    onclick="smartWaRedirect('https://wa.me/529986690777?text=Hola,%20me%20interesa%20agendar%20diagn%C3%B3stico%20para%20mi%20Mac.')"
                    class="btn-glass-primary pulse">
                    <i class="fa-solid fa-calendar-check" style="margin-right: 5px;"></i> Agendar diagnóstico
                </button>
                <button onclick="document.getElementById('detalles-servicio').scrollIntoView({behavior: 'smooth'})"
                    class="btn-glass-primary"
                    style="background: rgba(255,255,255,0.05); color:#fff; border-color:rgba(255,255,255,0.2);">
                    <i class="fa-solid fa-list-check" style="margin-right: 5px;"></i> Ver qué incluye
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <section class="mac-premium-content" id="detalles-servicio">
        <div class="container" style="position:relative; z-index:2;">
            <div style="text-align: center; max-width: 800px; margin: 0 auto 60px;">
                <span
                    style="color: #38bdf8; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;">Sección
                    Principal</span>
                <h2
                    style="font-size: clamp(2rem, 4vw, 3rem); color: #ffffff; margin-top: 15px; margin-bottom: 20px; line-height:1.2; font-weight: 800;">
                    ¿Qué hacemos en el<br>mantenimiento de Mac?</h2>
                <p style="color: #94a3b8; font-size: 1.15rem; line-height: 1.7;">Este servicio está diseñado para
                    usuarios que buscan una atención más profunda que una limpieza básica. Revisamos tu Mac por dentro y
                    por fuera, aplicando un proceso técnico orientado a rendimiento, temperatura, cuidado de componentes
                    y prevención de fallas.</p>
            </div>

            <div class="showcase-grid">
                <!-- Bloques de contenido fuertes -->
                <div style="display: flex; flex-direction: column; gap: 30px;">
                    <div class="feature-super-card">
                        <div class="feature-point">
                            <div class="feature-icon-lg"><i class="fa-solid fa-microscope"></i></div>
                            <div>
                                <h3>1. Diagnóstico técnico</h3>
                                <p>Antes de intervenir tu equipo, evaluamos su estado general para detectar acumulación
                                    de polvo, sobrecalentamiento, ruido en ventiladores, lentitud y posibles fallas de
                                    funcionamiento.</p>
                            </div>
                        </div>

                        <div class="feature-point">
                            <div class="feature-icon-lg"><i class="fa-solid fa-spray-can-sparkles"></i></div>
                            <div>
                                <h3>2. Limpieza interna de precisión</h3>
                                <p>Desarmamos el equipo con cuidado para limpiar las zonas críticas donde se acumula
                                    suciedad y donde se compromete la disipación térmica.</p>
                            </div>
                        </div>

                        <div class="feature-point">
                            <div class="feature-icon-lg"><i class="fa-solid fa-microchip"></i></div>
                            <div>
                                <h3>3. Revisión y limpieza de componentes</h3>
                                <p>Inspeccionamos los componentes internos, ventiladores, disipadores y zonas sensibles
                                    para asegurar un mantenimiento completo y ordenado.</p>
                            </div>
                        </div>

                        <div class="feature-point">
                            <div class="feature-icon-lg"><i class="fa-solid fa-temperature-arrow-down"></i></div>
                            <div>
                                <h3>4. Optimización térmica</h3>
                                <p>Aplicamos pasta térmica de alta calidad para mejorar la transferencia de calor y
                                    ayudar a que tu Mac trabaje con mayor estabilidad.</p>
                            </div>
                        </div>

                        <div class="feature-point">
                            <div class="feature-icon-lg"><i class="fa-solid fa-shield-heart"></i></div>
                            <div>
                                <h3>5. Cuidado preventivo</h3>
                                <p>Un mantenimiento a tiempo ayuda a evitar apagados inesperados, calentamiento excesivo
                                    y desgaste prematuro de componentes.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Incluye -->
                    <div
                        style="background: rgba(14, 165, 233, 0.05); border: 1px solid rgba(14, 165, 233, 0.2); border-radius: 24px; padding: 40px; backdrop-filter: blur(10px);">
                        <h3
                            style="color: #ffffff; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; font-size: 1.4rem;">
                            <i class="fa-solid fa-list-check" style="color: #38bdf8;"></i> Incluye:
                        </h3>
                        <ul
                            style="list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 15px;">
                            <li style="display: flex; align-items: start; gap: 10px; color: #cbd5e1;">
                                <i class="fa-solid fa-check" style="color: #38bdf8; margin-top: 4px;"></i> Limpieza
                                interna completa
                            </li>
                            <li style="display: flex; align-items: start; gap: 10px; color: #cbd5e1;">
                                <i class="fa-solid fa-check" style="color: #38bdf8; margin-top: 4px;"></i> Revisión de
                                componentes
                            </li>
                            <li style="display: flex; align-items: start; gap: 10px; color: #cbd5e1;">
                                <i class="fa-solid fa-check" style="color: #38bdf8; margin-top: 4px;"></i> Cambio de
                                pasta térmica de alto desempeño
                            </li>
                            <li style="display: flex; align-items: start; gap: 10px; color: #cbd5e1;">
                                <i class="fa-solid fa-check" style="color: #38bdf8; margin-top: 4px;"></i> Limpieza de
                                ventilación y disipación
                            </li>
                            <li style="display: flex; align-items: start; gap: 10px; color: #cbd5e1;">
                                <i class="fa-solid fa-check" style="color: #38bdf8; margin-top: 4px;"></i> Optimización
                                del flujo de aire
                            </li>
                            <li style="display: flex; align-items: start; gap: 10px; color: #cbd5e1;">
                                <i class="fa-solid fa-check" style="color: #38bdf8; margin-top: 4px;"></i> Control de
                                temperatura
                            </li>
                            <li style="display: flex; align-items: start; gap: 10px; color: #cbd5e1;">
                                <i class="fa-solid fa-check" style="color: #38bdf8; margin-top: 4px;"></i> Diagnóstico
                                preventivo
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Right Column: Photos and Porque elegirnos -->
                <div style="display: flex; flex-direction: column; gap: 40px;">

                    <div
                        style="background: rgba(14, 165, 233, 0.03); border: 1px solid rgba(14, 165, 233, 0.1); border-radius: 24px; padding: 30px; margin-bottom: 40px;">
                        <h3 style="color: #ffffff; font-size: 1.4rem; margin-bottom: 15px;">Servicio técnico
                            especializado para MacBook e iMac</h3>
                        <p style="color: #94a3b8; line-height: 1.7; margin: 0;">Realizamos mantenimiento de Mac con
                            enfoque profesional, ideal para equipos que presentan calentamiento, lentitud, ruido en
                            ventiladores o pérdida de rendimiento. Nuestro proceso está pensado para cuidar tu equipo
                            Apple con precisión, limpieza y materiales de calidad.</p>
                    </div>

                    <!-- FOTOS ESTÉTICAS ASIMÉTRICAS -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: start;">
                        <img src="/assets/images/responsive/mantenimiento-macbook-cancun.webp" alt="Procesador Mac Mantenimiento" loading="lazy"
                            decoding="async"
                            style="width: 100%; border-radius: 20px; object-fit: cover; aspect-ratio: 4/5; box-shadow: 0 20px 40px rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.05);">
                        <img src="/assets/images/responsive/reparacion-mac-cancun.webp" alt="Desensamble Mac Cancún" loading="lazy" decoding="async"
                            style="width: 100%; border-radius: 20px; object-fit: cover; aspect-ratio: 4/5; transform: translateY(40px); box-shadow: 0 20px 40px rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.05);">
                    </div>

                    <!-- POR QUE ELEGIRNOS (Darker Card) -->
                    <div
                        style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.05); color: white; border-radius: 24px; padding: 40px; margin-top: 20px; box-shadow: inset 0 0 40px rgba(0,0,0,0.5);">
                        <h3 style="margin-bottom: 15px; font-size: 1.5rem; color: #ffffff;">¿Por qué elegir este
                            servicio?</h3>
                        <p style="color: #94a3b8; line-height: 1.6; margin-bottom: 25px;">Porque no se trata solo de
                            limpiar un equipo, sino de cuidarlo con criterio técnico. Cada Mac necesita atención
                            precisa, buen manejo y una intervención pensada para mantener rendimiento, estética y
                            durabilidad.</p>

                        <h4
                            style="color: #0ea5e9; margin-bottom: 20px; font-size: 1.1rem; text-transform: uppercase; letter-spacing: 1px;">
                            Beneficios:</h4>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                            <div
                                style="display: flex; align-items: center; gap: 10px; font-size: 0.95rem; color:#cbd5e1;">
                                <div
                                    style="background: rgba(14,165,233,0.1); width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center;">
                                    <i class="fa-solid fa-arrow-trend-up"
                                        style="color: #38bdf8; font-size: 0.8rem;"></i></div> Mejor rendimiento
                            </div>
                            <div
                                style="display: flex; align-items: center; gap: 10px; font-size: 0.95rem; color:#cbd5e1;">
                                <div
                                    style="background: rgba(14,165,233,0.1); width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center;">
                                    <i class="fa-solid fa-temperature-arrow-down"
                                        style="color: #38bdf8; font-size: 0.8rem;"></i></div> Menor temperatura
                            </div>
                            <div
                                style="display: flex; align-items: center; gap: 10px; font-size: 0.95rem; color:#cbd5e1;">
                                <div
                                    style="background: rgba(14,165,233,0.1); width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center;">
                                    <i class="fa-solid fa-volume-low" style="color: #38bdf8; font-size: 0.8rem;"></i>
                                </div> Menos ruido
                            </div>
                            <div
                                style="display: flex; align-items: center; gap: 10px; font-size: 0.95rem; color:#cbd5e1;">
                                <div
                                    style="background: rgba(14,165,233,0.1); width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center;">
                                    <i class="fa-solid fa-shield-heart" style="color: #38bdf8; font-size: 0.8rem;"></i>
                                </div> Mayor vida útil
                            </div>
                            <div
                                style="display: flex; align-items: center; gap: 10px; font-size: 0.95rem; color:#cbd5e1;">
                                <div
                                    style="background: rgba(14,165,233,0.1); width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center;">
                                    <i class="fa-solid fa-face-smile" style="color: #38bdf8; font-size: 0.8rem;"></i>
                                </div> Mejor experiencia
                            </div>
                            <div
                                style="display: flex; align-items: center; gap: 10px; font-size: 0.95rem; color:#cbd5e1;">
                                <div
                                    style="background: rgba(14,165,233,0.1); width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center;">
                                    <i class="fa-solid fa-user-tie" style="color: #38bdf8; font-size: 0.8rem;"></i>
                                </div> Imagen profesional
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CALL TO ACTION BAND -->
    <div class="cta-dark-band">
        <div class="container">
            <h2>No esperes a que tu equipo se apague solo.</h2>
            <p style="color: #94a3b8; font-size: 1.1rem; max-width: 600px; margin: 0 auto 30px;">Un mantenimiento
                proactivo previene cortos circuitos, salva soldaduras de estrés térmico y ahorra miles de pesos en
                reparaciones costosas.</p>
            <button
                onclick="smartWaRedirect('https://wa.me/529986690777?text=Deseo%20cotizar%20el%20mantenimiento%20efecto%20espejo')"
                class="btn btn-primary btn-large">
                <i class="fa-brands fa-whatsapp"></i> Cotizar Mantenimiento Premium
            </button>
        </div>
    </div>

    <!-- -" PREGUNTAS FRECUENTES MAC -" -->
    
    <FaqSection
      title="Preguntas frecuentes sobre mantenimiento Mac"
      description="Dudas comunes sobre el cuidado de tu MacBook o iMac en Cancún."
      items={faqs}
      faqAccent="#38bdf8"
      backgroundColor="#0B1120"
      titleColor="#f1f5f9"
      descriptionColor="#94a3b8"
      viewMoreHref="/preguntas-frecuentes"
      viewMoreLabel="Ver todas las preguntas"
    />


    <!-- -" COMENTARIOS -" -->
    <section class="comments-section-container section-padding dark-bg" id="comentarios-mac">
        <div class="container comments-section">
            <div class="section-title text-center">
                <h2>¿Qué opinan nuestros clientes?</h2>
                <p>Déjanos un comentario y calificación sobre nuestro servicio.</p>
            </div>
            <div class="comment-form-container">
                <p style="font-size:1.1rem; font-weight:700; margin-bottom:15px;">Deja tu Comentario</p>
                <div class="stars-input" id="star-rating">
                    <i class="fa-solid fa-star" data-val="1"></i><i class="fa-solid fa-star" data-val="2"></i><i
                        class="fa-solid fa-star" data-val="3"></i><i class="fa-solid fa-star" data-val="4"></i><i
                        class="fa-solid fa-star" data-val="5"></i>
                </div>
                <form id="addCommentForm">
                    <div class="form-group"><input type="text" id="commenterName" placeholder="Tu Nombre" required
                            autocomplete="name"></div>
                    <div class="form-group mt-3"><textarea id="commenterText" rows="3"
                            placeholder="Muy buen servicio, mi Mac quedó como nueva..." required></textarea></div>
                    <button type="submit" class="btn btn-primary mt-3" id="submitCommentBtn"><i
                            class="fa-solid fa-paper-plane"></i> Publicar Comentario</button>
                </form>
            </div>
            <div class="comments-marquee-container" id="commentsCarousel">
                <div class="comment-list" id="commentsBox"></div>
            </div>
            <div class="text-center mt-4"><button id="loadMoreComments" class="btn btn-outline"
                    style="display:none;">Ver más comentarios</button></div>
        </div>
    </section>

    <!-- -" UBICACIÓN (cargada desde componente compartido) -" -->

    <style>
        @media (max-width: 768px) {
            .ubicacion-grid-mac {
                grid-template-columns: 1fr !important;
            }
        }
    </style>

    <!-- FOOTER -->
  <Footer />


    <!-- -" Cookie Banner -" -->
</Base>

<script>

  let selectedRating = 0;
  document.querySelectorAll('#star-rating .fa-star').forEach((star: Element) => {
    star.addEventListener('click', () => {
      selectedRating = parseInt((star as HTMLElement).dataset.val || '0');
      document.querySelectorAll('#star-rating .fa-star').forEach((s: Element, i: number) => {
        s.classList.toggle('active', i < selectedRating);
      });
    });
  });
  document.getElementById('addCommentForm')?.addEventListener('submit', async (e: Event) => {
    e.preventDefault();
    const name = (document.getElementById('commenterName') as HTMLInputElement)?.value;
    const text = (document.getElementById('commenterText') as HTMLTextAreaElement)?.value;
    if (!name || !text || selectedRating === 0) return;
    try {
      const res = await fetch('/api/comments', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'include', body: JSON.stringify({ name, text, rating: selectedRating }) });
      if (res.ok) { alert('¡Comentario enviado! Será revisado antes de publicarse.'); (e.target as HTMLFormElement).reset(); selectedRating = 0; document.querySelectorAll('#star-rating .fa-star').forEach(s => s.classList.remove('active')); }
    } catch (err) { console.error(err); }
  });

</script>
