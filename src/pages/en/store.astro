---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CartDrawer from '../../components/store/CartDrawer.astro';
import storeCss from '../../styles/store.css?url';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': 'https://pixon.com.mx/en/store#webpage',
    name: 'Technology Store and Repair Services in Cancun | Pixon PC',
    description: 'Catalog of devices, hardware, repair services and packages by Pixon PC in Cancun with written English support.',
    url: 'https://pixon.com.mx/en/store',
    isPartOf: { '@id': 'https://pixon.com.mx/#website' },
    about: { '@id': 'https://pixon.com.mx/#business' },
    mainEntity: {
      '@type': 'OfferCatalog',
      name: 'Pixon PC Catalog',
      itemListOrder: 'https://schema.org/ItemListOrderDescending',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pixon.com.mx/en' },
      { '@type': 'ListItem', position: 2, name: 'Store', item: 'https://pixon.com.mx/en/store' },
    ],
  },
];
---

<Base
  title="Computer, Hardware and Service Store in Cancun | Pixon PC"
  description="Explore devices, hardware, repair services and packages published by Pixon PC in Cancun with written English support. Check availability, condition and pricing."
  canonical="https://pixon.com.mx/en/store"
  image="/assets/images/tienda-hero-pixon.webp"
  ogTitle="Pixon PC Store | Devices, Hardware & Services in Cancun"
  ogDescription="Real tech and technical service listings in Cancun, with visible price, condition and availability."
  schema={schema}
  extraStyles={[storeCss]}
  preloadSprite={true}
  lang="en"
>
  <Navbar />

  <main class="store-page store-marketplace" aria-labelledby="catalog-title">
    <section class="store-catalog" id="catalogo-tienda" aria-labelledby="catalog-title">
      <div class="store-shell">
        <header class="store-catalog-header-bar">
          <div class="store-catalog-heading">
            <h1 id="catalog-title" tabindex="-1">Pixon PC Store in Cancun</h1>
            <p>Computers, parts and repair services in Cancun with verified price, condition and stock. Support in English by WhatsApp.</p>
          </div>
          <div class="store-search-bar">
            <div class="store-search-field">
              <label for="store-search" class="sr-only">Search the store</label>
              <div class="store-input-wrap">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <input id="store-search" name="q" type="search" autocomplete="off" maxlength="120" placeholder="Search laptops, parts, SSD, services..." aria-autocomplete="list" aria-controls="store-suggestions" aria-expanded="false" />
                <div class="store-suggestions" id="store-suggestions" role="listbox" hidden></div>
              </div>
            </div>
            <button class="store-filter-toggle" id="store-filter-toggle" type="button" aria-expanded="false" aria-controls="store-filters">
              <i class="fa-solid fa-sliders" aria-hidden="true"></i>
              <span>Filters</span>
            </button>
          </div>
        </header>

        <div class="store-catalog-layout">
          <aside class="store-catalog-sidebar" aria-label="Catalog filters">
            <form class="store-filters" id="store-filters" aria-label="Filter listings" novalidate>
              <div class="store-filters-top">
                <span class="store-filters-heading"><i class="fa-solid fa-sliders" aria-hidden="true"></i> Filters</span>
                <button class="store-clear-filters" id="store-clear-filters" type="button">
                  <i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Clear
                </button>
              </div>

              <fieldset class="store-check-group">
                <legend><i class="fa-solid fa-shapes" aria-hidden="true"></i> Type</legend>
                <label class="store-check-option"><input type="checkbox" data-filter-group="type" value="PRODUCT" /><span>Products</span></label>
                <label class="store-check-option"><input type="checkbox" data-filter-group="type" value="EQUIPMENT" /><span>Complete systems</span></label>
                <label class="store-check-option"><input type="checkbox" data-filter-group="type" value="HARDWARE" /><span>Hardware / Parts</span></label>
                <label class="store-check-option"><input type="checkbox" data-filter-group="type" value="SERVICE" /><span>Repair services</span></label>
                <label class="store-check-option"><input type="checkbox" data-filter-group="type" value="BUNDLE" /><span>Bundles</span></label>
                <select id="store-type" name="type" class="store-filter-source" tabindex="-1" aria-hidden="true">
                  <option value="">All</option>
                  <option value="EQUIPMENT">Equipment</option>
                  <option value="HARDWARE">Hardware</option>
                  <option value="PRODUCT">Products</option>
                  <option value="SERVICE">Services</option>
                  <option value="BUNDLE">Bundles</option>
                </select>
              </fieldset>

              <fieldset class="store-check-group">
                <legend><i class="fa-solid fa-certificate" aria-hidden="true"></i> Condition</legend>
                <label class="store-check-option"><input type="checkbox" data-filter-group="condition" value="NEW" /><span>New</span></label>
                <label class="store-check-option"><input type="checkbox" data-filter-group="condition" value="USED" /><span>Used, with warranty</span></label>
                <label class="store-check-option"><input type="checkbox" data-filter-group="condition" value="REFURBISHED" /><span>Refurbished</span></label>
                <label class="store-check-option"><input type="checkbox" data-filter-group="condition" value="OPEN_BOX" /><span>Open box</span></label>
                <label class="store-check-option"><input type="checkbox" data-filter-group="condition" value="FOR_PARTS" /><span>For parts</span></label>
                <select id="store-condition" name="condition" class="store-filter-source" tabindex="-1" aria-hidden="true">
                  <option value="">Any</option>
                  <option value="NEW">New</option>
                  <option value="USED">Used</option>
                  <option value="REFURBISHED">Refurbished</option>
                  <option value="OPEN_BOX">Open box</option>
                  <option value="FOR_PARTS">For parts</option>
                  <option value="NOT_APPLICABLE">N/A</option>
                </select>
              </fieldset>

              <fieldset class="store-check-group">
                <legend><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Availability</legend>
                <label class="store-check-option"><input type="checkbox" data-filter-group="availability" value="AVAILABLE" /><span>In stock in Cancun</span></label>
                <label class="store-check-option"><input type="checkbox" data-filter-group="availability" value="UNAVAILABLE" /><span>Sold out / On order</span></label>
                <select id="store-availability" name="availability" class="store-filter-source" tabindex="-1" aria-hidden="true">
                  <option value="">All</option>
                  <option value="AVAILABLE">Available</option>
                  <option value="UNAVAILABLE">Unavailable</option>
                </select>
              </fieldset>

              <label class="store-filter-field">
                <span><i class="fa-solid fa-tag" aria-hidden="true"></i> Brand</span>
                <input id="store-brand" name="brand" type="text" maxlength="100" placeholder="e.g. Lenovo, Asus, Kingston..." />
              </label>

              <div class="store-price-fields">
                <label class="store-filter-field">
                  <span>Min price</span>
                  <input id="store-min-price" name="minPrice" type="number" min="0" step="0.01" inputmode="decimal" placeholder="$ Min" />
                </label>
                <label class="store-filter-field">
                  <span>Max price</span>
                  <input id="store-max-price" name="maxPrice" type="number" min="0" step="0.01" inputmode="decimal" placeholder="$ Max" />
                </label>
              </div>

              <label class="store-filter-field">
                <span><i class="fa-solid fa-arrow-down-wide-short" aria-hidden="true"></i> Sort by</span>
                <select id="store-sort" name="sort">
                  <option value="newest">Newest first</option>
                  <option value="price_asc">Price: low to high</option>
                  <option value="price_desc">Price: high to low</option>
                  <option value="name">Name A–Z</option>
                </select>
              </label>
            </form>
          </aside>

          <div class="store-results-column">
            <div class="store-category-row" id="store-category-row" aria-label="Catalog categories">
              <button type="button" class="store-category-chip is-active" data-category="" aria-pressed="true">All categories</button>
            </div>

            <aside class="store-promotion-banner" id="store-promotion-banner" hidden>
              <div><span>Current promotion</span><strong id="store-promotion-title"></strong><p id="store-promotion-text"></p></div>
              <a href="/tienda/promociones" hreflang="es">View promotions (Spanish)</a>
            </aside>

            <div class="store-results-bar">
              <p id="store-result-summary" aria-live="polite">Preparing catalog…</p>
              <p class="store-live-note"><span aria-hidden="true"></span> Live data from the Pixon PC catalog</p>
            </div>

            <div class="store-state" id="store-loading" role="status" hidden>
              <span class="store-spinner" aria-hidden="true"></span>
              <p>Loading listings…</p>
            </div>

            <div class="store-state store-state-error" id="store-error" role="alert" hidden>
              <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
              <h3>Could not load the catalog</h3>
              <p>The catalog is not available right now. Try again or message us to confirm stock.</p>
              <button type="button" id="store-retry">Try again</button>
            </div>

            <div class="store-state" id="store-empty" hidden>
              <i class="fa-solid fa-box-open" aria-hidden="true"></i>
              <h3>No listings match these filters</h3>
              <p>Try another search or tell us which device, part or service you need.</p>
              <div class="store-empty-actions">
                <button type="button" id="store-empty-clear">View full catalog</button>
                <a href="https://wa.me/529986690777?text=Hello%20Pixon%20PC%2C%20I%20did%20not%20find%20what%20I%20need%20in%20the%20store." target="_blank" rel="noopener noreferrer">Ask on WhatsApp</a>
              </div>
            </div>

            <div class="store-product-grid" id="store-product-grid" aria-live="polite"></div>

            <noscript>
              <div class="store-state">
                <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                <h3>Enable JavaScript to view the live catalog</h3>
                <p>You can also confirm listings and stock directly with Pixon PC.</p>
                <div class="store-empty-actions">
                  <a href="https://wa.me/529986690777?text=Hello%20Pixon%20PC%2C%20I%20would%20like%20to%20check%20the%20store%20catalog." target="_blank" rel="noopener noreferrer">Ask on WhatsApp</a>
                  <a href="/en/contact">Contact us</a>
                </div>
              </div>
            </noscript>

            <nav class="store-pagination" id="store-pagination" aria-label="Catalog pagination" hidden>
              <button type="button" id="store-prev-page"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Previous</button>
              <span id="store-page-label">Page 1</span>
              <button type="button" id="store-next-page">Next <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
            </nav>
          </div>
        </div>
      </div>
    </section>
  </main>

  <dialog class="store-detail-dialog" id="store-detail-dialog" aria-labelledby="store-dialog-title">
    <div class="store-dialog-shell">
      <button class="store-dialog-close" id="store-dialog-close" type="button" aria-label="Close details"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
      <h2 class="store-dialog-status-title" id="store-dialog-title">Listing details</h2>
      <div id="store-dialog-content">
        <div class="store-state" role="status"><span class="store-spinner" aria-hidden="true"></span><p>Loading details…</p></div>
      </div>
    </div>
  </dialog>

  <CartDrawer showLauncher={true} />
  <Footer />
  <script src="/scripts/store-cart.js?v=20260912-2" is:inline defer></script>
  <script src="/scripts/store.js?v=20261022-1" is:inline defer></script>
</Base>
