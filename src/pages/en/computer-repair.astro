---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const canonical = 'https://pixon.com.mx/en/computer-repair';
const description = 'Computer and PC repair in Cancun with written English support. Diagnosis for no power, slow performance, overheating, Windows and hardware issues before any repair.';
const whatsappUrl = `https://wa.me/529986690777?text=${encodeURIComponent('Hi Pixon PC. I need computer repair in Cancun. Device/model: ____. Problem: ____. Hotel or area: ____.')}`;
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', '@id': `${canonical}#service`, name: 'Computer and PC Repair in Cancun', serviceType: 'Computer repair', description, url: canonical, provider: { '@id': 'https://pixon.com.mx/#business' }, areaServed: { '@type': 'City', name: 'Cancun' } },
];
---

<Base title="Computer Repair in Cancun | English Support | Pixon PC" {description} canonical={canonical} lang="en" schema={schema} bodyClass="english-service-page">
  <Navbar lang="en" />
  <Breadcrumb items={[{ label: 'Home', href: '/en' }, { label: 'Computer repair' }]} />
  <main>
    <header class="english-service-hero"><div class="english-service-shell"><p class="eyebrow">Computer repair · Cancun</p><h1>Computer Repair in Cancun</h1><p>PC not turning on, running slowly, overheating or showing Windows errors? We start with the symptom, test the likely causes and explain the repair path in written English.</p><div class="actions"><a class="btn primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Message us on WhatsApp</a><a class="btn secondary" href="/en#communication-title">How English support works</a></div><p class="note">Service by appointment · quote and updates available in written English</p></div></header>
    <section class="english-service-section"><div class="english-service-shell grid"><div><p class="eyebrow dark">What we can assess</p><h2>Diagnosis before replacing parts</h2><p>We can assess desktop PCs, gaming computers, office equipment and custom builds. The exact route depends on the model, symptom and test results.</p></div><div class="cards"><article><h3>No power or no display</h3><p>Power supply, motherboard, RAM, GPU, cables and startup signals.</p></article><article><h3>Slow, unstable or overheating</h3><p>Windows, storage, memory, drivers, airflow and temperature behavior.</p></article><article><h3>Upgrade or component question</h3><p>Compatibility, space, power, cooling and whether the upgrade makes sense.</p></article></div></div></section>
    <section class="english-service-section soft"><div class="english-service-shell grid"><div><h2>A clear next step for visitors and residents</h2><p>Send the computer model, the symptoms and your Cancun area. We confirm the available service or workshop route before you arrange delivery or pickup.</p></div><div class="process"><h3>What to include in your message</h3><ol><li>Computer type and exact model</li><li>What happens when you press the power button</li><li>When the problem started and any recent change</li><li>Hotel, condo, office or Cancun area</li></ol></div></div></section>
    <section class="english-service-final"><div class="english-service-shell"><h2>Need a computer checked in Cancun?</h2><p>Message Pixon PC with the symptom. We will explain what information is needed before quoting work.</p><a class="btn primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Start with the symptoms</a></div></section>
  </main>
  <Footer lang="en" />
</Base>

<style>
  .english-service-page{color:#071F3A}.english-service-shell{width:min(calc(100% - 32px),1180px);margin-inline:auto}.english-service-hero{padding:72px 0 58px;background:linear-gradient(135deg,#071F3A,#0b4162);color:#fff}.english-service-hero h1{max-width:780px;margin:0 0 16px;font-family:Kanit,sans-serif;font-size:clamp(2.3rem,6vw,4.4rem);line-height:1.05;color:#fff}.english-service-hero p:not(.eyebrow):not(.note){max-width:720px;font-size:1.08rem;line-height:1.7;color:#e8f7fb}.eyebrow{margin:0 0 12px;font-size:.76rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:#9de8f7}.eyebrow.dark{color:#1479D4}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}.btn{display:inline-flex;min-height:48px;align-items:center;justify-content:center;padding:12px 18px;border-radius:12px;font-weight:850;text-decoration:none}.btn.primary{background:#168b50;color:#fff}.btn.secondary{border:1px solid rgba(255,255,255,.45);color:#fff}.note{margin-top:18px;font-size:.86rem;color:#cbeaf1}.english-service-section{padding:clamp(52px,8vw,88px) 0}.english-service-section.soft{background:#eff9fc}.english-service-section h2,.english-service-final h2{margin:0 0 14px;color:#071F3A;font-family:Kanit,sans-serif;font-size:clamp(1.8rem,4vw,2.8rem);line-height:1.15}.english-service-section p,.english-service-section li,.english-service-final p{color:#071F3A;line-height:1.7}.grid{display:grid;gap:28px}.cards{display:grid;gap:14px}.cards article,.process{padding:22px;border:1px solid #b9dfe9;border-radius:16px;background:#fff}.cards h3,.process h3{margin:0 0 8px;color:#071F3A}.cards p{margin:0}.process ol{display:grid;gap:12px;padding-left:22px;margin:0}.english-service-final{padding:64px 0;background:#d9f3f8;text-align:center}.english-service-final p{max-width:620px;margin:0 auto 22px}.english-service-final .btn{width:min(100%,300px)}@media(min-width:760px){.grid{grid-template-columns:minmax(0,1fr) minmax(0,1.2fr)}.cards{grid-template-columns:repeat(3,1fr)}}
</style>
