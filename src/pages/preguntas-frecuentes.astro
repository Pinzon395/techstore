---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { buildBreadcrumbSchema, buildFAQSchema } from '../lib/schema';

const faqCategories = [
  {
    title: 'Servicio, diagnóstico y tiempos',
    icon: 'fa-screwdriver-wrench',
    items: [
      {
        question: '¿El diagnóstico tiene costo?',
        answer: 'El diagnóstico inicial es gratis y sin compromiso. Revisamos el equipo, confirmamos la falla real y te damos un costo antes de reparar. No cambiamos piezas ni hacemos procesos delicados sin tu autorización.',
      },
      {
        question: '¿Cuánto tarda una reparación?',
        answer: 'Depende de la falla y de si requiere refacción. Un mantenimiento puede quedar el mismo día; una reparación con placa, pantalla, teclado, batería o pruebas de estabilidad suele tomar de 24 a 72 horas. Siempre te damos tiempo estimado antes de iniciar.',
      },
      {
        question: '¿Me avisan antes de cambiar piezas?',
        answer: 'Sí. Primero enviamos diagnóstico, costo, tiempo estimado y condiciones de garantía. Si encontramos una falla adicional durante la revisión, te avisamos por WhatsApp antes de continuar.',
      },
      {
        question: '¿Puedo llevar mi propio repuesto?',
        answer: 'Sí, podemos instalarlo si es compatible con el modelo exacto del equipo. En ese caso la garantía aplica sobre la mano de obra, pero no sobre la pieza que trae el cliente.',
      },
    ],
  },
  {
    title: 'Laptops y computadoras',
    icon: 'fa-laptop',
    items: [
      {
        question: '¿Reparan laptops que no encienden?',
        answer: 'Sí. Revisamos cargador, centro de carga, batería, placa, RAM, SSD, BIOS y líneas principales de energía. La idea es diagnosticar antes de cambiar piezas para evitar gastos innecesarios.',
      },
      {
        question: '¿Cambian pantallas, teclados y baterías?',
        answer: 'Sí. Trabajamos pantallas, teclados, baterías, bisagras, carcasas, centros de carga, ventiladores, SSD y RAM según el modelo. Antes de cotizar confirmamos compatibilidad y disponibilidad de la refacción.',
      },
      {
        question: '¿Mi información se borra durante la reparación?',
        answer: 'No tocamos archivos personales en diagnósticos, limpiezas o cambios de piezas. Si el servicio requiere respaldo, clonado, recuperación de datos o formateo, pedimos autorización antes de hacerlo.',
      },
      {
        question: '¿Qué hago si mi laptop se calienta mucho?',
        answer: 'Conviene revisarla pronto. En Cancún el calor, polvo, humedad y salitre saturan ventiladores y pasta térmica más rápido que en climas secos. Una limpieza preventiva puede evitar apagados, lentitud y daño de placa.',
      },
    ],
  },
  {
    title: 'PC gamer, ensambles y upgrades',
    icon: 'fa-desktop',
    items: [
      {
        question: '¿Arman PC gamer si yo compro las piezas?',
        answer: 'Sí. Podemos ensamblar, ordenar cableado, actualizar BIOS, instalar Windows, configurar drivers y hacer pruebas de temperatura. También revisamos compatibilidad de fuente, gabinete, tarjeta madre, RAM y GPU antes del armado.',
      },
      {
        question: '¿Qué incluye el mantenimiento Pro Gamer?',
        answer: 'Incluye limpieza profunda, revisión térmica, pasta de alto rendimiento, mantenimiento de GPU compatible y pruebas bajo carga. Es recomendado para equipos que juegan muchas horas, hacen streaming o trabajan con render y edición.',
      },
      {
        question: '¿Instalan SSD, RAM o tarjeta gráfica?',
        answer: 'Sí. Verificamos compatibilidad de placa, fuente, gabinete, BIOS y temperatura antes de instalar. Si vas a migrar de disco duro a SSD, también podemos clonar el sistema para conservar archivos y programas cuando sea viable.',
      },
      {
        question: '¿Hacen optimización para más FPS?',
        answer: 'Sí. Optimizamos Windows, drivers, inicio, energía, latencia y configuración de juegos cuando el hardware lo permite. No prometemos FPS irreales: primero revisamos temperaturas, cuello de botella y estado del sistema.',
      },
    ],
  },
  {
    title: 'Humedad, líquido y antisulfatación',
    icon: 'fa-droplet-slash',
    items: [
      {
        question: '¿Qué es la sulfatación?',
        answer: 'Es corrosión en pistas, conectores y componentes por humedad, salitre, líquido o residuos. En Cancún es común por el clima costero, sobre todo en equipos cerca de ventanas, playa, aire acondicionado o zonas húmedas.',
      },
      {
        question: '¿Qué hago si se mojó mi equipo?',
        answer: 'Apágalo, no lo cargues, no uses secadora y no intentes encenderlo para probar. Lo correcto es abrirlo, desconectar energía interna, limpiar residuos y revisar corrosión antes de aplicar corriente.',
      },
      {
        question: '¿La antisulfatación garantiza que quedará como nuevo?',
        answer: 'No se promete eso cuando hay corrosión. Primero buscamos detener el avance, recuperar funcionamiento, rescatar datos si aplica y explicarte el riesgo real. Si la placa está muy dañada, te lo decimos antes de invertir más.',
      },
      {
        question: '¿Cada cuánto conviene dar mantenimiento en Cancún?',
        answer: 'Para equipos de uso diario recomendamos revisión cada 6 a 8 meses. Si el equipo está cerca de playa, humedad, polvo, mascotas o trabaja muchas horas, puede necesitar mantenimiento antes.',
      },
    ],
  },
  {
    title: 'Celulares, tablets y consolas',
    icon: 'fa-gamepad',
    items: [
      {
        question: '¿Reparan celulares e iPhone?',
        answer: 'Sí. Revisamos pantalla, batería, cámara, centro de carga, micrófono, bocina, software y daño por líquido. Antes de cambiar piezas confirmamos si la falla viene de refacción, flex, humedad, placa o configuración.',
      },
      {
        question: '¿Reparan PS5, Xbox y Nintendo Switch?',
        answer: 'Sí. Atendemos sobrecalentamiento, HDMI, limpieza profunda, pasta térmica, ruido, apagados y controles con drift. Cada consola se revisa por modelo porque PS5, Xbox y Switch tienen procesos térmicos diferentes.',
      },
      {
        question: '¿Qué es joystick drift?',
        answer: 'Es cuando el control detecta movimiento aunque no estés tocando la palanca. Revisamos suciedad, desgaste del módulo analógico, flex y placa del control para decidir si conviene limpieza, ajuste o reemplazo.',
      },
      {
        question: '¿También ven tablets o iPad?',
        answer: 'Sí. Podemos revisar pantalla, batería, puerto de carga, software y daño por líquido en tablets compatibles. Te pedimos modelo exacto para confirmar disponibilidad de piezas y riesgo de apertura.',
      },
    ],
  },
  {
    title: 'Windows, software y datos',
    icon: 'fa-window-restore',
    items: [
      {
        question: '¿Instalan Windows con drivers?',
        answer: 'Sí. Instalamos Windows 10 u 11, drivers, actualizaciones y programas básicos. Si hay datos importantes, primero cotizamos respaldo o clonado para evitar pérdida de información.',
      },
      {
        question: '¿Quitan virus y programas basura?',
        answer: 'Sí. Revisamos malware, programas de inicio, extensiones sospechosas, archivos temporales y configuraciones que afectan rendimiento. También te indicamos qué hábitos o programas estaban causando el problema.',
      },
      {
        question: '¿Recuperan archivos borrados o discos dañados?',
        answer: 'Sí, primero evaluamos el tipo de daño. La recuperación depende de si la falla es lógica, física o por corrupción avanzada. Si el disco hace ruidos, no conviene seguirlo usando porque puede empeorar.',
      },
      {
        question: '¿Pueden hacer soporte remoto?',
        answer: 'Sí, para problemas de software, configuración, lentitud, programas, correo y algunas revisiones de Windows. Si el caso requiere abrir el equipo o revisar hardware, te indicamos llevarlo o coordinar recolección.',
      },
    ],
  },
  {
    title: 'Empresas, pagos y factura',
    icon: 'fa-building-shield',
    items: [
      {
        question: '¿Atienden empresas en Cancún?',
        answer: 'Sí. Atendemos oficinas, hoteles, restaurantes, escuelas y negocios con soporte por lote o póliza mensual. Podemos documentar equipos, fallas, evidencias, recomendaciones y prioridades por área.',
      },
      {
        question: '¿Facturan?',
        answer: 'Sí. Emitimos CFDI para personas físicas y morales. Solicítalo al cotizar para registrar los datos correctos y evitar retrasos al cerrar el servicio.',
      },
      {
        question: '¿Aceptan tarjeta o transferencia?',
        answer: 'Sí. Aceptamos efectivo, transferencia y tarjeta según el servicio. Para empresas podemos cotizar condiciones específicas cuando hay varios equipos o mantenimiento recurrente.',
      },
      {
        question: '¿Dan reportes por equipo?',
        answer: 'Sí. En servicios B2B podemos documentar folio, evidencia, estado inicial, trabajos realizados, piezas instaladas y recomendaciones preventivas para cada equipo.',
      },
    ],
  },
  {
    title: 'Ubicación, domicilio y garantía',
    icon: 'fa-location-dot',
    items: [
      {
        question: '¿Dónde están ubicados?',
        answer: 'Estamos en Haciendas, Cancún, Quintana Roo 77539. Trabajamos con cita para recibir tu equipo con orden, folio y seguimiento por WhatsApp.',
      },
      {
        question: '¿Tienen recolección y entrega?',
        answer: 'Sí. Podemos coordinar recolección y entrega en Cancún según zona, horario y tipo de equipo. Para reparaciones delicadas te orientamos antes de moverlo para evitar más daño.',
      },
      {
        question: '¿Qué cubre la garantía?',
        answer: 'Cubre mano de obra y piezas instaladas según el servicio realizado. No cubre golpes, líquido posterior, variaciones eléctricas, manipulación externa o fallas en componentes no intervenidos.',
      },
      {
        question: '¿Cómo activo mi garantía?',
        answer: 'Contáctanos por WhatsApp con tu folio, ticket o datos del servicio. Revisamos el caso, validamos la intervención anterior y te indicamos el siguiente paso.',
      },
    ],
  },
  {
    title: 'English support',
    icon: 'fa-globe',
    items: [
      {
        question: 'Do you speak English?',
        answer: 'Yes. We can assist tourists, digital nomads and expats in English by WhatsApp. We can explain the diagnosis, cost and repair timing before starting the service.',
      },
      {
        question: 'Do you offer hotel pickup?',
        answer: 'Yes. We can coordinate pickup and delivery in the Hotel Zone depending on schedule, location and device type. Send your hotel area and device model by WhatsApp.',
      },
      {
        question: 'Can you repair laptops for travelers?',
        answer: 'Yes. We handle diagnosis, Windows issues, charging problems, overheating, SSD upgrades and emergency data backup for travelers in Cancun.',
      },
    ],
  },
];

const allFaqs = faqCategories.flatMap((category) => category.items);
const schema = [
  buildBreadcrumbSchema([
    { label: 'Inicio', href: '/' },
    { label: 'Preguntas frecuentes', href: '/preguntas-frecuentes' },
  ]),
  buildFAQSchema(allFaqs),
];
---

<Base
  title="Preguntas frecuentes sobre reparación en Cancún | Pixon PC"
  description="Preguntas frecuentes de Pixon PC sobre reparación de computadoras, laptops, consolas, celulares, humedad, garantía, domicilio, pagos y soporte para empresas en Cancún."
  canonical="https://pixon.com.mx/preguntas-frecuentes"
  image="/LOGOCIRCULAR.png"
  schema={schema}
>
  <Navbar />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Centro de Ayuda / Preguntas' }]} />

  <header class="faq-hero">
    <div class="container">
      <h1>Preguntas frecuentes sobre reparación en Cancún</h1>
      <p>Resolvemos dudas sobre laptops, PCs gamer, celulares, consolas, humedad, garantía, domicilio, pagos y soporte para empresas.</p>
    </div>
  </header>

  <div class="faq-search-bar" id="faq-search-bar">
    <div class="container">
      <div class="faq-search-wrap" style="position:relative;">
        <span class="faq-search-icon" aria-hidden="true"><i class="fa-solid fa-magnifying-glass"></i></span>
        <input type="search" id="faq-search-input" placeholder="Busca: laptop, garantía, humedad, domicilio, empresa..." autocomplete="off" aria-label="Buscar preguntas frecuentes">
        <span id="faq-result-count" aria-live="polite" style="position:absolute; right:18px; top:50%; transform:translateY(-50%); font-size:0.8rem; color:#64748b; pointer-events:none; display:none;"></span>
      </div>
    </div>
  </div>

  <section class="faq-page-content" id="preguntas-frecuentes-content">
    <div class="container">
      {faqCategories.map((category, categoryIndex) => (
        <section class="faq-category-block" data-faq-category>
          <h2 class="faq-category-title" style={categoryIndex === 0 ? 'margin-top:0;' : ''}>
            <i class={`fa-solid ${category.icon}`}></i> {category.title}
          </h2>
          <div class="faq-page-grid">
            {category.items.map((item, itemIndex) => (
              <div class="faq-item" id={`faq-${categoryIndex}-${itemIndex}`} data-faq-item data-faq-text={`${item.question} ${item.answer}`}>
                <button class="faq-question" type="button" aria-expanded="false" aria-controls={`faq-answer-${categoryIndex}-${itemIndex}`} data-faq-question onclick="window.toggleFaq && window.toggleFaq(this)">
                  <span>{item.question}</span>
                  <i class="fa-solid fa-chevron-down faq-chevron" aria-hidden="true"></i>
                </button>
                <div class="faq-answer" id={`faq-answer-${categoryIndex}-${itemIndex}`} aria-hidden="true">
                  <div class="faq-answer-inner">{item.answer}</div>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}

      <div class="faq-no-results" id="faq-no-results" style="display:none; background:#fff; border-radius:20px; padding:48px 28px; border:2px dashed #e2e8f0; box-shadow:0 4px 20px rgba(0,0,0,0.04); text-align:center;">
        <span class="faq-no-icon" style="font-size:2.8rem; display:block; margin-bottom:16px; color:#3b82f6;"><i class="fa-solid fa-magnifying-glass"></i></span>
        <h3 style="font-size:1.3rem; font-weight:800; color:#0f172a; margin-bottom:8px;">No encontramos esa pregunta</h3>
        <p style="color:#64748b; margin-bottom:24px;">Mándanosla por WhatsApp y te respondemos directo.</p>
        <a href="https://wa.me/529986690777?text=Hola%2C%20tengo%20una%20duda%20sobre%20el%20servicio" class="btn-faq-wa" target="_blank" rel="noopener">
          <i class="fa-brands fa-whatsapp"></i> Preguntar por WhatsApp
        </a>
      </div>

      <div class="epic-cta-box" style="margin-top: 5rem;">
        <h2 style="font-weight: 800; font-size: 2rem; color: #020617; margin-bottom: 10px;">Tu equipo en manos expertas.</h2>
        <p style="color: #64748b; font-size: 1.1rem; margin-bottom: 30px;">Garantía por escrito, pago con tarjeta, entrega y recolección a domicilio en Cancún.</p>
        <button onclick="smartWaRedirect('https://wa.me/529986690777?text=Hola%2C%20le%C3%AD%20las%20preguntas%20frecuentes%20y%20quiero%20agendar%20hoy')" class="btn btn-primary btn-large pulse" style="display:inline-flex; align-items:center;">
          <i class="fa-brands fa-whatsapp" style="margin-right:8px; font-size:1.2rem;"></i> Agendar diagnóstico hoy
        </button>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const input = document.getElementById('faq-search-input');
      const resultCount = document.getElementById('faq-result-count');
      const emptyState = document.getElementById('faq-no-results');
      const categoryBlocks = Array.from(document.querySelectorAll('[data-faq-category]'));
      const faqItems = Array.from(document.querySelectorAll('[data-faq-item]'));

      function normalize(value) {
        return String(value || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/\s+/g, ' ')
          .trim();
      }

      function closeFaq(item) {
        const button = item.querySelector('[data-faq-question]');
        const answer = item.querySelector('.faq-answer');
        item.classList.remove('faq-item--open');
        button?.setAttribute('aria-expanded', 'false');
        answer?.setAttribute('aria-hidden', 'true');
        if (answer) answer.style.maxHeight = '0px';
      }

      function openFaq(item) {
        const button = item.querySelector('[data-faq-question]');
        const answer = item.querySelector('.faq-answer');
        item.classList.add('faq-item--open');
        button?.setAttribute('aria-expanded', 'true');
        answer?.setAttribute('aria-hidden', 'false');
        if (answer) answer.style.maxHeight = `${answer.scrollHeight}px`;
      }

      function toggleFaq(button) {
        const item = button.closest('[data-faq-item]');
        if (!item) return;
        if (item.classList.contains('faq-item--open')) closeFaq(item);
        else openFaq(item);
      }

      window.toggleFaq = toggleFaq;

      faqItems.forEach((item) => {
        const answer = item.querySelector('.faq-answer');
        if (answer) answer.style.maxHeight = '0px';
      });

      function filterFaqs() {
        const query = normalize(input?.value || '');
        let visible = 0;

        faqItems.forEach((item) => {
          const searchableText = normalize(item.getAttribute('data-faq-text') || item.textContent || '');
          const matches = !query || searchableText.includes(query);
          item.hidden = !matches;
          item.style.display = matches ? '' : 'none';
          if (!matches) closeFaq(item);
          if (matches) visible += 1;
        });

        categoryBlocks.forEach((block) => {
          const hasVisibleItem = Array.from(block.querySelectorAll('[data-faq-item]')).some((item) => !item.hidden);
          block.hidden = !hasVisibleItem;
          block.style.display = hasVisibleItem ? '' : 'none';
        });

        if (resultCount) {
          resultCount.style.display = query ? 'block' : 'none';
          resultCount.textContent = `${visible} ${visible === 1 ? 'resultado' : 'resultados'}`;
        }
        if (emptyState) emptyState.style.display = visible === 0 ? 'block' : 'none';
      }

      input?.addEventListener('input', filterFaqs);
      window.addEventListener('resize', () => {
        faqItems.forEach((item) => {
          if (item.classList.contains('faq-item--open')) openFaq(item);
        });
      });

      filterFaqs();
    })();
  </script>

  <Footer />
</Base>
