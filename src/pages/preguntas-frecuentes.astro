---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<Base
  title="Preguntas frecuentes sobre reparación en Cancún | Pixon PC"
  description="Preguntas frecuentes sobre reparación de computadoras, laptops, celulares y consolas en Cancún. Diagnóstico gratis, garantía por escrito y servicio a domicilio. Pixon PC."
  canonical="https://pixon.com.mx/preguntas-frecuentes"
  image="/LOGOCIRCULAR.png"
  schema={[
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            {
                "@type": "Question",
                "name": "¿Hacen servicio a domicilio o recolección en Cancún?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí. Ofrecemos recolección y entrega a domicilio dentro de Cancún (Haciendas, Supermanzanas, Zona Hotelera, Polígono Sur, Huayacán, Puerto Morelos y más). Contáctanos por WhatsApp para coordinar, puede aplicar cargo extra por zona."
                }
            },
            {
                "@type": "Question",
                "name": "¿El diagnóstico tiene costo?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "El diagnóstico inicial es gratuito. Te informamos qué tiene tu equipo y cuánto costaría antes de hacer nada. Si decides no proceder, no pagas nada."
                }
            },
            {
                "@type": "Question",
                "name": "¿Cuánto cuesta el mantenimiento de una laptop en Cancún?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "El mantenimiento básico de laptop en Cancún va desde $450 MXN. Incluye limpieza interna, cambio de pasta térmica, revisión de ventiladores y optimización de software."
                }
            },
            {
                "@type": "Question",
                "name": "¿Reparan MacBook en Cancún? ¿Qué modelos?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí, reparamos MacBook Air y Pro con chip M1, M2, M3 e Intel en Cancún. Servicios: cambio de batería, reparación de pantalla Retina, limpieza por líquido derramado, mantenimiento térmico y recuperación de datos."
                }
            },
            {
                "@type": "Question",
                "name": "¿Reparan bisagras rotas de laptop?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí. Reparamos bisagras rotas o sueltas en laptops HP, Dell, Lenovo, Acer y más. Usamos resina epóxica de alta resistencia. Precio desde $650 MXN con garantía por escrito."
                }
            },
            {
                "@type": "Question",
                "name": "¿Cuánto cuesta cambiar la pantalla de una laptop en Cancún?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Desde $1,200 MXN para modelos estándar hasta $3,500 MXN para pantallas 4K. Incluye mano de obra y la pantalla nueva. Diagnóstico gratis."
                }
            },
            {
                "@type": "Question",
                "name": "¿Reparan iPhones en Cancún? ¿Qué modelos?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí, reparamos todos los modelos de iPhone desde el XR hasta el 16 Pro Max en Cancún. Servicios: cambio de pantalla, batería, cámara, Face ID, centro de carga, micrófono y altavoces."
                }
            },
            {
                "@type": "Question",
                "name": "¿Cuánto cuesta cambiar la pantalla de un iPhone en Cancún?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "iPhone XR desde $1,200 MXN, iPhone 13/14 desde $2,200 MXN, iPhone 15/16 Pro Max desde $3,500 MXN. Dos opciones: pantalla original o compatible de alta calidad."
                }
            },
            {
                "@type": "Question",
                "name": "¿Reparan Samsung Galaxy en Cancún?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí, reparamos Samsung Galaxy S23, S24, A34, A54, A15, M series y Note en Cancún. Cambio de pantalla AMOLED, batería, centro de carga, cámara y reparación de software."
                }
            },
            {
                "@type": "Question",
                "name": "¿Mi celular se mojó, todavía tiene solución?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí, en muchos casos sí. Apágalo de inmediato y no lo conectes a corriente. Realizamos limpieza ultrasónica y reparación a nivel componente. La humedad y el salitre de Cancún aceleran la corrosión."
                }
            },
            {
                "@type": "Question",
                "name": "¿Cambian baterías de celular en Cancún?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí. Cambio de batería para iPhone desde $650 MXN y para Samsung Galaxy desde $550 MXN con 30 días de garantía."
                }
            },
            {
                "@type": "Question",
                "name": "¿Reparan consolas PS5, Xbox y Nintendo Switch en Cancún?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí, realizamos limpieza profunda y reparación de consolas PS5, Xbox Series/One y Nintendo Switch en Cancún. Solucionamos problemas de sobrecalentamiento, fallas de HDMI, ruido excesivo y controles con drift."
                }
            },
            {
                "@type": "Question",
                "name": "¿Qué es el Joystick Drift y cómo lo reparan?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "El Joystick Drift ocurre cuando el analógico registra movimiento sin que lo toques. Lo solucionamos reemplazando el potenciómetro analógico dañado. Aplica para PS5 DualSense, Xbox y Switch Pro."
                }
            },
            {
                "@type": "Question",
                "name": "Mi PS5 no da imagen, ¿qué puede ser?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "La causa más común es el puerto HDMI dañado. También puede ser problema de la fuente de poder o placa principal. Ofrecemos diagnóstico gratis."
                }
            },
            {
                "@type": "Question",
                "name": "Mi Xbox se apaga sola, ¿qué hago?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Es por sobrecalentamiento. El polvo y humedad de Cancún bloquean los ventiladores. Una limpieza profunda con cambio de pasta térmica resuelve el problema desde $550 MXN."
                }
            },
            {
                "@type": "Question",
                "name": "¿Cuánto cuesta la limpieza de una consola en Cancún?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "La limpieza profunda de consola (PS5, Xbox, Switch) cuesta desde $550 MXN. Incluye desmontaje completo, limpieza de ventiladores y cambio de pasta térmica."
                }
            },
            {
                "@type": "Question",
                "name": "¿Reparan impresoras en Cancún? ¿Qué marcas?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí. Reparamos impresoras Epson, HP, Canon y Brother en Cancún. Mantenimiento de cabezales, limpieza ultrasónica, cambio de fusor, rodillos y configuración WiFi."
                }
            },
            {
                "@type": "Question",
                "name": "¿Reparan tablets y iPads en Cancún?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí. Reparamos iPad (todos los modelos), Samsung Tab y Lenovo Tab. Servicios: cambio de pantalla, batería, conector USB-C y reparación de software."
                }
            },
            {
                "@type": "Question",
                "name": "¿Reparan audífonos en Cancún?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí. Reparamos AirPods (batería y estuche), Sony WH/WF, JBL, Beats. Cambio de batería, reparación de conector Jack, cable o driver. Limpieza ultrasónica disponible."
                }
            },
            {
                "@type": "Question",
                "name": "¿En qué zonas de Cancún dan servicio a domicilio?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Cubrimos toda Cancún: Zona Hotelera, Supermanzanas, Haciendas, Polígono Sur, Huayacán, Puerto Morelos, Puerto Juárez y Regiones 200-300. También llegamos a Playa del Carmen."
                }
            },
            {
                "@type": "Question",
                "name": "¿Cuánto cuesta el servicio a domicilio?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Desde $50 MXN en zonas cercanas hasta $150 MXN en Zona Hotelera. Te confirmamos el costo exacto al cotizar."
                }
            },
            {
                "@type": "Question",
                "name": "¿Ofrecen soporte técnico remoto?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí. Para problemas de software, virus o configuración. Desde $200 MXN, lo resolvemos en el momento vía conexión remota."
                }
            },
            {
                "@type": "Question",
                "name": "¿Dan garantía por escrito?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí, todos nuestros servicios incluyen garantía por escrito. Si algo falla por causa de nuestro trabajo, lo corregimos sin costo adicional."
                }
            },
            {
                "@type": "Question",
                "name": "¿Aceptan tarjetas y dan factura?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí aceptamos transferencia bancaria y tarjetas de débito/crédito. Emitimos factura electrónica (CFDI) para personas físicas y morales."
                }
            },
            {
                "@type": "Question",
                "name": "¿Qué cubre la garantía?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Cubre la mano de obra y refacciones de la reparación. No cubre daños físicos posteriores. 30 días para reparaciones simples, 90 días para reparaciones mayores."
                }
            },
            {
                "@type": "Question",
                "name": "¿Cómo activo mi garantía?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Contáctanos por WhatsApp o teléfono con tu número de servicio. Te atenderemos sin costo dentro del período de garantía."
                }
            },
            {
                "@type": "Question",
                "name": "¿Aceptan pagos a meses sin intereses?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Aceptamos pago de contado en efectivo, transferencia y tarjetas. No manejamos meses sin intereses, pero ofrecemos descuentos por pago en efectivo."
                }
            },
            {
                "@type": "Question",
                "name": "¿Pueden recuperar datos de un disco duro dañado?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí. Recuperamos datos de discos duros internos, externos, SSD y USB en Cancún. Diagnóstico gratis antes de cobrar."
                }
            },
            {
                "@type": "Question",
                "name": "¿Cuánto cuesta la recuperación de datos en Cancún?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Por software desde $800 MXN. Con daño físico desde $1,500 MXN. Cotizamos después del diagnóstico sin costo."
                }
            },
            {
                "@type": "Question",
                "name": "¿Tienen planes de soporte técnico para empresas en Cancún?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí. Ofrecemos pólizas de mantenimiento mensual y por lote para empresas, hoteles y oficinas. Incluye CFDI 4.0, contratos NDA y canal prioritario."
                }
            },
            {
                "@type": "Question",
                "name": "¿Dan mantenimiento a equipos de hoteles y restaurantes?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí. Tenemos clientes hoteleros en Zona Hotelera. Ofrecemos mantenimiento preventivo programado, equipos de cómputo, impresoras, redes WiFi y sistemas POS."
                }
            },
            {
                "@type": "Question",
                "name": "¿Ofrecen soporte para sistemas CONTPAQi?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí. Damos soporte a CONTPAQi (Contabilidad, Nóminas, Bancos, Factura Electrónica) en Cancún. Instalación, configuración y resolución de errores."
                }
            },
            {
                "@type": "Question",
                "name": "Do you speak English? (¿Hablan inglés?)",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Yes! We speak English. We have experience serving digital nomads, tourists, and expats in Cancún. Contact us on WhatsApp."
                }
            },
            {
                "@type": "Question",
                "name": "Do you offer hotel pickup for repairs?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Yes! We can pick up and deliver your device directly to your hotel in the Hotel Zone. Contact us on WhatsApp to schedule."
                }
            },
            {
                "@type": "Question",
                "name": "Mi laptop tiene virus, ¿cuánto cuesta limpiarlo?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Desde $350 MXN. Incluye análisis completo, eliminación de amenazas, instalación de antivirus y optimización del sistema."
                }
            },
            {
                "@type": "Question",
                "name": "¿Cuánto cuesta instalar Windows en Cancún?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Instalación de Windows 10 u 11 con drivers y programas básicos: $500 MXN. Incluye respaldo de archivos antes de formatear."
                }
            },
            {
                "@type": "Question",
                "name": "Mi computadora está muy lenta, ¿qué puedo do?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Ofrecemos optimización del sistema desde $350 MXN. Incluye limpieza de archivos basura, desfragmentación y revisión de salud del disco duro."
                }
            },
            {
                "@type": "Question",
                "name": "¿Venden e instalan SSD en Cancún?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí. SSD de 240GB, 480GB y 1TB. El cambio revive cualquier laptop vieja. Precio desde $1,200 MXN (SSD 240GB + instalación)."
                }
            },
            {
                "@type": "Question",
                "name": "¿Qué es la sulfatación y por qué afecta en Cancún?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Es la corrosión de componentes electrónicos por humedad, salitre y calor de Cancún. Ofrecemos diagnóstico y tratamiento anti-sulfatación con baño ultrasónico."
                }
            },
            {
                "@type": "Question",
                "name": "¿Cada cuándo debo dar mantenimiento a mi PC en Cancún?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Por el clima de Cancún, recomendamos mantenimiento preventivo cada 4-6 meses. La humedad y el salitre aceleran el desgaste de los componentes."
                }
            }
        ]
    }
]}
>
  <Navbar />
<!-- ═══ NAVBAR ═══ -->
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Centro de Ayuda / Preguntas' }]} />

    <!-- HERO -->
    <header class="faq-hero">
        <div class="container">
            <h1>Preguntas frecuentes sobre reparación en Cancún</h1>
            <p>Resolvemos las dudas más comunes sobre reparación de laptops, computadoras, celulares, impresoras y consolas en Cancún. Diagnóstico gratis, garantía por escrito y atención directa.</p>
        </div>
    </header>

    <!-- BUSCADOR DE PREGUNTAS -->
    <div class="faq-search-bar" id="faq-search-bar">
        <div class="container">
            <div class="faq-search-wrap" style="position:relative;">
                <span class="faq-search-icon" aria-hidden="true"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="search" id="faq-search-input" placeholder="Busca: celular, laptop, garantia, domicilio, impresora..." autocomplete="off" aria-label="Buscar preguntas frecuentes">
                <span id="faq-result-count" style="position:absolute; right:40px; top:50%; transform:translateY(-50%); font-size:0.8rem; color:#94a3b8; pointer-events:none; display:none;"></span>
                <div id="faq-suggestions" style="position:absolute; top:100%; left:0; right:0; background:#fff; border:1px solid #e2e8f0; border-top:none; border-radius:0 0 16px 16px; box-shadow:0 8px 24px rgba(0,0,0,0.1); z-index:100; display:none; overflow:hidden;"></div>
            </div>
        </div>
    </div>
    <script>
    (function(){
        var input = document.getElementById('faq-search-input') as HTMLInputElement;
        var sugBox = document.getElementById('faq-suggestions') as HTMLElement;
        var noResults = document.getElementById('faq-no-results') as HTMLElement;
        var resultCount = document.getElementById('faq-result-count') as HTMLElement;
        if(!input) return;

        function normalize(str: string){ return str.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim(); }

        function saveUnanswered(query: string) {
            if(!query || query.length < 3) return;
            fetch('/api/faqs/unanswered', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' },
                body: JSON.stringify({ query: query })
            }).catch(e => {});
        }

        var allItems: any[] = [];
        var allQuestions: any[] = [];

        function initQuestions() {
            allItems = Array.from(document.querySelectorAll('.faq-item'));
            allQuestions = allItems.map(function(item){
                var btn = item.querySelector('.faq-question span');
                var ans = item.querySelector('.faq-answer-inner');
                var tq = btn ? btn.textContent.trim().toLowerCase() : '';
                var ta = ans ? ans.textContent.trim().toLowerCase() : '';
                return { el: item, text: tq + " " + ta };
            });
        }

        function renderFaqs(faqs: any[]) {
            const container = document.getElementById('dynamic-faqs-container');
            if(!container) return;
            
            // SEO Schema
            const schema = {
                "@context": "https://schema.org",
                "@type": "FAQPage",
                "mainEntity": faqs.map(f => ({
                    "@type": "Question",
                    "name": f.question,
                    "acceptedAnswer": { "@type": "Answer", "text": f.answer }
                }))
            };
            let script = document.createElement('script');
            script.type = 'application/ld+json';
            script.textContent = JSON.stringify(schema);
            document.head.appendChild(script);

            const grouped: Record<string, { icon: string; items: any[] }> = {};
            faqs.forEach(f => {
                if(!grouped[f.category]) grouped[f.category] = { icon: f.icon, items: [] };
                grouped[f.category].items.push(f);
            });

            let html = '';
            const isAdmin = new URLSearchParams(window.location.search).get('admin') === '1';

            for(const [cat, data] of Object.entries(grouped)) {
                html += '<h2 class="faq-category-title"><i class="' + data.icon + '"></i> ' + cat + '</h2>';
                html += '<div class="faq-page-grid" data-cat="' + cat + '" data-icon="' + data.icon + '">';
                data.items.forEach((item: any) => {
                    html += '<div class="faq-item" id="faq-' + item.id + '">';
                    if(isAdmin) {
                        html += '<div style="background:#3b82f6;color:#fff;padding:4px 8px;font-size:12px;display:flex;justify-content:space-between;border-radius:15px 15px 0 0;">' +
                                '<span>ID: ' + item.id + ' (Orden: ' + item.display_order + ')</span>' +
                                '<div><button onclick="editFaq(' + item.id + ')" style="background:#fff;color:#3b82f6;border:none;border-radius:4px;padding:2px 8px;margin-right:5px;cursor:pointer;">✎ Editar</button>' +
                                '<button onclick="deleteFaq(' + item.id + ')" style="background:#ef4444;color:#fff;border:none;border-radius:4px;padding:2px 8px;cursor:pointer;">🗑</button></div></div>';
                    }
                    html += '<button class="faq-question" aria-expanded="false" onclick="toggleFaq(this)">' +
                            '<span>' + item.question + '</span>' +
                            '<i class="fa-solid fa-chevron-down faq-chevron"></i>' +
                            '</button>' +
                            '<div class="faq-answer" aria-hidden="true">' +
                            '<div class="faq-answer-inner">' + item.answer + '</div>' +
                            '</div></div>';
                });
                if(isAdmin) {
                    html += '<button onclick="addFaq(\'' + cat + '\', \'' + data.icon + '\')" style="width:100%;padding:10px;margin-top:10px;background:#eff6ff;color:#3b82f6;border:2px dashed #bfdbfe;border-radius:10px;cursor:pointer;font-weight:bold;">+ Nueva Pregunta en ' + cat + '</button>';
                }
                html += '</div>';
            }
            container.innerHTML = html;
            initQuestions();

            if(isAdmin) injectAdminUnanswered();
        }

        (window as any).editFaq = function(id: number) {
            var item = allItems.find(i => i.id === 'faq-' + id) || document.getElementById('faq-' + id);
            if(!item) return;
            var question = item.querySelector('.faq-question span').textContent;
            var answer = item.querySelector('.faq-answer-inner').innerHTML;
            
            var newQ = prompt('Editar pregunta:', question);
            if(newQ === null) return;
            var newA = prompt('Editar respuesta (acepta HTML):', answer);
            if(newA === null) return;
            var order = prompt('Orden de visualización (ej: 0):', '0');

            // Find cat and icon
            var grid = item.closest('.faq-page-grid');
            var cat = grid.getAttribute('data-cat');
            var icon = grid.getAttribute('data-icon');

            fetch('/api/admin/faqs/' + id, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' },
                body: JSON.stringify({ category: cat, icon: icon, question: newQ, answer: newA, display_order: parseInt(order || '0') })
            }).then(r => r.json()).then((res: any) => {
                if(res.success) location.reload();
                else alert('Error: Asegúrate de estar logueado como administrador.');
            });
        };

        (window as any).deleteFaq = function(id: number) {
            if(!confirm('¿Seguro que deseas eliminar esta pregunta?')) return;
            fetch('/api/admin/faqs/' + id, { method: 'DELETE', headers: { 'X-Requested-With': 'fetch' } })
            .then(r => r.json()).then((res: any) => {
                if(res.success) location.reload();
                else alert('Error: Asegúrate de estar logueado como administrador.');
            });
        };

        (window as any).addFaq = function(cat: string, icon: string) {
            var newQ = prompt('Nueva pregunta:');
            if(!newQ) return;
            var newA = prompt('Respuesta (acepta HTML):');
            if(!newA) return;
            var order = prompt('Orden de visualización (ej: 0):', '0');

            fetch('/api/admin/faqs', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' },
                body: JSON.stringify({ category: cat, icon: icon, question: newQ, answer: newA, display_order: parseInt(order || '0') })
            }).then(r => {
                if(r.status === 201) location.reload();
                else alert('Error: Asegúrate de estar logueado como administrador.');
            });
        };

        function injectAdminUnanswered() {
            if(document.getElementById('faq-admin-panel')) return;
            fetch('/api/admin/faqs/unanswered').then(r => r.json()).then((entries: any) => {
                if(!Array.isArray(entries)) return;
                var panel = document.createElement('div');
                panel.id = 'faq-admin-panel';
                panel.style.cssText = 'position:fixed; bottom:0; left:0; right:0; background:#0f172a; color:#fff; padding:20px; z-index:9999; max-height:60vh; overflow-y:auto; border-top:3px solid #3b82f6; font-family:monospace; font-size:0.85rem;';
                panel.innerHTML = '<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">' +
                    '<strong style="font-size:1rem; color:#60a5fa;">📊 Base de Datos — Búsquedas sin respuesta (' + entries.length + ')</strong>' +
                    '<div style="display:flex; gap:10px;">' +
                    '<button onclick="fetch(\'/api/admin/faqs/unanswered\',{method:\'DELETE\'}).then(()=>location.reload())" style="background:#ef4444; color:#fff; border:none; border-radius:8px; padding:6px 14px; cursor:pointer; font-size:0.8rem;">🗑 Vaciar DB</button>' +
                    '<button onclick="this.closest(\'div\').parentNode.parentNode.remove()" style="background:#475569; color:#fff; border:none; border-radius:8px; padding:6px 14px; cursor:pointer; font-size:0.8rem;">✕ Cerrar</button></div></div>' +
                    (entries.length === 0
                        ? '<p style="color:#94a3b8;">No hay búsquedas sin respuesta registradas en la DB. 🎉</p>'
                        : '<table style="width:100%; border-collapse:collapse;"><thead><tr style="border-bottom:1px solid #334155;"><th style="text-align:left; padding:6px 10px; color:#93c5fd;">Pregunta</th><th style="padding:6px 10px; color:#93c5fd;">Veces</th><th style="padding:6px 10px; color:#93c5fd;">Última</th></tr></thead><tbody>' +
                        entries.map(function(r){
                            var date = r.last_seen ? new Date(r.last_seen).toLocaleDateString('es-MX') : '-';
                            return '<tr style="border-bottom:1px solid #1e293b;"><td style="padding:8px 10px;">' + r.query + '</td><td style="text-align:center; padding:8px 10px; color:' + (r.count > 2 ? '#f87171' : '#fbbf24') + '; font-weight:700;">' + r.count + '</td><td style="padding:8px 10px; color:#64748b; font-size:0.8rem;">' + date + '</td></tr>';
                        }).join('') +
                        '</tbody></table>'
                    );
                document.body.appendChild(panel);
            }).catch(e => console.error(e));
        }

        fetch('/api/faqs')
            .then(res => res.json())
            .then((data: any) => {
                if(data && data.length > 0) renderFaqs(data);
                else initQuestions();
            })
            .catch(() => initQuestions());

        var saveTimer: number | null = null;
        var lastSavedQuery = '';

        function doSearch(){
            if(allQuestions.length === 0) initQuestions();
            if(!input) return;
            var query = normalize(input.value);
            var visible = 0;
            var suggestions: any[] = [];

            document.querySelectorAll('.faq-category-title').forEach(function(t){ (t as HTMLElement).style.display='none'; });

            allQuestions.forEach(function(q){
                if(!query){
                    q.el.style.display = '';
                    visible++;
                } else if(normalize(q.text).indexOf(query) !== -1){
                    q.el.style.display = '';
                    visible++;
                    if(suggestions.length < 5) suggestions.push(q);
                } else {
                    q.el.style.display = 'none';
                }
            });

            document.querySelectorAll('.faq-page-grid').forEach(function(grid){
                var hasVisible = Array.from(grid.querySelectorAll('.faq-item')).some(function(i){ return (i as HTMLElement).style.display !== 'none'; });
                var title = grid.previousElementSibling;
                while(title && !title.classList.contains('faq-category-title')) title = title.previousElementSibling;
                if(title) (title as HTMLElement).style.display = hasVisible ? '' : 'none';
            });

            if(query && resultCount){
                resultCount.textContent = visible + (visible === 1 ? ' resultado' : ' resultados');
                (resultCount as HTMLElement).style.display = 'block';
            } else if(resultCount){
                (resultCount as HTMLElement).style.display = 'none';
            }

            if(noResults) {
                if(query && visible === 0) {
                    (noResults as HTMLElement).style.display = '';
                    var waBtn = noResults.querySelector('.btn-faq-wa');
                    if(waBtn) {
                        var encoded = encodeURIComponent('Hola, pregunté "' + input.value + '" en las FAQs y no encontré respuesta. ¿Me ayudan?');
                        (waBtn as HTMLAnchorElement).href = 'https://wa.me/529986690777?text=' + encoded;
                    }
                    clearTimeout(saveTimer ?? undefined);
                    saveTimer = window.setTimeout(function(){
                        if(normalize(input.value) !== lastSavedQuery) {
                            saveUnanswered(input.value);
                            lastSavedQuery = normalize(input.value);
                        }
                    }, 2000);
                } else {
                    (noResults as HTMLElement).style.display = 'none';
                    clearTimeout(saveTimer ?? undefined);
                }
            }

            if(query && query.length >= 2 && suggestions.length > 0){
                sugBox.innerHTML = suggestions.map(function(s){
                    var txt = s.el.querySelector('.faq-question span').textContent.trim();
                    return '<div class="faq-sug-item" style="padding:12px 20px; cursor:pointer; font-size:0.95rem; color:#334155; border-bottom:1px solid #f1f5f9; transition:background 0.2s;" onmouseover="this.style.background=\\\'#f1f5f9\\\'" onmouseout="this.style.background=\\\'#fff\\\'"><i class="fa-solid fa-magnifying-glass" style="color:#94a3b8; margin-right:10px; font-size:0.8rem;"></i>' + txt + '</div>';
                }).join('');
                (sugBox as HTMLElement).style.display = 'block';
                sugBox.querySelectorAll('.faq-sug-item').forEach(function(item, idx){
                    item.addEventListener('click', function(){
                        var target = suggestions[idx].el;
                        (sugBox as HTMLElement).style.display = 'none';
                        input.value = '';
                        doSearch();
                        target.scrollIntoView({ behavior:'smooth', block:'center' });
                        var btn = target.querySelector('.faq-question');
                        if(btn && btn.getAttribute('aria-expanded') !== 'true') btn.click();
                    });
                });
            } else {
                (sugBox as HTMLElement).style.display = 'none';
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            input.addEventListener('input', doSearch);
            input.addEventListener('keydown', function(e){
                if(e.key === 'Escape'){ (sugBox as HTMLElement).style.display='none'; input.value=''; doSearch(); }
                if(e.key === 'Enter' && input.value.trim().length > 0){
                    var query = normalize(input.value);
                    var hasResults = allQuestions.some(function(q: any){ return normalize(q.text).indexOf(query) !== -1; });
                    if(!hasResults && input.value.length >= 3) { saveUnanswered(input.value); }
                    (sugBox as HTMLElement).style.display = 'none';
                }
            });
            document.addEventListener('click', function(e){
                if(!(e.target as HTMLElement).closest('.faq-search-wrap')) (sugBox as HTMLElement).style.display='none';
            });
        });
    })();
    </script>


