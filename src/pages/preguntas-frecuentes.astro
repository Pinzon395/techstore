---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const faqCategories = [
  {
    title: 'Servicio, diagnóstico y tiempos',
    icon: 'fa-screwdriver-wrench',
    items: [
      {
        question: '¿El diagnóstico tiene costo?',
        answer: 'El diagnóstico inicial es gratis y sin compromiso. Revisamos el equipo, explicamos la falla real y te damos costo antes de reparar.',
      },
      {
        question: '¿Cuánto tarda una reparación?',
        answer: 'Depende de la falla. Un mantenimiento puede tardar de 2 a 4 horas; reparaciones con piezas, placa o pruebas de estabilidad pueden tomar de 24 a 72 horas.',
      },
      {
        question: '¿Me avisan antes de cambiar piezas?',
        answer: 'Sí. No cambiamos piezas sin autorización. Primero enviamos diagnóstico, costo, tiempo estimado y condiciones de garantía.',
      },
      {
        question: '¿Puedo llevar mi propio repuesto?',
        answer: 'Sí, podemos instalarlo si es compatible. La garantía aplicaría sobre la mano de obra, no sobre la pieza que trae el cliente.',
      },
    ],
  },
  {
    title: 'Laptops y computadoras',
    icon: 'fa-laptop',
    items: [
      {
        question: '¿Reparan laptops que no encienden?',
        answer: 'Sí. Revisamos cargador, centro de carga, batería, placa, RAM, SSD, BIOS y líneas principales antes de cotizar.',
      },
      {
        question: '¿Cambian pantallas, teclados y baterías?',
        answer: 'Sí. Trabajamos pantallas, teclados, baterías, bisagras, carcasas, centros de carga, ventiladores, SSD y RAM según modelo.',
      },
      {
        question: '¿Mi información se borra durante la reparación?',
        answer: 'No tocamos archivos personales salvo que el servicio requiera respaldo, clonado o formateo. En ese caso pedimos autorización antes.',
      },
      {
        question: '¿Qué hago si mi laptop se calienta mucho?',
        answer: 'Conviene revisarla. En Cancún el calor, polvo y humedad saturan ventiladores y pasta térmica más rápido que en climas secos.',
      },
    ],
  },
  {
    title: 'PC gamer, ensambles y upgrades',
    icon: 'fa-desktop',
    items: [
      {
        question: '¿Arman PC gamer si yo compro las piezas?',
        answer: 'Sí. Podemos ensamblar, ordenar cableado, actualizar BIOS, instalar Windows, configurar drivers y hacer pruebas de temperatura.',
      },
      {
        question: '¿Qué incluye el mantenimiento Pro Gamer?',
        answer: 'Incluye limpieza profunda, revisión térmica, pasta de alto rendimiento, mantenimiento de GPU compatible y pruebas bajo carga.',
      },
      {
        question: '¿Instalan SSD, RAM o tarjeta gráfica?',
        answer: 'Sí. Verificamos compatibilidad de placa, fuente, gabinete, BIOS y temperatura antes de instalar.',
      },
      {
        question: '¿Hacen optimización para más FPS?',
        answer: 'Sí. Optimizamos Windows, drivers, inicio, energía, latencia y configuración de juegos cuando el hardware lo permite.',
      },
    ],
  },
  {
    title: 'Humedad, líquido y antisulfatación',
    icon: 'fa-droplet-slash',
    items: [
      {
        question: '¿Qué es la sulfatación?',
        answer: 'Es corrosión en pistas, conectores y componentes por humedad, salitre, líquido o residuos. En Cancún es común por el clima costero.',
      },
      {
        question: '¿Qué hago si se mojó mi equipo?',
        answer: 'Apágalo, no lo cargues, no uses secadora y tráelo a revisión. Encenderlo con humedad puede provocar corto y daño de placa.',
      },
      {
        question: '¿La antisulfatación garantiza que quedará como nuevo?',
        answer: 'No se promete eso cuando hay corrosión. Primero buscamos detener avance, recuperar funcionamiento, rescatar datos y explicar el riesgo real.',
      },
      {
        question: '¿Cada cuánto conviene dar mantenimiento en Cancún?',
        answer: 'Para equipos de uso diario recomendamos cada 6 a 8 meses. Si está cerca de playa, ventana, humedad o polvo, puede necesitarse antes.',
      },
    ],
  },
  {
    title: 'Celulares, tablets y consolas',
    icon: 'fa-gamepad',
    items: [
      {
        question: '¿Reparan celulares e iPhone?',
        answer: 'Sí. Revisamos pantalla, batería, cámara, centro de carga, micrófono, audio, software y daño por líquido.',
      },
      {
        question: '¿Reparan PS5, Xbox y Nintendo Switch?',
        answer: 'Sí. Atendemos sobrecalentamiento, HDMI, limpieza profunda, pasta térmica, ruido, apagados y controles con drift.',
      },
      {
        question: '¿Qué es joystick drift?',
        answer: 'Es cuando el control detecta movimiento aunque no lo estés tocando. Se revisa el módulo analógico y se reemplaza si está dañado.',
      },
      {
        question: '¿También ven tablets o iPad?',
        answer: 'Sí. Podemos revisar pantalla, batería, puerto de carga, software y daño por líquido en tablets compatibles.',
      },
    ],
  },
  {
    title: 'Windows, software y datos',
    icon: 'fa-window-restore',
    items: [
      {
        question: '¿Instalan Windows con drivers?',
        answer: 'Sí. Instalamos Windows 10 u 11, drivers, actualizaciones y programas básicos. Si hay datos importantes, cotizamos respaldo antes.',
      },
      {
        question: '¿Quitan virus y programas basura?',
        answer: 'Sí. Revisamos malware, programas de inicio, extensiones sospechosas, archivos temporales y configuración que afecta rendimiento.',
      },
      {
        question: '¿Recuperan archivos borrados o discos dañados?',
        answer: 'Sí, primero evaluamos el tipo de daño. La recuperación depende de si la falla es lógica, física o por corrupción avanzada.',
      },
      {
        question: '¿Pueden hacer soporte remoto?',
        answer: 'Sí, para problemas de software, configuración, lentitud, programas, correo y algunas revisiones de Windows.',
      },
    ],
  },
  {
    title: 'Empresas, pagos y factura',
    icon: 'fa-building-shield',
    items: [
      {
        question: '¿Atienden empresas en Cancún?',
        answer: 'Sí. Atendemos oficinas, hoteles, restaurantes, escuelas y negocios con soporte por lote o póliza mensual.',
      },
      {
        question: '¿Facturan?',
        answer: 'Sí. Emitimos CFDI para personas físicas y morales. Solicítalo al cotizar para registrar los datos correctos.',
      },
      {
        question: '¿Aceptan tarjeta o transferencia?',
        answer: 'Sí. Aceptamos efectivo, transferencia y tarjeta según el servicio. Para empresas podemos cotizar condiciones específicas.',
      },
      {
        question: '¿Dan reportes por equipo?',
        answer: 'Sí. En servicios B2B podemos documentar folio, evidencia, estado inicial, trabajos realizados y recomendaciones.',
      },
    ],
  },
  {
    title: 'Ubicación, domicilio y garantía',
    icon: 'fa-location-dot',
    items: [
      {
        question: '¿Dónde están ubicados?',
        answer: 'Estamos en Haciendas, Cancún, Quintana Roo 77539. Trabajamos con cita para recibir tu equipo con orden y seguimiento.',
      },
      {
        question: '¿Tienen recolección y entrega?',
        answer: 'Sí. Podemos coordinar recolección y entrega en Cancún según zona, horario y disponibilidad.',
      },
      {
        question: '¿Qué cubre la garantía?',
        answer: 'Cubre mano de obra y piezas instaladas según el servicio. No cubre golpes, líquido posterior, variaciones eléctricas o manipulación externa.',
      },
      {
        question: '¿Cómo activo mi garantía?',
        answer: 'Contáctanos por WhatsApp con tu folio, ticket o datos del servicio. Revisamos el caso y te indicamos el siguiente paso.',
      },
    ],
  },
  {
    title: 'English support',
    icon: 'fa-globe',
    items: [
      {
        question: 'Do you speak English?',
        answer: 'Yes. We can assist tourists, digital nomads and expats in English by WhatsApp.',
      },
      {
        question: 'Do you offer hotel pickup?',
        answer: 'Yes. We can coordinate pickup and delivery in the Hotel Zone depending on schedule and location.',
      },
      {
        question: 'Can you repair laptops for travelers?',
        answer: 'Yes. We handle diagnosis, Windows issues, charging problems, overheating, SSD upgrades and emergency data backup.',
      },
    ],
  },
];

const allFaqs = faqCategories.flatMap((category) => category.items);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: allFaqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<Base
  title="Preguntas frecuentes sobre reparación en Cancún | Pixon PC"
  description="Preguntas frecuentes de Pixon PC sobre reparación de computadoras, laptops, consolas, celulares, humedad, garantía, domicilio, pagos y soporte para empresas en Cancún."
  canonical="https://pixon.com.mx/preguntas-frecuentes"
  image="/LOGOCIRCULAR.png"
  schema={schema}
>
  <Navbar />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Centro de Ayuda / Preguntas' }]} />

  <header class="faq-hero">
    <div class="container">
      <h1>Preguntas frecuentes sobre reparación en Cancún</h1>
      <p>Resolvemos dudas sobre laptops, PCs gamer, celulares, consolas, humedad, garantía, domicilio, pagos y soporte para empresas.</p>
    </div>
  </header>

  <div class="faq-search-bar" id="faq-search-bar">
    <div class="container">
      <div class="faq-search-wrap" style="position:relative;">
        <span class="faq-search-icon" aria-hidden="true"><i class="fa-solid fa-magnifying-glass"></i></span>
        <input type="search" id="faq-search-input" placeholder="Busca: laptop, garantía, humedad, domicilio, empresa..." autocomplete="off" aria-label="Buscar preguntas frecuentes">
        <span id="faq-result-count" style="position:absolute; right:18px; top:50%; transform:translateY(-50%); font-size:0.8rem; color:#94a3b8; pointer-events:none; display:none;"></span>
      </div>
    </div>
  </div>

  <section class="faq-page-content" id="preguntas-frecuentes-content">
    <div class="container">
      {faqCategories.map((category, categoryIndex) => (
        <section class="faq-category-block" data-faq-category>
          <h2 class="faq-category-title" style={categoryIndex === 0 ? 'margin-top:0;' : ''}>
            <i class={`fa-solid ${category.icon}`}></i> {category.title}
          </h2>
          <div class="faq-page-grid">
            {category.items.map((item, itemIndex) => (
              <div class="faq-item" id={`faq-${categoryIndex}-${itemIndex}`} data-faq-item>
                <button class="faq-question" aria-expanded="false" onclick="toggleFaq(this)">
                  <span>{item.question}</span>
                  <i class="fa-solid fa-chevron-down faq-chevron"></i>
                </button>
                <div class="faq-answer" aria-hidden="true">
                  <div class="faq-answer-inner">{item.answer}</div>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}

      <div class="faq-no-results" id="faq-no-results" style="display:none; background:#fff; border-radius:20px; padding:48px 28px; border:2px dashed #e2e8f0; box-shadow:0 4px 20px rgba(0,0,0,0.04); text-align:center;">
        <span class="faq-no-icon" style="font-size:2.8rem; display:block; margin-bottom:16px; color:#3b82f6;"><i class="fa-solid fa-magnifying-glass"></i></span>
        <h3 style="font-size:1.3rem; font-weight:800; color:#0f172a; margin-bottom:8px;">No encontramos esa pregunta</h3>
        <p style="color:#64748b; margin-bottom:24px;">Mándanosla por WhatsApp y te respondemos directo.</p>
        <a href="https://wa.me/529986690777?text=Hola%2C%20tengo%20una%20duda%20sobre%20el%20servicio" class="btn-faq-wa" target="_blank" rel="noopener">
          <i class="fa-brands fa-whatsapp"></i> Preguntar por WhatsApp
        </a>
      </div>

      <div class="epic-cta-box" style="margin-top: 5rem;">
        <h2 style="font-weight: 800; font-size: 2rem; color: #020617; margin-bottom: 10px;">Tu equipo en manos expertas.</h2>
        <p style="color: #64748b; font-size: 1.1rem; margin-bottom: 30px;">Garantía por escrito, pago con tarjeta, entrega y recolección a domicilio en Cancún.</p>
        <button onclick="smartWaRedirect('https://wa.me/529986690777?text=Hola%2C%20le%C3%AD%20las%20preguntas%20frecuentes%20y%20quiero%20agendar%20hoy')" class="btn btn-primary btn-large pulse" style="display:inline-flex; align-items:center;">
          <i class="fa-brands fa-whatsapp" style="margin-right:8px; font-size:1.2rem;"></i> Agendar diagnóstico hoy
        </button>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<script is:inline>
  (function () {
    const input = document.getElementById('faq-search-input');
    const resultCount = document.getElementById('faq-result-count');
    const emptyState = document.getElementById('faq-no-results');
    const categoryBlocks = Array.from(document.querySelectorAll('[data-faq-category]'));
    const faqItems = Array.from(document.querySelectorAll('[data-faq-item]'));

    function normalize(value) {
      return value.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    }

    function filterFaqs() {
      const query = normalize(input.value.trim());
      let visible = 0;

      faqItems.forEach((item) => {
        const matches = !query || normalize(item.textContent || '').includes(query);
        item.style.display = matches ? '' : 'none';
        if (matches) visible += 1;
      });

      categoryBlocks.forEach((block) => {
        const hasVisibleItem = Array.from(block.querySelectorAll('[data-faq-item]')).some((item) => item.style.display !== 'none');
        block.style.display = hasVisibleItem ? '' : 'none';
      });

      if (resultCount) {
        resultCount.style.display = query ? 'block' : 'none';
        resultCount.textContent = `${visible}`;
      }
      if (emptyState) emptyState.style.display = visible === 0 ? 'block' : 'none';
    }

    input?.addEventListener('input', filterFaqs);
  })();
</script>
