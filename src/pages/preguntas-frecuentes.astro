  ],
  'English support': [
    { question: 'Can you provide an estimate before I visit?', answer: 'We can provide an initial range if you send the exact model, symptoms and photos. The final estimate may require physical diagnosis because charging, display and motherboard failures can look similar from the outside.' },
    { question: 'Can you help with an urgent data backup?', answer: 'Yes, when the storage device is still readable. Stop using the computer if the drive makes unusual noises or disconnects. We will assess the safest way to copy the data and explain the risks before proceeding.' },
    { question: 'Do you provide written repair updates?', answer: 'Yes. We can communicate the diagnosis, authorization request and status through WhatsApp or the repair ticket. Business customers may request a more structured report per device.' },
    { question: 'Can someone else collect my repaired device?', answer: 'Yes, with prior authorization from the registered customer. We may request the ticket details or confirmation through the original contact channel before releasing the device.' },
  ],
};

faqCategories.forEach((category) => {
  category.items.push(...(additionalFaqsByCategory[category.title] || []));
});

const allFaqs = faqCategories.flatMap((category) => category.items);
const localFaqRecords = faqCategories.flatMap((category) => category.items.map((item, index) => ({
  id: `local-${category.title}-${index}`,
  category: category.title,
  icon: `fa-solid ${category.icon}`,
  question: item.question,
  answer: item.answer,
  display_order: index,
})));
const localFaqDataJson = JSON.stringify(localFaqRecords).replace(/</g, '\\u003c');
const schema = [
  buildBreadcrumbSchema([
    { label: 'Inicio', href: '/' },
    { label: 'Preguntas frecuentes', href: '/preguntas-frecuentes' },
  ]),
  buildFAQSchema(allFaqs),
].filter(Boolean) as object[];
---

<Base
  title="Preguntas frecuentes sobre reparación en Cancún | Pixon PC"
  description="Preguntas frecuentes de Pixon PC sobre reparación de computadoras, laptops, consolas, celulares, humedad, garantía, domicilio, pagos y soporte para empresas en Cancún."
  canonical="https://pixon.com.mx/preguntas-frecuentes"
  image="/LOGOCIRCULAR.png"
  schema={schema}
  bodyClass="light-theme faq-hub-page"
>
  <Navbar />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Centro de Ayuda / Preguntas' }]} />

  <header class="faq-hero">
    <div class="container">
      <span class="faq-hero-kicker"><Icon name="circle-question" /> Centro de ayuda Pixon PC</span>
      <h1>Preguntas frecuentes sobre reparación en Cancún</h1>
      <p>Resolvemos dudas sobre laptops, PCs gamer, celulares, consolas, humedad, garantía, domicilio, pagos y soporte para empresas.</p>
      <div class="faq-hero-stats" aria-label="Resumen del centro de ayuda">
        <span><strong id="faq-total-count">{allFaqs.length}</strong> respuestas</span>
        <span><strong>{faqCategories.length}</strong> categorías</span>
        <span><Icon name="clock" /> Búsqueda instantánea</span>
      </div>
    </div>
  </header>

  <div class="faq-search-bar" id="faq-search-bar">
    <div class="container">
      <div class="faq-search-wrap">
        <span class="faq-search-icon" aria-hidden="true"><Icon name="magnifying-glass" /></span>
        <input type="search" id="faq-search-input" placeholder="Busca: laptop, garantía, humedad, domicilio, empresa..." autocomplete="off" aria-label="Buscar preguntas frecuentes">
        <kbd class="faq-search-shortcut" aria-hidden="true">/</kbd>
        <button type="button" id="faq-search-clear" class="faq-search-clear" aria-label="Limpiar búsqueda" hidden><Icon name="xmark" /></button>
      </div>
      <div class="faq-search-meta" aria-label="Estado de la búsqueda">
        <span class="faq-meta-item faq-meta-results">
          <span class="faq-meta-icon" aria-hidden="true"><Icon name="list-check" /></span>
          <span><small>Resultados</small><strong id="faq-result-count" aria-live="polite">Mostrando todas las respuestas</strong></span>
        </span>
        <span class="faq-meta-item faq-meta-source">
          <span class="faq-meta-icon" aria-hidden="true"><Icon name="shield-halved" /></span>
          <span><small>Fuente</small><strong id="faq-source-status">Contenido verificado por Pixon PC</strong></span>
        </span>
      </div>
      <div class="faq-filter-header">
        <span><Icon name="sliders" /> Explorar por tema</span>
        <small>Selecciona una categoría para filtrar</small>
      </div>
      <div class="faq-category-tabs" id="faq-category-tabs" aria-label="Filtrar por categoría">
        <button type="button" class="faq-category-tab active" data-faq-filter="all" aria-pressed="true"><span class="faq-tab-icon"><Icon name="layer-group" /></span><span>Todas</span></button>
        {faqCategories.map((category) => <button type="button" class="faq-category-tab" data-faq-filter={category.title} aria-pressed="false"><span class="faq-tab-icon"><Icon name={category.icon.replace('fa-', '')} /></span><span>{category.title}</span></button>)}
      </div>
    </div>
  </div>

  <section class="faq-page-content" id="preguntas-frecuentes-content">
    <div class="container">
      {faqCategories.map((category, categoryIndex) => (
        <section class="faq-category-block" data-faq-category data-category-name={category.title}>
          <h2 class="faq-category-title" style={categoryIndex === 0 ? 'margin-top:0;' : ''}>
            <Icon name={category.icon.replace('fa-', '')} /> <span>{category.title}</span><small>{category.items.length}</small>
          </h2>
          <div class="faq-page-grid">
            {category.items.map((item, itemIndex) => (
              <div class="faq-item" id={`faq-${categoryIndex}-${itemIndex}`} data-faq-item data-faq-text={`${item.question} ${item.answer}`}>
                <button class="faq-question" type="button" aria-expanded="false" aria-controls={`faq-answer-${categoryIndex}-${itemIndex}`} data-faq-question>
                  <span>{item.question}</span>
                  <i class="fa-solid fa-chevron-down faq-chevron" aria-hidden="true"></i>
                </button>
                <div class="faq-answer" id={`faq-answer-${categoryIndex}-${itemIndex}`} aria-hidden="true">
                  <div class="faq-answer-inner">{item.answer}</div>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}

      <div class="faq-no-results" id="faq-no-results" hidden>
        <span class="faq-no-icon"><Icon name="magnifying-glass" /></span>
        <h3>No encontramos esa pregunta</h3>
        <p>Registramos tu búsqueda para mejorar este centro de ayuda. También puedes preguntarnos directamente.</p>
        <a href="https://wa.me/529986690777?text=Hola%2C%20tengo%20una%20duda%20sobre%20el%20servicio" class="btn-faq-wa" target="_blank" rel="noopener">
          <Icon name="whatsapp" /> Preguntar por WhatsApp
        </a>
      </div>

      <div class="faq-final-cta">
        <div><span>¿Tu caso necesita diagnóstico?</span><h2>Convierte tu duda en un ticket con seguimiento</h2><p>Registra equipo, síntomas y datos de contacto para conservar toda la información desde el inicio.</p></div>
        <div class="faq-final-actions"><a href="/tickets" class="faq-primary-action"><Icon name="ticket" /> Crear ticket</a><a href="https://wa.me/529986690777?text=Hola%2C%20le%C3%AD%20las%20preguntas%20frecuentes%20y%20necesito%20ayuda" target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a></div>
      </div>
    </div>
  </section>

  <template id="faq-local-data" set:html={localFaqDataJson}></template>

  <script is:inline>
    (function () {
      const input = document.getElementById('faq-search-input');
      const resultCount = document.getElementById('faq-result-count');
      const emptyState = document.getElementById('faq-no-results');
      const content = document.querySelector('#preguntas-frecuentes-content > .container');
      const clearButton = document.getElementById('faq-search-clear');
      const tabs = document.getElementById('faq-category-tabs');
      const sourceStatus = document.getElementById('faq-source-status');
      const totalCount = document.getElementById('faq-total-count');
      const loggedQueries = new Set();
      const localData = (() => {
        try { return JSON.parse(document.getElementById('faq-local-data')?.textContent || '[]'); }
        catch (_error) { return []; }
      })();
      let activeCategory = new URLSearchParams(location.search).get('categoria') || 'all';
      let unansweredTimer;

      function normalize(value) {
        return String(value || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/\s+/g, ' ')
          .trim();
      }

      function getItems() {
        return Array.from(document.querySelectorAll('[data-faq-item]'));
      }

      function getCategories() {
        return Array.from(document.querySelectorAll('[data-faq-category]'));
      }

      function closeFaq(item) {
        const button = item.querySelector('[data-faq-question]');
        const answer = item.querySelector('.faq-answer');
        item.classList.remove('faq-item--open');
        button?.setAttribute('aria-expanded', 'false');
        answer?.setAttribute('aria-hidden', 'true');
      }

      function openFaq(item) {
        const button = item.querySelector('[data-faq-question]');
        const answer = item.querySelector('.faq-answer');
        item.classList.add('faq-item--open');
        button?.setAttribute('aria-expanded', 'true');
        answer?.setAttribute('aria-hidden', 'false');
      }

      function toggleFaq(button) {
        const item = button.closest('[data-faq-item]');
        if (!item) return;
        if (item.classList.contains('faq-item--open')) closeFaq(item);
        else {
          openFaq(item);
          history.replaceState(null, '', `${location.pathname}${location.search}#${item.id}`);
        }
      }

      window.toggleFaq = toggleFaq;

      function updateUrl(query) {
        const params = new URLSearchParams();
        if (query) params.set('q', query);
        if (activeCategory !== 'all') params.set('categoria', activeCategory);
        const search = params.toString();
        history.replaceState(null, '', `${location.pathname}${search ? `?${search}` : ''}`);
      }

      function logUnanswered(query) {
        const normalized = normalize(query);
        if (normalized.length < 3 || loggedQueries.has(normalized)) return;
        clearTimeout(unansweredTimer);
        unansweredTimer = setTimeout(() => {
          loggedQueries.add(normalized);
          fetch('/api/faqs/unanswered', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ query: query.slice(0, 180) }),
            keepalive: true,
          }).catch(() => {});
        }, 900);
      }

      function filterFaqs(options = {}) {
        const query = normalize(input?.value || '');
        const tokens = query.split(' ').filter(Boolean);
        let visible = 0;

        getItems().forEach((item) => {
          const searchableText = normalize(item.getAttribute('data-faq-text') || item.textContent || '');
          const category = item.closest('[data-faq-category]')?.getAttribute('data-category-name') || '';
          const matchesText = !query || tokens.every((token) => searchableText.includes(token));
          const matchesCategory = activeCategory === 'all' || category === activeCategory;
          const matches = matchesText && matchesCategory;
          item.hidden = !matches;
          if (!matches) closeFaq(item);
          if (matches) visible += 1;
        });

        getCategories().forEach((block) => {
          const hasVisibleItem = Array.from(block.querySelectorAll('[data-faq-item]')).some((item) => !item.hidden);
          block.hidden = !hasVisibleItem;
        });

        if (resultCount) {
          resultCount.textContent = query || activeCategory !== 'all'
            ? `${visible} ${visible === 1 ? 'respuesta encontrada' : 'respuestas encontradas'}`
            : 'Mostrando todas las respuestas';
        }
        if (emptyState) emptyState.hidden = visible !== 0;
        if (clearButton) clearButton.hidden = !query;
        tabs?.querySelectorAll('[data-faq-filter]').forEach((tab) => {
          const selected = tab.dataset.faqFilter === activeCategory;
          tab.classList.toggle('active', selected);
          tab.setAttribute('aria-pressed', String(selected));
        });
        if (!options.skipUrl) updateUrl(input?.value.trim() || '');
        if (visible === 0 && query) logUnanswered(input.value.trim());
      }

      function plainText(html) {
        const node = document.createElement('div');
        node.innerHTML = String(html || '').replace(/<br\s*\/?\s*>/gi, '\n');
        return node.textContent || '';
      }

      function iconName(value) {
        const matches = String(value || '').match(/fa-([\w-]+)/g) || [];
        return matches.length ? matches[matches.length - 1].replace('fa-', '') : 'circle-question';
      }

      function svgIcon(name, className = '') {
        return `<svg class="tc-svg ${className}" aria-hidden="true" focusable="false"><use href="/assets/icons/sprite.svg#fa-${name}"></use></svg>`;
      }

      function renderFaqData(data) {
        const grouped = new Map();
        data.forEach((faq) => {
          const category = String(faq.category || 'General').trim() || 'General';
          if (!grouped.has(category)) grouped.set(category, { icon: iconName(faq.icon), items: [] });
          grouped.get(category).items.push(faq);
        });
        content.querySelectorAll('[data-faq-category]').forEach((node) => node.remove());
        [...grouped.entries()].forEach(([category, group], categoryIndex) => {
          group.items.sort((a, b) => Number(a.display_order || 0) - Number(b.display_order || 0));
          const section = document.createElement('section');
          section.className = 'faq-category-block';
          section.dataset.faqCategory = '';
          section.dataset.categoryName = category;
          const title = document.createElement('h2');
          title.className = 'faq-category-title';
          title.innerHTML = `${svgIcon(group.icon)}<span></span><small>${group.items.length}</small>`;
          title.querySelector('span').textContent = category;
          const grid = document.createElement('div');
          grid.className = 'faq-page-grid';
          group.items.forEach((faq, itemIndex) => {
            const id = `faq-${faq.id || `${categoryIndex}-${itemIndex}`}`;
            const item = document.createElement('div');
            item.className = 'faq-item';
            item.id = id;
            item.dataset.faqItem = '';
            item.dataset.faqText = `${faq.question || ''} ${plainText(faq.answer)} ${category}`;
            const button = document.createElement('button');
            button.className = 'faq-question';
            button.type = 'button';
            button.dataset.faqQuestion = '';
            button.setAttribute('aria-expanded', 'false');
            button.setAttribute('aria-controls', `${id}-answer`);
            const question = document.createElement('span');
            question.textContent = faq.question || '';
            button.append(question);
            button.insertAdjacentHTML('beforeend', svgIcon('chevron-down', 'faq-chevron'));
            const answer = document.createElement('div');
            answer.className = 'faq-answer';
            answer.id = `${id}-answer`;
            answer.setAttribute('aria-hidden', 'true');
            const answerInner = document.createElement('div');
            answerInner.className = 'faq-answer-inner';
            answerInner.textContent = plainText(faq.answer);
            answer.append(answerInner);
            item.append(button, answer);
            grid.append(item);
          });
          section.append(title, grid);
          content.insertBefore(section, emptyState);
        });
        if (totalCount) totalCount.textContent = String(data.length);
        if (tabs) {
          tabs.innerHTML = '<button type="button" class="faq-category-tab active" data-faq-filter="all" aria-pressed="true">Todas</button>';
          [...grouped.keys()].forEach((category) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'faq-category-tab';
            button.dataset.faqFilter = category;
            button.setAttribute('aria-pressed', 'false');
            button.textContent = category;
            tabs.append(button);
          });
        }
      }

      input?.addEventListener('input', () => filterFaqs());
      clearButton?.addEventListener('click', () => { input.value = ''; input.focus(); filterFaqs(); });
      tabs?.addEventListener('click', (event) => {
        const tab = event.target.closest('[data-faq-filter]');
        if (!tab) return;
        activeCategory = tab.dataset.faqFilter || 'all';
        filterFaqs();
      });
      document.addEventListener('click', (event) => {
        const button = event.target.closest('[data-faq-question]');
        if (button) toggleFaq(button);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === '/' && document.activeElement !== input && !/INPUT|TEXTAREA|SELECT/.test(document.activeElement?.tagName || '')) {
          event.preventDefault();
          input?.focus();
        }
        if (event.key === 'Escape' && document.activeElement === input && input.value) {
          input.value = '';
          filterFaqs();
        }
      });
      window.addEventListener('resize', () => {
        getItems().forEach((item) => {
          if (item.classList.contains('faq-item--open')) openFaq(item);
        });
      });

      const params = new URLSearchParams(location.search);
      if (input) input.value = params.get('q') || '';
      getItems().forEach((item) => closeFaq(item));
      filterFaqs({ skipUrl: true });

      fetch('/api/faqs')
        .then((response) => response.ok ? response.json() : Promise.reject())
        .then((data) => {
          if (!Array.isArray(data)) return;
          const merged = new Map(localData.map((faq) => [normalize(faq.question), faq]));
          data.forEach((faq) => merged.set(normalize(faq.question), faq));
          renderFaqData([...merged.values()]);
          if (![...tabs.querySelectorAll('[data-faq-filter]')].some((tab) => tab.dataset.faqFilter === activeCategory)) activeCategory = 'all';
          if (sourceStatus) sourceStatus.textContent = 'Sincronizado con el panel administrativo';
          filterFaqs({ skipUrl: true });
          if (location.hash) document.querySelector(location.hash)?.querySelector('[data-faq-question]')?.click();
        })
        .catch(() => { if (sourceStatus) sourceStatus.textContent = 'Contenido local disponible'; });
    })();
  </script>

  <style>
    :global(.faq-hub-page) { --faq-ink:#071f3a; --faq-blue:#0b65d8; --faq-cyan:#39bce9; --faq-soft:#eef6fb; background:#f7fafc; }
    :global(.faq-hub-page .tc-svg) { width:1em; height:1em; fill:currentColor; }
    :global(.faq-hub-page .faq-hero) { position:relative; overflow:hidden; padding:clamp(72px,9vw,118px) 0 88px; background:#071f3a; text-align:left; }
    :global(.faq-hub-page .faq-hero::before) { content:""; position:absolute; inset:0; background:linear-gradient(rgba(57,188,233,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(57,188,233,.08) 1px,transparent 1px); background-size:44px 44px; mask-image:linear-gradient(to right,#000,transparent 88%); }
    :global(.faq-hub-page .faq-hero::after) { content:"?"; position:absolute; right:5vw; bottom:-.34em; color:rgba(57,188,233,.1); font-family:var(--font-heading); font-size:clamp(14rem,28vw,28rem); font-weight:900; line-height:1; }
    :global(.faq-hub-page .faq-hero .container) { position:relative; z-index:1; }
    :global(.faq-hub-page .faq-hero h1) { max-width:900px; margin:14px 0 16px; color:#fff; font-family:var(--font-heading); font-size:clamp(2.5rem,6vw,5.2rem); line-height:1; letter-spacing:0; }
    :global(.faq-hub-page .faq-hero p) { max-width:720px; margin:0; color:#bed1e4; font-size:clamp(1rem,2vw,1.15rem); line-height:1.7; }
    .faq-hero-kicker { display:inline-flex; align-items:center; gap:8px; color:#75d3f5!important; font-size:.78rem; font-weight:900; letter-spacing:.12em; text-transform:uppercase; }
    .faq-hero-stats { display:flex; flex-wrap:wrap; gap:10px; margin-top:28px; }
    .faq-hero-stats span { display:inline-flex; align-items:center; gap:7px; padding:8px 12px; color:#d9e8f5!important; border:1px solid rgba(255,255,255,.16); border-radius:6px; background:rgba(255,255,255,.05); font-size:.82rem; font-weight:700; }
    .faq-hero-stats strong { color:#57c9f2!important; }
    :global(.faq-hub-page .faq-search-bar) { position:sticky; top:66px; z-index:20; margin:0; padding:20px 0 14px; background:rgba(247,250,252,.96); border-bottom:1px solid #d6e3ed; backdrop-filter:blur(12px); }
    .faq-search-wrap { position:relative; max-width:860px; }
    :global(.faq-hub-page #faq-search-input) { width:100%; height:58px; padding:0 104px 0 52px; color:var(--faq-ink); border:1px solid #91b5cf; border-radius:8px; background:#fff; box-shadow:0 10px 30px rgba(7,31,58,.08); font:700 1rem var(--font-main); outline:none; }
    :global(.faq-hub-page #faq-search-input:focus) { border-color:var(--faq-blue); box-shadow:0 0 0 3px rgba(11,101,216,.15),0 10px 30px rgba(7,31,58,.08); }
    .faq-search-icon { position:absolute; left:18px; top:50%; z-index:1; transform:translateY(-50%); color:var(--faq-blue); font-size:1.1rem; }
    .faq-search-shortcut { position:absolute; right:18px; top:50%; transform:translateY(-50%); min-width:28px; padding:3px 7px; color:#59738a; border:1px solid #c8d7e3; border-radius:5px; background:#f3f7fa; text-align:center; font:800 .78rem var(--font-main); }
    .faq-search-clear { position:absolute; right:14px; top:50%; width:34px; height:34px; transform:translateY(-50%); display:grid; place-items:center; color:#405c74; border:0; border-radius:6px; background:#eaf1f6; cursor:pointer; }
    .faq-search-clear[hidden] { display:none; }
    .faq-search-wrap:has(.faq-search-clear:not([hidden])) .faq-search-shortcut { display:none; }
    .faq-search-meta { display:flex; justify-content:space-between; gap:12px; max-width:860px; margin-top:8px; color:#5a7186; font-size:.76rem; font-weight:700; }
    .faq-category-tabs { display:flex; gap:8px; margin-top:14px; padding-bottom:2px; overflow-x:auto; scrollbar-width:thin; }
    .faq-category-tab { flex:0 0 auto; min-height:36px; padding:0 13px; color:#2d4b64; border:1px solid #c6d7e4; border-radius:6px; background:#fff; font:800 .78rem var(--font-main); cursor:pointer; transition:background-color 160ms ease-out,color 160ms ease-out,border-color 160ms ease-out,transform 160ms ease-out; }
    .faq-category-tab.active { color:#fff; border-color:var(--faq-ink); background:var(--faq-ink); }
    .faq-category-tab:active { transform:scale(.97); }
    :global(.faq-hub-page .faq-page-content) { padding:clamp(50px,7vw,84px) 0; background:#f7fafc; }
    :global(.faq-hub-page .faq-category-block) { margin:0 0 52px; }
    :global(.faq-hub-page .faq-category-title) { display:grid; grid-template-columns:38px 1fr auto; align-items:center; gap:12px; margin:0 0 16px!important; padding-bottom:13px; color:var(--faq-ink); border-bottom:1px solid #bfd1df; font-family:var(--font-heading); font-size:clamp(1.35rem,3vw,2rem); }
    :global(.faq-hub-page .faq-category-title .tc-svg) { width:38px; height:38px; padding:10px; color:#fff; border-radius:7px; background:var(--faq-blue); }
    :global(.faq-hub-page .faq-category-title small) { color:#668096; font:800 .76rem var(--font-main); }
    :global(.faq-hub-page .faq-page-grid) { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
    :global(.faq-hub-page .faq-item) { align-self:start; overflow:hidden; border:1px solid #cad9e5; border-radius:8px; background:#fff; box-shadow:none; }
