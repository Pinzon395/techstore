---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="404 — Página no encontrada | Pixon PC"
  description="Página no encontrada — Pixon PC Cancún. Vuelve al inicio o contáctanos por WhatsApp."
  image="/LOGOCIRCULAR.png"
  robots="noindex, follow"
>
  <Navbar />
<main class="error-page" id="main-content">
        <div class="error-page__inner">
            <span class="error-emoji" role="img" aria-label="PC en problemas">🖥️</span>
            <div class="error-code" aria-hidden="true">404</div>
            <h1 class="error-title">Esta página se cayó del sistema</h1>
            <p class="error-subtitle">
                Como una PC sin pasta térmica... esto no está bien.<br>
                La página que buscas no existe o fue movida.<br>
                <strong>¿Te ayudamos a encontrar lo que necesitas?</strong>
            </p>
            <div class="error-actions">
                <a href="/" class="btn btn-primary" id="btn-404-inicio">
                    <i class="fa-solid fa-house"></i> Volver al Inicio
                </a>
                <button onclick="smartWaRedirect('https://wa.me/529986690777?text=Hola%2C%20no%20encontr%C3%A9%20lo%20que%20buscaba%20en%20la%20web')"
                    class="btn btn-outline" id="btn-404-whatsapp">
                    <i class="fa-brands fa-whatsapp"></i> Contactar por WhatsApp
                </button>
            </div>
        </div>
    </main>
  <Footer />


    <!-- ═══ Cookie Banner ═══ -->
</Base>

