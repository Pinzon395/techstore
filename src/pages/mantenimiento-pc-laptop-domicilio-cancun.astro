---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FaqSection from '../components/FaqSection.astro';
import ServiceTicketSection from '../components/ServiceTicketSection.astro';
import HomeVisitMaintenanceForm from '../components/HomeVisitMaintenanceForm.astro';
import { buildBreadcrumbSchema } from '../lib/schema';

const canonical = 'https://pixon.com.mx/mantenimiento-pc-laptop-domicilio-cancun';
const title = 'Mantenimiento PC y Laptop a Domicilio en Cancún | Pixon PC';
const description = 'Mantenimiento de PC y laptop a domicilio en Cancún mediante cita previa. Limpieza, temperaturas y pasta térmica. Zona Hotelera y otras zonas según disponibilidad.';

const whatsappMessage = `Hola Pixon PC. Quiero agendar mantenimiento de PC o laptop a domicilio en Cancún.

Equipo:
Marca/modelo:
Síntoma:
Zona:
Casa / oficina / hotel:
Horario aproximado:
¿Requiere cita en Zona Hotelera, Costa Mujeres o Playa Mujeres?:`;

const whatsappUrl = `https://wa.me/529986690777?text=${encodeURIComponent(whatsappMessage)}`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${canonical}#service`,
    name: 'Mantenimiento de PC y Laptop a Domicilio en Cancún',
    serviceType: 'Mantenimiento preventivo de computadoras y laptops a domicilio',
    description,
    url: canonical,
    provider: { '@id': 'https://pixon.com.mx/#business' },
    areaServed: [
      { '@type': 'City', name: 'Cancún' },
      { '@type': 'Place', name: 'Cancún Centro' },
      { '@type': 'Place', name: 'Zona Hotelera de Cancún' },
      { '@type': 'Place', name: 'Puerto Cancún' },
      { '@type': 'Place', name: 'Huayacán' },
      { '@type': 'Place', name: 'Cumbres' },
      { '@type': 'Place', name: 'Costa Mujeres' },
      { '@type': 'Place', name: 'Playa Mujeres' },
      { '@type': 'Place', name: 'Punta Sam' },
      { '@type': 'Place', name: 'Polígono Sur' },
      { '@type': 'Place', name: 'Bonfil' },
    ],
  },
  buildBreadcrumbSchema([
    { name: 'Inicio', url: '/' },
    { name: 'Servicios', url: '/servicios' },
    { name: 'Mantenimiento a domicilio', url: canonical },
  ]),
].filter(Boolean) as object[];

const faqs = [
  {
    question: '¿Dan mantenimiento de PC a domicilio en Cancún?',
    answer: 'Sí. Realizamos mantenimiento preventivo, limpieza interna, revisión de ventiladores y pasta térmica para computadoras de escritorio y PC gamer directamente en tu domicilio, oficina o departamento mediante cita previa y confirmación de viabilidad técnica en sitio.',
  },
  {
    question: '¿Atienden laptops a domicilio en Cancún?',
    answer: 'Sí. Atendemos laptops de trabajo, home office y laptops gamer en sitio para limpieza de ventiladores, disipadores y revisión térmica, siempre que el diseño del chasis y el desarmado permitan trabajar de forma segura fuera del laboratorio.',
  },
  {
    question: '¿Atienden Zona Hotelera de Cancún?',
    answer: 'Sí. Coordinamos visitas técnicas mediante cita previa en la Zona Hotelera (km 0 al km 25 de Blvd. Kukulcán) para huéspedes en hoteles, condominios, departamentos y oficinas, respetando las normas de acceso de cada propiedad.',
  },
  {
    question: '¿Pueden ir a mi hotel o resort?',
    answer: 'Sí. Evaluamos la atención para huéspedes y turistas en hoteles de Cancún, Zona Hotelera, Costa Mujeres y Playa Mujeres. La coordinación se realiza por WhatsApp con cita previa; no ingresamos a habitaciones sin autorización y acordamos el punto de recepción según las reglas del hotel.',
  },
  {
    question: '¿Atienden Costa Mujeres?',
    answer: 'Sí. Brindamos servicio en Costa Mujeres mediante cita previa y confirmación de disponibilidad para hoteles, condominios y personal corporativo de la zona.',
  },
  {
    question: '¿Atienden Playa Mujeres?',
    answer: 'Sí. Atendemos solicitudes en Playa Mujeres para laptops y computadoras en resorts, condominios y residenciales con cita previa confirmada.',
  },
  {
    question: '¿Atienden Punta Sam y zona norte de Cancún?',
    answer: 'Sí. Cubrimos Punta Sam, Puerto Juárez y corredores residenciales de la zona norte previa validación de agenda y tipo de servicio.',
  },
  {
    question: '¿Trabajan únicamente con cita previa?',
    answer: 'Sí. Todo nuestro servicio a domicilio se programa con cita previa para asegurar la asignación del técnico, las herramientas adecuadas para tu modelo y la confirmación de la zona antes de solicitar tu dirección exacta.',
  },
  {
    question: '¿Cómo agendo una visita a domicilio?',
    answer: 'Puedes llenar el formulario de esta página o escribirnos directamente por WhatsApp indicando qué equipo tienes (PC o laptop), marca/modelo, qué síntoma presenta y tu zona. Te confirmamos si es viable en sitio y acordamos día y horario.',
  },
  {
    question: '¿Necesitan mi dirección completa para cotizar?',
    answer: 'No. Para cotizar únicamente necesitamos saber el tipo de equipo, síntomas y tu zona general (ej. Cumbres, Zona Hotelera, Huayacán). La dirección exacta se solicita únicamente después de que confirmes que deseas agendar la cita.',
  },
  {
    question: '¿Cobran traslado según la zona?',
    answer: 'El costo del servicio incluye la intervención técnica y puede contemplar un cargo de traslado o viático según la distancia (por ejemplo en Zona Hotelera, Costa Mujeres o Playa Mujeres). Cualquier costo se informa de manera transparente antes de agendar.',
  },
  {
    question: '¿Pueden realizar el mantenimiento frente al cliente?',
    answer: 'Sí. Cuando el espacio y las condiciones del lugar lo permiten, el mantenimiento se realiza a la vista en tu casa u oficina, con orden, protección de la superficie y explicación de cada paso.',
  },
  {
    question: '¿Pueden recoger el equipo si requiere taller?',
    answer: 'Sí. Si al diagnosticar encontramos una falla compleja (como daño en placa madre, líquido, microsoldadura o desarmado que requiere maquinaria especial), te explicamos la situación y podemos coordinar la recolección segura a nuestro taller.',
  },
  {
    question: '¿Atienden PC gamer y laptop gamer?',
    answer: 'Sí. Atendemos mantenimiento de PC gamer (gabinetes, radiadores, AIO, ventiladores, pasta térmica) y laptops gamer (ASUS ROG/TUF, Lenovo Legion, MSI, Alienware, Acer Predator, HP Omen/Victus) con materiales térmicos de alto rendimiento.',
  },
  {
    question: '¿Cambian pasta térmica a domicilio?',
    answer: 'Sí, cuando la condición térmica del procesador o disipador lo requiere. Aplicamos compuestos térmicos de alta conductividad para CPU y GPU. En casos con metal líquido de fábrica o diseños especiales, confirmamos previamente el procedimiento.',
  },
  {
    question: '¿Cuánto cuesta el servicio a domicilio?',
    answer: 'El precio depende del tipo de computadora (laptop estándar, PC de oficina, PC gamer o workstation), la complejidad del desarmado, los materiales requeridos y la zona de visita. Escríbenos por WhatsApp con tu modelo para darte una cotización cerrada y sin sorpresas.',
  },
];
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  image="/assets/images/mantenimiento-pc-escritorio.webp"
  ogTitle={title}
  ogDescription={description}
  schema={schema}
  bodyClass="homevisit-page"
>
  <Navbar />

  <main>
    <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Servicios', href: '/servicios' }, { label: 'Mantenimiento a domicilio' }]} />

    <!-- ==================== 1. HERO ==================== -->
    <header class="homevisit-hero" aria-labelledby="homevisit-title">
      <div class="container homevisit-hero__grid">
        <div class="homevisit-hero__copy">
          <p class="homevisit-eyebrow">
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i> SERVICIO TÉCNICO A DOMICILIO · CANCÚN · CITA PREVIA
          </p>
          <h1 id="homevisit-title">Mantenimiento de PC y Laptop a Domicilio en Cancún</h1>
          <p class="homevisit-hero__lead">
            Vamos a tu casa, departamento, hotel u oficina para realizar mantenimiento de PC y laptop cuando el procedimiento puede hacerse de forma segura en sitio. Atención mediante cita previa en Cancún y zonas de cobertura.
          </p>
          <p class="homevisit-hero__support">
            Limpieza interna, ventilación, temperaturas y pasta térmica según el equipo.
          </p>
          <div class="homevisit-hero__actions">
            <a class="homevisit-btn homevisit-btn--primary" href="#solicitar-visita">
              <i class="fa-solid fa-calendar-check" aria-hidden="true"></i> Solicitar cita a domicilio
            </a>
            <a class="homevisit-btn homevisit-btn--whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-wa-link data-event-placement="homevisit-hero">
              <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Cotizar por WhatsApp
            </a>
          </div>
          <ul class="homevisit-hero__trust" aria-label="Garantías del servicio">
            <li><i class="fa-solid fa-check"></i> PC y Laptop</li>
            <li><i class="fa-solid fa-check"></i> Servicio por cita</li>
            <li><i class="fa-solid fa-check"></i> Zona Hotelera</li>
            <li><i class="fa-solid fa-check"></i> Cancún</li>
          </ul>
        </div>

        <div class="homevisit-hero__visual-container">
          <!-- Visual SVG Animation (No text inside) -->
          <figure class="homevisit-visual" aria-hidden="true">
            <svg viewBox="0 0 640 380" focusable="false" class="homevisit-story-svg">
              <defs>
                <linearGradient id="hv-card-bg" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#092543" />
                  <stop offset="60%" stop-color="#071b30" />
                  <stop offset="100%" stop-color="#051424" />
                </linearGradient>
                <linearGradient id="hv-pin-grad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#38bdf8" />
                  <stop offset="100%" stop-color="#0284c7" />
                </linearGradient>
                <linearGradient id="hv-house-grad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#0e3a63" />
                  <stop offset="100%" stop-color="#08233d" />
                </linearGradient>
                <linearGradient id="hv-screen-grad" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#d8f8fc" />
                  <stop offset="100%" stop-color="#7dd3fc" />
                </linearGradient>
                <linearGradient id="hv-pc-grad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#14426d" />
                  <stop offset="100%" stop-color="#081e33" />
                </linearGradient>
                <linearGradient id="hv-check-grad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#10b981" />
                  <stop offset="100%" stop-color="#047857" />
                </linearGradient>
                <linearGradient id="hv-sheen-grad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#ffffff" stop-opacity="0" />
                  <stop offset="50%" stop-color="#ffffff" stop-opacity="0.35" />
                  <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
                </linearGradient>

                <filter id="hv-shadow" x="-20%" y="-20%" width="140%" height="140%">
                  <feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#010e1a" flood-opacity="0.5" />
                </filter>
                <filter id="hv-glow-cyan" x="-30%" y="-30%" width="160%" height="160%">
                  <feDropShadow dx="0" dy="0" stdDeviation="6" flood-color="#38bdf8" flood-opacity="0.9" />
                </filter>
                <filter id="hv-glow-green" x="-30%" y="-30%" width="160%" height="160%">
                  <feDropShadow dx="0" dy="0" stdDeviation="8" flood-color="#10b981" flood-opacity="0.95" />
                </filter>
                <filter id="hv-door-glow" x="-40%" y="-40%" width="180%" height="180%">
                  <feDropShadow dx="0" dy="0" stdDeviation="10" flood-color="#38bdf8" flood-opacity="0.8" />
                </filter>
              </defs>

              <!-- Main Canvas Frame -->
              <rect class="hv-canvas" x="8" y="8" width="624" height="364" rx="20" fill="url(#hv-card-bg)" stroke="#1e4e79" stroke-width="1.5" stroke-opacity="0.65" />

              <!-- Subtle Radial Depth Glow behind customer home -->
              <ellipse cx="485" cy="200" rx="140" ry="120" fill="#0c3254" opacity="0.35" />

              <!-- Background Technical Grid Lines -->
              <g class="hv-grid-decor" opacity="0.16">
                <line x1="8" y1="285" x2="632" y2="285" stroke="#38bdf8" stroke-width="1" />
                <line x1="8" y1="120" x2="632" y2="120" stroke="#38bdf8" stroke-width="0.75" stroke-dasharray="6 8" />
                <line x1="8" y1="190" x2="632" y2="190" stroke="#38bdf8" stroke-width="0.75" stroke-dasharray="6 8" />
              </g>

              <!-- Travel Pathway Curve (From Pixon Hub to Customer Home) -->
              <path class="hv-path-base" d="M 85 282 Q 220 305 355 282 T 475 282" fill="none" stroke="#0e3d66" stroke-width="7" stroke-linecap="round" />
              <path class="hv-path-trail" d="M 85 282 Q 220 305 355 282 T 475 282" fill="none" stroke="url(#hv-pin-grad)" stroke-width="3.5" stroke-linecap="round" pathLength="100" />

              <!-- STAGE 1: Pixon PC Origin Hub (Left) -->
              <g class="hv-origin-hub">
                <!-- Single Clean Pulse Ring at start -->
                <circle class="hv-pulse-ring" cx="80" cy="250" r="22" fill="none" stroke="#38bdf8" stroke-width="2" />
                <!-- Ground Base Shadow -->
                <ellipse cx="80" cy="282" rx="34" ry="9" fill="#041221" />
                <ellipse cx="80" cy="280" rx="24" ry="6" fill="#0d426d" />
                <!-- Pixon Landmark Pin -->
                <g class="hv-pin-marker" filter="url(#hv-shadow)">
                  <path d="M 80 200 C 64 200 51 213 51 229 C 51 251 80 274 80 274 C 80 274 109 251 109 229 C 109 213 96 200 80 200 Z" fill="url(#hv-pin-grad)" />
                  <circle cx="80" cy="227" r="11" fill="#ffffff" />
                  <!-- Pixon Tech Emblem -->
                  <path d="M 75 224 L 85 224 M 80 219 L 80 229 M 76 233 L 84 233" stroke="#0284c7" stroke-width="2.2" stroke-linecap="round" />
                </g>
              </g>

              <!-- STAGE 2: Customer Home Architecture (Right) -->
              <g class="hv-destination-home" filter="url(#hv-shadow)">
                <!-- Architectural House Contour -->
                <path d="M 370 95 L 505 35 L 610 82 V 282 H 370 Z" fill="url(#hv-house-grad)" stroke="#1d5485" stroke-width="1.5" />
                <path d="M 360 98 L 505 32 L 620 85" fill="none" stroke="#38bdf8" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                
                <!-- Modern Interior Window -->
                <rect x="415" y="75" width="65" height="42" rx="4" fill="#0c2e4f" stroke="#1d5485" stroke-width="1" />
                <line x1="447" y1="75" x2="447" y2="117" stroke="#1d5485" stroke-width="1" />
                <line x1="415" y1="96" x2="480" y2="96" stroke="#1d5485" stroke-width="1" />

                <!-- Entrance Door with Arrival Glow -->
                <g class="hv-door-entrance">
                  <rect x="376" y="210" width="22" height="72" rx="2" fill="#08233f" stroke="#22d3ee" stroke-width="1.2" />
                  <rect class="hv-door-light" x="378" y="212" width="18" height="68" rx="1" fill="#38bdf8" opacity="0" filter="url(#hv-door-glow)" />
                </g>

                <!-- Modern Workstation Desk -->
                <rect x="400" y="232" width="200" height="9" rx="3" fill="#1b4d79" stroke="#38bdf8" stroke-width="1" />
                <rect x="410" y="241" width="6" height="41" rx="2" fill="#0c2c4a" />
                <rect x="585" y="241" width="6" height="41" rx="2" fill="#0c2c4a" />
              </g>

              <!-- STAGE 3: Workstation Equipment (PC Tower + Laptop) with Focus Zoom -->
              <g class="hv-workstation" filter="url(#hv-shadow)">
                <!-- Modern PC Gamer Tower -->
                <g class="hv-pc-tower">
                  <!-- Chassis -->
                  <rect x="515" y="130" width="82" height="102" rx="8" fill="url(#hv-pc-grad)" stroke="#22d3ee" stroke-width="1.5" stroke-opacity="0.85" />
                  <!-- Tempered Glass Panel -->
                  <rect x="523" y="140" width="66" height="82" rx="4" fill="#05192c" stroke="#174b77" stroke-width="1" />
                  <!-- Motherboard & Heatsink Thermal block -->
                  <rect class="hv-heatsink-block" x="528" y="146" width="30" height="30" rx="3" fill="#0c3254" stroke="#f59e0b" stroke-width="1" />
                  
                  <!-- CPU Cooler Fan with spinning blades -->
                  <circle class="hv-fan-ring" cx="543" cy="161" r="10" fill="#061c30" stroke="#38bdf8" stroke-width="1.5" />
                  <g class="hv-fan-blades hv-fan-blades--cpu">
                    <line x1="543" y1="153" x2="543" y2="169" stroke="#38bdf8" stroke-width="1.8" stroke-linecap="round" />
                    <line x1="535" y1="161" x2="551" y2="161" stroke="#38bdf8" stroke-width="1.8" stroke-linecap="round" />
                  </g>

                  <!-- GPU Bracket -->
                  <rect x="528" y="188" width="56" height="14" rx="3" fill="#0f3d66" stroke="#38bdf8" stroke-width="1" />
                  
                  <!-- Front Dual RGB Cooling Fans -->
                  <circle class="hv-fan-ring" cx="578" cy="158" r="9" fill="#07223b" stroke="#38bdf8" stroke-width="1.2" />
                  <circle class="hv-fan-ring" cx="578" cy="192" r="9" fill="#07223b" stroke="#38bdf8" stroke-width="1.2" />
                  <g class="hv-fan-blades hv-fan-blades--front1">
                    <line x1="578" y1="151" x2="578" y2="165" stroke="#38bdf8" stroke-width="1.6" stroke-linecap="round" />
                    <line x1="571" y1="158" x2="585" y2="158" stroke="#38bdf8" stroke-width="1.6" stroke-linecap="round" />
                  </g>
                  <g class="hv-fan-blades hv-fan-blades--front2">
                    <line x1="578" y1="185" x2="578" y2="199" stroke="#38bdf8" stroke-width="1.6" stroke-linecap="round" />
                    <line x1="571" y1="192" x2="585" y2="192" stroke="#38bdf8" stroke-width="1.6" stroke-linecap="round" />
                  </g>

                  <!-- Power LED -->
                  <circle class="hv-pc-power-led" cx="585" cy="136" r="2" fill="#38bdf8" />
                </g>

                <!-- Laptop Setup -->
                <g class="hv-laptop">
                  <!-- Base / Keyboard -->
                  <path d="M 405 232 L 485 232 L 480 224 L 410 224 Z" fill="#0d3558" stroke="#1d588a" stroke-width="1" />
                  <!-- Screen Lid -->
                  <rect x="412" y="162" width="68" height="62" rx="4" fill="#07233d" stroke="#22d3ee" stroke-width="1.3" />
                  <!-- Screen Display Area -->
                  <rect class="hv-laptop-screen" x="417" y="167" width="58" height="47" rx="2" fill="url(#hv-screen-grad)" />
                  <!-- Diagnostic Waveform on Screen -->
                  <path class="hv-screen-waveform" d="M 420 190 L 428 190 L 433 180 L 439 198 L 444 186 L 450 190 L 472 190" fill="none" stroke="#0369a1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </g>

                <!-- Cleaning Light Sheen Sweep across PC & Laptop -->
                <rect class="hv-sheen-sweep" x="390" y="125" width="220" height="115" rx="6" fill="url(#hv-sheen-grad)" opacity="0" />
              </g>

              <!-- STAGE 4: PROMINENT ENLARGED TECHNICIAN (~125px tall, geometric tech style) -->
              <g class="hv-technician-actor">
                <!-- Ground Shadow following tech -->
                <ellipse class="hv-tech-shadow" cx="0" cy="0" rx="34" ry="7" fill="#010d18" opacity="0.7" />
                
                <!-- Bobbing Body Container -->
                <g class="hv-tech-body">
                  <!-- Left Arm (moves opposite to left leg) -->
                  <g class="hv-arm hv-arm--left">
                    <line x1="-13" y1="-68" x2="-23" y2="-44" stroke="#0369a1" stroke-width="7" stroke-linecap="round" />
                  </g>

                  <!-- Left Leg (Scissor Walk) -->
                  <g class="hv-leg hv-leg--left">
                    <line x1="-9" y1="-32" x2="-13" y2="-6" stroke="#082f49" stroke-width="8" stroke-linecap="round" />
                    <path d="M -18 -6 L -3 -6" stroke="#0284c7" stroke-width="5" stroke-linecap="round" />
                  </g>

                  <!-- Right Leg (Scissor Walk) -->
                  <g class="hv-leg hv-leg--right">
                    <line x1="9" y1="-32" x2="13" y2="-6" stroke="#0c4a6e" stroke-width="8" stroke-linecap="round" />
                    <path d="M 9 -6 L 24 -6" stroke="#38bdf8" stroke-width="5" stroke-linecap="round" />
                  </g>

                  <!-- Torso / Tech Uniform Shirt & Vest -->
                  <path d="M -16 -70 C -16 -75 -6 -78 0 -78 C 6 -78 16 -75 16 -70 L 14 -32 L -14 -32 Z" fill="#0284c7" stroke="#0369a1" stroke-width="1.5" />
                  <!-- Tech Vest Detail & Belt -->
                  <path d="M -9 -70 L 0 -50 L 9 -70" fill="none" stroke="#38bdf8" stroke-width="2.4" />
                  <rect x="-14" y="-34" width="28" height="5" rx="1.5" fill="#0c3254" />

                  <!-- Head with Cap Visor -->
                  <circle cx="0" cy="-92" r="16" fill="#fed7aa" />
                  <path d="M -14 -97 C -14 -107 10 -107 15 -97 L 22 -92 L 14 -90 Z" fill="#0369a1" />

                  <!-- Right Arm holding Toolkit Briefcase -->
                  <g class="hv-arm hv-arm--right">
                    <line x1="13" y1="-68" x2="23" y2="-46" stroke="#0284c7" stroke-width="7" stroke-linecap="round" />
                    
                    <!-- Technician Toolkit Briefcase -->
                    <g class="hv-tech-kit" transform="translate(18, -48)">
                      <rect x="0" y="0" width="30" height="21" rx="4" fill="#f59e0b" stroke="#b45309" stroke-width="1.8" />
                      <path d="M 8 0 V -6 C 8 -8 11 -10 15 -10 C 19 -10 22 -8 22 -6 V 0" fill="none" stroke="#b45309" stroke-width="2.5" />
                      <line x1="0" y1="10" x2="30" y2="10" stroke="#b45309" stroke-width="1.4" />
                      <rect x="12" y="8" width="6" height="5" rx="1" fill="#fef08a" />
                    </g>
                  </g>
                </g>
              </g>

              <!-- STAGE 5: Cleaning Particles & Airflow Streams -->
              <g class="hv-cleaning-effects">
                <!-- 12 Fine Dust Particles blowing away -->
                <g class="hv-dust-particles" fill="#f59e0b">
                  <circle class="hv-dust-fleck" cx="548" cy="165" r="2.5" />
                  <circle class="hv-dust-fleck" cx="562" cy="178" r="2" />
                  <circle class="hv-dust-fleck" cx="540" cy="195" r="2.5" />
                  <circle class="hv-dust-fleck" cx="528" cy="170" r="1.5" />
                  <circle class="hv-dust-fleck" cx="572" cy="155" r="2" />
                  <circle class="hv-dust-fleck" cx="582" cy="190" r="1.8" />
                  <circle class="hv-dust-fleck" cx="440" cy="205" r="2.2" />
                  <circle class="hv-dust-fleck" cx="456" cy="216" r="1.8" />
