<style>
  .homevisit-page {
    --homevisit-navy: #071F3A;
    --homevisit-cyan: #0b8eac;
    --homevisit-pale: #eaf7fb;
    --homevisit-line: #cce7ee;
    background: #fff;
    color: var(--homevisit-navy);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }
  .homevisit-page main { overflow: clip; background: #fff; }
  .homevisit-page :global(.breadcrumb-container) { margin-top: 0; }

  /* Hero */
  .homevisit-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(42px, 6vw, 76px) 0 clamp(48px, 7vw, 92px);
    background: radial-gradient(circle at 82% 18%, rgba(35, 184, 207, .22), transparent 27%), linear-gradient(135deg, #061d37 0%, #08294a 60%, #0b3d5b 100%);
    color: #fff;
  }
  .homevisit-hero::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: '';
    opacity: .18;
    background-image: linear-gradient(rgba(118, 223, 240, .18) 1px, transparent 1px), linear-gradient(90deg, rgba(118, 223, 240, .18) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(to right, #000, transparent 70%);
  }
  .homevisit-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(300px, .82fr);
    align-items: center;
    gap: clamp(28px, 5vw, 76px);
  }
  .homevisit-hero__copy { max-width: 690px; }
  .homevisit-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
    color: #96e9f4;
    font-size: .78rem;
    font-weight: 900;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .homevisit-hero h1 {
    max-width: 720px;
    margin: 0;
    color: #fff;
    font-family: 'Kanit', sans-serif;
    font-size: clamp(2.18rem, 4.25vw, 3.85rem);
    font-weight: 800;
    letter-spacing: -.025em;
    line-height: 1.01;
    text-wrap: balance;
  }
  .homevisit-hero__lead {
    max-width: 650px;
    margin: 20px 0 0;
    color: #f3fbff;
    font-size: clamp(1rem, 1.5vw, 1.17rem);
    line-height: 1.68;
  }
  .homevisit-hero__support {
    max-width: 610px;
    margin: 10px 0 0;
    color: #b7eaf2;
    font-size: .98rem;
    line-height: 1.6;
  }
  .homevisit-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .homevisit-btn {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 12px 18px;
    font-weight: 900;
    line-height: 1.15;
    text-align: center;
    text-decoration: none;
    transition: transform 160ms cubic-bezier(.23, 1, .32, 1), box-shadow 160ms cubic-bezier(.23, 1, .32, 1), background 160ms ease;
  }
  .homevisit-btn--primary {
    background: #67d9e9;
    color: #041a32;
    box-shadow: 0 12px 25px rgba(65, 206, 226, .22);
  }
  .homevisit-btn--whatsapp {
    border-color: rgba(255,255,255,.35);
    background: rgba(255,255,255,.09);
    color: #fff;
  }
  @media (hover: hover) and (pointer: fine) {
    .homevisit-btn:hover { transform: translateY(-2px); }
    .homevisit-btn--primary:hover { background: #96edf7; box-shadow: 0 15px 30px rgba(65, 206, 226, .31); }
    .homevisit-btn--whatsapp:hover { background: rgba(255,255,255,.16); }
  }
  .homevisit-btn:active { transform: scale(.985); }
  .homevisit-btn:focus-visible, .homevisit-page a:focus-visible { outline: 3px solid #f59e0b; outline-offset: 3px; }
  .homevisit-hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .homevisit-hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid rgba(169, 237, 247, .25);
    border-radius: 999px;
    padding: 6px 12px;
    color: #d8f8fc;
    font-size: .78rem;
    font-weight: 800;
  }
