  /* Hero Visual & Narrative Animation */
  .homevisit-hero__visual-container {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    max-width: 630px;
    margin: 0 auto;
  }
  .homevisit-visual {
    width: 100%;
    margin: 0;
  }
  .homevisit-visual svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 14px 28px rgba(3, 14, 26, 0.45));
  }

  /* SVG Animation Elements (13-second loop) */
  .hv-pulse-ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: hv-pulse-fx 13s cubic-bezier(0.2, 0.8, 0.25, 1) infinite;
  }
  .hv-pin-marker {
    transform-box: fill-box;
    transform-origin: center bottom;
    animation: hv-pin-fx 13s cubic-bezier(0.22, 0.8, 0.28, 1) infinite;
  }
  .hv-path-trail {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: hv-path-fx 13s ease-in-out infinite;
  }

  /* Prominent Technician Actor (2.2x scale) */
  .hv-technician-actor {
    animation: hv-tech-travel 13s cubic-bezier(0.35, 0.05, 0.2, 1) infinite;
  }
  .hv-tech-body {
    animation: hv-tech-bob 0.48s ease-in-out infinite alternate;
  }
  .hv-leg--left {
    transform-box: fill-box;
    transform-origin: top center;
    animation: hv-leg-left-cycle 0.48s ease-in-out infinite alternate;
  }
  .hv-leg--right {
    transform-box: fill-box;
    transform-origin: top center;
    animation: hv-leg-right-cycle 0.48s ease-in-out infinite alternate;
  }
  .hv-arm--left {
    transform-box: fill-box;
    transform-origin: top center;
    animation: hv-arm-left-cycle 0.48s ease-in-out infinite alternate;
  }
  .hv-arm--right {
    transform-box: fill-box;
    transform-origin: top center;
    animation: hv-arm-right-cycle 0.48s ease-in-out infinite alternate;
  }
  .hv-tech-kit {
    transform-box: fill-box;
    transform-origin: top center;
    animation: hv-kit-sway 0.48s ease-in-out infinite alternate;
  }

  /* House Door Entrance Glow */
  .hv-door-light {
    animation: hv-door-glow-fx 13s ease-in-out infinite;
  }

  /* Workstation Focus Zoom */
  .hv-workstation {
    transform-box: fill-box;
    transform-origin: center;
    animation: hv-workstation-focus 13s cubic-bezier(0.3, 0.05, 0.2, 1) infinite;
  }
  .hv-heatsink-block {
    animation: hv-thermal-fx 13s ease-in-out infinite;
  }
  .hv-fan-blades {
    transform-box: fill-box;
    transform-origin: center;
    animation: hv-fans-spin 13s linear infinite;
  }
  .hv-laptop-screen {
    animation: hv-screen-pulse 13s ease-in-out infinite;
  }

  /* Cleaning Phase: Dust & Airflow */
  .hv-dust-particles {
    animation: hv-dust-dissipate 13s cubic-bezier(0.2, 0.7, 0.3, 1) infinite;
  }
  .hv-air-stream {
    stroke-dasharray: 40 80;
    stroke-dashoffset: 120;
    animation: hv-airflow-fx 13s linear infinite;
  }
  .hv-air-stream--2 { animation-delay: 90ms; }
  .hv-air-stream--3 { animation-delay: 180ms; }
  .hv-air-stream--4 { animation-delay: 140ms; }

  /* Sheen Sweep & Sparkles & Ready Check */
  .hv-sheen-sweep {
    animation: hv-sheen-fx 13s ease-in-out infinite;
  }
  .hv-gleam {
    transform-box: fill-box;
    transform-origin: center;
    animation: hv-gleam-fx 13s ease-in-out infinite;
  }
  .hv-gleam--2 { animation-delay: 140ms; }
  .hv-success-badge {
    transform-box: fill-box;
    transform-origin: center;
    animation: hv-check-pop 13s cubic-bezier(0.18, 0.9, 0.32, 1.25) infinite;
  }

  /* ==================== KEYFRAME DEFINITIONS ==================== */
  /* Stage 1: Pixon Pin & Pulse */
  @keyframes hv-pulse-fx {
    0%, 2% { opacity: 0; transform: scale(0.6); }
    5% { opacity: 0.9; transform: scale(1.35); }
    8%, 100% { opacity: 0; transform: scale(1.6); }
  }

  @keyframes hv-pin-fx {
    0% { opacity: 0; transform: translateY(-8px) scale(0.9); }
    6%, 35% { opacity: 1; transform: translateY(0) scale(1); }
    40%, 100% { opacity: 0.75; transform: translateY(0) scale(0.95); }
  }

  /* Stage 2: Route Trail Draws (8% - 15%) */
  @keyframes hv-path-fx {
    0%, 7% { stroke-dashoffset: 100; opacity: 0; }
    8% { opacity: 0.95; }
    15%, 45% { stroke-dashoffset: 0; opacity: 0.85; }
    50%, 94% { stroke-dashoffset: 0; opacity: 0.45; }
    98%, 100% { stroke-dashoffset: -100; opacity: 0; }
  }

  /* Stage 3: Technician Walks (15% - 38%), Arrives (38% - 43%), Enters Home (43% - 48%) */
  @keyframes hv-tech-travel {
    0%, 14% { opacity: 0; transform: translate(75px, 280px); }
    15% { opacity: 1; transform: translate(75px, 280px); }
    38%, 43% { opacity: 1; transform: translate(360px, 280px); }
    48% { opacity: 0; transform: translate(378px, 280px) scale(0.92); }
    100% { opacity: 0; transform: translate(378px, 280px); }
  }

  @keyframes hv-tech-bob {
    0% { transform: translateY(0); }
    100% { transform: translateY(-3px); }
  }

  @keyframes hv-leg-left-cycle {
    0% { transform: rotate(16deg); }
    100% { transform: rotate(-16deg); }
  }

  @keyframes hv-leg-right-cycle {
    0% { transform: rotate(-16deg); }
    100% { transform: rotate(16deg); }
  }

  @keyframes hv-arm-left-cycle {
    0% { transform: rotate(-14deg); }
    100% { transform: rotate(14deg); }
  }

  @keyframes hv-arm-right-cycle {
    0% { transform: rotate(14deg); }
    100% { transform: rotate(-14deg); }
  }

  @keyframes hv-kit-sway {
    0% { transform: rotate(-5deg); }
    100% { transform: rotate(5deg); }
  }

  @keyframes hv-door-glow-fx {
    0%, 37% { opacity: 0; }
    40%, 46% { opacity: 0.95; }
    50%, 100% { opacity: 0; }
  }

  /* Stage 4: Workstation Focus Zoom (48% - 94%) */
  @keyframes hv-workstation-focus {
    0%, 46% { transform: translate(0, 0) scale(1); }
    52%, 92% { transform: translate(-18px, -4px) scale(1.08); }
    97%, 100% { transform: translate(0, 0) scale(1); }
  }

  @keyframes hv-thermal-fx {
    0%, 52% { stroke: #f59e0b; }
    55%, 72% { stroke: #f59e0b; }
    76%, 92% { stroke: #38bdf8; }
    96%, 100% { stroke: #f59e0b; }
  }

  /* Stage 5: Fans Spin & Dust Clears (55% - 74%) */
  @keyframes hv-fans-spin {
    0%, 52% { transform: rotate(0deg); }
    55% { transform: rotate(90deg); }
    74% { transform: rotate(2160deg); }
    88%, 94% { transform: rotate(2700deg); }
    98%, 100% { transform: rotate(2880deg); }
  }

  @keyframes hv-screen-pulse {
    0%, 44% { opacity: 0.4; }
    50%, 92% { opacity: 1; }
    96%, 100% { opacity: 0.4; }
  }

  @keyframes hv-dust-dissipate {
    0%, 53% { opacity: 0.95; transform: translate(0, 0) scale(1); }
    62% { opacity: 0.8; transform: translate(22px, -14px) scale(0.9); }
    70% { opacity: 0.25; transform: translate(52px, -30px) scale(0.45); }
    74%, 100% { opacity: 0; transform: translate(70px, -40px) scale(0); }
  }

  @keyframes hv-airflow-fx {
    0%, 53% { opacity: 0; stroke-dashoffset: 120; }
    57% { opacity: 0.95; }
    76% { opacity: 0.95; stroke-dashoffset: -120; }
    82%, 100% { opacity: 0; stroke-dashoffset: -160; }
  }

  /* Stage 6: Sheen Sweep (82% - 90%) & Sparkles & Ready Check (90% - 96%) */
  @keyframes hv-sheen-fx {
    0%, 81% { opacity: 0; transform: translateX(-140px) skewX(-20deg); }
    83% { opacity: 0.75; }
    88% { opacity: 0.75; transform: translateX(120px) skewX(-20deg); }
    90%, 100% { opacity: 0; transform: translateX(140px) skewX(-20deg); }
  }

  @keyframes hv-gleam-fx {
    0%, 84% { opacity: 0; transform: scale(0.2); }
    87%, 93% { opacity: 1; transform: scale(1.25) rotate(15deg); }
    96%, 100% { opacity: 0; transform: scale(0.2); }
  }

  @keyframes hv-check-pop {
    0%, 88% { opacity: 0; transform: translateY(10px) scale(0.4); }
    91% { opacity: 1; transform: translateY(-4px) scale(1.15); }
    93%, 96% { opacity: 1; transform: translateY(0) scale(1); }
    99%, 100% { opacity: 0; transform: translateY(-4px) scale(0.8); }
  }

  /* ==================== UNIFIED PROCESS TIMELINE (VERTICAL LIST) ==================== */
  .service-process {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 13px;
    margin: 8px 0 0;
    padding: 18px 18px 16px;
    list-style: none;
    background: rgba(6, 26, 48, 0.68);
    border: 1px solid rgba(56, 189, 248, 0.22);
    border-radius: 16px;
    backdrop-filter: blur(10px);
  }

  /* Connecting Background Track Line (Vertical on Left) */
  .service-process::before {
    position: absolute;
    top: 24px;
    bottom: 24px;
    left: 24px;
    width: 3px;
    content: '';
    background: rgba(14, 61, 102, 0.85);
    border-radius: 2px;
    z-index: 1;
  }

  /* Connecting Active Animated Progress Line (Vertical on Left) */
  .service-process::after {
    position: absolute;
    top: 24px;
    bottom: 24px;
    left: 24px;
    width: 3px;
    content: '';
    background: linear-gradient(180deg, #38bdf8, #22d3ee, #10b981);
    border-radius: 2px;
    z-index: 1;
    transform-origin: top;
    animation: hv-line-progress-vert 13s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  /* Step Row Items */
  .process-step {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 14px;
    text-align: left;
    opacity: 0.55;
    transform: translateX(0);
    transition: opacity 250ms ease, transform 250ms ease;
  }

  .process-step__indicator {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 9px;
    margin-bottom: 0;
    flex-shrink: 0;
  }

  /* Dot on the track line */
  .process-step__dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #092644;
    border: 2.5px solid #1a517e;
    box-shadow: 0 0 0 3px rgba(6, 26, 48, 0.9);
    margin-top: 2px;
    transition: background 250ms ease, border-color 250ms ease, box-shadow 250ms ease;
  }

  .process-step__num {
    color: #7dd3fc;
    font-family: monospace;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    min-width: 20px;
    margin-top: 1px;
  }

  .process-step__info {
    min-width: 0;
    flex: 1;
  }

  .process-step__info strong {
    display: block;
    color: #ffffff;
    font-family: 'Kanit', sans-serif;
    font-size: 0.9rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .process-step__info p {
    margin: 2px 0 0;
    color: #cbe9f4;
    font-size: 0.78rem;
    line-height: 1.35;
  }

  /* Timeline Synchronized Keyframes (13-second loop) */
  @keyframes hv-line-progress-vert {
    0%, 8% { transform: scaleY(0); }
    15%, 43% { transform: scaleY(0.33); }
    48%, 80% { transform: scaleY(0.66); }
    85%, 96% { transform: scaleY(1); }
    98%, 100% { transform: scaleY(0); }
  }

  .process-step--1 { animation: hv-step1-sync 13s ease-in-out infinite; }
  .process-step--2 { animation: hv-step2-sync 13s ease-in-out infinite; }
  .process-step--3 { animation: hv-step3-sync 13s ease-in-out infinite; }
  .process-step--4 { animation: hv-step4-sync 13s ease-in-out infinite; }

  @keyframes hv-step1-sync {
    0%, 14% { opacity: 1; transform: translateX(2px); }
    16%, 96% { opacity: 0.55; transform: translateX(0); }
    98%, 100% { opacity: 1; transform: translateX(2px); }
  }

  @keyframes hv-step2-sync {
    0%, 14% { opacity: 0.55; transform: translateX(0); }
    16%, 46% { opacity: 1; transform: translateX(2px); }
    48%, 100% { opacity: 0.55; transform: translateX(0); }
  }

  @keyframes hv-step3-sync {
    0%, 46% { opacity: 0.55; transform: translateX(0); }
    48%, 82% { opacity: 1; transform: translateX(2px); }
    84%, 100% { opacity: 0.55; transform: translateX(0); }
  }

  @keyframes hv-step4-sync {
    0%, 82% { opacity: 0.55; transform: translateX(0); }
    84%, 96% { opacity: 1; transform: translateX(2px); }
    98%, 100% { opacity: 0.55; transform: translateX(0); }
  }

  /* Common Sections */
  .homevisit-section {
    padding: clamp(54px, 7vw, 88px) 0;
    background: #fff;
    color: #071F3A;
  }
  .homevisit-section--soft { background: #eef9fb; }
  .homevisit-section--navy { background: #071F3A; color: #fff; }

  .homevisit-heading { max-width: 820px; }
  .homevisit-heading--center { margin-right: auto; margin-left: auto; text-align: center; }
  .homevisit-kicker {
    display: inline-block;
    color: #08799a;
    font-size: .76rem;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .homevisit-heading--light .homevisit-kicker { color: #77e1ef; }

  .homevisit-heading h2 {
    margin: 0;
    color: #071F3A;
    font-family: 'Kanit', sans-serif;
    font-size: clamp(1.84rem, 3.5vw, 2.95rem);
    font-weight: 800;
    letter-spacing: -.02em;
    line-height: 1.1;
    text-wrap: balance;
  }
  .homevisit-heading--light h2 { color: #fff; }

  .homevisit-heading p:not(.homevisit-kicker) {
    margin: 14px 0 0;
    color: #071F3A;
    font-size: 1.02rem;
    line-height: 1.7;
  }
  .homevisit-heading--light p:not(.homevisit-kicker) { color: #d7f5f9; }

  .homevisit-split {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    align-items: start;
    gap: clamp(28px, 5vw, 76px);
  }

  /* Card Grids */
  .homevisit-card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(26px, 4vw, 40px);
  }
  .homevisit-card-grid article {
    border: 1px solid #d2e8ee;
    border-radius: 16px;
    padding: 22px;
    background: #fff;
    box-shadow: 0 9px 22px rgba(7,31,58,.04);
    display: flex;
    flex-direction: column;
    transition: transform 180ms cubic-bezier(.23, 1, .32, 1), box-shadow 180ms cubic-bezier(.23, 1, .32, 1), border-color 180ms ease;
  }
  .homevisit-card-grid article > i {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: 10px;
    background: #d9f4f8;
    color: #087d99;
    font-size: 1.05rem;
    margin-bottom: 12px;
  }
  .homevisit-card-grid h3 {
    margin: 0 0 8px;
    color: #071F3A;
    font-family: 'Kanit', sans-serif;
    font-size: 1.15rem;
    line-height: 1.25;
  }
  .homevisit-card-grid p {
    margin: 0;
    color: #071F3A;
    font-size: .92rem;
    line-height: 1.6;
    flex-grow: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .homevisit-card-grid article:hover {
      border-color: #91d6e3;
      box-shadow: 0 15px 28px rgba(7,31,58,.09);
      transform: translateY(-3px);
    }
  }

  .homevisit-card-grid--four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  /* Sublevel H4s */
  .homevisit-sublevels {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px dashed #cfe5eb;
    display: grid;
    gap: 10px;
  }
  .homevisit-sublevels h4 {
    margin: 0 0 3px;
    color: #08799a;
    font-size: 0.84rem;
    font-weight: 850;
    line-height: 1.3;
  }
  .homevisit-sublevels p {
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .homevisit-sublevels-box {
    margin-top: 24px;
    padding: 20px 24px;
    background: #f0fafc;
    border: 1px solid #cbe9ef;
    border-radius: 14px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .homevisit-sublevels-box h4 {
    margin: 0 0 6px;
    color: #08799a;
    font-size: 0.94rem;
    font-weight: 850;
  }
  .homevisit-sublevels-box p {
    margin: 0;
    font-size: 0.88rem;
    color: #071F3A;
    line-height: 1.5;
  }

  .homevisit-inline-link {
    margin: 24px 0 0;
    text-align: center;
  }
  .homevisit-inline-link a, .homevisit-text-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #075b85;
    font-size: .94rem;
    font-weight: 900;
    text-decoration: none;
  }
  .homevisit-inline-link a:hover, .homevisit-text-cta:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* Signal Grid */
  .homevisit-signal-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-top: 34px;
    border: 1px solid rgba(137,228,241,.26);
    background: rgba(137,228,241,.22);
    border-radius: 14px;
    overflow: hidden;
  }
  .homevisit-signal-grid article {
    padding: 22px;
    background: rgba(255,255,255,.05);
  }
  .homevisit-signal-grid h3 {
    margin: 0 0 8px;
    color: #fff;
    font-family: 'Kanit', sans-serif;
    font-size: 1.08rem;
  }
  .homevisit-signal-grid p {
    margin: 0;
    color: #d7f5f9;
    font-size: .88rem;
    line-height: 1.55;
  }
  .homevisit-signal-grid__wide {
    grid-column: 1 / -1;
    background: rgba(7, 31, 58, 0.6) !important;
    border-top: 1px solid rgba(137, 228, 241, 0.3);
  }

  /* Compare Box */
  .homevisit-compare { display: grid; gap: 16px; }
  .homevisit-compare article {
    border: 1px solid #c8e5ed;
    border-radius: 16px;
    padding: 22px;
    background: #f9feff;
    box-shadow: 0 8px 20px rgba(7,31,58,.04);
  }
  .homevisit-compare article:nth-child(2) {
    border-color: #b6d3e2;
    background: #eaf4f8;
  }
  .homevisit-compare h3, .homevisit-compare span {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 9px;
    color: #071F3A;
    font-size: 1.05rem;
    font-weight: 900;
    font-family: 'Kanit', sans-serif;
  }
  .homevisit-compare h3 i, .homevisit-compare span i { color: #0785a1; }
  .homevisit-compare ul {
    display: grid;
    gap: 8px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }
  .homevisit-compare li {
    position: relative;
    padding-left: 19px;
    color: #071F3A;
    font-size: .9rem;
    line-height: 1.5;
  }
  .homevisit-compare li::before {
    position: absolute;
    top: .55em;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #13a1bc;
    content: '';
  }

  /* Factor List */
  .homevisit-factor-list { display: grid; gap: 14px; }
  .homevisit-factor-list article {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 14px;
    align-items: start;
    border-bottom: 1px solid #cfe5eb;
    padding-bottom: 14px;
  }
  .homevisit-factor-list article:last-child { border-bottom: 0; padding-bottom: 0; }
  .homevisit-factor-list article > span {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 10px;
    background: #d9f4f8;
    color: #087d99;
    font-size: .82rem;
    font-weight: 900;
  }
  .homevisit-factor-list h3 {
    margin: 0 0 4px;
    color: #071F3A;
    font-family: 'Kanit', sans-serif;
    font-size: 1.05rem;
  }
  .homevisit-factor-list p {
    margin: 0;
    color: #071F3A;
    font-size: .9rem;
    line-height: 1.55;
  }

  /* Process */
  .homevisit-process {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0;
    margin: 35px 0 0;
    padding: 0;
    list-style: none;
    border: 1px solid #c9e5eb;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
  }
  .homevisit-process li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 12px;
    padding: 20px;
    border-right: 1px solid #c9e5eb;
  }
  .homevisit-process li:last-child { border-right: 0; }
  .homevisit-process li > span {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 50%;
    background: #071F3A;
    color: #fff;
    font-size: .76rem;
    font-weight: 900;
  }
  .homevisit-process h3 {
    margin: 0 0 6px;
    color: #071F3A;
    font-family: 'Kanit', sans-serif;
    font-size: 1.02rem;
  }
  .homevisit-process p {
    margin: 0;
    color: #071F3A;
    font-size: .86rem;
    line-height: 1.5;
  }

  /* Feature Gamer */
  .homevisit-feature {
    display: grid;
    grid-template-columns: minmax(0, .94fr) minmax(0, 1.06fr);
    gap: clamp(26px, 5vw, 72px);
    align-items: center;
  }
  .homevisit-feature__visual {
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    box-shadow: 0 22px 44px rgba(7,31,58,.15);
  }
  .homevisit-feature__visual::after {
    position: absolute;
    inset: auto 0 0;
    height: 42%;
    content: '';
    background: linear-gradient(transparent, rgba(7,31,58,.72));
    pointer-events: none;
  }
  .homevisit-feature__visual img {
    display: block;
    width: 100%;
    aspect-ratio: 1.18;
    object-fit: cover;
  }
  .homevisit-feature__visual span {
    position: absolute;
    z-index: 1;
    right: 18px;
    bottom: 15px;
    left: 18px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    font-size: .82rem;
    font-weight: 900;
  }
  .homevisit-feature__visual span i { color: #81e9f3; }

  .homevisit-gamer-points, .homevisit-office-points {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 20px 0;
  }
  .homevisit-gamer-points h3, .homevisit-office-points h3 {
    margin: 0 0 4px;
    color: #071F3A;
    font-family: 'Kanit', sans-serif;
    font-size: 1rem;
  }
  .homevisit-gamer-points p, .homevisit-office-points p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  /* Note Box */
  .homevisit-note {
    border: 1px solid #b6dce6;
    border-radius: 16px;
    padding: 24px;
    background: #fff;
    box-shadow: 0 10px 24px rgba(7,31,58,.04);
  }
  .homevisit-note > i {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 10px;
    background: #d9f4f8;
    color: #087d99;
  }
