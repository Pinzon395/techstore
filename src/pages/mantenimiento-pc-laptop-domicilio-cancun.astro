  /* Hero Visual & Narrative Animation */
  .homevisit-hero__visual-container {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    max-width: 630px;
    margin: 0 auto;
  }
  /* Unified Semantic Process Timeline (Vertical List) */
  .service-process {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 13px;
    margin: 8px 0 0;
    padding: 18px 18px 16px;
    list-style: none;
    background: rgba(6, 26, 48, 0.68);
    border: 1px solid rgba(56, 189, 248, 0.22);
    border-radius: 16px;
    backdrop-filter: blur(10px);
  }

  /* Connecting Background Track Line (Vertical on Left) */
  .service-process::before {
    position: absolute;
    top: 24px;
    bottom: 24px;
    left: 24px;
    width: 3px;
    content: '';
    background: rgba(14, 61, 102, 0.85);
    border-radius: 2px;
    z-index: 1;
  }

  /* Connecting Active Animated Progress Line (Vertical on Left) */
  .service-process::after {
    position: absolute;
    top: 24px;
    bottom: 24px;
    left: 24px;
    width: 3px;
    content: '';
    background: linear-gradient(180deg, #38bdf8, #22d3ee, #10b981);
    border-radius: 2px;
    z-index: 1;
    transform-origin: top;
    animation: hv-line-progress-vert 13s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  /* Step Row Items */
  .process-step {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 14px;
    text-align: left;
    opacity: 0.55;
    transform: translateX(0);
    transition: opacity 250ms ease, transform 250ms ease;
  }

  .process-step__indicator {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 9px;
    margin-bottom: 0;
    flex-shrink: 0;
  }

  /* Dot on the track line */
  .process-step__dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #092644;
    border: 2.5px solid #1a517e;
    box-shadow: 0 0 0 3px rgba(6, 26, 48, 0.9);
    margin-top: 2px;
    transition: background 250ms ease, border-color 250ms ease, box-shadow 250ms ease;
  }

  .process-step__num {
    color: #7dd3fc;
    font-family: monospace;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    min-width: 20px;
    margin-top: 1px;
  }

  .process-step__info {
    min-width: 0;
    flex: 1;
  }

  .process-step__info strong {
    display: block;
    color: #ffffff;
    font-family: 'Kanit', sans-serif;
    font-size: 0.9rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .process-step__info p {
    margin: 2px 0 0;
    color: #cbe9f4;
    font-size: 0.78rem;
    line-height: 1.35;
  }

  /* Timeline Synchronized Keyframes (13-second loop) */
  @keyframes hv-line-progress-vert {
    0%, 8% { transform: scaleY(0); }
    15%, 43% { transform: scaleY(0.33); }
    48%, 80% { transform: scaleY(0.66); }
    85%, 96% { transform: scaleY(1); }
    98%, 100% { transform: scaleY(0); }
  }

  .process-step--1 { animation: hv-step1-sync 13s ease-in-out infinite; }
  .process-step--2 { animation: hv-step2-sync 13s ease-in-out infinite; }
  .process-step--3 { animation: hv-step3-sync 13s ease-in-out infinite; }
  .process-step--4 { animation: hv-step4-sync 13s ease-in-out infinite; }

  @keyframes hv-step1-sync {
    0%, 14% { opacity: 1; transform: translateX(2px); }
    16%, 96% { opacity: 0.55; transform: translateX(0); }
    98%, 100% { opacity: 1; transform: translateX(2px); }
  }

  @keyframes hv-step2-sync {
    0%, 14% { opacity: 0.55; transform: translateX(0); }
    16%, 46% { opacity: 1; transform: translateX(2px); }
    48%, 100% { opacity: 0.55; transform: translateX(0); }
  }

  @keyframes hv-step3-sync {
    0%, 46% { opacity: 0.55; transform: translateX(0); }
    48%, 82% { opacity: 1; transform: translateX(2px); }
    84%, 100% { opacity: 0.55; transform: translateX(0); }
  }

  @keyframes hv-step4-sync {
    0%, 82% { opacity: 0.55; transform: translateX(0); }
    84%, 96% { opacity: 1; transform: translateX(2px); }
    98%, 100% { opacity: 0.55; transform: translateX(0); }
  }

  /* Common Sections */
  :global(main.homevisit-page) section.homevisit-section,
  section.homevisit-section,
  .homevisit-section {
    padding: clamp(54px, 7vw, 88px) 0;
    background-color: #ffffff !important;
    color: #071F3A;
  }
  :global(main.homevisit-page) section.homevisit-section--soft,
  section.homevisit-section--soft,
  .homevisit-section--soft {
    background-color: #eef9fb !important;
  }
  :global(main.homevisit-page) section.homevisit-section--navy,
  section.homevisit-section--navy,
  .homevisit-section--navy {
    background-color: #071F3A !important;
    color: #ffffff !important;
  }

  .homevisit-heading { max-width: 820px; }
  .homevisit-heading--center { margin-right: auto; margin-left: auto; text-align: center; }
  .homevisit-kicker {
    display: inline-block;
    color: #08799a;
    font-size: .76rem;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .homevisit-heading--light .homevisit-kicker { color: #77e1ef; }

  .homevisit-heading h2 {
    margin: 0;
    color: #071F3A;
    font-family: 'Kanit', sans-serif;
    font-size: clamp(1.84rem, 3.5vw, 2.95rem);
    font-weight: 800;
    letter-spacing: -.02em;
    line-height: 1.1;
    text-wrap: balance;
  }
  .homevisit-heading--light h2 { color: #fff; }

  .homevisit-heading p:not(.homevisit-kicker) {
    margin: 14px 0 0;
    color: #071F3A;
    font-size: 1.02rem;
    line-height: 1.7;
  }
  .homevisit-heading--light p:not(.homevisit-kicker) { color: #d7f5f9; }

  .homevisit-split {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    align-items: start;
    gap: clamp(28px, 5vw, 76px);
  }

  /* Card Grids */
  .homevisit-card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(26px, 4vw, 40px);
  }
  .homevisit-card-grid article {
    border: 1px solid #d2e8ee;
    border-radius: 16px;
    padding: 22px;
    background: #fff;
    box-shadow: 0 9px 22px rgba(7,31,58,.04);
    display: flex;
    flex-direction: column;
    transition: transform 180ms cubic-bezier(.23, 1, .32, 1), box-shadow 180ms cubic-bezier(.23, 1, .32, 1), border-color 180ms ease;
  }
  .homevisit-card-grid article > i {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: 10px;
    background: #d9f4f8;
    color: #087d99;
    font-size: 1.05rem;
    margin-bottom: 12px;
  }
  .homevisit-card-grid h3 {
    margin: 0 0 8px;
    color: #071F3A;
    font-family: 'Kanit', sans-serif;
    font-size: 1.15rem;
    line-height: 1.25;
  }
  .homevisit-card-grid p {
    margin: 0;
    color: #071F3A;
    font-size: .92rem;
    line-height: 1.6;
    flex-grow: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .homevisit-card-grid article:hover {
      border-color: #91d6e3;
      box-shadow: 0 15px 28px rgba(7,31,58,.09);
      transform: translateY(-3px);
    }
  }

  .homevisit-card-grid--four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  /* Sublevel H4s */
  .homevisit-sublevels {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px dashed #cfe5eb;
    display: grid;
    gap: 10px;
  }
  .homevisit-sublevels h4 {
    margin: 0 0 3px;
    color: #08799a;
    font-size: 0.84rem;
    font-weight: 850;
    line-height: 1.3;
  }
  .homevisit-sublevels p {
    color: #071F3A;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .homevisit-sublevels-box {
    margin-top: 24px;
    padding: 20px 24px;
    background: #f0fafc;
    border: 1px solid #cbe9ef;
    border-radius: 14px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .homevisit-sublevels-box h4 {
    margin: 0 0 6px;
    color: #08799a;
    font-size: 0.94rem;
    font-weight: 850;
  }
  .homevisit-sublevels-box p {
    margin: 0;
    font-size: 0.88rem;
    color: #071F3A;
    line-height: 1.5;
  }

  .homevisit-inline-link {
    margin: 24px 0 0;
    text-align: center;
  }
  .homevisit-inline-link a, .homevisit-text-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #075b85;
    font-size: .94rem;
    font-weight: 900;
    text-decoration: none;
  }
  .homevisit-inline-link a:hover, .homevisit-text-cta:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* Signal Grid */
  .homevisit-signal-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-top: 34px;
    border: 1px solid rgba(137,228,241,.26);
    background: rgba(137,228,241,.22);
    border-radius: 14px;
    overflow: hidden;
  }
  .homevisit-signal-grid article {
    padding: 22px;
    background: rgba(255,255,255,.05);
  }
  .homevisit-signal-grid h3 {
    margin: 0 0 8px;
    color: #fff;
    font-family: 'Kanit', sans-serif;
    font-size: 1.08rem;
  }
  .homevisit-signal-grid p {
    margin: 0;
    color: #d7f5f9;
    font-size: .88rem;
    line-height: 1.55;
  }
  .homevisit-signal-grid__wide {
    grid-column: 1 / -1;
    background: rgba(7, 31, 58, 0.6) !important;
    border-top: 1px solid rgba(137, 228, 241, 0.3);
  }

  /* Compare Box */
  .homevisit-compare { display: grid; gap: 16px; }
  .homevisit-compare article {
    border: 1px solid #c8e5ed;
    border-radius: 16px;
    padding: 22px;
    background: #f9feff;
    box-shadow: 0 8px 20px rgba(7,31,58,.04);
  }
  .homevisit-compare article:nth-child(2) {
    border-color: #b6d3e2;
    background: #eaf4f8;
  }
  .homevisit-compare h3, .homevisit-compare span {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 9px;
    color: #071F3A;
    font-size: 1.05rem;
    font-weight: 900;
    font-family: 'Kanit', sans-serif;
  }
  .homevisit-compare h3 i, .homevisit-compare span i { color: #0785a1; }
  .homevisit-compare ul {
    display: grid;
    gap: 8px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }
  .homevisit-compare li {
    position: relative;
    padding-left: 19px;
    color: #071F3A;
    font-size: .9rem;
    line-height: 1.5;
  }
  .homevisit-compare li::before {
    position: absolute;
    top: .55em;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #13a1bc;
    content: '';
  }

  /* Factor List */
  .homevisit-factor-list { display: grid; gap: 14px; }
  .homevisit-factor-list article {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 14px;
    align-items: start;
    border-bottom: 1px solid #cfe5eb;
    padding-bottom: 14px;
  }
  .homevisit-factor-list article:last-child { border-bottom: 0; padding-bottom: 0; }
  .homevisit-factor-list article > span {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 10px;
    background: #d9f4f8;
    color: #087d99;
    font-size: .82rem;
    font-weight: 900;
  }
  .homevisit-factor-list h3 {
    margin: 0 0 4px;
    color: #071F3A;
    font-family: 'Kanit', sans-serif;
    font-size: 1.05rem;
  }
  .homevisit-factor-list p {
    margin: 0;
    color: #071F3A;
    font-size: .9rem;
    line-height: 1.55;
  }

  /* Process */
  .homevisit-process {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0;
    margin: 35px 0 0;
    padding: 0;
    list-style: none;
    border: 1px solid #c9e5eb;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
  }
  .homevisit-process li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 12px;
    padding: 20px;
    border-right: 1px solid #c9e5eb;
  }
  .homevisit-process li:last-child { border-right: 0; }
  .homevisit-process li > span {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 50%;
    background: #071F3A;
    color: #fff;
    font-size: .76rem;
    font-weight: 900;
  }
  .homevisit-process h3 {
    margin: 0 0 6px;
    color: #071F3A;
    font-family: 'Kanit', sans-serif;
    font-size: 1.02rem;
  }
  .homevisit-process p {
    margin: 0;
    color: #071F3A;
    font-size: .86rem;
    line-height: 1.5;
  }

  /* Feature Gamer */
  .homevisit-feature {
    display: grid;
    grid-template-columns: minmax(0, .94fr) minmax(0, 1.06fr);
    gap: clamp(26px, 5vw, 72px);
    align-items: center;
  }
  .homevisit-feature__visual {
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    box-shadow: 0 22px 44px rgba(7,31,58,.15);
  }
  .homevisit-feature__visual::after {
    position: absolute;
    inset: auto 0 0;
    height: 42%;
    content: '';
    background: linear-gradient(transparent, rgba(7,31,58,.72));
    pointer-events: none;
  }
  .homevisit-feature__visual img {
    display: block;
    width: 100%;
    aspect-ratio: 1.18;
    object-fit: cover;
  }
  .homevisit-feature__visual span {
    position: absolute;
    z-index: 1;
    right: 18px;
    bottom: 15px;
    left: 18px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    font-size: .82rem;
    font-weight: 900;
  }
  .homevisit-feature__visual span i { color: #81e9f3; }

  .homevisit-gamer-points, .homevisit-office-points {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 20px 0;
  }
  .homevisit-gamer-points h3, .homevisit-office-points h3 {
    margin: 0 0 4px;
    color: #071F3A;
    font-family: 'Kanit', sans-serif;
    font-size: 1rem;
  }
  .homevisit-gamer-points p, .homevisit-office-points p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  /* Note Box */
  .homevisit-note {
    border: 1px solid #b6dce6;
    border-radius: 16px;
    padding: 24px;
    background: #fff;
    box-shadow: 0 10px 24px rgba(7,31,58,.04);
  }
  .homevisit-note > i {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 10px;
    background: #d9f4f8;
    color: #087d99;
  }
  .homevisit-note h3 {
    margin: 14px 0 8px;
    color: #071F3A;
    font-family: 'Kanit', sans-serif;
    font-size: 1.1rem;
  }
  .homevisit-note p {
    margin: 0 0 16px;
    color: #071F3A;
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .homevisit-note div { display: flex; flex-wrap: wrap; gap: 9px; }
  .homevisit-note a {
    border: 1px solid #b9dce5;
    border-radius: 999px;
    padding: 7px 12px;
    color: #075b85;
    font-size: .84rem;
    font-weight: 900;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .homevisit-note a:hover {
    border-color: #087d99;
    background: #eef9fb;
  }

  /* Zones Grid */
  .homevisit-zones-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 18px;
    margin-top: 34px;
  }
  .homevisit-zone-card {
    background: #ffffff;
    border: 1px solid #d2e8ee;
    border-radius: 16px;
    padding: 22px;
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 16px;
    box-shadow: 0 8px 20px rgba(7,31,58,.04);
  }
  .homevisit-zone-card__icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: #d9f4f8;
    color: #087d99;
    display: grid;
    place-items: center;
    font-size: 1.15rem;
  }
  .homevisit-zone-card h3 {
    margin: 0 0 6px;
    color: #071F3A;
    font-family: 'Kanit', sans-serif;
    font-size: 1.1rem;
  }
  .homevisit-zone-card p {
    margin: 0;
    color: #071F3A;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  /* Price Scope Box */
  .homevisit-price-scope-box {
    margin: 20px 0 16px;
    padding: 18px 20px;
    background: #ffffff;
    border: 1px solid #cce7ee;
    border-left: 4px solid #08799a;
    border-radius: 12px;
  }
  .homevisit-price-scope-box h4 {
    margin: 0 0 8px;
    color: #071F3A;
    font-family: 'Kanit', sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
  }
  .homevisit-price-scope-box p {
    margin: 0 0 8px;
    color: #071F3A;
    font-size: 0.88rem;
    line-height: 1.55;
  }
  .homevisit-price-scope-box p:last-child { margin-bottom: 0; }

  /* Guarantee Note */
  .homevisit-guarantee-note {
    margin-top: 18px;
    padding: 16px 18px;
    background: #eef9fb;
    border: 1px solid #cbe9ef;
    border-radius: 12px;
  }
  .homevisit-guarantee-note h4 {
    margin: 0 0 6px;
    color: #08799a;
    font-size: 0.92rem;
    font-weight: 850;
  }
  .homevisit-guarantee-note p {
    margin: 0;
    color: #071F3A;
    font-size: 0.86rem;
    line-height: 1.5;
  }

  /* Residential Grid */
  .homevisit-residential-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: clamp(26px, 4vw, 40px);
  }
  .homevisit-residential-card {
    position: relative;
    border: 1px solid #d2e8ee;
    border-radius: 16px;
    padding: 22px;
    background: #ffffff;
    box-shadow: 0 8px 20px rgba(7,31,58,.04);
    display: flex;
    flex-direction: column;
    transition: transform 180ms cubic-bezier(.23, 1, .32, 1), box-shadow 180ms cubic-bezier(.23, 1, .32, 1), border-color 180ms ease;
  }
  .homevisit-residential-card--tier-a {
    border-color: #9cdbe8;
    background: linear-gradient(180deg, #f7fdff 0%, #ffffff 100%);
    box-shadow: 0 10px 24px rgba(7,31,58,.07);
  }
  .homevisit-badge-tier {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    border-radius: 6px;
    padding: 4px 8px;
    background: #071F3A;
    color: #67d9e9;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .homevisit-badge-sub {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    border-radius: 6px;
    padding: 3px 8px;
    background: #eef9fb;
    color: #08799a;
    font-size: 0.72rem;
    font-weight: 800;
    margin-bottom: 10px;
  }
  .homevisit-residential-card h3 {
    margin: 0 0 8px;
    color: #071F3A;
    font-family: 'Kanit', sans-serif;
    font-size: 1.15rem;
    line-height: 1.25;
  }
  .homevisit-residential-card p {
    margin: 0;
    color: #071F3A;
    font-size: 0.9rem;
    line-height: 1.55;
    flex-grow: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .homevisit-residential-card:hover {
      border-color: #72cde0;
      box-shadow: 0 14px 28px rgba(7,31,58,.1);
      transform: translateY(-3px);
    }
  }

  /* Access protocol box */
  .homevisit-access-box {
    margin-top: 28px;
    padding: 22px 26px;
    background: #f0fafc;
    border: 1px solid #cbe9ef;
    border-radius: 16px;
    display: grid;
    grid-template-columns: 36px 1fr auto;
    align-items: center;
    gap: 20px;
  }
  .homevisit-access-box > i {
    font-size: 1.8rem;
    color: #08799a;
  }
  .homevisit-access-box h4 {
    margin: 0 0 4px;
    color: #071F3A;
    font-family: 'Kanit', sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
  }
  .homevisit-access-box p {
    margin: 0;
    color: #071F3A;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  /* Transition to generic page box */
  .homevisit-trans-box {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 24px;
    padding: 28px 32px;
    background: #ffffff;
    border: 1px solid #cce7ee;
    border-radius: 18px;
    box-shadow: 0 9px 24px rgba(7,31,58,.05);
  }
  .homevisit-trans-box__content h3 {
    margin: 0 0 8px;
    color: #071F3A;
    font-family: 'Kanit', sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
  }
  .homevisit-trans-box__content p {
    margin: 0;
    color: #071F3A;
    font-size: 0.94rem;
    line-height: 1.6;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .homevisit-card-grid--four { grid-template-columns: repeat(2, 1fr); }
    .homevisit-signal-grid { grid-template-columns: repeat(2, 1fr); }
    .homevisit-process { grid-template-columns: repeat(2, 1fr); }
    .homevisit-residential-grid { grid-template-columns: repeat(2, 1fr); }
    .homevisit-access-box { grid-template-columns: 36px 1fr; }
    .homevisit-access-box a { grid-column: 1 / -1; }
    .homevisit-trans-box { grid-template-columns: 1fr; }
    .homevisit-process li:nth-child(2n) { border-right: 0; }
    .homevisit-process li:nth-last-child(-n+2) { border-bottom: 0; }
  }

  @media (max-width: 860px) {
    .homevisit-hero__grid {
      grid-template-areas:
        "eyebrow"
        "title"
        "media"
        "summary"
        "actions"
        "trust";
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .homevisit-split,
    .homevisit-feature { grid-template-columns: 1fr; }
    .homevisit-hero__copy { max-width: 100%; }
    .homevisit-hero__visual-container { max-width: 540px; margin: 0 auto; width: 100%; }
    .homevisit-card-grid { grid-template-columns: repeat(2, 1fr); }
    .homevisit-sublevels-box { grid-template-columns: 1fr; }
    .homevisit-gamer-points, .homevisit-office-points { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .homevisit-hero { padding-top: 36px; }
    .homevisit-hero h1 { font-size: clamp(1.9rem, 8vw, 2.5rem); }
    .homevisit-hero__actions { flex-direction: column; }
    .homevisit-btn { width: 100%; }
    .homevisit-hero__visual-container { max-width: 100%; }
    .service-process { padding: 14px 14px 13px; gap: 11px; }
    .service-process::before, .service-process::after { left: 20px; }
    .process-step { gap: 11px; }
    .process-step__info strong { font-size: 0.86rem; }
    .process-step__info p { font-size: 0.74rem; }
    .homevisit-card-grid, .homevisit-card-grid--four { grid-template-columns: 1fr; }
    .homevisit-signal-grid { grid-template-columns: 1fr; }
    .homevisit-process { grid-template-columns: 1fr; }
    .homevisit-process li { border-right: 0; border-bottom: 1px solid #c9e5eb; }
    .homevisit-process li:last-child { border-bottom: 0; }
    .homevisit-zones-grid { grid-template-columns: 1fr; }
    .homevisit-residential-grid { grid-template-columns: 1fr; }
    .homevisit-access-box { grid-template-columns: 1fr; }
    .homevisit-access-box > i { display: none; }
    .homevisit-zone-card { grid-template-columns: 1fr; }
    .homevisit-zone-card__icon { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .homevisit-visual * { animation: none !important; }
