---
/**
 * Admin Panel v2.1 — Sidebar lateral colapsada por default + hover-expand
 * - Solo logo circular en sidebar (sin texto al lado)
 * - Expandir al pasar el cursor o tocar
 * - body sin .light-theme (sin preload sprite, ya que el admin no lo usa)
 */
import Base from '../../layouts/Base.astro';
import CommerceHubView from '../../components/admin/CommerceHubView.astro';
import CommerceCatalogView from '../../components/admin/CommerceCatalogView.astro';
import CommerceOperationsView from '../../components/admin/CommerceOperationsView.astro';
import '../../styles/admin.css';
---

<Base
  title="Panel de Administración | Pixon PC"
  description="Panel administrativo Pixon PC"
  canonical="https://pixon.com.mx/admin"
  image="/LOGOCIRCULAR.png"
  bodyClass="admin-body"
  preloadSprite={false}
  robots="noindex, nofollow"
>
  <!-- Pantalla de carga mientras admin.js verifica permisos -->
  <div id="auth-loading">
    <i class="fa-solid fa-circle-notch fa-spin fa-2x" style="color: #22d3ee;"></i>
    <p>Verificando permisos…</p>
  </div>

  <div class="admin-shell" id="admin-shell">

    <!-- ═══════════════════════════════════════════════════════════════
         SIDEBAR — interactiva (expandible, colapsable, grupos, tooltips)
    ═══════════════════════════════════════════════════════════════ -->
    <aside class="admin-sidebar" id="admin-sidebar">
      <div class="admin-sidebar-header">
        <a href="/" class="admin-brand" aria-label="Inicio Pixon PC" title="Pixon PC">
          <img src="/LOGOCIRCULAR.png" alt="Pixon PC" width="36" height="36" />
          <span class="admin-brand-text">Pixon <span>PC</span></span>
        </a>
        <button type="button" class="admin-sidebar-mobile-close" id="adminSidebarMobileClose" aria-label="Cerrar menú">
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
      </div>

      <button type="button" class="admin-sb-toggle" id="adminSbToggle" aria-label="Contraer o expandir barra lateral" title="Contraer / Expandir menú">
        <i class="fa-solid fa-chevron-left" id="adminSbToggleIcon" aria-hidden="true"></i>
      </button>

      <nav class="admin-nav" aria-label="Navegación admin">
        <div class="nav-single-item">
          <button class="nav-link active" type="button" data-view="dashboard" data-tooltip="Dashboard" title="Dashboard" aria-controls="view-dashboard" aria-current="page">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-gauge-high" /></svg>
            <span class="nav-link-label">Dashboard</span>
          </button>
        </div>

        <div class="nav-group" data-nav-group="hoy">
          <button type="button" class="nav-group-header" data-group-toggle aria-expanded="true" aria-controls="nav-group-items-hoy">
            <span class="nav-section-title">Hoy</span>
            <i class="fa-solid fa-chevron-down nav-group-chevron" aria-hidden="true"></i>
          </button>
          <div class="nav-group-items" id="nav-group-items-hoy">
            <button class="nav-link" type="button" data-view="dashboard" data-tooltip="Mi jornada" title="Mi jornada" aria-controls="view-dashboard">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-gauge-high" /></svg>
              <span class="nav-link-label">Mi jornada</span>
            </button>
            <button class="nav-link" type="button" data-view="agenda" data-tooltip="Agenda" title="Agenda operativa" aria-controls="view-agenda">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-calendar-days" /></svg>
              <span class="nav-link-label">Agenda</span>
            </button>
            <button class="nav-link" type="button" data-notifications-focus data-tooltip="Notificaciones" title="Notificaciones" aria-controls="notificationsDropdown">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-bell" /></svg>
              <span class="nav-link-label">Notificaciones</span>
            </button>
          </div>
        </div>

        <div class="nav-group" data-nav-group="operacion">
          <button type="button" class="nav-group-header" data-group-toggle aria-expanded="true" aria-controls="nav-group-items-operacion">
            <span class="nav-section-title">Operación</span>
            <i class="fa-solid fa-chevron-down nav-group-chevron" aria-hidden="true"></i>
          </button>
          <div class="nav-group-items" id="nav-group-items-operacion">
            <button class="nav-link" type="button" data-view="repairs" data-tooltip="Taller" title="Taller" aria-controls="view-repairs">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-screwdriver-wrench" /></svg>
              <span class="nav-link-label">Taller</span>
            </button>
            <button class="nav-link" type="button" data-view="commerce-orders" data-tooltip="Pedidos" title="Pedidos" aria-controls="view-commerce-orders">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-bag-shopping" /></svg>
              <span class="nav-link-label">Pedidos</span>
              <span class="badge warn" id="nav-badge-orders" style="display:none;">0</span>
            </button>
            <button class="nav-link" type="button" data-view="commerce-payments" data-tooltip="Pagos" title="Pagos" aria-controls="view-commerce-payments">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-credit-card" /></svg>
              <span class="nav-link-label">Pagos</span>
            </button>
            <button class="nav-link" type="button" data-view="commerce-inventory" data-tooltip="Inventario" title="Inventario" aria-controls="view-commerce-inventory">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-boxes-stacked" /></svg>
              <span class="nav-link-label">Inventario</span>
            </button>
            <button class="nav-link" type="button" data-view="builds" data-tooltip="Ensambles" title="Ensambles" aria-controls="view-builds">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-microchip" /></svg>
              <span class="nav-link-label">Ensambles</span>
            </button>
          </div>
        </div>

        <div class="nav-group" data-nav-group="comercio">
          <button type="button" class="nav-group-header" data-group-toggle aria-expanded="false" aria-controls="nav-group-items-comercio">
            <span class="nav-section-title">Comercio</span>
            <i class="fa-solid fa-chevron-down nav-group-chevron" aria-hidden="true"></i>
          </button>
          <div id="nav-group-items-comercio" class="nav-group-items" hidden>
            <button class="nav-link" type="button" data-view="commerce" data-tooltip="Resumen comercial" title="Resumen comercial" aria-controls="view-commerce">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-cart-shopping" /></svg>
              <span class="nav-link-label">Resumen comercial</span>
            </button>
            <button class="nav-link" type="button" data-view="commerce-store" data-tooltip="Catálogo" title="Catálogo" aria-controls="view-commerce-store">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-store" /></svg>
              <span class="nav-link-label">Catálogo</span>
            </button>
            <button class="nav-link" type="button" data-view="commerce-dashboard" data-tooltip="Ventas" title="Ventas" aria-controls="view-commerce-dashboard">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-chart-line" /></svg>
              <span class="nav-link-label">Ventas</span>
            </button>
            <button class="nav-link" type="button" data-view="commerce-promotions" data-tooltip="Promociones" title="Promociones" aria-controls="view-commerce-promotions">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-tags" /></svg>
              <span class="nav-link-label">Promociones</span>
            </button>
            <button class="nav-link" type="button" data-view="commerce-settings" data-tooltip="Métodos de pago" title="Métodos de pago" aria-controls="view-commerce-settings">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-credit-card" /></svg>
              <span class="nav-link-label">Métodos de pago</span>
            </button>
          </div>
        </div>

        <div class="nav-group" data-nav-group="clientes">
          <button type="button" class="nav-group-header" data-group-toggle aria-expanded="true" aria-controls="nav-group-items-clientes">
            <span class="nav-section-title">Clientes</span>
            <i class="fa-solid fa-chevron-down nav-group-chevron" aria-hidden="true"></i>
          </button>
          <div class="nav-group-items" id="nav-group-items-clientes">
            <button class="nav-link" type="button" data-view="comments" data-tooltip="Comentarios" title="Comentarios" aria-controls="view-comments">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-comments" /></svg>
              <span class="nav-link-label">Comentarios</span>
              <span class="badge warn" id="nav-badge-comments" style="display:none;">0</span>
            </button>
            <button class="nav-link" type="button" data-view="users" data-tooltip="Usuarios" title="Usuarios" aria-controls="view-users">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-users-gear" /></svg>
              <span class="nav-link-label">Usuarios</span>
            </button>
          </div>
        </div>

        <div class="nav-group" data-nav-group="contenido">
          <button type="button" class="nav-group-header" data-group-toggle aria-expanded="true" aria-controls="nav-group-items-contenido">
            <span class="nav-section-title">Contenido</span>
            <i class="fa-solid fa-chevron-down nav-group-chevron" aria-hidden="true"></i>
          </button>
          <div class="nav-group-items" id="nav-group-items-contenido">
            <button class="nav-link" type="button" data-view="faqs" data-tooltip="Preguntas Frecuentes" title="Preguntas Frecuentes" aria-controls="view-faqs">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-circle-question" /></svg>
              <span class="nav-link-label">Preguntas Frecuentes</span>
            </button>
          </div>
        </div>

        <div class="nav-group" data-nav-group="configuracion">
          <button type="button" class="nav-group-header" data-group-toggle aria-expanded="true" aria-controls="nav-group-items-configuracion">
            <span class="nav-section-title">Configuración</span>
            <i class="fa-solid fa-chevron-down nav-group-chevron" aria-hidden="true"></i>
          </button>
          <div class="nav-group-items" id="nav-group-items-configuracion">
            <button class="nav-link" type="button" data-view="repairs" data-repair-panel="config" data-tooltip="Config. agenda" title="Configuración de agenda" aria-controls="view-repairs">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-sliders" /></svg>
              <span class="nav-link-label">Config. agenda</span>
            </button>
            <button class="nav-link" type="button" data-view="preferences" data-tooltip="Preferencias" title="Preferencias" aria-controls="view-preferences">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-gear" /></svg>
              <span class="nav-link-label">Preferencias</span>
            </button>
          </div>
        </div>

        <div class="nav-group">
          <p class="nav-section-title">Secundario</p>
          <a href="https://pixon.com.mx/" class="nav-link" target="_blank" rel="noopener noreferrer" title="Ver sitio público" data-tooltip="Ver sitio público">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-arrow-right" /></svg>
            <span class="nav-link-label">Ver sitio público</span>
          </a>
        </div>
      </nav>

      <!-- Bloque de usuario actual -->
      <div class="admin-user-block" id="admin-user-block">
        <div class="admin-avatar-fallback" id="admin-user-avatar">A</div>
        <div class="admin-user-info">
          <span class="name" id="admin-user-name">Cargando…</span>
          <span class="role">Admin</span>
        </div>
      </div>

      <!-- Logout separado y con peso visual distinto al menú -->
      <a href="/auth/logout" class="admin-logout" title="Cerrar sesión" data-tooltip="Cerrar sesión">
        <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-power-off" /></svg>
        <span class="admin-logout-text">Cerrar sesión</span>
      </a>
    </aside>

    <!-- ═══════════════════════════════════════════════════════════════
         MAIN
    ═══════════════════════════════════════════════════════════════ -->
    <main class="admin-main">
      <header class="admin-topbar">
        <div class="admin-topbar-left">
          <button class="admin-mobile-toggle" id="adminMobileToggle" aria-label="Abrir menú">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-sliders" /></svg>
          </button>
          <div>
            <h1 class="admin-page-title" id="admin-page-title">Mi jornada</h1>
            <p class="admin-page-sub" id="admin-subtitle">Prioridades, agenda y operación de hoy.</p>
          </div>
        </div>
        <div class="admin-topbar-right" style="display: flex; align-items: center; gap: 16px;">
          <button class="admin-global-search-trigger" id="adminGlobalSearchTrigger" type="button" aria-haspopup="dialog" aria-controls="adminGlobalSearchDialog">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><span>Buscar en Pixon</span><kbd>⌘ K</kbd>
          </button>
          <div class="live-indicator" id="live-indicator" style="display:none;">
            <div class="live-dot"></div> En vivo
          </div>
          <!-- Centro de Notificaciones -->
          <div class="notifications-wrapper" id="notifications-wrapper">
            <button class="notifications-bell-btn" id="notificationsBellBtn" aria-label="Notificaciones" aria-expanded="false">
              <i class="fa-solid fa-bell"></i>
              <span class="notifications-badge" id="notifications-badge" style="display: none;">0</span>
            </button>
            <div class="notifications-dropdown" id="notificationsDropdown">
              <div class="notifications-dropdown-header">
                Notificaciones recientes
              </div>
              <div class="notifications-dropdown-body" id="notificationsDropdownBody">
                <div class="empty-state">No tienes notificaciones pendientes</div>
              </div>
            </div>
          </div>
          <div id="admin-user-area"></div>
        </div>
      </header>

      <div class="admin-content" id="admin-content">

        <!-- ═══ VISTA DASHBOARD ═══ -->
        <section id="view-dashboard" class="admin-section">
          <section class="journey" aria-labelledby="journey-title">
            <header class="journey-header">
              <div>
                <span class="journey-eyebrow">PIXON PC · OPERACIÓN</span>
                <h2 id="journey-title">Mi jornada</h2>
                <p id="journey-date">Cargando fecha local…</p>
              </div>
              <button type="button" class="journey-primary-action" data-view-target="repairs" data-open-repair><i class="fa-solid fa-plus" aria-hidden="true"></i> Nuevo ticket</button>
            </header>
            <div class="journey-grid">
              <article class="journey-panel" aria-labelledby="journey-attention-title">
                <header class="journey-panel-header"><div><span class="journey-kicker">Prioridad operativa</span><h3 id="journey-attention-title">Atención ahora</h3></div><button type="button" class="journey-link" data-view-target="repairs">Ver taller <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button></header>
                <div id="journey-attention" class="journey-list" aria-live="polite" aria-busy="true"><div class="journey-loading">Preparando prioridades…</div></div>
              </article>
              <article class="journey-panel" aria-labelledby="journey-agenda-title">
                <header class="journey-panel-header">
                  <div>
                    <span class="journey-kicker">Agenda operativa</span>
                    <h3 id="journey-agenda-title">Hoy</h3>
                  </div>
                  <button type="button" class="journey-link" data-view-target="agenda">Abrir <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
                </header>
                <div class="agenda-kpi-compact-strip">
                  <div class="kpi-mini-pill is-total"><span class="kpi-mini-num" id="agenda-kpi-total">0</span><small>Citas</small></div>
                  <div class="kpi-mini-pill is-confirmed"><span class="kpi-mini-num" id="agenda-kpi-confirmed">0</span><small>Confirmadas</small></div>
                  <div class="kpi-mini-pill is-pending"><span class="kpi-mini-num" id="agenda-kpi-pending">0</span><small>Pago pend.</small></div>
                  <div class="kpi-mini-pill is-onsite"><span class="kpi-mini-num" id="agenda-kpi-onsite">0</span><small>Domicilio</small></div>
                  <div class="kpi-mini-pill is-liquid"><span class="kpi-mini-num" id="agenda-kpi-liquid">0</span><small>Mojados</small></div>
                  <div class="kpi-mini-pill is-noshow"><span class="kpi-mini-num" id="agenda-kpi-noshow">0</span><small>No-show</small></div>
                </div>
                <p class="agenda-preview-label">Próximas citas</p>
                <div id="dashboard-agenda-preview" class="dashboard-agenda-container" aria-live="polite">
                  <div class="journey-loading">Cargando agenda operativa…</div>
                </div>
              </article>
            </div>
            <section class="journey-summary" aria-labelledby="journey-summary-title">
              <div class="journey-summary-heading"><span class="journey-kicker">Lectura rápida</span><h3 id="journey-summary-title">Resumen de hoy</h3></div>
              <div id="journey-summary-grid" class="journey-summary-grid" aria-busy="true"></div>
            </section>
          </section>

          <details class="journey-analysis">
            <summary><span>Ver análisis del negocio</span><small>Finanzas, tendencia, servicios e inventario</small></summary>
            <div class="journey-analysis-body">
          <div class="dashboard-command dashboard-command--control">
            <div class="dashboard-command-copy">
              <span class="dashboard-eyebrow">Centro de mando</span>
              <h2>Situación del negocio</h2>
              <p id="dashboard-period-summary">Cargando datos reales del periodo…</p>
            </div>
            <div class="dashboard-controlbar">
              <div class="dashboard-period-control">
                <button type="button" class="dashboard-period-trigger" id="dashboard-period-trigger" aria-expanded="false" aria-controls="dashboard-period-popover">
                  <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-calendar-days" /></svg>
                  <span id="dashboard-period-label">Últimos 30 días</span>
                  <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                </button>
                <div class="dashboard-period-popover" id="dashboard-period-popover" hidden>
                  <div class="dashboard-period-presets" role="list" aria-label="Periodos frecuentes">
                    <button type="button" data-dashboard-preset="today">Hoy</button>
                    <button type="button" data-dashboard-preset="yesterday">Ayer</button>
                    <button type="button" data-dashboard-preset="last7">Últimos 7 días</button>
                    <button type="button" data-dashboard-preset="last30" aria-current="true">Últimos 30 días</button>
                    <button type="button" data-dashboard-preset="thisMonth">Este mes</button>
                    <button type="button" data-dashboard-preset="previousMonth">Mes anterior</button>
                    <button type="button" data-dashboard-preset="year">Año actual</button>
                  </div>
                  <form class="dashboard-custom-period" id="dashboard-custom-period">
                    <label>Desde<input type="date" id="dashboard-period-from" name="from" required /></label>
                    <label>Hasta<input type="date" id="dashboard-period-to" name="to" required /></label>
                    <button type="submit">Aplicar rango</button>
                  </form>
                </div>
              </div>
              <button type="button" class="dashboard-icon-action" id="dashboard-refresh-btn" aria-label="Actualizar Dashboard" title="Actualizar datos">
                <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-rotate-left" /></svg>
              </button>
              <button type="button" class="dashboard-action dashboard-action-primary" data-view-target="repairs" data-open-repair>
                <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-plus" /></svg><span>Nuevo ticket</span>
              </button>
            </div>
          </div>

          <div class="dashboard-status" id="dashboard-status" role="status" aria-live="polite"></div>

          <div class="dashboard-kpi-grid dashboard-kpi-grid--command" id="dashboard-kpis" aria-busy="true">
            {[
              ['sales', 'Ventas', 'Valor registrado, no dinero cobrado'],
              ['collected', 'Ingresos cobrados', 'Pagos aprobados menos reembolsos'],
              ['expenses', 'Gastos', 'Salidas expresamente registradas'],
              ['operating_profit', 'Utilidad', 'Ventas menos costos y gastos'],
              ['active_work', 'Órdenes activas', 'Trabajos que requieren acción'],
              ['ready', 'Por entregar', 'Listas para el cliente'],
              ['new_customers', 'Clientes nuevos', 'Primera aparición en el sistema'],
              ['average_ticket', 'Ticket promedio', 'Ventas por operación con importe']
            ].map(([key, label, help]) => (
              <button type="button" class="command-kpi is-loading" data-dashboard-kpi={key} aria-describedby={`kpi-help-${key}`}>
                <span class="command-kpi-label">{label}</span>
                <strong class="command-kpi-value" data-kpi-value>—</strong>
                <span class="command-kpi-change" data-kpi-change>Cargando…</span>
                <span class="sr-only" id={`kpi-help-${key}`}>{help}</span>
              </button>
            ))}
          </div>

          <div class="dashboard-primary-grid">
            <article class="command-panel command-panel--operations">
              <header class="command-panel-header">
                <div><span class="command-panel-kicker">Operación</span><h3>Flujo del taller</h3></div>
                <button type="button" class="command-link" data-view-target="repairs">Ver tickets <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
              </header>
              <div id="dashboard-operations" class="dashboard-panel-body dashboard-skeleton" aria-busy="true"></div>
            </article>

            <article class="command-panel command-panel--trend">
              <header class="command-panel-header">
                <div><span class="command-panel-kicker">Tendencia</span><h3 id="dashboard-series-title">Ingresos en el tiempo</h3></div>
                <div class="dashboard-series-tabs" role="group" aria-label="Serie visible">
                  <button type="button" data-dashboard-series="collected" aria-pressed="true">Ingresos</button>
                  <button type="button" data-dashboard-series="sales" aria-pressed="false">Ventas</button>
                  <button type="button" data-dashboard-series="tickets" aria-pressed="false">Órdenes</button>
                  <button type="button" data-dashboard-series="views" aria-pressed="false">Tráfico</button>
                </div>
              </header>
              <div id="dashboard-series" class="dashboard-panel-body dashboard-skeleton" aria-busy="true"></div>
            </article>
          </div>

          <div class="dashboard-secondary-grid" id="dashboard-secondary">
            <details class="command-disclosure" open>
              <summary><span><i class="fa-solid fa-wallet" aria-hidden="true"></i> Finanzas</span><span class="disclosure-summary" data-dashboard-summary="finance">Cargando…</span></summary>
              <div class="disclosure-body" id="dashboard-finance" aria-busy="true"><div class="dashboard-skeleton"><span></span><span></span><span></span></div></div>
            </details>
            <details class="command-disclosure">
              <summary><span><i class="fa-solid fa-users" aria-hidden="true"></i> Clientes y citas</span><span class="disclosure-summary" data-dashboard-summary="customers">Cargando…</span></summary>
              <div class="disclosure-body" id="dashboard-customers"></div>
            </details>
            <details class="command-disclosure">
