ï»¿---
/**
 * Admin Panel v2.1 — Sidebar lateral colapsada por default + hover-expand
 * - Solo logo circular en sidebar (sin texto al lado)
 * - Expandir al pasar el cursor o tocar
 * - body sin .light-theme (sin preload sprite, ya que el admin no lo usa)
 */
import Base from '../../layouts/Base.astro';
import '../../styles/admin.css';
---

<Base
  title="Panel de Administración | Pixon PC"
  description="Panel administrativo Pixon PC"
  canonical="https://pixon.com.mx/admin"
  image="/LOGOCIRCULAR.png"
  bodyClass="admin-body"
  preloadSprite={false}
  robots="noindex, nofollow"
>
  <!-- Pantalla de carga mientras admin.js verifica permisos -->
  <div id="auth-loading">
    <i class="fa-solid fa-circle-notch fa-spin fa-2x" style="color: #22d3ee;"></i>
    <p>Verificando permisos…</p>
  </div>

  <div class="admin-shell sb-collapsed" id="admin-shell">

    <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
         SIDEBAR — colapsada por default (solo iconos + logo circular).
         Al hover, se expande temporalmente mostrando textos.
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
    <aside class="admin-sidebar" id="admin-sidebar" data-collapsed="true">
      <a href="/" class="admin-brand" aria-label="Inicio Pixon PC" title="Pixon PC">
        <img src="/LOGOCIRCULAR.png" alt="Pixon PC" width="36" height="36" />
      </a>

      <nav class="admin-nav" aria-label="Navegación admin">
        <div class="nav-group">
          <p class="nav-section-title">Principal</p>
          <button class="nav-link active" type="button" data-view="dashboard" title="Dashboard" aria-controls="view-dashboard" aria-current="page">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-gauge-high" /></svg>
            <span class="nav-link-label">Dashboard</span>
          </button>
        </div>

        <div class="nav-group">
          <p class="nav-section-title">Gestión</p>
          <button class="nav-link" type="button" data-view="repairs" title="Taller (Tickets)" aria-controls="view-repairs">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-screwdriver-wrench" /></svg>
            <span class="nav-link-label">Taller (Tickets)</span>
          </button>
          <button class="nav-link" type="button" data-view="builds" title="Ensambles" aria-controls="view-builds">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-microchip" /></svg>
            <span class="nav-link-label">Ensambles</span>
          </button>
          <button class="nav-link" type="button" data-view="comments" title="Comentarios" aria-controls="view-comments">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-comments" /></svg>
            <span class="nav-link-label">Comentarios</span>
            <span class="badge warn" id="nav-badge-comments" style="display:none;">0</span>
          </button>
          <button class="nav-link" type="button" data-view="users" title="Usuarios" aria-controls="view-users">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-users-gear" /></svg>
            <span class="nav-link-label">Usuarios</span>
          </button>
          <button class="nav-link" type="button" data-view="faqs" title="Preguntas Frecuentes" aria-controls="view-faqs">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-circle-question" /></svg>
            <span class="nav-link-label">Preguntas Frecuentes</span>
          </button>
        </div>

        <div class="nav-group">
          <p class="nav-section-title">Sistema</p>
          <a href="/" class="nav-link" target="_blank" rel="noopener" title="Ver sitio público">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-arrow-right" /></svg>
            <span class="nav-link-label">Ver sitio público</span>
          </a>
        </div>
      </nav>

      <!-- Bloque de usuario actual -->
      <div class="admin-user-block" id="admin-user-block">
        <div class="admin-avatar-fallback" id="admin-user-avatar">A</div>
        <div class="admin-user-info">
          <span class="name" id="admin-user-name">Cargando…</span>
          <span class="role">Admin</span>
        </div>
      </div>

      <!-- Logout separado y con peso visual distinto al menú -->
      <a href="/auth/logout" class="admin-logout" title="Cerrar sesión">
        <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-power-off" /></svg>
        <span class="admin-logout-text">Cerrar sesión</span>
      </a>
    </aside>

    <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
         MAIN
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
    <main class="admin-main">
      <header class="admin-topbar">
        <div class="admin-topbar-left">
          <button class="admin-mobile-toggle" id="adminMobileToggle" aria-label="Abrir menú">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-sliders" /></svg>
          </button>
          <div>
            <h1 class="admin-page-title" id="admin-page-title">Dashboard</h1>
            <p class="admin-page-sub" id="admin-subtitle">Revisa, aprueba y gestiona tu plataforma.</p>
          </div>
        </div>
        <div class="admin-topbar-right">
          <div class="live-indicator" id="live-indicator" style="display:none;">
            <div class="live-dot"></div> En vivo
          </div>
          <div id="admin-user-area"></div>
        </div>
      </header>

      <div class="admin-content" id="admin-content">

        <!-- â•â•â• VISTA DASHBOARD â•â•â• -->
        <section id="view-dashboard" class="admin-section">
          <div class="dashboard-command">
            <div>
              <span class="dashboard-eyebrow">Centro de operaciones</span>
              <h2>Resumen del negocio</h2>
              <p>Prioridades, actividad del sitio y accesos frecuentes en una sola vista.</p>
            </div>
            <div class="dashboard-actions" aria-label="Acciones rápidas">
              <button type="button" class="dashboard-action dashboard-action-primary" data-view-target="repairs" data-open-repair><svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-plus" /></svg><span>Nuevo ticket</span></button>
              <button type="button" class="dashboard-action" data-view-target="comments"><svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-comments" /></svg><span>Moderar</span></button>
              <button type="button" class="dashboard-action" data-view-target="faqs"><svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-circle-question" /></svg><span>Gestionar FAQ</span></button>
            </div>
          </div>

          <div class="dashboard-stats">
            <div class="stat-card stat-card-attention"><div class="stat-icon"><svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-comments" /></svg></div><div><div class="stat-number" id="stat-comments-pending">0</div><div class="stat-label">Comentarios pendientes</div></div><span class="stat-context">Por revisar</span></div>
            <div class="stat-card stat-card-users"><div class="stat-icon"><svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-users-gear" /></svg></div><div><div class="stat-number" id="stat-users">0</div><div class="stat-label">Usuarios registrados</div></div><span class="stat-context">Base total</span></div>
            <div class="stat-card stat-card-warning"><div class="stat-icon"><svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-circle-question" /></svg></div><div><div class="stat-number" id="stat-faqs-unanswered">0</div><div class="stat-label">Dudas sin resolver</div></div><span class="stat-context">Requieren respuesta</span></div>
            <div class="stat-card stat-card-traffic"><div class="stat-icon"><svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-magnifying-glass-chart" /></svg></div><div><div class="stat-number" id="stat-total-views">0</div><div class="stat-label">Visitas totales</div></div><span class="stat-context">Histórico</span></div>
            <div class="stat-card stat-card-today"><div class="stat-icon"><svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-arrow-trend-up" /></svg></div><div><div class="stat-number" id="stat-today-views">0</div><div class="stat-label">Visitas hoy</div></div><span class="stat-context">Actividad diaria</span></div>
            <div class="stat-card stat-card-unique"><div class="stat-icon"><svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-user" /></svg></div><div><div class="stat-number" id="stat-unique-today">0</div><div class="stat-label">Visitantes únicos hoy</div></div><span class="stat-context">Personas distintas</span></div>
          </div>

          <!-- BLOQUE LIVE — actualiza cada 10s -->
          <div class="admin-card live-card" id="live-card">
            <div class="live-card-head">
              <h3>
                <span class="live-pulse" aria-hidden="true"></span>
                Actividad en vivo
              </h3>
              <div class="live-card-stats">
                <div class="live-stat">
                  <span class="live-stat-num" id="live-active">0</span>
                  <span class="live-stat-label">viendo ahora</span>
                </div>
                <div class="live-stat">
                  <span class="live-stat-num" id="live-window-views">0</span>
                  <span class="live-stat-label">vistas últimos 30 min</span>
                </div>
                <div class="live-stat">
                  <span class="live-stat-num" id="live-window-visitors">0</span>
                  <span class="live-stat-label">visitantes únicos</span>
                </div>
              </div>
            </div>

            <!-- Sparkline SVG (últimos 30 min, 1 barra por minuto) -->
            <div class="live-spark-wrap">
              <svg id="live-sparkline" class="live-spark" viewBox="0 0 600 120" preserveAspectRatio="none" aria-label="Vistas por minuto últimos 30 minutos"></svg>
              <div class="live-spark-axis">
                <span>-30 min</span>
                <span>-15 min</span>
                <span>ahora</span>
              </div>
            </div>

            <!-- Feed de páginas agrupadas -->
            <div class="live-feed-head">
              <span><i class="fa-solid fa-layer-group"></i> Páginas vistas agrupadas</span>
              <small id="live-updated">—</small>
            </div>
            <div class="live-feed-legend" aria-label="Métricas de páginas agrupadas">
              <span>Semana</span>
              <span>Hoy</span>
              <span>Últimos 30 min</span>
            </div>
            <ul class="live-feed" id="live-feed">
              <li class="empty-state">Cargando…</li>
            </ul>
          </div>

          <div class="admin-grid-2 dashboard-analytics-grid">
            <div class="admin-card dashboard-analysis-card">
              <h3>
                <i class="fa-solid fa-ranking-star"></i>
                Páginas más visitadas (30 días)
              </h3>
              <div id="analytics-top-pages">
                <div class="empty-state">Cargando…</div>
              </div>
            </div>
            <div class="admin-card dashboard-analysis-card">
              <h3>
                <i class="fa-solid fa-chart-line"></i>
                Tráfico diario (14 días)
              </h3>
              <div id="analytics-chart">
                <div class="empty-state">Cargando…</div>
              </div>
            </div>
          </div>
        </section>

        <!-- â•â•â• VISTA TALLER (REPAIRS) â•â•â• -->
        <section id="view-repairs" class="admin-section" style="display:none;">
          <div class="admin-section-header">
            <h2>Tickets de Reparación</h2>
            <div style="display:flex;gap:10px;flex-wrap:wrap;">
              <button class="btn-admin" type="button" id="repairTabTickets"><i class="fa-solid fa-list"></i> Tickets</button>
              <button class="btn-admin" type="button" id="repairTabAgenda"><i class="fa-solid fa-calendar-days"></i> Agenda</button>
              <button class="btn-admin" type="button" id="repairTabConfig"><i class="fa-solid fa-gear"></i> Configurar agenda</button>
              <button class="btn-admin btn-approve" type="button" onclick="window.openRepairModal && openRepairModal()">
                <i class="fa-solid fa-plus"></i> Nuevo Ticket
              </button>
            </div>
          </div>
          <div id="repairTicketsPanel">
          <div class="admin-filter-panel repair-filter-panel" aria-label="Filtros de tickets">
            <div class="admin-filter-field admin-filter-field-wide">
              <label for="repairSearchInput">Buscar</label>
              <input type="search" id="repairSearchInput" class="admin-input" placeholder="Ticket, cliente, equipo, falla, telefono..." />
            </div>
            <div class="admin-filter-field">
              <label for="repairStatusFilter">Estatus</label>
              <select id="repairStatusFilter" class="admin-input">
                <option value="all">Todos</option>
              </select>
            </div>
            <div class="admin-filter-field">
              <label for="repairUrgencyFilter">Urgencia</label>
              <select id="repairUrgencyFilter" class="admin-input">
                <option value="all">Todas</option>
                <option value="normal">Normal</option>
                <option value="urgent">Lo necesito lo antes posible</option>
                <option value="work_school">Es para trabajo / escuela</option>
                <option value="quote">Solo quiero cotizar</option>
              </select>
            </div>
            <div class="admin-filter-field">
              <label for="repairDeviceFilter">Dispositivo</label>
              <select id="repairDeviceFilter" class="admin-input">
                <option value="all">Todos</option>
              </select>
            </div>
            <div class="admin-filter-field">
              <label for="repairServiceFilter">Tipo de servicio</label>
              <select id="repairServiceFilter" class="admin-input">
                <option value="all">Todos</option>
              </select>
            </div>
            <button type="button" class="btn-admin admin-filter-clear" id="repairClearFilters">
              <i class="fa-solid fa-rotate-left"></i> Limpiar
            </button>
          </div>
          <div class="admin-filter-summary" id="repairFilterSummary">Mostrando todos los tickets.</div>
          <div class="users-table-wrapper">
            <table class="users-table repairs-table">
              <thead>
                <tr>
                  <th>Código</th>
                  <th>Cliente</th>
                  <th>Dispositivo</th>
                  <th>Falla Reportada</th>
                  <th>Urgencia</th>
                  <th>Estatus</th>
                  <th>Fecha</th>
                  <th>Abrir</th>
                </tr>
              </thead>
              <tbody id="repairs-tbody">
                <tr><td colspan="8" class="empty-row">Aún no hay tickets registrados.</td></tr>
              </tbody>
            </table>
          </div>
          </div>
          <div id="repairAgendaPanel" class="admin-card repair-agenda-panel" style="display:none;">
            <div class="admin-section-header">
              <h2>Agenda de citas</h2>
              <div style="display:flex;gap:10px;flex-wrap:wrap;">
                <input id="appointmentFrom" class="admin-input" type="date" />
                <input id="appointmentTo" class="admin-input" type="date" />
                <button class="btn-admin" type="button" id="appointmentRefresh"><i class="fa-solid fa-rotate"></i> Actualizar</button>
              </div>
            </div>
            <div class="filters" id="appointmentFilters">
              <button class="filter-btn active" type="button" data-appointment-filter="today">Hoy</button>
              <button class="filter-btn" type="button" data-appointment-filter="week">Esta semana</button>
              <button class="filter-btn" type="button" data-appointment-filter="upcoming">Proximas</button>
              <button class="filter-btn" type="button" data-appointment-filter="confirmada">Confirmadas</button>
              <button class="filter-btn" type="button" data-appointment-filter="pendiente_confirmacion">Pendientes</button>
              <button class="filter-btn" type="button" data-appointment-filter="cancelada">Canceladas</button>
            </div>
            <div id="appointmentsList" class="repair-appointments-list">
              <div class="empty-state">Cargando agenda...</div>
            </div>
          </div>
          <div id="repairConfigPanel" class="admin-card repair-agenda-panel" style="display:none;">
            <div class="admin-section-header">
              <h2>Configuración de agenda</h2>
              <button class="btn-admin btn-approve" type="button" id="appointmentConfigSave"><i class="fa-solid fa-floppy-disk"></i> Guardar configuración</button>
            </div>
            <div id="appointmentSettingsGrid" class="appointment-settings-grid"></div>
            <h3 style="margin-top:24px;">Dias bloqueados y reglas especiales</h3>
            <div class="appointment-exception-form">
              <input id="appointmentExceptionDate" class="admin-input" type="date" />
              <select id="appointmentExceptionStatus" class="admin-input">
                <option value="closed">Cerrado</option>
                <option value="normal">Disponible normal</option>
                <option value="only_pickup">Solo recepcion de equipos</option>
                <option value="only_dropoff">Solo entrega de equipos</option>
                <option value="only_diagnostic">Solo diagnóstico</option>
                <option value="custom_hours">Horario especial</option>
              </select>
              <input id="appointmentExceptionStart" class="admin-input" type="time" />
              <input id="appointmentExceptionEnd" class="admin-input" type="time" />
              <select id="appointmentExceptionSlot" class="admin-input">
                <option value="">Duracion default</option>
                <option value="15">15 minutos</option>
                <option value="30">30 minutos</option>
                <option value="45">45 minutos</option>
                <option value="60">60 minutos</option>
              </select>
              <input id="appointmentExceptionReason" class="admin-input" type="text" placeholder="Motivo" />
              <button class="btn-admin" type="button" id="appointmentExceptionAdd">Agregar regla</button>
            </div>
            <div id="appointmentExceptionsList" class="repair-appointments-list"></div>
          </div>
        </section>

        <!-- â•â•â• VISTA ENSAMBLES (BUILDS) â•â•â• -->
        <section id="view-builds" class="admin-section" style="display:none;">
          <div class="admin-section-header">
            <h2>Catálogo de Ensambles y Paquetes</h2>
            <button class="btn-admin btn-approve" type="button" onclick="window.openBuildModal && openBuildModal()">
              <i class="fa-solid fa-plus"></i> Nuevo Ensamble
            </button>
          </div>
          <div class="admin-grid" id="builds-grid">
            <div class="empty-state full-grid">No hay ensambles creados.</div>
          </div>
        </section>

        <!-- â•â•â• VISTA COMENTARIOS â•â•â• -->
        <section id="view-comments" class="admin-section" style="display:none;">
          <div class="admin-section-header">
            <h2>Moderación de Comentarios</h2>
          </div>
          <div class="filters">
            <button class="filter-btn active" type="button" data-filter="all">Todos</button>
            <button class="filter-btn" type="button" data-filter="pending">Pendientes</button>
            <button class="filter-btn" type="button" data-filter="approved">Aprobados</button>
          </div>
          <div class="admin-grid" id="comments-grid"></div>
        </section>

        <!-- â•â•â• VISTA USUARIOS â•â•â• -->
        <section id="view-users" class="admin-section" style="display:none;">
          <div class="admin-section-header">
            <h2>Usuarios Registrados</h2>
          </div>
          <div class="users-table-wrapper">
            <table class="users-table">
              <thead>
                <tr>
                  <th>Usuario</th>
                  <th>Email</th>
                  <th>Celular</th>
                  <th>Rol</th>
                  <th>Fecha de Registro</th>
                </tr>
              </thead>
              <tbody id="users-tbody"></tbody>
            </table>
          </div>
        </section>

        <!-- â•â•â• VISTA FAQs â•â•â• -->
        <section id="view-faqs" class="admin-section" style="display:none;">
          <div class="admin-section-header">
            <h2>Búsquedas sin respuesta</h2>
            <button class="btn-admin btn-delete" type="button" onclick="window.clearUnanswered && clearUnanswered()">
              <i class="fa-solid fa-trash"></i> Limpiar Registro
            </button>
          </div>
          <div class="users-table-wrapper" style="margin-bottom:32px;">
            <table class="users-table">
              <thead>
                <tr>
                  <th>Término Buscado</th>
                  <th>Búsquedas</th>
                  <th>Última Vez</th>
                  <th>Acción</th>
                </tr>
              </thead>
              <tbody id="unanswered-tbody"></tbody>
            </table>
          </div>

          <div class="admin-section-header">
            <h2>Gestionar Preguntas Frecuentes</h2>
            <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
              <input type="text" id="faqSearchInput" class="faq-search-bar" placeholder="Buscar pregunta…" aria-label="Buscar pregunta" />
              <select id="faqCategoryFilter" class="faq-search-bar" aria-label="Filtrar categoria">
                <option value="all">Todas las categorias</option>
              </select>
              <button class="btn-admin" type="button" id="faqExpandAll">
                <i class="fa-solid fa-chevron-down"></i> Abrir todas
              </button>
              <button class="btn-admin" type="button" id="faqCollapseAll">
                <i class="fa-solid fa-chevron-up"></i> Cerrar todas
              </button>
              <button class="btn-admin btn-approve" type="button" onclick="window.addNewFaq && addNewFaq()">
                <i class="fa-solid fa-plus"></i> Nueva
              </button>
            </div>
          </div>
          <div class="admin-filter-summary" id="faqFilterSummary">Categorias comprimidas. Abre una para ver sus preguntas.</div>
          <div id="faqs-container"></div>
        </section>

      </div>
    </main>
  </div>

