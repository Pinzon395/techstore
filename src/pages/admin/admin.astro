  <!-- ═══════════════════════════════════════════════════════════════
       SIDEBAR INTERACTIONS — hover-expand + tab switching + mobile
  ═══════════════════════════════════════════════════════════════ -->
  <script is:inline>
    (function () {
      const shell = document.getElementById('admin-shell');
      const sidebar = document.getElementById('admin-sidebar');
      const mobileToggle = document.getElementById('adminMobileToggle');
      const pageTitle = document.getElementById('admin-page-title');
      const subtitle  = document.getElementById('admin-subtitle');

      // Hover-expand: en desktop, al pasar el cursor sobre la sidebar se expande.
      // Al salir, vuelve a colapsada. En mobile se ignora (se usa toggle).
      let hoverTimer = null;
      function isDesktop() { return window.innerWidth >= 1024; }

      sidebar.addEventListener('mouseenter', () => {
        if (!isDesktop()) return;
        clearTimeout(hoverTimer);
        shell.classList.remove('sb-collapsed');
        shell.classList.add('sb-hover');
      });
      sidebar.addEventListener('mouseleave', () => {
        if (!isDesktop()) return;
        clearTimeout(hoverTimer);
        // Pequeño delay para evitar flicker al salir y volver a entrar
        hoverTimer = setTimeout(() => {
          shell.classList.add('sb-collapsed');
          shell.classList.remove('sb-hover');
        }, 180);
      });

      // Tab switching
      const VIEW_TITLES = {
        dashboard: { title: 'Dashboard',            sub: 'Revisa, aprueba y gestiona tu plataforma.' },
        repairs:   { title: 'Taller (Tickets)',     sub: 'Tickets de reparación activos y completados.' },
        commerce:  { title: 'Commerce',             sub: 'Centro de operaciones comerciales de Pixon PC.' },
        'commerce-store': { title: 'Tienda',        sub: 'Catálogo central, publicación y contenido comercial.' },
        'commerce-dashboard': { title: 'Ventas', sub: 'Métricas comerciales y actividad confirmada.' },
        'commerce-orders': { title: 'Pedidos', sub: 'Pagos, seguimiento y estados de pedidos.' },
        'commerce-payments': { title: 'Pagos', sub: 'Comprobantes pendientes, revisados y rechazados.' },
        'commerce-inventory': { title: 'Inventario', sub: 'Existencias, reservas y movimientos.' },
        'commerce-promotions': { title: 'Promociones', sub: 'Descuentos activos, programados y finalizados.' },
        'commerce-settings': { title: 'Métodos de pago', sub: 'Configuración bancaria y opciones de cobro.' },
        builds:    { title: 'Ensambles',            sub: 'Catálogo de ensambles y paquetes ofertados.' },
        comments:  { title: 'Comentarios',          sub: 'Modera reseñas pendientes y aprobadas.' },
        users:     { title: 'Usuarios',             sub: 'Lista de usuarios registrados y roles.' },
        faqs:      { title: 'Preguntas Frecuentes', sub: 'Gestiona FAQs y revisa búsquedas sin respuesta.' },
      };

      const COMMERCE_ROUTES = {
        commerce: '/admin/commerce',
        'commerce-store': '/admin/commerce/store',
        'commerce-dashboard': '/admin/commerce/sales',
        'commerce-orders': '/admin/commerce/orders',
        'commerce-payments': '/admin/commerce/payments',
        'commerce-inventory': '/admin/commerce/inventory',
        'commerce-promotions': '/admin/commerce/promotions',
        'commerce-settings': '/admin/commerce/payment-methods',
      };
      const ROUTE_VIEWS = Object.fromEntries(Object.entries(COMMERCE_ROUTES).map(([view, path]) => [path, view]));

      function switchView(view, options = {}) {
        if (!VIEW_TITLES[view]) return;
        document.querySelectorAll('.nav-link[data-view]').forEach(l => {
          const isActive = l.dataset.view === view;
          l.classList.toggle('active', isActive);
          if (isActive) l.setAttribute('aria-current', 'page');
          else l.removeAttribute('aria-current');
        });
        document.querySelectorAll('.commerce-module-card[data-view-target]').forEach(card => {
          if (card.dataset.viewTarget === view) card.setAttribute('aria-current', 'page');
          else card.removeAttribute('aria-current');
        });
        document.querySelectorAll('.admin-section').forEach(s => {
          s.style.display = (s.id === 'view-' + view) ? '' : 'none';
        });
        const meta = VIEW_TITLES[view];
        if (meta) {
          pageTitle.textContent = meta.title;
          subtitle.textContent  = meta.sub;
        }
        if (window.innerWidth < 1024) shell.classList.remove('sb-open');
        try { sessionStorage.setItem('admin_view', view); } catch (_) {}
        const nextUrl = COMMERCE_ROUTES[view] || ('/admin#' + view);
        if (location.pathname + location.hash !== nextUrl) {
          const method = options.replace ? 'replaceState' : 'pushState';
          history[method]({ adminView: view }, '', nextUrl);
        }
        window.dispatchEvent(new CustomEvent('admin:switch-view', { detail: { view } }));
      }

      document.querySelectorAll('.nav-link[data-view]').forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          switchView(link.dataset.view);
        });
      });

      document.querySelectorAll('[data-view-target]').forEach(button => {
        button.addEventListener('click', (event) => {
          event.preventDefault();
          switchView(button.dataset.viewTarget);
          if (button.hasAttribute('data-open-repair')) {
            window.setTimeout(() => window.openRepairModal?.(), 0);
          }
        });
      });

      // Restaurar última vista
      try {
        const routeView = ROUTE_VIEWS[location.pathname.replace(/\/$/, '') || '/admin'];
        const hashView = location.hash.slice(1);
        const saved = sessionStorage.getItem('admin_view');
        if (routeView) switchView(routeView, { replace: true });
        else if (VIEW_TITLES[hashView]) switchView(hashView, { replace: true });
        else if (saved && VIEW_TITLES[saved]) switchView(saved, { replace: true });
      } catch (_) {}

      window.addEventListener('popstate', () => {
        const view = ROUTE_VIEWS[location.pathname.replace(/\/$/, '')] || location.hash.slice(1) || 'dashboard';
        switchView(VIEW_TITLES[view] ? view : 'dashboard', { replace: true });
      });

      // Mobile toggle
      mobileToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        shell.classList.toggle('sb-open');
      });
      document.addEventListener('click', (e) => {
        if (window.innerWidth < 1024 && shell.classList.contains('sb-open')) {
          if (!sidebar.contains(e.target) && e.target !== mobileToggle && !mobileToggle?.contains(e.target)) {
            shell.classList.remove('sb-open');
          }
        }
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && shell.classList.contains('sb-open')) {
          shell.classList.remove('sb-open');
          mobileToggle?.focus();
        }
      });

      // Llenar el bloque de usuario en sidebar tan pronto como /api/me responda.
      fetch('/api/me', { credentials: 'include' })
        .then(r => r.json())
        .then(data => {
          if (!data?.user) return;
          const u = data.user;
          const nameEl = document.getElementById('admin-user-name');
          const avatarEl = document.getElementById('admin-user-avatar');
          if (nameEl) nameEl.textContent = u.name || u.email || 'Admin';
          if (avatarEl) {
            if (u.avatar_url || u.avatar) {
              const img = document.createElement('img');
              img.src = u.avatar_url || u.avatar;
              img.alt = u.name || 'Admin';
              img.id = 'admin-user-avatar';
              avatarEl.replaceWith(img);
            } else {
              avatarEl.textContent = (u.name || u.email || 'A').charAt(0).toUpperCase();
            }
          }
        })
        .catch(() => {});
    })();
  </script>

  <!-- Scripts del admin (sin estos, las pestañas/secciones no cargan datos) -->
  <!-- Live analytics: polling cada 10s, sparkline SVG manual (sin libs) -->
  <script is:inline>
    (function () {
      const cardEl    = document.getElementById('live-card');
      if (!cardEl) return;
      const activeEl  = document.getElementById('live-active');
      const winViews  = document.getElementById('live-window-views');
      const winVis    = document.getElementById('live-window-visitors');
      const updatedEl = document.getElementById('live-updated');
      const feedEl    = document.getElementById('live-feed');
      const svgEl     = document.getElementById('live-sparkline');

      function relTime(iso, nowTime) {
        const t = new Date(iso).getTime();
        const now = nowTime ? new Date(nowTime).getTime() : Date.now();
        const diffSec = Math.max(0, (now - t) / 1000);
        if (diffSec < 60)        return Math.floor(diffSec) + 's';
        if (diffSec < 3600)      return Math.floor(diffSec / 60) + ' min';
        if (diffSec < 86400)     return Math.floor(diffSec / 3600) + ' h';
        return Math.floor(diffSec / 86400) + ' d';
      }

      function renderSparkline(perMinute, windowMin, serverTime) {
        if (!svgEl) return;
        // Construir un array de 30 minutos (rellenar huecos con 0)
        const buckets = new Array(windowMin).fill(0);
        const now = serverTime ? new Date(serverTime).getTime() : Date.now();
        perMinute.forEach((p) => {
          const minute = new Date(p.minute).getTime();
          const ago = Math.floor((now - minute) / 60000);
          const idx = windowMin - 1 - ago;
          if (idx >= 0 && idx < windowMin) buckets[idx] = p.views;
        });
        const max = Math.max(1, ...buckets);
        const W = 600, H = 120;
        const barW = W / windowMin;
        let bars = '';
        for (let i = 0; i < windowMin; i++) {
          const v = buckets[i];
          const h = v === 0 ? 2 : Math.max(2, (v / max) * (H - 4));
          const x = i * barW + 1;
          const y = H - h;
          const op = v === 0 ? 0.18 : 0.85;
          bars += `<rect x="${x}" y="${y}" width="${Math.max(1, barW - 2)}" height="${h}" rx="2" fill="url(#liveGrad)" opacity="${op}"><title>${v} vista(s)</title></rect>`;
        }
        svgEl.innerHTML =
          '<defs><linearGradient id="liveGrad" x1="0" y1="0" x2="0" y2="1">' +
          '<stop offset="0%" stop-color="#22d3ee"/>' +
          '<stop offset="100%" stop-color="#0891b2"/>' +
          '</linearGradient></defs>' + bars;
      }

      function normalizeFeedPath(path) {
        const raw = String(path || '/').split('?')[0].replace(/\/+$/, '');
        return raw || '/';
      }

      function groupFeedItems(items, windowMinutes, serverTime) {
        const now = serverTime ? new Date(serverTime).getTime() : Date.now();
        const todayKey = new Date(now).toDateString();
        const windowMs = Number(windowMinutes || 30) * 60000;
        const grouped = new Map();

        items.forEach((item) => {
          const path = normalizeFeedPath(item.path);
          const seenValue = item.last_seen || item.created_at || new Date(now).toISOString();
          const seenAt = new Date(seenValue).getTime();
          const current = grouped.get(path) || {
            path,
            last_seen: seenValue,
            week_views: 0,
            today_views: 0,
            window_views: 0,
            total_views: 0,
          };
          const hasServerCounts = item.week_views !== undefined || item.today_views !== undefined || item.window_views !== undefined;

          if (hasServerCounts) {
            current.week_views += Number(item.week_views || 0);
            current.today_views += Number(item.today_views || 0);
            current.window_views += Number(item.window_views || 0);
            current.total_views += Number(item.total_views || item.week_views || 0);
          } else {
            current.week_views += 1;
            current.total_views += 1;
            if (new Date(seenAt).toDateString() === todayKey) current.today_views += 1;
            if (now - seenAt <= windowMs) current.window_views += 1;
          }

          if (!current.last_seen || seenAt > new Date(current.last_seen).getTime()) {
            current.last_seen = seenValue;
          }
          grouped.set(path, current);
        });

        return Array.from(grouped.values())
          .sort((a, b) => Number(b.week_views || 0) - Number(a.week_views || 0) || new Date(b.last_seen).getTime() - new Date(a.last_seen).getTime());
      }

      function renderFeed(items, windowMinutes, serverTime) {
        if (!feedEl) return;
        if (!items || !items.length) {
          feedEl.innerHTML = '<li class="empty-state">Aun no hay vistas registradas.</li>';
          return;
        }
        const groupedItems = groupFeedItems(items, windowMinutes, serverTime);
        feedEl.innerHTML = groupedItems.map((v) => {
          const path = normalizeFeedPath(v.path).replace(/[<>"']/g, '');
          const weekViews = Number(v.week_views || 0);
          const todayViews = Number(v.today_views || 0);
          const windowViews = Number(v.window_views || 0);
          const lastSeen = v.last_seen || v.created_at;
          return '<li class="live-feed-item live-feed-item--grouped">' +
            '<span class="live-feed-dot"></span>' +
            '<span class="live-feed-main">' +
              '<span class="live-feed-path" title="' + path + '">' + path + '</span>' +
              '<span class="live-feed-sub">última visita hace ' + relTime(lastSeen, serverTime) + '</span>' +
            '</span>' +
            '<span class="live-feed-metrics" aria-label="Conteos de visitas">' +
              '<span><strong>' + weekViews + '</strong></span>' +
              '<span><strong>' + todayViews + '</strong></span>' +
              '<span><strong>' + windowViews + '</strong></span>' +
            '</span>' +
          '</li>';
        }).join('');
      }

      let timer = null;
      async function tick() {
        try {
          const r = await fetch('/api/admin/analytics/live?window=30&limit=12', { credentials: 'include' });
          if (!r.ok) return;
          const data = await r.json();
          if (activeEl)  activeEl.textContent  = data.active ?? 0;
          const totalViews    = Number(data.window_views ?? (data.per_minute || []).reduce((s, p) => s + Number(p.views || 0), 0));
          const totalVisitors = Number(data.window_visitors ?? (data.per_minute || []).reduce((s, p) => s + Number(p.visitors || 0), 0));
          if (winViews) winViews.textContent = totalViews;
          if (winVis)   winVis.textContent   = totalVisitors;
          if (updatedEl) updatedEl.textContent = 'actualizado ' + new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
          renderSparkline(data.per_minute || [], data.window_minutes || 30, data.ts);
          renderFeed(data.grouped_pages || data.last_views || [], data.window_minutes || 30, data.ts);
        } catch (_) {}
      }

      // Iniciar y refrescar cada 10s solo si la pestaña Dashboard está visible
      function start() {
        tick();
        timer = setInterval(() => {
          const dash = document.getElementById('view-dashboard');
          if (dash && dash.style.display !== 'none' && document.visibilityState === 'visible') tick();
        }, 10000);
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start, { once: true });
      } else {
        start();
      }
    })();
  </script>

