---
/**
 * Admin Panel v2.1 — Sidebar lateral colapsada por default + hover-expand
 * - Solo logo circular en sidebar (sin texto al lado)
 * - Expandir al pasar el cursor o tocar
 * - body sin .light-theme (sin preload sprite, ya que el admin no lo usa)
 */
import Base from '../../layouts/Base.astro';
import CommerceHubView from '../../components/admin/CommerceHubView.astro';
import CommerceCatalogView from '../../components/admin/CommerceCatalogView.astro';
import CommerceOperationsView from '../../components/admin/CommerceOperationsView.astro';
import '../../styles/admin.css';
---

<Base
  title="Panel de Administración | Pixon PC"
  description="Panel administrativo Pixon PC"
  canonical="https://pixon.com.mx/admin"
  image="/LOGOCIRCULAR.png"
  bodyClass="admin-body"
  preloadSprite={false}
  robots="noindex, nofollow"
>
  <!-- Pantalla de carga mientras admin.js verifica permisos -->
  <div id="auth-loading">
    <i class="fa-solid fa-circle-notch fa-spin fa-2x" style="color: #22d3ee;"></i>
    <p>Verificando permisos…</p>
  </div>

  <div class="admin-shell sb-collapsed" id="admin-shell">

    <!-- ═══════════════════════════════════════════════════════════════
         SIDEBAR — colapsada por default (solo iconos + logo circular).
         Al hover, se expande temporalmente mostrando textos.
    ═══════════════════════════════════════════════════════════════ -->
    <aside class="admin-sidebar" id="admin-sidebar" data-collapsed="true">
      <a href="/" class="admin-brand" aria-label="Inicio Pixon PC" title="Pixon PC">
        <img src="/LOGOCIRCULAR.png" alt="Pixon PC" width="36" height="36" />
      </a>

      <nav class="admin-nav" aria-label="Navegación admin">
        <div class="nav-group">
          <p class="nav-section-title">Principal</p>
          <button class="nav-link active" type="button" data-view="dashboard" title="Dashboard" aria-controls="view-dashboard" aria-current="page">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-gauge-high" /></svg>
            <span class="nav-link-label">Dashboard</span>
          </button>
        </div>

        <div class="nav-group">
          <p class="nav-section-title">Gestión</p>
          <button class="nav-link" type="button" data-view="repairs" title="Taller (Tickets)" aria-controls="view-repairs">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-screwdriver-wrench" /></svg>
            <span class="nav-link-label">Taller (Tickets)</span>
          </button>
          <button class="nav-link" type="button" data-view="commerce" title="Commerce" aria-controls="view-commerce">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-cart-shopping" /></svg>
            <span class="nav-link-label">Commerce</span>
          </button>
          <button class="nav-link" type="button" data-view="commerce-store" title="Tienda" aria-controls="view-commerce-store"><svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-store" /></svg><span class="nav-link-label">Tienda</span></button>
          <button class="nav-link" type="button" data-view="commerce-dashboard" title="Ventas" aria-controls="view-commerce-dashboard"><svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-chart-line" /></svg><span class="nav-link-label">Ventas</span></button>
          <button class="nav-link" type="button" data-view="commerce-orders" title="Pedidos" aria-controls="view-commerce-orders"><svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-bag-shopping" /></svg><span class="nav-link-label">Pedidos</span><span class="badge warn" id="nav-badge-orders" style="display:none;">0</span></button>
          <button class="nav-link" type="button" data-view="commerce-payments" title="Pagos" aria-controls="view-commerce-payments"><svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-credit-card" /></svg><span class="nav-link-label">Pagos</span></button>
          <button class="nav-link" type="button" data-view="commerce-inventory" title="Inventario" aria-controls="view-commerce-inventory"><svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-boxes-stacked" /></svg><span class="nav-link-label">Inventario</span></button>
          <button class="nav-link" type="button" data-view="commerce-promotions" title="Promociones" aria-controls="view-commerce-promotions"><svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-tags" /></svg><span class="nav-link-label">Promociones</span></button>
          <button class="nav-link" type="button" data-view="commerce-settings" title="Métodos de pago" aria-controls="view-commerce-settings"><svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-credit-card" /></svg><span class="nav-link-label">Métodos de pago</span></button>
          <button class="nav-link" type="button" data-view="builds" title="Ensambles" aria-controls="view-builds">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-microchip" /></svg>
            <span class="nav-link-label">Ensambles</span>
          </button>
          <button class="nav-link" type="button" data-view="comments" title="Comentarios" aria-controls="view-comments">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-comments" /></svg>
            <span class="nav-link-label">Comentarios</span>
            <span class="badge warn" id="nav-badge-comments" style="display:none;">0</span>
          </button>
          <button class="nav-link" type="button" data-view="users" title="Usuarios" aria-controls="view-users">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-users-gear" /></svg>
            <span class="nav-link-label">Usuarios</span>
          </button>
          <button class="nav-link" type="button" data-view="faqs" title="Preguntas Frecuentes" aria-controls="view-faqs">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-circle-question" /></svg>
            <span class="nav-link-label">Preguntas Frecuentes</span>
          </button>
        </div>

        <div class="nav-group">
          <p class="nav-section-title">Sistema</p>
          <a href="/" class="nav-link" target="_blank" rel="noopener" title="Ver sitio público">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-arrow-right" /></svg>
            <span class="nav-link-label">Ver sitio público</span>
          </a>
        </div>
      </nav>

      <!-- Bloque de usuario actual -->
      <div class="admin-user-block" id="admin-user-block">
        <div class="admin-avatar-fallback" id="admin-user-avatar">A</div>
        <div class="admin-user-info">
          <span class="name" id="admin-user-name">Cargando…</span>
          <span class="role">Admin</span>
        </div>
      </div>

      <!-- Logout separado y con peso visual distinto al menú -->
      <a href="/auth/logout" class="admin-logout" title="Cerrar sesión">
        <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-power-off" /></svg>
        <span class="admin-logout-text">Cerrar sesión</span>
      </a>
    </aside>

    <!-- ═══════════════════════════════════════════════════════════════
         MAIN
    ═══════════════════════════════════════════════════════════════ -->
    <main class="admin-main">
      <header class="admin-topbar">
        <div class="admin-topbar-left">
          <button class="admin-mobile-toggle" id="adminMobileToggle" aria-label="Abrir menú">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-sliders" /></svg>
          </button>
          <div>
            <h1 class="admin-page-title" id="admin-page-title">Dashboard</h1>
            <p class="admin-page-sub" id="admin-subtitle">Revisa, aprueba y gestiona tu plataforma.</p>
          </div>
        </div>
        <div class="admin-topbar-right" style="display: flex; align-items: center; gap: 16px;">
          <div class="live-indicator" id="live-indicator" style="display:none;">
            <div class="live-dot"></div> En vivo
          </div>
          <!-- Centro de Notificaciones -->
          <div class="notifications-wrapper" id="notifications-wrapper">
            <button class="notifications-bell-btn" id="notificationsBellBtn" aria-label="Notificaciones" aria-expanded="false">
              <i class="fa-solid fa-bell"></i>
              <span class="notifications-badge" id="notifications-badge" style="display: none;">0</span>
            </button>
            <div class="notifications-dropdown" id="notificationsDropdown">
              <div class="notifications-dropdown-header">
                Notificaciones recientes
              </div>
              <div class="notifications-dropdown-body" id="notificationsDropdownBody">
                <div class="empty-state">No tienes notificaciones pendientes</div>
              </div>
            </div>
          </div>
          <div id="admin-user-area"></div>
        </div>
      </header>

      <div class="admin-content" id="admin-content">

        <!-- ═══ VISTA DASHBOARD ═══ -->
        <section id="view-dashboard" class="admin-section">
          <div class="dashboard-command dashboard-command--control">
            <div class="dashboard-command-copy">
              <span class="dashboard-eyebrow">Centro de mando</span>
              <h2>Situación del negocio</h2>
              <p id="dashboard-period-summary">Cargando datos reales del periodo…</p>
            </div>
            <div class="dashboard-controlbar">
              <div class="dashboard-period-control">
                <button type="button" class="dashboard-period-trigger" id="dashboard-period-trigger" aria-expanded="false" aria-controls="dashboard-period-popover">
                  <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-calendar-days" /></svg>
                  <span id="dashboard-period-label">Últimos 30 días</span>
                  <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                </button>
                <div class="dashboard-period-popover" id="dashboard-period-popover" hidden>
                  <div class="dashboard-period-presets" role="list" aria-label="Periodos frecuentes">
                    <button type="button" data-dashboard-preset="today">Hoy</button>
                    <button type="button" data-dashboard-preset="yesterday">Ayer</button>
                    <button type="button" data-dashboard-preset="last7">Últimos 7 días</button>
                    <button type="button" data-dashboard-preset="last30" aria-current="true">Últimos 30 días</button>
                    <button type="button" data-dashboard-preset="thisMonth">Este mes</button>
                    <button type="button" data-dashboard-preset="previousMonth">Mes anterior</button>
                    <button type="button" data-dashboard-preset="year">Año actual</button>
                  </div>
                  <form class="dashboard-custom-period" id="dashboard-custom-period">
                    <label>Desde<input type="date" id="dashboard-period-from" name="from" required /></label>
                    <label>Hasta<input type="date" id="dashboard-period-to" name="to" required /></label>
                    <button type="submit">Aplicar rango</button>
                  </form>
                </div>
              </div>
              <button type="button" class="dashboard-icon-action" id="dashboard-refresh-btn" aria-label="Actualizar Dashboard" title="Actualizar datos">
                <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-rotate-left" /></svg>
              </button>
              <button type="button" class="dashboard-action dashboard-action-primary" data-view-target="repairs" data-open-repair>
                <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-plus" /></svg><span>Nuevo ticket</span>
              </button>
            </div>
          </div>

          <div class="dashboard-status" id="dashboard-status" role="status" aria-live="polite"></div>

          <div class="dashboard-kpi-grid dashboard-kpi-grid--command" id="dashboard-kpis" aria-busy="true">
            {[
              ['sales', 'Ventas', 'Valor registrado, no dinero cobrado'],
              ['collected', 'Ingresos cobrados', 'Pagos aprobados menos reembolsos'],
              ['expenses', 'Gastos', 'Salidas expresamente registradas'],
              ['operating_profit', 'Utilidad', 'Ventas menos costos y gastos'],
              ['active_work', 'Órdenes activas', 'Trabajos que requieren acción'],
              ['ready', 'Por entregar', 'Listas para el cliente'],
              ['new_customers', 'Clientes nuevos', 'Primera aparición en el sistema'],
              ['average_ticket', 'Ticket promedio', 'Ventas por operación con importe']
            ].map(([key, label, help]) => (
              <button type="button" class="command-kpi is-loading" data-dashboard-kpi={key} aria-describedby={`kpi-help-${key}`}>
                <span class="command-kpi-label">{label}</span>
                <strong class="command-kpi-value" data-kpi-value>—</strong>
                <span class="command-kpi-change" data-kpi-change>Cargando…</span>
                <span class="sr-only" id={`kpi-help-${key}`}>{help}</span>
              </button>
            ))}
          </div>

          <div class="dashboard-primary-grid">
            <article class="command-panel command-panel--operations">
              <header class="command-panel-header">
                <div><span class="command-panel-kicker">Operación</span><h3>Flujo del taller</h3></div>
                <button type="button" class="command-link" data-view-target="repairs">Ver tickets <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
              </header>
              <div id="dashboard-operations" class="dashboard-panel-body dashboard-skeleton" aria-busy="true"></div>
            </article>

            <article class="command-panel command-panel--trend">
              <header class="command-panel-header">
                <div><span class="command-panel-kicker">Tendencia</span><h3 id="dashboard-series-title">Ingresos en el tiempo</h3></div>
                <div class="dashboard-series-tabs" role="group" aria-label="Serie visible">
                  <button type="button" data-dashboard-series="collected" aria-pressed="true">Ingresos</button>
                  <button type="button" data-dashboard-series="sales" aria-pressed="false">Ventas</button>
                  <button type="button" data-dashboard-series="tickets" aria-pressed="false">Órdenes</button>
                  <button type="button" data-dashboard-series="views" aria-pressed="false">Tráfico</button>
                </div>
              </header>
              <div id="dashboard-series" class="dashboard-panel-body dashboard-skeleton" aria-busy="true"></div>
            </article>
          </div>

          <div class="dashboard-secondary-grid" id="dashboard-secondary">
            <details class="command-disclosure" open>
              <summary><span><i class="fa-solid fa-wallet" aria-hidden="true"></i> Finanzas</span><span class="disclosure-summary" data-dashboard-summary="finance">Cargando…</span></summary>
              <div class="disclosure-body" id="dashboard-finance" aria-busy="true"><div class="dashboard-skeleton"><span></span><span></span><span></span></div></div>
            </details>
            <details class="command-disclosure">
              <summary><span><i class="fa-solid fa-users" aria-hidden="true"></i> Clientes y citas</span><span class="disclosure-summary" data-dashboard-summary="customers">Cargando…</span></summary>
              <div class="disclosure-body" id="dashboard-customers"></div>
            </details>
            <details class="command-disclosure">
              <summary><span><i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i> Servicios y técnicos</span><span class="disclosure-summary" data-dashboard-summary="services">Cargando…</span></summary>
              <div class="disclosure-body" id="dashboard-services"></div>
            </details>
            <details class="command-disclosure">
              <summary><span><i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i> Inventario y piezas</span><span class="disclosure-summary" data-dashboard-summary="inventory">Cargando…</span></summary>
              <div class="disclosure-body" id="dashboard-inventory"></div>
            </details>
            <details class="command-disclosure command-disclosure--wide">
              <summary><span><i class="fa-solid fa-chart-line" aria-hidden="true"></i> Tráfico web</span><span class="disclosure-summary" data-dashboard-summary="traffic">Cargando…</span></summary>
              <div class="disclosure-body" id="dashboard-traffic"></div>
              <div class="live-card" id="live-card">
                <div class="live-card-head">
                  <h3><span class="live-pulse" aria-hidden="true"></span> Actividad en vivo</h3>
                  <div class="live-card-stats">
                    <div class="live-stat"><span class="live-stat-num" id="live-active">—</span><span class="live-stat-label">viendo ahora</span></div>
                    <div class="live-stat"><span class="live-stat-num" id="live-window-views">—</span><span class="live-stat-label">vistas en 30 min</span></div>
                    <div class="live-stat"><span class="live-stat-num" id="live-window-visitors">—</span><span class="live-stat-label">visitantes</span></div>
                  </div>
                </div>
                <div class="live-spark-wrap">
                  <svg id="live-sparkline" class="live-spark" viewBox="0 0 600 120" preserveAspectRatio="none" aria-label="Vistas por minuto en los últimos 30 minutos"></svg>
                  <div class="live-spark-axis"><span>-30 min</span><span>-15 min</span><span>ahora</span></div>
                </div>
                <div class="live-feed-head"><span>Páginas vistas agrupadas</span><small id="live-updated">—</small></div>
                <div class="live-feed-legend" aria-label="Métricas de páginas agrupadas"><span>Semana</span><span>Hoy</span><span>30 min</span></div>
                <ul class="live-feed" id="live-feed"><li class="empty-state">Cargando…</li></ul>
              </div>
            </details>
          </div>

          <details class="dashboard-data-quality" id="dashboard-data-quality" hidden>
            <summary>Fuentes pendientes de configurar <span data-quality-count></span></summary>
            <ul data-quality-list></ul>
          </details>
        </section>

        <!-- ═══ VISTA TALLER (REPAIRS) ═══ -->
        <section id="view-repairs" class="admin-section" style="display:none;">
          <div class="admin-section-header">
            <h2>Tickets de Reparación</h2>
            <div style="display:flex;gap:10px;flex-wrap:wrap;">
              <button class="btn-admin" type="button" id="repairTabTickets"><i class="fa-solid fa-list"></i> Tickets</button>
              <button class="btn-admin" type="button" id="repairTabAgenda"><i class="fa-solid fa-calendar-days"></i> Agenda</button>
              <button class="btn-admin" type="button" id="repairTabConfig"><i class="fa-solid fa-gear"></i> Configurar agenda</button>
              <button class="btn-admin btn-approve" type="button" onclick="window.openRepairModal && openRepairModal()">
                <i class="fa-solid fa-plus"></i> Nuevo Ticket
              </button>
            </div>
          </div>
          <div id="repairTicketsPanel">
            <div class="admin-filter-panel repair-filter-panel" aria-label="Filtros de tickets" style="display: flex; gap: 12px; flex-wrap: wrap; align-items: flex-end; margin-bottom: 16px;">
              <div class="admin-filter-field" style="flex: 2; min-width: 200px;">
                <label for="repairSearchInput" style="font-weight: 700; margin-bottom: 4px; display: block; font-size: 0.8rem; color: var(--a-text-muted);">Buscar por término</label>
                <input type="search" id="repairSearchInput" class="admin-input" placeholder="Folio, cliente, teléfono, falla..." style="width: 100%;" />
              </div>
              <div class="admin-filter-field" style="flex: 1; min-width: 130px;">
                <label for="repairStatusFilter" style="font-weight: 700; margin-bottom: 4px; display: block; font-size: 0.8rem; color: var(--a-text-muted);">Estado</label>
                <select id="repairStatusFilter" class="admin-input" style="width: 100%;"></select>
              </div>
              <div class="admin-filter-field" style="flex: 1; min-width: 130px;">
                <label for="repairUrgencyFilter" style="font-weight: 700; margin-bottom: 4px; display: block; font-size: 0.8rem; color: var(--a-text-muted);">Prioridad</label>
                <select id="repairUrgencyFilter" class="admin-input" style="width: 100%;"></select>
              </div>
              <div class="admin-filter-field" style="flex: 1; min-width: 130px;">
                <label for="repairDeviceFilter" style="font-weight: 700; margin-bottom: 4px; display: block; font-size: 0.8rem; color: var(--a-text-muted);">Dispositivo</label>
                <select id="repairDeviceFilter" class="admin-input" style="width: 100%;"></select>
              </div>
              <div class="admin-filter-field" style="flex: 1; min-width: 130px;">
                <label for="repairServiceFilter" style="font-weight: 700; margin-bottom: 4px; display: block; font-size: 0.8rem; color: var(--a-text-muted);">Servicio</label>
                <select id="repairServiceFilter" class="admin-input" style="width: 100%;"></select>
              </div>
              <div style="display: flex; gap: 8px;">
                <button type="button" class="btn-admin admin-filter-clear" id="repairClearFilters" style="height: 38px;">
                  <i class="fa-solid fa-rotate-left"></i> Limpiar
                </button>
                <button type="button" class="btn-admin" id="crmExportCsv" style="height: 38px; background: rgba(34, 211, 238, 0.1); border-color: var(--a-cyan); color: var(--a-cyan);">
                  <i class="fa-solid fa-file-csv"></i> Exportar
                </button>
              </div>
            </div>

            <div class="admin-filter-summary" id="repairFilterSummary" style="font-size: 0.85rem; color: var(--a-text-dim); margin-bottom: 12px;">Mostrando todos los tickets.</div>

            <!-- CRM Table Premium Container -->
            <div class="crm-table-container">
              <div class="crm-table-wrapper">
                <table class="crm-table">
                  <thead>
                    <tr>
                      <th style="width: 40px; text-align: center;"><input type="checkbox" id="crmSelectAll" /></th>
                      <th>Folio</th>
                      <th>Cliente</th>
                      <th>Dispositivo</th>
                      <th>Falla Reportada</th>
                      <th>Prioridad</th>
                      <th>Estatus</th>
                      <th>Fecha</th>
                      <th style="text-align: right;">Acciones</th>
                    </tr>
                  </thead>
                  <tbody id="repairs-tbody">
                    <tr><td colspan="9" class="empty-row" style="text-align: center; padding: 30px; color: var(--a-text-dim);">Cargando expediente de taller...</td></tr>
                  </tbody>
                </table>
              </div>

              <!-- CRM Pagination -->
              <div class="crm-pagination">
                <div style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--a-text-muted);">
                  <span>Mostrar</span>
                  <select id="crmPageSize" class="admin-input" style="padding: 4px 8px; width: 70px; height: auto;">
                    <option value="10">10</option>
                    <option value="25" selected>25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                  </select>
                  <span>filas por página</span>
                </div>
                <div style="display: flex; align-items: center; gap: 12px;">
                  <span id="crmPaginationInfo" style="font-size: 0.85rem; color: var(--a-text-muted);">0 - 0 de 0</span>
                  <div style="display: flex; gap: 6px;">
                    <button class="btn-admin" id="crmPrevPage" style="padding: 4px 8px; height: auto;" disabled><i class="fa-solid fa-chevron-left"></i></button>
                    <button class="btn-admin" id="crmNextPage" style="padding: 4px 8px; height: auto;" disabled><i class="fa-solid fa-chevron-right"></i></button>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div id="repairAgendaPanel" class="admin-card repair-agenda-panel" style="display:none;">
            <div class="admin-section-header">
              <h2>Agenda de citas</h2>
              <div style="display:flex;gap:10px;flex-wrap:wrap;">
                <input id="appointmentFrom" class="admin-input" type="date" />
                <input id="appointmentTo" class="admin-input" type="date" />
                <button class="btn-admin" type="button" id="appointmentRefresh"><i class="fa-solid fa-rotate"></i> Actualizar</button>
              </div>
            </div>
            <div class="filters" id="appointmentFilters">
              <button class="filter-btn active" type="button" data-appointment-filter="today">Hoy</button>
              <button class="filter-btn" type="button" data-appointment-filter="week">Esta semana</button>
              <button class="filter-btn" type="button" data-appointment-filter="upcoming">Proximas</button>
              <button class="filter-btn" type="button" data-appointment-filter="confirmada">Confirmadas</button>
