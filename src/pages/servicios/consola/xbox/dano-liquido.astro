---
import Base from '../../../../layouts/Base.astro';
import Navbar from '../../../../components/Navbar.astro';
import Footer from '../../../../components/Footer.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import FaqSection from '../../../../components/FaqSection.astro';
import ServiceTicketSection from '../../../../components/ServiceTicketSection.astro';
import XboxLiquidRequestForm from '../../../../components/XboxLiquidRequestForm.astro';
import { buildBreadcrumbSchema } from '../../../../lib/schema';

const canonical = 'https://pixon.com.mx/servicios/consola/xbox/dano-liquido';
const title = 'Reparación de Xbox Mojado en Cancún | Daño por Líquido | Pixon PC';
const description = 'Reparación de Xbox mojado en Cancún. Revisamos daño por agua, humedad, corrosión y sulfatación en Xbox Series X, Series S y Xbox One antes de cotizar.';
const whatsappMessage = `Hola Pixon PC. Necesito revisión para un Xbox mojado.

Modelo:
Qué líquido fue:
Síntoma:
Cuándo ocurrió:
Zona:
¿Sigue encendiendo?:`;
const whatsappUrl = `https://wa.me/529986690777?text=${encodeURIComponent(whatsappMessage)}`;

const immediateSteps = [
  ['No la enciendas ni la conectes', 'La energía puede agravar un corto o mover residuos de líquido hacia zonas sensibles. Déjala desconectada.'],
  ['No intentes probarla “solo para ver si prende”', 'Un encendido breve no confirma que esté bien y puede empeorar una condición de humedad o corrosión.'],
  ['No uses calor directo ni secadora', 'El calor directo puede desplazar residuos o afectar plásticos, adhesivos y componentes; no sustituye una revisión técnica.'],
  ['Solicita revisión lo antes posible', 'Agua, bebida, humedad o salitre no se comportan igual. El tipo de exposición y el tiempo importan para definir el siguiente paso.'],
];
const models = [
  ['Xbox Series X mojado', 'Revisamos el caso según el tipo de líquido, encendido, video, consumo y señales internas de humedad o residuos.'],
  ['Xbox Series S mojado', 'Una Series S expuesta a agua, bebida o humedad requiere diagnóstico antes de volver a conectarla, incluso si parece seca por fuera.'],
  ['Xbox One mojado', 'En Xbox One, One S u One X se valora el estado de fuente, placa, conectores, almacenamiento y zonas afectadas antes de cotizar.'],
];
const noPower = [
  ['Sin encendido', 'Puede existir protección, consumo anormal, daño en alimentación, residuos o corrosión. No se asume una sola causa.'],
  ['Prende y se apaga', 'Puede reaccionar a humedad, corto parcial, fuente o placa. Se revisa antes de seguir intentándolo.'],
  ['No da imagen', 'El líquido puede afectar más que el video; se revisa el contexto, puertos, alimentación y placa antes de atribuirlo a HDMI.'],
  ['No da señales de vida', 'Que no haya luz, sonido o respuesta no determina por sí solo el alcance del daño. Requiere inspección técnica.'],
];
const liquidTypes = [
  ['Agua dulce', 'Puede dejar humedad y minerales. La respuesta depende de cuánto entró, dónde llegó y si la consola se encendió después.'],
  ['Agua salada', 'El salitre puede acelerar corrosión y dejar residuos conductivos. Indica si el incidente fue cerca del mar, playa o una superficie costera.'],
  ['Bebidas', 'Refresco, café u otras bebidas pueden dejar residuos pegajosos aun cuando la carcasa parezca seca.'],
  ['Humedad ambiental', 'La exposición prolongada no es igual a un derrame, pero puede favorecer oxidación superficial o falsos contactos.'],
  ['Sulfatación y corrosión', 'Se revisan rastros, conectores y zonas afectadas para determinar si corresponde limpieza técnica, reparación adicional o detener el proceso.'],
];
const process = [['Inspección inicial', 'Modelo, líquido, tiempo transcurrido, síntomas y si se intentó encender.'], ['Desarmado y revisión interna', 'Se revisan zonas accesibles, conectores, placa y residuos cuando el caso lo requiere.'], ['Evaluación de corrosión', 'Se identifica si hay oxidación, sulfatación o evidencia que pueda afectar el alcance.'], ['Limpieza técnica', 'Se define únicamente cuando corresponde al diagnóstico y al estado de la consola.'], ['Pruebas y cotización', 'Explicamos hallazgos, riesgos, alcance y costo antes de avanzar con una reparación.']];
const price = [['Depende del modelo', 'Series X, Series S y Xbox One tienen diseños, componentes y accesos distintos.'], ['Depende del nivel de corrosión', 'El residuo, la humedad activa y las zonas alcanzadas cambian la complejidad.'], ['Depende del daño en placa o componentes', 'Un daño superficial no tiene el mismo alcance que un corto, conector o componente afectado.'], ['Depende de si fue agua, salitre o bebida', 'Cada líquido deja residuos y riesgos diferentes; por eso el incidente se documenta antes de cotizar.']];
const recovery = [['Qué factores ayudan', 'Desconectarla, evitar encendidos y pedir revisión pronto puede reducir el tiempo en que la humedad o los residuos permanecen en el interior.'], ['Qué factores empeoran el daño', 'Energía, calor directo, varios intentos de encendido, bebida azucarada, agua salada y retrasar la revisión pueden aumentar el riesgo.'], ['Qué pasa si lo siguieron usando', 'El uso posterior puede convertir un problema localizado en una falla de alimentación, video, placa o conectores. Se revisa el caso real, sin prometer recuperación.']];
const faqs = [
  { question: '¿Se puede reparar un Xbox mojado?', answer: 'Depende del modelo, el líquido, el tiempo, el estado interno y si se intentó encender. Primero revisamos evidencia de humedad, residuos, corrosión y componentes afectados antes de cotizar.' },
  { question: '¿Qué hago si mi Xbox se mojó?', answer: 'Desconéctala y no la enciendas para probarla. No uses secadora ni calor directo. Envía el modelo, el líquido involucrado, cuándo ocurrió y el síntoma para orientar la revisión.' },
  { question: '¿Qué pasa si mi Xbox se mojó y ya no prende?', answer: 'Puede haber humedad, corrosión, un corto o un problema de alimentación. No conecta la consola nuevamente: el diagnóstico permite conocer el alcance antes de decidir una reparación.' },
  { question: '¿Puedo conectarlo para probarlo?', answer: 'No es recomendable. Un intento de encendido puede agravar un corto o mover residuos en zonas sensibles.' },
  { question: '¿Qué pasa si le cayó refresco?', answer: 'Las bebidas pueden dejar residuos pegajosos y conductivos. Indica qué bebida fue y dónde cayó para que la revisión considere el tipo de residuo.' },
  { question: '¿Es diferente si fue agua salada?', answer: 'Sí. El salitre puede acelerar corrosión y dejar residuos que requieren revisión cuidadosa. No intentes limpiarla por fuera y volver a conectarla.' },
  { question: '¿Qué es la sulfatación?', answer: 'Es corrosión o residuo que puede aparecer en zonas metálicas, conectores o placa después de humedad o líquido. Su gravedad solo se define tras inspección.' },
  { question: '¿Qué tan rápido debo llevarlo?', answer: 'Conviene solicitar orientación lo antes posible, sin encenderla ni aplicarle calor. El tiempo y los intentos de uso son parte del diagnóstico.' },
  { question: '¿Cuánto cuesta reparar un Xbox mojado?', answer: 'El costo depende del modelo, líquido, corrosión, componentes afectados y si hubo corto. Se confirma después de la revisión, no con un precio fijo genérico.' },
  { question: '¿Atienden Xbox Series X, Series S y Xbox One?', answer: 'Sí, revisamos solicitudes para Xbox Series X, Series S y Xbox One según falla, estado y disponibilidad del caso.' },
  { question: '¿Atienden Zona Hotelera y Costa Mujeres?', answer: 'Podemos revisar solicitudes por WhatsApp y confirmar la modalidad según zona, propiedad, acceso y disponibilidad. No se promete acceso directo a habitaciones.' },
  { question: '¿Dan diagnóstico antes de reparar?', answer: 'Sí. Explicamos los hallazgos, alcance y opciones antes de autorizar trabajo adicional.' },
];
const schema = [{ '@context': 'https://schema.org', '@type': 'Service', '@id': `${canonical}#service`, name: 'Reparación de Xbox mojado en Cancún', serviceType: 'Diagnóstico y reparación de daño por líquido en Xbox', description, url: canonical, provider: { '@id': 'https://pixon.com.mx/#business' }, areaServed: [{ '@type': 'City', name: 'Cancún' }, { '@type': 'Place', name: 'Zona Hotelera' }, { '@type': 'Place', name: 'Puerto Cancún' }, { '@type': 'Place', name: 'Huayacán' }, { '@type': 'Place', name: 'Cumbres' }] }, buildBreadcrumbSchema([{ name: 'Inicio', url: '/' }, { name: 'Servicios', url: '/servicios' }, { name: 'Consolas', url: '/servicios/consola' }, { name: 'Reparación Xbox', url: '/servicios/consola/reparacion-xbox' }, { name: 'Xbox mojado', url: canonical }])].filter(Boolean) as object[];
---

<Base title={title} description={description} canonical={canonical} image="/assets/images/xbox.webp" ogTitle={title} ogDescription={description} schema={schema} bodyClass="xbox-liquid-page">
  <Navbar />
  <main>
    <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Servicios', href: '/servicios' }, { label: 'Consolas', href: '/servicios/consola' }, { label: 'Xbox', href: '/servicios/consola/reparacion-xbox' }, { label: 'Daño por líquido' }]} />
    <header class="xl-hero" aria-labelledby="xl-title"><div class="container xl-hero__grid"><div class="xl-hero__copy"><p class="xl-kicker"><i class="fa-solid fa-droplet" aria-hidden="true"></i> Daño por líquido en Xbox · Cancún</p><h1 id="xl-title">Reparación de Xbox mojado en Cancún</h1><p>Si tu Xbox se mojó, le cayó agua, bebida o estuvo expuesto a humedad, no lo enciendas ni lo conectes. Revisamos corrosión, sulfatación y daño interno antes de cotizar.</p><div class="xl-actions"><a class="xl-btn xl-btn--primary" href="#solicitar-revision"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Solicitar revisión</a><a class="xl-btn xl-btn--ghost" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Explicar mi caso por WhatsApp</a></div><ul><li>Xbox Series X</li><li>Xbox Series S</li><li>Xbox One</li><li>Diagnóstico antes de reparar</li></ul></div>
      <div class="xl-hero__visual-container">
        <figure class="xl-visual" aria-hidden="true">
          <svg viewBox="0 0 540 450" focusable="false" class="xl-xbox-svg">
            <defs>
              <!-- Gradients for Xbox Series X -->
              <linearGradient id="xb-front-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#102b48" />
                <stop offset="40%" stop-color="#091c30" />
                <stop offset="100%" stop-color="#040e1a" />
              </linearGradient>
              <linearGradient id="xb-side-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#08182b" />
                <stop offset="100%" stop-color="#030a13" />
              </linearGradient>
              <linearGradient id="xb-top-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#0c253f" />
                <stop offset="100%" stop-color="#051322" />
              </linearGradient>
              <linearGradient id="xb-grill-depth" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#10b981" stop-opacity="0.6" />
                <stop offset="100%" stop-color="#021422" stop-opacity="0.9" />
              </linearGradient>
              <linearGradient id="xb-pad-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#133352" />
                <stop offset="100%" stop-color="#081829" />
              </linearGradient>
              <linearGradient id="xb-water-grad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#7dd3fc" />
                <stop offset="100%" stop-color="#0284c7" />
              </linearGradient>
              <linearGradient id="xb-scan-grad" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#38bdf8" stop-opacity="0" />
                <stop offset="25%" stop-color="#38bdf8" stop-opacity="0.9" />
                <stop offset="50%" stop-color="#ffffff" />
                <stop offset="75%" stop-color="#38bdf8" stop-opacity="0.9" />
                <stop offset="100%" stop-color="#38bdf8" stop-opacity="0" />
              </linearGradient>
              <linearGradient id="xb-check-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#10b981" />
                <stop offset="100%" stop-color="#047857" />
              </linearGradient>

              <!-- Glow Filters -->
              <filter id="xb-shadow" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="10" stdDeviation="12" flood-color="#01070e" flood-opacity="0.6" />
              </filter>
              <filter id="xb-glow-cyan" x="-30%" y="-30%" width="160%" height="160%">
                <feDropShadow dx="0" dy="0" stdDeviation="6" flood-color="#38bdf8" flood-opacity="0.8" />
              </filter>
              <filter id="xb-glow-amber" x="-30%" y="-30%" width="160%" height="160%">
                <feDropShadow dx="0" dy="0" stdDeviation="6" flood-color="#f59e0b" flood-opacity="0.85" />
              </filter>
              <filter id="xb-glow-green" x="-30%" y="-30%" width="160%" height="160%">
                <feDropShadow dx="0" dy="0" stdDeviation="8" flood-color="#10b981" flood-opacity="0.9" />
              </filter>
            </defs>

            <!-- Radial Background Glow -->
            <ellipse cx="260" cy="220" rx="190" ry="170" fill="#0b2a47" opacity="0.4" />

            <!-- Perspective Base Shadow -->
            <ellipse cx="265" cy="405" rx="175" ry="24" fill="#01070e" opacity="0.75" />

            <!-- ==================== XBOX SERIES X MONOLITH ==================== -->
            <g class="xb-console-group" filter="url(#xb-shadow)">

              <!-- 1. RIGHT SIDE FACET (3D Extrusion) -->
              <path class="xb-side-face" d="M 285 92 L 342 72 L 342 362 L 285 385 Z" fill="url(#xb-side-grad)" stroke="#1a466d" stroke-width="1" />

              <!-- 2. TOP CONCAVE EXHAUST GRILL -->
              <g class="xb-top-grill">
                <!-- Top Parallelogram Lid -->
                <path d="M 175 92 L 232 72 L 342 72 L 285 92 Z" fill="url(#xb-top-grad)" stroke="#1e5482" stroke-width="1.2" />
                <!-- Concave Dish Depression Accent -->
                <path d="M 195 88 Q 255 98 320 78 Q 260 72 195 88 Z" fill="url(#xb-grill-depth)" />
                <!-- Characteristic Vent Array Holes (Hexagonal Dot Grid) -->
                <g class="xb-grill-dots" fill="#051422" stroke="#16466e" stroke-width="0.5">
                  <circle cx="210" cy="85" r="2.2" />
                  <circle cx="225" cy="83" r="2.4" />
                  <circle cx="240" cy="81" r="2.6" />
                  <circle cx="255" cy="79" r="2.8" />
                  <circle cx="270" cy="78" r="2.8" />
                  <circle cx="285" cy="77" r="2.6" />
                  <circle cx="300" cy="76" r="2.4" />
                  <circle cx="315" cy="75" r="2.2" />

                  <circle cx="205" cy="89" r="2" />
                  <circle cx="220" cy="87" r="2.4" />
                  <circle cx="235" cy="85" r="2.7" />
                  <circle cx="250" cy="83" r="3" />
                  <circle cx="265" cy="82" r="3" />
                  <circle cx="280" cy="81" r="2.8" />
                  <circle cx="295" cy="80" r="2.5" />
                  <circle cx="310" cy="79" r="2.1" />
                </g>
              </g>

              <!-- 3. INTERNAL X-RAY CIRCUIT BOARD LAYER (Revealed during States 3-6) -->
              <g class="xb-internal-layer">
                <!-- Board substrate -->
                <rect x="180" y="98" width="100" height="280" fill="#041220" />
                <!-- Copper Heatpipes & Vapor chamber routing -->
                <path d="M 215 110 V 160 Q 215 175 230 175 H 245 Q 260 175 260 190 V 270" fill="none" stroke="#b45309" stroke-width="3.5" opacity="0.65" stroke-linecap="round" />
                <path d="M 245 110 V 150 Q 245 165 230 165 H 205 V 260" fill="none" stroke="#b45309" stroke-width="2.5" opacity="0.5" stroke-linecap="round" />
                
                <!-- Main APU SoC Package -->
                <rect x="212" y="180" width="46" height="46" rx="4" fill="#08233a" stroke="#22d3ee" stroke-width="1.2" />
                <rect x="220" y="188" width="30" height="30" rx="2" fill="#031422" stroke="#38bdf8" stroke-width="0.8" />
                <!-- Memory GDDR6 chips around APU -->
                <rect x="194" y="183" width="12" height="18" rx="1.5" fill="#0a2a46" />
                <rect x="194" y="205" width="12" height="18" rx="1.5" fill="#0a2a46" />
                <rect x="264" y="183" width="12" height="18" rx="1.5" fill="#0a2a46" />
                <rect x="264" y="205" width="12" height="18" rx="1.5" fill="#0a2a46" />
                
                <!-- Top Whisper Fan Silhouette -->
                <circle cx="232" cy="128" r="18" fill="none" stroke="#0ea5e9" stroke-width="1.2" stroke-dasharray="4 4" opacity="0.7" />

                <!-- Ingress Liquid Flow Path inside Chassis -->
                <path class="xb-liquid-path" d="M 252 88 V 135 Q 252 155 235 165 L 222 188 Q 212 205 218 225 L 235 255 V 300" fill="none" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" pathLength="100" />

                <!-- Circuit Moisture / Corrosion Nodes -->
                <g class="xb-corrosion-nodes">
                  <!-- Node 1: Fan & Power Stage -->
                  <g class="xb-node xb-node--1" transform="translate(235, 142)">
                    <circle class="xb-node-halo" r="8" fill="#f59e0b" opacity="0.3" />
                    <circle class="xb-node-core" r="3.5" fill="#38bdf8" />
                  </g>
                  <!-- Node 2: APU Main Power VRM Choke -->
                  <g class="xb-node xb-node--2" transform="translate(222, 192)">
                    <circle class="xb-node-halo" r="10" fill="#f59e0b" opacity="0.4" />
                    <circle class="xb-node-core" r="4" fill="#38bdf8" />
                  </g>
                  <!-- Node 3: HDMI / Display Power Rail -->
                  <g class="xb-node xb-node--3" transform="translate(225, 242)">
                    <circle class="xb-node-halo" r="9" fill="#f59e0b" opacity="0.35" />
                    <circle class="xb-node-core" r="3.8" fill="#38bdf8" />
                  </g>
                  <!-- Node 4: Southbridge / Standby Controller -->
                  <g class="xb-node xb-node--4" transform="translate(250, 275)">
                    <circle class="xb-node-halo" r="8" fill="#f59e0b" opacity="0.3" />
                    <circle class="xb-node-core" r="3.5" fill="#38bdf8" />
                  </g>
                  <!-- Salt / Mineral Residue Micro-dots -->
                  <g class="xb-salt-residue" fill="#fef08a" opacity="0">
                    <circle cx="218" cy="190" r="1.5" />
                    <circle cx="228" cy="196" r="1.2" />
                    <circle cx="220" cy="246" r="1.4" />
                  </g>
                </g>
              </g>

              <!-- 4. FRONT CASING SHELL (Fades to 0.45 in X-Ray mode, opaque otherwise) -->
              <g class="xb-front-shell">
                <path d="M 175 92 L 285 92 L 285 385 L 175 385 Z" fill="url(#xb-front-grad)" stroke="#1a4d78" stroke-width="1.2" />
                <!-- Left Rim Light Glow -->
                <line x1="175" y1="92" x2="175" y2="385" stroke="#38bdf8" stroke-width="1.8" stroke-opacity="0.9" />

                <!-- Vertical Disc Slot -->
                <rect x="186" y="285" width="2.5" height="60" rx="1.2" fill="#040b12" stroke="#163854" stroke-width="0.6" />
                <!-- Eject Button -->
                <circle cx="187" cy="275" r="2.2" fill="#0e2a44" stroke="#22d3ee" stroke-width="0.6" />
                <!-- Front USB 3.0 Port -->
                <rect x="266" y="348" width="8" height="4.5" rx="1" fill="#040b12" stroke="#22d3ee" stroke-width="0.8" />
                <!-- Controller Sync Button -->
                <circle cx="270" cy="334" r="2" fill="#0e2a44" stroke="#22d3ee" stroke-width="0.6" />
              </g>

              <!-- 5. XBOX ILLUMINATED POWER BUTTON (Top Left) -->
              <g class="xb-power-group" transform="translate(196, 115)">
                <!-- Base housing -->
                <circle cx="0" cy="0" r="8" fill="#061626" stroke="#1e4e79" stroke-width="1" />
                <!-- Glowing Power Logo Symbol -->
                <g class="xb-power-logo">
                  <circle cx="0" cy="0" r="6" fill="#38bdf8" filter="url(#xb-glow-cyan)" />
                  <!-- Xbox Sphere Cutout Curves -->
                  <path d="M -4.2 -4.2 Q 0 -1 4.2 -4.2 Q 1 0 4.2 4.2 Q 0 1 -4.2 4.2 Q -1 0 -4.2 -4.2 Z" fill="#051524" />
                </g>
                <!-- NO-POWER Red/Amber Warning Slash (Appears in State 5) -->
                <g class="xb-no-power-warning">
                  <circle cx="0" cy="0" r="10.5" fill="none" stroke="#f59e0b" stroke-width="2" filter="url(#xb-glow-amber)" />
                  <line x1="-7.5" y1="7.5" x2="7.5" y2="-7.5" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" />
                </g>
              </g>

              <!-- 6. PIXON TECHNICAL SCANNER LINE (Sweeps down in State 6) -->
              <g class="xb-scanner-group">
                <rect class="xb-scan-beam" x="170" y="90" width="180" height="4" rx="2" fill="url(#xb-scan-grad)" filter="url(#xb-glow-cyan)" />
                <line class="xb-scan-laser" x1="172" y1="92" x2="345" y2="92" stroke="#ffffff" stroke-width="1.5" />
              </g>

              <!-- 7. DIAGNOSIS READY STATE CHECKMARK BADGE (State 7) -->
              <g class="xb-ready-badge" filter="url(#xb-glow-green)" transform="translate(285, 80)">
                <circle cx="0" cy="0" r="18" fill="url(#xb-check-grad)" stroke="#ffffff" stroke-width="2" />
                <path d="M -8 0 L -2 6 L 9 -5" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              </g>

              <!-- Sparkle Twinkles (State 7) -->
              <g class="xb-sparkles">
                <path class="xb-sparkle xb-sparkle--1" d="M 175 92 Q 175 87 170 87 Q 175 87 175 82 Q 175 87 180 87 Q 175 87 175 92 Z" fill="#ffffff" filter="url(#xb-glow-cyan)" />
                <path class="xb-sparkle xb-sparkle--2" d="M 285 385 Q 285 380 280 380 Q 285 380 285 375 Q 285 380 290 380 Q 285 380 285 385 Z" fill="#ffffff" filter="url(#xb-glow-cyan)" />
              </g>
            </g>

            <!-- ==================== WATER DROPS & IMPACT ==================== -->
            <g class="xb-water-system">
              <!-- Main Droplet Falling from above -->
              <g class="xb-falling-drop">
                <path d="M 252 0 C 248 10 244 24 244 32 C 244 38 248 42 252 42 C 256 42 260 38 260 32 C 260 24 256 10 252 0 Z" fill="url(#xb-water-grad)" filter="url(#xb-glow-cyan)" />
              </g>
              <!-- Secondary Droplet -->
              <g class="xb-falling-drop-2">
                <circle cx="280" cy="20" r="3.5" fill="#38bdf8" />
              </g>
              <!-- Micro Splash Ripples on Grill Impact -->
              <g class="xb-splash-impact" transform="translate(252, 78)">
                <ellipse class="xb-splash-ring" cx="0" cy="0" rx="8" ry="3" fill="none" stroke="#38bdf8" stroke-width="1.5" />
                <circle class="xb-splash-dot xb-splash-dot--1" cx="-6" cy="-4" r="1.5" fill="#7dd3fc" />
                <circle class="xb-splash-dot xb-splash-dot--2" cx="6" cy="-5" r="1.5" fill="#7dd3fc" />
                <circle class="xb-splash-dot xb-splash-dot--3" cx="1" cy="-7" r="1.8" fill="#e0f2fe" />
              </g>
            </g>

            <!-- ==================== XBOX CONTROLLER (GAMEPAD COMPANION) ==================== -->
            <g class="xb-gamepad-group" filter="url(#xb-shadow)" transform="translate(75, 305)">
              <!-- Controller Outer Silhouette -->
