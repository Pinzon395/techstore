---
import Base from '../../../layouts/Base.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import ServiceTicketSection from '../../../components/ServiceTicketSection.astro';
---

<Base
  title="Cambio de pantalla de laptop en Cancún | Pixon PC"
  description="Cambiamos la pantalla de tu laptop en Cancún con pantallas certificadas. Diagnóstico gratis, garantía 6 meses. Servicio a domicilio disponible."
  canonical="https://pixon.com.mx/servicios/laptop/cambio-pantalla"
  image="/assets/images/cambio-pantalla-laptop-cancun.webp"
>
  <Navbar />

  <!-- Hero minimal -->
  <section style="background:linear-gradient(135deg,#0f172a 0%,#1e293b 60%,#0f172a 100%);padding:80px 20px 40px;text-align:center;">
    <div style="max-width:700px;margin:0 auto;">
      <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(59,130,246,0.15);border:1px solid rgba(59,130,246,0.3);border-radius:20px;padding:6px 16px;margin-bottom:20px;">
        <i class="fa-solid fa-display" style="color:#60a5fa;font-size:.85rem;"></i>
        <span style="color:#93c5fd;font-size:.85rem;font-weight:600;">Servicio especializado · Cancún</span>
      </div>
      <h1 style="color:#fff;font-family:'Kanit',sans-serif;font-size:clamp(1.8rem,5vw,2.8rem);font-weight:800;margin-bottom:16px;line-height:1.2;">
        Cambio de Pantalla para Laptop
      </h1>
      <p style="color:#94a3b8;font-size:1.05rem;line-height:1.7;margin-bottom:28px;">
        Pantallas originales y certificadas. Reparación el mismo día en la mayoría de modelos.
        Diagnóstico sin costo, garantía por escrito.
      </p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
        <a href="#ticket-form" style="background:linear-gradient(135deg,#3b82f6,#6366f1);color:#fff;padding:14px 28px;border-radius:10px;font-weight:700;text-decoration:none;font-size:1rem;">
          <i class="fa-solid fa-ticket"></i> Crear Ticket de Servicio
        </a>
        <a href="https://wa.me/529986690777?text=Hola%2C%20necesito%20cambio%20de%20pantalla%20para%20mi%20laptop"
           target="_blank" rel="noopener"
           style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.2);color:#fff;padding:14px 28px;border-radius:10px;font-weight:700;text-decoration:none;font-size:1rem;">
          <i class="fa-brands fa-whatsapp"></i> WhatsApp directo
        </a>
      </div>
    </div>
  </section>

  <!-- Info rápida -->
  <section style="background:#f1f5f9;padding:32px 20px;">
    <div style="max-width:900px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:20px;">
      {[
        { icon:'fa-magnifying-glass', label:'Diagnóstico', value:'Gratis' },
        { icon:'fa-clock', label:'Tiempo promedio', value:'2–4 horas' },
        { icon:'fa-shield-halved', label:'Garantía', value:'6 meses' },
        { icon:'fa-truck', label:'A domicilio', value:'Cancún' },
      ].map(item => (
        <div style="background:#fff;border-radius:12px;padding:20px;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,0.06);">
          <i class={`fa-solid ${item.icon}`} style="color:#3b82f6;font-size:1.4rem;margin-bottom:8px;display:block;"></i>
          <div style="font-size:.8rem;color:#64748b;margin-bottom:4px;">{item.label}</div>
          <div style="font-weight:700;color:#0f172a;font-size:1rem;">{item.value}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Sección del ticket -->
  <ServiceTicketSection
    defaultDevice="Laptop"
    defaultService="Cambio de pantalla"
    sourcePage="/servicios/laptop/cambio-pantalla"
    title="Crear Ticket de Servicio"
    subtitle="Cuéntanos qué le pasó a tu pantalla y te contactamos por WhatsApp para continuar."
  />

  <Footer />
</Base>
