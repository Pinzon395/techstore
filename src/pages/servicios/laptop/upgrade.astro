<style is:global>
/* =====================================
     PALETA DE DISEÑO / REGLAS EXACTAS
     - Base: #0E1629
     - Alterno: #F8FAFC (blanco azulado muy sutil) o rgba(255,255,255,0.04)
     - Oscuro: #0B1322
     - Acentos: azul solo bordes/botones (#3B82F6)
