   ====================================== */

  /* Gradient Transitions between sections */
  .upgrade-page section {
    background-color: #0E1629 !important;
    position: relative;
  }

  /* Top gradient fade - bleeds from previous section */
  .upgrade-page section::before {
    content: '';
    position: absolute;
    top: -32px;
    left: 0;
    right: 0;
    height: 32px;
    background: linear-gradient(to bottom, rgba(14, 22, 41, 0.5), transparent);
    pointer-events: none;
    z-index: 1;
  }

  /* First section has no top fade */
  .upg-hero::before { display: none; }

  /* Bottom gradient fade - prepares for next section */
  .upgrade-page section::after {
    content: '';
    position: absolute;
    bottom: -32px;
    left: 0;
    right: 0;
    height: 32px;
    background: linear-gradient(to top, rgba(14, 22, 41, 0.5), transparent);
    pointer-events: none;
    z-index: 1;
  }

  /* Last section has no bottom fade */
  .upg-cta::after { display: none; }

  /* Darker sections (BA, CTA) need darker gradients to match their bg */
  .upg-ba::before,
  .upg-ba::after {
    background: linear-gradient(to bottom, rgba(11, 19, 34, 0.5), transparent);
  }
  .upg-ba::after {
    background: linear-gradient(to top, rgba(11, 19, 34, 0.5), transparent);
  }

/* Footer links/text in dark mode */
