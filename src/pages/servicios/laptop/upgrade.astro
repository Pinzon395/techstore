---
import Base from '../../../layouts/Base.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CommentsSection from '../../../components/CommentsSection.astro';
import ContactSection from '../../../components/ContactSection.astro';
import ServiceTicketSection from '../../../components/ServiceTicketSection.astro';
import RelatedServicesSection from '../../../components/RelatedServicesSection.astro';
import FaqSection from '../../../components/FaqSection.astro';

const seoTitle = "Upgrade de Laptop | Mejora de RAM y SSD en Cancún | Pixon PC";
const description = "Mejora el rendimiento de tu laptop con más velocidad, mejor respuesta y una experiencia fluida. Upgrade de SSD y RAM en Cancún con garantía.";
const waMessage = encodeURIComponent("Hola, quiero cotizar un Upgrade de Laptop (SSD/RAM).");

const relatedUpgradeServices = [
  {
    href: '/servicios/laptop/pasta-termica',
    icon: 'fa-temperature-three-quarters',
    label: 'Cambio de pasta térmica',
    desc: 'Ideal si además del upgrade tu laptop se calienta, hace ruido o baja rendimiento por temperatura.',
    cta: 'Ver servicio  →',
  },
  {
    href: '/servicios/laptop/diagnostico',
    icon: 'fa-stethoscope',
    label: 'Diagnóstico de laptop',
    desc: 'Revisión técnica antes de comprar piezas si no sabes si falla disco, RAM, sistema o placa.',
    cta: 'Ver servicio  →',
  },
  {
    href: '/servicios/laptop/cambio-bateria',
    icon: 'fa-battery-three-quarters',
    label: 'Cambio de batería',
    desc: 'Complemento recomendado si tu laptop ya no retiene carga o se apaga al desconectarla.',
    cta: 'Ver servicio  →',
  },
  {
    href: '/instalacion-windows',
    icon: 'fa-window-restore',
    label: 'Instalación de Windows',
    desc: 'Sistema limpio, drivers y configuración lista cuando conviene reinstalar en vez de clonar.',
    cta: 'Ver servicio  →',
  },
  {
    href: '/paquetes',
    icon: 'fa-box',
    label: 'Paquetes de mantenimiento',
    desc: 'Aprovecha el desarme para limpieza interna, revisión térmica y mantenimiento preventivo.',
    cta: 'Ver más  →',
    isExternal: true,
  },
  {
    href: '/mantenimiento-mac',
    icon: 'fa-laptop-code',
    label: 'Mantenimiento Mac',
    desc: 'Servicio para MacBook Intel con limpieza, revisión térmica y diagnóstico de compatibilidad.',
    cta: 'Ver más  →',
    isExternal: true,
  },
];

const upgradeFaqs = [
  {
    question: '¿Vale la pena hacer upgrade a una laptop antigua?',
    answer: 'Sí, cuando el equipo enciende bien, la placa está estable y el cuello de botella es disco mecánico, poca RAM o sistema saturado. Antes de venderte piezas revisamos modelo, salud del disco y temperatura para confirmar si conviene SSD, RAM, limpieza o reinstalación.',
  },
  {
    question: '¿Mis archivos se borran al instalar SSD o RAM?',
    answer: 'La RAM no borra archivos. Para SSD podemos clonar tu sistema si el disco actual está sano; si el disco tiene errores, te avisamos y priorizamos respaldo antes de migrar o reinstalar Windows.',
  },
  {
    question: '¿Cómo saben qué SSD o RAM usa mi laptop?',
    answer: 'Revisamos modelo exacto, ranuras internas, tipo de memoria, generación, capacidad máxima y si el almacenamiento es SATA, M.2 SATA, NVMe o propietario. No recomendamos comprar piezas sin validar compatibilidad.',
  },
  {
    question: '¿Cuánto tarda el upgrade de laptop?',
    answer: 'La instalación física puede ser rápida, pero el servicio completo normalmente toma de 4 a 8 horas porque incluye revisión, respaldo o clonación, pruebas de arranque, velocidad, temperatura y estabilidad.',
  },
  {
    question: '¿Hacen upgrade a MacBook?',
    answer: 'Depende del modelo. Algunos MacBook Intel permiten upgrade o mantenimiento relacionado; equipos Apple Silicon M1, M2 y M3 tienen memoria y almacenamiento soldados. Primero confirmamos generación y número de modelo.',
  },
];

// Schema markup para SEO
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Upgrade de Laptop en Cancún",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Pixon PC",
      "url": "https://pixon.com.mx",
      "telephone": "+529986690777",
      "image": "https://pixon.com.mx/assets/logos/Logo.svg",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Haciendas",
        "addressLocality": "Cancún",
        "addressRegion": "Quintana Roo",
        "postalCode": "77539",
        "addressCountry": "MX"
      }
    },
    "areaServed": {
      "@type": "City",
      "name": "Cancún"
    },
    "serviceType": "Upgrade de Laptop (RAM/SSD)",
    "url": "https://pixon.com.mx/servicios/laptop/upgrade",
    "description": "Mejora el rendimiento de tu laptop con upgrade de SSD y RAM en Cancún. Servicio técnico profesional con garantía.",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Opciones de Upgrade",
      "itemListElement": [
        {
          "@type": "Offer",
          "name": "Upgrade Básico",
          "description": "SSD SATA 240GB/480GB + 4GB/8GB RAM + Clonación"
        },
        {
          "@type": "Offer",
          "name": "Upgrade Intermedio",
          "description": "SSD NVMe 500GB/1TB + 8GB/16GB RAM + Limpieza interna + Optimización"
        },
        {
          "@type": "Offer",
          "name": "Upgrade Pro Gamer",
          "description": "SSD NVMe Gen4 1TB/2TB + 16GB/32GB RAM + Cambio pasta térmica"
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Vale la pena hacer upgrade a una laptop antigua?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Depende del estado de la motherboard. Si el equipo enciende y no tiene fallas físicas, el upgrade de SSD + RAM puede rejuvenecerlo por 2-3 años más."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cuánto tiempo dura el upgrade?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "El servicio completo toma entre 4 a 8 horas dependiendo del modelo. La clonación del sistema es lo que más tiempo requiere."
        }
      },
      {
        "@type": "Question",
        "name": "¿Hacen upgrade a MacBooks?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Solo modelos Intel (2012-2017). Los MacBooks con chip M1, M2 o M3 tienen memoria y almacenamiento soldado a la placa."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Inicio",
        "item": "https://pixon.com.mx/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Servicios",
        "item": "https://pixon.com.mx/servicios"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Laptop",
        "item": "https://pixon.com.mx/servicios/laptop"
      },
      {
        "@type": "ListItem",
        "position": 4,
        "name": "Upgrade",
        "item": "https://pixon.com.mx/servicios/laptop/upgrade"
      }
    ]
  }
];
---

<Base title={seoTitle} description={description} canonical="/servicios/laptop/upgrade" schema={schema} bodyClass="theme-upgrade-dark">
  <Navbar />
  <Breadcrumb items={[
    { label: 'Inicio', href: '/' },
    { label: 'Servicios', href: '/servicios' },
    { label: 'Laptop', href: '/servicios/laptop' },
    { label: 'Upgrade' }
  ]} />

  <div class="upgrade-page" style="background-color: #0E1629; color: #ffffff;">
    
    <!-- 1) Hero principal -->
    <section class="upg-hero section-pad">
      <div class="container grid-2">
        <div class="upg-hero-text">
          <span class="upg-badge"><i class="fa-solid fa-location-dot"></i> Servicio técnico premium en Cancún</span>
          <h1 class="upg-title">Upgrade de <span class="gradient-text">Laptop en Cancún</span></h1>
          <p class="upg-lead">
            Mejora el rendimiento de tu laptop con SSD, RAM compatible y configuración profesional. Revisamos modelo, tipo de almacenamiento, capacidad máxima, estado del sistema y temperatura antes de instalar piezas.
          </p>
          <div class="upg-hero-points" aria-label="Ventajas del upgrade de laptop">
            <span><i class="fa-solid fa-hard-drive"></i> SSD SATA o NVMe según compatibilidad</span>
            <span><i class="fa-solid fa-memory"></i> RAM correcta para tu modelo</span>
            <span><i class="fa-solid fa-clone"></i> Clonación de sistema si aplica</span>
            <span><i class="fa-solid fa-shield-halved"></i> Garantía por escrito</span>
          </div>
          <div class="upg-btn-group">
            <a href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank" class="btn-primary-white">Cotizar ahora</a>
            <a href="#compatibilidad" class="btn-secondary-outline">Ver compatibilidad</a>
          </div>
          <div class="upg-hero-proof" aria-label="Resumen del servicio">
            <div><strong>SSD</strong><span>SATA, M.2 o NVMe</span></div>
            <div><strong>RAM</strong><span>DDR3, DDR4 o DDR5</span></div>
            <div><strong>QA</strong><span>Pruebas antes de entregar</span></div>
          </div>
        </div>

        <div class="upg-hero-visual">
          <div class="hero-image-wrapper">
            <img src="/assets/images/cambio-ssd.webp" alt="SSD para upgrade de laptop en Cancun" class="main-image" loading="eager" decoding="async" width="960" height="1280" />
            <div class="hero-upgrade-panel">
              <div>
                <span>Antes</span>
                <strong>HDD lento</strong>
                <small>arranque de minutos</small>
              </div>
              <i class="fa-solid fa-arrow-right"></i>
              <div>
                <span>Después</span>
                <strong>SSD + RAM</strong>
                <small>respuesta inmediata</small>
              </div>
            </div>
            <div class="floating-card">
              <i class="fa-solid fa-microchip"></i>
              <div>
                <strong>Hasta 10x más rápido</strong>
                <span>NVMe SSD + RAM</span>
              </div>
            </div>
            <div class="hero-image-chip hero-image-chip-a">
              <i class="fa-solid fa-memory"></i>
              <span>RAM compatible</span>
            </div>
            <div class="hero-image-chip hero-image-chip-b">
              <i class="fa-solid fa-hard-drive"></i>
              <span>SSD correcto</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2) Trust Strip / barra de confianza -->
    <section class="upg-trust">
      <div class="container">
        <div class="trust-grid">
          <div class="trust-card">
            <div class="trust-icon"><i class="fa-solid fa-stethoscope"></i></div>
            <h3>Diagnóstico</h3>
            <p>Revisamos salud del disco, RAM instalada, sistema y temperatura.</p>
          </div>
          <div class="trust-card">
            <div class="trust-icon"><i class="fa-solid fa-check-double"></i></div>
            <h3>Compatibilidad</h3>
            <p>Confirmamos si tu equipo usa SATA, M.2, NVMe, DDR3, DDR4 o DDR5.</p>
          </div>
          <div class="trust-card">
            <div class="trust-icon"><i class="fa-solid fa-screwdriver-wrench"></i></div>
            <h3>Instalación</h3>
            <p>Montaje limpio, sin forzar conectores, carcasas ni flex internos.</p>
          </div>
          <div class="trust-card">
            <div class="trust-icon"><i class="fa-solid fa-bolt"></i></div>
            <h3>Rendimiento</h3>
            <p>Validamos arranque, velocidad, multitarea y estabilidad posterior.</p>
          </div>
          <div class="trust-card">
            <div class="trust-icon"><i class="fa-solid fa-shield-halved"></i></div>
            <h3>Garantía</h3>
            <p>Por escrito en cada pieza.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3) Sección S¿Qué incluye el upgrade?⬝ -->
    <section class="upg-includes section-pad" id="que-incluye">
      <div class="container">
        <div class="includes-wrapper">
          <div class="includes-layout">
            <div class="includes-copy">
              <span class="upg-section-kicker">Upgrade SSD / RAM</span>
              <h2 class="section-title">Qué incluye el upgrade de laptop</h2>
              <p class="section-subtitle">
                Un upgrade bien hecho no es solo cambiar piezas. En Pixon PC validamos compatibilidad real, rendimiento esperado, estado del sistema y estabilidad para que la mejora se note desde el primer uso.
              </p>
              <div class="includes-checklist">
                <span><i class="fa-solid fa-circle-check"></i> Revisión de capacidad máxima de RAM</span>
                <span><i class="fa-solid fa-circle-check"></i> Validación de ranura SATA, M.2 o NVMe</span>
                <span><i class="fa-solid fa-circle-check"></i> Respaldo o clonación según condición del disco</span>
                <span><i class="fa-solid fa-circle-check"></i> Pruebas de velocidad y arranque posterior</span>
              </div>
            </div>

            <div class="includes-grid">
              <div class="include-card">
                <i class="fa-solid fa-hard-drive"></i>
                <h4>Instalación de SSD</h4>
                <p>Cambio de disco mecánico a SSD SATA o NVMe para arranque rápido, carga inmediata de programas y mejor respuesta general.</p>
              </div>
              <div class="include-card">
                <i class="fa-solid fa-memory"></i>
                <h4>Ampliación de RAM</h4>
                <p>Instalamos memoria compatible para multitarea, clases, oficina, navegadores pesados, programas de diseño o uso gamer ligero.</p>
              </div>
              <div class="include-card">
                <i class="fa-solid fa-clone"></i>
                <h4>Clonación del sistema</h4>
                <p>Cuando el disco está sano, migramos Windows, archivos, programas y configuración para que sigas trabajando sin empezar desde cero.</p>
              </div>
              <div class="include-card">
                <i class="fa-solid fa-vial-virus"></i>
                <h4>Pruebas finales</h4>
                <p>Probamos encendido, lectura/escritura, uso de RAM, temperatura y estabilidad para confirmar que el upgrade quedó funcionando.</p>
              </div>
              <div class="include-card include-card-wide">
                <i class="fa-solid fa-magnifying-glass-chart"></i>
                <h4>Diagnóstico antes de comprar piezas</h4>
                <p>Te decimos si conviene SSD, RAM, ambos o si primero hay que resolver fallas de disco, sistema, temperatura o placa.</p>
              </div>
              <div class="include-card include-card-wide">
                <i class="fa-solid fa-file-shield"></i>
                <h4>Entrega clara</h4>
                <p>Recibes recomendaciones de uso, garantía por escrito y explicación de la mejora instalada en tu laptop.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4) Sección de beneficios reales -->
    <section class="upg-benefits section-pad" id="beneficios">
      <div class="container">
        <div class="benefits-panel">
          <div class="benefits-heading">
            <span class="upg-section-kicker">Beneficios del upgrade</span>
            <h2 class="section-title">Más velocidad sin comprar otra laptop</h2>
            <p class="section-subtitle">El cambio se nota en tareas reales: abrir Windows, navegar, trabajar con varias apps, cargar programas y reducir bloqueos causados por disco lento o memoria insuficiente.</p>
          </div>
          <div class="benefits-grid">
            <div class="benefit-card">
              <i class="fa-solid fa-rocket"></i>
              <h4>Arranque rápido</h4>
              <p>Windows y tus programas cargan en segundos cuando el cuello de botella era el disco mecánico.</p>
            </div>
            <div class="benefit-card">
              <i class="fa-solid fa-layer-group"></i>
              <h4>Trabajo más fluido</h4>
              <p>Más RAM permite usar Chrome, Office, clases, videollamadas y apps de trabajo sin congelamientos constantes.</p>
            </div>
            <div class="benefit-card">
              <i class="fa-solid fa-arrows-spin"></i>
              <h4>Respuesta estable</h4>
              <p>Adiós a la espera eterna al abrir archivos, buscar documentos o cambiar entre aplicaciones.</p>
            </div>
            <div class="benefit-card">
              <i class="fa-solid fa-heart-pulse"></i>
              <h4>Vida útil extendida</h4>
              <p>Una laptop funcional puede seguir rindiendo varios años más con piezas correctas y mantenimiento preventivo.</p>
            </div>
            <div class="benefit-card">
              <i class="fa-solid fa-gauge-high"></i>
              <h4>Mejor multitarea</h4>
              <p>Menos uso al 100% del disco, menos cierres inesperados y mejor respuesta en trabajo diario.</p>
            </div>
            <div class="benefit-card">
              <i class="fa-solid fa-volume-xmark"></i>
              <h4>Menos ruido y calor</h4>
              <p>Un SSD no tiene partes mecánicas y puede ayudar a que el equipo trabaje con menos esfuerzo.</p>
            </div>
          </div>
          <div class="benefits-note">
            <strong>No todos necesitan el mismo upgrade.</strong>
            <span>Primero revisamos si tu laptop conviene para SSD, RAM, limpieza, reinstalación o una combinación.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 5) Sección Antes / Después -->
    <!-- 4.5) Guia de decision -->
    <section class="upg-decision section-pad" id="que-upgrade-necesito">
      <div class="container">
        <div class="decision-layout">
          <div class="decision-copy">
            <span class="upg-section-kicker">Recomendación técnica</span>
            <h2 class="section-title">Qué upgrade necesita tu laptop realmente</h2>
            <p class="section-subtitle">
              No todas las laptops necesitan las mismas piezas. Separamos síntomas para recomendar SSD, RAM, limpieza, reinstalación o una combinación, sin vender componentes que tu equipo no puede aprovechar.
            </p>
            <div class="decision-warning">
              <i class="fa-solid fa-triangle-exclamation"></i>
              <span>Antes de comprar RAM o SSD por internet, confirma modelo exacto, ranuras disponibles y tipo de disco. Muchas laptops modernas traen memoria soldada o una sola ranura M.2.</span>
            </div>
          </div>
          <div class="decision-cards">
            <article class="decision-card">
              <i class="fa-solid fa-hard-drive"></i>
              <h3>Conviene SSD</h3>
              <p>Si tarda mucho en prender, el disco marca 100%, se congela al abrir apps o todavía usa HDD mecánico.</p>
            </article>
            <article class="decision-card">
              <i class="fa-solid fa-memory"></i>
              <h3>Conviene RAM</h3>
              <p>Si usas muchas pestañas, Office, clases, diseño básico o videollamadas y el equipo se queda sin memoria.</p>
            </article>
            <article class="decision-card">
              <i class="fa-solid fa-fan"></i>
              <h3>Conviene mantenimiento</h3>
              <p>Si se calienta, baja velocidad, suena el ventilador o se apaga. El upgrade rinde mejor con buena temperatura.</p>
            </article>
            <article class="decision-card">
              <i class="fa-solid fa-window-restore"></i>
              <h3>Conviene sistema limpio</h3>
              <p>Si Windows está dañado, lleno de errores o malware, puede requerir respaldo e instalación limpia.</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- 5) Seccion Antes / Despues -->
    <section class="upg-ba section-pad" id="antes-despues">
      <div class="container">
        <div class="ba-panel">
          <div class="ba-heading">
            <span class="upg-section-kicker">Antes y después</span>
            <h2 class="section-title">La diferencia se nota desde el primer encendido</h2>
            <p class="section-subtitle">Comparamos síntomas reales de laptops con disco mecánico, poca RAM o sistema saturado contra el resultado esperado después de instalar SSD/RAM compatible y validar estabilidad.</p>
          </div>
          <div class="ba-grid mt-8">
            <div class="ba-card ba-before">
              <div class="ba-header">
                <i class="fa-solid fa-turtle"></i>
                <div>
                  <span>Antes del upgrade</span>
                  <h3>Equipo lento y saturado</h3>
                </div>
              </div>
              <ul>
                <li><i class="fa-solid fa-xmark"></i> <span>Tarda minutos en encender o abrir el escritorio.</span></li>
                <li><i class="fa-solid fa-xmark"></i> <span>Cuelgues al abrir Chrome, Word, clases o videollamadas.</span></li>
                <li><i class="fa-solid fa-xmark"></i> <span>Sonidos mecánicos del disco HDD y carga constante.</span></li>
                <li><i class="fa-solid fa-xmark"></i> <span>Disco al 100% en Administrador de tareas.</span></li>
              </ul>
            </div>
            <div class="ba-card ba-after">
              <div class="ba-header">
                <i class="fa-solid fa-bolt"></i>
                <div>
                  <span>Después del upgrade</span>
                  <h3>Respuesta rápida y estable</h3>
                </div>
              </div>
              <ul>
                <li><i class="fa-solid fa-check"></i> <span>Enciende y carga en menos de 15s cuando el equipo lo permite.</span></li>
                <li><i class="fa-solid fa-check"></i> <span>Multitarea fluida sin bloqueos constantes.</span></li>
                <li><i class="fa-solid fa-check"></i> <span>Menos ruido, menor carga mecánica y mejor sensación de uso.</span></li>
                <li><i class="fa-solid fa-check"></i> <span>El equipo responde al instante en tareas diarias.</span></li>
              </ul>
            </div>
          </div>
          <div class="ba-metrics">
            <div><strong>SSD</strong><span>Arranque y apertura de apps mucho más rápida.</span></div>
            <div><strong>RAM</strong><span>Mejor multitarea y menos cierres por memoria saturada.</span></div>
            <div><strong>QA</strong><span>Pruebas finales para confirmar estabilidad real.</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 6.5) Ticket de Servicio -->
    <ServiceTicketSection 
      defaultDevice="Laptop" 
      defaultService="Upgrade SSD / RAM" 
      title="Crear Ticket de Upgrade" 
      subtitle="Cuéntanos qué equipo tienes y te recomendaremos el mejor upgrade disponible."
    />

    <!-- 8) Compatibilidad -->
    <section class="upg-compat section-pad" id="compatibilidad">
      <div class="container">
        <div class="compat-wrapper">
          <div class="compat-layout">
            <div class="compat-copy">
              <span class="upg-section-kicker">Compatibilidad real</span>
              <h2 class="section-title">Compatibilidad</h2>
              <p class="section-subtitle">
                Antes de realizar cualquier upgrade, revisamos el modelo exacto del equipo para asegurar compatibilidad real. No todos los equipos usan la misma RAM o SSD, y algunos modelos tienen almacenamiento o memoria soldada.
              </p>
              <div class="compat-checks">
                <span><i class="fa-solid fa-check"></i> Tipo de RAM: DDR3, DDR4, DDR5, LPDDR o soldada</span>
                <span><i class="fa-solid fa-check"></i> Tipo de disco: SATA, M.2 SATA, NVMe o propietario</span>
                <span><i class="fa-solid fa-check"></i> Capacidad máxima soportada por el modelo</span>
                <span><i class="fa-solid fa-check"></i> Estado del disco actual antes de clonar</span>
              </div>
            </div>
            <div class="compat-cards">
