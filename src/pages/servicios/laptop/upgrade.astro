  body.theme-upgrade-dark footer *:not(i):not(svg):not(path),
  footer.light-footer,
  footer.light-footer *:not(i):not(svg):not(path) {
    color: rgba(255, 255, 255, 0.7) !important;
  }

  /* Force override ALL footer colors with !important */
  body.theme-upgrade-dark .footer-links li a,
