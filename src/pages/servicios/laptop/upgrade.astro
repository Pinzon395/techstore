---
import Base from '../../../layouts/Base.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CommentsSection from '../../../components/CommentsSection.astro';
import ContactSection from '../../../components/ContactSection.astro';
import ServiceTicketSection from '../../../components/ServiceTicketSection.astro';

const seoTitle = "Upgrade de Laptop | Mejora de RAM y SSD en Cancún | Pixon PC";
const description = "Mejora el rendimiento de tu laptop con más velocidad, mejor respuesta y una experiencia fluida. Upgrade de SSD y RAM en Cancún con garantía.";
const waMessage = encodeURIComponent("Hola, quiero cotizar un Upgrade de Laptop (SSD/RAM).");

// Schema markup para SEO
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Upgrade de Laptop en Cancún",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Pixon PC",
      "url": "https://pixon.com.mx",
      "telephone": "+529986690777",
      "image": "https://pixon.com.mx/assets/logos/Logo.svg",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Haciendas",
        "addressLocality": "Cancún",
        "addressRegion": "Quintana Roo",
        "postalCode": "77539",
        "addressCountry": "MX"
      }
    },
    "areaServed": {
      "@type": "City",
      "name": "Cancún"
    },
    "serviceType": "Upgrade de Laptop (RAM/SSD)",
    "url": "https://pixon.com.mx/servicios/laptop/upgrade",
    "description": "Mejora el rendimiento de tu laptop con upgrade de SSD y RAM en Cancún. Servicio técnico profesional con garantía.",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Opciones de Upgrade",
      "itemListElement": [
        {
          "@type": "Offer",
          "name": "Upgrade Básico",
          "description": "SSD SATA 240GB/480GB + 4GB/8GB RAM + Clonación"
        },
        {
          "@type": "Offer",
          "name": "Upgrade Intermedio",
          "description": "SSD NVMe 500GB/1TB + 8GB/16GB RAM + Limpieza interna + Optimización"
        },
        {
          "@type": "Offer",
          "name": "Upgrade Pro Gamer",
          "description": "SSD NVMe Gen4 1TB/2TB + 16GB/32GB RAM + Cambio pasta térmica"
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Vale la pena hacer upgrade a una laptop antigua?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Depende del estado de la motherboard. Si el equipo enciende y no tiene fallas físicas, el upgrade de SSD + RAM puede rejuvenecerlo por 2-3 años más."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cuánto tiempo dura el upgrade?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "El servicio completo toma entre 4 a 8 horas dependiendo del modelo. La clonación del sistema es lo que más tiempo requiere."
        }
      },
      {
        "@type": "Question",
        "name": "¿Hacen upgrade a MacBooks?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Solo modelos Intel (2012-2017). Los MacBooks con chip M1, M2 o M3 tienen memoria y almacenamiento soldado a la placa."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Inicio",
        "item": "https://pixon.com.mx/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Servicios",
        "item": "https://pixon.com.mx/servicios"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Laptop",
        "item": "https://pixon.com.mx/servicios/laptop"
      },
      {
        "@type": "ListItem",
        "position": 4,
        "name": "Upgrade",
        "item": "https://pixon.com.mx/servicios/laptop/upgrade"
      }
    ]
  }
];
---

<Base title={seoTitle} description={description} schema={schema} bodyClass="theme-upgrade-dark">
  <Navbar />
  <Breadcrumb items={[
    { label: 'Inicio', href: '/' },
    { label: 'Servicios', href: '/servicios' },
    { label: 'Laptop', href: '/servicios/laptop' },
    { label: 'Upgrade' }
  ]} />

  <div class="upgrade-page" style="background-color: #0E1629; color: #ffffff;">
    
    <!-- 1) Hero principal -->
    <section class="upg-hero section-pad">
      <div class="container grid-2">
        <div class="upg-hero-text">
          <span class="upg-badge">Servicio técnico premium</span>
          <h1 class="upg-title">Upgrade de <span class="gradient-text">Laptop en Cancún</span></h1>
          <p class="upg-lead">
            Mejora el rendimiento de tu laptop en Cancún con más velocidad, mejor respuesta y una experiencia mucho más fluida. Instalación profesional de SSD y RAM.
          </p>
          <div class="upg-btn-group">
            <a href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank" class="btn-primary-white">Cotizar ahora</a>
            <a href="#compatibilidad" class="btn-secondary-outline">Ver compatibilidad</a>
          </div>
        </div>

        <div class="upg-hero-visual">
          <div class="hero-image-wrapper">
            <img src="/assets/images/mantenimiento-macbook-cancun.jpeg" alt="Upgrade de Laptop" class="main-image" />
            <div class="floating-card">
              <i class="fa-solid fa-microchip"></i>
              <div>
                <strong>Hasta 10x más rápido</strong>
                <span>NVMe SSD + RAM</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2) Trust Strip / barra de confianza -->
    <section class="upg-trust">
      <div class="container">
        <div class="trust-grid">
          <div class="trust-card">
            <div class="trust-icon"><i class="fa-solid fa-stethoscope"></i></div>
            <h3>Diagnóstico</h3>
            <p>Revisión inicial del equipo.</p>
          </div>
          <div class="trust-card">
            <div class="trust-icon"><i class="fa-solid fa-check-double"></i></div>
            <h3>Compatibilidad</h3>
            <p>Piezas exactas para tu modelo.</p>
          </div>
          <div class="trust-card">
            <div class="trust-icon"><i class="fa-solid fa-screwdriver-wrench"></i></div>
            <h3>Instalación</h3>
            <p>Técnicos especializados.</p>
          </div>
          <div class="trust-card">
            <div class="trust-icon"><i class="fa-solid fa-bolt"></i></div>
            <h3>Rendimiento</h3>
            <p>Test de velocidad post-upgrade.</p>
          </div>
          <div class="trust-card">
            <div class="trust-icon"><i class="fa-solid fa-shield-halved"></i></div>
            <h3>Garantía</h3>
            <p>Por escrito en cada pieza.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3) Sección “¿Qué incluye el upgrade?” -->
    <section class="upg-includes section-pad" id="que-incluye">
      <div class="container">
        <div class="includes-wrapper">
          <div class="grid-2">
            <div>
              <h2 class="section-title">¿Qué incluye el upgrade?</h2>
              <p class="section-subtitle">
                Un upgrade bien hecho no es solo cambiar piezas: es revisar compatibilidad, mejorar respuesta y validar estabilidad.
              </p>
              <img src="/assets/images/reparacion-mac-cancun.jpeg" alt="Herramientas" class="includes-img-side" />
            </div>

            <div class="includes-grid">
              <div class="include-card">
                <i class="fa-solid fa-hard-drive"></i>
                <h4>Instalación de SSD</h4>
                <p>Migración a almacenamiento de estado sólido para arranques instantáneos.</p>
              </div>
              <div class="include-card">
                <i class="fa-solid fa-memory"></i>
                <h4>Ampliación de RAM</h4>
                <p>Más capacidad para multitarea sin cierres ni pantallas congeladas.</p>
              </div>
              <div class="include-card">
                <i class="fa-solid fa-clone"></i>
                <h4>Clonación del Sistema</h4>
                <p>Conservamos todos tus archivos, programas y configuración intactos.</p>
              </div>
              <div class="include-card">
                <i class="fa-solid fa-vial-virus"></i>
                <h4>Pruebas Finales</h4>
                <p>Test de estrés térmico y velocidad para garantizar estabilidad.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4) Sección de beneficios reales -->
    <section class="upg-benefits section-pad" id="beneficios">
      <div class="container grid-2">
        <div class="benefits-grid">
          <div class="benefit-card">
            <i class="fa-solid fa-rocket"></i>
            <h4>Arranque rápido</h4>
            <p>Windows listo en segundos.</p>
          </div>
          <div class="benefit-card">
            <i class="fa-solid fa-layer-group"></i>
            <h4>Trabajo más fluido</h4>
            <p>Abre múltiples pestañas sin lag.</p>
          </div>
          <div class="benefit-card">
            <i class="fa-solid fa-arrows-spin"></i>
            <h4>Respuesta estable</h4>
            <p>Adiós a la ruedita de carga eterna.</p>
          </div>
          <div class="benefit-card">
            <i class="fa-solid fa-heart-pulse"></i>
            <h4>Vida útil extendida</h4>
            <p>Tu laptop durará años extra.</p>
          </div>
        </div>
        
        <div class="benefits-visual">
          <img src="/assets/images/mantenimiento-mac-cancun.jpeg" alt="Beneficios del Upgrade" class="benefits-img" />
        </div>
      </div>
    </section>

    <!-- 5) Sección Antes / Después -->
    <section class="upg-ba section-pad" id="antes-despues">
      <div class="container">
        <h2 class="section-title text-center">Antes y después</h2>
        <div class="ba-grid mt-8">
          <div class="ba-card ba-before">
            <div class="ba-header">
              <i class="fa-solid fa-turtle"></i>
              <h3>Antes</h3>
            </div>
            <ul>
              <li><i class="fa-solid fa-xmark"></i> Tarda minutos en encender</li>
              <li><i class="fa-solid fa-xmark"></i> Cuelgues al abrir Chrome o Word</li>
              <li><i class="fa-solid fa-xmark"></i> Sonidos mecánicos del disco (HDD)</li>
              <li><i class="fa-solid fa-xmark"></i> Sistema al 100% de uso en Administrador</li>
            </ul>
          </div>
          <div class="ba-card ba-after">
            <div class="ba-header">
              <i class="fa-solid fa-bolt"></i>
              <h3>Después</h3>
            </div>
            <ul>
              <li><i class="fa-solid fa-check"></i> Enciende y carga en menos de 15s</li>
              <li><i class="fa-solid fa-check"></i> Multitarea fluida sin bloqueos</li>
              <li><i class="fa-solid fa-check"></i> Silencio total y menor temperatura</li>
              <li><i class="fa-solid fa-check"></i> El equipo responde al instante</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 6) Sección de proceso -->
    <section class="upg-process section-pad" id="proceso">
      <div class="container">
        <h2 class="section-title">Proceso de servicio</h2>
        <div class="process-grid mt-8">
          <div class="process-step">
            <div class="step-num">1</div>
            <h4>Diagnóstico</h4>
            <p>Validamos el estado actual.</p>
          </div>
          <div class="process-step">
            <div class="step-num">2</div>
            <h4>Compatibilidad</h4>
            <p>Elegimos los módulos correctos.</p>
          </div>
          <div class="process-step">
            <div class="step-num">3</div>
            <h4>Cotización</h4>
            <p>Selección del mejor SSD/RAM.</p>
          </div>
          <div class="process-step">
            <div class="step-num">4</div>
            <h4>Instalación</h4>
            <p>Montaje y clonado de sistema.</p>
          </div>
          <div class="process-step">
            <div class="step-num">5</div>
            <h4>Pruebas QA</h4>
            <p>Test de velocidad y estrés.</p>
          </div>
          <div class="process-step">
            <div class="step-num">6</div>
            <h4>Entrega</h4>
            <p>Lista para disfrutar.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6.5) Ticket de Servicio -->
    <ServiceTicketSection 
      defaultDevice="Laptop" 
      defaultService="Upgrade SSD / RAM" 
      title="Crear Ticket de Upgrade" 
      subtitle="Cuéntanos qué equipo tienes y te recomendaremos el mejor upgrade disponible."
    />

    <!-- 7) Galería Visual - Upgrade Professional -->
    <section class="upg-gallery section-pad" style="background: linear-gradient(to bottom, #0E1629 0%, #0B1322 100%);">
      <div class="container">
        <h2 class="section-title text-center" style="color: #fff;">Enfoque técnico</h2>
        <p class="section-subtitle text-center" style="color: #94a3b8; margin-bottom: 40px;">Cada upgrade es ejecutado con precisión, limpieza y verificación rigurosa.</p>
        
        <div style="display: grid; grid-template-columns: 1.2fr 1fr; grid-template-rows: 1fr 1fr; gap: 20px; max-width: 1000px; margin: 0 auto; min-height: 500px;">
          <!-- Imagen principal - ocupa 2 filas -->
          <div style="grid-row: 1 / 3; position: relative; overflow: hidden; border-radius: 20px;">
            <img src="/assets/images/mantenimiento-macbook-cancun.jpeg" alt="Técnico realizando upgrade" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;" />
            <div style="position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(to top, rgba(14, 22, 41, 0.95), transparent); padding: 30px 25px;">
              <h3 style="color: #fff; font-size: 1.3rem; margin: 0;"><i class="fa-solid fa-microchip" style="color: #3b82f6;"></i> Diagnóstico y verificación</h3>
            </div>
          </div>
          
          <!-- Imagen 2 - primera columna -->
          <div style="position: relative; overflow: hidden; border-radius: 20px;">
            <img src="/assets/images/reparacion-mac-cancun.jpeg" alt="Placa base y componentes" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;" />
            <div style="position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(to top, rgba(14, 22, 41, 0.9), transparent); padding: 20px;">
              <h4 style="color: #fff; font-size: 1rem; margin: 0;">Compatibilidad verificada</h4>
            </div>
          </div>
          
          <!-- Imagen 3 - segunda columna -->
          <div style="position: relative; overflow: hidden; border-radius: 20px;">
            <img src="/assets/images/mantenimiento-mac-cancun.jpeg" alt="SSD y RAM instalados" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;" />
            <div style="position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(to top, rgba(14, 22, 41, 0.9), transparent); padding: 20px;">
              <h4 style="color: #fff; font-size: 1rem; margin: 0;">Instalación profesional</h4>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 8) Compatibilidad -->
    <section class="upg-compat section-pad" id="compatibilidad">
      <div class="container">
        <div class="compat-wrapper">
          <div class="grid-2">
            <div>
              <h2 class="section-title">Compatibilidad</h2>
              <p class="section-subtitle">
                Antes de realizar cualquier upgrade, revisamos el modelo exacto del equipo para asegurar compatibilidad real. No todos los equipos usan la misma RAM o SSD.
              </p>
            </div>
            <div class="compat-cards">
              <div class="compat-card">
                <i class="fa-brands fa-windows"></i>
                <h4>Equipos Windows</h4>
                <p>Soporte para el 95% de laptops HP, Dell, Lenovo, Asus, Acer.</p>
              </div>
              <div class="compat-card">
                <i class="fa-brands fa-apple"></i>
                <h4>Equipos Apple</h4>
                <p>Solo modelos Intel (2012-2017). Los Apple Silicon (M1/M2) tienen piezas soldadas.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 9) Planes -->
    <section class="upg-plans section-pad" id="planes">
      <div class="container">
        <h2 class="section-title text-center">Opciones de upgrade</h2>
        <div class="plans-grid mt-8">
          <div class="plan-card">
            <h3>Básico</h3>
            <p class="plan-desc">Mejora inicial para tareas de oficina.</p>
            <ul class="plan-features">
              <li><i class="fa-solid fa-check"></i> SSD SATA 240GB / 480GB</li>
              <li><i class="fa-solid fa-check"></i> +4GB / 8GB RAM</li>
              <li><i class="fa-solid fa-check"></i> Clonación de sistema</li>
            </ul>
            <a href={`https://wa.me/529986690777?text=${encodeURIComponent("Hola, quiero cotizar el plan Básico de Upgrade.")}`} class="plan-btn">Cotizar Básico</a>
          </div>

          <div class="plan-card plan-featured">
            <div class="featured-tag">Recomendado</div>
            <h3>Intermedio</h3>
            <p class="plan-desc">Equilibrio perfecto para trabajo y velocidad.</p>
            <ul class="plan-features">
              <li><i class="fa-solid fa-check"></i> SSD NVMe 500GB / 1TB</li>
              <li><i class="fa-solid fa-check"></i> +8GB / 16GB RAM</li>
              <li><i class="fa-solid fa-check"></i> Limpieza interna gratis</li>
              <li><i class="fa-solid fa-check"></i> Optimización de Windows</li>
            </ul>
            <a href={`https://wa.me/529986690777?text=${encodeURIComponent("Hola, quiero cotizar el plan Intermedio de Upgrade.")}`} class="plan-btn plan-btn-featured">Cotizar Intermedio</a>
          </div>

          <div class="plan-card">
            <h3>Pro Gamer / Diseño</h3>
            <p class="plan-desc">Máximo rendimiento posible.</p>
            <ul class="plan-features">
              <li><i class="fa-solid fa-check"></i> SSD NVMe Gen4 1TB / 2TB</li>
              <li><i class="fa-solid fa-check"></i> +16GB / 32GB RAM (Dual Channel)</li>
              <li><i class="fa-solid fa-check"></i> Cambio de pasta térmica</li>
            </ul>
            <a href={`https://wa.me/529986690777?text=${encodeURIComponent("Hola, quiero cotizar el plan Pro Gamer de Upgrade.")}`} class="plan-btn">Cotizar Pro</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 10) CTA Final -->
    <section class="upg-cta section-pad">
      <div class="container">
        <div class="cta-wrapper">
          <div class="grid-2 cta-items-center">
            <div>
              <h2 class="section-title mb-4">Haz que tu laptop vuelva a rendir como debe.</h2>
              <p class="section-subtitle mb-6">
                Cotiza tu upgrade y mejora la experiencia de uso desde el primer día.
              </p>
              <div class="upg-btn-group">
                <a href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank" class="btn-primary-white">Cotizar ahora</a>
                <a href="https://wa.me/529986690777" class="btn-secondary-outline">Hablar por WhatsApp</a>
              </div>
            </div>
            <div class="cta-image">
              <img src="/LOGOCIRCULAR.png" alt="Pixon Logo" class="cta-logo-fade" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 11) Comments Section -->
    <CommentsSection 
      dark={true}
      title="Reseñas de clientes"
      description="Conoce las experiencias de quienes mejoraron su laptop con nosotros."
    />

    <!-- 10) Contact Section -->
    <ContactSection id="contacto" />

  </div>
  <Footer />
</Base>

<style is:global>
/* =====================================
     PALETA DE DISEÑO / REGLAS EXACTAS
     - Base: #0E1629
     - Alterno: #F8FAFC (blanco azulado muy sutil) o rgba(255,255,255,0.04)
     - Oscuro: #0B1322
     - Acentos: azul solo bordes/botones (#3B82F6)
     - Tipografía: Kanit (títulos), Inter (textos)
   ====================================== */

  /* Gradient Transitions between sections */
  .upgrade-page section {
    background-color: #0E1629 !important;
    position: relative;
  }

  /* Top gradient fade - bleeds from previous section */
  .upgrade-page section::before {
    content: '';
    position: absolute;
    top: -60px;
    left: 0;
    right: 0;
    height: 60px;
    background: linear-gradient(to bottom, rgba(14, 22, 41, 0.5), transparent);
    pointer-events: none;
    z-index: 1;
  }

  /* First section has no top fade */
  .upg-hero::before { display: none; }

  /* Bottom gradient fade - prepares for next section */
  .upgrade-page section::after {
    content: '';
    position: absolute;
    bottom: -60px;
    left: 0;
    right: 0;
    height: 60px;
    background: linear-gradient(to top, rgba(14, 22, 41, 0.5), transparent);
    pointer-events: none;
    z-index: 1;
  }

  /* Last section has no bottom fade */
  .upg-cta::after { display: none; }

  /* Darker sections (BA, CTA) need darker gradients to match their bg */
  .upg-ba::before,
  .upg-ba::after {
    background: linear-gradient(to bottom, rgba(11, 19, 34, 0.5), transparent);
  }
  .upg-ba::after {
    background: linear-gradient(to top, rgba(11, 19, 34, 0.5), transparent);
  }

/* Footer links/text in dark mode */
  body.theme-upgrade-dark footer,
  footer.light-footer {
    background: #0B1322 !important;
    color: rgba(255, 255, 255, 0.85) !important;
    border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
  }

  body.theme-upgrade-dark footer,
  body.theme-upgrade-dark footer *:not(i):not(svg):not(path),
  footer.light-footer,
  footer.light-footer *:not(i):not(svg):not(path) {
    color: rgba(255, 255, 255, 0.7) !important;
  }

  /* Force override ALL footer colors with !important */
  body.theme-upgrade-dark .footer-links li a,
  body.theme-upgrade-dark footer a,
  body.theme-upgrade-dark footer p,
  body.theme-upgrade-dark footer li,
  body.theme-upgrade-dark footer h3,
  body.theme-upgrade-dark footer div.footer-links li a,
  body.theme-upgrade-dark footer .footer-links ul li a {
    color: rgba(255, 255, 255, 0.7) !important;
  }

  body.theme-upgrade-dark footer .footer-links li a {
    color: rgba(255, 255, 255, 0.7) !important;
    background: transparent !important;
  }

  /* Footer social icons */
  body.theme-upgrade-dark footer .social-icons a,
  footer.light-footer .social-icons a {
    color: rgba(255, 255, 255, 0.6) !important;
  }

  /* Logo in footer needs to stay visible */
  body.theme-upgrade-dark footer .footer-logo .logo,
  footer.light-footer .footer-logo .logo {
    color: #fff !important;
  }

  /* Hide the specialty overlay on upgrade page */
  #specialty-overlay {
    display: none !important;
  }

  body {
    background-color: #0E1629 !important;
    color: #ffffff !important;
  }

