  .b2b-maintenance *::after { box-sizing: border-box; }

  .b2b-shell { width: min(1180px, calc(100% - (var(--page-gutter) * 2))); margin-inline: auto; }
  .b2b-section { padding: clamp(64px, 8vw, 104px) 0; }
  .b2b-section--soft { background: var(--b2b-soft); }
  .b2b-label,
  .b2b-eyebrow { display: inline-flex; color: var(--b2b-blue); font-size: .76rem; font-weight: 850; letter-spacing: .09em; line-height: 1.3; text-transform: uppercase; }
  .b2b-heading { max-width: 760px; margin-bottom: 34px; }
  .b2b-heading--wide { max-width: 880px; }
  .b2b-heading h2,
  .b2b-section h2,
  .b2b-final h2 { margin: 8px 0 14px; color: var(--b2b-ink); font-family: var(--font-heading); font-size: clamp(1.8rem, 3.2vw, 2.75rem); line-height: 1.1; text-wrap: balance; }
  .b2b-heading p,
  .b2b-section p { color: var(--b2b-muted); font-size: 1rem; line-height: 1.72; }
  .b2b-section p + p { margin-top: 14px; }

  .b2b-hero { position: relative; padding: clamp(40px, 7vw, 102px) 0; background: radial-gradient(circle at 84% 22%, rgba(32, 141, 231, .2), transparent 32%), linear-gradient(135deg, #06182b, #0a2947 62%, #0d365e); }

  /* Base (mobile-first): flex column — DOM order is H1 → animation → CTAs */
  .b2b-hero__grid { display: flex; flex-direction: column; gap: 20px; align-items: stretch; }
  .b2b-hero__media { position: relative; width: 100%; min-width: 0; max-width: 420px; margin-inline: auto; }

  /* Desktop ≥900px: 2-column grid — above/media/below are direct grid children */
  @media (min-width: 900px) {
    .b2b-hero__grid { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(300px, .72fr); grid-template-rows: auto 1fr; gap: clamp(24px, 5vw, 60px); align-items: start; }
    .b2b-hero__above { grid-column: 1; grid-row: 1; }
    .b2b-hero__below { grid-column: 1; grid-row: 2; }
    .b2b-hero__media { grid-column: 2; grid-row: 1 / span 2; max-width: 100%; margin: 0; align-self: center; }
  }

  .b2b-eyebrow { color: #7dd3fc !important; }
  .b2b-hero h1 { max-width: 16ch; margin: 12px 0 0; color: #fff !important; font-family: var(--font-heading); font-size: clamp(1.35rem, 4.5vw, 4.7rem); font-weight: 800; letter-spacing: -.03em; line-height: 1.05; text-wrap: balance; }
  .b2b-hero p { max-width: 720px; margin: 0 0 14px; color: rgba(255,255,255,.82) !important; font-size: 1.02rem; line-height: 1.7; }
  .b2b-hero .b2b-hero__lead { color: #fff !important; font-size: clamp(.95rem, 1.8vw, 1.27rem); font-weight: 700; line-height: 1.55; margin-top: 16px; }
  .b2b-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .b2b-btn { display: inline-flex; min-height: 50px; align-items: center; justify-content: center; gap: 9px; border: 1px solid transparent; border-radius: 10px; padding: 12px 20px; font-size: .94rem; font-weight: 850; text-decoration: none; transition: transform .18s ease, border-color .18s ease, background .18s ease; }
  .b2b-btn :global(.tc-svg) { width: 18px; height: 18px; flex: 0 0 auto; }
  .b2b-btn--primary { background: #20a45a; color: #fff !important; box-shadow: 0 14px 32px rgba(0,0,0,.18); }
  .b2b-btn--secondary { border-color: rgba(255,255,255,.3); background: rgba(255,255,255,.08); color: #fff !important; }
  .b2b-btn:hover { transform: translateY(-2px); }
  .b2b-btn--primary:hover { background: #168c49; }
  .b2b-btn--secondary:hover { border-color: rgba(255,255,255,.55); background: rgba(255,255,255,.14); }
  .b2b-proof { display: flex; flex-wrap: wrap; gap: 10px 18px; margin: 28px 0 0; padding: 20px 0 0; border-top: 1px solid rgba(255,255,255,.14); list-style: none; }
  .b2b-proof li { display: inline-flex; align-items: center; gap: 7px; color: rgba(255,255,255,.86); font-size: .82rem; font-weight: 750; }
  .b2b-proof :global(.tc-svg) { width: 16px; height: 16px; flex: 0 0 auto; color: #7dd3fc; }

  /* Mobile-only tweaks: H1 size, buttons full-width, figcaption hidden */
  @media (max-width: 899px) {
    .b2b-hero { padding: 32px 0 44px; }
    .b2b-hero h1 { font-size: clamp(1.5rem, 7vw, 2.4rem); max-width: 100%; line-height: 1.1; margin-bottom: 4px; }
    .b2b-hero .b2b-hero__lead { font-size: .97rem; margin-top: 0; }
    .b2b-btn { width: 100%; justify-content: center; }
    .b2b-actions { flex-direction: column; gap: 10px; margin-top: 18px; }
    .b2b-proof { gap: 8px 14px; margin-top: 20px; }
    .b2b-hero__media figcaption { display: none; }
  }

  .b2b-cleaning-scene {
    position: relative;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgba(155, 210, 245, .28);
    border-radius: 24px;
    background:
      radial-gradient(circle at 79% 17%, rgba(97, 207, 255, .22), transparent 28%),
      radial-gradient(circle at 16% 79%, rgba(34, 117, 178, .2), transparent 36%),
      linear-gradient(145deg, #0d2b48, #061a30 68%);
    box-shadow: 0 26px 70px rgba(0, 0, 0, .34);
    isolation: isolate;
  }
  .b2b-cleaning-scene::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgba(141, 207, 241, .055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(141, 207, 241, .055) 1px, transparent 1px);
    background-size: 34px 34px;
    content: '';
    mask-image: linear-gradient(to bottom, #000, transparent 76%);
  }
  .b2b-cleaning-scene__art { display: block; width: 100%; height: 100%; min-height: 0; }
  .b2b-cleaning-scene__status {
    position: absolute;
    top: 22px;
    left: 22px;
    z-index: 2;
    min-height: 26px;
    font-size: .69rem;
    font-weight: 850;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .b2b-cleaning-scene__status span {
    position: absolute;
    top: 0;
    left: 0;
    width: max-content;
    border: 1px solid rgba(255, 255, 255, .18);
    border-radius: 999px;
    padding: 7px 12px;
    background: rgba(4, 20, 37, .75);
    color: rgba(255, 255, 255, .84);
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, .2);
  }
  .b2b-cleaning-scene__status-dirty {
    color: #fbd38d !important;
    border-color: rgba(251, 211, 141, .35) !important;
    animation: b2b-status-dirty 5.5s ease-in-out infinite both;
  }
  .b2b-cleaning-scene__status-inspecting {
    color: #7dd3fc !important;
    border-color: rgba(125, 211, 252, .35) !important;
    animation: b2b-status-inspecting 5.5s ease-in-out infinite both;
  }
  .b2b-cleaning-scene__status-clean {
    color: #6ee7b7 !important;
    border-color: rgba(110, 231, 183, .35) !important;
    animation: b2b-status-clean 5.5s ease-in-out infinite both;
  }
  .b2b-cleaning-scene__legend {
    position: absolute;
    top: 23px;
    right: 20px;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px 13px;
    max-width: 260px;
    color: rgba(234, 247, 255, .75);
    font-size: .7rem;
    font-weight: 700;
  }
  .b2b-cleaning-scene__legend span { display: inline-flex; align-items: center; gap: 6px; }
  .b2b-cleaning-scene__legend-mark { display: inline-block; width: 7px; height: 7px; border-radius: 50%; }
  .b2b-cleaning-scene__legend-mark--dust { background: #d6c4a5; box-shadow: 0 0 6px rgba(214, 196, 165, .5); }
  .b2b-cleaning-scene__legend-mark--air { background: #38bdf8; box-shadow: 0 0 8px #38bdf8; }
  .b2b-cleaning-scene__legend-mark--clean { background: #10b981; box-shadow: 0 0 8px #10b981; }

  /* Hardware-accelerated animation elements */
  .b2b-scene__dust-layer,
  .b2b-scene__static-dust,
  .b2b-scene__air-flow,
  .b2b-scene__expelled-dust,
  .b2b-scene__screen-ui,
  .b2b-scene__rim-glow,
  .b2b-scene__screen-rim,
  .b2b-scene__perimeter-trace,
  .b2b-scene__specular-sweep,
  .b2b-scene__sparkle {
    transform-box: fill-box;
    will-change: transform, opacity;
  }

  /* 1. Dust layer & Static dust */
  .b2b-scene__dust-layer { animation: b2b-dust-layer-anim 5.5s ease-in-out infinite both; }
  .b2b-scene__static-dust { animation: b2b-static-dust-anim 5.5s ease-in-out infinite both; }

  /* 2. Air Flow stream */
  .b2b-scene__air-flow { animation: b2b-air-flow-anim 5.5s cubic-bezier(0.16, 1, 0.3, 1) infinite both; }

  /* 3. Expelled dust particles */
  .b2b-scene__expelled-dust { animation: b2b-expelled-dust-anim 5.5s cubic-bezier(0.16, 1, 0.3, 1) infinite both; }

  /* 4. Screen UI clarity transition */
  .b2b-scene__screen-ui { animation: b2b-screen-ui-anim 5.5s ease-in-out infinite both; }

  /* 5. Rim Glow & Screen Rim */
  .b2b-scene__rim-glow { animation: b2b-rim-glow-anim 5.5s ease-in-out infinite both; }
  .b2b-scene__screen-rim { animation: b2b-screen-rim-anim 5.5s ease-in-out infinite both; }

  /* 6. Perimeter Laser Trace */
  .b2b-scene__perimeter-trace { animation: b2b-perimeter-trace-anim 5.5s cubic-bezier(0.2, 0.8, 0.2, 1) infinite both; }

  /* 7. Specular Light Sweep */
  .b2b-scene__specular-sweep {
    transform-origin: 300px 270px;
    animation: b2b-specular-sweep-anim 5.5s cubic-bezier(0.2, 0.8, 0.2, 1) infinite both;
  }

  /* 8. 3 Diamond Sparkles */
  .b2b-scene__sparkle { transform-origin: center; }
  .b2b-scene__sparkle--1 { animation: b2b-sparkle-1-anim 5.5s cubic-bezier(0.34, 1.56, 0.64, 1) infinite both; }
  .b2b-scene__sparkle--2 { animation: b2b-sparkle-2-anim 5.5s cubic-bezier(0.34, 1.56, 0.64, 1) infinite both; }
  .b2b-scene__sparkle--3 { animation: b2b-sparkle-3-anim 5.5s cubic-bezier(0.34, 1.56, 0.64, 1) infinite both; }

  /* Keyframe Definitions */
  @keyframes b2b-status-dirty {
    0%, 18% { opacity: 1; transform: translateY(0); }
    24%, 100% { opacity: 0; transform: translateY(-7px); }
  }

  @keyframes b2b-status-inspecting {
    0%, 18% { opacity: 0; transform: translateY(7px); }
    24%, 44% { opacity: 1; transform: translateY(0); }
    48%, 100% { opacity: 0; transform: translateY(-7px); }
  }

  @keyframes b2b-status-clean {
    0%, 48% { opacity: 0; transform: translateY(7px); }
    54%, 92% { opacity: 1; transform: translateY(0); }
    98%, 100% { opacity: 0; transform: translateY(7px); }
  }

  @keyframes b2b-dust-layer-anim {
    0%, 20% { opacity: 1; transform: translate(0, 0); }
    28% { opacity: .85; transform: translateX(-15px); }
    42% { opacity: 0; transform: translateX(-95px); }
    92% { opacity: 0; transform: translate(0, 0); }
    100% { opacity: 1; transform: translate(0, 0); }
  }

  @keyframes b2b-static-dust-anim {
    0%, 20% { opacity: 1; transform: translate(0, 0) scale(1); }
    26% { opacity: .9; transform: translate(-20px, 4px) scale(.95); }
    40% { opacity: 0; transform: translate(-120px, 12px) scale(.8); }
    92% { opacity: 0; transform: translate(0, 0) scale(1); }
    100% { opacity: 1; transform: translate(0, 0) scale(1); }
  }

  @keyframes b2b-air-flow-anim {
    0%, 18% { opacity: 0; transform: translateX(160px); }
    24% { opacity: 1; transform: translateX(0); }
    36% { opacity: .95; transform: translateX(-40px); }
    44% { opacity: .4; transform: translateX(-110px); }
    48%, 100% { opacity: 0; transform: translateX(-170px); }
  }

  @keyframes b2b-expelled-dust-anim {
    0%, 20% { opacity: 0; transform: translate(60px, -6px) scale(.6); }
    26% { opacity: 1; transform: translate(0, 0) scale(1); }
    36% { opacity: .8; transform: translate(-140px, 14px) scale(.9); }
    46% { opacity: 0; transform: translate(-260px, 28px) scale(.4); }
    48%, 100% { opacity: 0; transform: translate(60px, -6px) scale(.6); }
  }

  @keyframes b2b-screen-ui-anim {
    0%, 24% { opacity: .25; filter: blur(1.5px); }
    42% { opacity: .85; filter: blur(0); }
    54%, 92% { opacity: 1; filter: blur(0); }
    98%, 100% { opacity: .25; filter: blur(1.5px); }
  }

  @keyframes b2b-rim-glow-anim {
    0%, 48% { opacity: 0; stroke-width: 2px; }
    56% { opacity: 1; stroke-width: 3.5px; }
    68% { opacity: .85; stroke-width: 3px; }
    84% { opacity: .5; stroke-width: 2px; }
    94%, 100% { opacity: 0; stroke-width: 2px; }
  }

  @keyframes b2b-screen-rim-anim {
    0%, 48% { opacity: 0; }
    56%, 84% { opacity: .7; }
    94%, 100% { opacity: 0; }
  }

  @keyframes b2b-perimeter-trace-anim {
    0%, 50% { opacity: 0; stroke-dashoffset: 1120; }
    55% { opacity: 1; }
    70% { opacity: .9; stroke-dashoffset: 280; }
    76% { opacity: 0; stroke-dashoffset: 0; }
    78%, 100% { opacity: 0; stroke-dashoffset: 1120; }
  }

  @keyframes b2b-specular-sweep-anim {
    0%, 52% { opacity: 0; transform: translateX(-340px); }
    56% { opacity: .85; transform: translateX(-140px); }
    66% { opacity: 1; transform: translateX(180px); }
    74% { opacity: 0; transform: translateX(360px); }
    75%, 100% { opacity: 0; transform: translateX(-340px); }
  }

  @keyframes b2b-sparkle-1-anim {
    0%, 62% { opacity: 0; transform: translate(154px, 146px) scale(0) rotate(0deg); }
    66% { opacity: 1; transform: translate(154px, 146px) scale(1.25) rotate(45deg); }
    70% { opacity: .95; transform: translate(154px, 146px) scale(1) rotate(90deg); }
    75% { opacity: 0; transform: translate(154px, 146px) scale(.2) rotate(135deg); }
    76%, 100% { opacity: 0; transform: translate(154px, 146px) scale(0) rotate(0deg); }
  }

  @keyframes b2b-sparkle-2-anim {
    0%, 67% { opacity: 0; transform: translate(446px, 148px) scale(0) rotate(0deg); }
    71% { opacity: 1; transform: translate(446px, 148px) scale(1.2) rotate(-45deg); }
    75% { opacity: .9; transform: translate(446px, 148px) scale(1) rotate(-90deg); }
    79% { opacity: 0; transform: translate(446px, 148px) scale(.2) rotate(-135deg); }
    80%, 100% { opacity: 0; transform: translate(446px, 148px) scale(0) rotate(0deg); }
  }

  @keyframes b2b-sparkle-3-anim {
    0%, 71% { opacity: 0; transform: translate(432px, 350px) scale(0) rotate(0deg); }
    75% { opacity: 1; transform: translate(432px, 350px) scale(1.15) rotate(45deg); }
    79% { opacity: .85; transform: translate(432px, 350px) scale(.95) rotate(90deg); }
    83% { opacity: 0; transform: translate(432px, 350px) scale(.2) rotate(135deg); }
    84%, 100% { opacity: 0; transform: translate(432px, 350px) scale(0) rotate(0deg); }
  }
  .b2b-hero__media figcaption { position: absolute; right: -18px; bottom: 22px; left: 22px; display: grid; gap: 3px; border: 1px solid rgba(255,255,255,.17); border-radius: 14px; padding: 15px 17px; background: rgba(6,24,43,.91); box-shadow: 0 16px 35px rgba(0,0,0,.25); backdrop-filter: blur(12px); }
  .b2b-hero__media strong { color: #fff; font-size: .95rem; }
  .b2b-hero__media span { color: rgba(255,255,255,.72); font-size: .8rem; line-height: 1.45; }

  .b2b-answers { position: relative; z-index: 2; border-bottom: 1px solid var(--b2b-line); background: #fff; }
  .b2b-answers__grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .b2b-answers__grid div { padding: 22px 20px; border-right: 1px solid var(--b2b-line); }
  .b2b-answers__grid div:first-child { padding-left: 0; }
  .b2b-answers__grid div:last-child { border-right: 0; }
  .b2b-answers span { display: block; margin-bottom: 4px; color: var(--b2b-blue); font-size: .72rem; font-weight: 850; text-transform: uppercase; }
  .b2b-answers strong { display: block; color: var(--b2b-ink); font-size: .93rem; line-height: 1.4; }

  .b2b-split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, .7fr); gap: clamp(40px, 7vw, 84px); align-items: start; }
  .b2b-note { display: flex; gap: 16px; border: 1px solid #bcd7ec; border-radius: 16px; padding: 22px; background: #eef7ff; }
  .b2b-note > :global(.tc-svg) { width: 24px; height: 24px; flex: 0 0 auto; color: var(--b2b-blue); }
