  .b2b-note p { margin: 7px 0 0; font-size: .92rem; }

  .b2b-card-grid { display: grid; gap: 18px; }
  .b2b-card-grid--three { grid-template-columns: repeat(3, 1fr); }
  .b2b-card { border: 1px solid var(--b2b-line); border-radius: 16px; padding: 24px; background: #fff; box-shadow: 0 10px 28px rgba(15,35,55,.045); }
