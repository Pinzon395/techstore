---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import TicketFormSection from '../../components/TicketFormSection.astro';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/LocalSpriteIcon.astro';
import { buildBreadcrumbSchema, buildFAQSchema, buildServiceSchema } from '../../lib/schema';

const canonical = 'https://pixon.com.mx/servicios/mantenimiento-preventivo-pc-empresas';
const title = 'Mantenimiento de PC para Empresas en Cancún | Pixon PC';
const description = 'Mantenimiento preventivo por lote para computadoras de empresas en Cancún. Atención programada para PCs y laptops con reporte técnico. Cotiza por WhatsApp.';
const heroImage = '/assets/images/mantenimiento-pc-escritorio.webp';
const whatsappMessage = 'Hola Pixon. Quiero cotizar mantenimiento preventivo para las computadoras de mi empresa. Tenemos aproximadamente ____ equipos y estamos ubicados en ____.';
const whatsappUrl = `https://wa.me/529986690777?text=${encodeURIComponent(whatsappMessage)}`;

const warningSigns = [
  {
    icon: 'gauge-high',
    title: 'Equipos lentos durante la jornada',
    text: 'Una computadora lenta no siempre necesita limpieza. Revisamos síntomas, programas de inicio, almacenamiento disponible y condición del disco para distinguir mantenimiento de una posible reparación o actualización.',
  },
  {
    icon: 'fan',
    title: 'Ventiladores con ruido constante',
    text: 'El ruido puede relacionarse con polvo, flujo de aire limitado, desgaste del ventilador o carga de trabajo elevada. La inspección permite identificar la causa antes de autorizar una intervención.',
  },
  {
    icon: 'temperature-high',
    title: 'Temperaturas elevadas',
    text: 'Gabinetes bajo escritorios, rejillas obstruidas y ambientes cálidos pueden dificultar la ventilación. También existen otras causas, por lo que primero se revisa la condición real del equipo.',
  },
  {
    icon: 'power-off',
    title: 'Apagados o reinicios inesperados',
    text: 'Un apagado puede tener origen térmico, eléctrico, de memoria, almacenamiento o sistema operativo. El mantenimiento ayuda a revisar señales visibles, pero no sustituye un diagnóstico cuando la falla ya existe.',
  },
  {
    icon: 'hard-drive',
    title: 'Almacenamiento con alertas',
    text: 'Tiempos de arranque largos, errores al abrir archivos o bloqueos pueden justificar una revisión del SSD o HDD. Cualquier cambio de pieza o respaldo se cotiza y autoriza por separado.',
  },
  {
    icon: 'calendar-days',
    title: 'Mucho tiempo sin revisión',
    text: 'Cuando varios equipos operan durante jornadas largas sin historial de mantenimiento, conviene levantar inventario y revisar primero las áreas críticas para definir prioridades reales.',
  },
];

const includedItems = [
  ['clipboard-check', 'Inventario inicial', 'Identificación del equipo, área y responsable cuando la empresa lo requiere.'],
  ['magnifying-glass', 'Inspección física', 'Revisión exterior, conexiones, rejillas, filtros y señales visibles antes de abrir.'],
  ['broom', 'Limpieza interna', 'Retiro de polvo en las zonas accesibles cuando el diseño y la condición lo permiten.'],
  ['fan', 'Ventiladores y disipación', 'Revisión de ventiladores, disipadores, radiadores y circulación de aire.'],
  ['temperature-high', 'Condición térmica', 'Comprobación de síntomas y temperaturas según el tipo de hardware y carga.'],
  ['microchip', 'Pasta térmica', 'Se revisa y se reemplaza únicamente cuando la condición del equipo lo justifica.'],
  ['hard-drive', 'SSD o HDD', 'Consulta de indicadores básicos de salud cuando existe sospecha de almacenamiento.'],
  ['memory', 'Memoria RAM', 'Pruebas cuando hay congelamientos, errores o síntomas relacionados.'],
  ['windows', 'Revisión básica de Windows', 'Programas de inicio, espacio disponible y actualizaciones autorizadas.'],
  ['check-double', 'Comprobación posterior', 'Encendido, ventilación y funcionamiento general después del ensamble.'],
  ['file-lines', 'Registro de hallazgos', 'Observaciones por equipo para que el responsable conozca qué se encontró.'],
  ['list-check', 'Recomendaciones', 'Acciones sugeridas separadas del mantenimiento y sujetas a autorización.'],
];

const criticalAreas = [
  ['Recepción', 'Equipos usados para atención, registro y comunicación con clientes.'],
  ['Facturación', 'Computadoras que concentran documentos y tareas administrativas.'],
  ['Ventas y cajas', 'PCs vinculadas a cobro, consulta de productos o atención.'],
  ['Contabilidad', 'Equipos de trabajo con información y procesos sensibles.'],
  ['Reservaciones', 'Estaciones utilizadas durante jornadas amplias en operación.'],
  ['Diseño y workstations', 'Equipos con cargas sostenidas de CPU, GPU o almacenamiento.'],
  ['Administración', 'Computadoras compartidas por personal operativo o gerencial.'],
  ['Gerencia', 'Equipos cuya indisponibilidad complica decisiones y seguimiento.'],
];

const sectors = [
  ['building', 'PyMEs y oficinas', 'Equipos administrativos, recepción, ventas, contabilidad y estaciones compartidas.'],
  ['hotel', 'Hoteles y hospedaje', 'Computadoras de recepción, reservaciones y administración, organizadas según prioridad.'],
  ['utensils', 'Restaurantes y comercios', 'Equipos de oficina, cajas y facturación, sin asumir soporte de software específico.'],
  ['briefcase', 'Agencias y despachos', 'PCs, laptops y estaciones de trabajo utilizadas durante jornadas completas.'],
  ['stethoscope', 'Consultorios y servicios', 'Mantenimiento programado de equipos administrativos y de atención.'],
  ['graduation-cap', 'Escuelas y capacitación', 'Computadoras de administración, docentes y áreas de trabajo compartido.'],
];

const processSteps = [
  ['01', 'Levantamiento', 'Conocemos cantidad aproximada, tipos de equipo, ubicación y necesidades de la empresa.'],
  ['02', 'Inventario', 'Identificamos los equipos incluidos y el área a la que pertenecen.'],
  ['03', 'Priorización', 'Separamos equipos críticos de los que pueden atenderse con mayor flexibilidad.'],
  ['04', 'Calendarización', 'Acordamos bloques de trabajo según disponibilidad y operación del negocio.'],
  ['05', 'Mantenimiento', 'Realizamos únicamente el alcance previamente autorizado para cada grupo.'],
  ['06', 'Pruebas', 'Comprobamos encendido, ventilación y funcionamiento general antes de cerrar.'],
  ['07', 'Reporte', 'Registramos trabajos, hallazgos y observaciones relevantes por equipo.'],
  ['08', 'Recomendaciones', 'Separamos mantenimiento realizado de reparaciones o mejoras que requieran autorización.'],
];

const faqs = [
  {
    question: '¿Qué incluye el mantenimiento preventivo para empresas?',
    answer: 'El alcance se define según los equipos y su condición. Puede incluir inventario, inspección física, limpieza interna, revisión de ventiladores y disipación, comprobaciones térmicas, estado básico del almacenamiento, pruebas posteriores y un registro de hallazgos. Cualquier reparación o refacción se cotiza por separado.',
  },
  {
    question: '¿Atienden varias computadoras en una misma empresa?',
    answer: 'Sí. La página está enfocada en oficinas y negocios con varios equipos. Primero confirmamos cantidad, tipos de computadora, áreas críticas y disponibilidad para proponer una atención por grupos.',
  },
  {
    question: '¿Pueden realizar mantenimiento por lotes?',
    answer: 'Sí. Podemos organizar los equipos por área, prioridad o bloque de trabajo. El tamaño de cada lote y el calendario se acuerdan después de conocer el volumen y las condiciones de la empresa.',
  },
  {
    question: '¿Dan mantenimiento a PCs y laptops?',
    answer: 'Sí. Atendemos PCs de escritorio y laptops empresariales. El procedimiento cambia según marca, modelo, diseño interno y facilidad de acceso, por lo que no todos los equipos reciben exactamente las mismas tareas.',
  },
  {
    question: '¿Cómo evitan detener toda la oficina?',
    answer: 'Priorizamos los equipos que la operación necesita y planteamos bloques escalonados. No prometemos cero interrupciones, pero la calendarización permite reducir el impacto frente a retirar todos los equipos al mismo tiempo.',
  },
  {
    question: '¿Pueden trabajar con equipos de diferentes marcas?',
    answer: 'Sí, sujeto a la revisión de cada modelo. Una misma empresa puede tener computadoras de distintas marcas y generaciones; por eso el inventario y el alcance se confirman antes de intervenir.',
  },
  {
    question: '¿El mantenimiento borra archivos?',
    answer: 'La limpieza física no tiene como objetivo modificar archivos. Si se requiere trabajar sobre Windows, almacenamiento o respaldos, primero se explica el alcance y se solicita autorización. Recomendamos contar con respaldo vigente de la información importante.',
  },
  {
    question: '¿Incluye cambio de pasta térmica?',
    answer: 'No en todos los equipos. Se revisa según antigüedad, condición, diseño y comportamiento térmico. Si conviene reemplazarla, se informa antes de realizarlo y se considera dentro del alcance autorizado.',
  },
  {
    question: '¿Cada cuánto debe hacerse mantenimiento preventivo?',
    answer: 'No existe un intervalo universal. Depende de horas de uso, polvo, temperatura, ubicación, ventilación, tipo de gabinete y criticidad del equipo. Con el inventario y los hallazgos puede proponerse una revisión acorde con la operación real.',
  },
  {
    question: '¿Pueden revisar equipos que trabajan todo el día?',
    answer: 'Sí. Es importante identificar esos equipos desde el levantamiento para acordar una ventana de atención y revisar su carga, ventilación y condición sin asumir que todas las fallas se deben a temperatura.',
  },
  {
    question: '¿Atienden hoteles y restaurantes en Cancún?',
    answer: 'Sí. Podemos cotizar mantenimiento de sus computadoras administrativas, de recepción o trabajo. El soporte de redes, impresoras, sistemas especializados o pólizas continuas se revisa como un alcance diferente.',
  },
  {
    question: '¿Atienden pequeñas empresas?',
    answer: 'Sí. La cotización se adapta al número y tipo de equipos; no es necesario tener una flotilla grande para solicitar una revisión empresarial.',
  },
  {
    question: '¿Cómo se cotiza un mantenimiento por volumen?',
    answer: 'Necesitamos cantidad aproximada, tipos de equipo, ubicación, síntomas, áreas críticas y horario disponible. Con esos datos definimos si conviene una visita inicial, recepción por lote o una revisión programada. No publicamos un precio único porque el alcance cambia entre empresas.',
  },
  {
    question: '¿Pueden llevar un registro por computadora?',
    answer: 'Podemos documentar equipo, área, marca, modelo, estado observado, mantenimiento realizado y recomendaciones cuando el alcance acordado lo incluye. El nivel de detalle se confirma en la cotización.',
  },
  {
    question: '¿También ofrecen soporte TI continuo?',
    answer: 'Sí, pero es un servicio diferente. Para incidencias recurrentes, usuarios, redes, WiFi, soporte remoto o pólizas mensuales consulta la página de soluciones para empresas.',
  },
  {
    question: '¿Dan servicio en las instalaciones de la empresa?',
    answer: 'Podemos coordinar visita, recepción o recolección por lote en Cancún según cantidad de equipos, tipo de trabajo, zona y disponibilidad. Primero confirmamos qué actividades pueden realizarse de forma segura en sitio.',
  },
];

const schema = [
  buildServiceSchema({
    service: {
      label: 'Mantenimiento preventivo de computadoras para empresas en Cancún',
      seoKeyword: 'Mantenimiento preventivo de computadoras para empresas en Cancún',
      intro: description,
      heroImage,
    },
    category: { title: 'Servicios para empresas', slug: 'empresas' },
    url: canonical,
    description,
    image: heroImage,
  }),
  buildBreadcrumbSchema([
    { label: 'Inicio', href: '/' },
    { label: 'Empresas', href: '/empresas' },
    { label: 'Mantenimiento preventivo', href: canonical },
  ]),
  buildFAQSchema(faqs),
].filter(Boolean) as object[];
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  image={heroImage}
  ogTitle="Mantenimiento de Computadoras para Empresas | Pixon PC"
  ogDescription="Mantenimiento preventivo por lote para PCs y laptops de empresas en Cancún. Inventario, calendarización y reporte técnico."
  robots="index, follow"
  schema={schema}
  bodyClass="service-page b2b-maintenance-page"
  preloadSprite={true}
>
  <Navbar />

  <Breadcrumb items={[
    { label: 'Inicio', href: '/' },
    { label: 'Empresas', href: '/empresas' },
    { label: 'Mantenimiento preventivo' },
  ]} />

  <main class="b2b-maintenance">
    <section class="b2b-hero" aria-labelledby="b2b-title">
      <div class="b2b-shell b2b-hero__grid">
        <div class="b2b-hero__copy">
          <span class="b2b-eyebrow">Mantenimiento TI para empresas en Cancún</span>
          <h1 id="b2b-title">Mantenimiento preventivo de computadoras para empresas en Cancún</h1>
          <p class="b2b-hero__lead">Programamos limpieza, revisión preventiva y mantenimiento de PCs y laptops empresariales sin detener innecesariamente la operación de tu negocio.</p>
          <p>Atendemos equipos por lote, organizando el trabajo según la prioridad de cada área para reducir interrupciones y mantener un historial técnico claro por computadora.</p>
          <div class="b2b-actions">
            <a
              class="b2b-btn b2b-btn--primary"
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-b2b-event="b2b_quote_click"
              data-b2b-secondary-event="b2b_whatsapp_click"
              data-placement="hero"
            ><Icon name="whatsapp" /> Solicitar cotización empresarial</a>
            <a
              class="b2b-btn b2b-btn--secondary"
              href="tel:+529986690777"
              data-b2b-event="b2b_quote_click"
              data-placement="hero_phone"
            ><Icon name="phone" /> Hablar con un técnico</a>
          </div>
          <ul class="b2b-proof" aria-label="Características del servicio">
            <li><Icon name="boxes-stacked" /> Atención por lote</li>
            <li><Icon name="desktop" /> PCs y laptops</li>
            <li><Icon name="calendar-check" /> Servicio programado</li>
            <li><Icon name="file-lines" /> Reporte técnico</li>
            <li><Icon name="location-dot" /> Atención en Cancún</li>
          </ul>
        </div>

        <figure class="b2b-hero__media">
          <img
            src={heroImage}
            alt="Limpieza interna de una computadora de escritorio durante mantenimiento preventivo"
            width="1280"
            height="1280"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <figcaption>
            <strong>Mantenimiento con contexto</strong>
            <span>Primero confirmamos equipo, condición y prioridad; después definimos el alcance.</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="b2b-answers" aria-label="Respuestas rápidas">
      <div class="b2b-shell b2b-answers__grid">
        <div><span>¿Atienden empresas?</span><strong>Sí, oficinas y negocios en Cancún.</strong></div>
        <div><span>¿Varios equipos?</span><strong>Se organizan por lote y prioridad.</strong></div>
        <div><span>¿PCs y laptops?</span><strong>El proceso se adapta a cada modelo.</strong></div>
        <div><span>¿En las instalaciones?</span><strong>Según alcance, zona y disponibilidad.</strong></div>
      </div>
    </section>

    <section class="b2b-section" aria-labelledby="meaning-title">
      <div class="b2b-shell b2b-split">
        <div>
          <span class="b2b-label">Prevención con alcance definido</span>
          <h2 id="meaning-title">¿Qué es el mantenimiento preventivo empresarial?</h2>
          <p>Es una revisión programada de los equipos de cómputo antes de que una incidencia obligue a detener actividades. Su objetivo es observar la condición física, retirar suciedad cuando corresponde, revisar ventilación y registrar señales que conviene atender.</p>
          <p>No es lo mismo que una reparación correctiva. Si una computadora ya presenta una falla de tarjeta madre, fuente, memoria, almacenamiento o sistema operativo, primero debe diagnosticarse. El mantenimiento puede ayudar a detectar indicios y facilitar una corrección planeada, pero no garantiza que un equipo nunca falle.</p>
        </div>
        <aside class="b2b-note">
          <Icon name="circle-info" />
          <div>
            <strong>Una cotización empresarial empieza con información básica</strong>
            <p>Cantidad aproximada, tipos de equipo, áreas críticas, ubicación y horarios disponibles. No asignamos un precio por volumen sin conocer ese alcance.</p>
          </div>
        </aside>
      </div>
    </section>

    <section class="b2b-section b2b-section--soft" aria-labelledby="warning-title">
      <div class="b2b-shell">
        <header class="b2b-heading">
          <span class="b2b-label">Señales que conviene revisar</span>
          <h2 id="warning-title">¿Qué pasa cuando las computadoras de una empresa no reciben mantenimiento?</h2>
          <p>El polvo, el uso continuo y la falta de historial pueden ocultar problemas distintos. Una revisión ordenada permite identificar señales, priorizar correcciones y evitar compras hechas sin diagnóstico.</p>
        </header>
        <div class="b2b-card-grid b2b-card-grid--three">
          {warningSigns.map((item) => (
            <article class="b2b-card">
              <span class="b2b-icon"><Icon name={item.icon} /></span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="b2b-section" id="incluye" aria-labelledby="includes-title">
      <div class="b2b-shell">
        <header class="b2b-heading b2b-heading--wide">
          <span class="b2b-label">Alcance técnico</span>
          <h2 id="includes-title">¿Qué incluye el mantenimiento preventivo empresarial?</h2>
          <p>El procedimiento exacto cambia entre una PC de oficina, una laptop, una workstation y un equipo compacto. Estas son las tareas que pueden formar parte del servicio después de revisar el lote.</p>
        </header>
        <div class="b2b-includes">
          {includedItems.map(([icon, itemTitle, text], index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <Icon name={icon} />
              <div><h3>{itemTitle}</h3><p>{text}</p></div>
            </article>
          ))}
        </div>
        <p class="b2b-disclaimer"><strong>Importante:</strong> no cambiamos pasta térmica, piezas, configuraciones ni almacenamiento automáticamente. Cualquier acción adicional depende de la inspección y requiere autorización.</p>
      </div>
    </section>

    <section class="b2b-section b2b-section--dark" aria-labelledby="batch-title">
      <div class="b2b-shell">
        <div class="b2b-dark-intro">
          <div>
            <span class="b2b-label">El diferenciador B2B</span>
            <h2 id="batch-title">Mantenimiento por lote sin detener toda tu oficina</h2>
          </div>
          <p>En lugar de retirar todas las computadoras al mismo tiempo, identificamos equipos, áreas y prioridades. Así podemos proponer bloques de trabajo y mantener disponibles los puestos que la operación necesita.</p>
        </div>
        <ol class="b2b-flow" aria-label="Flujo de mantenimiento por lote">
          <li><span>01</span><strong>Inventario</strong><small>Equipos y áreas</small></li>
          <li><span>02</span><strong>Priorización</strong><small>Puestos críticos</small></li>
          <li><span>03</span><strong>Grupos</strong><small>Bloques programados</small></li>
          <li><span>04</span><strong>Pruebas</strong><small>Comprobación final</small></li>
          <li><span>05</span><strong>Reporte</strong><small>Hallazgos por equipo</small></li>
        </ol>
        <div class="b2b-dark-cta">
          <p>¿Ya sabes aproximadamente cuántas computadoras necesitan revisión?</p>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-b2b-event="b2b_whatsapp_click" data-placement="batch"><Icon name="whatsapp" /> Cotizar mantenimiento por lote</a>
        </div>
      </div>
    </section>

    <section class="b2b-section" aria-labelledby="critical-title">
      <div class="b2b-shell">
        <header class="b2b-heading">
          <span class="b2b-label">Continuidad operativa</span>
          <h2 id="critical-title">Priorizamos los equipos que tu operación no puede perder</h2>
          <p>Cada empresa tiene puestos distintos. Durante el levantamiento identificamos qué computadoras pueden salir de operación y cuáles necesitan una ventana cuidadosamente acordada.</p>
        </header>
        <div class="b2b-priority-grid">
          {criticalAreas.map(([area, text]) => (
            <article><span aria-hidden="true"></span><div><h3>{area}</h3><p>{text}</p></div></article>
          ))}
        </div>
      </div>
    </section>

    <section class="b2b-section b2b-section--soft" aria-labelledby="equipment-title">
      <div class="b2b-shell">
        <header class="b2b-heading">
          <span class="b2b-label">Hardware de trabajo</span>
          <h2 id="equipment-title">Equipos que podemos incluir en un plan de mantenimiento</h2>
          <p>Podemos cotizar un lote mixto. El inventario evita aplicar el mismo procedimiento a equipos con diseños y necesidades diferentes.</p>
        </header>
        <div class="b2b-device-grid">
          <article>
            <Icon name="desktop" />
            <h3>Mantenimiento de computadoras de oficina en Cancún</h3>
            <p>PCs de escritorio, equipos administrativos, mini PC, cajas y estaciones de facturación suelen trabajar bajo escritorios o durante jornadas largas. Revisamos ventilación, suciedad, ruido, almacenamiento y señales de inestabilidad sin asumir que la limpieza resolverá cualquier lentitud.</p>
          </article>
          <article>
            <Icon name="laptop" />
            <h3>Mantenimiento de laptops para empresas</h3>
            <p>Las flotillas de laptops combinan modelos, usuarios y patrones de uso distintos. Organizamos inventario y calendarización para revisar ventilación, temperatura, cargadores o condición física según el equipo, sin competir con el servicio individual de una sola laptop.</p>
          </article>
          <article>
            <Icon name="microchip" />
            <h3>Workstations y equipos de alto rendimiento</h3>
            <p>Estaciones de diseño, arquitectura o producción pueden mantener cargas elevadas de CPU, GPU y almacenamiento. Su mantenimiento requiere confirmar hardware, refrigeración y disponibilidad antes de abrir o realizar pruebas.</p>
          </article>
        </div>
        <p class="b2b-inline-link">¿Necesitas atención para una sola computadora? Consulta el <a href="/mantenimiento-preventivo-computadora">mantenimiento preventivo de PC individual</a>. Para impresoras existe un <a href="/servicios/impresora">catálogo de servicio específico</a>.</p>
      </div>
    </section>

    <section class="b2b-section" aria-labelledby="sectors-title">
      <div class="b2b-shell">
        <header class="b2b-heading">
          <span class="b2b-label">Sectores atendidos</span>
          <h2 id="sectors-title">Mantenimiento para negocios que dependen de sus computadoras</h2>
          <p>La prioridad cambia entre recepción, administración, caja y producción. No usamos un paquete idéntico para todos los giros.</p>
        </header>
        <div class="b2b-sector-grid">
          {sectors.map(([icon, sector, text]) => (
            <article><Icon name={icon} /><h3>{sector}</h3><p>{text}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="b2b-section b2b-section--soft" aria-labelledby="choice-title">
      <div class="b2b-shell">
        <header class="b2b-heading">
          <span class="b2b-label">Elegir el servicio correcto</span>
          <h2 id="choice-title">¿Necesitas mantenimiento preventivo o soporte TI continuo?</h2>
          <p>Separar ambos alcances evita pagar por servicios que tu empresa no necesita y permite cotizar con claridad.</p>
        </header>
        <div class="b2b-compare">
          <article class="b2b-compare__featured">
            <span>Servicio de esta página</span>
            <h3>Mantenimiento preventivo empresarial</h3>
            <p>Indicado para limpieza, revisiones programadas, mantenimiento físico por lote, ventilación, condición térmica e historial de equipos.</p>
            <ul><li>Hardware y prevención</li><li>Trabajo por lotes</li><li>Calendarización</li><li>Reporte de hallazgos</li></ul>
            <a href="#cotizacion-empresa" data-b2b-event="b2b_ticket_start" data-placement="comparison">Cotizar mantenimiento <Icon name="arrow-right" /></a>
          </article>
          <article>
            <span>Servicio de alcance continuo</span>
            <h3>Soporte TI para empresas</h3>
            <p>Indicado para incidencias frecuentes, usuarios, redes, WiFi, soporte remoto, administración tecnológica y pólizas recurrentes.</p>
            <ul><li>Mesa de ayuda</li><li>Red y WiFi</li><li>Atención recurrente</li><li>Pólizas y prioridades</li></ul>
            <a href="/empresas" data-b2b-event="business_services_click" data-placement="comparison">Conocer soporte TI <Icon name="arrow-right" /></a>
          </article>
        </div>
      </div>
    </section>

    <section class="b2b-section" aria-labelledby="process-title">
      <div class="b2b-shell">
        <header class="b2b-heading b2b-heading--wide">
          <span class="b2b-label">Proceso Pixon PC</span>
          <h2 id="process-title">¿Cómo organizamos el mantenimiento de una empresa?</h2>
          <p>El proceso parte de información verificable y conserva una separación clara entre lo solicitado, lo realizado y lo que requiere una decisión posterior.</p>
        </header>
        <ol class="b2b-process">
          {processSteps.map(([number, stepTitle, text]) => (
            <li><span>{number}</span><div><h3>{stepTitle}</h3><p>{text}</p></div></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="b2b-section b2b-section--report" aria-labelledby="report-title">
      <div class="b2b-shell b2b-report-grid">
        <div>
          <span class="b2b-label">Trazabilidad útil</span>
          <h2 id="report-title">Un historial claro por cada computadora</h2>
          <p>Cuando el alcance acordado incluye reporte, podemos registrar equipo, área o usuario, marca, modelo, número de serie cuando corresponda, condición observada, mantenimiento realizado y recomendaciones.</p>
          <p>El reporte no convierte una observación en una reparación autorizada. Si encontramos un disco con alertas, memoria inestable, ventilador desgastado o una pieza que requiere cambio, se informa y se cotiza aparte.</p>
        </div>
        <ul class="b2b-report-list">
          <li><Icon name="tag" /><span><strong>Identificación</strong> Equipo, área y modelo.</span></li>
          <li><Icon name="screwdriver-wrench" /><span><strong>Trabajo realizado</strong> Alcance aplicado al equipo.</span></li>
          <li><Icon name="triangle-exclamation" /><span><strong>Hallazgos</strong> Señales que requieren atención.</span></li>
          <li><Icon name="list-check" /><span><strong>Siguiente paso</strong> Recomendaciones separadas.</span></li>
        </ul>
      </div>
    </section>

    <section class="b2b-section" aria-labelledby="frequency-title">
      <div class="b2b-shell b2b-two-topics">
        <article>
          <span class="b2b-label">Frecuencia basada en uso</span>
          <h2 id="frequency-title">¿Cada cuánto necesita mantenimiento una computadora de empresa?</h2>
          <p>No existe una frecuencia idéntica para todas. Depende de horas de uso, ubicación, polvo, temperatura, tipo de gabinete, ventilación, número de usuarios y criticidad. Una PC de recepción que opera durante jornadas largas puede requerir revisiones diferentes a una computadora administrativa de uso ocasional.</p>
          <p>El primer levantamiento y los hallazgos ayudan a proponer un calendario razonable sin imponer revisiones innecesarias.</p>
        </article>
        <article>
          <span class="b2b-label">Contexto local</span>
          <h2>Computadoras empresariales en el clima de Cancún</h2>
          <p>El calor, la humedad, el polvo ambiental y la ubicación del gabinete pueden influir en la acumulación de residuos y en la ventilación. Cerca del ambiente costero también conviene observar señales de corrosión, pero no debe asumirse que aparecerán en todos los equipos.</p>
          <p>La recomendación se basa en la condición encontrada, no en afirmaciones generales sobre “salitre” o temperaturas garantizadas.</p>
        </article>
      </div>
    </section>

    <section class="b2b-section b2b-section--form" id="cotizacion-empresa" aria-labelledby="quote-title">
      <div class="b2b-shell b2b-form-intro">
        <span class="b2b-label">Cotización por volumen</span>
        <h2 id="quote-title">Cuéntanos cuántos equipos necesita revisar tu empresa</h2>
        <p>El formulario utiliza el sistema de tickets existente de Pixon PC. Incluye nombre de empresa, cantidad y tipo de equipos, frecuencia deseada, datos de contacto y descripción de la necesidad.</p>
      </div>
      <TicketFormSection
        id="ticket-empresa"
        defaultDevice="Equipo empresarial / B2B"
        defaultService="Mantenimiento de flotilla"
        sourcePage="/servicios/mantenimiento-preventivo-pc-empresas"
        title="Solicitar cotización empresarial"
        subtitle="Indica la cantidad aproximada de equipos, tipos, ubicación y prioridad. Confirmaremos el alcance antes de intervenir."
      />
    </section>

    <FaqSection
      id="faq-mantenimiento-empresarial"
      title="Preguntas frecuentes sobre mantenimiento para empresas"
      description="Respuestas claras sobre atención por lote, PCs, laptops, reportes y cotización empresarial en Cancún."
      items={faqs}
      ariaLabel="Preguntas frecuentes sobre mantenimiento preventivo de computadoras para empresas"
    />

    <section class="b2b-final" aria-labelledby="final-title">
      <div class="b2b-shell b2b-final__grid">
        <div>
          <span>Consulta empresarial directa</span>
          <h2 id="final-title">¿Necesitas organizar el mantenimiento de varias computadoras?</h2>
          <p>Envíanos la cantidad aproximada, tipos de equipo, zona y áreas que no pueden detenerse. Con esa información definimos el siguiente paso.</p>
        </div>
        <div class="b2b-final__actions">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-b2b-event="b2b_quote_click" data-b2b-secondary-event="b2b_whatsapp_click" data-placement="final"><Icon name="whatsapp" /> Solicitar cotización empresarial</a>
          <a href="/empresas" data-b2b-event="business_services_click" data-placement="final">Ver soluciones para empresas</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script defer src="/scripts/b2b-maintenance-events.js?v=20260808-1"></script>
</Base>

<style>
  .b2b-maintenance {
    --b2b-ink: #0b2038;
    --b2b-muted: #53667a;
    --b2b-blue: #1479d4;
    --b2b-blue-dark: #0c4f8b;
    --b2b-soft: #f3f7fb;
    --b2b-line: #dce6f0;
    overflow: clip;
    background: #fff;
    color: var(--b2b-ink);
  }

  .b2b-maintenance,
  .b2b-maintenance *,
  .b2b-maintenance *::before,
  .b2b-maintenance *::after { box-sizing: border-box; }

  .b2b-shell { width: min(1180px, calc(100% - 40px)); margin-inline: auto; }
  .b2b-section { padding: clamp(64px, 8vw, 104px) 0; }
  .b2b-section--soft { background: var(--b2b-soft); }
  .b2b-label,
  .b2b-eyebrow { display: inline-flex; color: var(--b2b-blue); font-size: .76rem; font-weight: 850; letter-spacing: .09em; line-height: 1.3; text-transform: uppercase; }
  .b2b-heading { max-width: 760px; margin-bottom: 34px; }
  .b2b-heading--wide { max-width: 880px; }
  .b2b-heading h2,
  .b2b-section h2,
  .b2b-final h2 { margin: 8px 0 14px; color: var(--b2b-ink); font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 3rem); line-height: 1.1; text-wrap: balance; }
  .b2b-heading p,
  .b2b-section p { color: var(--b2b-muted); font-size: 1rem; line-height: 1.72; }
  .b2b-section p + p { margin-top: 14px; }

  .b2b-hero { position: relative; padding: clamp(58px, 8vw, 102px) 0; background: radial-gradient(circle at 84% 22%, rgba(32, 141, 231, .2), transparent 32%), linear-gradient(135deg, #06182b, #0a2947 62%, #0d365e); }
  .b2b-hero__grid { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(340px, .72fr); gap: clamp(40px, 6vw, 76px); align-items: center; }
  .b2b-hero__copy { position: relative; z-index: 1; }
  .b2b-eyebrow { color: #7dd3fc !important; }
  .b2b-hero h1 { max-width: 16ch; margin: 12px 0 18px; color: #fff !important; font-family: var(--font-heading); font-size: clamp(2.25rem, 5vw, 4.55rem); font-weight: 800; line-height: 1.02; text-wrap: balance; }
  .b2b-hero p { max-width: 720px; margin: 0 0 14px; color: rgba(255,255,255,.82) !important; font-size: 1.02rem; line-height: 1.7; }
  .b2b-hero .b2b-hero__lead { color: #fff !important; font-size: clamp(1.08rem, 1.8vw, 1.27rem); font-weight: 700; line-height: 1.55; }
  .b2b-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .b2b-btn { display: inline-flex; min-height: 50px; align-items: center; justify-content: center; gap: 9px; border: 1px solid transparent; border-radius: 10px; padding: 12px 20px; font-size: .94rem; font-weight: 850; text-decoration: none; transition: transform .18s ease, border-color .18s ease, background .18s ease; }
  .b2b-btn svg { width: 18px; height: 18px; }
  .b2b-btn--primary { background: #20a45a; color: #fff !important; box-shadow: 0 14px 32px rgba(0,0,0,.18); }
  .b2b-btn--secondary { border-color: rgba(255,255,255,.3); background: rgba(255,255,255,.08); color: #fff !important; }
  .b2b-btn:hover { transform: translateY(-2px); }
  .b2b-btn--primary:hover { background: #168c49; }
  .b2b-btn--secondary:hover { border-color: rgba(255,255,255,.55); background: rgba(255,255,255,.14); }
  .b2b-proof { display: flex; flex-wrap: wrap; gap: 10px 18px; margin: 28px 0 0; padding: 20px 0 0; border-top: 1px solid rgba(255,255,255,.14); list-style: none; }
  .b2b-proof li { display: inline-flex; align-items: center; gap: 7px; color: rgba(255,255,255,.86); font-size: .82rem; font-weight: 750; }
  .b2b-proof svg { width: 15px; height: 15px; color: #7dd3fc; }
  .b2b-hero__media { position: relative; margin: 0; }
  .b2b-hero__media img { display: block; width: 100%; aspect-ratio: 1; border: 1px solid rgba(255,255,255,.18); border-radius: 24px; object-fit: cover; box-shadow: 0 26px 70px rgba(0,0,0,.34); }
  .b2b-hero__media figcaption { position: absolute; right: -18px; bottom: 22px; left: 22px; display: grid; gap: 3px; border: 1px solid rgba(255,255,255,.17); border-radius: 14px; padding: 15px 17px; background: rgba(6,24,43,.91); box-shadow: 0 16px 35px rgba(0,0,0,.25); backdrop-filter: blur(12px); }
  .b2b-hero__media strong { color: #fff; font-size: .95rem; }
  .b2b-hero__media span { color: rgba(255,255,255,.72); font-size: .8rem; line-height: 1.45; }

  .b2b-answers { position: relative; z-index: 2; border-bottom: 1px solid var(--b2b-line); background: #fff; }
  .b2b-answers__grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .b2b-answers__grid div { padding: 22px 20px; border-right: 1px solid var(--b2b-line); }
  .b2b-answers__grid div:first-child { padding-left: 0; }
  .b2b-answers__grid div:last-child { border-right: 0; }
  .b2b-answers span { display: block; margin-bottom: 4px; color: var(--b2b-blue); font-size: .72rem; font-weight: 850; text-transform: uppercase; }
  .b2b-answers strong { display: block; color: var(--b2b-ink); font-size: .93rem; line-height: 1.4; }

  .b2b-split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, .7fr); gap: clamp(40px, 7vw, 84px); align-items: start; }
  .b2b-note { display: flex; gap: 16px; border: 1px solid #bcd7ec; border-radius: 16px; padding: 22px; background: #eef7ff; }
  .b2b-note > svg { width: 24px; height: 24px; flex: 0 0 auto; color: var(--b2b-blue); }
  .b2b-note strong { color: var(--b2b-ink); font-size: 1.05rem; line-height: 1.4; }
  .b2b-note p { margin: 7px 0 0; font-size: .92rem; }

  .b2b-card-grid { display: grid; gap: 18px; }
  .b2b-card-grid--three { grid-template-columns: repeat(3, 1fr); }
  .b2b-card { border: 1px solid var(--b2b-line); border-radius: 16px; padding: 24px; background: #fff; box-shadow: 0 10px 28px rgba(15,35,55,.045); }
  .b2b-icon { display: grid; width: 42px; height: 42px; place-items: center; margin-bottom: 18px; border-radius: 11px; background: #e9f4fe; color: var(--b2b-blue); }
  .b2b-icon svg { width: 19px; height: 19px; }
  .b2b-card h3,
  .b2b-includes h3,
  .b2b-priority-grid h3,
  .b2b-device-grid h3,
  .b2b-sector-grid h3,
  .b2b-compare h3,
  .b2b-process h3 { margin: 0 0 8px; color: var(--b2b-ink); font-family: var(--font-heading); font-size: 1.08rem; line-height: 1.3; }
  .b2b-card p,
  .b2b-includes p,
  .b2b-priority-grid p,
  .b2b-device-grid p,
  .b2b-sector-grid p,
  .b2b-process p { margin: 0; font-size: .91rem; line-height: 1.62; }

  .b2b-includes { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .b2b-includes article { display: grid; grid-template-columns: 34px 24px minmax(0,1fr); gap: 12px; align-items: start; border: 1px solid var(--b2b-line); border-radius: 13px; padding: 18px; background: #fff; }
  .b2b-includes article > span { color: #8a9bad; font-size: .72rem; font-weight: 850; }
  .b2b-includes article > svg { width: 20px; height: 20px; color: var(--b2b-blue); }
  .b2b-disclaimer { margin: 22px 0 0; border-left: 4px solid var(--b2b-blue); padding: 14px 18px; background: var(--b2b-soft); font-size: .92rem !important; }

  .b2b-section--dark { background: #071f3a; }
  .b2b-section--dark .b2b-label { color: #7dd3fc; }
  .b2b-section--dark h2,
  .b2b-section--dark p { color: #fff !important; }
  .b2b-dark-intro { display: grid; grid-template-columns: minmax(0, .9fr) minmax(320px, .7fr); gap: 60px; align-items: end; }
  .b2b-dark-intro p { margin: 0 0 8px; color: rgba(255,255,255,.76) !important; }
  .b2b-flow { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin: 40px 0 0; padding: 0; list-style: none; }
  .b2b-flow li { position: relative; min-height: 150px; border: 1px solid rgba(255,255,255,.13); border-radius: 14px; padding: 20px; background: rgba(255,255,255,.05); }
  .b2b-flow span { display: block; margin-bottom: 25px; color: #7dd3fc; font-size: .72rem; font-weight: 900; }
  .b2b-flow strong { display: block; color: #fff; font-size: 1rem; }
  .b2b-flow small { display: block; margin-top: 5px; color: rgba(255,255,255,.62); }
  .b2b-dark-cta { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 28px; border-top: 1px solid rgba(255,255,255,.12); padding-top: 25px; }
  .b2b-dark-cta p { margin: 0; font-weight: 750; }
  .b2b-dark-cta a { display: inline-flex; align-items: center; gap: 8px; border-radius: 9px; padding: 12px 18px; background: #20a45a; color: #fff; font-weight: 850; text-decoration: none; }
  .b2b-dark-cta svg { width: 17px; height: 17px; }

  .b2b-priority-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .b2b-priority-grid article { display: flex; gap: 13px; border-top: 1px solid var(--b2b-line); padding: 18px 4px 4px; }
  .b2b-priority-grid article > span { width: 8px; height: 8px; flex: 0 0 auto; margin-top: 8px; border-radius: 50%; background: var(--b2b-blue); box-shadow: 0 0 0 5px #e7f3fe; }

  .b2b-device-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .b2b-device-grid article { border: 1px solid var(--b2b-line); border-radius: 16px; padding: 25px; background: #fff; }
  .b2b-device-grid article > svg { width: 28px; height: 28px; margin-bottom: 20px; color: var(--b2b-blue); }
  .b2b-inline-link { margin: 24px 0 0; text-align: center; }
  .b2b-inline-link a { color: var(--b2b-blue-dark); font-weight: 800; }

  .b2b-sector-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .b2b-sector-grid article { border: 1px solid var(--b2b-line); border-radius: 14px; padding: 22px; }
  .b2b-sector-grid svg { width: 22px; height: 22px; margin-bottom: 15px; color: var(--b2b-blue); }

  .b2b-compare { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .b2b-compare article { border: 1px solid var(--b2b-line); border-radius: 18px; padding: clamp(24px, 4vw, 36px); background: #fff; }
  .b2b-compare__featured { border-color: #8fc5ef !important; box-shadow: inset 0 4px 0 var(--b2b-blue); }
  .b2b-compare article > span { color: var(--b2b-blue); font-size: .72rem; font-weight: 850; text-transform: uppercase; }
  .b2b-compare h3 { margin-top: 10px; font-size: 1.45rem; }
  .b2b-compare ul { display: grid; gap: 8px; margin: 20px 0; padding-left: 20px; color: var(--b2b-muted); }
  .b2b-compare a { display: inline-flex; align-items: center; gap: 8px; color: var(--b2b-blue-dark); font-weight: 850; text-decoration: none; }
  .b2b-compare a svg { width: 14px; height: 14px; }

  .b2b-process { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin: 0; padding: 0; list-style: none; }
  .b2b-process li { min-height: 190px; border: 1px solid var(--b2b-line); border-radius: 15px; padding: 22px; }
  .b2b-process li > span { display: inline-flex; margin-bottom: 28px; color: var(--b2b-blue); font-size: .76rem; font-weight: 900; }

  .b2b-section--report { background: linear-gradient(120deg, #eef7ff, #f8fbfe); }
  .b2b-report-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, .72fr); gap: clamp(40px, 7vw, 90px); align-items: center; }
  .b2b-report-list { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .b2b-report-list li { display: flex; gap: 14px; border: 1px solid #cfe0ee; border-radius: 13px; padding: 16px; background: rgba(255,255,255,.78); }
  .b2b-report-list svg { width: 20px; height: 20px; flex: 0 0 auto; color: var(--b2b-blue); }
  .b2b-report-list span { color: var(--b2b-muted); font-size: .9rem; line-height: 1.5; }
  .b2b-report-list strong { color: var(--b2b-ink); }

  .b2b-two-topics { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(40px, 7vw, 90px); }
  .b2b-two-topics article + article { border-left: 1px solid var(--b2b-line); padding-left: clamp(40px, 7vw, 90px); }

  .b2b-section--form { padding-bottom: 0; background: var(--b2b-soft); }
  .b2b-form-intro { max-width: 820px; text-align: center; }
  .b2b-section--form :global(.service-ticket-section) { padding-top: 34px !important; }

  .b2b-final { padding: clamp(55px, 7vw, 84px) 0; background: #071f3a; }
  .b2b-final__grid { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 40px; align-items: center; }
  .b2b-final span { color: #7dd3fc; font-size: .75rem; font-weight: 850; text-transform: uppercase; }
  .b2b-final h2 { color: #fff !important; }
  .b2b-final p { max-width: 760px; margin: 0; color: rgba(255,255,255,.72) !important; line-height: 1.65; }
  .b2b-final__actions { display: grid; gap: 10px; min-width: 280px; }
  .b2b-final__actions a { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; gap: 8px; border: 1px solid rgba(255,255,255,.25); border-radius: 9px; padding: 11px 18px; color: #fff; font-weight: 850; text-align: center; text-decoration: none; }
  .b2b-final__actions a:first-child { border-color: #20a45a; background: #20a45a; }
  .b2b-final__actions svg { width: 18px; height: 18px; }

  .b2b-maintenance a:focus-visible { outline: 3px solid #f59e0b; outline-offset: 4px; }

  @media (max-width: 980px) {
    .b2b-hero__grid,
    .b2b-split,
    .b2b-report-grid { grid-template-columns: 1fr; }
    .b2b-hero__media { max-width: 620px; }
    .b2b-hero__media figcaption { right: 18px; }
    .b2b-card-grid--three,
    .b2b-device-grid,
    .b2b-sector-grid { grid-template-columns: repeat(2, 1fr); }
    .b2b-priority-grid,
    .b2b-process { grid-template-columns: repeat(2, 1fr); }
    .b2b-flow { grid-template-columns: repeat(5, minmax(170px, 1fr)); overflow-x: auto; padding-bottom: 12px; scroll-snap-type: x proximity; }
    .b2b-flow li { scroll-snap-align: start; }
    .b2b-dark-intro { grid-template-columns: 1fr; gap: 14px; }
    .b2b-final__grid { grid-template-columns: 1fr; }
    .b2b-final__actions { width: min(100%, 420px); }
  }

  @media (max-width: 720px) {
    .b2b-shell { width: min(100% - 28px, 1180px); }
    .b2b-section { padding: 58px 0; }
    .b2b-hero { padding: 48px 0 58px; }
    .b2b-hero__grid { gap: 34px; }
    .b2b-hero h1 { font-size: clamp(2.12rem, 11vw, 3.2rem); }
