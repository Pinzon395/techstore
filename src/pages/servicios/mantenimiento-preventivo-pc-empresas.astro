---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import TicketFormSection from '../../components/TicketFormSection.astro';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/LocalSpriteIcon.astro';
import { buildBreadcrumbSchema, buildFAQSchema, buildServiceSchema } from '../../lib/schema';

const canonical = 'https://pixon.com.mx/servicios/mantenimiento-preventivo-pc-empresas';
const title = 'Mantenimiento de Computadoras para Empresas en Cancún | Pixon PC';
const description = 'Mantenimiento preventivo de computadoras para empresas en Cancún: PCs y laptops por lote, calendarización, reporte técnico y atención según prioridad operativa.';
const heroImage = '/assets/images/mantenimiento-pc-escritorio.webp';
const whatsappMessage = 'Hola Pixon. Quiero cotizar mantenimiento preventivo para las computadoras de mi empresa. Tenemos aproximadamente ____ equipos y estamos ubicados en ____.';
const whatsappUrl = `https://wa.me/529986690777?text=${encodeURIComponent(whatsappMessage)}`;

const coverageGroups = [
  {
    icon: 'building',
    title: 'Oficinas, PyMEs y despachos',
    text: 'Atención coordinada para equipos de trabajo en Cancún Centro, Av. Tulum, Bonampak, Puerto Cancún, Cumbres y Huayacán.',
  },
  {
    icon: 'hotel',
    title: 'Hoteles, hospedaje y comercio',
    text: 'Planeamos bloques para recepción, reservaciones, cajas y administración en Zona Hotelera, Puerto Juárez, Costa Mujeres, Playa Mujeres y corredores comerciales.',
  },
  {
    icon: 'location-dot',
    title: 'Operación en otras zonas de Cancún',
    text: 'También coordinamos según agenda en Bonfil, Polígono Sur, Supermanzanas y Haciendas; confirmamos la modalidad antes de programar.',
  },
];

const warningSigns = [
  {
    icon: 'gauge-high',
    title: 'Equipos lentos durante la jornada',
    text: 'Una computadora lenta no siempre necesita limpieza. Revisamos síntomas, programas de inicio, almacenamiento disponible y condición del disco para distinguir mantenimiento de una posible reparación o actualización.',
  },
  {
    icon: 'fan',
    title: 'Ventiladores con ruido constante',
    text: 'El ruido puede relacionarse con polvo, flujo de aire limitado, desgaste del ventilador o carga de trabajo elevada. La inspección permite identificar la causa antes de autorizar una intervención.',
  },
  {
    icon: 'temperature-high',
    title: 'Temperaturas elevadas',
    text: 'Gabinetes bajo escritorios, rejillas obstruidas y ambientes cálidos pueden dificultar la ventilación. También existen otras causas, por lo que primero se revisa la condición real del equipo.',
  },
  {
    icon: 'power-off',
    title: 'Apagados o reinicios inesperados',
    text: 'Un apagado puede tener origen térmico, eléctrico, de memoria, almacenamiento o sistema operativo. El mantenimiento ayuda a revisar señales visibles, pero no sustituye un diagnóstico cuando la falla ya existe.',
  },
  {
    icon: 'hard-drive',
    title: 'Almacenamiento con alertas',
    text: 'Tiempos de arranque largos, errores al abrir archivos o bloqueos pueden justificar una revisión del SSD o HDD. Cualquier cambio de pieza o respaldo se cotiza y autoriza por separado.',
  },
  {
    icon: 'calendar-days',
    title: 'Mucho tiempo sin revisión',
    text: 'Cuando varios equipos operan durante jornadas largas sin historial de mantenimiento, conviene levantar inventario y revisar primero las áreas críticas para definir prioridades reales.',
  },
];

const includedItems = [
  ['clipboard-check', 'Inventario inicial', 'Identificación del equipo, área y responsable cuando la empresa lo requiere.'],
  ['magnifying-glass', 'Inspección física', 'Revisión exterior, conexiones, rejillas, filtros y señales visibles antes de abrir.'],
  ['broom', 'Limpieza interna', 'Retiro de polvo en las zonas accesibles cuando el diseño y la condición lo permiten.'],
  ['fan', 'Ventiladores y disipación', 'Revisión de ventiladores, disipadores, radiadores y circulación de aire.'],
  ['temperature-high', 'Condición térmica', 'Comprobación de síntomas y temperaturas según el tipo de hardware y carga.'],
  ['microchip', 'Pasta térmica', 'Se revisa y se reemplaza únicamente cuando la condición del equipo lo justifica.'],
  ['hard-drive', 'SSD o HDD', 'Consulta de indicadores básicos de salud cuando existe sospecha de almacenamiento.'],
  ['memory', 'Memoria RAM', 'Pruebas cuando hay congelamientos, errores o síntomas relacionados.'],
  ['windows', 'Revisión básica de Windows', 'Programas de inicio, espacio disponible y actualizaciones autorizadas.'],
  ['check-double', 'Comprobación posterior', 'Encendido, ventilación y funcionamiento general después del ensamble.'],
  ['file-lines', 'Registro de hallazgos', 'Observaciones por equipo para que el responsable conozca qué se encontró.'],
  ['list-check', 'Recomendaciones', 'Acciones sugeridas separadas del mantenimiento y sujetas a autorización.'],
];

const criticalAreas = [
  ['Recepción', 'Equipos usados para atención, registro y comunicación con clientes.'],
  ['Facturación', 'Computadoras que concentran documentos y tareas administrativas.'],
  ['Ventas y cajas', 'PCs vinculadas a cobro, consulta de productos o atención.'],
  ['Contabilidad', 'Equipos de trabajo con información y procesos sensibles.'],
  ['Reservaciones', 'Estaciones utilizadas durante jornadas amplias en operación.'],
  ['Diseño y workstations', 'Equipos con cargas sostenidas de CPU, GPU o almacenamiento.'],
  ['Administración', 'Computadoras compartidas por personal operativo o gerencial.'],
  ['Gerencia', 'Equipos cuya indisponibilidad complica decisiones y seguimiento.'],
];

const sectors = [
  ['building', 'PyMEs y oficinas', 'Equipos administrativos, recepción, ventas, contabilidad y estaciones compartidas.'],
  ['hotel', 'Hoteles y hospedaje', 'Computadoras de recepción, reservaciones y administración, organizadas según prioridad.'],
  ['utensils', 'Restaurantes y comercios', 'Equipos de oficina, cajas y facturación, sin asumir soporte de software específico.'],
  ['briefcase', 'Agencias y despachos', 'PCs, laptops y estaciones de trabajo utilizadas durante jornadas completas.'],
  ['stethoscope', 'Consultorios y servicios', 'Mantenimiento programado de equipos administrativos y de atención.'],
  ['graduation-cap', 'Escuelas y capacitación', 'Computadoras de administración, docentes y áreas de trabajo compartido.'],
];

const processSteps = [
  ['01', 'Levantamiento', 'Conocemos cantidad aproximada, tipos de equipo, ubicación y necesidades de la empresa.'],
  ['02', 'Inventario', 'Identificamos los equipos incluidos y el área a la que pertenecen.'],
  ['03', 'Priorización', 'Separamos equipos críticos de los que pueden atenderse con mayor flexibilidad.'],
  ['04', 'Calendarización', 'Acordamos bloques de trabajo según disponibilidad y operación del negocio.'],
  ['05', 'Mantenimiento', 'Realizamos únicamente el alcance previamente autorizado para cada grupo.'],
  ['06', 'Pruebas', 'Comprobamos encendido, ventilación y funcionamiento general antes de cerrar.'],
  ['07', 'Reporte', 'Registramos trabajos, hallazgos y observaciones relevantes por equipo.'],
  ['08', 'Recomendaciones', 'Separamos mantenimiento realizado de reparaciones o mejoras que requieran autorización.'],
];

const faqs = [
  {
    question: '¿Qué incluye el mantenimiento preventivo para empresas?',
    answer: 'El alcance se define según los equipos y su condición. Puede incluir inventario, inspección física, limpieza interna, revisión de ventiladores y disipación, comprobaciones térmicas, estado básico del almacenamiento, pruebas posteriores y un registro de hallazgos. Cualquier reparación o refacción se cotiza por separado.',
  },
  {
    question: '¿Atienden varias computadoras en una misma empresa?',
    answer: 'Sí. La página está enfocada en oficinas y negocios con varios equipos. Primero confirmamos cantidad, tipos de computadora, áreas críticas y disponibilidad para proponer una atención por grupos.',
  },
  {
    question: '¿Pueden realizar mantenimiento por lotes?',
    answer: 'Sí. Podemos organizar los equipos por área, prioridad o bloque de trabajo. El tamaño de cada lote y el calendario se acuerdan después de conocer el volumen y las condiciones de la empresa.',
  },
  {
    question: '¿Dan mantenimiento a PCs y laptops?',
    answer: 'Sí. Atendemos PCs de escritorio y laptops empresariales. El procedimiento cambia según marca, modelo, diseño interno y facilidad de acceso, por lo que no todos los equipos reciben exactamente las mismas tareas.',
  },
  {
    question: '¿Cómo evitan detener toda la oficina?',
    answer: 'Priorizamos los equipos que la operación necesita y planteamos bloques escalonados. No prometemos cero interrupciones, pero la calendarización permite reducir el impacto frente a retirar todos los equipos al mismo tiempo.',
  },
  {
    question: '¿Pueden trabajar con equipos de diferentes marcas?',
    answer: 'Sí, sujeto a la revisión de cada modelo. Una misma empresa puede tener computadoras de distintas marcas y generaciones; por eso el inventario y el alcance se confirman antes de intervenir.',
  },
  {
    question: '¿El mantenimiento borra archivos?',
    answer: 'La limpieza física no tiene como objetivo modificar archivos. Si se requiere trabajar sobre Windows, almacenamiento o respaldos, primero se explica el alcance y se solicita autorización. Recomendamos contar con respaldo vigente de la información importante.',
  },
  {
    question: '¿Incluye cambio de pasta térmica?',
    answer: 'No en todos los equipos. Se revisa según antigüedad, condición, diseño y comportamiento térmico. Si conviene reemplazarla, se informa antes de realizarlo y se considera dentro del alcance autorizado.',
  },
  {
    question: '¿Cada cuánto debe hacerse mantenimiento preventivo?',
    answer: 'No existe un intervalo universal. Depende de horas de uso, polvo, temperatura, ubicación, ventilación, tipo de gabinete y criticidad del equipo. Con el inventario y los hallazgos puede proponerse una revisión acorde con la operación real.',
  },
  {
    question: '¿Pueden revisar equipos que trabajan todo el día?',
    answer: 'Sí. Es importante identificar esos equipos desde el levantamiento para acordar una ventana de atención y revisar su carga, ventilación y condición sin asumir que todas las fallas se deben a temperatura.',
  },
  {
    question: '¿Atienden hoteles y restaurantes en Cancún?',
    answer: 'Sí. Podemos cotizar mantenimiento de sus computadoras administrativas, de recepción o trabajo. El soporte de redes, impresoras, sistemas especializados o pólizas continuas se revisa como un alcance diferente.',
  },
  {
    question: '¿Atienden pequeñas empresas?',
    answer: 'Sí. La cotización se adapta al número y tipo de equipos; no es necesario tener una flotilla grande para solicitar una revisión empresarial.',
  },
  {
    question: '¿Cómo se cotiza un mantenimiento por volumen?',
    answer: 'Necesitamos cantidad aproximada, tipos de equipo, ubicación, síntomas, áreas críticas y horario disponible. Con esos datos definimos si conviene una visita inicial, recepción por lote o una revisión programada. No publicamos un precio único porque el alcance cambia entre empresas.',
  },
  {
    question: '¿Pueden llevar un registro por computadora?',
    answer: 'Podemos documentar equipo, área, marca, modelo, estado observado, mantenimiento realizado y recomendaciones cuando el alcance acordado lo incluye. El nivel de detalle se confirma en la cotización.',
  },
  {
    question: '¿También ofrecen soporte TI continuo?',
    answer: 'Sí, pero es un servicio diferente. Para incidencias recurrentes, usuarios, redes, WiFi, soporte remoto o pólizas mensuales consulta la página de soluciones para empresas.',
  },
  {
    question: '¿Dan servicio en las instalaciones de la empresa?',
    answer: 'Podemos coordinar visita, recepción o recolección por lote en Cancún según cantidad de equipos, tipo de trabajo, zona y disponibilidad. Primero confirmamos qué actividades pueden realizarse de forma segura en sitio.',
  },
  {
    question: '¿Qué zonas de Cancún atienden para mantenimiento empresarial?',
    answer: 'Coordinamos mantenimiento de computadoras para empresas en Cancún Centro, Zona Hotelera, Huayacán, Cumbres, Bonfil, Polígono Sur, Puerto Cancún, Av. Tulum, Bonampak, Puerto Juárez, Supermanzanas y Haciendas. La visita, recepción o recolección se confirma según el lote, tipo de trabajo y disponibilidad.',
  },
];

const schema = [
  buildServiceSchema({
    service: {
      label: 'Mantenimiento preventivo de computadoras para empresas en Cancún',
      seoKeyword: 'Mantenimiento preventivo de computadoras para empresas en Cancún',
      intro: description,
      heroImage,
    },
    category: { title: 'Servicios para empresas', slug: 'empresas' },
    url: canonical,
    description,
    image: heroImage,
  }),
  buildBreadcrumbSchema([
    { label: 'Inicio', href: '/' },
    { label: 'Empresas', href: '/empresas' },
    { label: 'Mantenimiento preventivo', href: canonical },
  ]),
  buildFAQSchema(faqs),
].filter(Boolean) as object[];
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  image={heroImage}
  ogTitle="Mantenimiento de Computadoras para Empresas en Cancún | Pixon PC"
  ogDescription="PCs y laptops empresariales por lote en Cancún: inventario, calendarización, mantenimiento preventivo y reporte técnico."
  robots="index, follow"
  schema={schema}
  bodyClass="service-page b2b-maintenance-page"
  preloadSprite={true}
>
  <Navbar />

  <Breadcrumb items={[
    { label: 'Inicio', href: '/' },
    { label: 'Empresas', href: '/empresas' },
    { label: 'Mantenimiento preventivo' },
  ]} />

  <main class="b2b-maintenance">
    <section class="b2b-hero" aria-labelledby="b2b-title">
      <div class="b2b-shell b2b-hero__grid">

        <div class="b2b-hero__above">
          <span class="b2b-eyebrow">Mantenimiento TI para empresas en Cancún</span>
          <h1 id="b2b-title">Mantenimiento preventivo de computadoras para empresas en Cancún</h1>
        </div>

        <figure class="b2b-hero__media">
          <div class="b2b-cleaning-scene" role="img" aria-label="Animación técnica del mantenimiento preventivo: eliminación de polvo con flujo de aire de precisión y acabado limpio profesional.">
            <div class="b2b-cleaning-scene__status" aria-hidden="true">
              <span class="b2b-cleaning-scene__status-dirty">Antes: polvo acumulado</span>
              <span class="b2b-cleaning-scene__status-inspecting">Limpieza con aire</span>
              <span class="b2b-cleaning-scene__status-clean">Después: equipo listo</span>
            </div>
            <svg class="b2b-cleaning-scene__art" viewBox="0 0 600 560" fill="none" aria-hidden="true" focusable="false">
              <defs>
                <!-- Background / Desk gradients -->
                <linearGradient id="pc-desk" x1="60" y1="440" x2="540" y2="510" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#112D47" />
                  <stop offset=".5" stop-color="#1B4567" />
                  <stop offset="1" stop-color="#0E2942" />
                </linearGradient>

                <!-- Monitor Chassis & Screen Gradients -->
                <linearGradient id="pc-chassis" x1="140" y1="130" x2="460" y2="390" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#2A4866" />
                  <stop offset=".45" stop-color="#18314A" />
                  <stop offset="1" stop-color="#0A1C30" />
                </linearGradient>

                <linearGradient id="pc-bezel-inner" x1="156" y1="146" x2="444" y2="364" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#0B1C2E" />
                  <stop offset="1" stop-color="#05101C" />
                </linearGradient>

                <linearGradient id="pc-screen-bg" x1="160" y1="150" x2="440" y2="360" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#0E2F52" />
                  <stop offset=".5" stop-color="#092038" />
                  <stop offset="1" stop-color="#051426" />
                </linearGradient>

                <linearGradient id="pc-screen-glow" x1="160" y1="150" x2="440" y2="360" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#178CE0" stop-opacity=".25" />
                  <stop offset=".6" stop-color="#0B5296" stop-opacity=".1" />
                  <stop offset="1" stop-color="#083867" stop-opacity="0" />
                </linearGradient>

                <!-- Dust layer matte gradient -->
                <linearGradient id="dust-haze-grad" x1="140" y1="130" x2="460" y2="390" gradientUnits="userSpaceOnUse">
                  <stop stop-color="rgba(196, 172, 138, 0.5)" />
                  <stop offset=".5" stop-color="rgba(168, 146, 116, 0.42)" />
                  <stop offset="1" stop-color="rgba(140, 120, 92, 0.48)" />
                </linearGradient>

                <!-- Air stream aerodynamic gradients -->
                <linearGradient id="air-jet-main" x1="580" y1="200" x2="60" y2="240" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#EBF8FF" stop-opacity=".95" />
                  <stop offset=".3" stop-color="#7DD3FC" stop-opacity=".85" />
                  <stop offset=".7" stop-color="#38BDF8" stop-opacity=".4" />
                  <stop offset="1" stop-color="#0284C7" stop-opacity="0" />
                </linearGradient>

                <linearGradient id="air-jet-secondary" x1="560" y1="160" x2="80" y2="320" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#FFFFFF" stop-opacity=".9" />
                  <stop offset=".4" stop-color="#BAE6FD" stop-opacity=".7" />
                  <stop offset=".8" stop-color="#38BDF8" stop-opacity=".25" />
                  <stop offset="1" stop-color="#38BDF8" stop-opacity="0" />
                </linearGradient>

                <!-- Specular light sweep gradient -->
                <linearGradient id="light-sweep-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="rgba(255,255,255,0)" />
                  <stop offset="35%" stop-color="rgba(255,255,255,0.03)" />
                  <stop offset="48%" stop-color="rgba(255,255,255,0.85)" />
                  <stop offset="52%" stop-color="rgba(224,242,254,0.95)" />
                  <stop offset="65%" stop-color="rgba(255,255,255,0.05)" />
                  <stop offset="100%" stop-color="rgba(255,255,255,0)" />
                </linearGradient>

                <!-- Filters -->
                <filter id="pc-shadow" x="80" y="110" width="440" height="420" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
                  <feDropShadow dx="0" dy="24" stdDeviation="20" flood-color="#020912" flood-opacity=".55" />
                </filter>

                <filter id="neon-glow" x="120" y="110" width="360" height="300" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
                  <feGaussianBlur stdDeviation="6" result="blur" />
                  <feMerge>
                    <feMergeNode in="blur" />
                    <feMergeNode in="SourceGraphic" />
                  </feMerge>
                </filter>

                <filter id="sparkle-flare" x="-30" y="-30" width="60" height="60" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
                  <feGaussianBlur stdDeviation="3" result="blur" />
                  <feMerge>
                    <feMergeNode in="blur" />
                    <feMergeNode in="SourceGraphic" />
                  </feMerge>
                </filter>

                <!-- Clip paths -->
                <clipPath id="monitor-clip">
                  <rect x="145" y="140" width="310" height="248" rx="18" />
                </clipPath>
                <clipPath id="screen-clip">
                  <rect x="160" y="152" width="280" height="206" rx="10" />
                </clipPath>
              </defs>

              <!-- 1. BASE / DESK & STAND -->
              <g class="b2b-scene__desk" filter="url(#pc-shadow)">
                <path d="M70 452h460c22 0 40 18 40 40v14H30v-14c0-22 18-40 40-40Z" fill="url(#pc-desk)" />
                <path d="M50 505h500" stroke="#335A7E" stroke-width="2" opacity=".6" />

                <!-- Monitor Stand Neck & Base -->
                <path d="M262 388h76l12 50H250l12-50Z" fill="#1C3852" stroke="#486D8F" stroke-width="2" />
                <path d="M205 438h190c10 0 18 7 18 16H187c0-9 8-16 18-16Z" fill="#132B40" stroke="#486D8F" stroke-width="2" />
                <rect x="250" y="445" width="100" height="3" rx="1.5" fill="#5E8BB3" opacity=".7" />
              </g>

              <!-- 2. MONITOR CHASSIS & SCREEN -->
              <g class="b2b-scene__monitor" filter="url(#pc-shadow)">
                <!-- Outer Chassis Frame -->
                <rect x="145" y="140" width="310" height="248" rx="18" fill="url(#pc-chassis)" stroke="#4A7094" stroke-width="2.5" />
                
                <!-- Inner Bezel -->
                <rect x="156" y="148" width="288" height="214" rx="12" fill="url(#pc-bezel-inner)" />
                
                <!-- Screen Glass Surface -->
                <rect x="160" y="152" width="280" height="206" rx="10" fill="url(#pc-screen-bg)" />
                <rect x="160" y="152" width="280" height="206" rx="10" fill="url(#pc-screen-glow)" />

                <!-- Clean Enterprise UI (Telemetry & Metrics) -->
                <g class="b2b-scene__screen-ui" clip-path="url(#screen-clip)">
                  <!-- UI Grid -->
                  <path d="M160 196h280M160 240h280M160 284h280M160 328h280" stroke="#1E476F" stroke-width="1" opacity=".35" />
                  <path d="M220 152v206M280 152v206M340 152v206M400 152v206" stroke="#1E476F" stroke-width="1" opacity=".35" />

                  <!-- Status Widgets -->
                  <rect x="174" y="166" width="74" height="40" rx="6" fill="#0C2947" stroke="#255986" stroke-width="1" />
                  <text x="182" y="180" fill="#7DD3FC" font-size="8" font-weight="700" font-family="system-ui, sans-serif">CPU 100%</text>
                  <path d="M182 194h58" stroke="#0284C7" stroke-width="3" stroke-linecap="round" />
                  <path d="M182 194h46" stroke="#38BDF8" stroke-width="3" stroke-linecap="round" />

                  <rect x="263" y="166" width="74" height="40" rx="6" fill="#0C2947" stroke="#255986" stroke-width="1" />
                  <text x="271" y="180" fill="#7DD3FC" font-size="8" font-weight="700" font-family="system-ui, sans-serif">TEMP 32°C</text>
                  <path d="M271 194h58" stroke="#0284C7" stroke-width="3" stroke-linecap="round" />
                  <path d="M271 194h38" stroke="#10B981" stroke-width="3" stroke-linecap="round" />

                  <rect x="352" y="166" width="74" height="40" rx="6" fill="#0C2947" stroke="#255986" stroke-width="1" />
                  <text x="360" y="180" fill="#7DD3FC" font-size="8" font-weight="700" font-family="system-ui, sans-serif">VENTILACIÓN</text>
                  <path d="M360 194h58" stroke="#0284C7" stroke-width="3" stroke-linecap="round" />
                  <path d="M360 194h50" stroke="#38BDF8" stroke-width="3" stroke-linecap="round" />

                  <!-- Telemetry waveform chart -->
                  <path d="M174 310 Q215 285 250 295 T330 260 T400 245 T426 250" fill="none" stroke="#38BDF8" stroke-width="2.5" stroke-linecap="round" />
                  <path d="M174 310 Q215 285 250 295 T330 260 T400 245 T426 250 L426 340 L174 340 Z" fill="url(#pc-screen-glow)" opacity=".4" />
                  <circle cx="426" cy="250" r="3.5" fill="#38BDF8" />
                </g>

                <!-- Bezel Hardware Accents (Power LED, brand mark) -->
                <circle cx="300" cy="374" r="3" fill="#38BDF8" />
                <circle cx="300" cy="374" r="6" fill="#38BDF8" opacity=".3" />
                <rect x="180" y="372" width="16" height="3" rx="1.5" fill="#3B6385" />
                <rect x="404" y="372" width="16" height="3" rx="1.5" fill="#3B6385" />
              </g>

              <!-- 3. DIRTY STAGE: DUST HAZE & PARTICULATE ACCUMULATION -->
              <g class="b2b-scene__dust-layer">
                <rect x="145" y="140" width="310" height="248" rx="18" fill="url(#dust-haze-grad)" />
                
                <g class="b2b-scene__static-dust" fill="#D6C4A5">
