</Base>

<style>
  .b2b-maintenance {
    --b2b-ink: #071f3a;
    --b2b-muted: #071f3a;
    --b2b-blue: #1479d4;
    --b2b-blue-dark: #0c4f8b;
    --b2b-soft: #f3f7fb;
