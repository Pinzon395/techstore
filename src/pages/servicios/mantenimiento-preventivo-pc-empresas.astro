---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ServiceTicketSection from '../../components/ServiceTicketSection.astro';
import ContactSection from '../../components/ContactSection.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/LocalSpriteIcon.astro';

const canonical = '/servicios/mantenimiento-preventivo-pc-empresas/';
const waText = encodeURIComponent('Hola, quiero cotizar mantenimiento preventivo y limpieza de computadoras para mi empresa en Cancún. Mis equipos están lentos y se calientan.');

const problems = [
  ['gauge-high', 'Computadora lenta, lag y congelamiento constante', 'Diagnosticamos por qué tu PC de oficina se traba o tarda en responder. Optimizamos Windows, memoria RAM, SSD y eliminamos procesos que ralentizan tu flujo de trabajo diario.'],
  ['temperature-high', 'Sobrecalentamiento extremo y ventilador ruidoso', 'El polvo acumulado obstruye el flujo de aire interno. Limpiamos disipadores y ventiladores antes de que la laptop se caliente en exceso y sufra daños graves de hardware.'],
  ['power-off', 'Apagones inesperados y reinicios repentinos', 'Cuando el procesador supera su temperatura segura por pasta térmica seca o ventilador bloqueado, el equipo se apaga solo para evitar quemar la tarjeta madre.'],
  ['circle-exclamation', 'Pantallas azules de la muerte (BSOD) recurrentes', 'Analizamos el origen de los fallos de pantalla azul: desde controladores de Windows corruptos, sobrecalentamiento, hasta módulos de RAM y discos duros con fallas físicas.'],
  ['glass-water', 'Derrame de líquidos en laptop (refresco, café o agua)', 'Si a un colaborador se le cayó líquido en su laptop de trabajo, realizamos un desarmado rápido, limpieza ultrasónica de placa base y baño químico contra la corrosión húmeda.'],
  ['shield-halved', 'PC sucia con polvo costero, pelusa y corrosión', 'El aire salino de Cancún magnetiza el polvo, creando una capa conductora que oxida pines, circuitos y fuentes de poder. La limpieza física profunda elimina este riesgo.'],
];

const plans = [
  ['Limpieza Física', 'PCs con alta carga de polvo', 'Desarmado, soplado de ventilador, limpieza del disipador de cobre y cambio de pasta térmica premium.', 'Cada 6 a 12 meses'],
  ['Optimización de Software', 'Laptops lentas o que se traban', 'Eliminación de virus, malware, software basura, actualización de drivers, parches de Windows y limpieza de inicio.', 'Cada 6 meses'],
  ['Mantenimiento Completo', 'Flotillas y equipos corporativos', 'Combinación de limpieza física interna profunda, cambio de pasta térmica, optimización lógica de Windows y reporte de salud.', 'Cada 6 a 8 meses'],
  ['Póliza de Soporte TI', 'Oficinas, hoteles y PyMEs', 'Mesa de ayuda presencial y remota, visitas programadas preventivas por lote y prioridad ante fallas críticas y redes.', 'Iguala mensual'],
];

const process = [
  ['01', 'Levantamiento y Diagnóstico', 'Evaluamos el estado físico de los equipos, registramos marcas (HP, Dell, Lenovo, Asus), síntomas y horarios disponibles para no detener tu oficina.'],
  ['02', 'Priorización Operativa', 'Damos mantenimiento primero a los equipos críticos: computadoras de ventas, cajas de cobro, servidores locales y facturación electrónica CFDI.'],
  ['03', 'Limpieza Física Profunda', 'Abrimos los equipos con herramientas antiestáticas, retiramos polvo pegajoso, pelusa, limpiamos ventiladores y disipadores de cobre.'],
  ['04', 'Cambio de Pasta Térmica', 'Eliminamos el compuesto térmico viejo y seco del procesador y GPU, aplicando pasta térmica nueva de alta conductividad para evitar sobrecalentamientos.'],
  ['05', 'Optimización de Sistema', 'Revisamos velocidad de Windows, consumo de RAM, estado del SSD/HDD, eliminamos adware, virus de navegadores y configuramos respaldos automáticos.'],
  ['06', 'Reporte Técnico por Lote', 'Entregamos un informe claro con la condición de cada computadora de tu flotilla, trabajos realizados, riesgos detectados y recomendaciones.'],
];

const related = [
  ['/servicios/pc/virus-malware', 'shield-halved', 'Eliminación de malware y virus', 'Análisis de navegadores, adware y desinfección de archivos de trabajo.'],
  ['/servicios/pc/limpieza-profunda', 'fan', 'Limpieza interna de hardware', 'Servicio de remoción de polvo, mantenimiento de ventiladores y cambio de pasta térmica.'],
  ['/servicios/pc/recuperacion-datos', 'database', 'Respaldo y recuperación de datos', 'Protección de archivos, bases de datos y migración segura ante cambio de disco duro.'],
  ['/servicios/redes/impresora-red', 'print', 'Instalación de impresoras en red', 'Configuración de colas de impresión y recursos compartidos de oficina en Cancún.'],
  ['/servicios/b2b/wifi-empresarial', 'wifi', 'Redes y WiFi empresarial', 'Optimización de cobertura, routers, access points y cableado estructurado.'],
  ['/servicios/pc/upgrade', 'microchip', 'Ampliación de memoria RAM y SSD', 'Solución de lentitud y upgrades justificados para que tu laptop no se trabe.'],
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Mantenimiento preventivo de computadoras para empresas en Cancún', serviceType: 'Mantenimiento preventivo y soporte informático empresarial', url: `https://pixon.com.mx${canonical}`, description: 'Mantenimiento preventivo de computadoras en Cancún: limpieza interna, cambio de pasta térmica, solución a sobrecalentamiento, lentitud, virus y respaldos para oficinas y PyMEs.', provider: { '@id': 'https://pixon.com.mx/#business' }, areaServed: [{ '@type': 'City', name: 'Cancún' }, { '@type': 'State', name: 'Quintana Roo' }] },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://pixon.com.mx/' }, { '@type': 'ListItem', position: 2, name: 'Servicios', item: 'https://pixon.com.mx/servicios/' }, { '@type': 'ListItem', position: 3, name: 'Mantenimiento preventivo para empresas', item: `https://pixon.com.mx${canonical}` }] },
];
---

<Base title="Mantenimiento preventivo de computadoras para empresas en Cancún | Pixon PC" description="Mantenimiento y limpieza de computadoras empresariales en Cancún. Evita sobrecalentamientos, pantallas azules, apagones y lentitud en tu oficina." canonical={canonical} image="/assets/images/soporte-hoteles-hero.webp" schema={schema} bodyClass="service-page enterprise-maintenance-page">
  <Navbar />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Servicios', href: '/servicios' }, { label: 'Mantenimiento preventivo para empresas' }]} />

  <main class="ep-main">
    
    <!-- REDISEÑO COMPLETO HERO CON GRADIENTES PREMIUM, GLOW Y MICRO-INTERACCIONES -->
    <section class="ep-hero">
      <div class="ep-hero-glow"></div>
      <img src="/assets/images/soporte-hoteles-hero.webp" alt="Mantenimiento preventivo de computadoras y laptops para empresas en Cancún" width="1600" height="1050" loading="eager" fetchpriority="high" />
      <div class="ep-hero__shade"></div>
      <div class="ep-shell ep-hero__content">
        <div class="ep-hero__copy">
          <span class="ep-kicker"><i class="fa-solid fa-location-dot"></i> Servicio Técnico de TI en Cancún &middot; Facturación CFDI</span>
          <h1>Mantenimiento preventivo de computadoras para empresas en Cancún</h1>
          <p>Evita que el sobrecalentamiento, las pantallas azules de la muerte o un reinicio inesperado detengan tu oficina. Ofrecemos **limpieza interna profunda**, cambio de pasta térmica en laptops y PCs de escritorio por lote, y optimización de Windows para que tu personal trabaje sin lentitud ni interrupciones.</p>
          <div class="ep-actions">
            <a class="ep-btn ep-btn--primary" href={`https://wa.me/529986690777?text=${waText}`} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /> Cotizar mantenimiento por WhatsApp</a>
            <a class="ep-btn ep-btn--ghost" href="#ticket-empresa"><Icon name="clipboard-list" /> Crear ticket de soporte empresarial</a>
          </div>
          <dl class="ep-facts">
            <div><dt>Equipos cubiertos</dt><dd>Laptops, PC de escritorio, Mac e impresoras</dd></div>
            <div><dt>Ubicación del servicio</dt><dd>Visitas en sitio (Cancún) y soporte remoto</dd></div>
            <div><dt>Tiempos y Entregas</dt><dd>Limpieza programada por lote y reporte técnico</dd></div>
          </dl>
        </div>
        <aside class="ep-hero__console" aria-label="Consola de monitoreo y soporte empresarial de sistemas">
          <div class="ep-console__head"><span><i></i> Operación activa en Cancún</span><b>Pixon PC / TI</b></div>
          <div class="ep-console__core">
            <span class="ep-console__ring"><Icon name="desktop" /></span>
            <strong>Continuidad de negocio</strong>
            <small>Prevención activa contra sobrecalentamiento</small>
          </div>
          <div class="ep-console__nodes">
            <span><Icon name="gauge-high" /> Velocidad de Windows</span>
            <span><Icon name="shield-halved" /> Limpieza de virus</span>
            <span><Icon name="database" /> Copia de seguridad</span>
            <span><Icon name="wifi" /> WiFi estable de oficina</span>
          </div>
          <div class="ep-console__foot"><span>Limpieza por lote</span><strong>Prioridad para áreas críticas</strong></div>
        </aside>
      </div>
    </section>

    <!-- CONTINUIDAD OPERATIVA -->
    <section class="ep-section ep-opening">
      <div class="ep-shell ep-split">
        <div>
          <span class="ep-label">Continuidad operativa y de sistemas</span>
          <h2>Soporte técnico para empresas que necesitan equipos rápidos y estables</h2>
          <h3>Limpieza interna profunda de hardware y mantenimiento preventivo en Cancún</h3>
          <p>Una revisión de computadoras corporativa va más allá de soplarlas superficialmente. En el clima de Cancún, la combinación de polvo pegajoso, alta humedad y salitre crea una capa de sedimentos que obstruye ventiladores, bloquea rejillas y acelera la corrosión de la tarjeta madre. Nuestro servicio remueve esta suciedad física antes de que tu laptop se caliente y se apague sola.</p>
          
          <h3>Optimización lógica de Windows para erradicar la lentitud</h3>
          <p>Comparamos los síntomas de lentitud con mediciones del estado del SSD, el consumo de memoria RAM y la temperatura del procesador. Corregimos cuellos de botella lógicos, eliminamos software basura y limpiamos amenazas sin reinstalar Windows ni comprometer tus archivos administrativos o licencias.</p>
          
          <h3>Cobertura técnica para despachos, oficinas, hoteles y comercios locales</h3>
          <p>Organizamos el mantenimiento preventivo por lotes y horarios específicos para que no tengas que detener toda tu oficina a la vez. Ofrecemos visitas programadas en sitio y soporte inmediato ante incidentes.</p>
        </div>
        <figure>
          <img src="/assets/images/mantenimiento-pc-escritorio.webp" alt="Técnico de Pixon PC dando soporte de sistemas a computadoras de oficina en Cancún" loading="lazy" />
          <figcaption>Evitamos apagones inesperados y pérdida de datos mediante soporte preventivo estructurado.</figcaption></figure></div></section>
 
    <!-- SÍNTOMAS COMUNES DE LENTITUD Y CALENTAMIENTO -->
    <section class="ep-section ep-intent">
      <div class="ep-shell">
        <header class="ep-heading">
          <Icon name="gauge-high" />
          <div>
            <span class="ep-label">Diagnóstico de rendimiento</span>
            <h2>¿Tus computadoras están realmente lentas o necesitan una limpieza urgente?</h2>
            <p>Muchos reportes de computadoras lentas en Cancún son la consecuencia de un sobrecalentamiento sostenido. Cuando el calor es excesivo, el procesador baja su velocidad de trabajo para enfriarse. Identificar estas señales a tiempo te ahorra compras innecesarias de equipos nuevos.</p>
          </div>
        </header>
        <div class="ep-intent__grid">
          <article><b>01</b><h3>Laptops y PCs que tardan minutos en prender</h3><p>Revisamos si el disco duro HDD está degradado, diagnosticamos el inicio de Windows y ampliamos a discos SSD para acelerar la velocidad al máximo.</p></article>
          <article><b>02</b><h3>El sistema se congela o se traba al facturar</h3><p>Evaluamos el consumo de memoria RAM y el procesador en medio del trabajo real, asegurando la fluidez en tus sistemas de ventas o cajas de cobro.</p></article>
          <article><b>03</b><h3>Computadoras con virus, ventanas raras y adware</h3><p>Eliminamos secuestradores de navegadores, extensiones maliciosas y programas instalados sin autorización que saturan la conexión de internet de tu oficina.</p></article>
          <article><b>04</b><h3>Apagones repentinos a mitad de la jornada laboral</h3><p>Es la protección térmica en acción. Si el ventilador está bloqueado por pelusa o polvo costero de Cancún, el equipo se apaga solo de inmediato para no quemarse.</p></article>
        </div>
      </div>
    </section>
 
    <!-- ALCANCE PREVENTIVO -->
    <section class="ep-section ep-includes">
      <div class="ep-shell ep-feature">
        <div>
          <span class="ep-label">Alcance del servicio de TI</span>
          <h2>¿Qué incluye el mantenimiento preventivo de computadoras para tu empresa?</h2>
          <p>Diseñamos un plan adaptado a tu volumen de equipos informáticos y necesidades de software. Una póliza completa combina la limpieza física del hardware con la optimización de seguridad lógica.</p>
        </div>
        <div class="ep-checklist">
          <article><Icon name="fan" /><h3>Limpieza física interna de hardware</h3><p>Remoción de polvo en gabinetes, ventiladores, disipadores de cobre, puertos de conexión, fuentes de poder y teclado.</p></article>
          <article><Icon name="windows" /><h3>Optimización de Windows y programas</h3><p>Eliminación de archivos temporales, limpieza del registro, desinstalación de bloatware y parches de seguridad recomendados.</p></article>
          <article><Icon name="microchip" /><h3>Revisión térmica y cambio de pasta térmica</h3><p>Medición de temperaturas de la CPU/GPU bajo carga y reemplazo de pasta térmica vieja por un compuesto nuevo de alta conductividad.</p></article>
          <article><Icon name="clipboard-check" /><h3>Reporte de salud y diagnóstico de discos</h3><p>Monitoreo del estado de salud de discos SSD o HDD mediante parámetros S.M.A.R.T. para anticipar pérdidas de información de la empresa.</p></article>
        </div>
      </div>
    </section>
 
    <!-- CANALES DE SOPORTE -->
    <section class="ep-section ep-it">
      <div class="ep-shell ep-it__layout">
        <div class="ep-it__panel">
          <header><span>Canales de ayuda de TI</span><Icon name="headset" /></header>
          <div class="ep-it__channels">
            <article>
              <Icon name="location-dot" />
              <div>
                <strong>Soporte técnico en sitio</strong>
                <p>Para fallas físicas, limpieza interna profunda por sobrecalentamiento, problemas de red local, WiFi o impresoras.</p>
              </div>
              <small>Visita en taller u oficina</small>
            </article>
            <article>
              <Icon name="globe" />
              <div>
                <strong>Soporte técnico remoto</strong>
                <p>Configuración de paquetería de oficina, problemas con correos, virus en navegadores y dudas de usuarios mediante conexión segura.</p>
              </div>
              <small>Mesa de ayuda remota</small>
            </article>
          </div>
          <footer><i></i><span>Soporte rápido adaptado a la urgencia</span></footer>
        </div>
        <div>
          <span class="ep-label">Administración de TI local</span>
          <h2>Soporte técnico integral y consultoría de sistemas para PyMEs en Cancún</h2>
          <h3>Servicio técnico confiable de computadoras, laptops y redes locales</h3>
          <p>Atendemos problemas técnicos individuales del personal y fallas de infraestructura de tu red de oficina. Llevamos el control administrativo de qué equipo presenta fallas recurrentes para optimizar tus gastos de TI.</p>
          
          <h3>Soporte para software administrativo, contable y correos</h3>
          <p>Verificamos que tus sistemas de contabilidad (CONTPAQi, Aspel, etc.), bases de datos locales, ERP e impresoras compartidas en red funcionen con estabilidad. Las actualizaciones delicadas de Windows se planifican con respaldos previos.</p>
        </div>
      </div>
    </section>
 
    <!-- PROBLEMAS FRECUENTES -->
    <section class="ep-section ep-problems">
      <div class="ep-shell">
        <header class="ep-heading">
          <Icon name="triangle-exclamation" />
          <div>
            <span class="ep-label">Incidentes frecuentes de hardware y software</span>
            <h2>Problemas comunes en computadoras de oficina que resolvemos a diario</h2>
            <p>La inestabilidad informática en tu negocio de Cancún puede venir de un ventilador bloqueado con polvo, una pasta térmica endurecida o virus en Windows. Diagnosticamos de manera responsable.</p>
          </div>
        </header>
        <div class="ep-problems__grid">
          {problems.map(([icon, title, text]) => (
            <article>
              <Icon name={icon} />
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
 
    <!-- PREVENCIÓN DE APAGONES Y SOBRECALENTAMIENTO -->
    <section class="ep-section ep-thermal">
      <div class="ep-shell ep-split ep-split--reverse">
        <figure><img src="/assets/images/mantenimiento-pastaternima-thermalpads.webp" alt="Limpieza interna de hardware y cambio de pasta térmica de computadoras en Cancún" loading="lazy" /></figure>
        <div>
          <span class="ep-label">Control de temperatura en Cancún</span>
          <h2>Mantenimiento térmico para laptops y PCs de escritorio empresariales</h2>
          <h3>Limpieza interna del ventilador y desobstrucción de disipadores</h3>
          <p>El ventilador succiona aire caliente, pero en Cancún arrastra humedad y salitre marino. Esto compacta el polvo fino dentro del disipador, forzando a los ventiladores a girar a revoluciones máximas haciendo ruido de turbina. La limpieza física a tiempo remueve estas obstrucciones antes de que la PC se caliente y se apague sola por protección térmica.</p>
          
          <h3>Cambio de pasta térmica premium para prevenir fallas físicas</h3>
          <p>Una pasta térmica seca o endurecida ya no transfiere calor al disipador. Si tu CPU o GPU opera continuamente a más de 80°C, la vida útil de los componentes se reduce drásticamente, provocando pantallas azules y reinicios repentinos. Reemplazamos el compuesto por pasta térmica premium de alta conductividad para mantener tu equipo frío y silencioso.</p>
        </div>
      </div>
    </section>
 
    <!-- OPTIMIZACIÓN DE WINDOWS -->
    <section class="ep-section ep-windows">
      <div class="ep-shell ep-windows__layout">
        <div class="ep-windows__copy">
          <span class="ep-label">Velocidad del sistema</span>
          <h2>Optimización de velocidad y rendimiento de Windows</h2>
          <p>Buscamos estabilidad, estabilidad y tiempos de respuesta ágiles en las tareas diarias de tu personal de oficina, eliminando cuellos de botella sin prometer milagros ni reinstalar sistemas operativos por rutina.</p>
          <div class="ep-windows__device">
            <div class="ep-windows__screen">
              <Icon name="windows" />
              <span>Estado del equipo</span>
              <strong>Flujo de trabajo empresarial verificado</strong>
            </div>
            <div class="ep-windows__base"></div>
          </div>
        </div>
        <ol>
          <li><Icon name="gear" /><div><strong>Inicio optimizado</strong><span>Desactivamos servicios y programas en segundo plano que ralentizan el encendido.</span></div><b>01</b></li>
          <li><Icon name="windows" /><div><strong>Drivers y parches</strong><span>Instalamos controladores estables y parches de Windows para evitar congelamientos y pantallas azules.</span></div><b>02</b></li>
          <li><Icon name="database" /><div><strong>Limpieza de almacenamiento</strong><span>Eliminamos archivos temporales pesados y optimizamos el espacio libre del disco SSD/HDD.</span></div><b>03</b></li>
          <li><Icon name="circle-check" /><div><strong>Prueba de velocidad</strong><span>Validamos el comportamiento real del equipo con las aplicaciones habituales de tu oficina.</span></div><b>04</b></li>
        </ol>
      </div>
    </section>
 
    <!-- SEGURIDAD BÁSICA -->
    <section class="ep-section ep-security">
      <div class="ep-shell ep-security__layout">
        <div>
          <span class="ep-label">Seguridad de la información</span>
          <h2>Eliminación de virus, malware y desinfección de computadoras de oficina</h2>
          <p>Detectamos y removemos software malicioso, spyware, troyanos, extensiones de navegador que inyectan publicidad molesta y programas instalados sin autorización del administrador. Si detectamos señales de compromiso de red o ransomware, procedemos a aislar el equipo de inmediato para proteger la información del negocio.</p>
          <div class="ep-security__tags">
            <span>Antivirus corporativo</span>
            <span>Limpieza de navegadores</span>
            <span>Eliminación de troyanos</span>
            <span>Actualización de firewall</span>
            <span>Gestión de contraseñas</span>
          </div>
        </div>
        <aside>
          <Icon name="shield-halved" />
          <h3>La limpieza no sustituye una política de seguridad informática</h3>
          <p>Te entregamos recomendaciones administrativas y preventivas sobre permisos de usuario, actualizaciones automáticas de Windows, seguridad en descargas y contraseñas seguras para reducir el riesgo de nuevas infecciones en tu oficina de Cancún.</p>
        </aside>
      </div>
    </section>
 
    <!-- RESPALDO DE INFORMACIÓN -->
    <section class="ep-section ep-backup">
      <div class="ep-shell ep-backup__layout">
        <div class="ep-backup__visual">
          <Icon name="database" />
          <span>Archivos de Excel</span>
          <span>Facturas y CFDI</span>
          <span>Bases de datos</span>
          <span>Correos Outlook</span>
        </div>
        <div>
          <span class="ep-label">Protección de datos empresariales</span>
          <h2>Respaldos de información automáticos y prevención de pérdida de datos</h2>
          <h3>Diagnóstico y salud del disco antes de que falle por completo</h3>
          <p>Cuando una computadora lenta hace ruidos extraños de clic-clic o el SSD tiene problemas de lectura, la prioridad cambia inmediatamente: primero salvaguardamos la información confidencial de la empresa y después nos enfocamos en el mantenimiento físico o lógico.</p>
          
          <h3>Respaldos locales en red local y copia de seguridad en la nube</h3>
          <p>Te ayudamos a estructurar políticas de backup automáticas en discos duros locales NAS o servicios en la nube empresariales, verificando que los respaldos se realicen con éxito. No asumimos que una sincronización simple de OneDrive o Google Drive es un respaldo seguro y libre de ransomware.</p>
        </div>
      </div>
    </section>
 
    <!-- CTA INTERMEDIO -->
    <section class="ep-mid-cta">
      <div class="ep-shell">
        <div class="ep-mid-cta__mark"><Icon name="desktop" /><i></i><i></i><i></i></div>
        <div>
          <span>¿Tus computadoras se calientan o están lentas en Cancún?</span>
          <h2>Programa una limpieza interna por lote antes de que la falla detenga a tu personal crítico</h2>
        </div>
        <a href="#ticket-empresa">Solicitar diagnóstico de flotilla <Icon name="arrow-right" /></a>
      </div>
    </section>
 
    <!-- DIAGNÓSTICO DE HARDWARE -->
    <section class="ep-section ep-hardware">
      <div class="ep-shell">
        <header class="ep-heading">
          <Icon name="microchip" />
          <div>
            <span class="ep-label">Salud física de componentes</span>
            <h2>Pruebas de estabilidad de hardware: almacenamiento, memoria RAM y procesador</h2>
            <p>Las pruebas de diagnóstico deben ser seguras para la información. Un disco duro mecánico viejo e inestable no se somete a las mismas pruebas de velocidad que un SSD saludable pero lento.</p>
          </div>
        </header>
        <div class="ep-metrics">
          <article>
            <strong>PRUEBAS S.M.A.R.T.</strong>
            <h3>Salud de almacenamiento corporativo</h3>
            <p>Monitoreamos sectores dañados, horas de uso acumuladas y temperatura de discos duros y unidades SSD.</p>
          </article>
          <article>
            <strong>VELOCIDAD DE E/S</strong>
            <h3>Tiempos de respuesta de disco</h3>
            <p>Detectamos discos duros lentos saturados al 100% que hacen que Windows se trabe o tarde en abrir programas.</p>
          </article>
          <article>
            <strong>ESTABILIDAD DE RAM</strong>
            <h3>Pruebas de memoria física</h3>
            <p>Descartamos módulos de RAM defectuosos que provocan reinicios repentinos, congelamientos y pantallas azules.</p>
          </article>
          <article>
            <strong>AMPLIACIONES (UPGRADE)</strong>
            <h3>Upgrades de hardware con contexto</h3>
            <p>Aumentar memoria RAM o instalar un disco SSD rápido solo cuando el procesador del equipo justifique la inversión.</p>
          </article>
        </div>
      </div>
    </section>
 
    <!-- LAPTOPS VS PC DE ESCRITORIO -->
    <section class="ep-section ep-devices">
      <div class="ep-shell">
        <div class="ep-device ep-device--laptop">
          <img src="/assets/images/laptop-gamer-rogstrix.webp" alt="Mantenimiento preventivo de laptops corporativas en Cancún" loading="lazy" />
          <div>
            <span class="ep-label">Soporte para equipos móviles</span>
            <h2>Mantenimiento preventivo y limpieza de laptops de trabajo en Cancún</h2>
            <p>Damos mantenimiento a laptops HP, Dell, Lenovo, Asus, Acer y MacBook de uso continuo. Revisamos ciclos de salud de batería, estado físico de las bisagras, teclado, cargador, conectores de carga, temperatura interna de CPU, ventiladores y puertos USB.</p>
            <h3>Laptop que se calienta y se apaga sola</h3>
            <p>Verificamos que el extractor de calor funcione libre de pelusa y polvo. Renovamos los thermal pads y la pasta térmica seca para prolongar la vida útil de los equipos de tus colaboradores remotos.</p>
          </div>
        </div>
        <div class="ep-device ep-device--desktop">
          <div>
            <span class="ep-label">Puestos administrativos fijos</span>
            <h2>Mantenimiento preventivo de PC de escritorio para oficinas</h2>
            <p>Atendemos computadoras fijas en áreas de recepción, cajas de cobro, facturación y contabilidad en Cancún. Desarmamos el gabinete, limpiamos la fuente de poder (que suele acumular polvo estático pesado), organizamos el cableado interno para mejorar el flujo de aire y limpiamos ventiladores del procesador y chasis.</p>
            <h3>Equipos que operan jornadas de 24 horas</h3>
            <p>Alineamos la frecuencia de limpieza interna según el ambiente de trabajo (presencia de humedad, salitre costero de Cancún o falta de flujo de aire) para evitar paros imprevistos.</p>
          </div>
          <img src="/assets/images/mantenimiento-pc-escritorio.webp" alt="Mantenimiento preventivo y limpieza interna de PC de escritorio de oficina en Cancún" loading="lazy" />
        </div>
      </div>
    </section>
 
    <!-- IMPRESORAS Y RED LOCAL -->
    <section class="ep-section ep-network">
      <div class="ep-shell ep-network__layout">
        <div>
          <Icon name="print" />
          <h2>Revisión de impresoras compartidas de oficina y red local</h2>
          <p>Una computadora que no imprime no siempre tiene una falla física. Analizamos controladores de impresora, colas de impresión saturadas, asignaciones de IP, cableado Ethernet de oficina, WiFi inestable y permisos de Windows antes de recomendar cualquier reparación.</p>
        </div>
        <div class="ep-network__map">
          <span>Computadora</span>
          <i></i>
          <span>Red Local WiFi / LAN</span>
          <i></i>
          <span>Impresora de oficina</span>
          <i></i>
          <span>Archivos compartidos</span>
        </div>
        <div>
          <h3>WiFi inestable, switches de red y recursos compartidos</h3>
          <p>Diagnosticamos desconexiones recurrentes de internet, switches de red saturados, carpetas compartidas sin permisos, y accesorios para ubicar el origen real de la falla informática en el punto correcto.</p>
        </div>
      </div>
    </section>
 
    <!-- EQUIPOS CRÍTICOS (PUNTO DE VENTA Y FACTURACIÓN) -->
    <section class="ep-section ep-pos">
      <div class="ep-shell ep-pos__layout">
        <div class="ep-pos__copy">
          <span class="ep-label">Áreas críticas de ventas</span>
          <h2>Soporte técnico para computadoras de punto de venta (POS) y facturación</h2>
          <p>Las computadoras que operan la facturación electrónica CFDI, cobros a clientes e inventarios son el corazón de tu negocio en Cancún. Antes de realizar formateos o actualizaciones de Windows, resguardamos licencias, bases de datos y configuraciones específicas de periféricos de cobro.</p>
          
          <h3>Mantenimiento de sistemas sin borrar programas contables</h3>
          <p>No formateamos por rutina. Documentamos el sistema y sus dependencias, protegemos tus archivos y configuramos de forma segura las actualizaciones automáticas de Windows para que no se instalen a mitad del horario laboral.</p>
          
          <div class="ep-pos__assurance">
            <Icon name="shield-halved" />
            <span><strong>Intervención controlada de sistemas</strong> Verificamos programas, licencias, terminales bancarias y bases de datos antes de realizar cualquier cambio técnico mayor en tus computadoras críticas.</span>
          </div>
        </div>
        <div class="ep-pos__map">
          <div class="ep-pos__hub">
            <Icon name="desktop" />
            <strong>Punto de venta y facturación</strong>
            <span>Operación centralizada</span>
          </div>
          <ol>
            <li><Icon name="file-invoice" /><div><strong>01</strong><span>Facturación electrónica CFDI</span></div></li>
            <li><Icon name="box" /><div><strong>02</strong><span>Inventarios y almacén</span></div></li>
            <li><Icon name="chart-line" /><div><strong>03</strong><span>Cajas de cobro y terminales</span></div></li>
            <li><Icon name="print" /><div><strong>04</strong><span>Impresión térmica de tickets</span></div></li>
          </ol>
        </div>
      </div>
    </section>
 
    <!-- PYMES Y HOTELES EN CANCÚN -->
    <section class="ep-section ep-sectors">
      <div class="ep-shell">
        <header class="ep-heading">
          <Icon name="building" />
          <div>
            <span class="ep-label">Soporte TI por sector comercial</span>
            <h2>Mantenimiento preventivo de computadoras para PyMEs, hoteles y restaurantes en Cancún</h2>
            <p>Un negocio con tres computadoras de oficina depende de cada equipo tanto como una gran empresa. Cotizamos nuestros servicios de soporte técnico por volumen y prioridad operativa, facilitando el mantenimiento a los negocios locales en Cancún sin contratos complejos.</p>
          </div>
        </header>
        <div class="ep-sector-row">
          <article>
            <span>PyMEs y Oficinas</span>
            <h3>Despachos contables, agencias de viajes, escuelas y consultorios</h3>
            <p>Soporte de sistemas claro, optimización de velocidad de Windows, limpieza interna de laptops y mantenimiento preventivo para oficinas que necesitan equipos estables.</p>
          </article>
          <article>
            <span>Hoteles y Hostales</span>
            <h3>Equipos de recepción, reservas, administración y almacén</h3>
            <p>Programamos limpiezas de computadoras y mantenimiento por lotes en horarios flexibles para no interferir con las áreas de recepción de huéspedes en Cancún.</p>
          </article>
          <article>
            <span>Comercios y Restaurantes</span>
            <h3>Computadoras de caja, sistemas POS, comandas y WiFi empresarial</h3>
            <p>Mantenimiento y soporte preventivo enfocado a equipos de uso intensivo expuestos a calor, grasa de cocina o humedad ambiental.</p>
          </article>
        </div>
      </div>
    </section>
 
    <!-- PLANES DE MANTENIMIENTO -->
    <section class="ep-section ep-plans">
      <div class="ep-shell">
        <header class="ep-heading">
          <Icon name="clipboard-check" />
          <div>
            <span class="ep-label">Planes de soporte técnico de computadoras</span>
            <h2>Planes de mantenimiento preventivo de PC y laptops para empresas</h2>
            <p>La frecuencia recomendada para dar mantenimiento físico y de software depende del entorno de trabajo en Cancún y las horas de uso diario de la flotilla de computadoras.</p>
          </div>
        </header>
        <div class="ep-table">
          <table>
            <thead>
              <tr>
                <th>Plan de servicio</th>
                <th>Recomendado para</th>
                <th>Qué incluye el servicio</th>
                <th>Frecuencia en Cancún</th>
              </tr>
            </thead>
            <tbody>
              {plans.map(row => (
                <tr>
                  {row.map(cell => <td>{cell}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
 
    <!-- PREVENTIVO VS CORRECTIVO -->
    <section class="ep-section ep-compare">
      <div class="ep-shell">
        <span class="ep-label">Decisión administrativa de TI</span>
        <h2>Mantenimiento preventivo vs mantenimiento correctivo de computadoras en la empresa</h2>
        <div class="ep-compare__grid">
          <article>
            <Icon name="shield-halved" />
            <h3>Mantenimiento Preventivo</h3>
            <p>Se planifica por lote, se realiza en horarios flexibles, previene fallas, pantallas azules y permite respaldar la información de la empresa con calma.</p>
            <dl>
              <div><dt>Ejecución</dt><dd>Antes de que ocurra la falla</dd></div>
              <div><dt>Impacto en la oficina</dt><dd>Planeado sin detener labores</dd></div>
              <div><dt>Costo administrativo</dt><dd>Controlado y económico</dd></div>
            </dl>
          </article>
          <article>
            <Icon name="screwdriver-wrench" />
            <h3>Mantenimiento Correctivo</h3>
            <p>Se realiza de urgencia cuando la laptop ya no enciende, se apaga sola o muestra pantalla azul de forma permanente. Requiere refacciones y recuperación de datos rápida.</p>
            <dl>
              <div><dt>Ejecución</dt><dd>Cuando el equipo ya falló</dd></div>
              <div><dt>Impacto en la oficina</dt><dd>Paro operativo del colaborador</dd></div>
              <div><dt>Costo administrativo</dt><dd>Gasto de emergencia elevado</dd></div>
            </dl>
          </article>
        </div>
      </div>
    </section>
 
    <!-- PROCESO DE MANTENIMIENTO -->
    <section class="ep-section ep-process">
      <div class="ep-shell">
        <header class="ep-heading">
          <Icon name="tools" />
          <div>
            <span class="ep-label">Metodología de sistemas</span>
            <h2>Cómo trabaja Pixon PC el mantenimiento preventivo empresarial en Cancún</h2>
            <p>Mantenemos una comunicación transparente e historial técnico claro desde la cotización hasta el reporte técnico final de cada computadora.</p>
          </div>
        </header>
        <ol>
          {process.map(([n, title, text]) => (
            <li>
              <strong>{n}</strong>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
 
    <!-- BENEFICIOS -->
    <section class="ep-section ep-benefits">
      <div class="ep-shell ep-benefits__layout">
        <div>
          <span class="ep-label">Ventajas de TI para tu oficina</span>
          <h2>Beneficios reales de dar mantenimiento preventivo a tus computadoras en Cancún</h2>
          <p>El objetivo no es que una computadora antigua parezca nueva de fábrica. Es reducir los paros de trabajo imprevistos, asegurar tus copias de seguridad de datos corporativas y tomar decisiones informadas sobre cuándo conviene renovar hardware.</p>
        </div>
        <ul>
          <li><Icon name="clock" /><span><strong>Menos caídas operativas</strong> en horario comercial.</span></li>
          <li><Icon name="gauge-high" /><span><strong>Velocidad de Windows mejorada</strong> en tareas administrativas.</span></li>
          <li><Icon name="database" /><span><strong>Menor riesgo de pérdida de archivos</strong> de contabilidad y facturación.</span></li>
          <li><Icon name="laptop" /><span><strong>Mayor vida útil de flotillas</strong> de laptops e impresoras de red.</span></li>
          <li><Icon name="chart-line" /><span><strong>Presupuestos de TI previsibles</strong> evitando compras de emergencia.</span></li>
        </ul>
      </div>
    </section>
 
    <!-- ERRORES EVITABLES -->
    <section class="ep-section ep-errors">
      <div class="ep-shell">
        <header>
          <span class="ep-label">Riesgos para el hardware corporativo</span>
          <h2>Errores comunes que acortan la vida útil de las computadoras de tu oficina</h2>
        </header>
        <div class="ep-errors__list">
          <article><b>01</b><h3>Esperar a que la computadora no encienda</h3><p>Las pantallas azules intermitentes o una laptop lenta son alertas tempranas que permiten planificar un diagnóstico de hardware a tiempo.</p></article>
          <article><b>02</b><h3>No diagnosticar discos antes de la pérdida de datos</h3><p>El almacenamiento suele avisar de su deterioro mediante lentitud severa antes de quedar inaccesible por completo.</p></article>
          <article><b>03</b><h3>Trabajar con laptops sucias y con polvo</h3><p>El polvo costero obstruye las salidas de calor. Operar a temperaturas altas de forma continua daña procesadores y componentes en la placa.</p></article>
          <article><b>04</b><h3>No limpiar líquidos derramados a tiempo</h3><p>Un derrame de agua o café en una laptop puede parecer resuelto al secarse por fuera, pero por dentro la humedad acelera la oxidación del circuito.</p></article>
          <article><b>05</b><h3>No tener copias de seguridad automatizadas</h3><p>Ninguna reparación física garantiza recuperar archivos contables de un disco duro degradado o dañado internamente.</p></article>
        </div>
      </div>
    </section>
 
    <!-- SERVICIOS RELACIONADOS -->
    <section class="ep-section ep-related">
      <div class="ep-shell">
        <header class="ep-heading">
          <Icon name="toolbox" />
          <div>
            <span class="ep-label">Soluciones técnicas empresariales</span>
            <h2>Servicios de soporte técnico de cómputo y redes disponibles en Cancún</h2>
            <p>El mantenimiento preventivo puede revelar necesidades adicionales de velocidad en computadoras, respaldos lógicos, WiFi empresarial o seguridad en la red de tu oficina.</p>
          </div>
        </header>
        <div class="ep-related__grid">
          {related.map(([href, icon, title, text]) => (
            <a href={href}>
              <Icon name={icon} />
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
                <span>Ver detalles del servicio <Icon name="arrow-right" /></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
 
    <ServiceTicketSection id="ticket-empresa" sourcePage={Astro.url.pathname} defaultDevice="Equipo empresarial / B2B" defaultService="Mantenimiento preventivo empresarial" title="Solicita cotización de mantenimiento para computadoras en Cancún" subtitle="Indica cuántos equipos de cómputo (PCs, laptops, impresoras) tienes en tu oficina, qué síntomas presentan y las prioridades de tu negocio." />
    <ContactSection id="contacto-mantenimiento-empresas" />
  </main>
  <Footer />
</Base>

<style is:global>
  .enterprise-maintenance-page {
    --ep-ink: #071f3a;
    --ep-blue: #1479d4;
    --ep-blue-deep: #0f64b3;
    --ep-muted: #294963;
    --ep-line: #c8d9e6;
    --ep-ice: #eef6fc;
    background: #fff;
    color: var(--ep-ink);
  }
  
  .ep-main { overflow: hidden; }
  .ep-shell { width: min(1180px, calc(100% - 32px)); margin: 0 auto; }
  .ep-main :where(h2, h3, p, li, span, strong, a, td, th, dt, dd) { color: var(--ep-ink); }
  .ep-main .tc-svg { display: block; width: 20px; height: 20px; max-width: 26px; max-height: 26px; fill: currentColor; flex: 0 0 auto; }

  /* REDISEÑO COMPLETO HERO EMPRESARIAL: Gradientes premium, glow y micro-interacciones */
  .ep-hero {
    position: relative;
    min-height: 640px;
    display: grid;
    align-items: center;
    background: #071f3a;
    isolation: isolate;
    padding: clamp(52px, 8vw, 100px) 0 clamp(40px, 6vw, 75px);
  }

  .ep-hero-glow {
    position: absolute;
    bottom: -150px;
    right: -100px;
    width: 450px;
    height: 450px;
    border-radius: 999px;
    background: rgba(20, 121, 212, 0.18);
    filter: blur(55px);
    pointer-events: none;
    z-index: 1;
  }

  .ep-hero>img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ep-hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(135deg, rgba(3, 17, 31, 0.95) 0%, rgba(3, 17, 31, 0.85) 60%, rgba(3, 17, 31, 0.5) 100%);
  }

  .ep-hero__content {
    display: grid;
    grid-template-columns: minmax(0, 1.22fr) minmax(320px, 0.78fr);
    gap: clamp(34px, 5vw, 68px);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .ep-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #a9d9fb !important;
    font-size: .78rem;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }

  .ep-hero h1 {
    max-width: 20ch;
    margin: 0 0 16px;
    color: #fff;
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 4.4vw, 4.15rem);
    font-style: italic;
    font-weight: 800;
    line-height: 1.08;
    text-wrap: balance;
  }

  .ep-hero p {
    max-width: 680px;
    margin: 0 0 24px;
    color: rgba(255, 255, 255, 0.88) !important;
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .ep-hero p strong {
    color: #fff !important;
  }

  .ep-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  /* Botones premium estilo Emil Kowalski con active press */
  .ep-btn {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 22px;
    border-radius: 8px;
    font-weight: 850;
    font-size: 0.92rem;
    text-decoration: none;
    transition: transform 0.2s cubic-bezier(0.23, 1, 0.32, 1), box-shadow 0.2s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .ep-btn--primary {
    border: 1px solid var(--ep-blue);
    color: #fff !important;
    background: var(--ep-blue);
    box-shadow: 0 10px 25px rgba(20, 121, 212, 0.35);
  }

  .ep-btn--primary:hover {
    background: var(--ep-blue-deep);
    border-color: var(--ep-blue-deep);
    transform: translateY(-2px);
    box-shadow: 0 14px 30px rgba(20, 121, 212, 0.45);
  }

  .ep-btn--ghost {
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.08);
    color: #fff !important;
  }

  .ep-btn--ghost:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.35);
    transform: translateY(-2px);
  }

  .ep-btn:active {
    transform: scale(0.97);
  }

  .ep-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 760px;
    margin: 28px 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: 18px;
  }

  .ep-facts div { padding: 12px 18px 0 0; }
  .ep-facts dt { color: #8cc8f2; font-size: .7rem; font-weight: 850; text-transform: uppercase; letter-spacing: 0.05em; }
  .ep-facts dd { margin: 3px 0 0; color: #fff; font-size: .9rem; font-weight: 750; }

  /* Consola decorativa del Hero */
  .ep-hero__console {
    position: relative;
    overflow: hidden;
    padding: 20px;
    border: 1px solid rgba(139, 201, 245, 0.35);
    border-radius: 12px;
    background: rgba(6, 26, 46, 0.85);
    box-shadow: 0 25px 60px rgba(2, 13, 24, 0.5);
    backdrop-filter: blur(10px);
  }

  .ep-hero__console::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(rgba(106, 184, 238, 0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(106, 184, 238, 0.08) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .ep-console__head, .ep-console__foot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: #fff;
    font-size: .68rem;
    text-transform: uppercase;
  }

  .ep-console__head span, .ep-console__head b, .ep-console__foot span, .ep-console__foot strong { color: #fff; }
  .ep-console__head i {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 6px;
    border-radius: 50%;
    background: #47d79b;
    position: relative;
  }

  .ep-console__head i::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #47d79b;
    animation: status-pulse-green 1.8s infinite ease-in-out;
  }

  @keyframes status-pulse-green {
    0% { transform: scale(1); opacity: 1; }
    100% { transform: scale(2.8); opacity: 0; }
  }

  .ep-console__core {
    position: relative;
    display: grid;
    justify-items: center;
    padding: 24px 0 20px;
    text-align: center;
  }

  .ep-console__core :where(strong, small) { color: #fff; }
  .ep-console__core small { margin-top: 4px; opacity: .75; font-size: 0.8rem; }
  .ep-console__ring {
    display: grid;
    width: 74px;
    height: 74px;
    margin-bottom: 12px;
    place-items: center;
    border: 1px solid #65b8ef;
    border-radius: 50%;
    color: #fff !important;
    box-shadow: inset 0 0 0 10px rgba(20, 121, 212, 0.15), 0 0 0 7px rgba(20, 121, 212, 0.1);
  }

  .ep-console__ring .tc-svg { width: 26px; height: 26px; }
  .ep-console__nodes { position: relative; display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-bottom: 18px; }
  .ep-console__nodes span {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 10px;
    border: 1px solid rgba(135, 199, 240, 0.25);
    border-radius: 6px;
    color: #dcefff;
    background: #0b2943;
    font-size: .72rem;
    font-weight: 750;
  }

  .ep-console__nodes .tc-svg { color: #66bdf7; }
  .ep-console__foot { padding-top: 12px; border-top: 1px solid rgba(139, 201, 245, 0.22); }

  /* ESTILOS DE SECCIONES CON TEXTO AZUL OSCURO */
  .ep-section { position: relative; padding: clamp(50px, 6vw, 78px) 0; }
  .ep-section:not(.ep-windows):not(.ep-pos) :where(h2, h3, p, li, span, strong, a, td, th, dt, dd) { color: var(--ep-ink); }
  .ep-label { display: inline-block; color: var(--ep-blue) !important; font-size: .75rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.05em; }
  
  .ep-section h2, .ep-final h2, .ep-mid-cta h2 { 
    margin: 8px 0 14px; 
    font-family: var(--font-heading); 
    font-size: clamp(1.8rem, 3.2vw, 2.5rem); 
    font-style: italic; 
    font-weight: 800; 
    line-height: 1.1; 
    text-wrap: balance; 
  }
  
  .ep-section h3, .ep-final h3 { margin: 18px 0 6px; font-size: 1.08rem; line-height: 1.35; font-weight: 800; }
  .ep-section p, .ep-final p { max-width: 74ch; margin: 0; color: var(--ep-muted) !important; font-weight: 500; line-height: 1.65; }
  
  .ep-split { display: grid; grid-template-columns: 1fr .9fr; gap: clamp(32px, 6vw, 75px); align-items: center; }
  .ep-split--reverse { grid-template-columns: .9fr 1fr; }
  .ep-split figure, .ep-device img { margin: 0; overflow: hidden; border-radius: 8px; background: #dceaf4; border: 1px solid var(--ep-line); }
  .ep-split figure img, .ep-device img { display: block; width: 100%; aspect-ratio: 4/3; object-fit: cover; transition: transform 0.3s ease; }
  .ep-split figure:hover img, .ep-device:hover img { transform: scale(1.02); }
  .ep-split figcaption { padding: 11px 14px; color: var(--ep-muted); font-size: .8rem; font-weight: 600; }
  
  .ep-heading { display: grid; grid-template-columns: 44px minmax(0, 800px); gap: 16px; margin-bottom: 30px; align-items: start; }
  .ep-heading>.tc-svg { box-sizing: border-box; width: 42px; height: 42px; max-width: 42px; max-height: 42px; padding: 11px; border-radius: 7px; color: #fff; background: var(--ep-blue); }
  
  .ep-intent, .ep-problems, .ep-plans, .ep-related { background: var(--ep-ice); }
  .ep-intent__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--ep-line); border-radius: 8px; overflow: hidden; border: 1px solid var(--ep-line); }
  .ep-intent article { min-height: 195px; padding: 22px; background: #fff; }
  .ep-intent b, .ep-errors b { color: var(--ep-blue); font-weight: 900; }
  .ep-intent h3 { font-size: 1.05rem; line-height: 1.25; margin-bottom: 6px; }
  .ep-intent p { font-size: 0.88rem; line-height: 1.5; }
  
  .ep-feature { display: grid; grid-template-columns: .75fr 1.25fr; gap: 50px; }
  .ep-checklist { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--ep-line); border-radius: 8px; overflow: hidden; border: 1px solid var(--ep-line); }
  .ep-checklist article { padding: 22px; background: #fff; }
  .ep-checklist h3 { font-size: 1.05rem; margin-bottom: 6px; }
  .ep-checklist p { font-size: 0.88rem; line-height: 1.5; }
  .ep-checklist .tc-svg { color: var(--ep-blue); }
  
  .ep-it { overflow: hidden; background: #eaf4fa; position: relative; }
  .ep-it::before { content: ''; position: absolute; left: -110px; bottom: -130px; width: 280px; height: 280px; border: 1px solid #87b9d8; border-radius: 50%; box-shadow: 0 0 0 34px rgba(205, 228, 241, 0.2), 0 0 0 68px rgba(205, 228, 241, 0.15); pointer-events: none; }
  .ep-it__layout { display: grid; grid-template-columns: .7fr 1.3fr; gap: 50px; align-items: center; }
  .ep-it__panel { position: relative; display: grid; gap: 0; padding: 22px; border: 1px solid #a8cada; border-radius: 12px; background: #fff; box-shadow: 0 18px 45px rgba(18, 60, 92, 0.08); z-index: 1; }
  .ep-it__panel header, .ep-it__panel footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .ep-it__panel header { padding-bottom: 16px; border-bottom: 1px solid var(--ep-line); }
  .ep-it__panel header span, .ep-it__panel footer span { color: var(--ep-ink) !important; font-size: .75rem; font-weight: 900; text-transform: uppercase; }
  .ep-it__panel header>.tc-svg { color: var(--ep-blue); }
  .ep-it__channels { display: grid; gap: 10px; padding: 18px 0; }
  .ep-it__channels article { display: grid; grid-template-columns: 38px 1fr auto; gap: 13px; align-items: center; padding: 15px; border-radius: 7px; background: #edf6fb; border: 1px solid transparent; }
  .ep-it__channels article>.tc-svg { box-sizing: border-box; width: 36px; height: 36px; max-width: 36px; max-height: 36px; padding: 9px; border-radius: 50%; color: #fff; background: var(--ep-blue); }
  .ep-it__channels strong, .ep-it__channels p, .ep-it__channels small { color: var(--ep-ink) !important; }
  .ep-it__channels strong { display: block; margin-bottom: 3px; font-size: 0.95rem; }
  .ep-it__channels p { font-size: .86rem; line-height: 1.45; }
  .ep-it__channels small { font-size: .68rem; font-weight: 800; text-transform: uppercase; }
  .ep-it__panel footer { justify-content: flex-start; padding-top: 14px; border-top: 1px solid var(--ep-line); }
  .ep-it__panel footer i { width: 8px; height: 8px; border-radius: 50%; background: #1e9c6c; box-shadow: 0 0 0 4px rgba(30, 156, 108, 0.1); }
  
  .ep-problems__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--ep-line); border-radius: 8px; overflow: hidden; border: 1px solid var(--ep-line); }
  .ep-problems article { display: grid; grid-template-columns: 38px 1fr; gap: 14px; padding: 20px; background: #fff; }
  .ep-problems article>.tc-svg { color: var(--ep-blue); }
  .ep-problems h3 { margin-top: 0; font-size: 1.05rem; }
  .ep-problems p { font-size: 0.88rem; line-height: 1.5; }
  
  .ep-thermal { background: #fff; }
  
  /* Sección de Windows adaptada a colores de la página */
  .ep-windows { position: relative; overflow: hidden; background: #e8f3f9; }
  .ep-windows::after { content: ''; position: absolute; right: -80px; top: 45px; width: 240px; height: 240px; border: 1px solid #8ebbd6; border-radius: 50%; box-shadow: 0 0 0 28px rgba(255, 255, 255, 0.3), 0 0 0 56px rgba(255, 255, 255, 0.15); pointer-events: none; }
  .ep-windows :where(h2, p, li, strong, span, b) { color: var(--ep-ink) !important; }
  .ep-windows .ep-label { color: var(--ep-blue) !important; }
  .ep-windows__layout { display: grid; grid-template-columns: minmax(0, .92fr) minmax(420px, 1.08fr); gap: 50px; align-items: center; }
  .ep-windows__copy { position: relative; z-index: 1; }
  .ep-windows__device { width: min(350px, 90%); margin-top: 30px; }
  .ep-windows__screen { position: relative; display: grid; min-height: 150px; align-content: center; justify-items: center; padding: 24px; border: 7px solid var(--ep-ink); border-radius: 8px; background: #fff; box-shadow: 0 16px 34px rgba(18, 60, 92, 0.08); }
  .ep-windows__screen::before { content: ''; position: absolute; inset: 10px; background-image: linear-gradient(rgba(20, 121, 212, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(20, 121, 212, 0.05) 1px, transparent 1px); background-size: 18px 18px; }
  .ep-windows__screen>.tc-svg { position: relative; width: 34px; height: 34px; max-width: 34px; max-height: 34px; margin-bottom: 10px; color: var(--ep-blue); }
  .ep-windows__screen span { font-size: .7rem; font-weight: 800; text-transform: uppercase; }
  .ep-windows__screen strong { margin-top: 4px; font-size: 0.95rem; }
  .ep-windows__base { width: 45%; height: 17px; margin: auto; border-radius: 0 0 8px 8px; background: var(--ep-ink); }
  .ep-windows ol { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr; gap: 8px; margin: 0; padding: 0; border: 0; list-style: none; }
  .ep-windows li { position: relative; display: grid; grid-template-columns: 42px 1fr auto; gap: 14px; align-items: center; padding: 17px 18px; border: 1px solid #b8d3e3; border-radius: 7px; background: #fff; }
  .ep-windows li>.tc-svg { box-sizing: border-box; width: 40px; height: 40px; max-width: 40px; max-height: 40px; padding: 10px; border-radius: 6px; color: #fff; background: var(--ep-blue); }
  .ep-windows li span { display: block; margin-top: 3px; color: var(--ep-muted) !important; font-size: .86rem; }
  .ep-windows li b { font-size: .72rem; color: var(--ep-blue) !important; }
  .ep-windows li:not(:last-child)::after { content: ''; position: absolute; left: 38px; bottom: -9px; width: 2px; height: 9px; background: var(--ep-blue); }
  
  .ep-security__layout { display: grid; grid-template-columns: 1.2fr .8fr; gap: 50px; }
  .ep-security__tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .ep-security__tags span { padding: 8px 11px; border: 1px solid var(--ep-line); border-radius: 5px; font-size: .82rem; font-weight: 750; background: #fff; color: var(--ep-ink); }
  .ep-security aside { padding: 28px; border-radius: 8px; background: #e8f2f9; border: 1px solid var(--ep-line); }
  .ep-security aside>.tc-svg { width: 28px; height: 28px; max-width: 28px; max-height: 28px; color: var(--ep-blue); margin-bottom: 12px; }
  .ep-security aside h3 { font-size: 1.1rem; margin-bottom: 8px; }
  .ep-security aside p { font-size: 0.88rem; line-height: 1.5; }
  
  .ep-backup { background: #dcecf7; }
  .ep-backup__layout { display: grid; grid-template-columns: .75fr 1.25fr; gap: 50px; align-items: center; }
  .ep-backup__visual { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .ep-backup__visual>.tc-svg { grid-column: 1/-1; width: 48px; height: 48px; max-width: 48px; max-height: 48px; margin-bottom: 12px; color: var(--ep-blue); }
  .ep-backup__visual span { padding: 16px; background: #fff; font-weight: 750; font-size: 0.85rem; text-align: center; border-radius: 6px; box-shadow: inset 0 3px var(--ep-blue); border: 1px solid var(--ep-line); }
  
  /* Sección CTA Intermedio */
  .ep-mid-cta { position: relative; overflow: hidden; padding: 28px 0; border-block: 1px solid #a8cada; background: #dcecf7; }
  .ep-mid-cta::after { content: ''; position: absolute; right: 8%; top: -75px; width: 180px; height: 180px; border: 1px solid #80b7d8; border-radius: 50%; pointer-events: none; }
  .ep-mid-cta>div { display: grid; grid-template-columns: 72px 1fr auto; gap: 24px; align-items: center; }
  .ep-mid-cta :where(span, h2, a) { color: var(--ep-ink) !important; }
  .ep-mid-cta__mark { position: relative; display: grid; width: 64px; height: 64px; place-items: center; border-radius: 50%; color: #fff; background: var(--ep-blue); }
  .ep-mid-cta__mark>.tc-svg { width: 26px; height: 26px; }
  .ep-mid-cta__mark i { position: absolute; width: 5px; height: 5px; border-radius: 50%; background: var(--ep-blue); }
  .ep-mid-cta__mark i:nth-child(2) { left: -10px; }
  .ep-mid-cta__mark i:nth-child(3) { right: -10px; }
  .ep-mid-cta__mark i:nth-child(4) { bottom: -10px; }
  .ep-mid-cta a { position: relative; z-index: 1; padding: 12px 20px; border: 1px solid #6da8cc; border-radius: 8px; background: #fff; font-weight: 850; text-decoration: none; transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .ep-mid-cta a:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(18, 60, 92, 0.1); }
  .ep-mid-cta a:active { transform: scale(0.97); }

  .ep-metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .ep-metrics article { padding: 22px; background: linear-gradient(180deg, #d8ebf9 0 4px, #f1f7fb 4px); border-radius: 8px; border: 1px solid var(--ep-line); }
  .ep-metrics strong { font-size: .75rem; color: var(--ep-blue); text-transform: uppercase; letter-spacing: 0.05em; }
  .ep-metrics h3 { font-size: 1.05rem; margin: 8px 0 6px; }
  .ep-metrics p { font-size: 0.85rem; line-height: 1.5; }
  
  .ep-devices { background: #f4f8fb; }
  .ep-device { display: grid; grid-template-columns: repeat(2, 1fr); gap: 50px; align-items: center; padding: 28px 0; border-bottom: 1px solid var(--ep-line); }
  .ep-device:last-child { border-bottom: 0; }
  .ep-device h2 { font-size: 1.35rem; }
  .ep-device p { font-size: 0.92rem; line-height: 1.55; }
  .ep-device h3 { font-size: 1.05rem; margin-top: 14px; }
  
  .ep-network { background: #fff; }
  .ep-network__layout { display: grid; grid-template-columns: 1fr .7fr 1fr; gap: 40px; align-items: center; }
  .ep-network__layout>div:first-child>.tc-svg { width: 34px; height: 34px; max-width: 34px; max-height: 34px; color: var(--ep-blue); margin-bottom: 12px; }
  .ep-network__map { display: grid; justify-items: center; }
  .ep-network__map span { width: 110px; padding: 12px; text-align: center; border: 1px solid var(--ep-line); border-radius: 6px; background: #eef6fc; font-weight: 800; font-size: 0.8rem; }
  .ep-network__map i { width: 1px; height: 22px; background: var(--ep-blue); }
  
  /* Sección de POS (Puntos de venta) adaptada */
  .ep-pos { position: relative; overflow: hidden; background: #f3f8fb; }
  .ep-pos::before { content: ''; position: absolute; left: 0; top: 0; width: 100%; height: 5px; background: linear-gradient(90deg, var(--ep-blue) 0 32%, #85bddf 32% 67%, #c6deec 67%); }
  .ep-pos :where(h2, h3, p, li, strong, span) { color: var(--ep-ink) !important; }
  .ep-pos .ep-label { color: var(--ep-blue) !important; }
  .ep-pos__layout { display: grid; grid-template-columns: minmax(0, 1.02fr) minmax(420px, .98fr); gap: 50px; align-items: center; }
  .ep-pos__assurance { display: grid; grid-template-columns: 38px 1fr; gap: 13px; align-items: center; margin-top: 25px; padding: 15px; border: 1px solid #b9d4e4; border-radius: 8px; background: #fff; box-shadow: 0 4px 15px rgba(7, 31, 58, 0.02); }
  .ep-pos__assurance>.tc-svg { box-sizing: border-box; width: 38px; height: 38px; max-width: 38px; max-height: 38px; padding: 10px; border-radius: 50%; color: #fff; background: var(--ep-blue); }
  .ep-pos__assurance span { font-size: .82rem; line-height: 1.45; }
  .ep-pos__assurance strong { display: block; }
  .ep-pos__map { position: relative; display: grid; min-height: 400px; place-items: center; }
  .ep-pos__map::before, .ep-pos__map::after { content: ''; position: absolute; background: #84b9d8; }
  .ep-pos__map::before { left: 50%; top: 18%; bottom: 18%; width: 1px; }
  .ep-pos__map::after { left: 18%; right: 18%; top: 50%; height: 1px; }
  .ep-pos__hub { position: relative; z-index: 2; display: grid; width: 145px; height: 145px; place-content: center; justify-items: center; border: 1px solid #75afd1; border-radius: 50%; background: #fff; box-shadow: 0 0 0 14px #dcecf7, 0 18px 38px rgba(18, 60, 92, 0.08); text-align: center; }
  .ep-pos__hub>.tc-svg { width: 32px; height: 32px; max-width: 32px; max-height: 32px; margin-bottom: 8px; color: var(--ep-blue); }
  .ep-pos__hub span { font-size: .72rem; }
  .ep-pos__map ol { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; }
  .ep-pos__map li { position: absolute; display: grid; grid-template-columns: 34px 1fr; gap: 10px; align-items: center; width: 185px; padding: 13px; border: 1px solid #b9d4e4; border-radius: 8px; background: #fff; box-shadow: 0 10px 24px rgba(18, 60, 92, 0.05); }
  .ep-pos__map li:nth-child(1) { left: 0; top: 28px; }
  .ep-pos__map li:nth-child(2) { right: 0; top: 28px; }
  .ep-pos__map li:nth-child(3) { left: 0; bottom: 28px; }
  .ep-pos__map li:nth-child(4) { right: 0; bottom: 28px; }
  .ep-pos__map li>.tc-svg { box-sizing: border-box; width: 34px; height: 34px; max-width: 34px; max-height: 34px; padding: 8px; border-radius: 6px; color: #fff; background: var(--ep-blue); }
  .ep-pos__map li strong { display: block; color: var(--ep-blue) !important; font-size: .68rem; }
  .ep-pos__map li span { font-size: .78rem; font-weight: 800; }
  .ep-it p, .ep-windows p, .ep-pos p { color: var(--ep-ink) !important; }
  
  .ep-sector-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .ep-sector-row article { padding: 24px; border-radius: 8px; background: #f0f6fa; border: 1px solid var(--ep-line); }
  .ep-sector-row article>span { color: var(--ep-blue); font-size: .75rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.05em; }
  .ep-sector-row h3 { font-size: 1.1rem; margin: 8px 0 6px; }
  .ep-sector-row p { font-size: 0.88rem; line-height: 1.5; }
  
  .ep-table { overflow-x: auto; border-radius: 8px; border: 1px solid var(--ep-line); }
  .ep-table table { width: 100%; min-width: 800px; border-collapse: collapse; background: #fff; }
  .ep-table :where(th, td) { padding: 15px 17px; text-align: left; border-bottom: 1px solid var(--ep-line); }
  .ep-table th { color: var(--ep-blue); font-size: .8rem; text-transform: uppercase; font-weight: 800; background: #f8fafc; }
  .ep-table td:first-child { font-weight: 850; }
  .ep-table tr:last-child td { border-bottom: 0; }
  
  .ep-compare__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .ep-compare article { padding: 28px; border-radius: 8px; background: #eef6fc; border: 1px solid var(--ep-line); }
  .ep-compare article>.tc-svg { width: 28px; height: 28px; max-width: 28px; max-height: 28px; color: var(--ep-blue); margin-bottom: 12px; }
  .ep-compare h3 { font-size: 1.15rem; margin-bottom: 8px; }
  .ep-compare p { font-size: 0.88rem; line-height: 1.5; }
  .ep-compare dl { margin-top: 22px; }
  .ep-compare dl div { display: flex; justify-content: space-between; padding: 10px 0; border-top: 1px solid var(--ep-line); font-size: 0.88rem; }
  
  .ep-process { background: #fff; }
  .ep-process ol { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin: 0; padding: 0; background: var(--ep-line); list-style: none; border-radius: 8px; overflow: hidden; border: 1px solid var(--ep-line); }
  .ep-process li { display: grid; grid-template-columns: 38px 1fr; gap: 14px; min-height: 155px; padding: 21px; background: #fff; }
  .ep-process li>strong { color: var(--ep-blue); font-size: 1.15rem; font-weight: 850; }
  .ep-process h3 { margin-top: 0; font-size: 1.05rem; }
  .ep-process p { font-size: 0.88rem; line-height: 1.5; }
  
  .ep-benefits { background: #dcecf7; }
  .ep-benefits__layout { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center; }
  .ep-benefits ul { display: grid; gap: 1px; margin: 0; padding: 0; background: var(--ep-line); list-style: none; border-radius: 8px; overflow: hidden; border: 1px solid var(--ep-line); }
  .ep-benefits li { display: grid; grid-template-columns: 30px 1fr; gap: 12px; padding: 16px; background: #fff; align-items: center; }
  .ep-benefits li>.tc-svg { color: var(--ep-blue); }
  .ep-benefits li span { font-size: 0.9rem; line-height: 1.5; }
  
  .ep-errors__list { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: var(--ep-line); border-radius: 8px; overflow: hidden; border: 1px solid var(--ep-line); }
  .ep-errors article { padding: 20px; background: #fff; }
  .ep-errors h3 { font-size: 1.02rem; margin: 8px 0 6px; }
  .ep-errors p { font-size: 0.85rem; line-height: 1.5; }
  
  .ep-related__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .ep-related__grid>a { display: grid; grid-template-columns: 34px 1fr; gap: 13px; padding: 20px; border-radius: 8px; background: #fff; text-decoration: none; border: 1px solid var(--ep-line); transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .ep-related__grid>a>.tc-svg { color: var(--ep-blue); }
  .ep-related h3 { margin-top: 0; font-size: 1.05rem; }
  .ep-related p { font-size: 0.88rem; line-height: 1.5; }
  .ep-related__grid a span { display: inline-flex; gap: 7px; margin-top: 12px; color: var(--ep-blue); font-weight: 850; font-size: 0.88rem; }
  
  .enterprise-maintenance-page #ticket-empresa.service-ticket-section { padding-top: 56px !important; padding-bottom: 56px !important; }
  .enterprise-maintenance-page #ticket-empresa :where(h2, h3, label, strong, p, span) { color: var(--ep-ink) !important; }
  .enterprise-maintenance-page #ticket-empresa p { color: var(--ep-muted) !important; }

  /* HOVER EFFECTS */
  @media (hover: hover) and (pointer: fine) {
    .ep-related__grid>a:hover, .ep-intent article:hover, .ep-checklist article:hover, .ep-problems article:hover, .ep-sector-row article:hover, .ep-it__channels article:hover, .ep-windows li:hover, .ep-pos__map li:hover {
      transform: translateY(-3px);
      border-color: #78afd0;
      box-shadow: 0 12px 28px rgba(18, 60, 92, 0.08);
    }
    .ep-console__nodes span:hover {
      transform: translateY(-2px);
      border-color: rgba(135, 199, 240, 0.65);
    }
  }

  /* MEDIA QUERIES */
  @media (max-width: 900px) {
    .ep-hero__content { grid-template-columns: 1fr; padding-top: 80px; }
    .ep-hero__console { display: none; }
    .ep-split { grid-template-columns: 1fr; }
    .ep-split figure img { aspect-ratio: 16/9; }
    .ep-intent__grid, .ep-checklist, .ep-problems__grid, .ep-process ol, .ep-related__grid { grid-template-columns: repeat(2, 1fr); }
    .ep-feature, .ep-it__layout, .ep-backup__layout, .ep-pos__layout, .ep-benefits__layout { grid-template-columns: 1fr; gap: 30px; }
    .ep-compare__grid { grid-template-columns: 1fr; }
    .ep-device { grid-template-columns: 1fr; gap: 20px; }
    .ep-network__layout { grid-template-columns: 1fr; }
    .ep-network__map { display: none; }
    .ep-sector-row { grid-template-columns: 1fr; }
