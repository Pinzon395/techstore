---
/**
 * Hub general de servicios - /servicios
 * Consume src/data/services.ts como fuente unica para categorias y conteos.
 */
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CommentsSection from '../../components/CommentsSection.astro';
import { SERVICE_CATEGORIES } from '../../data/services';

const canonical = 'https://pixon.com.mx/servicios';
const totalServices = SERVICE_CATEGORIES.reduce((acc, c) => acc + c.services.length, 0);

const priorityServices = [
  { label: 'Pantalla rota', href: '/servicios/laptop/cambio-pantalla', icon: 'fa-display' },
  { label: 'No enciende', href: '/servicios/laptop/diagnostico', icon: 'fa-power-off' },
  { label: 'Equipo lento', href: '/servicios/pc/upgrade', icon: 'fa-gauge-high' },
  { label: 'Se calienta', href: '/servicios/laptop/pasta-termica', icon: 'fa-temperature-high' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://pixon.com.mx/' },
      { '@type': 'ListItem', position: 2, name: 'Servicios', item: canonical },
    ],
  },
];
---

<Base
  title="Servicios de reparación en Cancún | Pixon PC"
  description={`${totalServices} servicios profesionales de reparación: laptop, PC, teléfono, consola e impresora. Diagnóstico gratis y garantía por escrito.`}
  canonical={canonical}
  image="/LOGOCIRCULAR.png"
  schema={schema}
>
  <Navbar />

  <Breadcrumb items={[
    { label: 'Inicio', href: '/' },
    { label: 'Servicios' },
  ]} />

  <section class="svc-hub">
    <div class="svc-hub-bg" aria-hidden="true"></div>

    <div class="container svc-hub-inner">
      <header class="svc-hub-hero">
        <div class="svc-hub-copy">
          <span class="svc-hub-eyebrow">
            <i class="fa-solid fa-screwdriver-wrench"></i> Catálogo completo
          </span>
          <h1>Nuestros <span>servicios</span></h1>
          <p>
            {totalServices} servicios profesionales agrupados en 5 categorías.
            <strong> Diagnóstico siempre gratis</strong> y garantía por escrito en cada uno.
          </p>
          <div class="svc-hub-actions" aria-label="Acciones principales">
            <a href="#categorias-servicio" class="svc-hub-btn-primary">
              Ver categorías <i class="fa-solid fa-arrow-down"></i>
            </a>
            <a href="https://wa.me/529986690777?text=Hola%2C%20quiero%20saber%20que%20servicio%20necesita%20mi%20equipo" target="_blank" rel="noopener noreferrer" class="svc-hub-btn-secondary">
              <i class="fa-brands fa-whatsapp"></i> Orientación rápida
            </a>
          </div>
        </div>

        <aside class="svc-hub-map" aria-label="Resumen del catálogo">
          <div class="svc-hub-map-top">
            <span>Mapa de servicio</span>
            <strong>{totalServices}</strong>
            <small>servicios activos</small>
          </div>
          <div class="svc-hub-map-grid">
            <div><strong>5</strong><span>categorías</span></div>
            <div><strong>Sin costo</strong><span>diagnóstico</span></div>
            <div><strong>24-48h</strong><span>casos comunes</span></div>
            <div><strong>Garantía</strong><span>por escrito</span></div>
          </div>
        </aside>
      </header>

      <div class="svc-hub-priority" aria-label="Accesos por problema frecuente">
        <span class="svc-hub-priority-label">Atajos por problema</span>
        <div class="svc-hub-priority-links">
          {priorityServices.map((item) => (
            <a href={item.href}>
              <i class={`fa-solid ${item.icon}`}></i>
              {item.label}
            </a>
          ))}
        </div>
      </div>

      <section class="svc-hub-categories" id="categorias-servicio" aria-labelledby="categorias-title">
        <div class="svc-hub-section-head">
          <span>Elige por tipo de equipo</span>
          <h2 id="categorias-title">Servicios organizados para encontrar la solución más rápido</h2>
          <p>Entra a la categoría de tu equipo y revisa servicios específicos con cotización previa, tiempos estimados y proceso de atención.</p>
        </div>

        <div class="svc-hub-lanes">
          {SERVICE_CATEGORIES.map((cat, index) => (
            <a href={`/servicios/${cat.slug}`} class="svc-hub-lane" style={`--lane-bg: ${cat.heroBg};`}>
              <div class="svc-hub-lane-index">{String(index + 1).padStart(2, '0')}</div>
              <div class="svc-hub-lane-icon">
                <i class={`fa-solid ${cat.icon}`} aria-hidden="true"></i>
              </div>
              <div class="svc-hub-lane-main">
                <h3>{cat.title}</h3>
                <p>{cat.blurb}</p>
                <div class="svc-hub-service-preview">
                  {cat.services.slice(0, 4).map((service) => (
                    <span>{service.label}</span>
                  ))}
                </div>
              </div>
              <div class="svc-hub-lane-meta">
                <strong>{cat.services.length}</strong>
                <span>servicios</span>
                <i class="fa-solid fa-arrow-right"></i>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="svc-hub-flow" aria-labelledby="flujo-title">
        <div class="svc-hub-section-head compact">
          <span>Proceso claro</span>
          <h2 id="flujo-title">Si no sabes qué servicio elegir, lo aterrizamos contigo</h2>
        </div>
        <div class="svc-hub-flow-grid">
          <div class="svc-hub-flow-step">
            <i class="fa-solid fa-laptop-medical"></i>
            <strong>1. Identificamos el equipo</strong>
            <p>Laptop, PC, consola, celular o impresora. Revisamos marca, modelo y síntoma principal.</p>
          </div>
          <div class="svc-hub-flow-step">
            <i class="fa-solid fa-stethoscope"></i>
            <strong>2. Confirmamos la falla</strong>
            <p>No cotizamos a ciegas: validamos si es pieza, software, temperatura, carga, pantalla o placa.</p>
          </div>
          <div class="svc-hub-flow-step">
            <i class="fa-solid fa-clipboard-check"></i>
            <strong>3. Te damos ruta de servicio</strong>
            <p>Recibes diagnóstico, opciones, tiempo estimado y garantía antes de aprobar cualquier trabajo.</p>
          </div>
        </div>
      </section>
    </div>
  </section>

  <CommentsSection viewMoreHref="/comentarios" />

  <Footer />

  <style is:global>
    .svc-hub {
      position: relative;
      padding: 54px 0 70px;
      background: linear-gradient(180deg, #ffffff 0%, #f8fafc 56%, #eef4ff 100%);
      color: #0f2a4a;
      overflow: hidden;
      isolation: isolate;
    }
    .svc-hub-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(90deg, rgba(37, 99, 235, 0.06) 1px, transparent 1px),
        linear-gradient(180deg, rgba(37, 99, 235, 0.05) 1px, transparent 1px);
      background-size: 42px 42px;
      mask-image: linear-gradient(180deg, #000 0%, transparent 78%);
      opacity: .9;
    }
    .svc-hub-inner {
      position: relative;
      z-index: 1;
    }

    .svc-hub-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(320px, .85fr);
      gap: 34px;
      align-items: stretch;
      margin-bottom: 24px;
    }
    .svc-hub-copy {
      min-height: 360px;
      padding: 44px;
      border: 1px solid #dbe7f7;
      border-radius: 22px;
      background:
        radial-gradient(circle at 92% 12%, rgba(59, 130, 246, .14), transparent 34%),
        #ffffff;
      box-shadow: 0 18px 50px rgba(15, 42, 74, .08);
    }
    .svc-hub-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: .78rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .14em;
      color: #1d4ed8;
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      padding: 7px 14px;
      border-radius: 999px;
      margin-bottom: 20px;
    }
    .svc-hub-copy h1 {
      font-family: var(--font-heading, 'Kanit', sans-serif);
      font-size: clamp(2.2rem, 5vw, 4.2rem);
      font-weight: 800;
      color: #0b1f3a;
      line-height: .98;
      margin: 0 0 16px;
      letter-spacing: 0;
    }
    .svc-hub-copy h1 span {
      color: #1d4ed8;
    }
    .svc-hub-copy p {
      font-size: 1.05rem;
      line-height: 1.6;
      color: #425b78;
      margin: 0 0 24px;
      max-width: 660px;
    }
    .svc-hub-copy strong {
      color: #0f2a4a;
      font-weight: 700;
    }
    .svc-hub-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }
    .svc-hub-btn-primary,
    .svc-hub-btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      min-height: 44px;
      padding: 12px 18px;
      border-radius: 12px;
      font-weight: 800;
      text-decoration: none;
      transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }
    .svc-hub-btn-primary {
      background: #1d4ed8;
      color: #ffffff;
      box-shadow: 0 14px 30px rgba(29, 78, 216, .24);
    }
    .svc-hub-btn-secondary {
      color: #0f2a4a;
      background: #ffffff;
      border: 1px solid #cbdff6;
    }
    .svc-hub-btn-primary:hover,
    .svc-hub-btn-secondary:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 30px rgba(15, 42, 74, .14);
    }

    .svc-hub-map {
      border-radius: 22px;
      overflow: hidden;
      border: 1px solid #cbdff6;
      background: #0f2a4a;
      color: #ffffff;
      box-shadow: 0 18px 50px rgba(15, 42, 74, .16);
    }
    .svc-hub-map-top {
      min-height: 210px;
      padding: 30px;
      display: grid;
      align-content: end;
      background:
        radial-gradient(circle at 80% 16%, rgba(96, 165, 250, .45), transparent 30%),
        linear-gradient(135deg, #0f2a4a 0%, #1d4ed8 100%);
    }
    .svc-hub-map-top span {
      color: #bfdbfe;
      font-size: .78rem;
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .svc-hub-map-top strong {
      font-family: var(--font-heading, 'Kanit', sans-serif);
      font-size: 5rem;
      line-height: .9;
      margin-top: 12px;
    }
    .svc-hub-map-top small {
      color: #dbeafe;
      font-size: 1rem;
    }
    .svc-hub-map-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      border-top: 1px solid rgba(255,255,255,.12);
    }
    .svc-hub-map-grid div {
      padding: 18px;
      border-right: 1px solid rgba(255,255,255,.1);
      border-bottom: 1px solid rgba(255,255,255,.1);
    }
    .svc-hub-map-grid strong,
    .svc-hub-map-grid span {
      display: block;
    }
    .svc-hub-map-grid strong {
      font-size: 1.08rem;
      color: #ffffff;
    }
    .svc-hub-map-grid span {
      color: #bfdbfe;
      font-size: .8rem;
      margin-top: 3px;
    }

    .svc-hub-priority {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 14px 16px;
      margin-bottom: 36px;
      border-radius: 16px;
      background: #ffffff;
      border: 1px solid #dbe7f7;
      box-shadow: 0 12px 36px rgba(15, 42, 74, .06);
    }
    .svc-hub-priority-label {
      color: #0f2a4a;
      font-weight: 900;
      white-space: nowrap;
      font-size: .88rem;
    }
    .svc-hub-priority-links {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
    }
    .svc-hub-priority-links a {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 11px;
      border-radius: 999px;
      background: #f8fafc;
      color: #1e3a8a;
      border: 1px solid #dbe7f7;
      text-decoration: none;
      font-size: .84rem;
      font-weight: 800;
    }
    .svc-hub-priority-links a:hover {
      background: #eff6ff;
      border-color: #bfdbfe;
    }

    .svc-hub-categories,
    .svc-hub-flow {
      margin-top: 34px;
    }
    .svc-hub-section-head {
      max-width: 760px;
      margin-bottom: 22px;
    }
    .svc-hub-section-head.compact {
      max-width: 680px;
    }
    .svc-hub-section-head span {
      color: #1d4ed8;
      font-size: .78rem;
      font-weight: 900;
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .svc-hub-section-head h2 {
      color: #0f2a4a;
      font-family: var(--font-heading, 'Kanit', sans-serif);
      font-size: clamp(1.55rem, 3vw, 2.35rem);
      line-height: 1.12;
      margin: 8px 0 10px;
      letter-spacing: 0;
    }
    .svc-hub-section-head p {
      color: #536b87;
      line-height: 1.6;
      margin: 0;
    }

    .svc-hub-lanes {
      display: grid;
      gap: 12px;
    }
    .svc-hub-lane {
      display: grid;
      grid-template-columns: 48px 64px minmax(0, 1fr) 120px;
      gap: 18px;
      align-items: center;
      padding: 18px;
      min-height: 118px;
      border-radius: 18px;
      background: #ffffff;
      border: 1px solid #dbe7f7;
      text-decoration: none;
      box-shadow: 0 10px 28px rgba(15, 42, 74, .055);
      transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }
    .svc-hub-lane:hover {
      transform: translateX(4px);
      border-color: #93c5fd;
      box-shadow: 0 18px 42px rgba(15, 42, 74, .11);
    }
    .svc-hub-lane-index {
      color: #93a8c2;
      font-weight: 900;
      font-size: .9rem;
    }
    .svc-hub-lane-icon {
      width: 58px;
      height: 58px;
      border-radius: 16px;
      background: var(--lane-bg);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.35rem;
      box-shadow: 0 14px 26px rgba(29, 78, 216, .18);
    }
    .svc-hub-lane-main h3 {
      color: #0f2a4a;
      font-size: 1.28rem;
      margin: 0;
      font-weight: 900;
    }
    .svc-hub-lane-main p {
      color: #536b87;
      margin: 3px 0 10px;
      line-height: 1.45;
    }
    .svc-hub-service-preview {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
    }
    .svc-hub-service-preview span {
      color: #1e3a8a;
      background: #eff6ff;
      border: 1px solid #dbeafe;
      font-size: .74rem;
      font-weight: 800;
      padding: 4px 10px;
      border-radius: 999px;
    }
    .svc-hub-lane-meta {
      justify-self: end;
      min-width: 108px;
      text-align: right;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 2px;
      color: #1d4ed8;
    }
    .svc-hub-lane-meta strong {
      font-size: 1.55rem;
      line-height: 1;
      color: #0f2a4a;
    }
    .svc-hub-lane-meta span {
      color: #64748b;
      font-size: .78rem;
      font-weight: 800;
    }
    .svc-hub-lane-meta i {
      margin-top: 8px;
      color: #1d4ed8;
    }

    .svc-hub-flow {
      padding: 28px;
      border-radius: 22px;
      background: linear-gradient(135deg, #f6f9fe 0%, #eaf2ff 100%);
      color: #0f2a4a;
      border: 1px solid #cbdff6;
      box-shadow: 0 18px 48px rgba(15, 42, 74, .11);
    }
    .svc-hub-flow .svc-hub-section-head span,
    .svc-hub-flow .svc-hub-section-head h2 {
      color: #0f2a4a;
    }
    .svc-hub-flow .svc-hub-section-head span {
      color: #1d4ed8;
    }
    .svc-hub-flow-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
    .svc-hub-flow-step {
      padding: 18px;
      border-radius: 16px;
      background: #f8fbff;
      border: 1px solid #dbe7f7;
    }
    .svc-hub-flow-step i {
      color: #1d4ed8;
      font-size: 1.35rem;
      margin-bottom: 12px;
    }
    .svc-hub-flow-step strong {
      display: block;
      color: #0f2a4a;
      margin-bottom: 8px;
    }
    .svc-hub-flow-step p {
      color: #425b78;
      margin: 0;
      font-size: .9rem;
      line-height: 1.55;
    }

    @media (max-width: 768px) {
      .svc-hub {
        padding: 36px 0 50px;
      }
      .svc-hub-hero {
        grid-template-columns: 1fr;
      }
      .svc-hub-copy {
        min-height: auto;
        padding: 26px;
      }
      .svc-hub-map-top {
        min-height: 160px;
      }
      .svc-hub-map-top strong {
        font-size: 4rem;
      }
      .svc-hub-priority {
        align-items: flex-start;
        flex-direction: column;
      }
      .svc-hub-lane {
        grid-template-columns: 42px 1fr;
        gap: 12px;
      }
      .svc-hub-lane-index {
        grid-column: 1;
      }
      .svc-hub-lane-icon {
        grid-column: 1;
        width: 50px;
        height: 50px;
      }
      .svc-hub-lane-main {
        grid-column: 2;
        grid-row: 1 / span 2;
      }
      .svc-hub-lane-meta {
        grid-column: 1 / -1;
        justify-self: stretch;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        text-align: left;
        min-width: 0;
        padding-top: 12px;
        border-top: 1px solid #e2e8f0;
      }
      .svc-hub-flow {
        padding: 22px;
      }
      .svc-hub-flow-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Base>
