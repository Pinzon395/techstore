  <script is:inline>
    (() => {
      if (window.location.pathname !== '/servicios/laptop/cambio-pantalla') return;

        const baseUrl = window.location.pathname + window.location.search;
        const removeProcesoHash = () => {
          if (window.location.hash !== '#proceso') return;
          history.replaceState(null, '', baseUrl);
          window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
        };

        removeProcesoHash();

        window.addEventListener('load', () => {
          const navigationEntry = performance.getEntriesByType('navigation')[0];
          if (!navigationEntry || navigationEntry.type === 'reload') {
            removeProcesoHash();
          }
        });

        document.querySelectorAll('[data-screen-scroll="proceso"]').forEach((button) => {
          button.addEventListener('click', (event) => {
            event.preventDefault();
            const target = document.getElementById('proceso');
            if (!target) return;

            const navbarOffset = 96;
            const targetTop = target.getBoundingClientRect().top + window.scrollY - navbarOffset;
            window.scrollTo({ top: targetTop, behavior: 'smooth' });
            history.replaceState(null, '', baseUrl);
          });
        });

        document.querySelectorAll('[data-related-toggle]').forEach((button) => {
          button.addEventListener('click', () => {
            const section = button.closest('.svc-related');
            const label = button.querySelector('[data-related-toggle-text]');
            if (!section || !label) return;

            const isExpanded = section.classList.toggle('is-expanded');
            button.setAttribute('aria-expanded', String(isExpanded));
            label.textContent = isExpanded ? 'Ver menos servicios' : 'Ver más servicios';
          });
        });
    })();
  </script>

