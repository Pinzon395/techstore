---
import Base from '../../../layouts/Base.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FaqSection from '../../../components/FaqSection.astro';
import CommentsSection from '../../../components/CommentsSection.astro';
import ContactSection from '../../../components/ContactSection.astro';
import RelatedServicesSection from '../../../components/RelatedServicesSection.astro';
import ServiceTicketSection from '../../../components/ServiceTicketSection.astro';
import { SERVICE_ROUTES } from '../../../data/services';
import { getServiceFlags } from '../../../lib/service-page-rules';
import { resolveServiceView } from '../../../lib/service-view-registry';
import { getServiceSeoMeta } from '../../../lib/service-seo';
import { buildBreadcrumbSchema, buildFAQSchema, buildServiceSchema } from '../../../lib/schema';

export function getStaticPaths() {
  return SERVICE_ROUTES
    // Esta intención comercial tiene una landing pilar propia. La URL
    // histórica se atiende con una redirección permanente, no con una segunda
    // página indexable que compita por las mismas búsquedas.
    .filter(({ params }) => !(params.categoria === 'pc' && params.servicio === 'mantenimiento-preventivo'))
    .map(({ params, props }) => ({ params, props }));
}

const { category, service } = Astro.props;

const canonical = `https://pixon.com.mx/servicios/${category.slug}/${service.slug}`;
const serviceFlags = getServiceFlags(category, service);
const {
  isLaptopScreenReplacement,
  isLaptopKeyboardReplacement,
  isLaptopThermalPaste,
  isLaptopPreventiveMaintenance,
  isLaptopDiagnostic,
  isLenovoLaptopRepair,
  isHpLaptopRepair,
  isDellLaptopRepair,
  isLaptopDataRecovery,
  isPcUpgrade,
  isPcFormat,
  isPcDiagnostic,
  isPcBlueScreen,
  isPcLentitud,
  isPcDataRecovery,
  isPcVirusMalware,
  isPcInstallComponents,
  isPcPreventiveMaintenance,
  isPcCorrectiveMaintenance,
  isPcDeepCleaning,
  isPcNoEnciende,
  isPcPowerSupply,
  isPcGpu,
  isPrinterService,
  isPrinterMaintenance,
  isPrinterInkToner,
  isPrinterDiagnostic,
  isPrinterConnectivity,
  isPrinterRollers,
  isPrinterJams,
  isConsoleCleaning,
  isConsoleThermalPaste,
  isConsolePowerSupply,
  isConsoleHdmi,
  isConsoleOverheating,
  isConsolePreventiveMaintenance,
  isPs5LiquidMetalCleaning,
  isPs5Shutdown,
  isMacbookPreventiveMaintenance,
  isMacBookLiquidDamage,
  isMacBookBatteryReplacement,
  isMacSoftware,
  isImacMacMiniRepair,
  isHotelSupport,
  isB2bOfficeSupport,
  isB2bWifiEmpresarial,
  isPhoneSpeakerRepair,
  isPhoneScreenReplacement,
  isPhoneSoftwareUnlock,
  isPhoneFlexButtons,
  isPhoneDiagnostic,
  isPhoneNoPower,
  isIphoneService,
  isIphoneScreenRepair,
  isIphoneBatteryReplacement,
  isSamsungBatteryReplacement,
  isIphoneCameraRepair,
  isIphoneFaceIdRepair,
  isIphoneHumidityRepair,
  isIphoneChargeRepair,
  isIphoneSpeakerRepair,
  isIphoneDiagnostic,
  isIphoneButtonsRepair,
  isIphoneMicrophoneRepair,
  isLaptopLocalReplacement,
  usesLegacyInlineServiceView,
  useServiceDetailView,
  usesLegacyServiceStyles,
} = serviceFlags;
const CustomView = await resolveServiceView(serviceFlags, category, service);
// SEO LOCAL H1 / TITLE
const {
  seoKeyword,
  finalSeoTitle,
  finalDescription,
  faqServiceContext,
  genericFaqTitle,
  waMessage,
  hook,
} = getServiceSeoMeta(category, service, serviceFlags);
// FAQ items con SEO local
const faqItems = [
  { question: `¿Cuánto tiempo toma este servicio en Cancún?`, answer: `El tiempo depende del tipo de intervención, disponibilidad de refacciones y gravedad de la falla. En servicios simples puede resolverse el mismo día; en reparaciones con piezas o pruebas extendidas puede tomar de 24 a 72 horas. Siempre te damos tiempo estimado antes de iniciar.` },
  { question: `¿Mi equipo está seguro durante la reparación?`, answer: `Sí. Trabajamos con área antiestática, herramienta adecuada y revisión documentada del estado del equipo. No borramos información ni cambiamos piezas sin autorización. Si el servicio implica riesgo para datos o componentes, te lo explicamos antes de continuar.` },
  { question: `¿Ofrecen garantía por escrito?`, answer: `Sí, entregamos garantía por escrito según el tipo de servicio y pieza instalada. La garantía cubre la intervención realizada bajo uso normal, pero no aplica por golpes, humedad, manipulación externa, variaciones eléctricas o fallas en piezas no intervenidas.` },
  { question: `¿Qué marcas atienden en Cancún?`, answer: `Trabajamos con marcas comunes como HP, Dell, Lenovo, Asus, Acer, MSI, Apple, PlayStation, Xbox, Nintendo, Epson, Canon, Brother y equipos ensamblados. La compatibilidad final se confirma por modelo, síntoma y disponibilidad de refacciones.` },
  { question: `¿Tienen servicio a domicilio o debo llevar el equipo?`, answer: `Contamos con taller físico en Cancún para diagnósticos y reparaciones que requieren herramienta especializada. En algunos casos podemos coordinar recolección, entrega o visita según zona, disponibilidad y tipo de equipo. Te orientamos por WhatsApp antes de moverlo.` },
];

const phoneSpeakerFaqs = [
  { question: '¿Cuánto cuesta reparar la bocina de un celular en Cancún?', answer: 'La reparación de bocina de celular inicia desde $400 MXN, pero el costo final depende del modelo, disponibilidad de refacción y si la falla viene de bocina, auricular, flex, micrófono, humedad o rejilla obstruida. Primero revisamos el síntoma para evitar cambiar piezas innecesarias.' },
  { question: '¿Cómo sé si falla la bocina, el auricular o el micrófono?', answer: 'Si no suena música, videos o timbre, normalmente revisamos la bocina principal. Si no escuchas llamadas, revisamos el auricular superior. Si la otra persona no te escucha, puede ser micrófono, flex o software; por eso hacemos pruebas de llamada, grabación y multimedia antes de cotizar.' },
  { question: '¿Se puede limpiar la bocina sin cambiar la pieza?', answer: 'Sí, en algunos equipos el problema es polvo, pelusa, humedad o residuos en la rejilla. Cuando la bocina está físicamente dañada, distorsiona o perdió volumen por desgaste, sí puede requerir reemplazo. Te decimos cuál caso aplica después del diagnóstico.' },
  { question: '¿Qué pasa si el celular se mojó y dejó de escucharse?', answer: 'Cuando hay contacto con líquido, no conviene cambiar la bocina sin revisar humedad, corrosión, flex y conectores. El audio puede fallar por sulfato o daño en placa, así que primero se revisa para evitar que la falla regrese con una pieza nueva.' },
  { question: '¿Cuánto tarda la reparación de audio del celular?', answer: 'En muchos modelos puede quedar en 24 a 48 horas, dependiendo de la refacción, carga de trabajo y nivel de daño. Si requiere limpieza por humedad, prueba extendida o pieza especial, te confirmamos el tiempo real antes de iniciar.' },
  { question: '¿La reparación de bocina tiene garantía?', answer: 'Sí, entregamos garantía por escrito sobre la pieza o intervención realizada. La garantía aplica bajo uso normal y no cubre nuevos golpes, humedad posterior, manipulación externa o daños en componentes no intervenidos.' },
];

const phoneScreenFaqs = [
  { question: '¿Cuánto cuesta cambiar la pantalla de un celular en Cancún?', answer: 'El cambio de pantalla inicia desde $1,200 MXN, pero el precio final depende del modelo, tipo de pantalla, calidad disponible y si también hay daño en marco, touch, display o humedad. Antes de instalar confirmamos compatibilidad y te explicamos opciones de calidad.' },
  { question: '¿Cambian pantalla de iPhone, Samsung, Xiaomi y Motorola?', answer: 'Sí, atendemos iPhone, Samsung, Xiaomi, Motorola, Oppo, Huawei, Honor, Realme y más marcas. Cada modelo usa diferente tipo de panel, adhesivo y flex, por eso revisamos modelo exacto y disponibilidad antes de cotizar.' },
  { question: '¿Cómo sé si falló el display o solo el cristal?', answer: 'Si hay líneas, manchas, pantalla negra, parpadeos o zonas sin touch, puede estar dañado el display completo. Si solo está estrellado pero imagen y touch funcionan, revisamos si existe opción viable; en muchos modelos conviene cambiar módulo completo para asegurar resultado.' },
  { question: '¿La pantalla queda con buen brillo y touch?', answer: 'Probamos brillo, colores, sensibilidad táctil, proximidad, cámara frontal y llamadas antes de entregar. También te explicamos si la pieza es original, OLED, LCD, Incell u otra calidad disponible para tu modelo.' },
  { question: '¿Qué pasa si el celular se mojó o se golpeó fuerte?', answer: 'Cuando hay líquido o golpe fuerte no conviene cambiar pantalla sin revisar conectores, placa, marco y flex. Si hay humedad o daño interno, te avisamos antes porque una pantalla nueva puede fallar si el problema real está en otro componente.' },
  { question: '¿La reparación tiene garantía?', answer: 'Sí, entregamos garantía por escrito sobre la pantalla instalada y mano de obra. No cubre nuevos golpes, presión, humedad posterior, manipulación externa o daño físico después de la entrega.' },
];

const phoneSoftwareFaqs = [
  { question: '¿Cuánto cuesta liberar o reparar el software de un celular en Cancún?', answer: 'El servicio inicia desde $650 MXN, pero el precio depende del modelo, compañía, versión de Android o iOS, tipo de bloqueo y método disponible. Antes de trabajar revisamos IMEI, estado del equipo, cuenta, respaldo posible y viabilidad para darte una cotización clara.' },
  { question: '¿La liberación de red se pierde si actualizo el celular?', answer: 'Cuando la liberación es permanente por IMEI o servidor compatible, normalmente puedes actualizar sin perder señal. Si el método depende de software, parche o versión específica, te lo explicamos antes para que sepas qué puede pasar con futuras actualizaciones.' },
  { question: '¿Pueden quitar cuenta Google FRP o bloqueo de software?', answer: 'Podemos revisar casos legítimos de FRP, restauración, bootloop, errores de sistema y configuración. No trabajamos equipos reportados, robados o con restricciones legales; primero validamos estatus y te explicamos opciones permitidas para tu caso.' },
  { question: '¿Se borran mis fotos, chats o archivos?', answer: 'Depende del trabajo. Una liberación de red normalmente no borra datos, pero flasheo, restauración profunda, FRP o desbloqueo por sistema puede requerir formateo. Si el equipo permite acceso, recomendamos respaldo antes de iniciar y te avisamos el riesgo real.' },
  { question: '¿Cuánto tarda una reparación de software de celular?', answer: 'Muchas revisiones de software quedan de 1 a 3 horas, pero liberaciones por servidor, códigos o modelos especiales pueden tardar más. Si el equipo está en bootloop, tiene firmware dañado o requiere descarga de sistema completo, te damos tiempo estimado antes de continuar.' },
  { question: '¿Qué marcas atienden para liberación y software?', answer: 'Revisamos iPhone, Samsung, Motorola, Xiaomi, Huawei, Oppo, Honor, Realme, ZTE y otras marcas según modelo. La compatibilidad depende de versión, parche de seguridad, compañía original, región e historial del equipo.' },
];

const phoneFlexFaqs = [
  { question: '¿Cuánto cuesta cambiar el flex o botones de un celular en Cancún?', answer: 'El servicio inicia desde $450 MXN, pero el precio final depende del modelo, tipo de flex, disponibilidad de refacción y si la falla viene del botón, carcasa, humedad o placa. Primero revisamos el equipo para confirmar si conviene limpieza, ajuste o reemplazo.' },
  { question: '¿Qué botones pueden reparar o cambiar?', answer: 'Revisamos botón power, volumen, mute, home, botones laterales, flex de encendido, flex de volumen y sensores relacionados según el modelo. También validamos si el botón está hundido, duro, falso contacto o si dejó de responder después de un golpe.' },
  { question: '¿Siempre se tiene que cambiar el flex completo?', answer: 'No siempre. Algunas fallas vienen de suciedad, carcasa deformada, humedad, presión del marco o mal ensamble previo. Si el flex está roto, sulfatado o con pistas dañadas, sí recomendamos reemplazo para evitar fallas intermitentes.' },
  { question: '¿Qué pasa si el botón falló después de mojarse?', answer: 'Cuando hubo líquido o humedad, revisamos corrosión, conectores, flex y placa antes de instalar una pieza nueva. Cambiar solo el botón sin atender sulfato puede hacer que la falla regrese o que otro componente deje de responder.' },
  { question: '¿Cuánto tarda la reparación de botones?', answer: 'En modelos comunes puede tomar de 24 a 48 horas, según disponibilidad de pieza y carga de trabajo. Si el equipo requiere desarmado profundo, limpieza por humedad o refacción especial, te confirmamos el tiempo antes de iniciar.' },
  { question: '¿La reparación tiene garantía?', answer: 'Sí, entregamos garantía por escrito sobre la intervención realizada y la pieza instalada cuando aplica. La garantía no cubre golpes nuevos, humedad posterior, carcasa deformada por caída o manipulación externa después de la entrega.' },
];

const printerDiagnosticFaqs = [
  { question: `¿Qué incluye el diagnóstico de impresora en Cancún?`, answer: `Revisamos calidad de impresión, bandejas, rodillos, cabezales, cartuchos, tóner, sensores, conexión USB/WiFi, drivers y mensajes de error. El objetivo es identificar la causa real antes de cotizar, porque una impresora que no imprime no siempre necesita tinta.` },
  { question: `?Si mi impresora no imprime siempre necesita tinta o tóner?`, answer: `No necesariamente. Puede ser cola de impresión, driver dañado, cabezal tapado, cartucho no reconocido, chip, rodillos, conexión de red o error interno. Primero hacemos pruebas para evitar que compres insumos que no resolver?n la falla.` },
  { question: `¿Atienden impresoras HP, Epson, Canon y Brother?`, answer: `Sí. Revisamos HP, Epson, Canon, Brother, Samsung, Xerox, Lexmark, Ricoh, Kyocera, Pantum y multifuncionales comunes. También atendemos impresoras de casa, escuela, oficina y negocios en Cancún con alto volumen de impresión.` },
  { question: `¿Pueden revisar impresoras con atascos de papel?`, answer: `Sí. Revisamos ruta de papel, rodillos, sensores, bandejas, restos de papel y separación de hojas. Si requiere limpieza, ajuste o refacción, te lo explicamos antes de avanzar para evitar que el atasco vuelva a repetirse.` },
  { question: `¿También diagnostican impresoras para oficina o empresa?`, answer: `Sí. Podemos revisar equipos de alto uso, multifuncionales y flotillas pequeñas para negocios que necesitan impresión estable. También orientamos sobre mantenimiento preventivo, insumos adecuados y fallas repetidas por volumen de trabajo.` },
  { question: `¿Cuánto tarda el diagnóstico?`, answer: `Normalmente se revisa el mismo día o dentro de 24 horas, según carga de trabajo, tipo de impresora y complejidad de la falla. Si hay que hacer pruebas de red, cabezal, sensores o alimentaci?n de papel, te avisamos por WhatsApp antes de reparar.` },
];

const printerMaintenanceFaqs = [
  { question: `¿Cuánto cuesta el mantenimiento de impresora en Cancún?`, answer: `El mantenimiento de impresora inicia desde <strong>$750 MXN</strong>. El precio puede variar si el equipo requiere refacciones, cambio de rodillos, limpieza interna profunda, cabezal especial, tóner derramado o pruebas adicionales por alto volumen de impresión.` },
  { question: `¿Qué incluye el mantenimiento de una impresora?`, answer: `Incluye revisión de bandeja, ruta de papel, rodillos, cabezales, cartuchos, tinta o tóner, sensores visibles y prueba de impresión. También te indicamos si la falla requiere diagnóstico adicional, refacción o ajuste específico.` },
  { question: `¿Cada cuánto conviene dar mantenimiento a una impresora?`, answer: `Para uso de casa puede ser cada 6 a 12 meses. En oficina o negocio, donde se imprime diario, conviene revisar con más frecuencia para evitar atascos, manchas, hojas dobles y desgaste de rodillos.` },
  { question: `¿El mantenimiento corrige impresiones con rayas o manchas?`, answer: `Puede ayudar si el problema viene de suciedad, cabezal parcialmente tapado, tinta seca, tóner derramado o residuos internos. Si el cartucho, cabezal o fusor está dañado, te lo explicamos antes de cotizar pieza.` },
  { question: `¿Atienden impresoras HP, Epson, Canon y Brother?`, answer: `Sí. Atendemos HP, Epson, Canon, Brother y otras marcas comunes de casa, escuela, oficina y negocio en Cancún. El procedimiento depende del modelo, tipo de tinta, tóner, sistema continuo o multifuncional.` },
  { question: `¿Cuánto tarda el mantenimiento de impresora?`, answer: `Normalmente toma de 24 a 48 horas según carga de trabajo, modelo, nivel de suciedad y pruebas necesarias. Si requiere refacción o limpieza más profunda, te avisamos antes de continuar.` },
];

