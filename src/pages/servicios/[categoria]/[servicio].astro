---
import Base from '../../../layouts/Base.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CommentsSection from '../../../components/CommentsSection.astro';
import ContactSection from '../../../components/ContactSection.astro';
import MantenimientoTermicoView from '../../../components/views/MantenimientoTermicoView.astro';
import CambioBateriaView from '../../../components/views/CambioBateriaView.astro';
import { SERVICE_CATEGORIES } from '../../../data/services';

export function getStaticPaths() {
  const paths: any[] = [];
  for (const category of SERVICE_CATEGORIES) {
    for (const service of category.services) {
      if (service.customUrl) continue;
      paths.push({
        params: { categoria: category.slug, servicio: service.slug },
        props:  { category, service },
      });
    }
  }
  return paths;
}

const { category, service } = Astro.props;

const canonical = `https://pixon.com.mx/servicios/${category.slug}/${service.slug}`;
// SEO LOCAL H1 / TITLE
const seoKeyword = service.seoKeyword || service.label;
const seoTitle = `${seoKeyword} para ${category.title} en Cancún | Pixon PC`;
const description = service.intro
  ? `${service.intro} Cotización gratis y reparación profesional en Cancún.`
  : `Servicio especializado de ${service.label} para ${category.title} en Cancún. Diagnóstico profundo y garantía por escrito.`;

const waMessage = encodeURIComponent(`Hola, necesito el servicio de ${service.label} para mi ${category.title}. ¿Me podrían cotizar?`);

// Hooks y Bullets
const hook = service.hook || `Evita fallas costosas y recupera el rendimiento de tu ${category.title}`;

// FAQ items con SEO local
const faqItems = [
  {
    question: `¿Cuánto tiempo toma el ${service.label.toLowerCase()} en Cancún?`,
    answer: `El ${service.label.toLowerCase()} para ${category.title} normalmente toma entre 1 y 3 días hábiles dependiendo de la severidad del daño y disponibilidad de refacciones en Cancún. Te avisamos en tiempo real.`,
  },
  {
    question: `¿Mi equipo está seguro durante el ${service.label.toLowerCase()}?`,
    answer: `Sí. Trabajamos en un área antiestática certificada. Tus datos y componentes están protegidos durante todo el proceso. No desinstalamos ni borramos información personal.`,
  },
  {
    question: `¿Ofrecen garantía en el ${service.label.toLowerCase()}?`,
    answer: `Sí, ofrecemos garantía por escrito en todos nuestros servicios. El tiempo varía según el tipo de intervención, pero mínimo 30 días en mano de obra.`,
  },
  {
    question: `¿Qué marcas de ${category.title} manejan en Cancún?`,
    answer: `Trabajamos con todas las marcas principales: Apple, Dell, HP, Asus ROG, Lenovo Legion, MSI, Acer, Alienware y equipos ensamblados a medida. Sin importar la marca, tenemos la capacidad técnica.`,
  },
  {
    question: '¿Tienen servicio a domicilio o tienen que llevar el equipo?',
    answer: 'Contamos con taller físico en Cancún donde atendemos diagnósticos presenciales. Para ciertos servicios también podemos coordinar recogida. Contáctanos por WhatsApp para más detalles.',
  },
];
---

<Base title={seoTitle} description={description} canonical={canonical}>
  <!-- CRITICAL: Forzar fondo oscuro antes que cualquier CSS global -->
  <style is:global>
    body { background-color: #0B1120 !important; color: #E2E8F0 !important; }
    .ux-hero, .ux-benefits, .ux-process, .ux-cta-band {
      background-color: #0B1120 !important;
    }
    .ux-symptoms, .ux-brands {
      background-color: #0F172A !important;
    }
    /* Override cualquier background blanco que venga del layout base */
    main, .main-content, #main, .page-wrapper { background-color: #0B1120 !important; }
  </style>
  <Navbar />

  <Breadcrumb items={[
    { label: 'Inicio',         href: '/' },
    { label: 'Servicios',      href: '/servicios' },
    { label: category.title,   href: `/servicios/${category.slug}` },
    { label: service.label },
  ]} />

  {service.slug === 'ventilacion' ? (
    <MantenimientoTermicoView service={service} category={category} />
  ) : service.slug === 'cambio-bateria' ? (
    <CambioBateriaView service={service} category={category} />
  ) : (
    <div class="theme-premium-dark">
      <!-- 1. HERO SECTION (Dark Premium) -->
    <section class="ux-hero">
      <div class="ux-glow-hero"></div>
      <div class="container ux-hero-inner">
        <div class="ux-hero-content">
          <span class="ux-badge"><i class={`fa-solid ${category.icon}`}></i> Especialistas en {category.title} en Cancún</span>
          
          <h1 class="ux-h1">
            {seoKeyword} <br>
            <span class="ux-gradient-text">Profesional</span>
          </h1>
          
          <h2 class="ux-hero-hook">{hook}</h2>
          
          <p class="ux-hero-desc">
            {service.intro || `Solucionamos problemas de ${service.label.toLowerCase()} de forma definitiva. Trabajamos con equipo especializado y refacciones certificadas en Cancún.`}
          </p>

          <div class="ux-trust-bar">
            <div class="trust-item"><i class="fa-solid fa-star"></i> 5.0 en Google Maps</div>
            <div class="trust-item"><i class="fa-solid fa-shield-halved"></i> Garantía por escrito</div>
            <div class="trust-item"><i class="fa-solid fa-stopwatch"></i> {service.eta || 'Atención rápida'}</div>
          </div>

          <div class="ux-hero-ctas">
            <a href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank" class="ux-btn-primary pulse">
              <i class="fa-brands fa-whatsapp"></i> Cotizar Servicio
            </a>
            <a href="#proceso" class="ux-btn-secondary">
              Ver Proceso <i class="fa-solid fa-arrow-down"></i>
            </a>
          </div>
        </div>
        
        <div class="ux-hero-visual">
          <div class="ux-glass-panel">
            <div class="glass-header">
              <i class="fa-solid fa-clipboard-list"></i>
              <span>¿Qué Incluye?</span>
            </div>
            <ul class="ux-check-list">
              {service.bullets && service.bullets.length > 0 ? (
                service.bullets.map((b: string) => (
                  <li><i class="fa-solid fa-circle-check"></i> <span>{b}</span></li>
                ))
              ) : (
                <>
                  <li><i class="fa-solid fa-circle-check"></i> <span>Diagnóstico físico y por software</span></li>
                  <li><i class="fa-solid fa-circle-check"></i> <span>Uso de herramientas antiestáticas</span></li>
                  <li><i class="fa-solid fa-circle-check"></i> <span>Componentes de alta calidad</span></li>
                  <li><i class="fa-solid fa-circle-check"></i> <span>Pruebas de rendimiento post-servicio</span></li>
                </>
              )}
            </ul>
            <div class="glass-price">
              <span>Inversión desde:</span>
              <strong>{service.fromPrice || 'Previa Revisión'}</strong>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 1.5 TRUST STRIP CON STATS -->
    {service.trustStats && service.trustStats.length > 0 && (
      <section class="svc-trust-strip">
        <div class="container">
          <div class="trust-stats-grid">
            {service.trustStats.map((stat) => (
              <div class="trust-stat-item">
                <div class="trust-stat-icon"><i class={`fa-solid ${stat.icon}`}></i></div>
                <div class="trust-stat-value">{stat.value}</div>
                <div class="trust-stat-label">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 1.6 ESPECIALISTAS (Patrón Reparaciones) -->
    {service.specialistTitle && (
      <section class="svc-specialists section-pad" style="background:#0F172A;">
        <div class="container">
          <div class="svc-specialists-inner">
            <div class="svc-specialists-text">
              <span class="ux-eyebrow"><i class="fa-solid fa-microchip"></i> Especialistas</span>
              <h2 class="ux-h2">{service.specialistTitle}</h2>
              <p>{service.specialistDesc}</p>
              <a href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank" class="ux-btn-primary">
                <i class="fa-brands fa-whatsapp"></i> Cotizar mi pantalla
              </a>
            </div>
            <div class="svc-specialists-img">
              <img src={service.specialistImage || '/assets/images/reparacion-mac-cancun.jpeg'} alt={service.specialistTitle} />
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 1.7 TIPOS DE PANTALLA (Galería con badges) -->
    {service.screenTypes && service.screenTypes.length > 0 && (
      <section class="svc-screen-types section-pad" style="background:#0B1120;">
        <div class="container">
          <div class="ux-section-header text-center">
            <span class="ux-eyebrow">Tipos de Pantalla</span>
            <h2 class="ux-h2">Trabajamos con todos los <span class="ux-text-accent">tipos de panel</span></h2>
            <p>Identificamos el modelo exacto antes de cotizar para que la pieza sea 100% compatible.</p>
          </div>
          <div class="screen-types-grid">
            {service.screenTypes.map((type) => (
              <div class="screen-type-card">
                <span class="screen-type-badge">{type.label}</span>
                <p>{type.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 1.8 ANTES / DESPUÉS (Comparativa) -->
    {service.beforeAfter && (
      <section class="svc-before-after section-pad" style="background:#0F172A;">
        <div class="container">
          <div class="ux-section-header text-center">
            <span class="ux-eyebrow">Resultado real</span>
            <h2 class="ux-h2">Tu laptop antes vs. <span class="ux-text-accent">después</span></h2>
          </div>
          <div class="ba-comparison">
            <div class="ba-col ba-col--before">
              <h3><i class="fa-solid fa-circle-xmark"></i> Antes</h3>
              {service.beforeAfter.before.map((item) => (
                <div class="ba-item"><i class="fa-solid fa-xmark"></i> {item}</div>
              ))}
            </div>
            <div class="ba-col ba-col--after">
              <h3><i class="fa-solid fa-circle-check"></i> Después</h3>
              {service.beforeAfter.after.map((item) => (
                <div class="ba-item"><i class="fa-solid fa-check"></i> {item}</div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 2. SÍNTOMAS / PROBLEMAS COMUNES (Fallback) -->
    {(!service.commonProblems || service.commonProblems.length === 0) && (
      <section class="ux-symptoms">
        <div class="container">
          <div class="ux-section-header">
            <span class="ux-eyebrow">Diagnóstico Inicial</span>
            <h2 class="ux-h2">Señales de que necesitas <span class="ux-text-accent">{service.label.toLowerCase()}</span></h2>
            <p>Si tu {category.title} presenta alguno de estos síntomas, es momento de intervenir antes de que el daño sea mayor o irreversible.</p>
          </div>

          <div class="ux-grid-3">
            <div class="ux-symptom-card">
              <div class="symptom-icon"><i class="fa-solid fa-temperature-arrow-up"></i></div>
              <h3>Calentamiento Excesivo</h3>
              <p>El equipo se calienta rápido y apaga solo por protección térmica.</p>
            </div>
            <div class="ux-symptom-card">
              <div class="symptom-icon"><i class="fa-solid fa-gauge-simple-low"></i></div>
              <h3>Lentitud y Congelamientos</h3>
              <p>El sistema operativo tarda en responder o se traba constantemente.</p>
            </div>
            <div class="ux-symptom-card">
              <div class="symptom-icon"><i class="fa-solid fa-volume-high"></i></div>
              <h3>Ruidos Extraños</h3>
              <p>Los ventiladores suenan muy fuerte o hacen ruidos mecánicos.</p>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 3. POR QUÉ ELEGIRNOS (Fallback) -->
    {(!service.whyUs || service.whyUs.length === 0) && (
      <section class="ux-benefits">
        <div class="container ux-benefits-inner">
          <div class="ux-benefits-img">
            <div class="img-wrapper">
              <img src="/assets/images/reparacion-mac-cancun.jpeg" alt={`Mantenimiento de ${category.title} en Cancún`} loading="lazy" />
              <div class="ux-float-badge">
                <i class="fa-solid fa-medal"></i>
                <span>Refacciones Originales u OEM</span>
              </div>
            </div>
          </div>
          <div class="ux-benefits-text">
            <span class="ux-eyebrow">Diferenciador Pixon</span>
            <h2 class="ux-h2">No es solo reparar, es <span class="ux-text-accent">Ingeniería Aplicada</span></h2>
            <p>Un mal {service.label.toLowerCase()} puede causar cortos circuitos o dañar tu {category.title} para siempre. Nosotros aplicamos estándares técnicos rigurosos en Cancún.</p>
            
            <div class="ux-benefit-list">
              <div class="benefit-row">
                <i class="fa-solid fa-microchip"></i>
                <div>
                  <h4>Insumos Premium</h4>
                  <p>Aplicamos compuestos de alto rendimiento y metal líquido (según requiera) para garantizar temperaturas ideales.</p>
                </div>
              </div>
              <div class="benefit-row">
                <i class="fa-solid fa-hands-bubbles"></i>
                <div>
                  <h4>Limpieza Preventiva y Correctiva</h4>
                  <p>Eliminamos sulfato y polvo milimétrico sin dañar microcomponentes internos.</p>
                </div>
              </div>
              <div class="benefit-row">
                <i class="fa-solid fa-user-shield"></i>
                <div>
                  <h4>Protección de tu Información</h4>
                  <p>Tus datos son sagrados. Tu privacidad y archivos están 100% seguros y respaldados.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 4. MARCAS (Fallback) -->
    {(!service.compatibleBrands || service.compatibleBrands.length === 0) && (
      <section class="ux-brands">
        <div class="container text-center">
          <h3 class="ux-h3">Especialistas multimarcas en {category.title}</h3>
          <div class="brands-grid">
            <span>Apple / Mac</span>
            <span>Asus ROG</span>
            <span>Dell Alienware</span>
            <span>HP Omen</span>
            <span>Lenovo Legion</span>
            <span>MSI</span>
            <span>Acer</span>
            <span>Equipos Custom</span>
          </div>
        </div>
      </section>
    )}

    <!-- 5. PROCESO DE TRABAJO (Dynamic or Fallback) -->
    <section class="ux-process" id="proceso">
      <div class="container">
        <div class="ux-section-header text-center">
          <span class="ux-eyebrow">Transparencia Total</span>
          <h2 class="ux-h2">Nuestra Metodología de <span class="ux-text-accent">Trabajo</span></h2>
        </div>

        <div class="ux-timeline">
          {service.process && service.process.length > 0 ? (
            service.process.map((step: any, index: number) => (
              <div class="timeline-item">
                <div class="timeline-num">{index + 1}</div>
                <div class="timeline-content">
                  <h4>{step.title.replace(/^\d+\.\s*/, '')}</h4>
                  <p>{step.desc}</p>
                </div>
              </div>
            ))
          ) : (
            <>
              <div class="timeline-item">
                <div class="timeline-num">1</div>
                <div class="timeline-content">
                  <h4>Recepción y Análisis</h4>
                  <p>Inspeccionamos tu {category.title} para identificar el problema exacto frente a ti.</p>
                </div>
              </div>
              <div class="timeline-item">
                <div class="timeline-num">2</div>
                <div class="timeline-content">
                  <h4>Cotización Transparente</h4>
                  <p>Te explicamos qué necesita y cuánto cuesta. Sin cargos ocultos ni sorpresas.</p>
                </div>
              </div>
              <div class="timeline-item">
                <div class="timeline-num">3</div>
                <div class="timeline-content">
                  <h4>Ejecución Técnica</h4>
                  <p>Realizamos el {service.label.toLowerCase()} bajo estrictas normativas de seguridad.</p>
                </div>
              </div>
              <div class="timeline-item">
                <div class="timeline-num">4</div>
                <div class="timeline-content">
                  <h4>Pruebas de Estrés y Entrega</h4>
                  <p>Verificamos temperaturas y rendimiento antes de entregarte tu equipo funcionando al 100%.</p>
                </div>
              </div>
            </>
          )}
        </div>
      </div>
    </section>    <!-- 5.5 EDUCATIONAL BLOCKS (Opcional, Claro/Oscuro alterno) -->
    {service.educationalBlocks && service.educationalBlocks.length > 0 && service.educationalBlocks.map((block: any, index: number) => (
      <section class={`svc-educational ${index % 2 === 0 ? 'bg-light' : 'bg-dark'}`}>
        <div class={`container educational-container ${block.reverse ? 'row-reverse' : ''}`}>
          <div class="educational-text">
            <span class="ux-eyebrow" style={index % 2 === 0 ? "color:#2563EB;" : "color:#60A5FA;"}>{block.eyebrow}</span>
            <h2 class="ux-h2" style={index % 2 === 0 ? "color:#0E1629 !important;" : ""}>{block.title}</h2>
            <p class="educational-intro" style={index % 2 === 0 ? "color:#4B5563;" : ""}>{block.intro}</p>
            <div class="educational-points">
              {block.points.map((point: any) => (
                <div class="edu-point">
                  <div class="edu-icon" style={index % 2 === 0 ? "background:#DBEAFE;color:#2563EB;" : ""}><i class={`fa-solid ${point.icon}`}></i></div>
                  <div class="edu-content">
                    <h4 style={index % 2 === 0 ? "color:#1E293B;" : ""}>{point.title}</h4>
                    <p style={index % 2 === 0 ? "color:#4B5563;" : ""}>{point.text}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div class="educational-image">
            <img src={block.imgSrc} alt={block.imgAlt} loading="lazy" />
          </div>
        </div>
      </section>
    ))}

    <!-- 6. WHY US - Claro -->
    {service.whyUs && service.whyUs.length > 0 && (
      <section class="svc-whyus">
        <div class="container">
          <div class="ux-section-header text-center">
            <span class="ux-eyebrow" style="color:#2563EB;">Ventaja Pixon</span>
            <h2 class="ux-h2" style="color:#0E1629 !important;">¿Por qué elegir nuestro <span style="color:#2563EB;">{service.label.toLowerCase()}</span>?</h2>
          </div>
          <div class="whyus-grid">
            {service.whyUs.map((item: any) => (
              <div class="whyus-card">
                <div class="whyus-icon"><i class={`fa-solid ${item.icon}`}></i></div>
                <h4>{item.title}</h4>
                <p>{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 7. PROBLEMAS COMUNES - Oscuro -->
    {service.commonProblems && service.commonProblems.length > 0 && (
      <section class="svc-problems">
        <div class="container">
          <div class="ux-section-header text-center">
            <span class="ux-eyebrow">Diagnóstico Frecuente</span>
            <h2 class="ux-h2">Problemas comunes → <span class="ux-text-accent">Soluciones reales</span></h2>
          </div>
          <div class="problems-list">
            {service.commonProblems.map((item: any) => (
              <div class="problem-row">
                <div class="problem-left">
                  <i class="fa-solid fa-circle-xmark"></i>
                  <span>{item.problem}</span>
                </div>
                <div class="problem-arrow"><i class="fa-solid fa-arrow-right"></i></div>
                <div class="problem-right">
                  <i class="fa-solid fa-circle-check"></i>
                  <span>{item.solution}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 8. MARCAS COMPATIBLES - Claro -->
    {service.compatibleBrands && service.compatibleBrands.length > 0 && (
      <section class="svc-compat">
        <div class="container text-center">
          <span class="ux-eyebrow" style="color:#2563EB;">Cobertura Total</span>
          <h2 class="ux-h2" style="color:#0E1629 !important;">Hacemos {service.label.toLowerCase()} en estas marcas</h2>
          <div class="compat-brands">
            {service.compatibleBrands.map((b: string) => (
              <span class="brand-chip">{b}</span>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 9. SERVICIOS RELACIONADOS - Oscuro -->
    {(service.relatedSlugs?.length > 0 || service.relatedExternal?.length > 0) && (
      <section class="svc-related">
        <div class="container">
          <div class="ux-section-header text-center">
            <span class="ux-eyebrow">Servicios Complementarios</span>
            <h2 class="ux-h2">Otros servicios que podrían <span class="ux-text-accent">interesarte</span></h2>
          </div>
          <div class="related-grid">
            {service.relatedSlugs?.filter((s: string) => s !== service.slug).slice(0, 3).map((slug: string) => {
              const rel = category.services.find((s: any) => s.slug === slug);
              if (!rel) return null;
              const href = rel.customUrl ?? `/servicios/${category.slug}/${rel.slug}`;
              return (
                <a href={href} class="related-card">
                  <i class={`fa-solid ${category.icon}`}></i>
                  <h4>{rel.label}</h4>
                  <span>Ver servicio →</span>
                </a>
              );
            })}
            {service.relatedExternal?.slice(0, 3).map((ext: any) => (
              <a href={ext.href} class="related-card related-card--ext">
                <i class={`fa-solid ${ext.icon}`}></i>
                <h4>{ext.label}</h4>
                <p>{ext.desc}</p>
                <span>Ver más →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 10. FAQ — Home pattern (conditional) -->
    {service.faqs && (
    <section class="faq-section section-padding" id="faq" aria-label={`Preguntas frecuentes sobre ${service.label} en Cancún`}>
      <div class="container">
        <div class="section-title text-center" style="margin-bottom:2.5rem;">
          <h2>Preguntas frecuentes sobre {service.label} en Cancún</h2>
          <p>Resolvemos las dudas más comunes sobre {service.label} en Cancún. Diagnóstico claro, atención directa y garantía real.</p>
        </div>
        <div class="faq-grid">
          {service.faqs.map((item: any) => (
            <div class="faq-item">
              <button class="faq-question" aria-expanded="false" onclick="toggleSvcFaqItem(this)">
                <span><i class="fa-solid fa-circle-question faq-q-icon"></i> {item.question}</span>
                <i class="fa-solid fa-chevron-down faq-chevron"></i>
              </button>
              <div class="faq-answer" aria-hidden="true">
                <div class="faq-answer-inner" set:html={item.answer}></div>
              </div>
            </div>
          ))}
        </div>
        <div class="text-center" style="margin-top:2.5rem;">
          <a href="/preguntas-frecuentes"
            style="background:transparent;border:2px solid #3b82f6;color:#3b82f6;font-weight:700;padding:12px 30px;border-radius:30px;transition:all 0.3s;text-decoration:none;display:inline-block;"
            onmouseover="this.style.background='#3b82f6';this.style.color='#fff';"
