  <!-- ─── FAQ Toggle Script ─── -->
  <!-- ⚠️ PRECAUCIÓN: Esta función controla el acordeón de FAQs en las landing pages
       de servicios (/servicios/[categoria]/[servicio]).
       - El onclick en el botón usa 'toggleSvcFaqItem'
       - Los selectores apuntan a .faq-item, .faq-question, .faq-answer
       - NO cambiar estos nombres sin actualizar el onclick en el botón arriba -->
  <script>
    function toggleSvcFaqItem(btn: HTMLButtonElement) {
      const item = btn.closest('.faq-item') as HTMLElement | null;
      if (!item) return;
      const ans = item.querySelector('.faq-answer') as HTMLElement | null;
      if (!ans) return;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      // Cerrar todos los items abiertos del mismo contenedor
      const container = item.closest('.faq-grid');
      if (container) {
        container.querySelectorAll<HTMLElement>('.faq-item').forEach(el => {
          const q = el.querySelector<HTMLButtonElement>('.faq-question');
          const a = el.querySelector<HTMLElement>('.faq-answer');
          if (q) q.setAttribute('aria-expanded', 'false');
          if (a) {
            a.style.maxHeight = '0';
            a.setAttribute('aria-hidden', 'true');
          }
        });
      }

      // Abrir el clickeado solo si estaba cerrado
      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        ans.style.maxHeight = ans.scrollHeight + 'px';
        ans.setAttribute('aria-hidden', 'false');
      }
    }
    // Exponer al scope global para que el onclick inline funcione
    (window as any).toggleSvcFaqItem = toggleSvcFaqItem;
  </script>
  )}
