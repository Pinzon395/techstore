---
import Base from '../../../layouts/Base.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FaqSection from '../../../components/FaqSection.astro';
import CommentsSection from '../../../components/CommentsSection.astro';
import ContactSection from '../../../components/ContactSection.astro';
import RelatedServicesSection from '../../../components/RelatedServicesSection.astro';
import MantenimientoTermicoView from '../../../components/views/MantenimientoTermicoView.astro';
import CambioBateriaView from '../../../components/views/CambioBateriaView.astro';
import ServiceTicketSection from '../../../components/ServiceTicketSection.astro';
import { SERVICE_CATEGORIES } from '../../../data/services';

export function getStaticPaths() {
  const paths: any[] = [];
  for (const category of SERVICE_CATEGORIES) {
    for (const service of category.services) {
      if (service.customUrl) continue;
      paths.push({
        params: { categoria: category.slug, servicio: service.slug },
        props:  { category, service },
      });
    }
  }
  return paths;
}

const { category, service } = Astro.props;

const canonical = `https://pixon.com.mx/servicios/${category.slug}/${service.slug}`;
const isLaptopScreenReplacement = category.slug === 'laptop' && service.slug === 'cambio-pantalla';
const isLaptopKeyboardReplacement = category.slug === 'laptop' && service.slug === 'cambio-teclado';
const isLaptopLocalReplacement = isLaptopScreenReplacement || isLaptopKeyboardReplacement;
// SEO LOCAL H1 / TITLE
const seoKeyword = service.seoKeyword || service.label;
const seoTitle = isLaptopKeyboardReplacement
  ? 'Cambio de teclado de laptop en Cancún | Pixon PC'
  : isLaptopLocalReplacement
  ? `${seoKeyword} con garantía | Pixon PC`
  : `${seoKeyword} para ${category.title} en Cancún | Pixon PC`;
const description = isLaptopKeyboardReplacement
  ? 'Cambia o repara el teclado de tu laptop en Cancún. Revisamos flex, líquido, conector y modelo antes de cotizar por WhatsApp.'
  : service.intro
  ? `${service.intro} Cotización gratis, diagnóstico claro y reparación profesional en Cancún.`
  : `Servicio especializado de ${service.label} para ${category.title} en Cancún. Diagnóstico profundo y garantía por escrito.`;

const waMessage = encodeURIComponent(isLaptopKeyboardReplacement
  ? 'Hola, quiero cotizar cambio o reparación de teclado de laptop en Cancún. Puedo enviar modelo o foto del equipo.'
  : `Hola, necesito el servicio de ${service.label} para mi ${category.title}. ¿Me podrían cotizar?`);

// Hooks y Bullets
const hook = service.hook || `Evita fallas costosas y recupera el rendimiento de tu ${category.title}`;

const pageSchema = isLaptopKeyboardReplacement ? [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Cambio de teclado de laptop en Cancún",
    "description": description,
    "serviceType": "Reparación y cambio de teclado de laptop",
    "url": canonical,
    "provider": { "@id": "https://pixon.com.mx/#business" },
    "areaServed": [
      { "@type": "City", "name": "Cancún" },
      { "@type": "State", "name": "Quintana Roo" }
    ],
    "offers": {
      "@type": "Offer",
      "price": "1550",
      "priceCurrency": "MXN",
      "availability": "https://schema.org/InStock",
      "description": "Precio desde. El costo final depende del modelo, distribución, disponibilidad y si el teclado viene integrado al palmrest."
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": (service.faqs || []).map((item: any) => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer.replace(/<[^>]*>/g, '')
      }
    }))
  }
] : [];

// FAQ items con SEO local
const faqItems = [
  {
    question: `¿Cuánto tiempo toma el ${service.label.toLowerCase()} en Cancún?`,
    answer: `El ${service.label.toLowerCase()} para ${category.title} normalmente toma entre 1 y 3 días hábiles dependiendo de la severidad del daño y disponibilidad de refacciones en Cancún. Te avisamos en tiempo real.`,
  },
  {
    question: `¿Mi equipo está seguro durante el ${service.label.toLowerCase()}?`,
    answer: `Sí. Trabajamos en un área antiestática certificada. Tus datos y componentes están protegidos durante todo el proceso. No desinstalamos ni borramos información personal.`,
  },
  {
    question: `¿Ofrecen garantía en el ${service.label.toLowerCase()}?`,
    answer: `Sí, ofrecemos garantía por escrito en todos nuestros servicios. El tiempo varía según el tipo de intervención, pero mínimo 30 días en mano de obra.`,
  },
  {
    question: `¿Qué marcas de ${category.title} manejan en Cancún?`,
    answer: `Trabajamos con todas las marcas principales: Apple, Dell, HP, Asus ROG, Lenovo Legion, MSI, Acer, Alienware y equipos ensamblados a medida. Sin importar la marca, tenemos la capacidad técnica.`,
  },
  {
    question: '¿Tienen servicio a domicilio o tienen que llevar el equipo?',
    answer: 'Contamos con taller físico en Cancún donde atendemos diagnósticos presenciales. Para ciertos servicios también podemos coordinar recogida. Contáctanos por WhatsApp para más detalles.',
  },
];

---

<Base title={seoTitle} description={description} canonical={canonical} schema={pageSchema}>
  <!-- CRITICAL: Forzar fondo oscuro antes que cualquier CSS global -->
  <style is:global>
    body { background-color: #0B1120 !important; color: #E2E8F0 !important; }
    .ux-hero, .ux-benefits, .ux-process, .ux-cta-band {
      background-color: #0B1120 !important;
    }
    .ux-symptoms, .ux-brands {
      background-color: #0F172A !important;
    }
    /* Override cualquier background blanco que venga del layout base */
    main, .main-content, #main, .page-wrapper { background-color: #0B1120 !important; }
  </style>
  <Navbar />
  {isLaptopScreenReplacement && <div class="screen-navbar-offset" aria-hidden="true"></div>}

  {!isLaptopScreenReplacement && (
    <Breadcrumb items={[
      { label: 'Inicio',         href: '/' },
      { label: 'Servicios',      href: '/servicios' },
      { label: category.title,   href: `/servicios/${category.slug}` },
      { label: service.label },
    ]} />
  )}

  {service.slug === 'ventilacion' ? (
    <MantenimientoTermicoView service={service} category={category} />
  ) : service.slug === 'cambio-bateria' ? (
    <CambioBateriaView service={service} category={category} />
  ) : (
    <div class="theme-premium-dark">
      <!-- 1. HERO SECTION (Dark Premium) -->
    <section class={`ux-hero ${isLaptopScreenReplacement ? 'screen-hero' : ''} ${isLaptopKeyboardReplacement ? 'keyboard-hero' : ''}`}>
      <div class="ux-glow-hero"></div>
      <div class="container ux-hero-inner">
        <div class="ux-hero-content">
          <span class="ux-badge">
            <i class={`fa-solid ${category.icon}`}></i>
            {isLaptopScreenReplacement ? 'Pantallas para laptop en Cancún' : isLaptopKeyboardReplacement ? 'Servicio técnico de teclado en Cancún' : `Especialistas en ${category.title} en Cancún`}
          </span>
          
          <h1 class="ux-h1">
            {isLaptopScreenReplacement ? 'Cambio de pantalla de laptop en Cancún' : isLaptopKeyboardReplacement ? 'Cambio de teclado de laptop en Cancún' : seoKeyword} <br>
            <span class="ux-gradient-text">
              {isLaptopScreenReplacement ? 'con diagnóstico y garantía' : isLaptopKeyboardReplacement ? 'con revisión de flex, líquido y garantía' : 'Profesional'}
            </span>
          </h1>
          
          <h2 class="ux-hero-hook">{hook}</h2>
          
          <p class="ux-hero-desc">
            {service.intro || `Solucionamos problemas de ${service.label.toLowerCase()} de forma definitiva. Trabajamos con equipo especializado y refacciones certificadas en Cancún.`}
          </p>

          {isLaptopScreenReplacement && (
            <div class="screen-hero-tags" aria-label="Detalles del servicio de cambio de pantalla">
              <span><i class="fa-solid fa-display"></i> LCD, LED, FHD, táctil y OLED</span>
              <span><i class="fa-solid fa-location-dot"></i> Taller local en Cancún</span>
              <span><i class="fa-solid fa-magnifying-glass"></i> Revisamos flex y video antes de cotizar</span>
            </div>
          )}

          {isLaptopKeyboardReplacement && (
            <div class="keyboard-hero-tags" aria-label="Detalles del servicio de cambio de teclado">
              <span><i class="fa-solid fa-keyboard"></i> Español latino, US o backlit</span>
              <span><i class="fa-solid fa-droplet-slash"></i> Revisamos líquido, flex y conector</span>
              <span><i class="fa-solid fa-location-dot"></i> Taller local en Cancún</span>
            </div>
          )}

          <div class="ux-trust-bar">
            <div class="trust-item"><i class="fa-solid fa-star"></i> 5.0 en Google Maps</div>
            <div class="trust-item"><i class="fa-solid fa-shield-halved"></i> Garantía por escrito</div>
            <div class="trust-item"><i class="fa-solid fa-stopwatch"></i> {service.eta || 'Atención rápida'}</div>
          </div>

          <div class="ux-hero-ctas">
            <a href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank" class={`ux-btn-primary ${isLaptopLocalReplacement ? '' : 'pulse'}`}>
              <i class="fa-brands fa-whatsapp"></i> {isLaptopScreenReplacement ? 'Cotizar pantalla por WhatsApp' : isLaptopKeyboardReplacement ? 'Cotizar cambio de teclado' : 'Cotizar Servicio'}
            </a>
            <a href="#proceso" class="ux-btn-secondary" data-screen-scroll={isLaptopScreenReplacement ? 'proceso' : undefined}>
              {isLaptopScreenReplacement ? 'Ver proceso técnico' : isLaptopKeyboardReplacement ? 'Ver diagnóstico antes de cambiar pieza' : 'Ver Proceso'} <i class="fa-solid fa-arrow-down"></i>
            </a>
          </div>
        </div>
        
        <div class="ux-hero-visual">
          {isLaptopKeyboardReplacement ? (
            <div class="keyboard-quote-card">
              <div class="keyboard-quote-top">
                <span class="keyboard-quote-label">Cotización por WhatsApp</span>
                <span class="keyboard-quote-time"><i class="fa-solid fa-stopwatch"></i> 24-72 h</span>
              </div>
              <div class="keyboard-price-block">
                <span>Desde</span>
                <strong>{service.fromPrice || '$1,550 MXN'}</strong>
                <small>El precio final depende del modelo, distribución, backlit, palmrest y disponibilidad.</small>
              </div>
              <div class="keyboard-diagnosis-included">
                <i class="fa-solid fa-magnifying-glass-chart"></i>
                <div>
                  <strong>Primero revisamos de dónde viene la falla</strong>
                  <span>Teclado, flex, conector, humedad, BIOS y placa.</span>
                </div>
              </div>
              <div class="keyboard-quote-steps" aria-label="Proceso de cotización">
                <div><span>1</span> Envías modelo o foto</div>
                <div><span>2</span> Confirmamos compatibilidad</div>
                <div><span>3</span> Instalamos y probamos</div>
              </div>
              <a href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank" class="keyboard-quote-cta">
                <i class="fa-brands fa-whatsapp"></i> Enviar modelo de mi laptop
              </a>
              <p class="keyboard-quote-note">No pedimos la pieza hasta confirmar modelo, distribución y tipo de teclado.</p>
            </div>
          ) : (
          <div class="ux-glass-panel">
            <div class="glass-header">
              <i class={`fa-solid ${isLaptopScreenReplacement ? 'fa-display' : isLaptopKeyboardReplacement ? 'fa-keyboard' : 'fa-clipboard-list'}`}></i>
              <span>{isLaptopScreenReplacement ? 'Servicio para pantallas LCD, LED y táctiles' : isLaptopKeyboardReplacement ? 'Servicio para teclados de laptop LA-ESP, US y backlit' : '¿Qué Incluye?'}</span>
            </div>
            <ul class="ux-check-list">
              {service.bullets && service.bullets.length > 0 ? (
                service.bullets.map((b: string) => (
                  <li><i class="fa-solid fa-circle-check"></i> <span>{b}</span></li>
                ))
              ) : (
                <>
                  <li><i class="fa-solid fa-circle-check"></i> <span>Diagnóstico físico y por software</span></li>
                  <li><i class="fa-solid fa-circle-check"></i> <span>Uso de herramientas antiestáticas</span></li>
                  <li><i class="fa-solid fa-circle-check"></i> <span>Componentes de alta calidad</span></li>
                  <li><i class="fa-solid fa-circle-check"></i> <span>Pruebas de rendimiento post-servicio</span></li>
                </>
              )}
            </ul>
            <div class="glass-price">
              <span>Inversión desde:</span>
              <strong>{service.fromPrice || 'Previa Revisión'}</strong>
              {isLaptopScreenReplacement && <small>El precio final depende del modelo y tipo de pantalla de tu laptop.</small>}
              {isLaptopKeyboardReplacement && <small>El precio final depende del modelo, distribución, si es retroiluminado y disponibilidad de la pieza.</small>}
            </div>
          </div>
          )}
        </div>
      </div>
    </section>

    <!-- 1.5 TRUST STRIP CON STATS -->
    {service.trustStats && service.trustStats.length > 0 && (
      <section class={`svc-trust-strip ${isLaptopScreenReplacement ? 'screen-proof-strip' : ''} ${isLaptopKeyboardReplacement ? 'keyboard-proof-strip' : ''}`}>
        <div class="container">
          {isLaptopScreenReplacement && (
            <div class="screen-proof-heading">
              <span class="ux-eyebrow">Servicio local verificado</span>
              <h2 class="ux-h2">Cambio de pantalla de laptop en Cancún con proceso claro</h2>
              <p>Atendemos cambio de pantalla de laptop en Cancún con diagnóstico previo del panel, flex de video y salida a monitor externo. Te confirmamos compatibilidad, costo y tiempo antes de pedir o instalar la pieza.</p>
            </div>
          )}
          {isLaptopKeyboardReplacement && (
            <div class="keyboard-proof-heading">
              <span class="ux-eyebrow">Transparencia en refacciones</span>
              <h2 class="ux-h2">Reparación y cambio de teclado de laptop en Cancún con diagnóstico real</h2>
              <p>No vendemos un teclado sin revisar. Primero identificamos si la falla viene del teclado físico, flex, conector, humedad, BIOS o placa. Después te confirmamos compatibilidad, costo y tiempo real por WhatsApp.</p>
            </div>
          )}
          <div class="trust-stats-grid">
            {service.trustStats.map((stat, index) => (
              <div class="trust-stat-item">
                <div class="trust-stat-icon"><i class={`fa-solid ${stat.icon}`}></i></div>
                <div class="trust-stat-value">{stat.value}</div>
                <div class="trust-stat-label">{stat.label}</div>
                {isLaptopScreenReplacement && (
                  <p class="trust-stat-note">
                    {[
                      'Revisamos si la falla real está en display, cable flex, bisagra, retroiluminación o tarjeta de video.',
                      'La garantía aplica sobre la pantalla instalada y se entrega por escrito al finalizar el servicio.',
                      'Coordinamos recepción, recolección o entrega según zona y disponibilidad operativa en Cancún.',
                      'El tiempo puede variar si el panel debe pedirse fuera de Cancún o si el modelo requiere pieza especial.',
                    ][index]}
                  </p>
                )}
                {isLaptopKeyboardReplacement && (
                  <p class="trust-stat-note">
                    {[
                      'Probamos teclado, flex, conector y señales de líquido antes de recomendar cambio completo.',
                      'Validamos idioma, tamaño, molde, retroiluminación y número de parte del modelo exacto.',
                      'La garantía aplica sobre la pieza instalada y se entrega por escrito al finalizar.',
                      'El tiempo depende de stock local en Cancún o pedido de refacción para modelos especiales.',
                    ][index]}
                  </p>
                )}
              </div>
            ))}
          </div>
          {isLaptopScreenReplacement && (
            <div class="screen-proof-footer">
              <i class="fa-solid fa-circle-info"></i>
              <span>El plazo de entrega depende del modelo exacto, tipo de pantalla y disponibilidad de la refacción en Cancún. Si la pieza está local, avanzamos más rápido; si se pide fuera, te avisamos antes de confirmar.</span>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- 1.6 ESPECIALISTAS (Patrón Reparaciones) -->
    {service.specialistTitle && (
      <section class="svc-specialists section-pad" style="background:#0F172A;">
        <div class="container">
          <div class="svc-specialists-inner">
            <div class="svc-specialists-text">
              <span class="ux-eyebrow"><i class="fa-solid fa-microchip"></i> Especialistas</span>
              <h2 class="ux-h2">{service.specialistTitle}</h2>
              <p>{service.specialistDesc}</p>
              <a href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank" class="ux-btn-primary">
                <i class="fa-brands fa-whatsapp"></i> Cotizar mi pantalla
              </a>
            </div>
            <div class="svc-specialists-img">
              <img src={service.specialistImage || '/assets/images/reparacion-mac-cancun.jpeg'} alt={service.specialistTitle} />
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 1.7 TIPOS DE PANTALLA (Galería con badges) -->
    {service.screenTypes && service.screenTypes.length > 0 && (
      <section class="svc-screen-types section-pad" style="background:#0B1120;">
        <div class="container">
          <div class="ux-section-header text-center">
            <span class="ux-eyebrow">Tipos de Pantalla</span>
            <h2 class="ux-h2">
              {isLaptopScreenReplacement ? (
                <>Tipos de pantalla de laptop que instalamos en <span class="ux-text-accent">Cancún</span></>
              ) : (
                <>Trabajamos con todos los <span class="ux-text-accent">tipos de panel</span></>
              )}
            </h2>
            <p>Identificamos el modelo exacto antes de cotizar para que la pieza sea compatible con tu laptop.</p>
          </div>
          <div class="screen-types-grid">
            {service.screenTypes.map((type) => (
              <div class="screen-type-card">
                <span class="screen-type-badge">{type.label}</span>
                <p>{type.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 1.8 ANTES / DESPUÉS (Comparativa) -->
    {service.beforeAfter && (
      <section class={`svc-before-after section-pad ${isLaptopScreenReplacement ? 'screen-result-section' : ''}`} style="background:#0F172A;">
        <div class="container">
          <div class="ux-section-header text-center">
            <span class="ux-eyebrow">Resultado real</span>
            <h2 class="ux-h2">
              {isLaptopScreenReplacement ? (
                <>Antes y después del cambio de pantalla de <span class="ux-text-accent">laptop</span></>
              ) : (
                <>Tu laptop antes vs. <span class="ux-text-accent">después</span></>
              )}
            </h2>
            {isLaptopScreenReplacement && (
              <p>Mostramos el cambio esperado después de instalar el display correcto, validar flex de video y probar imagen antes de entregar.</p>
            )}
          </div>
          <div class="ba-comparison">
            <div class="ba-col ba-col--before">
              {isLaptopScreenReplacement && (
                <div class="ba-status-pill">
                  <i class="fa-solid fa-triangle-exclamation"></i>
                  Equipo con falla visible
                </div>
              )}
              <h3><i class="fa-solid fa-circle-xmark"></i> Antes</h3>
              {isLaptopScreenReplacement && (
                <p class="ba-col-desc">Síntomas que revisamos para confirmar si el daño viene del panel, flex, bisagras o tarjeta de video.</p>
              )}
              {service.beforeAfter.before.map((item) => (
                <div class="ba-item"><i class="fa-solid fa-xmark"></i> {item}</div>
              ))}
            </div>
            <div class="ba-col ba-col--after">
              {isLaptopScreenReplacement && (
                <div class="ba-status-pill ba-status-pill--ok">
                  <i class="fa-solid fa-screwdriver-wrench"></i>
                  Pantalla instalada y probada
                </div>
              )}
              <h3><i class="fa-solid fa-circle-check"></i> Después</h3>
              {isLaptopScreenReplacement && (
                <p class="ba-col-desc">Resultado que buscamos antes de cerrar el equipo: imagen limpia, brillo estable y funcionamiento continuo.</p>
              )}
              {service.beforeAfter.after.map((item) => (
                <div class="ba-item"><i class="fa-solid fa-check"></i> {item}</div>
              ))}
            </div>
          </div>
          {isLaptopScreenReplacement && (
            <div class="ba-validation-row" aria-label="Validaciones posteriores al cambio de pantalla">
              <div class="ba-validation-item">
                <i class="fa-solid fa-display"></i>
                <span>Prueba de imagen continua</span>
              </div>
              <div class="ba-validation-item">
                <i class="fa-solid fa-sliders"></i>
                <span>Brillo, color y contraste revisados</span>
              </div>
              <div class="ba-validation-item">
                <i class="fa-solid fa-file-shield"></i>
                <span>Garantía por escrito en Cancún</span>
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- 2. SÍNTOMAS / PROBLEMAS COMUNES (Fallback) -->
    {(!service.commonProblems || service.commonProblems.length === 0) && (
      <section class="ux-symptoms">
        <div class="container">
          <div class="ux-section-header">
            <span class="ux-eyebrow">Diagnóstico Inicial</span>
            <h2 class="ux-h2">Señales de que necesitas <span class="ux-text-accent">{service.label.toLowerCase()}</span></h2>
            <p>Si tu {category.title} presenta alguno de estos síntomas, es momento de intervenir antes de que el daño sea mayor o irreversible.</p>
          </div>

          <div class="ux-grid-3">
            <div class="ux-symptom-card">
              <div class="symptom-icon"><i class="fa-solid fa-temperature-arrow-up"></i></div>
              <h3>Calentamiento Excesivo</h3>
              <p>El equipo se calienta rápido y apaga solo por protección térmica.</p>
            </div>
            <div class="ux-symptom-card">
              <div class="symptom-icon"><i class="fa-solid fa-gauge-simple-low"></i></div>
              <h3>Lentitud y Congelamientos</h3>
              <p>El sistema operativo tarda en responder o se traba constantemente.</p>
            </div>
            <div class="ux-symptom-card">
              <div class="symptom-icon"><i class="fa-solid fa-volume-high"></i></div>
              <h3>Ruidos Extraños</h3>
              <p>Los ventiladores suenan muy fuerte o hacen ruidos mecánicos.</p>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 3. POR QUÉ ELEGIRNOS (Fallback) -->
    {(!service.whyUs || service.whyUs.length === 0) && (
      <section class="ux-benefits">
        <div class="container ux-benefits-inner">
          <div class="ux-benefits-img">
            <div class="img-wrapper">
              <img src="/assets/images/reparacion-mac-cancun.jpeg" alt={`Mantenimiento de ${category.title} en Cancún`} loading="lazy" />
              <div class="ux-float-badge">
                <i class="fa-solid fa-medal"></i>
                <span>Refacciones Originales u OEM</span>
              </div>
            </div>
          </div>
          <div class="ux-benefits-text">
            <span class="ux-eyebrow">Diferenciador Pixon</span>
            <h2 class="ux-h2">No es solo reparar, es <span class="ux-text-accent">Ingeniería Aplicada</span></h2>
            <p>Un mal {service.label.toLowerCase()} puede causar cortos circuitos o dañar tu {category.title} para siempre. Nosotros aplicamos estándares técnicos rigurosos en Cancún.</p>
            
            <div class="ux-benefit-list">
              <div class="benefit-row">
                <i class="fa-solid fa-microchip"></i>
                <div>
                  <h4>Insumos Premium</h4>
