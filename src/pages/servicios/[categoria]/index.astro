---
/**
 * Hub de cada categoria de servicios.
 * /servicios/laptop, /servicios/pc, /servicios/telefono, /servicios/consola, /servicios/impresora
 */
import Base from '../../../layouts/Base.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CommentsSection from '../../../components/CommentsSection.astro';
import ServiceTicketSection from '../../../components/ServiceTicketSection.astro';
import { SERVICE_CATEGORIES } from '../../../data/services';

export function getStaticPaths() {
  return SERVICE_CATEGORIES.map((category) => ({
    params: { categoria: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const canonical = `https://pixon.com.mx/servicios/${category.slug}`;
const title = `Reparación de ${category.title} en Cancún | Pixon PC`;
const description = `Servicios profesionales de reparación de ${category.title.toLowerCase()} en Cancún. ${category.services.length} servicios disponibles, garantía por escrito y diagnóstico gratis.`;
const waMessage = encodeURIComponent(`Hola, quiero información sobre los servicios de ${category.title}`);

const featured = category.services.slice(0, 3);
const remaining = category.services.slice(3);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://pixon.com.mx/' },
      { '@type': 'ListItem', position: 2, name: 'Servicios', item: 'https://pixon.com.mx/servicios' },
      { '@type': 'ListItem', position: 3, name: category.title, item: canonical },
    ],
  },
];
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  image="/LOGOCIRCULAR.png"
  schema={schema}
>
  <Navbar />

  <Breadcrumb items={[
    { label: 'Inicio', href: '/' },
    { label: 'Servicios', href: '/servicios' },
    { label: category.title },
  ]} />

  <section class="cat-hub">
    <div class="cat-hub-bg" aria-hidden="true"></div>

    <div class="container cat-hub-inner">
      <header class="cat-hero">
        <div class="cat-hero-copy">
          <span class="cat-eyebrow">
            <i class={`fa-solid ${category.icon}`}></i>
            Catálogo {category.title}
          </span>
          <h1>
            Reparación de <span>{category.title}</span>
            <small>en Cancún</small>
          </h1>
          <p>
            {category.services.length} servicios profesionales para tu {category.title.toLowerCase()}.
            Diagnóstico siempre gratis y garantía por escrito.
          </p>
          <div class="cat-actions">
            <a
              href={`https://wa.me/529986690777?text=${waMessage}`}
              target="_blank"
              rel="noopener noreferrer"
              class="cat-btn-primary"
            >
              <i class="fa-brands fa-whatsapp"></i> Cotizar por WhatsApp
            </a>
            <a href="/contacto" class="cat-btn-secondary">
              <i class="fa-solid fa-phone"></i> Otros medios
            </a>
          </div>
        </div>

        <aside class="cat-hero-panel" aria-label={`Resumen de servicios de ${category.title}`}>
          <div class="cat-device-mark" style={`--category-bg: ${category.heroBg};`}>
            <i class={`fa-solid ${category.icon}`}></i>
          </div>
          <div class="cat-panel-stat">
            <strong>{category.services.length}</strong>
            <span>servicios disponibles</span>
          </div>
          <div class="cat-panel-grid">
            <div><i class="fa-solid fa-magnifying-glass"></i><span>Diagnóstico gratis</span></div>
            <div><i class="fa-solid fa-shield-halved"></i><span>Garantía por escrito</span></div>
            <div><i class="fa-solid fa-clock"></i><span>Tiempos claros</span></div>
            <div><i class="fa-solid fa-location-dot"></i><span>Servicio en Cancún</span></div>
          </div>
        </aside>
      </header>

      <section class="cat-featured" aria-labelledby="destacados-title">
        <div class="cat-section-head">
          <span>Servicios principales</span>
          <h2 id="destacados-title">Elige el servicio que mejor describe la falla</h2>
          <p>Si no estás seguro, crea un ticket y te guiamos hacia el servicio correcto antes de cotizar.</p>
        </div>

        <div class="cat-featured-grid">
          {featured.map((service, index) => {
            const href = service.customUrl ?? `/servicios/${category.slug}/${service.slug}`;
            const isExternal = !!service.customUrl;
            return (
              <a href={href} class="cat-feature-card">
                <div class="cat-feature-top">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  {isExternal && <em>Servicio dedicado</em>}
                </div>
                <h3>{service.label}</h3>
                {service.intro && <p>{service.intro}</p>}
                <div class="cat-card-meta">
                  {service.fromPrice && <span>Desde {service.fromPrice}</span>}
                  {service.eta && <span><i class="fa-solid fa-clock"></i> {service.eta}</span>}
                </div>
                <i class="fa-solid fa-arrow-right cat-card-next"></i>
              </a>
            );
          })}
        </div>
      </section>

      {remaining.length > 0 && (
        <section class="cat-service-board" aria-labelledby="servicios-title">
          <div class="cat-section-head compact">
            <span>Catálogo completo</span>
            <h2 id="servicios-title">Más opciones para {category.title}</h2>
          </div>

          <div class="cat-service-list">
            {remaining.map((service) => {
              const href = service.customUrl ?? `/servicios/${category.slug}/${service.slug}`;
              const isExternal = !!service.customUrl;
              return (
                <a href={href} class="cat-service-row">
                  <div class="cat-row-main">
                    <strong>{service.label}</strong>
                    {service.intro && <p>{service.intro}</p>}
                  </div>
                  <div class="cat-row-meta">
                    {isExternal && <span class="cat-tag-dedicated">Servicio dedicado</span>}
                    {service.fromPrice && <span>{service.fromPrice}</span>}
                    {service.eta && <span>{service.eta}</span>}
                    <i class="fa-solid fa-arrow-right"></i>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}

      <section class="cat-support-flow" aria-labelledby="flow-title">
        <div>
          <span class="cat-flow-label">Cómo trabajamos</span>
          <h2 id="flow-title">Primero confirmamos la falla, luego cotizamos</h2>
          <p>No vendemos piezas ni servicios sin revisar. Tomamos síntomas, validamos el equipo y te damos una ruta clara.</p>
        </div>
        <div class="cat-flow-steps">
          <div><strong>01</strong><span>Recibimos síntomas</span></div>
          <div><strong>02</strong><span>Diagnosticamos causa</span></div>
          <div><strong>03</strong><span>Confirmamos costo y garantía</span></div>
        </div>
      </section>

      <div class="cat-hub-trust">
        <div class="cat-hub-trust-item">
          <i class="fa-solid fa-shield-halved"></i>
          <div>
            <strong>Garantía por escrito</strong>
            <small>en cada servicio</small>
          </div>
        </div>
        <div class="cat-hub-trust-item">
          <i class="fa-solid fa-magnifying-glass"></i>
          <div>
            <strong>Diagnóstico gratis</strong>
            <small>sin compromiso</small>
          </div>
        </div>
        <div class="cat-hub-trust-item">
          <i class="fa-solid fa-truck"></i>
          <div>
            <strong>Recolección en Cancún</strong>
            <small>sin costo en servicios &gt;$800</small>
          </div>
        </div>
        <div class="cat-hub-trust-item">
          <i class="fa-solid fa-clock"></i>
          <div>
            <strong>+7 años</strong>
            <small>de experiencia</small>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ServiceTicketSection
    defaultDevice={category.title}
    defaultService={`Servicios de ${category.title}`}
    title={`Solicitar revisión de ${category.title}`}
    subtitle={`Cuéntanos qué necesita tu ${category.title.toLowerCase()} y te guiamos al servicio correcto antes de cotizar.`}
  />

  <CommentsSection viewMoreHref="/comentarios" />

  <Footer />

  <style is:global>
    .cat-hub {
      position: relative;
      padding: 46px 0 62px;
      background: linear-gradient(180deg, #f8fbff 0%, #edf4ff 100%);
      color: #0f2a4a;
      overflow: hidden;
      isolation: isolate;
    }
    .cat-hub-bg {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, rgba(37, 99, 235, .055) 1px, transparent 1px),
        linear-gradient(180deg, rgba(37, 99, 235, .05) 1px, transparent 1px);
      background-size: 44px 44px;
      mask-image: linear-gradient(180deg, #000 0%, transparent 82%);
      pointer-events: none;
    }
    .cat-hub-inner {
      position: relative;
      z-index: 1;
    }

    .cat-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(320px, .85fr);
      gap: 28px;
      align-items: stretch;
      margin-bottom: 34px;
    }
    .cat-hero-copy,
    .cat-hero-panel,
    .cat-featured,
    .cat-service-board,
    .cat-support-flow,
    .cat-hub-trust {
      background: #fbfdff;
      border: 1px solid #dbe7f7;
      box-shadow: 0 16px 44px rgba(15, 42, 74, .08);
    }
    .cat-hero-copy {
      min-height: 340px;
      padding: 42px;
      border-radius: 22px;
    }
    .cat-eyebrow,
    .cat-section-head span,
    .cat-flow-label {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #1d4ed8;
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 999px;
      padding: 7px 13px;
      font-size: .76rem;
      font-weight: 900;
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .cat-hero h1 {
      font-family: var(--font-heading, 'Kanit', sans-serif);
      font-size: clamp(2rem, 5vw, 4rem);
      line-height: 1;
      letter-spacing: 0;
      color: #0b1f3a;
      margin: 18px 0 16px;
    }
    .cat-hero h1 span {
      color: #1d4ed8;
    }
    .cat-hero h1 small {
      display: block;
      color: #425b78;
      font-size: .48em;
      margin-top: 8px;
    }
    .cat-hero-copy p {
      color: #425b78;
      font-size: 1.05rem;
      line-height: 1.62;
      max-width: 640px;
      margin: 0 0 24px;
    }
    .cat-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }
    .cat-btn-primary,
    .cat-btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      min-height: 44px;
      padding: 12px 18px;
      border-radius: 12px;
      font-weight: 850;
      text-decoration: none;
      transition: transform .2s ease, box-shadow .2s ease;
    }
    .cat-btn-primary {
      background: #128c7e;
      color: #f8fbff;
      box-shadow: 0 14px 28px rgba(18, 140, 126, .22);
    }
    .cat-btn-secondary {
      background: #f8fbff;
      color: #0f2a4a;
      border: 1px solid #cbdff6;
    }
    .cat-btn-primary:hover,
    .cat-btn-secondary:hover {
      transform: translateY(-2px);
    }

    .cat-hero-panel {
      border-radius: 22px;
      padding: 26px;
      display: grid;
      align-content: space-between;
      gap: 22px;
    }
    .cat-device-mark {
      width: 86px;
      height: 86px;
      border-radius: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--category-bg);
      color: #f8fbff;
      font-size: 2.15rem;
      box-shadow: 0 16px 34px rgba(29, 78, 216, .18);
    }
    .cat-panel-stat strong,
    .cat-panel-stat span {
      display: block;
    }
    .cat-panel-stat strong {
      color: #0f2a4a;
      font-family: var(--font-heading, 'Kanit', sans-serif);
      font-size: 4.6rem;
      line-height: .9;
    }
    .cat-panel-stat span {
      color: #536b87;
      font-weight: 800;
    }
    .cat-panel-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .cat-panel-grid div {
      min-height: 86px;
      padding: 14px;
      border-radius: 14px;
      background: #f2f7ff;
      border: 1px solid #dbe7f7;
      color: #0f2a4a;
      display: grid;
      align-content: center;
      gap: 7px;
    }
    .cat-panel-grid i {
      color: #1d4ed8;
    }
    .cat-panel-grid span {
      color: #425b78;
      font-size: .82rem;
      font-weight: 800;
      line-height: 1.25;
    }

    .cat-featured,
    .cat-service-board,
    .cat-support-flow {
      border-radius: 22px;
      padding: 28px;
      margin-bottom: 24px;
    }
    .cat-section-head {
      max-width: 760px;
      margin-bottom: 20px;
    }
    .cat-section-head.compact {
      max-width: 620px;
    }
    .cat-section-head h2,
    .cat-support-flow h2 {
      color: #0f2a4a;
      font-family: var(--font-heading, 'Kanit', sans-serif);
      font-size: clamp(1.45rem, 3vw, 2.25rem);
      line-height: 1.12;
      letter-spacing: 0;
      margin: 10px 0 8px;
    }
    .cat-section-head p,
    .cat-support-flow p {
      color: #536b87;
      line-height: 1.58;
      margin: 0;
    }

    .cat-featured-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }
    .cat-feature-card {
      position: relative;
      min-height: 230px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 20px;
      border-radius: 18px;
      background: linear-gradient(180deg, #f8fbff 0%, #eff6ff 100%);
      border: 1px solid #dbe7f7;
      color: #0f2a4a;
      text-decoration: none;
      transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }
    .cat-feature-card:hover {
      transform: translateY(-3px);
      border-color: #93c5fd;
      box-shadow: 0 16px 36px rgba(15, 42, 74, .12);
    }
    .cat-feature-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
    }
    .cat-feature-top span {
      color: #1d4ed8;
      font-weight: 900;
    }
    .cat-feature-top em,
    .cat-tag-dedicated {
      font-style: normal;
      color: #1e3a8a;
      background: #dbeafe;
      border: 1px solid #bfdbfe;
      border-radius: 999px;
      padding: 4px 9px;
      font-size: .7rem;
      font-weight: 900;
    }
    .cat-feature-card h3 {
      color: #0f2a4a;
      font-size: 1.16rem;
      margin: 0;
      font-weight: 900;
    }
    .cat-feature-card p {
      color: #536b87;
      line-height: 1.55;
      margin: 0;
      flex: 1;
      font-size: .9rem;
    }
    .cat-card-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: auto;
    }
    .cat-card-meta span {
      color: #1e3a8a;
      background: #f2f7ff;
      border: 1px solid #dbe7f7;
      border-radius: 999px;
      padding: 5px 10px;
      font-size: .75rem;
      font-weight: 850;
    }
    .cat-card-next {
      position: absolute;
      right: 18px;
      bottom: 18px;
      color: #1d4ed8;
    }

    .cat-service-list {
      display: grid;
      gap: 10px;
    }
    .cat-service-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 18px;
      align-items: center;
      padding: 16px 18px;
      border-radius: 16px;
      background: #f8fbff;
      border: 1px solid #dbe7f7;
      text-decoration: none;
      transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
    }
    .cat-service-row:hover {
      transform: translateX(3px);
      border-color: #93c5fd;
      box-shadow: 0 12px 26px rgba(15, 42, 74, .08);
    }
    .cat-row-main strong {
      display: block;
      color: #0f2a4a;
      font-size: 1rem;
      margin-bottom: 4px;
    }
    .cat-row-main p {
      color: #536b87;
      font-size: .86rem;
      line-height: 1.45;
      margin: 0;
    }
    .cat-row-meta {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 8px;
      flex-wrap: wrap;
      min-width: 220px;
    }
    .cat-row-meta span:not(.cat-tag-dedicated) {
      color: #1e3a8a;
      background: #eff6ff;
      border: 1px solid #dbeafe;
      border-radius: 999px;
      padding: 5px 9px;
      font-size: .74rem;
      font-weight: 850;
    }
    .cat-row-meta i {
      color: #1d4ed8;
    }

    .cat-support-flow {
      display: grid;
      grid-template-columns: minmax(0, .9fr) minmax(360px, 1.1fr);
      gap: 24px;
      align-items: center;
      background: linear-gradient(135deg, #f6f9fe 0%, #eaf2ff 100%);
    }
    .cat-flow-steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }
    .cat-flow-steps div {
      min-height: 118px;
      padding: 16px;
      border-radius: 16px;
      background: #f8fbff;
      border: 1px solid #dbe7f7;
      display: grid;
      align-content: center;
      gap: 8px;
    }
    .cat-flow-steps strong {
      color: #1d4ed8;
      font-size: 1.25rem;
    }
    .cat-flow-steps span {
      color: #0f2a4a;
      font-weight: 850;
      line-height: 1.3;
    }

    .cat-hub-trust {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      padding: 18px;
      border-radius: 20px;
      margin-top: 6px;
    }
    .cat-hub-trust-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px;
      border-radius: 16px;
      background: #f8fbff;
      border: 1px solid #dbe7f7;
    }
    .cat-hub-trust-item i {
      width: 42px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      background: #eff6ff;
      color: #1d4ed8;
      flex-shrink: 0;
    }
    .cat-hub-trust-item strong {
      display: block;
      color: #0f2a4a;
      font-size: .9rem;
      line-height: 1.22;
    }
    .cat-hub-trust-item small {
      display: block;
      color: #536b87;
      font-size: .76rem;
      margin-top: 3px;
    }

    @media (max-width: 900px) {
      .cat-hero,
      .cat-support-flow {
        grid-template-columns: 1fr;
      }
      .cat-featured-grid,
      .cat-flow-steps,
      .cat-hub-trust {
        grid-template-columns: 1fr;
      }
      .cat-service-row {
        grid-template-columns: 1fr;
      }
      .cat-row-meta {
        justify-content: flex-start;
        min-width: 0;
      }
    }

    @media (max-width: 560px) {
      .cat-hub {
        padding: 34px 0 46px;
      }
      .cat-hero-copy,
      .cat-hero-panel,
      .cat-featured,
      .cat-service-board,
      .cat-support-flow {
        padding: 22px;
      }
      .cat-actions {
        flex-direction: column;
      }
      .cat-btn-primary,
      .cat-btn-secondary {
        width: 100%;
      }
      .cat-panel-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Base>
