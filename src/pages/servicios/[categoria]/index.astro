---
/**
 * Hub de cada categoría de servicios.
 *  /servicios/laptop, /servicios/pc, /servicios/telefono, /servicios/consola, /servicios/impresora
 *
 * Una sola sección con el listado de subservicios. Paleta brand:
 *   --bg deep:    #020617  (azul muy oscuro premium)
 *   --primary:    #3b82f6  (azul brand)
 *   --gold:       #f59e0b
 *   --accent:     #8b5cf6
 * Hereda font-heading 'Kanit' del CSS principal.
 */
import Base from '../../../layouts/Base.astro';
import Navbar3_0 from '../../../components/Navbar3_0.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CommentsSection from '../../../components/CommentsSection.astro';
import { SERVICE_CATEGORIES } from '../../../data/services';

export function getStaticPaths() {
  return SERVICE_CATEGORIES.map((category) => ({
    params: { categoria: category.slug },
    props:  { category },
  }));
}

const { category } = Astro.props;
const canonical = `https://pixon.com.mx/servicios/${category.slug}`;
const title = `Reparación de ${category.title} en Cancún | Pixon PC`;
const description = `Servicios profesionales de reparación de ${category.title.toLowerCase()} en Cancún. ${category.services.length} servicios disponibles, garantía por escrito y diagnóstico gratis.`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio',     item: 'https://pixon.com.mx/' },
      { '@type': 'ListItem', position: 2, name: 'Servicios',  item: 'https://pixon.com.mx/servicios' },
      { '@type': 'ListItem', position: 3, name: category.title, item: canonical },
    ],
  },
];

const waMessage = encodeURIComponent(`Hola, quiero información sobre los servicios de ${category.title}`);
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  image="/LOGOCIRCULAR.png"
  schema={schema}
>
  <Navbar3_0 />

  <Breadcrumb items={[
    { label: 'Inicio',    href: '/' },
    { label: 'Servicios', href: '/servicios' },
    { label: category.title },
  ]} />

  <section class="cat-hub">
    <!-- Capa de fondo gradient para sense of depth -->
    <div class="cat-hub-bg" aria-hidden="true">
      <div class="cat-hub-glow cat-hub-glow-1" style={`background: ${category.heroBg};`}></div>
      <div class="cat-hub-glow cat-hub-glow-2"></div>
    </div>

    <div class="container cat-hub-inner">
      <!-- Header -->
      <header class="cat-hub-header">
        <span class="cat-hub-eyebrow">
          <i class="fa-solid fa-screwdriver-wrench"></i>
          Catálogo {category.title}
        </span>
        <div class="cat-hub-title-row">
          <span class="cat-hub-icon" style={`background: ${category.heroBg};`}>
            <i class={`fa-solid ${category.icon}`} aria-hidden="true"></i>
          </span>
          <h1>
            Reparación de <span class="cat-hub-title-accent">{category.title}</span>
            <small>en Cancún</small>
          </h1>
        </div>
        <p class="cat-hub-lead">
          {category.services.length} servicios profesionales para tu {category.title.toLowerCase()}.
          Diagnóstico siempre gratis y <strong>garantía por escrito</strong>.
        </p>

        <div class="cat-hub-cta-row">
          <a
            href={`https://wa.me/529986690777?text=${waMessage}`}
            target="_blank" rel="noopener noreferrer"
            class="cat-hub-cta-primary"
          >
            <i class="fa-brands fa-whatsapp"></i> Cotizar por WhatsApp
          </a>
          <a href="/contacto" class="cat-hub-cta-secondary">
            <i class="fa-solid fa-phone"></i> Otros medios
          </a>
        </div>
      </header>

      <!-- Grid de servicios -->
      <div class="cat-hub-grid">
        {category.services.map((s) => {
          const href = s.customUrl ?? `/servicios/${category.slug}/${s.slug}`;
          const isExternal = !!s.customUrl;
          return (
            <a href={href} class={`cat-card${isExternal ? ' cat-card--linked' : ''}`}>
              <div class="cat-card-head">
                <span class="cat-card-title">{s.label}</span>
                <i class="fa-solid fa-arrow-right cat-card-arrow" aria-hidden="true"></i>
              </div>
              {s.intro && <p class="cat-card-intro">{s.intro}</p>}
              {(s.fromPrice || s.eta) && (
                <div class="cat-card-meta">
                  {s.fromPrice && <span class="cat-card-price">Desde {s.fromPrice}</span>}
                  {s.eta && <span class="cat-card-eta"><i class="fa-solid fa-clock"></i> {s.eta}</span>}
                </div>
              )}
              {isExternal && (
                <span class="cat-card-linked-tag"><i class="fa-solid fa-link"></i> Servicio dedicado</span>
              )}
            </a>
          );
        })}
      </div>

      <!-- Trust strip al final -->
      <div class="cat-hub-trust">
        <div class="cat-hub-trust-item">
          <i class="fa-solid fa-shield-halved"></i>
          <div>
            <strong>Garantía por escrito</strong>
            <small>en cada servicio</small>
          </div>
        </div>
        <div class="cat-hub-trust-item">
          <i class="fa-solid fa-magnifying-glass"></i>
          <div>
            <strong>Diagnóstico gratis</strong>
            <small>sin compromiso</small>
          </div>
        </div>
        <div class="cat-hub-trust-item">
          <i class="fa-solid fa-truck"></i>
          <div>
            <strong>Recolección en Cancún</strong>
            <small>sin costo en servicios &gt;$800</small>
          </div>
        </div>
        <div class="cat-hub-trust-item">
          <i class="fa-solid fa-clock"></i>
          <div>
            <strong>+7 años</strong>
            <small>de experiencia</small>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CommentsSection viewMoreHref="/comentarios" />

  <Footer />

  <style is:global>
    /* ═══ Hub de categoría — paleta brand #020617 ═══
       Hereda --primary, --gold, --accent del CSS principal */
    .cat-hub {
      position: relative;
      padding: 110px 0 90px;
      background: #020617;
      color: #f1f5f9;
      overflow: hidden;
      isolation: isolate;
    }
    .cat-hub-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }
    .cat-hub-glow {
      position: absolute;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      filter: blur(120px);
      opacity: .35;
    }
    .cat-hub-glow-1 {
      top: -200px; left: -200px;
    }
    .cat-hub-glow-2 {
      bottom: -300px; right: -200px;
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(139,92,246,.4), transparent 60%);
      opacity: .3;
    }
    .cat-hub-inner {
      position: relative;
      z-index: 1;
    }

    /* Header */
    .cat-hub-header {
      max-width: 800px;
      margin: 0 auto 56px;
      text-align: center;
    }
    .cat-hub-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: .78rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .14em;
      color: var(--gold, #f59e0b);
      background: rgba(245, 158, 11, .1);
      border: 1px solid rgba(245, 158, 11, .25);
      padding: 6px 14px;
      border-radius: 999px;
      margin-bottom: 22px;
    }
    .cat-hub-title-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 22px;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }
    .cat-hub-icon {
      width: 76px;
      height: 76px;
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 1.9rem;
      box-shadow: 0 16px 40px rgba(0,0,0,.4), 0 0 0 1px rgba(255,255,255,.08);
      flex-shrink: 0;
    }
    .cat-hub-header h1 {
      font-family: var(--font-heading, 'Kanit', sans-serif);
      font-size: clamp(1.9rem, 4.6vw, 3.1rem);
      font-weight: 800;
      color: #ffffff;
      line-height: 1.1;
      margin: 0;
      text-align: left;
      text-wrap: balance;
    }
    .cat-hub-header h1 small {
      display: block;
      font-size: .55em;
      font-weight: 600;
      color: rgba(255,255,255,.7);
      letter-spacing: .04em;
      margin-top: 4px;
    }
    .cat-hub-title-accent {
      background: linear-gradient(135deg, #fbbf24 0%, #fde68a 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .cat-hub-lead {
      font-size: 1.05rem;
      line-height: 1.6;
      color: rgba(241, 245, 249, .82);
      margin: 0 auto 26px;
      max-width: 620px;
    }
    .cat-hub-lead strong {
      color: var(--gold, #fbbf24);
      font-weight: 700;
    }
    .cat-hub-cta-row {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .cat-hub-cta-primary,
    .cat-hub-cta-secondary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 22px;
      border-radius: 12px;
      font-weight: 700;
      font-size: .95rem;
      text-decoration: none;
      transition: all .15s ease;
    }
    .cat-hub-cta-primary {
      background: linear-gradient(135deg, #25d366, #128c7e);
      color: #ffffff;
      box-shadow: 0 8px 22px rgba(18,140,126,.4);
    }
    .cat-hub-cta-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(18,140,126,.55);
    }
    .cat-hub-cta-secondary {
      background: rgba(255,255,255,.06);
      color: #ffffff;
      border: 1px solid rgba(255,255,255,.16);
    }
    .cat-hub-cta-secondary:hover {
      background: rgba(255,255,255,.12);
      border-color: rgba(255,255,255,.3);
    }

    /* Grid de cards */
    .cat-hub-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 18px;
      margin-bottom: 60px;
    }
    .cat-card {
      background: rgba(255,255,255,.04);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 16px;
      padding: 22px 24px;
      text-decoration: none;
      color: #f1f5f9;
      transition: all .2s ease;
      display: flex;
      flex-direction: column;
      gap: 12px;
      position: relative;
      overflow: hidden;
    }
    .cat-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, var(--primary, #3b82f6), var(--accent, #8b5cf6));
      opacity: 0;
      transition: opacity .2s ease;
    }
    .cat-card:hover {
      transform: translateY(-3px);
      background: rgba(255,255,255,.08);
      border-color: rgba(59,130,246,.4);
      box-shadow: 0 16px 36px rgba(0,0,0,.5), 0 0 0 1px rgba(59,130,246,.15);
    }
    .cat-card:hover::before { opacity: 1; }
    .cat-card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .cat-card-title {
      font-size: 1.02rem;
      font-weight: 700;
      color: #ffffff;
      font-family: var(--font-heading, 'Kanit', sans-serif);
      letter-spacing: .005em;
    }
    .cat-card-arrow {
      color: rgba(255,255,255,.45);
      transition: all .2s;
      font-size: .85rem;
    }
    .cat-card:hover .cat-card-arrow {
      color: var(--gold, #fbbf24);
      transform: translateX(4px);
    }
    .cat-card-intro {
      font-size: .85rem;
      line-height: 1.55;
      color: rgba(241, 245, 249, .7);
      margin: 0;
      flex: 1;
    }
    .cat-card-meta {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: auto;
    }
    .cat-card-price,
    .cat-card-eta {
      font-size: .74rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 999px;
      letter-spacing: .02em;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .cat-card-price {
      background: rgba(245, 158, 11, .15);
      color: #fde68a;
      border: 1px solid rgba(245, 158, 11, .3);
    }
    .cat-card-eta {
      background: rgba(255,255,255,.08);
      color: rgba(241, 245, 249, .85);
      border: 1px solid rgba(255,255,255,.1);
    }
    .cat-card-eta i { font-size: .7em; }
    .cat-card--linked {
      border-style: dashed;
      border-color: rgba(139, 92, 246, .35);
    }
    .cat-card-linked-tag {
      font-size: .7rem;
      font-weight: 700;
      color: #c4b5fd;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    /* Trust strip */
    .cat-hub-trust {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
      padding: 28px 24px;
      background: rgba(2, 6, 23, .6);
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 18px;
      backdrop-filter: blur(8px);
    }
    .cat-hub-trust-item {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .cat-hub-trust-item i {
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      background: rgba(59, 130, 246, .15);
      color: var(--primary, #3b82f6);
      font-size: 1.1rem;
      flex-shrink: 0;
    }
    .cat-hub-trust-item strong {
      display: block;
      font-size: .92rem;
      color: #ffffff;
      font-weight: 700;
      line-height: 1.2;
    }
    .cat-hub-trust-item small {
      display: block;
      font-size: .76rem;
      color: rgba(241, 245, 249, .6);
      margin-top: 3px;
    }

    /* Responsive móvil */
    @media (max-width: 768px) {
      .cat-hub { padding: 70px 0 60px; }
      .cat-hub-header { margin-bottom: 36px; }
      .cat-hub-title-row {
        flex-direction: column;
        gap: 14px;
        text-align: center;
      }
      .cat-hub-header h1 { text-align: center; }
      .cat-hub-icon {
        width: 60px; height: 60px;
        font-size: 1.5rem;
      }
      .cat-hub-cta-row { flex-direction: column; align-items: stretch; }
      .cat-hub-cta-primary, .cat-hub-cta-secondary {
        justify-content: center;
      }
      .cat-hub-grid { grid-template-columns: 1fr; }
      .cat-hub-trust { padding: 20px 16px; }
    }
    @media (max-width: 480px) {
      .cat-hub-glow { display: none; }
    }
  </style>
</Base>
