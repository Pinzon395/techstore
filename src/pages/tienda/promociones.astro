---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import storeCss from '../../styles/store.css?url';
---
<Base
  title="Promociones reales de computadoras y servicios en Cancún | Pixon PC"
  description="Consulta promociones activas, equipos con disponibilidad limitada real y ofertas vendidas de Pixon PC en Cancún."
  canonical="https://pixon.com.mx/tienda/promociones"
  extraStyles={[storeCss]}
  preloadSprite={true}
>
  <Navbar />
  <main class="store-page promotions-page">
    <div class="store-shell"><Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Tienda', href: '/tienda' }, { label: 'Promociones' }]} /></div>
    <header class="store-shell promotions-hero">
      <p class="store-section-label">Datos reales del catálogo</p>
      <h1>Promociones de Pixon PC en Cancún</h1>
      <p>Solo mostramos descuentos, fechas y disponibilidad registrados por administración. Sin contadores ni urgencia inventada.</p>
      <a class="store-action store-action-primary" href="/tienda">Explorar tienda</a>
    </header>
    <section class="store-shell promotions-section" aria-labelledby="active-promotions-title">
      <h2 id="active-promotions-title">Promociones activas</h2>
      <div class="promotions-grid" id="promotions-active"><div class="home-store-skeleton"></div><div class="home-store-skeleton"></div></div>
    </section>
    <section class="store-shell promotions-section" id="promotions-ending-section" aria-labelledby="ending-promotions-title" hidden>
      <h2 id="ending-promotions-title">Terminan pronto</h2>
      <p>Estas fechas provienen de la programación real de cada promoción.</p>
      <div class="promotions-grid" id="promotions-ending"></div>
    </section>
    <section class="store-shell promotions-section" id="last-units-section" aria-labelledby="last-units-title" hidden>
      <h2 id="last-units-title">Últimas unidades</h2>
      <div class="home-store-grid" id="last-units-grid"></div>
    </section>
    <section class="store-shell promotions-section" aria-labelledby="sold-promotions-title">
      <h2 id="sold-promotions-title">Ofertas que ya volaron</h2>
      <p>Publicaciones vendidas que siguen visibles como referencia histórica.</p>
      <div class="home-store-grid" id="sold-promotions-grid"></div>
    </section>
  </main>
  <Footer />
  <script src="/scripts/store-promotions.js?v=20260812-1" is:inline defer></script>
</Base>

