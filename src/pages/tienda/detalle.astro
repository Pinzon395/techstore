---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CartDrawer from '../../components/store/CartDrawer.astro';
import storeCss from '../../styles/store.css?url';
---

<Base
  title="Producto de la tienda | Pixon PC"
  description="Consulta precio, disponibilidad, condición y detalles de una publicación de Pixon PC en Cancún."
  canonical="https://pixon.com.mx/tienda"
  robots="noindex, follow"
  extraStyles={[storeCss]}
  preloadSprite={true}
>
  <Navbar />

  <main class="store-page store-detail-page runtime-product-page" data-runtime-product>
    <nav class="store-shell runtime-product-breadcrumb" aria-label="Migas de pan">
      <a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/tienda">Tienda</a><span aria-hidden="true">/</span><span id="runtime-breadcrumb-name">Publicación</span>
    </nav>

    <section class="store-shell runtime-product-loading" id="runtime-product-loading" role="status">
      <span class="store-spinner" aria-hidden="true"></span>
      <p>Consultando precio, contenido y disponibilidad…</p>
    </section>

    <section class="store-shell runtime-product-error" id="runtime-product-error" hidden aria-labelledby="runtime-error-title">
      <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
      <h2 id="runtime-error-title">No pudimos abrir esta publicación</h2>
      <p id="runtime-error-message">La publicación no está disponible o cambió de dirección.</p>
      <div><a class="store-action store-action-primary" href="/tienda">Volver a la tienda</a><a class="store-action store-action-secondary" href="/tickets">Crear ticket de consulta</a></div>
    </section>

    <div id="runtime-product-content" hidden>
      <section class="product-detail" aria-labelledby="product-title">
        <div class="store-shell product-detail-grid">
          <div class="product-gallery">
            <div class="product-main-image">
              <img id="runtime-product-image" src="/assets/images/tienda-hero-pixon.webp" alt="" width="900" height="700" fetchpriority="high" decoding="async" />
              <span class="product-sold-stamp" id="runtime-sold-stamp" hidden>VENDIDO</span>
            </div>
            <div class="product-thumbnails" id="runtime-product-thumbnails" aria-label="Galería de la publicación" hidden></div>
          </div>

          <div class="product-buy-panel">
            <div class="product-badges" id="runtime-product-badges"></div>
            <h1 id="product-title">Publicación de Pixon PC</h1>
            <p class="product-lead" id="runtime-product-lead"></p>
            <div class="product-price-block">
              <del id="runtime-product-original-price" hidden></del>
              <strong id="runtime-product-price">Precio a consultar</strong>
              <span id="runtime-product-saving" hidden></span>
            </div>
            <dl class="product-quick-facts">
              <div><dt>Disponibilidad</dt><dd id="runtime-product-availability">Consultando…</dd></div>
              <div><dt>Condición</dt><dd id="runtime-product-condition">—</dd></div>
              <div><dt>Garantía</dt><dd id="runtime-product-warranty">—</dd></div>
            </dl>
            <div class="product-buy-actions">
              <button class="store-action store-action-primary" id="runtime-add-to-cart" type="button" data-add-to-cart disabled>Consultando disponibilidad…</button>
              <a class="store-action store-action-secondary" id="runtime-product-whatsapp" href="https://wa.me/529986690777" target="_blank" rel="noopener noreferrer">Consultar antes de comprar</a>
            </div>
            <ul class="product-trust-list">
              <li>El servidor valida nuevamente precio y stock al confirmar.</li>
              <li>Atención local de Pixon PC en Cancún.</li>
              <li>Garantía documentada cuando corresponda.</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="store-shell product-information" aria-labelledby="runtime-product-specs-title">
        <article>
          <h2 id="runtime-product-specs-title">Especificaciones y estado</h2>
          <p id="runtime-product-description"></p>
          <dl class="product-spec-table" id="runtime-product-attributes"></dl>
        </article>
        <aside>
          <h2>Antes de confirmar</h2>
          <p>La entrega incluye únicamente lo descrito en esta publicación. Confirma accesorios, compatibilidad, instalación y alcance del servicio antes de pagar.</p>
          <a href="/tickets">Crear ticket de consulta</a>
        </aside>
      </section>
    </div>
  </main>

  <CartDrawer showLauncher={true} />
  <Footer />
  <script src="/scripts/store-cart.js?v=20260819-1" is:inline defer></script>
  <script src="/scripts/store-runtime-product.js?v=20260819-1" is:inline defer></script>
</Base>
