                <img loading="lazy" src="/assets/images/optimizacion-pc-cancun.png" alt="Optimización antes"
                    style="width:100%; aspect-ratio:16/9; object-fit:cover; border-radius:20px; box-shadow:0 20px 40px rgba(0,0,0,0.1);">
                <img loading="lazy" src="/assets/images/reparacion-sulfatacion-cancun.jpeg" alt="Optimización después"
                    style="width:100%; aspect-ratio:16/9; object-fit:cover; border-radius:20px; box-shadow:0 20px 40px rgba(0,0,0,0.1);">
