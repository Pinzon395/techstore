  <Footer />
</Base>

<script>
  const params = new URLSearchParams(window.location.search);
  const section = params.get('section');
  if (section) { const target = document.getElementById(section); if (target) setTimeout(() => target.scrollIntoView({ behavior: 'smooth' }), 300); }
  if (window.location.hash) { const target = document.querySelector(window.location.hash); if (target) setTimeout(() => target.scrollIntoView({ behavior: 'smooth' }), 300); }
</script>
