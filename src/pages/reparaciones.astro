---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FaqSection from '../components/FaqSection.astro';
import CommentsSection from '../components/CommentsSection.astro';
import ContactSection from '../components/ContactSection.astro';
import ServiceTicketSection from '../components/ServiceTicketSection.astro';

const repairFaqs = [
  {
    icon: 'fa-solid fa-magnifying-glass-chart',
    question: '¿El diagnóstico realmente es gratis?',
    answer: 'Sí. Revisamos tu equipo y te explicamos la falla antes de iniciar. Si decides no reparar, no hay costo por el diagnóstico general.',
  },
  {
    icon: 'fa-solid fa-truck-fast',
    question: '¿Tienen recolección y entrega a domicilio en Cancún?',
    answer: 'Sí. Podemos recolectar y entregar en zonas de Cancún como Zona Hotelera, Haciendas, Supermanzanas, Polígono Sur, Huayacán y Puerto Morelos. Te confirmamos disponibilidad por WhatsApp.',
  },
  {
    icon: 'fa-solid fa-clock',
    question: '¿Cuánto tarda una reparación?',
    answer: 'Las reparaciones de software suelen tomar de 24 a 48 horas. Las reparaciones de hardware dependen del daño y de la disponibilidad de refacciones. Si es urgente, podemos revisar prioridad express.',
  },
  {
    icon: 'fa-solid fa-shield-halved',
    question: '¿Mis archivos están seguros durante la reparación?',
    answer: 'Sí. Trabajamos con cuidado para proteger tu información. Si el servicio implica formateo, cambio de disco o recuperación, primero te explicamos el riesgo y pedimos autorización.',
  },
  {
    icon: 'fa-solid fa-screwdriver-wrench',
    question: '¿Reparan laptops, PC, celulares, consolas e impresoras?',
    answer: 'Sí. Atendemos laptops, computadoras de escritorio, celulares, consolas, controles e impresoras. También hacemos mantenimiento, limpieza interna, optimización, instalación de Windows y reparaciones por falla física o electrónica.',
  },
  {
    icon: 'fa-solid fa-file-signature',
    question: '¿Las reparaciones tienen garantía?',
    answer: 'Sí. Entregamos garantía por escrito sobre el trabajo realizado. La cobertura depende del tipo de reparación y de la pieza instalada, y te la explicamos antes de cerrar el servicio.',
  },
];
---

<Base
  title="Reparación de equipos en Cancún | PCs, laptops, celulares y más"
  description="Servicio técnico en Cancún para computadoras, laptops, celulares e impresoras, diagnóstico claro, reparación profesional y atención rápida para todo tipo de equipos."
  canonical="https://pixon.com.mx/reparaciones"
  image="/assets/images/instalacion-windows-cancun.jpeg"
  schema={[
    {
        "@context": "https://schema.org",
        "@type": "Service",
        "name": "Reparacion de Computadoras Laptops y Celulares en Cancun",
        "provider": {
            "@type": "LocalBusiness",
            "name": "Pixon PC",
            "url": "https://pixon.com.mx",
            "telephone": "+529986690777",
            "image": "https://pixon.com.mx/assets/logos/Logo.svg",
            "priceRange": "$$"
        },
        "areaServed": {
            "@type": "City",
            "name": "Cancun"
        },
        "serviceType": "Reparacion tecnica de equipos",
        "url": "https://pixon.com.mx/reparaciones",
        "description": "Reparacion profesional de laptops PCs celulares consolas e impresoras en Cancun con diagnostico gratuito y garantia por escrito."
    },
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": repairFaqs.map((item) => ({
            "@type": "Question",
            "name": item.question,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": item.answer.replace(/<[^>]*>/g, '')
            }
        }))
    },
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Inicio",
                "item": "https://pixon.com.mx/"
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": "Reparaciones",
                "item": "https://pixon.com.mx/reparaciones"
            }
        ]
    }
]}
>
  <Navbar />
