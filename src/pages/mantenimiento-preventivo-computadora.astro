:100%}}@media(max-width:520px){.mpc-hero{padding-top:104px}.mpc-card-grid,.mpc-included__grid{grid-template-columns:1fr}.mpc-inline-cta{flex-direction:column;align-items:flex-start}.mpc-inline-cta a{white-space:normal}.mpc-actions .mpc-btn{width:100%}.mpc-safe{padding:16px}}
