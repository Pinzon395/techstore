---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FaqSection from '../components/FaqSection.astro';
import ServiceTicketSection from '../components/ServiceTicketSection.astro';

const canonical = 'https://pixon.com.mx/mantenimiento-preventivo-computadora';
const pageTitle = 'Mantenimiento de Computadoras en Canc\u00fan | Pixon PC';
const pageDescription = 'Mantenimiento preventivo de computadoras en Canc\u00fan. Limpieza interna, revisi\u00f3n t\u00e9rmica y servicio para PC de oficina y gamer. Cotiza por WhatsApp.';
const whatsappText = 'Hola Pixon. Quiero cotizar mantenimiento preventivo para mi computadora. Mi equipo es: ______ y presenta: ______.';
const whatsappUrl = `https://wa.me/529986690777?text=${encodeURIComponent(whatsappText)}`;

const signals = [
  ['fa-temperature-half', 'La PC se calienta demasiado', 'Si el gabinete expulsa aire muy caliente o la temperatura sube en tareas normales, conviene revisar polvo, ventilacion, disipador y carga real. No todos los casos tienen la misma causa.'],
  ['fa-fan', 'Los ventiladores suenan fuerte', 'Un ventilador puede aumentar de velocidad al jugar o renderizar. Si el ruido es constante, aparece sin carga o cambio de forma repentina, merece una revision.'],
  ['fa-gauge-high', 'Baja el rendimiento o los FPS', 'CPU y GPU pueden reducir velocidad cuando trabajan con temperatura alta. Tambien hay otras causas: almacenamiento, memoria, software o configuracion; se revisa el conjunto.'],
  ['fa-power-off', 'Se apaga o reinicia', 'Algunos equipos se protegen por temperatura, pero una fuente, un cable, Windows o un componente tambien pueden causar apagados. Se diagnostica antes de atribuirlo al calor.'],
  ['fa-box-open', 'Hay polvo visible o filtros tapados', 'El polvo en rejillas, filtros o ventiladores suele ser una buena razon para revisar el interior, especialmente si la computadora esta cerca del piso o se usa todos los dias.'],
  ['fa-clock-rotate-left', 'Lleva mucho tiempo sin revision', 'Una PC de oficina, gamer o estacion de trabajo acumula residuos a un ritmo distinto segun su entorno, horas de uso, mascotas, ventilacion y tipo de gabinete.'],
];

const maintenanceSteps = [
  ['01', 'Revision del equipo y sus sintomas', 'Recibimos el modelo, tipo de uso y lo que notas: ruido, calor, reinicios, polvo o perdida de rendimiento.'],
  ['02', 'Confirmacion del alcance', 'Antes de intervenir se revisa la condicion visible y se confirma que procedimiento corresponde al gabinete y sus componentes.'],
  ['03', 'Limpieza interna autorizada', 'Se atienden filtros, ventiladores, rejillas, gabinete y zonas accesibles del sistema de enfriamiento segun el equipo.'],
  ['04', 'Revision termica cuando aplica', 'Disipador, pasta termica, radiador o AIO se evalúan por condicion. No se cambia material termico automaticamente en cada computadora.'],
  ['05', 'Comprobacion general', 'Se verifica el funcionamiento general despues del servicio y se explican hallazgos o recomendaciones que requieran otra cotizacion.'],
];

const includedItems = [
  ['Gabinete y filtros', 'Revisamos entradas, salidas y filtros de aire cuando el diseno los incluye.'],
  ['Ventiladores y disipadores', 'Se revisa la acumulacion de polvo y el estado visible de ventiladores, disipador de CPU y flujo de aire.'],
  ['GPU, radiadores y AIO', 'En PC gamer se considera el sistema de enfriamiento instalado y sus necesidades reales de mantenimiento.'],
  ['Conexiones accesibles', 'Se observa el orden y estado general de conexiones accesibles sin prometer una reparacion que no haya sido diagnosticada.'],
];

const faqs = [
  { question: '\u00bfQu\u00e9 incluye un mantenimiento preventivo de computadora?', answer: 'Incluye una revision orientada a limpieza interna, ventilacion y estado general. El alcance cambia segun gabinete, componentes, nivel de polvo y sintomas; primero se confirma que necesita el equipo.' },
  { question: '\u00bfCu\u00e1nto cuesta el mantenimiento de una PC en Canc\u00fan?', answer: 'El costo depende del tipo de computadora, estado, nivel de suciedad y si requiere una atencion adicional. Por eso la cotizacion se confirma despues de conocer el equipo y el alcance autorizado.' },
  { question: '\u00bfCada cu\u00e1nto debo darle mantenimiento a mi computadora?', answer: 'No existe un plazo identico para todas. Importan el uso, polvo, mascotas, ubicacion del gabinete, ventilacion, juegos, renderizado y horas de trabajo.' },
  { question: '\u00bfPor qu\u00e9 mi computadora se calienta demasiado?', answer: 'Puede relacionarse con polvo, flujo de aire, disipador, ventiladores, carga de CPU o GPU, pasta termica o una falla distinta. Una revision ayuda a no asumir una causa unica.' },
  { question: '\u00bfPor qu\u00e9 los ventiladores de mi PC hacen mucho ruido?', answer: 'Pueden subir de velocidad bajo carga. Si lo hacen todo el tiempo, en tareas ligeras o el ruido cambio de golpe, conviene revisar temperatura, ventilacion y desgaste del ventilador.' },
  { question: '\u00bfEl polvo puede afectar el rendimiento de una computadora?', answer: 'Puede limitar el flujo de aire y contribuir a temperaturas elevadas. Cuando el equipo reduce frecuencias por proteccion termica puede sentirse lento, aunque almacenamiento, RAM y software tambien influyen.' },
  { question: '\u00bfEl mantenimiento incluye cambio de pasta termica?', answer: 'Se evalua cuando corresponde. La pasta termica no debe cambiarse por rutina sin considerar temperatura, montaje del disipador, uso y condicion real del sistema.' },
  { question: '\u00bfCu\u00e1ndo debo cambiar la pasta termica del procesador?', answer: 'Cuando la revision encuentre que es pertinente por condicion o comportamiento termico. Un problema de calor tambien puede venir de ventilacion, disipador, bomba, voltaje o aire caliente dentro del gabinete.' },
  { question: '\u00bfUna PC gamer necesita mantenimiento mas seguido?', answer: 'Puede necesitar revision antes si trabaja muchas horas con juegos, renderizado o alta carga. GPU, CPU, radiador, filtros y airflow se valoran segun la configuracion y el entorno.' },
  { question: '\u00bfEl mantenimiento borra mis archivos?', answer: 'La limpieza fisica no necesita borrar archivos. Si se detecta una accion de software o almacenamiento, se explica y se solicita autorizacion por separado.' },
  { question: '\u00bfCu\u00e1nto tarda el mantenimiento de una computadora?', answer: 'Depende de los componentes, nivel de suciedad, pruebas y carga de trabajo. Se indica un tiempo estimado despues de revisar el caso, sin prometer un plazo igual para todos los equipos.' },
  { question: '\u00bfTambien hacen mantenimiento de PC gamer?', answer: 'Si. Revisamos PC gamer, computadoras de escritorio, estaciones de trabajo y equipos de oficina. Cada configuracion requiere un alcance distinto de limpieza y revision termica.' },
  { question: '\u00bfRevisan CPU y GPU?', answer: 'La revision se adapta al hardware instalado. CPU, GPU, ventiladores, disipador, radiador o AIO se consideran cuando forman parte del sintoma o del alcance autorizado.' },
  { question: '\u00bfAtienden computadoras de oficina?', answer: 'Si. Una computadora administrativa tambien puede acumular polvo, ruido o temperatura con el tiempo. Para lotes o necesidades empresariales existe una ruta de soporte para empresas.' },
  { question: '\u00bfPuedo cotizar por WhatsApp?', answer: 'Si. Comparte si es PC de oficina, gamer o estacion de trabajo, junto con el modelo de componentes si lo conoces y los sintomas que presenta.' },
];

const faqSchema = faqs.map(({ question, answer }) => ({
  '@type': 'Question',
  name: question,
  acceptedAnswer: { '@type': 'Answer', text: answer },
}));
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  image="/assets/images/mantenimiento-pc-escritorio.webp"
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'Service',
      '@id': `${canonical}#service`,
      name: 'Mantenimiento de computadoras en Canc\u00fan',
      serviceType: 'Mantenimiento preventivo de computadora y limpieza interna de PC',
      url: canonical,
      description: pageDescription,
      provider: { '@id': 'https://pixon.com.mx/#business' },
      areaServed: [
        { '@type': 'City', name: 'Canc\u00fan' },
        { '@type': 'AdministrativeArea', name: 'Quintana Roo' },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://pixon.com.mx/' },
        { '@type': 'ListItem', position: 2, name: 'Servicios', item: 'https://pixon.com.mx/servicios' },
        { '@type': 'ListItem', position: 3, name: 'Mantenimiento de computadoras', item: canonical },
      ],
    },
    { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqSchema },
  ]}
>
  <Navbar />
  <main id="main-content" class="mpc-page">
    <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Servicios', href: '/servicios' }, { label: 'Mantenimiento de computadoras' }]} />

    <section class="mpc-hero" aria-labelledby="mpc-title">
      <div class="container mpc-hero__grid">
        <div class="mpc-hero__copy">
          <p class="mpc-eyebrow"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Servicio t&eacute;cnico en Canc&uacute;n</p>
          <h1 id="mpc-title">Mantenimiento de computadoras en Canc&uacute;n</h1>
          <p class="mpc-lead">Limpieza interna, revisi&oacute;n del sistema de ventilaci&oacute;n y mantenimiento preventivo para computadoras de escritorio, PC gamer y equipos de trabajo.</p>
          <p class="mpc-problem">Si tu computadora se calienta, hace demasiado ruido o tiene meses sin limpieza, revisamos su condici&oacute;n antes de que una falla peque&ntilde;a se convierta en un problema mayor.</p>
          <div class="mpc-actions">
            <a class="mpc-btn mpc-btn--primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-wa-link data-event-placement="hero"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Cotizar mantenimiento por WhatsApp</a>
            <a class="mpc-btn mpc-btn--secondary" href="#incluye">Ver qu&eacute; incluye</a>
          </div>
          <ul class="mpc-badges" aria-label="Alcance del servicio"><li>Atenci&oacute;n en Canc&uacute;n</li><li>PC de oficina y gamer</li><li>Revisi&oacute;n seg&uacute;n el equipo</li></ul>
        </div>
        <figure class="mpc-hero__media">
          <img src="/assets/images/mantenimiento-pc-escritorio.webp" alt="Mantenimiento preventivo de computadora de escritorio en Pixon PC Canc&uacute;n" width="1200" height="800" loading="eager" fetchpriority="high" />
          <figcaption><i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i> El alcance se confirma de acuerdo con el hardware y sus s&iacute;ntomas.</figcaption>
        </figure>
      </div>
    </section>

    <section class="mpc-section mpc-intro" aria-labelledby="intro-title">
      <div class="container mpc-split">
        <div class="mpc-heading">
          <span>Revision preventiva</span>
          <h2 id="intro-title">&iquest;Qu&eacute; incluye el mantenimiento preventivo de una computadora?</h2>
          <p>El mantenimiento preventivo busca revisar y atender acumulaci&oacute;n de polvo, ventilaci&oacute;n y condiciones visibles antes de que se conviertan en una molestia diaria. No es lo mismo que una reparaci&oacute;n correctiva: si detectamos una falla, se explica antes de hacer un trabajo adicional.</p>
          <p>En una PC de escritorio, el procedimiento puede incluir gabinete, filtros, ventiladores, disipador, cableado visible y comprobaci&oacute;n general. La pasta t&eacute;rmica, thermal pads, radiador o AIO solo se valoran cuando el equipo y su condici&oacute;n lo justifican.</p>
        </div>
        <aside class="mpc-note">
          <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
          <h3>Precio y alcance claros</h3>
          <p>El costo cambia por tipo de PC, configuraci&oacute;n, suciedad y trabajo requerido. Primero conocemos tu caso; no publicamos un precio gen&eacute;rico que pueda no aplicar a tu equipo.</p>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-wa-link data-event-placement="price">Pedir cotizaci&oacute;n por WhatsApp <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </aside>
      </div>
    </section>

    <section class="mpc-section mpc-signals" aria-labelledby="signals-title">
      <div class="container">
        <div class="mpc-heading"><span>Senales de alerta</span><h2 id="signals-title">Se&ntilde;ales de que tu PC necesita mantenimiento</h2><p>Estos s&iacute;ntomas no reemplazan un diagn&oacute;stico, pero ayudan a saber cu&aacute;ndo conviene solicitar mantenimiento de computadora en Canc&uacute;n.</p></div>
        <div class="mpc-card-grid">{signals.map(([icon, title, text]) => <article class="mpc-card"><i class={`fa-solid ${icon}`} aria-hidden="true"></i><h3>{title}</h3><p>{text}</p></article>)}</div>
        <div class="mpc-inline-cta"><p><strong>&iquest;Tu PC presenta alguno de estos s&iacute;ntomas?</strong> Dinos si es de oficina, gamer o de trabajo y qu&eacute; sucede.</p><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-wa-link data-event-placement="symptoms">Solicitar revisi&oacute;n <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div>
      </div>
    </section>

    <section id="incluye" class="mpc-section mpc-included" aria-labelledby="included-title">
      <div class="container">
        <div class="mpc-heading mpc-heading--center"><span>Limpieza interna de PC</span><h2 id="included-title">Mantenimiento de computadora pensado para el hardware real</h2><p>Una limpieza interna de computadora no consiste solo en retirar polvo visible. El sistema de refrigeraci&oacute;n se revisa como un conjunto: entradas de aire, filtros, ventiladores, disipadores y salida del aire caliente.</p></div>
        <div class="mpc-included__grid">{includedItems.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}</div>
        <div class="mpc-safe"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><p>La fuente de poder se revisa externamente y seg&uacute;n un procedimiento seguro. No recomendamos abrirla ni intentar limpiarla por dentro sin el conocimiento y las herramientas adecuadas.</p></div>
      </div>
    </section>

    <section class="mpc-section mpc-climate" aria-labelledby="climate-title">
      <div class="container mpc-climate__grid">
        <figure><img src="/assets/images/mantenimiento-pastaternima-thermalpads.webp" alt="Revision termica de componentes durante mantenimiento de PC" width="1200" height="800" loading="lazy" decoding="async" /></figure>
        <div class="mpc-heading">
          <span>Contexto local</span>
          <h2 id="climate-title">&iquest;Por qu&eacute; el clima de Canc&uacute;n importa para una PC?</h2>
          <p>El calor, la humedad ambiental, el polvo y la ubicaci&oacute;n del gabinete pueden cambiar las condiciones de trabajo de una computadora. Una PC debajo del escritorio, cerca del piso o en un espacio poco ventilado suele acumular residuos con mayor facilidad.</p>
          <p>En determinados entornos, la combinaci&oacute;n de humedad, polvo y ventilaci&oacute;n deficiente puede favorecer residuos, elevar temperaturas y acelerar algunos problemas de corrosi&oacute;n. No significa que cada PC vaya a fallar, pero s&iacute; que una revisi&oacute;n oportuna ayuda a detectar se&ntilde;ales antes de asumir una reparaci&oacute;n.</p>
          <p>Atendemos en Canc&uacute;n, Quintana Roo. Si vienes de Canc&uacute;n Centro, Huayac&aacute;n, Pol&iacute;gono Sur, Zona Hotelera o Puerto Ju&aacute;rez, consulta primero la opci&oacute;n adecuada para tu equipo.</p>
        </div>
      </div>
    </section>

    <section class="mpc-section mpc-gaming" aria-labelledby="gaming-title">
      <div class="container mpc-gaming__grid">
        <div class="mpc-heading">
          <span>PC gamer y alto rendimiento</span>
          <h2 id="gaming-title">Mantenimiento para PC gamer en Canc&uacute;n</h2>
          <p>Gaming, render, arquitectura y sesiones largas pueden exigir m&aacute;s a CPU y GPU. Si una PC gamer pierde FPS, sus ventiladores trabajan al m&aacute;ximo o el gabinete concentra calor, conviene revisar el airflow y el sistema de refrigeraci&oacute;n completo.</p>
          <p>Dependiendo de la configuraci&oacute;n, se pueden valorar ventiladores, filtros, disipador, GPU, radiador, AIO y pasta t&eacute;rmica. <em>Thermal throttling</em> es una reducci&oacute;n de velocidad para proteger componentes cuando la temperatura es alta; no es un diagn&oacute;stico por s&iacute; solo.</p>
          <a class="mpc-text-link" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-wa-link data-event-placement="gaming">Solicitar mantenimiento para PC gamer <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </div>
        <figure><img src="/assets/images/pc-gamer-gama-alta.webp" alt="Limpieza interna y mantenimiento para PC gamer" width="1200" height="800" loading="lazy" decoding="async" /></figure>
      </div>
    </section>

    <section class="mpc-section mpc-work" aria-labelledby="work-title">
      <div class="container mpc-split">
        <div class="mpc-heading"><span>Oficina y trabajo</span><h2 id="work-title">Mantenimiento para computadoras de oficina y trabajo</h2><p>Las computadoras administrativas, estaciones de dise&ntilde;o y equipos de negocio tambi&eacute;n necesitan una ventilaci&oacute;n razonable y una revisi&oacute;n peri&oacute;dica. El objetivo es detectar ruido, suciedad o comportamiento t&eacute;rmico que afecte estabilidad y productividad.</p><p>Esta página orienta sobre un equipo individual. Si necesitas organizar varios equipos, consulta el <a href="/servicios/mantenimiento-preventivo-pc-empresas">mantenimiento preventivo para empresas</a>; para redes, usuarios o atención recurrente visita <a href="/empresas">soporte TI para empresas en Cancún</a>.</p></div>
        <ol class="mpc-steps" aria-label="Proceso de mantenimiento">{maintenanceSteps.map(([number, title, text]) => <li><span>{number}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol>
      </div>
    </section>

    <section class="mpc-section mpc-related" aria-labelledby="related-title">
      <div class="container"><div class="mpc-heading"><span>Servicios relacionados</span><h2 id="related-title">Cuando el s&iacute;ntoma necesita una revisi&oacute;n m&aacute;s espec&iacute;fica</h2><p>Esta p&aacute;gina se concentra en PC de escritorio. Para otro tipo de equipo o problema, estas rutas ayudan a encontrar el servicio correcto sin mezclar intenciones.</p></div><div class="mpc-related__grid"><a href="/servicios/pc/refrigeracion"><i class="fa-solid fa-fan" aria-hidden="true"></i><span>Problemas de temperatura y refrigeraci&oacute;n de PC</span></a><a href="/servicios/pc/limpieza-profunda"><i class="fa-solid fa-spray-can-sparkles" aria-hidden="true"></i><span>Limpieza interna de PC</span></a><a href="/servicios/pc/upgrade"><i class="fa-solid fa-memory" aria-hidden="true"></i><span>Mejoras de rendimiento para PC</span></a><a href="/servicios/pc/mantenimiento-correctivo"><i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i><span>Mantenimiento correctivo de computadora</span></a><a href="/limpieza-laptop"><i class="fa-solid fa-laptop" aria-hidden="true"></i><span>&iquest;Buscas mantenimiento para laptop?</span></a></div></div>
    </section>

    <section class="mpc-final" aria-labelledby="final-title"><div class="container mpc-final__inner"><div><p>Consulta directa</p><h2 id="final-title">&iquest;Tu computadora se calienta o hace demasiado ruido?</h2><span>Escr&iacute;benos qu&eacute; equipo tienes, qu&eacute; problema presenta y desde cu&aacute;ndo ocurre. Te orientamos sobre la revisi&oacute;n que corresponde.</span></div><a class="mpc-btn mpc-btn--primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-wa-link data-event-placement="final_cta"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Cotizar por WhatsApp</a></div></section>

    <FaqSection title="Preguntas frecuentes sobre mantenimiento de computadoras" description="Respuestas claras sobre limpieza interna, ventiladores, temperatura, pasta termica y mantenimiento preventivo de PC." items={faqs} id="mantenimiento-computadora-faq" questionColor="#071F3A" />
    <ServiceTicketSection id="ticket" defaultDevice="PC" defaultService="mantenimiento preventivo de computadora" sourcePage="/mantenimiento-preventivo-computadora" />
  </main>
  <Footer />
</Base>

<script is:inline>
  (function () {
    var page = 'mantenimiento-preventivo-computadora';
    if (typeof window.gtag === 'function') {
      window.gtag('event', 'view_service', { page: page, service: 'mantenimiento_preventivo_pc' });
    }
    document.addEventListener('click', function (event) {
      var target = event.target;
      var link = target && target.closest ? target.closest('[data-wa-link]') : null;
      if (!link || typeof window.gtag !== 'function') return;
      window.gtag('event', 'whatsapp_click', {
        page: page,
        placement: link.getAttribute('data-event-placement') || 'unknown',
      });
    });
  })();
</script>

<style>
  .mpc-page{color:#071F3A;background:#f8fafc}.mpc-hero{padding:clamp(104px,13vw,146px) 0 66px;background:#071F3A;color:#fff;overflow:hidden}.mpc-hero,.mpc-final{background-color:#071F3A!important}.mpc-hero__grid,.mpc-split,.mpc-climate__grid,.mpc-gaming__grid{display:grid;gap:clamp(28px,5vw,66px);align-items:center}.mpc-hero__grid{grid-template-columns:minmax(0,1.05fr) minmax(300px,.8fr)}.mpc-eyebrow,.mpc-heading>span{display:inline-flex;align-items:center;gap:8px;color:#67e8f9;font-size:.78rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.mpc-hero h1{max-width:760px;margin:14px 0 20px;font-family:var(--font-heading);font-size:clamp(2.35rem,5vw,4.35rem);line-height:1.02;color:#fff}.mpc-lead{max-width:710px;margin:0;color:#fff;font-size:clamp(1.08rem,2vw,1.3rem);line-height:1.65}.mpc-problem{max-width:670px;margin:17px 0 27px;color:#dbeafe;line-height:1.66}.mpc-actions{display:flex;flex-wrap:wrap;gap:12px}.mpc-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:48px;padding:13px 20px;border-radius:10px;font-weight:800;text-decoration:none;transition:transform .18s ease,box-shadow .18s ease,background .18s ease}.mpc-btn:hover{transform:translateY(-2px)}.mpc-btn:focus-visible,.mpc-text-link:focus-visible,.mpc-inline-cta a:focus-visible,.mpc-related a:focus-visible,.mpc-note a:focus-visible{outline:3px solid #f59e0b;outline-offset:3px}.mpc-btn--primary{background:#16a34a;color:#fff;box-shadow:0 12px 25px rgba(22,163,74,.25)}.mpc-btn--primary:hover{background:#15803d}.mpc-btn--secondary{border:1px solid rgba(255,255,255,.45);color:#fff}.mpc-badges{display:flex;flex-wrap:wrap;gap:8px;margin:24px 0 0;padding:0;list-style:none}.mpc-badges li{padding:6px 10px;border:1px solid rgba(186,230,253,.28);border-radius:100px;background:rgba(255,255,255,.08);font-size:.82rem}.mpc-hero__media,.mpc-climate figure,.mpc-gaming figure{margin:0;overflow:hidden;border-radius:18px;background:#fff;box-shadow:0 28px 58px rgba(0,0,0,.14)}.mpc-he