---
import globalCss from '../styles/global.css?url';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  schema?: object[];
  lang?: 'es' | 'en';
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  image = '/LOGOCIRCULAR.png',
  schema = [],
  lang = 'es',
} = Astro.props;

const siteUrl = 'https://pixon.com.mx';
const fullCanonical = canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`;
const fullImage = image.startsWith('http') ? image : `${siteUrl}${image}`;

const defaultSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Pixon PC",
    "url": siteUrl,
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": `${siteUrl}/?s={search_term_string}`
      },
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "ProfessionalService"],
    "@id": `${siteUrl}/#business`,
    "name": "Pixon PC",
    "description": "Servicio técnico privado de reparación de computadoras, laptops, celulares e impresoras a domicilio en Cancún. Recolección y entrega en toda la ciudad. Mantenimiento preventivo, ensamble de PCs gamer y soporte B2B empresarial. Garantía por escrito. English Spoken.",
    "url": siteUrl,
    "telephone": "+529986690777",
    "priceRange": "$$",
    "image": `${siteUrl}/LOGOCIRCULAR.png`,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/LOGOCIRCULAR.png`,
      "width": 512,
      "height": 512
    },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Circuito Hacienda Chimay, Fraccionamiento Haciendas Real del Caribe",
      "addressLocality": "Cancún",
      "addressRegion": "Quintana Roo",
      "postalCode": "77539",
      "addressCountry": "MX"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 21.1375,
      "longitude": -86.8462
    },
    "areaServed": [
      { "@type": "City", "name": "Cancún" },
      { "@type": "Place", "name": "Zona Hotelera Cancún" },
      { "@type": "Place", "name": "Supermanzanas Cancún" },
      { "@type": "Place", "name": "Polígono Sur Cancún" },
      { "@type": "Place", "name": "Huayacán Cancún" },
      { "@type": "Place", "name": "Puerto Morelos" }
    ],
    "serviceArea": {
      "@type": "GeoCircle",
      "geoMidpoint": {
        "@type": "GeoCoordinates",
        "latitude": 21.1375,
        "longitude": -86.8462
      },
      "geoRadius": "25000"
    },
    "openingHoursSpecification": [{
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "09:00",
      "closes": "19:00"
    }],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "47",
      "bestRating": "5",
      "worstRating": "1"
    },
    "sameAs": [
      "https://www.facebook.com/people/Pixon-PC/61556271364935/",
      "https://www.instagram.com/pixonpc/",
      "https://www.tiktok.com/@pixonpc",
      "https://www.youtube.com/@pixonpc"
    ]
  }
];

const allSchema = [...defaultSchema, ...schema];
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="index, follow">
  <link rel="canonical" href={fullCanonical} />

  <link rel="icon" href="/favicon.png" type="image/png" sizes="any">
  <link rel="icon" type="image/png" sizes="192x192" href="/LOGOCIRCULAR.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#2563eb">

  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={fullCanonical}>
  <meta property="og:image" content={fullImage}>
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_MX'}>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={fullImage}>

  <style is:inline>:root{--bg-main:#f8f9fc;--bg-darker:#fff;--bg-card:#fff;--border-color:#e2e8f0;--primary:#3b82f6;--primary-hover:#2563eb;--secondary:#6366f1;--accent:#8b5cf6;--gold:#f59e0b;--text-main:#0f172a;--text-muted:#475569;--font-heading:'Kanit',sans-serif;--font-main:'Red Hat Display',sans-serif;--section-padding:40px 0;--transition:all .3s ease}*{margin:0;padding:0;box-sizing:border-box}body{background-color:var(--bg-main);color:var(--text-main);line-height:1.6;font-family:var(--font-main);overflow-x:hidden}.container{max-width:1200px;margin:0 auto;padding:0 clamp(30px,3vw,20px)}.navbar{position:fixed;top:0;left:0;width:100%;z-index:1000;padding:8px 20px;background:rgba(255,255,255,.9);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border-bottom:1px solid rgba(0,0,0,.05)}.nav-container{max-width:1200px;margin:0 auto;padding:0 20px;display:flex;justify-content:space-between;align-items:center;min-height:50px}.logo{font-size:1.5rem;color:var(--text-main);display:flex;align-items:center;gap:8px;font-family:var(--font-heading);text-decoration:none}.nav-menu{display:flex;gap:30px;align-items:center;list-style:none}.nav-links{font-size:.95rem;font-weight:700;color:var(--text-main);opacity:.8;text-decoration:none}.low-end-mode .navbar{backdrop-filter:none!important;-webkit-backdrop-filter:none!important;background:rgba(255,255,255,.98)!important}.low-end-mode *{animation-duration:.01ms!important;transition-duration:.01ms!important}.reduced-motion .navbar{backdrop-filter:none!important;-webkit-backdrop-filter:none!important}</style>
  <link rel="stylesheet" href={globalCss} media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href={globalCss}></noscript>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="dns-prefetch" href="//www.googletagmanager.com">
  <link rel="dns-prefetch" href="//wa.me">
  <link rel="dns-prefetch" href="//img.youtube.com">
  <link rel="dns-prefetch" href="//www.youtube.com">

  <link rel="alternate" hreflang="es-MX" href={`${siteUrl}/`} />
  <link rel="alternate" hreflang="en" href={`${siteUrl}/en`} />
  <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

  <link rel="preload"
    href="https://fonts.googleapis.com/css2?family=Fugaz+One&family=Red+Hat+Display:wght@400;600;700&display=swap"
    as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript>
    <link
      href="https://fonts.googleapis.com/css2?family=Fugaz+One&family=Red+Hat+Display:wght@400;600;700&display=swap"
      rel="stylesheet">
  </noscript>
  <link rel="preload" as="image" href="/assets/icons/sprite.svg" />

  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-ZRD2NG8MKH', { anonymize_ip: true });
    window.addEventListener('load', function () {
      var s = document.createElement('script');
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-ZRD2NG8MKH';
      s.async = true;
      document.head.appendChild(s);
    });
  </script>

  {allSchema.map((s) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}

  <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests; block-all-mixed-content">

  <script is:inline>
    (function(){var e=!1;navigator.connection&&(navigator.connection.saveData&&(e=!0),/2g/.test(navigator.connection.effectiveType)&&(e=!0),navigator.connection.downlink<.5&&(e=!0));navigator.deviceMemory&&navigator.deviceMemory<2&&(e=!0);navigator.hardwareConcurrency&&navigator.hardwareConcurrency<4&&(e=!0);(/Android\s([0-9])/i.test(navigator.userAgent)&&parseInt(navigator.userAgent.match(/Android\s([0-9])/i)[1])<10)&&(e=!0);e&&document.documentElement.classList.add('low-end-mode');window.matchMedia('(prefers-reduced-motion:reduce)').matches&&document.documentElement.classList.add('reduced-motion')})();
  </script>
  <script is:inline>
    function smartWaRedirect(url) {
      var isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
      if (isMobile) { window.location.href = url; } else { window.open(url, '_blank'); }
    }
  </script>
</head>
<body class="light-theme">
  <slot />

  <script>
    import { initSmoothScroll, scrollToSection } from '../lib/smooth-scroll';
    initSmoothScroll();

    const params = new URLSearchParams(window.location.search);
    const sectionId = params.get('section');
    if (sectionId) {
      setTimeout(() => {
        const fixedHeader = document.querySelector('#navbar');
        const offset = fixedHeader ? (fixedHeader as HTMLElement).offsetHeight + 20 : 80;
        scrollToSection(sectionId, offset);
        if (window.history.replaceState) {
          window.history.replaceState({}, document.title, window.location.pathname);
        }
      }, 400);
    }
    if (window.location.hash) {
      setTimeout(() => {
        scrollToSection(window.location.hash.slice(1), 80);
      }, 400);
    }
  </script>
</body>
</html>
