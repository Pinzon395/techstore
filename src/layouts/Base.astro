---
import globalCss from '../styles/global.css?url';
import {
  buildShippingServiceSchema,
  cleanSchemaList,
} from '../lib/schema';
import { getEnglishRoute, getLanguageAlternates } from '../lib/english-routes';
import { getLocaleFromPath, normalizeRoutePath } from '../lib/i18n';
import WhatsappFloat from '../components/WhatsappFloat.astro';
import BackToTopButton from '../components/BackToTopButton/BackToTopButton.astro';
import RegistrationDiscount from '../components/RegistrationDiscount.astro';
import EnglishSupportBanner from '../components/EnglishSupportBanner.astro';
import { business } from '../lib/business';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  schema?: object[];
  lang?: 'es' | 'en';
  bodyClass?: string;
  preloadSprite?: boolean;
  ogTitle?: string;
  ogDescription?: string;
  robots?: string;
  extraStyles?: string[];
  alternateLinks?: Array<{ hreflang: string; href: string }>;
  activeView?: string;
  allowFaqSchema?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  image = '/LOGOCIRCULAR.png',
  schema = [],
  lang = getLocaleFromPath(Astro.originPathname),
  bodyClass = 'light-theme',
  preloadSprite = false,
  ogTitle = title,
  ogDescription = description,
  robots,
  extraStyles = [],
  alternateLinks = [],
  activeView,
  allowFaqSchema = false,
} = Astro.props;

const siteUrl = business.siteUrl;
const fullCanonical = canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`;
const fullImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
const normalizedPath = normalizeRoutePath(Astro.originPathname);
const isPrivateCommerceFlow = normalizedPath === '/carrito'
  || normalizedPath === '/checkout'
  || normalizedPath === '/en/cart'
  || normalizedPath === '/en/checkout'
  || normalizedPath.startsWith('/pedido/');
const isPrivateRoute = [
  '/admin',
  '/api',
  '/auth',
  '/dashboard',
  '/panel',
  '/cuenta',
  '/tickets',
  '/en/account',
  '/en/tickets',
].some((prefix) => normalizedPath === prefix || normalizedPath.startsWith(`${prefix}/`));
const isDiagnosticFirstService = normalizedPath === '/servicios/telefono/celular-mojado';
const shouldShowRegistrationDiscount = normalizedPath !== '/404'
  && !isPrivateRoute
  && !isPrivateCommerceFlow
  && normalizedPath !== '/tienda'
  && normalizedPath !== '/en/store'
  && !isDiagnosticFirstService;
const shouldShowEnglishSupportBanner = lang === 'es'
  && normalizedPath !== '/404'
  && !isPrivateRoute
  && !isPrivateCommerceFlow;
const effectiveRobots = robots;
const resolvedAlternateLinks = alternateLinks.length > 0
  ? alternateLinks
  : getLanguageAlternates(normalizedPath, siteUrl);
const businessDescription = lang === 'en'
  ? 'Appointment-based computer, laptop, phone and printer repair in Cancun. Device diagnosis and repair scope are confirmed before work begins.'
  : 'Servicio técnico con cita previa para computadoras, laptops, celulares e impresoras en Cancún. El diagnóstico y alcance se confirman antes de reparar.';

const defaultSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    "name": business.name,
    "url": `${siteUrl}/`
  },
  {
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "ProfessionalService", "OnlineStore"],
    "@id": `${siteUrl}/#business`,
    "name": "Pixon PC",
    "legalName": "Pixon PC",
    "description": businessDescription,
    "url": siteUrl,
    "telephone": business.phone,
    "email": business.email,
    "priceRange": "$$",
    "currenciesAccepted": "MXN",
    "image": `${siteUrl}/LOGOCIRCULAR.png`,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/LOGOCIRCULAR.png`,
      "width": 512,
      "height": 512
    },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Cto. Hacienda Chimay",
      "addressLocality": "Cancún",
      "addressRegion": "Quintana Roo",
      "postalCode": "77539",
      "addressCountry": "MX"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 21.0512,
      "longitude": -86.8475
    },
    "areaServed": [
      "Cancún",
      "Zona Hotelera Cancún",
      "Huayacán",
      "Polígono Sur",
      "Puerto Juárez",
      "Puerto Morelos",
      "Costa Mujeres",
      "Playa Mujeres",
      "Punta Sam",
      "Isla Blanca"
    ],
    "hasShippingService": [buildShippingServiceSchema()],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Servicios de reparación y mantenimiento",
      "itemListElement": [
        {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Reparación de laptop en Cancún"}},
        {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Mantenimiento de PC Gamer en Cancún"}},
        {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Reparación de celular en Cancún"}},
        {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Soporte técnico para empresas en Cancún"}}
      ]
    },
    "sameAs": [
      "https://www.facebook.com/people/Pixon-PC/61556271364935/",
      "https://www.instagram.com/pixonpc/",
      "https://www.tiktok.com/@pixonpc",
      "https://www.youtube.com/@pixonpc"
    ]
  }
];

const isGlobalSchema = (item: any) => {
  const type = item?.['@type'];
  const types = Array.isArray(type) ? type : [type];
  return types.some((value) => ['WebSite', 'LocalBusiness', 'ProfessionalService', 'Organization'].includes(value));
};

const getSchemaTypes = (item: any) => {
  const type = item?.['@type'];
  return Array.isArray(type) ? type : [type].filter(Boolean);
};

// Las FAQ solo se marcan cuando la página las mantiene en HTML visible y verificable.
// El contenido actual no cumple esa condición de forma consistente.
const isFaqSchema = (item: any) => getSchemaTypes(item).includes('FAQPage');

const mergeSchemaList = (baseSchema: any[], pageItems: any[]) => {
  const merged = baseSchema.map((item) => ({ ...item }));
  const extra: any[] = [];

  for (const item of pageItems) {
    if (!isGlobalSchema(item)) {
      extra.push(item);
      continue;
    }

    const itemTypes = getSchemaTypes(item);
    const index = merged.findIndex((baseItem) =>
      getSchemaTypes(baseItem).some((type) => itemTypes.includes(type))
    );

    if (index >= 0) {
      merged[index] = { ...merged[index], ...item };
    } else {
      extra.push(item);
    }
  }

  return [...merged, ...extra];
};

const allSchema = cleanSchemaList(mergeSchemaList(defaultSchema, schema))
  .filter((item) => item && (allowFaqSchema || !isFaqSchema(item)));
const htmlLang = lang === 'en' ? 'en' : 'es-MX';
---

<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content={effectiveRobots}>
  <link rel="canonical" href={fullCanonical} />
  {resolvedAlternateLinks.map((alternate) => (
    <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
  ))}

  <link rel="icon" href="/favicon.png" type="image/png" sizes="any">
  <link rel="icon" type="image/png" sizes="192x192" href="/LOGO192.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#2563eb">
  <link rel="manifest" href="/manifest.json">

  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={fullCanonical}>
  <meta property="og:image" content={fullImage}>
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_MX'}>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={ogTitle}>
  <meta name="twitter:description" content={ogDescription}>
  <meta name="twitter:image" content={fullImage}>

  <style is:inline>:root{--page-gutter-desktop:50px;--page-gutter-tablet:36px;--page-gutter-mobile:20px;--page-gutter:var(--page-gutter-desktop);--bg-main:#f8f9fc;--bg-darker:#fff;--bg-card:#fff;--border-color:#e2e8f0;--primary:#3b82f6;--primary-hover:#2563eb;--secondary:#6366f1;--accent:#8b5cf6;--gold:#f59e0b;--text-main:#0f172a;--text-muted:#475569;--font-heading:'Kanit',sans-serif;--font-main:'Red Hat Display',sans-serif;--section-padding:40px 0;--transition:all .3s ease}@media (max-width:1023px){:root{--page-gutter:var(--page-gutter-tablet)}}@media (max-width:767px){:root{--page-gutter:var(--page-gutter-mobile)}}*{margin:0;padding:0;box-sizing:border-box}body{background-color:var(--bg-main);color:var(--text-main);line-height:1.6;font-family:var(--font-main);overflow-x:hidden}.container{max-width:1200px;margin:0 auto;padding-left:max(var(--page-gutter),env(safe-area-inset-left));padding-right:max(var(--page-gutter),env(safe-area-inset-right))}.navbar{position:fixed;top:0;left:0;width:100%;z-index:1000;padding:8px 0;background:rgba(255,255,255,.9);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border-bottom:1px solid rgba(0,0,0,.05)}.nav-container{max-width:1200px;margin:0 auto;padding-left:max(var(--page-gutter),env(safe-area-inset-left));padding-right:max(var(--page-gutter),env(safe-area-inset-right));display:flex;justify-content:space-between;align-items:center;min-height:50px}.logo{font-size:1.5rem;color:var(--text-main);display:flex;align-items:center;gap:8px;font-family:var(--font-heading);text-decoration:none}.nav-menu{display:flex;gap:30px;align-items:center;list-style:none}.nav-links{font-size:.95rem;font-weight:700;color:var(--text-main);opacity:.8;text-decoration:none}.low-end-mode .navbar{backdrop-filter:none!important;-webkit-backdrop-filter:none!important;background:rgba(255,255,255,.98)!important}.low-end-mode *{animation-duration:.01ms!important;transition-duration:.01ms!important}.reduced-motion .navbar{backdrop-filter:none!important;-webkit-backdrop-filter:none!important}.svc-icon{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;color:#fff;margin-bottom:20px;flex-shrink:0}</style>

  <style is:inline>.skip-to-content{position:fixed;top:12px;left:12px;z-index:10000;transform:translateY(-160%);background:#0f172a;color:#fff;padding:10px 14px;border-radius:10px;font-weight:800;text-decoration:none;box-shadow:0 12px 30px rgba(15,23,42,.25)}.skip-to-content:focus{transform:translateY(0);outline:3px solid #f59e0b;outline-offset:3px}#main-content:focus{outline:none}</style>
  <link rel="stylesheet" href={globalCss}>
  {extraStyles.map((href) => <link rel="stylesheet" href={href} />)}
  {activeView && <meta name="pixon-active-view" content={activeView} />}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  </noscript>
  <link rel="stylesheet" href="/styles/icon-compat.css">
  <script is:inline>
  (function(){
    if(customElements.get('alert-box'))return;
    var ICO={
      warning:"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512' fill='%23d97706'%3E%3Cpath d='M256 32c14.2 0 27.3 7.5 34.5 19.8l216 368c7.3 12.4 7.3 27.7 .2 40.1S489.9 480 475.7 480H36.3c-14.2 0-27.2-7.5-34.5-19.8s-7.1-27.8 .2-40.1l216-368C225.1 39.5 238.2 32 252.4 32h3.6zm0 128c-13.3 0-24 10.7-24 24V296c0 13.3 10.7 24 24 24s24-10.7 24-24V184c0-13.3-10.7-24-24-24zm32 224a32 32 0 1 0-64 0 32 32 0 1 0 64 0z'/%3E%3C/svg%3E",
      info:"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512' fill='%232563eb'%3E%3Cpath d='M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512zM216 336h24V272H216c-13.3 0-24-10.7-24-24s10.7-24 24-24h48c13.3 0 24 10.7 24 24v88h8c13.3 0 24 10.7 24 24s-10.7 24-24 24H216c-13.3 0-24-10.7-24-24s10.7-24 24-24zm40-208a32 32 0 1 1 0 64 32 32 0 1 1 0-64z'/%3E%3C/svg%3E",
      success:"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512' fill='%2310b981'%3E%3Cpath d='M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512zM369 209L241 337c-9.4 9.4-24.6 9.4-33.9 0l-64-64c-9.4-9.4-9.4-24.6 0-33.9s24.6-9.4 33.9 0l47 47L335 175c9.4-9.4 24.6-9.4 33.9 0s9.4 24.6 0 33.9z'/%3E%3C/svg%3E"
    };
    var CFG={
      warning:{bg:'#fffbeb',border:'#fcd34d',color:'#92400e',iconBg:'#fef3c7'},
      info:{bg:'#eff6ff',border:'#93c5fd',color:'#1e3a5f',iconBg:'#dbeafe'},
      success:{bg:'#ecfdf5',border:'#6ee7b7',color:'#065f46',iconBg:'#d1fae5'}
    };
    class AlertBox extends HTMLElement{
      connectedCallback(){
        if(this.dataset.r)return;this.dataset.r='1';
        var self=this;
        requestAnimationFrame(function(){
          var t=self.getAttribute('type')||'info';
          var c=CFG[t]||CFG.info;
          var ico=ICO[t]||ICO.info;
          var html=self.innerHTML.trim();
          self.style.display='block';
          self.innerHTML='<div style="display:flex;align-items:flex-start;gap:10px;background:'+c.bg+';border:1px solid '+c.border+';border-radius:10px;padding:10px 14px;margin-bottom:10px;font-size:.83rem;color:'+c.color+';font-weight:600;line-height:1.5"><span style="display:inline-flex;align-items:center;justify-content:center;background:'+c.iconBg+';border-radius:50%;width:26px;height:26px;min-width:26px;flex-shrink:0;margin-top:1px;background-image:url('+ico+');background-size:14px 14px;background-repeat:no-repeat;background-position:center"></span><span>'+html+'</span></div>';
        });
      }
    }
    customElements.define('alert-box',AlertBox);
  })();
  </script>

  <link rel="preload"
      href="https://fonts.googleapis.com/css2?family=Kanit:wght@600;700&family=Red+Hat+Display:wght@400;600;700&display=swap"
    as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript>
    <link
      href="https://fonts.googleapis.com/css2?family=Kanit:wght@600;700&family=Red+Hat+Display:wght@400;600;700&display=swap"
      rel="stylesheet">
  </noscript>
  {preloadSprite && <link rel="preload" as="image" href="/assets/icons/sprite.svg" />}

  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-ZRD2NG8MKH', { anonymize_ip: true });
    window.addEventListener('load', function () {
      var s = document.createElement('script');
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-ZRD2NG8MKH';
      s.async = true;
      document.head.appendChild(s);
    });
  </script>

  {allSchema.map((s) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}

  <script is:inline>
    (function(){
      var mq = window.matchMedia('(max-width: 750px)');
      if (mq.matches) {
        var style = document.createElement('style');
        style.textContent = '.navbar2 .mega-menu{display:none!important}.navbar2 .dropdown-menu{display:none}.navbar2 .has-dropdown.open .dropdown-menu,.navbar2 .has-dropdown.open .mega-menu{display:block!important}';
        document.head.appendChild(style);
      }
    })();
  </script>
  <script is:inline>
    (function(){var e=!1;navigator.connection&&(navigator.connection.saveData&&(e=!0),/2g/.test(navigator.connection.effectiveType)&&(e=!0),navigator.connection.downlink<.5&&(e=!0));navigator.deviceMemory&&navigator.deviceMemory<=4&&(e=!0);navigator.hardwareConcurrency&&navigator.hardwareConcurrency<4&&(e=!0);(/Android\s([0-9])/i.test(navigator.userAgent)&&parseInt(navigator.userAgent.match(/Android\s([0-9])/i)[1])<10)&&(e=!0);e&&document.documentElement.classList.add('low-end-mode');window.matchMedia('(prefers-reduced-motion:reduce)').matches&&document.documentElement.classList.add('reduced-motion')})();
  </script>
  <script is:inline>
    function smartWaRedirect(url) {
      var isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
      if (isMobile) { window.location.href = url; } else { window.open(url, '_blank'); }
    }
  </script>
  <script is:inline src="/scripts/scroll-restore.js?v=20260602-2"></script>
  <slot name="head" />
</head>
<body class={bodyClass} data-pixon-lang={lang}>
  <a class="skip-to-content" href="#main-content">{lang === 'en' ? 'Skip to main content' : 'Saltar al contenido principal'}</a>
  <div id="main-content" tabindex="-1">
    {shouldShowEnglishSupportBanner && <EnglishSupportBanner href={getEnglishRoute(normalizedPath)} />}
    <slot />
    {shouldShowRegistrationDiscount && (
      <RegistrationDiscount
        discount="30%"
        loginHref="/auth/google?returnTo=%2Ftickets"
        guestHref="/tickets"
        lang={lang}
      />
    )}
    <script defer src="/scripts/faq-accordion.js?v=20260804-1"></script>
  </div>
  <WhatsappFloat lang={lang} />
  <BackToTopButton />
  <script is:inline defer src="/scripts/floating-dock.js?v=20260930-cart-clearance"></script>

  <script>
    import '../../components/cookies/CookieBanner.js';
    import { initSmoothScroll, scrollToSection } from '../lib/smooth-scroll';
    initSmoothScroll();

    const params = new URLSearchParams(window.location.search);
    const sectionId = params.get('section');
    const fixedHeader = document.querySelector('#navbar');
    const offset = fixedHeader ? (fixedHeader as HTMLElement).offsetHeight + 20 : 80;
    if (sectionId) {
      requestAnimationFrame(() => {
        scrollToSection(sectionId, offset);
        if (window.history.replaceState) {
          window.history.replaceState({}, document.title, window.location.pathname);
        }
      });
    }
    if (window.location.hash) {
      requestAnimationFrame(() => {
        scrollToSection(window.location.hash.slice(1), offset);
      });
    }
  </script>
  <script defer src="/scripts/user-menu.js"></script>
  <script defer src="/scripts/locale-preference.js"></script>
  <script defer src="/cache-buster.js?v=20261001T200712Z-12187f097dae"></script>
  <script defer src="/scripts/tracker.js"></script>
  <script defer src="/scripts/pwa-register.js?v=20261001T200712Z-12187f097dae"></script>
</body>
</html>
