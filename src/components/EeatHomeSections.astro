    <div class="eeat-heading">
      <span>Reseñas verificables</span>
      <h2 data-google-review-summary>{googleRating} estrellas basado en {googleReviewCount} opiniones de Google</h2>
      <p>Clientes reales califican a Pixon PC en Google Business. Puedes revisar el perfil público, ubicación, horario y opiniones antes de agendar.</p>
    </div>

    <div class="google-proof-card">
      <div class="google-score">
        <span>{googleRating}</span>
        <strong aria-label={`${googleRating} de 5 estrellas`}>★★★★★</strong>
        <small>{googleReviewCount} opiniones en Google</small>
      </div>
      <div class="google-business-copy">
        <span class="google-business-label">Perfil de Negocio verificado</span>
        <h3>Pixon PC</h3>
        <p>Servicio de reparación de teléfonos, laptops, computadoras, consolas e impresoras en Cancún. Atención por cita, diagnóstico claro y garantía por escrito.</p>
        <div class="google-business-meta" aria-label="Datos del perfil de negocio">
          <span>Haciendas, 77539 Cancún, Q.R.</span>
          <span>998 669 0777</span>
          <span>Abre 9:00 a.m.</span>
        </div>
      </div>
      <a class="google-proof-link" href={googleMapsUrl} target="_blank" rel="noopener noreferrer" data-google-maps-link>
        <svg viewBox="0 0 488 512" width="17" height="17" aria-hidden="true"><path fill="currentColor" d="M488 261.8C488 403.3 391.1 504 248 504 110.8 504 0 393.2 0 256S110.8 8 248 8c66.8 0 123 24.5 166.3 64.9l-67.5 64.9C258.5 52.6 94.3 116.6 94.3 256c0 86.5 69.1 156.6 153.7 156.6 98.2 0 135-70.4 140.8-106.9H248v-85.3h236.1c2.3 12.7 3.9 24.9 3.9 41.4z"/></svg>
        Ver perfil en Google Maps
      </a>
    </div>

    <div class="google-review-grid" data-review-list>
      {fallbackReviews.map((review) => (
        <article class="google-review-card">
          <div class="review-avatar" aria-hidden="true">{review.name.charAt(0)}</div>
          <div>
            <div class="review-card-head">
              <h3>{review.name}</h3>
              <p class="review-stars" aria-label={`${review.rating} estrellas`}>★★★★★</p>
            </div>
            <p class="review-date">{review.date}</p>
            <div class="review-text" data-review-text>
              <p>{review.text}</p>
            </div>
            <button class="review-more" type="button" data-review-toggle hidden aria-expanded="false">Ver mas</button>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

