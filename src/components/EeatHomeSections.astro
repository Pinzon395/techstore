const catalogCategories = ['Todos', ...Array.from(new Set(catalogItems.map((item) => item.category)))];
const catalogFilters = catalogCategories.map((name) => ({
  name,
  count: name === 'Todos' ? catalogItems.length : catalogItems.filter((item) => item.category === name).length,
}));

const schema = [
