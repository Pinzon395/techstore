---
interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="breadcrumb" class="breadcrumb-container">
  <div class="container">
    <ol class="breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
      {items.map((item, i) => (
        <li
          itemprop="itemListElement"
          itemscope itemtype="https://schema.org/ListItem"
          {...(i === items.length - 1 ? { 'aria-current': 'page' } : {})}
        >
          {item.href ? (
            <a href={item.href} itemprop="item"><span itemprop="name">{item.label}</span></a>
          ) : (
            <span itemprop="name">{item.label}</span>
          )}
          <meta itemprop="position" content={String(i + 1)} />
        </li>
      ))}
    </ol>
  </div>
</nav>

<style>
  .breadcrumb-container {
    margin-top: var(--breadcrumb-navbar-offset, 58px);
    position: relative;
    z-index: 20;
    background: #f1f5f9;
    color: #071f3a;
  }

  .breadcrumb-container :global(.breadcrumb) {
    color: #475569 !important;
  }

  .breadcrumb-container :global(li),
  .breadcrumb-container :global(span) {
    color: #071f3a !important;
  }

  .breadcrumb-container :global(a) {
    color: #1d4ed8 !important;
  }

  .breadcrumb-container :global(li + li::before) {
    color: #94a3b8 !important;
  }

  /* Cuando el banner de Visiting Cancun está presente en la página, no duplicar el offset */
  :global(#main-content:has(.english-support-banner) .breadcrumb-container),
  :global(.english-support-banner ~ * .breadcrumb-container),
  :global(.english-support-banner ~ .breadcrumb-container),
  :global(body:has(.english-support-banner) .breadcrumb-container) {
    margin-top: 0 !important;
  }

  @media (max-width: 768px) {
    .breadcrumb-container {
      margin-top: var(--breadcrumb-navbar-offset-mobile, 54px);
    }

    :global(#main-content:has(.english-support-banner) .breadcrumb-container),
    :global(.english-support-banner ~ * .breadcrumb-container),
    :global(.english-support-banner ~ .breadcrumb-container),
    :global(body:has(.english-support-banner) .breadcrumb-container) {
      margin-top: 0 !important;
    }
  }
</style>
