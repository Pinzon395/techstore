  .xbox-liquid-form__intro > p { margin: 0 0 10px; color: #087b99; font-size: .75rem; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
  .xbox-liquid-form h2 { margin: 0; color: #071F3A; font-family: var(--font-heading); font-size: clamp(1.8rem, 3.1vw, 2.65rem); line-height: 1.08; }
