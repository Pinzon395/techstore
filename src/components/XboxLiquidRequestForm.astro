<section id="solicitar-revision" class="xbox-liquid-form" aria-labelledby="xbox-liquid-form-title">
  <div class="container xbox-liquid-form__shell">
    <div class="xbox-liquid-form__intro">
      <p>Revisi&oacute;n con contexto</p>
      <h2 id="xbox-liquid-form-title">Explica qu&eacute; pas&oacute; antes de mover tu Xbox</h2>
      <span>Esta información ayuda a preparar la revisión. No pedimos dirección completa hasta confirmar la opción de atención.</span>
    </div>
    <form id="xbox-liquid-request-form" class="xbox-liquid-form__form">
      <div class="xbox-liquid-form__grid">
        <label><span>Modelo <b>*</b></span><select name="modelo" required><option value="">Selecciona tu Xbox</option><option>Xbox Series X</option><option>Xbox Series S</option><option>Xbox One</option><option>Otro modelo</option></select></label>
        <label><span>&iquest;Qu&eacute; pas&oacute;? <b>*</b></span><select name="liquido" required><option value="">Selecciona una opci&oacute;n</option><option>Se mojó con agua</option><option>Le cayó bebida o refresco</option><option>Estuvo expuesto a humedad</option><option>No estoy seguro</option></select></label>
        <label><span>S&iacute;ntoma <b>*</b></span><select name="sintoma" required><option value="">Selecciona una opci&oacute;n</option><option>No prende</option><option>Prende y se apaga</option><option>No da imagen</option><option>Otro</option></select></label>
        <label><span>&iquest;Cu&aacute;ndo ocurri&oacute;? <b>*</b></span><select name="cuando" required><option value="">Selecciona una opci&oacute;n</option><option>Hoy</option><option>Ayer</option><option>Hace varios días</option></select></label>
        <label><span>Zona <b>*</b></span><input name="zona" required type="text" placeholder="Ej. Zona Hotelera, Cumbres" autocomplete="address-level2" /></label>
        <label><span>WhatsApp <b>*</b></span><input name="whatsapp" required type="tel" inputmode="tel" autocomplete="tel" placeholder="Tu número de contacto" /></label>
      </div>
      <label class="xbox-liquid-form__comment"><span>Comentario</span><textarea name="comentario" rows="4" placeholder="Indica si sigue encendiendo, qué líquido fue y cualquier detalle que ayude a revisar el caso."></textarea></label>
      <p><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Te llevamos a WhatsApp con el resumen. No conectes la consola solo para probarla.</p>
      <button type="submit"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Enviar caso por WhatsApp</button>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#xbox-liquid-request-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const value = (name: string) => String(data.get(name) || '').trim() || 'No indicado';
    const message = [
      'Hola Pixon PC. Necesito revisión para un Xbox mojado.',
      '',
      `Modelo: ${value('modelo')}`,
      `Qué líquido fue: ${value('liquido')}`,
      `Síntoma: ${value('sintoma')}`,
      `Cuándo ocurrió: ${value('cuando')}`,
      `Zona: ${value('zona')}`,
      `¿Sigue encendiendo?: ${value('sintoma') === 'No prende' ? 'No' : 'Por confirmar'}`,
      `WhatsApp: ${value('whatsapp')}`,
      `Comentario: ${value('comentario')}`,
    ].join('\n');
    const href = `https://wa.me/529986690777?text=${encodeURIComponent(message)}`;
    const popup = window.open(href, '_blank', 'noopener,noreferrer');
    if (!popup) window.location.assign(href);
  });
</script>

