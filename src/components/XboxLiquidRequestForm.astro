  .xbox-liquid-form__form { border: 1px solid #c8e6ed; border-radius: 18px; padding: clamp(17px, 3vw, 27px); background: #fff; box-shadow: 0 18px 40px rgba(7,31,58,.09); }
  .xbox-liquid-form__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 13px; }
  .xbox-liquid-form label { display: grid; gap: 7px; min-width: 0; color: #071F3A; font-size: .86rem; font-weight: 850; }
  .xbox-liquid-form b { color: #087b99; }
  .xbox-liquid-form input, .xbox-liquid-form select, .xbox-liquid-form textarea { width: 100%; min-height: 46px; border: 1px solid #bed8e1; border-radius: 10px; padding: 11px 12px; background: #fff; color: #071F3A; font: inherit; font-size: .93rem; }
  .xbox-liquid-form textarea { min-height: 100px; resize: vertical; }
  .xbox-liquid-form__comment { margin-top: 13px; }
  .xbox-liquid-form__form > p { display: flex; align-items: flex-start; gap: 8px; margin: 15px 0; color: #071F3A; font-size: .82rem; line-height: 1.45; }
  .xbox-liquid-form__form > p i { margin-top: 2px; color: #087b99; }
  .xbox-liquid-form button { display: inline-flex; width: 100%; min-height: 48px; align-items: center; justify-content: center; gap: 9px; border: 1px solid #129b64; border-radius: 10px; padding: 12px; background: #0d9b5e; color: #fff; font: inherit; font-weight: 900; cursor: pointer; transition: transform 160ms cubic-bezier(.23,1,.32,1), background 160ms ease; }
  .xbox-liquid-form input:focus-visible, .xbox-liquid-form select:focus-visible, .xbox-liquid-form textarea:focus-visible, .xbox-liquid-form button:focus-visible { outline: 3px solid #f59e0b; outline-offset: 2px; }
  @media (hover:hover) and (pointer:fine) { .xbox-liquid-form button:hover { background:#078653; transform:translateY(-1px); } }
  .xbox-liquid-form button:active { transform: scale(.985); }
  @media (max-width: 800px) { .xbox-liquid-form__shell { grid-template-columns: 1fr; gap: 24px; } }
  @media (max-width: 540px) { .xbox-liquid-form__grid { grid-template-columns: 1fr; } .xbox-liquid-form__form { padding: 16px; border-radius: 15px; } }
  @media (prefers-reduced-motion: reduce) { .xbox-liquid-form button { transition: none; } }
</style>
