---
import '../../styles/admin-commerce.css';

const modules = [
  { view: 'commerce-store', path: '/admin/commerce/store', icon: 'fa-cart-shopping', title: 'Tienda', text: 'Productos, fichas técnicas, multimedia, precios y publicación.' },
  { view: 'commerce-dashboard', path: '/admin/commerce/sales', icon: 'fa-chart-line', title: 'Ventas', text: 'Ingresos confirmados, rentabilidad, periodos y actividad comercial.' },
  { view: 'commerce-orders', path: '/admin/commerce/orders', icon: 'fa-bag-shopping', title: 'Pedidos', text: 'Clientes, artículos, estados, timeline y preparación.' },
  { view: 'commerce-payments', path: '/admin/commerce/payments', icon: 'fa-credit-card', title: 'Pagos', text: 'Transacciones, comprobantes, revisión y trazabilidad.' },
  { view: 'commerce-inventory', path: '/admin/commerce/inventory', icon: 'fa-boxes-stacked', title: 'Inventario', text: 'Existencias, reservas, alertas y movimientos auditados.' },
  { view: 'commerce-promotions', path: '/admin/commerce/promotions', icon: 'fa-tags', title: 'Promociones', text: 'Descuentos, vigencias, alcance y presentación pública.' },
  { view: 'commerce-settings', path: '/admin/commerce/payment-methods', icon: 'fa-sliders', title: 'Métodos de pago', text: 'Disponibilidad e instrucciones que recibe el cliente.' },
];
---

<section id="view-commerce" class="admin-section commerce-admin commerce-hub" style="display:none;" aria-labelledby="commerce-hub-title">
  <div class="commerce-command">
    <div>
      <p class="commerce-kicker">Centro de operaciones</p>
      <h2 id="commerce-hub-title">Commerce</h2>
      <p>Administra catálogo, ventas, pedidos, cobros e inventario desde módulos conectados.</p>
    </div>
    <a class="commerce-button commerce-button-secondary" href="/tienda" target="_blank" rel="noopener noreferrer">Ver tienda pública</a>
  </div>

  <nav class="commerce-module-grid" aria-label="Módulos de Commerce">
    {modules.map((module) => (
      <a class="commerce-module-card" href={module.path} data-view-target={module.view} aria-controls={`view-${module.view}`}>
        <span class="commerce-module-icon" aria-hidden="true"><i class={`fa-solid ${module.icon}`}></i></span>
        <span class="commerce-module-copy"><strong>{module.title}</strong><small>{module.text}</small></span>
        <i class="fa-solid fa-arrow-right commerce-module-arrow" aria-hidden="true"></i>
      </a>
    ))}
  </nav>
</section>
