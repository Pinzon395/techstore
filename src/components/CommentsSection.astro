---
interface Props {
  id?: string;
  viewMoreHref?: string;       // URL a la vista completa de reseñas (ej: '/comentarios'). Omitir en /comentarios.
  viewMoreLabel?: string;
  dark?: boolean;              // Si la página usa fondo oscuro (ej: empresas)
  title?: string;
  description?: string;
}

const {
  id = 'comentarios',
  viewMoreHref,
  viewMoreLabel = 'Ver todas las reseñas',
  dark = false,
  title = '¿Qué opinan nuestros clientes?',
  description = 'Déjanos un comentario y calificación sobre nuestro servicio.',
} = Astro.props;

const sectionStyle = dark
  ? 'background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);'
  : 'background:linear-gradient(to bottom, #ffffff 0%, #f1f5f9 40px, #f1f5f9 100%);';

const titleColor = dark ? '#ffffff' : 'inherit';
const descColor  = dark ? '#94a3b8' : 'inherit';
const formStyle  = dark
  ? 'background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);'
  : '';
const inputStyle = dark
  ? 'background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); color: #fff;'
  : '';
const labelColor = dark ? '#fbbf24' : '#f59e0b';
---

<section class={`comments-section-container section-padding${dark ? ' dark-bg' : ''}`} style={sectionStyle} id={id}>
  <div class="container comments-section">
    <div class="section-title text-center" style="margin-bottom: 2rem;">
      <h2 style={`color: ${titleColor};`}>{title}</h2>
      <p style={`color: ${descColor};`}>{description}</p>
    </div>

    <div class="comment-form-container" style={formStyle}>
      <p style={`font-size:1.1rem; font-weight:700; margin-bottom:15px; color: ${dark ? '#ffffff' : 'inherit'};`}>Deja tu Comentario</p>
      <div class="stars-input half" id="star-rating" role="radiogroup" aria-label="Calificación en estrellas">
        {[1, 2, 3, 4, 5].map((base) => (
          <span class="star-slot" data-base={base}>
            <svg class="star-bg" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-star" /></svg>
            <svg class="star-fg" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-star" /></svg>
            <button type="button" class="star-zone left"  data-val={(base - 0.5).toString()} aria-label={`${base - 0.5} estrellas`}></button>
            <button type="button" class="star-zone right" data-val={base.toString()}          aria-label={`${base} estrellas`}></button>
          </span>
        ))}
        <span class="rating-label" aria-live="polite" style={`color:${labelColor};`}></span>
      </div>
      <form id="addCommentForm">
        <div class="form-group">
          <input type="text" id="commenterName" placeholder="Tu Nombre" required autocomplete="name" style={inputStyle} />
        </div>
        <div class="form-group mt-3">
          <textarea id="commenterText" rows="3" placeholder="Muy buen servicio, mi equipo quedó como nuevo..." required style={inputStyle}></textarea>
        </div>
        <button type="submit" class="btn btn-primary mt-3" id="submitCommentBtn">
          <i class="fa-solid fa-paper-plane"></i> Publicar Comentario
        </button>
      </form>
    </div>

    <div class="comments-marquee-container" id="commentsCarousel">
      <div class="comment-list" id="commentsBox"></div>
    </div>

    <div class="text-center mt-4" style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
      <button id="loadMoreComments" class="btn btn-outline" style={dark ? 'display:none; color:#fff; border-color:rgba(255,255,255,0.2);' : 'display:none;'}>
        Ver más comentarios
      </button>
      {viewMoreHref && (
        <a href={viewMoreHref} class="btn btn-outline" style={dark ? 'color:#fff; border-color:rgba(255,255,255,0.2);' : ''}>
          <i class="fa-solid fa-comments"></i> {viewMoreLabel}
        </a>
      )}
    </div>
  </div>
</section>

<script src="/scripts/comments.js" is:inline defer></script>
