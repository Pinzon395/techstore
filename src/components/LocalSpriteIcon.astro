---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = '' } = Astro.props;
const aliases: Record<string, string> = {
  'arrow-down-long': 'arrow-down',
  'ban': 'circle-xmark',
  'chart-line': 'arrow-trend-up',
  'clipboard-list': 'clipboard-check',
  'computer': 'desktop',
  'scale-balanced': 'circle-half-stroke',
  'table-columns': 'table',
  'temperature-arrow-up': 'temperature-high',
  'temperature-half': 'temperature-high',
  'toolbox': 'tools',
  'wave-square': 'arrow-trend-up',
};
const iconName = aliases[name] || name;
---

<svg class:list={['tc-svg', className]} aria-hidden="true" focusable="false">
  <use href={`/assets/icons/sprite.svg#fa-${iconName}`}></use>
</svg>
