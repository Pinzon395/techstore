---

<button
  type="button"
  id="back-to-top"
  class="back-to-top-btn"
  aria-label="Volver al inicio de la página"
  title="Volver al inicio"
>
  <span class="back-to-top-btn__icon">
    <i class="fa-solid fa-chevron-up" aria-hidden="true"></i>
  </span>
</button>

<script>
  function initBackToTop() {
    const btn = document.getElementById('back-to-top');
    if (!btn || btn.dataset.initialized === 'true') return;
    btn.dataset.initialized = 'true';

    if (document.documentElement.lang === 'en') {
      btn.setAttribute('aria-label', 'Back to top of page');
      btn.setAttribute('title', 'Back to top');
    }

    let isTicking = false;

    const checkScroll = () => {
      if (window.scrollY > 300) {
        btn.classList.add('is-visible');
      } else {
        btn.classList.remove('is-visible');
      }
      isTicking = false;
    };

    const onScroll = () => {
      if (!isTicking) {
        requestAnimationFrame(checkScroll);
        isTicking = true;
      }
    };

    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({
        top: 0,
        left: 0,
        behavior: prefersReducedMotion ? 'auto' : 'smooth'
      });
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    checkScroll();

    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', onScroll);
    }, { once: true });
  }

  initBackToTop();
  document.addEventListener('astro:page-load', initBackToTop);
  document.addEventListener('astro:after-swap', initBackToTop);
</script>

<style>
  #back-to-top.back-to-top-btn {
    --btt-size: 48px;
    --btt-edge: 24px;
    --btt-bottom: 24px;
    --btt-clearance: 0px;

    position: fixed !important;
    left: calc(var(--btt-edge) + env(safe-area-inset-left, 0px)) !important;
    bottom: calc(
      var(--btt-bottom) +
      var(--btt-clearance) +
      env(safe-area-inset-bottom, 0px)
    ) !important;
    right: auto !important;
    top: auto !important;

    width: var(--btt-size) !important;
    height: var(--btt-size) !important;
    min-width: var(--btt-size) !important;
    min-height: var(--btt-size) !important;
    padding: 0 !important;
    margin: 0 !important;

    background-color: var(--primary, #3b82f6) !important;
    color: #ffffff !important;
    border: none !important;
    border-radius: 8px !important;
    box-shadow: 0 4px 14px rgba(7, 31, 58, 0.18) !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 1.15rem !important;
    cursor: pointer !important;
    z-index: 1001 !important;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px) translateZ(0);

    transition:
      bottom 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.24s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.24s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.24s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.18s ease,
      box-shadow 0.18s ease !important;
    will-change: bottom, opacity, visibility, transform;

    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }

  #back-to-top.back-to-top-btn.is-visible {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
    transform: translateY(0) translateZ(0);
  }

  .back-to-top-btn__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    animation: backToTopArrowFloat 1.8s ease-in-out infinite;
    will-change: transform;
    transform: translateZ(0);
  }

  #back-to-top i {
    color: #ffffff !important;
    line-height: 1 !important;
  }

  @keyframes backToTopArrowFloat {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    #back-to-top.back-to-top-btn:hover {
      background-color: var(--primary-hover, #2563eb) !important;
      transform: translateY(-2px) translateZ(0);
      box-shadow: 0 8px 22px rgba(7, 31, 58, 0.26) !important;
      transition:
        transform 0.12s ease,
        background-color 0.18s ease,
        box-shadow 0.18s ease !important;
    }
    #back-to-top.back-to-top-btn:hover .back-to-top-btn__icon {
      animation-duration: 1.1s;
    }
  }

  #back-to-top.back-to-top-btn:active {
    transform: scale(0.94) translateZ(0) !important;
    transition: transform 0.06s ease !important;
  }

  #back-to-top.back-to-top-btn:focus-visible {
    outline: 3px solid var(--gold, #f59e0b) !important;
    outline-offset: 3px !important;
  }

  @media (max-width: 768px) {
    #back-to-top.back-to-top-btn {
      --btt-edge: 20px;
      --btt-bottom: 20px;
    }

    .back-to-top-btn__icon {
      animation-name: backToTopArrowBreathe;
      animation-duration: 2.6s;
      animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1);
    }
  }

  @keyframes backToTopArrowBreathe {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #back-to-top.back-to-top-btn,
    .back-to-top-btn__icon {
      animation: none !important;
      transition: none !important;
      transform: none !important;
    }
  }

  :global(body.admin-body) #back-to-top.back-to-top-btn {
    display: none !important;
  }

  @media print {
    #back-to-top.back-to-top-btn {
      display: none !important;
    }
  }
</style>
