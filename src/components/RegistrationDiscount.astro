---
import Icon from './LocalSpriteIcon.astro';

interface Props {
  discount?: string;
  loginHref?: string;
  guestHref?: string;
  description?: string;
  terms?: string;
  placement?: 'inline' | 'after-hero';
  lang?: 'es' | 'en';
}

const {
  discount = '30%',
  loginHref = '/iniciar-sesion?redirect=/crear-ticket',
  guestHref = '/crear-ticket',
  description = 'Inicia sesión antes de registrar tu equipo y el descuento se aplica automáticamente a la mano de obra del servicio elegible.',
  terms = 'Válido únicamente en mano de obra del servicio técnico autorizado. No incluye refacciones, traslados fuera de la cobertura base ni servicios de terceros.',
  placement = 'inline',
  lang = 'es',
} = Astro.props;

const copy = lang === 'en' ? {
  title: `Pixon PC registration offer: ${discount} off eligible labor`,
  coupon: 'Digital offer',
  registration: 'Online registration',
  code: 'PIXON REGISTRATION',
  discountLabel: 'off eligible labor',
  description: 'Sign in before registering your device to apply the discount automatically to eligible service labor.',
  benefits: ['Device details saved', 'Service updates in your account', 'Written quote before repair'],
  login: 'Sign in and create ticket',
  guest: 'Create ticket without signing in',
  terms: 'Valid only for eligible authorized service labor. Parts, transportation outside the base coverage area and third-party services are excluded. The benefit is confirmed after diagnosis.',
  includes: 'Includes',
} : {
  title: `Cupón de registro Pixon PC: ${discount} de descuento en mano de obra`,
  coupon: 'Cupón digital',
  registration: 'Registro en línea',
  code: 'PIXON REGISTRO',
  discountLabel: 'de descuento',
  description,
  benefits: ['Datos del equipo guardados', 'Seguimiento técnico desde tu cuenta', 'Cotización antes de reparar'],
  login: 'Iniciar sesión y crear ticket',
  guest: 'Crear ticket sin iniciar sesión',
  terms: `${terms} El beneficio se valida después del diagnóstico.`,
  includes: 'Incluye',
};
---

<section class="registration-offer" aria-labelledby="registration-offer-title" data-registration-placement={placement === 'after-hero' ? placement : undefined}>
  <h2 id="registration-offer-title" class="registration-offer__title">{copy.title}</h2>
  <div class="registration-offer__inner">
    <div class="coupon" aria-label={`${discount} de descuento en mano de obra`}>
      <div class="coupon__saving">
        <span class="coupon__brand">PIXON PC</span>
        <span class="coupon__caption">{copy.coupon}</span>
        <strong>{discount}</strong>
        <span class="coupon__label">{copy.discountLabel}</span>
      </div>

      <div class="coupon__details">
        <div class="coupon__heading">
          <span class="coupon__ticket-mark"><Icon name="ticket" /></span>
          <div>
            <span>{copy.registration}</span>
            <strong>{copy.code}</strong>
          </div>
        </div>

        <p>{copy.description}</p>

        <ul class="coupon__benefits" aria-label={copy.includes}>
          {copy.benefits.map((benefit) => <li><Icon name="circle-check" /> {benefit}</li>)}
        </ul>

        <div class="coupon__actions">
          <a class="coupon__button coupon__button--primary" href={loginHref} aria-describedby="registration-offer-terms">
            <Icon name="user" /> {copy.login}
          </a>
          <a class="coupon__button coupon__button--secondary" href={guestHref} aria-describedby="registration-offer-terms">
            {copy.guest} <Icon name="arrow-right" />
          </a>
        </div>

        <p id="registration-offer-terms" class="registration-offer__terms">
          <Icon name="circle-info" />
          <span>{copy.terms}</span>
        </p>
      </div>
    </div>
  </div>
</section>

{placement === 'after-hero' && (
  <script defer src="/scripts/registration-discount-placement.js?v=20260804-1"></script>
)}

<style>
  .registration-offer {
    --offer-blue: #071f3a;
    --offer-blue-soft: #dff4fd;
    --offer-line: #9ecce1;
    --offer-accent: #f5c542;
    --offer-accent-light: #fff1ba;
    --offer-cyan: #24b9ed;
    --offer-shadow: rgba(7, 31, 58, 0.13);

    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 4vw, 2rem);
    background: linear-gradient(90deg, #f4f8fb, #eaf6fb 54%, #f4f8fb);
  }

  .registration-offer__inner {
    width: min(1160px, 100%);
    margin-inline: auto;
  }

  .registration-offer__title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .registration-offer__kicker,
  .coupon__brand,
  .coupon__caption,
  .coupon__label,
  .coupon__scope,
  .coupon__heading > div > span {
    color: var(--offer-blue) !important;
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .registration-offer__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
  }

  .registration-offer__kicker::before {
    width: 1.85rem;
    height: 2px;
    content: '';
    background: var(--offer-accent);
  }

  .coupon {
    position: relative;
    display: grid;
    overflow: hidden;
    border: 1px solid var(--offer-line);
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 14px 32px var(--offer-shadow);
  }

  .coupon::before,
  .coupon::after {
    position: absolute;
    z-index: 2;
    width: 2.15rem;
    height: 2.15rem;
    content: '';
    border-radius: 50%;
    background: #f4f8fb;
  }

  .coupon::before { top: -1.075rem; }
  .coupon::after { bottom: -1.075rem; }

  .coupon__saving {
    position: relative;
    display: flex;
    min-height: 0;
    padding: 1.35rem 1.5rem;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    background: linear-gradient(145deg, #c4edfc 0%, var(--offer-blue-soft) 58%, #f6fcff 100%);
  }

  .coupon__saving::before {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.62), transparent 46%);
  }

  .coupon__saving > * { position: relative; }

  .coupon__brand { margin-bottom: 0.35rem; }
  .coupon__caption { color: #44647d !important; letter-spacing: 0.09em; }

  .coupon__saving strong {
    margin-top: 0.6rem;
    color: var(--offer-blue) !important;
    font-size: clamp(4.4rem, 8vw, 6.2rem);
    font-weight: 900;
    line-height: 0.82;
    letter-spacing: -0.09em;
  }

  .coupon__label { margin-top: 0.55rem; }
  .coupon__scope { margin-top: 0.22rem; color: #44647d !important; letter-spacing: 0.08em; }

  .coupon__details {
    padding: 1.25rem clamp(1.25rem, 3vw, 2rem);
    color: var(--offer-blue) !important;
  }

  .coupon__heading {
    display: flex;
    gap: 0.85rem;
    align-items: center;
  }

  .coupon__ticket-mark {
    display: grid;
    width: 2.65rem;
    height: 2.65rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 0.7rem;
    color: var(--offer-blue) !important;
    background: var(--offer-accent-light);
  }

  .coupon__ticket-mark .tc-svg { width: 1.05rem; height: 1.05rem; }
  .coupon__heading > div { display: grid; gap: 0.2rem; }
  .coupon__heading > div > span { color: #44647d !important; font-size: 0.62rem; }
  .coupon__heading strong { color: var(--offer-blue) !important; font-size: 0.95rem; letter-spacing: 0.06em; }

  .coupon__details > p {
    max-width: 53ch;
    margin: 0.75rem 0 0;
    color: var(--offer-blue) !important;
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .coupon__benefits {
    display: grid;
    gap: 0.45rem 0.8rem;
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  .coupon__benefits li {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    color: var(--offer-blue) !important;
    font-size: 0.77rem;
    font-weight: 700;
  }

  .coupon__benefits .tc-svg {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    color: #1d729c;
  }

  .coupon__actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-top: 0.9rem;
    flex-wrap: wrap;
  }

  .coupon__button {
    display: inline-flex;
    min-height: 2.8rem;
    padding: 0.68rem 0.9rem;
    gap: 0.55rem;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 0.7rem;
    font-size: 0.78rem;
    font-weight: 850;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1), box-shadow 160ms cubic-bezier(0.23, 1, 0.32, 1), border-color 160ms ease, background-color 160ms ease;
  }

  .coupon__button .tc-svg { width: 0.95rem; height: 0.95rem; flex: 0 0 auto; }

  .coupon__button--primary {
    color: var(--offer-blue) !important;
    background: var(--offer-accent);
    box-shadow: 0 8px 18px rgba(239, 183, 35, 0.22);
  }

  .coupon__button--secondary {
    color: var(--offer-blue) !important;
    border-color: var(--offer-line);
    background: #fff;
  }

  .coupon__button:focus-visible {
    outline: 3px solid #1d729c;
    outline-offset: 3px;
  }

  .coupon__button:active { transform: scale(0.97); }

  .registration-offer__terms {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    margin: 0.7rem 0 0;
    padding-top: 0.65rem;
    border-top: 1px solid #d5e7f0;
    color: var(--offer-blue) !important;
    font-size: 0.69rem;
    line-height: 1.4;
  }

  .registration-offer__terms .tc-svg {
    width: 0.95rem;
    height: 0.95rem;
    flex: 0 0 auto;
    margin-top: 0.1rem;
    color: #1d729c;
  }

  @media (min-width: 760px) {
    .coupon { grid-template-columns: minmax(14.5rem, 0.63fr) minmax(0, 1.37fr); }
    .coupon::before, .coupon::after { left: calc(31.5% - 1.075rem); }
    .coupon__saving { border-right: 2px dashed var(--offer-line); }
  }

  @media (min-width: 1024px) {
    .coupon__benefits { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (hover: hover) and (pointer: fine) {
    .coupon__button:hover { transform: translateY(-2px); }
    .coupon__button--primary:hover { box-shadow: 0 12px 24px rgba(239, 183, 35, 0.32); }
    .coupon__button--secondary:hover { border-color: #1d729c; background: var(--offer-blue-soft); }
  }

  @media (max-width: 759px) {
    .coupon::before, .coupon::after { left: calc(50% - 1.075rem); }
    .coupon__saving {
      min-height: auto;
      padding: 1.2rem 1.3rem;
      border-bottom: 2px dashed var(--offer-line);
    }
    .coupon__saving strong { font-size: clamp(4.2rem, 19vw, 5.5rem); }
    .coupon__actions { display: grid; grid-template-columns: 1fr; }
    .coupon__button { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .coupon__button { transition: none; }
    .coupon__button:hover, .coupon__button:active { transform: none; }
  }

  /* LocalSpriteIcon is a child Astro component. Its SVG does not inherit this
     component's scoped attribute, so keep the icon sizing global but strictly
     contained inside the registration offer. */
  .registration-offer :global(.tc-svg) {
    display: block;
    width: 1rem !important;
    height: 1rem !important;
    max-width: 1rem !important;
    max-height: 1rem !important;
    flex: 0 0 1rem;
  }

  .registration-offer .coupon__ticket-mark :global(.tc-svg) {
    width: 1.05rem !important;
    height: 1.05rem !important;
    max-width: 1.05rem !important;
    max-height: 1.05rem !important;
    flex-basis: 1.05rem;
  }

  .registration-offer .coupon__button :global(.tc-svg),
  .registration-offer .registration-offer__terms :global(.tc-svg) {
    width: 0.95rem !important;
    height: 0.95rem !important;
    max-width: 0.95rem !important;
    max-height: 0.95rem !important;
    flex-basis: 0.95rem;
  }
</style>
