---
interface Props {
  id?: string;
  defaultDevice?: string;
  defaultService?: string;
  sourcePage?: string;
  title?: string;
  subtitle?: string;
}

const {
  id = 'ticket-form',
  defaultDevice = '',
  defaultService = '',
  sourcePage = Astro.url.pathname,
} = Astro.props;

const params = new URLSearchParams();
if (defaultDevice) params.set('device', defaultDevice);
if (defaultService) params.set('service', defaultService);
if (sourcePage && sourcePage !== '/tickets') params.set('source', sourcePage);

const ticketHref = params.toString() ? `/tickets?${params.toString()}` : '/tickets';
const whatsappText = defaultService
  ? `Hola Pixon PC, necesito servicio técnico para ${defaultService}.`
  : 'Hola Pixon PC, necesito servicio técnico para mi equipo.';
const whatsappHref = `https://wa.me/529986690777?text=${encodeURIComponent(whatsappText)}`;
const titleId = `${id}-title`;
---

<section id={id} class="service-ticket-section ticket-cta-section" aria-labelledby={titleId}>
  <div class="container ticket-cta-container">
    <div class="ticket-cta-card">
      <div class="ticket-cta-pattern" aria-hidden="true"></div>
      <div class="ticket-cta-icon" aria-hidden="true">
        <svg class="fa-icon"><use href="/assets/icons/sprite.svg#fa-ticket"></use></svg>
      </div>
      <div class="ticket-cta-copy">
        <span>Atención con seguimiento</span>
        <h2 id={titleId}>¿Necesitas servicio técnico?</h2>
        <p>Crea un ticket con tu equipo, falla y datos de contacto. Te respondemos en menos de 2 horas hábiles con el siguiente paso.</p>
      </div>
      <div class="ticket-cta-actions">
        <a class="ticket-cta-primary" href={ticketHref}>
          <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-arrow-right"></use></svg>
          Crear ticket ahora
        </a>
        <a class="ticket-cta-whatsapp" href={whatsappHref} target="_blank" rel="noopener noreferrer">
          <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-whatsapp"></use></svg>
          Prefiero WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ id, ticketHref }}>
  (() => {
    const targetHref = `#${id}`;
    document.querySelectorAll('a[href]').forEach((link) => {
      if (link.getAttribute('href') === targetHref) {
        link.setAttribute('href', ticketHref);
      }
    });
  })();
</script>

<style is:global>
  .service-ticket-section.ticket-cta-section,
  .service-ticket-section.ticket-cta-section * {
    box-sizing: border-box;
    font-family: var(--font-main);
    font-style: normal;
    letter-spacing: 0;
  }

  .service-ticket-section.ticket-cta-section {
    scroll-margin-top: 96px;
    padding: clamp(28px, 5vw, 56px) 20px;
    background: #f8fafc;
  }

  .service-ticket-section.ticket-cta-section .ticket-cta-container {
    max-width: 1180px;
    margin: 0 auto;
  }

  .service-ticket-section.ticket-cta-section .ticket-cta-card {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 16px;
    align-items: center;
    overflow: hidden;
    border: 1px solid #dbe4f0;
    border-radius: 12px;
    background: #ffffff;
    padding: 16px 18px;
    box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
    transition: border-color 180ms cubic-bezier(.23, 1, .32, 1), box-shadow 180ms cubic-bezier(.23, 1, .32, 1), transform 180ms cubic-bezier(.23, 1, .32, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .service-ticket-section.ticket-cta-section .ticket-cta-card:hover {
      border-color: #bfdbfe;
      box-shadow: 0 14px 30px rgba(15, 23, 42, .08);
      transform: translateY(-1px);
    }
  }

  .service-ticket-section.ticket-cta-section .ticket-cta-pattern {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(37, 99, 235, .04), transparent 45%, rgba(14, 165, 233, .035));
    pointer-events: none;
  }

  .service-ticket-section.ticket-cta-section .ticket-cta-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: #071F3A;
    color: #ffffff;
    box-shadow: 0 8px 16px rgba(7, 31, 58, .16);
  }

  .service-ticket-section.ticket-cta-section .ticket-cta-icon .fa-icon {
    width: 18px;
    height: 18px;
    color: #ffffff;
  }

  .service-ticket-section.ticket-cta-section .ticket-cta-copy {
    position: relative;
    min-width: 0;
  }

  .service-ticket-section.ticket-cta-section .ticket-cta-copy span {
    display: inline-flex;
    margin-bottom: 2px;
    color: #2563eb;
    font-size: .7rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .service-ticket-section.ticket-cta-section .ticket-cta-copy h2 {
    margin: 0 0 3px;
    color: #071F3A;
    font-family: var(--font-heading);
    font-size: clamp(1.08rem, 1.8vw, 1.34rem);
    font-weight: 800;
    line-height: 1.15;
  }

  .service-ticket-section.ticket-cta-section .ticket-cta-copy p {
    margin: 0;
    max-width: 700px;
    color: #071F3A;
    font-size: .92rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .service-ticket-section.ticket-cta-section .ticket-cta-actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
  }

  .service-ticket-section.ticket-cta-section .ticket-cta-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 38px;
    border-radius: 999px;
    padding: 8px 12px;
    color: #071F3A;
    font-size: .88rem;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 160ms cubic-bezier(.23, 1, .32, 1), box-shadow 160ms cubic-bezier(.23, 1, .32, 1), border-color 160ms cubic-bezier(.23, 1, .32, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .service-ticket-section.ticket-cta-section .ticket-cta-actions a:hover {
      transform: translateY(-1px);
    }
  }

  .service-ticket-section.ticket-cta-section .ticket-cta-actions a:active {
    transform: scale(.98);
  }

  .service-ticket-section.ticket-cta-section .ticket-cta-actions a:focus-visible {
    outline: 3px solid #f59e0b;
    outline-offset: 3px;
  }

  .service-ticket-section.ticket-cta-section .ticket-cta-primary {
    border: 1px solid #bfdbfe;
    background: #eff6ff;
    box-shadow: 0 8px 18px rgba(37, 99, 235, .14);
  }

  .service-ticket-section.ticket-cta-section .ticket-cta-whatsapp {
    border: 1px solid #a7f3d0;
    background: #ecfdf5;
  }

  .service-ticket-section.ticket-cta-section .ticket-cta-actions .fa-icon {
    width: 14px;
    height: 14px;
    color: currentColor;
  }

  @media (max-width: 860px) {
    .service-ticket-section.ticket-cta-section .ticket-cta-card {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
    }

    .service-ticket-section.ticket-cta-section .ticket-cta-actions {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }

    .service-ticket-section.ticket-cta-section .ticket-cta-icon {
      width: 40px;
      height: 40px;
    }
  }

    @media (max-width: 520px) {
    .service-ticket-section.ticket-cta-section {
      padding-inline: 12px;
    }

    .service-ticket-section.ticket-cta-section .ticket-cta-card {
      padding: 14px;
    }

    .service-ticket-section.ticket-cta-section .ticket-cta-actions a {
      width: 100%;
      min-height: 42px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-ticket-section.ticket-cta-section .ticket-cta-card,
    .service-ticket-section.ticket-cta-section .ticket-cta-actions a {
      transition: none;
    }
  }
</style>
