---
/**
 * Navbar 3.0  → Premium · Cascade Dropdown · Mobile-First
 *
 * - Servicios  → dropdown de categorías  → sub-menú en cascada (desktop)
 * - Mobile: acordeón nativo, sin bugs, animado con max-height
 * - Micro-animaciones: fade-slide entrada, hover glows, flecha rotante
 * - Sticky + hide-on-scroll
 * - Accesibilidad: aria-expanded, roles, focus-visible
 * - Data source: src/data/services.ts (single source of truth)
 *
 * Precaución: PRECAUCIÓN  → REGLAS QUE NO DEBEN ROMPERSE:
 *
 * 1. RUTAS DE SERVICIOS: Todas las rutas de categorías y subservicios se generan
 *    automáticamente desde src/data/services.ts (SERVICE_CATEGORIES).
 *    NO codifiques rutas manualmente aquí  → edita services.ts.
 *
 * 2. CLASES CSS CRTICAS: Las clases .navbar-v3, .has-cascade, .v3-cascade-l1,
 *    .v3-cascade-l2, .cascade-item, .cascade-cat-link son la espina dorsal
 *    del megamenú. Si cambias alguna, debes actualizar TODO el CSS scope
 *    que está al final de este archivo (único lugar donde se definen).
 *
 * 3. IDs CRÍTICOS: #navbar, #mobile-menu, #nav-menu, #nav-auth-area,
 *    #nav-auth-area-mobile, #nav-admin-gear, #dd-servicios, #dd-servicios-trigger,
 *    #dd-servicios-menu. Estos son referenciados por el JS del navbar.
 *
 * 4. JAVASCRIPT: El script al final de este archivo maneja hamburger, dropdowns
 *    en mobile, cascade L2, click-fuera, sticky+scroll y admin gear.
 *    Depende de IS_MOBILE() y de las clases .has-cascade, .has-dropdown.
 *    NO muevas ese script a otro archivo sin probar mobile completamente.
 *
 * 5. ESTE NAVBAR está usado en:
 *    - /test-navbar-3 (vista de prueba)
 *    - /servicios, /servicios/[categoria], /servicios/[categoria]/[servicio]
 *    - /servicios/laptop/upgrade, /servicios/laptop/cambio-bateria
 *    Cambios aquí afectan TODAS esas páginas simultaneamente.
 */
import { SERVICE_CATEGORIES, type ServiceItem } from '../data/services';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLocaleFromPath } from '../lib/i18n';

interface Props {
  lang?: 'es' | 'en';
}
const { lang = getLocaleFromPath(Astro.originPathname) } = Astro.props;
const home = lang === 'en' ? '/en' : '/';
const isEnglishNavigation = () => lang === 'en';
// El catálogo completo de enlaces vive en las páginas hub y servicios relacionados.
// El navbar conserva la jerarquía de categorías sin enviar todos los servicios al DOM inicial.
const NAV_SERVICE_CATEGORIES = SERVICE_CATEGORIES.map((category) => ({ ...category, services: [] as ServiceItem[] }));

const t = lang === 'en' ? {
  home: 'Home',
  services: 'Services',
  packages: 'Packages',
  info: 'Info',
  contact: 'Contact',
  store: 'Store',
  b2b: 'B2B',
  faq: 'FAQ',
  reviews: 'Reviews',
  catalog: 'Video Catalog',
  blogs: 'Blogs',
  warranty: 'Warranty',
} : {
  home: 'Inicio',
  services: 'Servicios',
  packages: 'Paquetes',
  info: 'Información',
  contact: 'Contacto',
  store: 'Tienda',
  b2b: 'B2B',
  faq: 'Preguntas Frecuentes',
  reviews: 'Reseñas',
  catalog: 'Catálogo en video',
  blogs: 'Blogs',
  warranty: 'Garantía',
};
---

<div class="nav-reveal-zone" id="nav-reveal-zone" aria-hidden="true"></div>

<nav class="navbar navbar-v3" id="navbar" role="navigation" aria-label={lang === 'en' ? 'Main navigation' : 'Menú principal'}>
  <div class="nav-container">

    <!-- Logo -->
    <a href="/" class="logo" aria-label={lang === 'en' ? 'Pixon PC — Spanish home' : 'Pixon PC → Inicio'}>
      <img src="/assets/logos/Logo.svg?v=3" alt="Pixon PC Logo" style="height:42px;" id="navbar-logo" class="brand-logo">
    </a>

    <!-- Hamburger (mobile only) -->
    <button
      class="menu-toggle"
      id="mobile-menu"
      aria-label={lang === 'en' ? 'Open menu' : 'Abrir menú'}
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span class="bar bar-dark"></span>
      <span class="bar bar-dark"></span>
      <span class="bar bar-dark"></span>
    </button>

    <!--  -> -> Nav links  -> -> -->
    <ul class="nav-menu" id="nav-menu" role="menubar">

      <li role="none"><a href={home} class="nav-links" role="menuitem">{t.home}</a></li>


      {isEnglishNavigation() ? (
        <>
          <li role="none"><a href="/en/services" class="nav-links" role="menuitem">Services</a></li>
          <li role="none"><a href="/en/business-it-support" class="nav-links" role="menuitem">Business IT</a></li>
          <li role="none"><a href="/en/contact" class="nav-links" role="menuitem">Contact</a></li>
          <li role="none"><a href="https://wa.me/529986690777?text=Hi%20Pixon%20PC.%20I%20need%20help%20with%20a%20device%20while%20I%20am%20in%20Cancun.%0A%0ADevice%3A%0AModel%3A%0AProblem%3A%0AHotel%20%2F%20area%3A%0AHow%20urgent%20is%20it%3F%3A%0A I%20prefer%20written%20communication%20in%20English." class="nav-links" role="menuitem" target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
        </>
      ) : (
        <>
      <li role="none"><a href="/tienda" class="nav-links" role="menuitem">{t.store}</a></li>

      <!-- - SERVICIOS - Cascade Dropdown -->
      <li class="has-dropdown has-cascade" role="none" id="dd-servicios">
        <a
          href="/servicios"
          class="nav-links nav-dd-trigger"
          role="menuitem"
          aria-haspopup="true"
          aria-expanded="false"
          id="dd-servicios-trigger"
        >
          {t.services}
          <i class="fa-solid fa-chevron-down dropdown-arrow" aria-hidden="true"></i>
        </a>

        <!-- ====== SERVICIOS DROPDOWN ======
             Precaución: PRECAUCIÓN: Este dropdown se genera dinámicamente desde
             src/data/services.ts. Para agregar/quitar categorías o subservicios,
             edita ese archivo. NO modifiques este HTML a mano.

             Rutas generadas automáticamente:
             - Categorías: /servicios/{cat.slug}
             - Subservicios: /servicios/{cat.slug}/{s.slug}
             - Con customUrl: se redirige a la página existente definida en customUrl

             El botón de categoría (cascade-cat-link) en MOBILE hace toggle del acordeón
             (e.preventDefault() en JS). En DESKTOP navega al href normalmente.
        -->
        <!-- Nivel 1: Categóras -->
        <ul class="v3-cascade-l1" role="menu" aria-label="Categorías de servicio" id="dd-servicios-menu">
          {NAV_SERVICE_CATEGORIES.map((cat) => (
            <li class="cascade-item" role="none" data-cat={cat.id} id={`dd-cat-${cat.id}`}>
              <a
                href={`/servicios/${cat.slug}`}
                class="cascade-cat-link"
                role="menuitem"
                aria-haspopup="true"
                aria-expanded="false"
              >
                <span class="cascade-cat-icon-wrap">
                  <i class={`fa-solid ${cat.icon}`} aria-hidden="true"></i>
                </span>
                <span class="cascade-cat-label">{cat.title}</span>
                <i class="fa-solid fa-chevron-right cascade-arrow" aria-hidden="true"></i>
              </a>

              <!-- Nivel 2: Subservicios -->
              <ul
                class="v3-cascade-l2"
                role="menu"
                aria-label={`Servicios de ${cat.title}`}
              >
                <li class="v3-l2-header" role="presentation">
                  <i class={`fa-solid ${cat.icon}`} aria-hidden="true"></i>
                  <span>{cat.title}</span>
                </li>
                {cat.services.filter((s) => !s.navHidden).map((s) => {
                  const serviceHref = s.customUrl ? s.customUrl : `/servicios/${cat.slug}/${s.slug}`;
                  const hasChildren = Array.isArray(s.navChildren) && s.navChildren.length > 0;
                  const childMenuId = `mobile-${cat.slug}-${s.slug}-services`;

                  return (
                    <li role="none" class:list={['v3-sub-item', { 'has-l3': hasChildren }]}>
                      {hasChildren ? (
                        <>
                          <button
                            type="button"
                            class="v3-sub-link v3-sub-trigger"
                            role="menuitem"
                            aria-haspopup="true"
                            aria-expanded="false"
                            aria-controls={childMenuId}
                          >
                            <span>{s.label}</span>
                            <i class="fa-solid fa-chevron-right v3-l3-arrow" aria-hidden="true"></i>
                          </button>

                          <ul id={childMenuId} class="v3-cascade-l3" role="menu" aria-label={`Servicios de ${s.label}`}>
                            <li class="v3-l2-header v3-l3-header" role="presentation">
                              <span>{s.label}</span>
                            </li>
                            {s.navChildren?.map((child) => (
                              <li role="none">
                                <a
                                  href={child.customUrl ? child.customUrl : `/servicios/${cat.slug}/${child.slug}`}
                                  class="v3-sub-link v3-l3-link"
                                  role="menuitem"
                                >
                                  <i class="fa-solid fa-angle-right v3-sub-arrow" aria-hidden="true"></i>
                                  {child.label}
                                </a>
                              </li>
                            ))}
                            <li class="v3-l2-footer" role="none">
                              <a href={serviceHref} class="v3-all-link">
                                Ver todos los servicios de {s.label}
                                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                              </a>
                            </li>
                          </ul>
                        </>
                      ) : (
                        <a
                          href={serviceHref}
                          class="v3-sub-link"
                          role="menuitem"
                        >
                          <i class="fa-solid fa-angle-right v3-sub-arrow" aria-hidden="true"></i>
                          {s.label}
                        </a>
                      )}
                    </li>
                  );
                })}
                <li class="v3-l2-footer" role="none">
                  <a href={`/servicios/${cat.slug}`} class="v3-all-link">
                    Ver todos los servicios de {cat.title}
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                  </a>
                </li>
              </ul>
            </li>
          ))}
          <li class="cascade-item" role="none">
            <a href="/servicios" class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-list-check" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">{lang === 'en' ? 'View all services' : 'Todos nuestros servicios'}</span>
              <i class="fa-solid fa-arrow-right cascade-arrow" aria-hidden="true"></i>
            </a>
          </li>
        </ul>
      </li>

      <!-- ====== PAQUETES ======
           Precaución: PRECAUCIÓN: El trigger href apunta a /paquetes (hub de paquetes).
           Los subitems del dropdown apuntan a /paquetes?section=... y /optimizacion.
           El dropdown en DESKTOP se abre con :hover (CSS). En MOBILE el JS hace toggle.
           La clase .has-cascade activa el comportamiento de cascade dropdown en el JS.
      -->
      <li class="has-dropdown has-cascade" role="none">
        <a href="/paquetes" class="nav-links nav-dd-trigger" role="menuitem" aria-haspopup="true" aria-expanded="false">
          {t.packages} <i class="fa-solid fa-chevron-down dropdown-arrow" aria-hidden="true"></i>
        </a>
        <ul class="v3-cascade-l1" role="menu">
          <li class="cascade-item" role="none">
            <a href="/paquetes?section=paquetes" class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">{lang === 'en' ? 'Maintenance' : 'Mantenimiento'}</span>
            </a>
          </li>
          <li class="cascade-item" role="none">
            <a href="/optimizacion?section=paquetes-optimizacion" class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-gauge-high" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">{lang === 'en' ? 'Optimization' : 'Optimización'}</span>
            </a>
          </li>
          <li class="cascade-item" role="none">
            <a href="/paquetes" class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">{lang === 'en' ? 'All packages' : 'Todos los Paquetes'}</span>
              <i class="fa-solid fa-arrow-right cascade-arrow" aria-hidden="true"></i>
            </a>
          </li>
        </ul>
      </li>

      <!-- ====== INFORMACIÓN ======
           Precaución: PRECAUCIÓN: El trigger href apunta a /preguntas-frecuentes.
           Subitems: FAQ, Reseñas, Catálogo en video, Garantía.
           Si agregas/quitas subitems, verifica que las páginas de destino existan.
      -->
      <li class="has-dropdown has-cascade" role="none">
        <a href="/preguntas-frecuentes" class="nav-links nav-dd-trigger" role="menuitem" aria-haspopup="true" aria-expanded="false">
          {t.info} <i class="fa-solid fa-chevron-down dropdown-arrow" aria-hidden="true"></i>
        </a>
        <ul class="v3-cascade-l1" role="menu">
          <li class="cascade-item" role="none">
            <a href="/preguntas-frecuentes" class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-circle-question" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">{t.faq}</span>
            </a>
          </li>
          <li class="cascade-item" role="none">
            <a href="/comentarios" class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-star" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">{t.reviews}</span>
            </a>
          </li>
          <li class="cascade-item" role="none">
            <a href="/catalogo" class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-video" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">{t.catalog}</span>
            </a>
          </li>
          <li class="cascade-item" role="none">
            <a href="/blogs" class="cascade-cat-link" role="menuitem" aria-haspopup="true" aria-expanded="false">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-newspaper" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">{t.blogs}</span>
              <i class="fa-solid fa-chevron-right cascade-arrow" aria-hidden="true"></i>
            </a>
            <ul class="v3-cascade-l2" role="menu" aria-label={lang === 'en' ? 'Blog articles' : 'Artículos del blog'}>
              <li class="v3-l2-header" role="presentation">
                <i class="fa-solid fa-newspaper" aria-hidden="true"></i>
                <span>{t.blogs}</span>
              </li>
              <li class="v3-sub-item" role="none">
                <a href="/blogs/mantenimiento-preventivo-equipos-cancun" class="v3-sub-link" role="menuitem">
                  <i class="fa-solid fa-screwdriver-wrench v3-sub-arrow" aria-hidden="true"></i>
                  <span>{lang === 'en' ? 'Preventive maintenance in Cancún' : 'Mantenimiento preventivo en Cancún'}</span>
                </a>
              </li>
              <li class="v3-sub-item" role="none">
                <a href="/blogs/desarrollo-software-paginas-web-cancun" class="v3-sub-link" role="menuitem">
                  <i class="fa-solid fa-code v3-sub-arrow" aria-hidden="true"></i>
                  <span>{lang === 'en' ? 'Software & Web Development' : 'Desarrollo web y software'}</span>
                </a>
              </li>
              <li class="v3-sub-item" role="none">
                <a href="/blogs/humedad-salitre-calor-cancun" class="v3-sub-link" role="menuitem">
                  <i class="fa-solid fa-cloud-sun-rain v3-sub-arrow" aria-hidden="true"></i>
                  <span>{lang === 'en' ? 'Humidity and salt air in Cancun' : 'Humedad, salitre y calor'}</span>
                </a>
              </li>
              <li class="v3-sub-item" role="none">
                <a href="/blogs/pasta-termica-vs-metal-liquido" class="v3-sub-link" role="menuitem">
                  <i class="fa-solid fa-temperature-half v3-sub-arrow" aria-hidden="true"></i>
                  <span>{lang === 'en' ? 'Thermal paste vs liquid metal' : 'Pasta térmica vs metal líquido'}</span>
                </a>
              </li>
              <li class="v3-sub-item" role="none">
                <a href="/blogs/aplicacion-metal-liquido-cancun" class="v3-sub-link" role="menuitem">
                  <i class="fa-solid fa-fire-flame-curved v3-sub-arrow" aria-hidden="true"></i>
                  <span>{lang === 'en' ? 'Liquid metal service' : 'Aplicación de metal líquido'}</span>
                </a>
              </li>
              <li class="v3-sub-item" role="none">
                <a href="/blogs/reparacion-bisagras-carcasas-laptop-cancun" class="v3-sub-link" role="menuitem">
                  <i class="fa-solid fa-wrench v3-sub-arrow" aria-hidden="true"></i>
                  <span>{lang === 'en' ? 'Laptop hinge repair' : 'Bisagras y carcasas'}</span>
                </a>
              </li>
              <li class="v3-l2-footer" role="none">
                <a href="/blogs" class="v3-all-link" role="menuitem">
                  {lang === 'en' ? 'View all blogs' : 'Ver todos los blogs'}
                  <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </a>
              </li>
            </ul>
          </li>
          <li class="cascade-item" role="none">
            <a href="/garantia" class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">{t.warranty}</span>
            </a>
          </li>
        </ul>
      </li>

      <!-- ====== CONTACTO ======
           Precaución: PRECAUCIÓN: Este ítem navega directamente a /contacto.
           El dropdown tiene 2 subitems: formulario y WhatsApp directo.
           El número de WhatsApp es 529986690777.
      -->
      <li class="has-dropdown has-cascade" role="none">
        <a href="/contacto" class="nav-links nav-dd-trigger" role="menuitem" aria-haspopup="true" aria-expanded="false">
          {t.contact} <i class="fa-solid fa-chevron-down dropdown-arrow" aria-hidden="true"></i>
        </a>
        <ul class="v3-cascade-l1" role="menu">
          <li class="cascade-item" role="none">
            <a href="/contacto" class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-envelope" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">{lang === 'en' ? 'Send a message' : 'Enviar mensaje'}</span>
            </a>
          </li>
          <li class="cascade-item" role="none">
            <a href="https://wa.me/529986690777" target="_blank" rel="noopener noreferrer" class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap" style="color: #25d366; border-color: #25d36640; background: #25d36615;"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">WhatsApp Directo</span>
            </a>
          </li>
        </ul>
      </li>

      <!-- ====== B2B ======
           Precaución: PRECAUCIÓN: Enlace simple sin dropdown. Apunta a /empresas.
           No tiene clase .has-cascade ni .has-dropdown  → no agregar dropdown
           sin probar que el CSS no colisione con el resto del menú.
      -->
      <li class="has-dropdown has-cascade" role="none">
        <a href="/empresas" class="nav-links nav-dd-trigger b2b-btn-premium" role="menuitem" aria-haspopup="true" aria-expanded="false">
          <i class="fa-solid fa-building-shield" aria-hidden="true"></i> {t.b2b} <i class="fa-solid fa-chevron-down dropdown-arrow" aria-hidden="true"></i>
        </a>
        <ul class="v3-cascade-l1" role="menu" aria-label="Servicios B2B">
          <li class="cascade-item" role="none">
            <a href="/empresas" class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-building-shield" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">Soporte TI empresarial</span>
            </a>
          </li>
          <li class="cascade-item" role="none">
            <a href="/servicios/b2b/soporte-oficinas" class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-building" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">Soporte TI para oficinas</span>
            </a>
          </li>
          <li class="cascade-item" role="none">
            <a href="/servicios/mantenimiento-preventivo-pc-empresas" class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">Mantenimiento preventivo</span>
            </a>
          </li>
          <li class="cascade-item" role="none">
            <a href="/servicios/b2b/wifi-empresarial" class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-wifi" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">WiFi empresarial</span>
            </a>
          </li>
          <li class="cascade-item" role="none">
            <a href="/servicios/b2b/polizas-mantenimiento" class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-file-contract" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">Pólizas de mantenimiento TI</span>
            </a>
          </li>
        </ul>
      </li>

        </>
      )}

      <li role="none" class="language-mobile"><LanguageSwitcher expanded /></li>
      <!-- Auth (mobile) -->
      <li class="nav-auth-mobile-li" id="nav-auth-mobile-li" role="none">
        <div id="nav-auth-area-mobile"></div>
      </li>
    </ul>

    <!-- Actions (desktop) -->
    <div class="nav-actions">
      <LanguageSwitcher />
      <a
        href="https://pixon.com.mx/admin"
        class="nav-admin-gear"
        id="nav-admin-gear"
        title="Panel de administración"
        aria-label="Ir al panel de administración"
        style="display:none;"
      >
        <i class="fa-solid fa-gear" aria-hidden="true"></i>
      </a>
      <div id="nav-auth-area"></div>
    </div>

  </div>
</nav>

<style is:global>
.navbar-v3 .language-mobile { display: none; }
.navbar-v3 .nav-actions { gap: 10px; }
@media (max-width: 1100px) {
  .navbar-v3 .language-mobile { display: block; }
  .navbar-v3 .nav-actions { display: none; }
  .navbar-v3 .menu-toggle { display: block; }
  .navbar-v3 .nav-auth-mobile-li { display: block; }
  .navbar-v3 .nav-menu {
