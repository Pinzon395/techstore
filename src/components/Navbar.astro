---
/**
 * Navbar 3.0 — Premium · Cascade Dropdown · Mobile-First
 *
 * ✅ Servicios → dropdown de categorías → sub-menú en cascada (desktop)
 * ✅ Mobile: acordeón nativo, sin bugs, animado con max-height
 * ✅ Micro-animaciones: fade-slide entrada, hover glows, flecha rotante
 * ✅ Sticky + hide-on-scroll
 * ✅ Accesibilidad: aria-expanded, roles, focus-visible
 * ✅ Data source: src/data/services.ts (single source of truth)
 *
 * ⚠️ PRECAUCIÓN — REGLAS QUE NO DEBEN ROMPERSE:
 *
 * 1. RUTAS DE SERVICIOS: Todas las rutas de categorías y subservicios se generan
 *    automáticamente desde src/data/services.ts (SERVICE_CATEGORIES).
 *    NO codifiques rutas manualmente aquí — edita services.ts.
 *
 * 2. CLASES CSS CRTICAS: Las clases .navbar-v3, .has-cascade, .v3-cascade-l1,
 *    .v3-cascade-l2, .cascade-item, .cascade-cat-link son la espina dorsal
 *    del megamenú. Si cambias alguna, debes actualizar TODO el CSS scope
 *    que está al final de este archivo (único lugar donde se definen).
 *
 * 3. IDs CRÍTICOS: #navbar, #mobile-menu, #nav-menu, #nav-auth-area,
 *    #nav-auth-area-mobile, #nav-admin-gear, #dd-servicios, #dd-servicios-trigger,
 *    #dd-servicios-menu. Estos son referenciados por el JS del navbar.
 *
 * 4. JAVASCRIPT: El script al final de este archivo maneja hamburger, dropdowns
 *    en mobile, cascade L2, click-fuera, sticky+scroll y admin gear.
 *    Depende de IS_MOBILE() y de las clases .has-cascade, .has-dropdown.
 *    NO muevas ese script a otro archivo sin probar mobile completamente.
 *
 * 5. ESTE NAVBAR está usado en:
 *    - /test-navbar-3 (vista de prueba)
 *    - /servicios, /servicios/[categoria], /servicios/[categoria]/[servicio]
 *    - /servicios/laptop/upgrade, /servicios/laptop/cambio-bateria
 *    Cambios aquí afectan TODAS esas páginas simultaneamente.
 */
import { SERVICE_CATEGORIES } from '../data/services';

interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;
const home = lang === 'en' ? '/en' : '/';

const t = lang === 'en' ? {
  home: 'Home',
  services: 'Services',
  packages: 'Packages',
  info: 'Info',
  contact: 'Contact',
  b2b: 'B2B',
  faq: 'FAQ',
  reviews: 'Reviews',
  catalog: 'Video Catalog',
  warranty: 'Warranty',
} : {
  home: 'Inicio',
  services: 'Servicios',
  packages: 'Paquetes',
  info: 'Información',
  contact: 'Contacto',
  b2b: 'B2B',
  faq: 'Preguntas Frecuentes',
  reviews: 'Reseñas',
  catalog: 'Catálogo en video',
  warranty: 'Garantía',
};
---

<div class="nav-reveal-zone" id="nav-reveal-zone" aria-hidden="true"></div>

<nav class="navbar navbar-v3" id="navbar" role="navigation" aria-label="Menú principal">
  <div class="nav-container">

    <!-- Logo -->
    <a href={home} class="logo" aria-label="Pixon PC — Inicio">
      <img src="/assets/logos/Logo.svg?v=3" alt="Pixon PC Logo" style="height:42px;" id="navbar-logo" class="brand-logo">
    </a>

    <!-- Hamburger (mobile only) -->
    <button
      class="menu-toggle"
      id="mobile-menu"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span class="bar bar-dark"></span>
      <span class="bar bar-dark"></span>
      <span class="bar bar-dark"></span>
    </button>

    <!-- ── Nav links ── -->
    <ul class="nav-menu" id="nav-menu" role="menubar">

      <li role="none"><a href={home} class="nav-links" role="menuitem">{t.home}</a></li>

      <!-- ══ SERVICIOS ══ Cascade Dropdown -->
      <li class="has-dropdown has-cascade" role="none" id="dd-servicios">
        <a
          href="#"
          class="nav-links nav-dd-trigger"
          role="menuitem"
          aria-haspopup="true"
          aria-expanded="false"
          id="dd-servicios-trigger"
        >
          {t.services}
          <i class="fa-solid fa-chevron-down dropdown-arrow" aria-hidden="true"></i>
        </a>

        <!-- ====== SERVICIOS DROPDOWN ======
             ⚠️ PRECAUCIÓN: Este dropdown se genera dinámicamente desde
             src/data/services.ts. Para agregar/quitar categorías o subservicios,
             edita ese archivo. NO modifiques este HTML a mano.

             Rutas generadas automáticamente:
             - Categorías: /servicios/{cat.slug}
             - Subservicios: /servicios/{cat.slug}/{s.slug}
             - Con customUrl: se redirige a la página existente definida en customUrl

             El botón de categoría (cascade-cat-link) en MOBILE hace toggle del acordeón
             (e.preventDefault() en JS). En DESKTOP navega al href normalmente.
        -->
        <!-- Nivel 1: Categóras -->
        <ul class="v3-cascade-l1" role="menu" aria-label="Categorías de servicio" id="dd-servicios-menu">
          {SERVICE_CATEGORIES.map((cat) => (
            <li class="cascade-item" role="none" data-cat={cat.id} id={`dd-cat-${cat.id}`}>
              <a
                href="#"
                class="cascade-cat-link"
                role="menuitem"
                aria-haspopup="true"
                aria-expanded="false"
              >
                <span class="cascade-cat-icon-wrap">
                  <i class={`fa-solid ${cat.icon}`} aria-hidden="true"></i>
                </span>
                <span class="cascade-cat-label">{cat.title}</span>
                <i class="fa-solid fa-chevron-right cascade-arrow" aria-hidden="true"></i>
              </a>

              <!-- Nivel 2: Subservicios -->
              <ul
                class="v3-cascade-l2"
                role="menu"
                aria-label={`Servicios de ${cat.title}`}
              >
                <li class="v3-l2-header" role="presentation">
                  <i class={`fa-solid ${cat.icon}`} aria-hidden="true"></i>
                  <span>{cat.title}</span>
                </li>
                {cat.services.map((s) => (
                  <li role="none">
                    <a
                      href={s.customUrl ? s.customUrl : `/servicios/${cat.slug}/${s.slug}`}
                      class="v3-sub-link"
                      role="menuitem"
                    >
                      <i class="fa-solid fa-angle-right v3-sub-arrow" aria-hidden="true"></i>
                      {s.label}
                    </a>
                  </li>
                ))}
                <li class="v3-l2-footer" role="none">
                  <a href={`/servicios/${cat.slug}`} class="v3-all-link">
                    Ver todos los servicios de {cat.title}
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                  </a>
                </li>
              </ul>
            </li>
          ))}
          <li class="cascade-item" role="none">
            <a href="/servicios" class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-list-check" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">{lang === 'en' ? 'View all services' : 'Todos nuestros servicios'}</span>
              <i class="fa-solid fa-arrow-right cascade-arrow" aria-hidden="true"></i>
            </a>
          </li>
        </ul>
      </li>

      <!-- ====== PAQUETES ======
           ⚠️ PRECAUCIÓN: El trigger href apunta a /paquetes (hub de paquetes).
           Los subitems del dropdown apuntan a /paquetes?section=... y /optimizacion.
           El dropdown en DESKTOP se abre con :hover (CSS). En MOBILE el JS hace toggle.
           La clase .has-cascade activa el comportamiento de cascade dropdown en el JS.
      -->
      <li class="has-dropdown has-cascade" role="none">
        <a href="#" class="nav-links nav-dd-trigger" role="menuitem" aria-haspopup="true" aria-expanded="false">
          {t.packages} <i class="fa-solid fa-chevron-down dropdown-arrow" aria-hidden="true"></i>
        </a>
        <ul class="v3-cascade-l1" role="menu">
          <li class="cascade-item" role="none">
            <a href={lang === 'en' ? '/en/packages' : '/paquetes?section=paquetes'} class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">{lang === 'en' ? 'Maintenance' : 'Mantenimiento'}</span>
            </a>
          </li>
          <li class="cascade-item" role="none">
            <a href={lang === 'en' ? '/en/optimization' : '/optimizacion?section=paquetes-optimizacion'} class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-gauge-high" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">{lang === 'en' ? 'Optimization' : 'Optimización'}</span>
            </a>
          </li>
          <li class="cascade-item" role="none">
            <a href={lang === 'en' ? '/en/packages' : '/paquetes'} class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">{lang === 'en' ? 'All packages' : 'Todos los Paquetes'}</span>
              <i class="fa-solid fa-arrow-right cascade-arrow" aria-hidden="true"></i>
            </a>
          </li>
        </ul>
      </li>

      <!-- ====== INFORMACIÓN ======
           ⚠️ PRECAUCIÓN: El trigger href apunta a /preguntas-frecuentes.
           Subitems: FAQ, Reseñas, Catálogo en video, Garantía.
           Si agregas/quitas subitems, verifica que las páginas de destino existan.
      -->
      <li class="has-dropdown has-cascade" role="none">
        <a href="#" class="nav-links nav-dd-trigger" role="menuitem" aria-haspopup="true" aria-expanded="false">
          {t.info} <i class="fa-solid fa-chevron-down dropdown-arrow" aria-hidden="true"></i>
        </a>
        <ul class="v3-cascade-l1" role="menu">
          <li class="cascade-item" role="none">
            <a href={lang === 'en' ? '/en/faq' : '/preguntas-frecuentes'} class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-circle-question" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">{t.faq}</span>
            </a>
          </li>
          <li class="cascade-item" role="none">
            <a href={lang === 'en' ? '/en/reviews' : '/comentarios'} class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-star" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">{t.reviews}</span>
            </a>
          </li>
          <li class="cascade-item" role="none">
            <a href={lang === 'en' ? '/en/catalog' : '/catalogo'} class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-video" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">{t.catalog}</span>
            </a>
          </li>
          <li class="cascade-item" role="none">
            <a href={lang === 'en' ? '/en/warranty' : '/garantia'} class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">{t.warranty}</span>
            </a>
          </li>
        </ul>
      </li>

      <!-- ====== CONTACTO ======
           ⚠️ PRECAUCIÓN: Este ítem navega directamente a /contacto.
           El dropdown tiene 2 subitems: formulario y WhatsApp directo.
           El número de WhatsApp es 529986690777.
      -->
      <li class="has-dropdown has-cascade" role="none">
        <a href="#" class="nav-links nav-dd-trigger" role="menuitem" aria-haspopup="true" aria-expanded="false">
          {t.contact} <i class="fa-solid fa-chevron-down dropdown-arrow" aria-hidden="true"></i>
        </a>
        <ul class="v3-cascade-l1" role="menu">
          <li class="cascade-item" role="none">
            <a href={lang === 'en' ? '/en/contact' : '/contacto'} class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap"><i class="fa-solid fa-envelope" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">{lang === 'en' ? 'Send a message' : 'Enviar mensaje'}</span>
            </a>
          </li>
          <li class="cascade-item" role="none">
            <a href="https://wa.me/529986690777" target="_blank" rel="noopener noreferrer" class="cascade-cat-link" role="menuitem">
              <span class="cascade-cat-icon-wrap" style="color: #25d366; border-color: #25d36640; background: #25d36615;"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i></span>
              <span class="cascade-cat-label">WhatsApp Directo</span>
            </a>
          </li>
        </ul>
      </li>

      <!-- ====== B2B ======
           ⚠️ PRECAUCIÓN: Enlace simple sin dropdown. Apunta a /empresas.
           No tiene clase .has-cascade ni .has-dropdown — no agregar dropdown
           sin probar que el CSS no colisione con el resto del menú.
      -->
      <li role="none">
        <a href={lang === 'en' ? '/en/corporate' : '/empresas'} class="nav-links b2b-btn-premium" role="menuitem">
          <i class="fa-solid fa-building-shield" aria-hidden="true"></i> {t.b2b}
        </a>
      </li>

      <!-- Auth (mobile) -->
      <li class="nav-auth-mobile-li" id="nav-auth-mobile-li" role="none">
        <div id="nav-auth-area-mobile"></div>
      </li>
    </ul>

    <!-- Actions (desktop) -->
    <div class="nav-actions">
      <a
        href="https://pixon.com.mx/admin"
        class="nav-admin-gear"
        id="nav-admin-gear"
        title="Panel de administración"
        aria-label="Ir al panel de administración"
        style="display:none;"
      >
        <i class="fa-solid fa-gear" aria-hidden="true"></i>
      </a>
      <div id="nav-auth-area"></div>
    </div>

  </div>
</nav>

<style is:global>
/* ═══════════════════════════════════════════════════════════════════
   Navbar 3.0 — PREMIUM CASCADE — Desktop & Mobile
   Scope: .navbar-v3 → no afecta otros componentes
═══════════════════════════════════════════════════════════════════ */

/* ── Tuerca admin ── */
.navbar-v3 .nav-admin-gear {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  color: #64748b;
  text-decoration: none;
  transition: background .15s, color .15s, transform .25s cubic-bezier(.34,1.56,.64,1);
  margin-right: 4px;
}
.navbar-v3 .nav-admin-gear:hover {
  background: #eff6ff;
  color: #2563eb;
  transform: rotate(30deg);
}
.navbar-v3 .nav-admin-gear i { font-size: 1rem; }

/* ══════════════════════════════
   DESKTOP CASCADE (≥ 751px)
══════════════════════════════ */
@media (min-width: 751px) {

  /* ── Nivel 1: el dropdown de categorías */
  .navbar-v3 .has-cascade { position: relative; }

  .navbar-v3 .v3-cascade-l1 {
    list-style: none;
    margin: 0;
    /* Estilo propio — NO hereda .dropdown-menu para evitar conflictos */
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 230px;
    padding: 8px 0;
    background: #fff;
    border-radius: 12px;
    border: 1px solid rgba(0,0,0,.05);
    box-shadow: 0 10px 30px rgba(0,0,0,.1);
    z-index: 1050;

    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity .2s cubic-bezier(.4,0,.2,1),
      transform .2s cubic-bezier(.4,0,.2,1),
      visibility .2s;
    pointer-events: none;
  }

  /* Desktop: abrir L1 con :hover O con .open (click toggle) */
  .navbar-v3 .has-cascade:hover > .v3-cascade-l1,
  .navbar-v3 .has-cascade:focus-within > .v3-cascade-l1,
  .navbar-v3 .has-cascade.open > .v3-cascade-l1 {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }
  /* Rotar flecha al hover O al .open */
  .navbar-v3 .has-cascade:hover > .nav-links .dropdown-arrow,
  .navbar-v3 .has-cascade:focus-within > .nav-links .dropdown-arrow,
  .navbar-v3 .has-cascade.open > .nav-links .dropdown-arrow {
    transform: rotate(180deg);
  }

  /* Cada fila de categoría */
  .navbar-v3 .cascade-item {
    position: relative;
  }

  .navbar-v3 .cascade-cat-link {
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
    padding: 9px 14px 9px 12px !important;
    color: #1e293b !important;
    font-weight: 600;
    font-size: .88rem;
    text-decoration: none;
    border-radius: 0;
    transition: background .12s, color .12s;
    cursor: pointer;
  }

  .navbar-v3 .cascade-cat-icon-wrap {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #2563eb;
    font-size: .9rem;
    flex-shrink: 0;
    transition: background .12s, border-color .12s, box-shadow .12s;
  }

  .navbar-v3 .cascade-cat-label { flex: 1; }

  .navbar-v3 .cascade-arrow {
    margin-left: auto;
    font-size: .65rem;
    color: #cbd5e1;
    flex-shrink: 0;
    transition: transform .15s, color .12s;
  }

  /* Hover / focus en fila de categoría */
  .navbar-v3 .cascade-item:hover > .cascade-cat-link,
  .navbar-v3 .cascade-item:focus-within > .cascade-cat-link,
  .navbar-v3 .cascade-item.intent-open > .cascade-cat-link {
    background: #eff6ff !important;
    color: #2563eb !important;
  }
  .navbar-v3 .cascade-item:hover .cascade-cat-icon-wrap,
  .navbar-v3 .cascade-item:focus-within .cascade-cat-icon-wrap,
  .navbar-v3 .cascade-item.intent-open .cascade-cat-icon-wrap {
    background: #2563eb;
    border-color: #2563eb;
    color: #fff;
    box-shadow: 0 3px 10px rgba(37, 99, 235, .3);
  }
  .navbar-v3 .cascade-item:hover .cascade-arrow,
  .navbar-v3 .cascade-item:focus-within .cascade-arrow,
  .navbar-v3 .cascade-item.intent-open .cascade-arrow {
    color: #2563eb;
    transform: translateX(3px);
  }

  /* ── Nivel 2: sub-menú lateral ── */
  .navbar-v3 .v3-cascade-l2 {
    list-style: none;
    margin: 0;
    /* Base compartida con .dropdown-menu (bg, shadow, border-radius) */
    position: absolute;
    top: -8px;
    left: calc(100% + 2px);
    min-width: 250px;
    max-height: 70vh;
    overflow-y: auto;
    padding: 8px 0;
    background: #fff;
    border-radius: 12px;
    border: 1px solid rgba(0,0,0,.05);
    box-shadow: 0 16px 40px rgba(15,23,42,.14), 0 0 0 1px rgba(15,23,42,.06);
    z-index: 1100;

    /* Animación de entrada */
    opacity: 0;
    visibility: hidden;
    transform: translateX(6px);
    transition:
      opacity .18s cubic-bezier(.4,0,.2,1),
      transform .18s cubic-bezier(.4,0,.2,1),
      visibility .18s;
    pointer-events: none;
  }

  .navbar-v3 .cascade-item:hover > .v3-cascade-l2,
  .navbar-v3 .cascade-item:focus-within > .v3-cascade-l2,
  .navbar-v3 .cascade-item.intent-open > .v3-cascade-l2,
  .navbar-v3 .cascade-item.open > .v3-cascade-l2 {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    pointer-events: auto;
  }

  /* Header del sub-menú */
  .navbar-v3 .v3-l2-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 10px;
    font-size: .75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: #94a3b8;
    border-bottom: 1px solid #f1f5f9;
    margin-bottom: 4px;
  }
  .navbar-v3 .v3-l2-header i { color: #2563eb; font-size: .85rem; }

  /* Links del sub-menú */
  .navbar-v3 .v3-sub-link {
    display: flex !important;
    align-items: center;
    gap: 8px;
    padding: 8px 14px !important;
    color: #1e293b !important;
    font-size: .87rem !important;
    font-weight: 600;
    transition: background .1s, color .1s, padding-left .15s;
  }
  .navbar-v3 .v3-sub-link:hover {
    background: #f1f5f9 !important;
    color: #2563eb !important;
    padding-left: 20px !important;
  }
  .navbar-v3 .v3-sub-arrow {
    font-size: .6rem;
    color: #cbd5e1;
    flex-shrink: 0;
    transition: color .1s, transform .1s;
  }
  .navbar-v3 .v3-sub-link:hover .v3-sub-arrow {
    color: #2563eb;
    transform: translateX(2px);
  }

  /* Footer "Ver todos" del sub-menú */
  .navbar-v3 .v3-l2-footer {
    padding: 8px 14px 4px;
    margin-top: 4px;
    border-top: 1px solid #f1f5f9;
  }
  .navbar-v3 .v3-all-link {
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: .78rem !important;
    font-weight: 700;
    color: #2563eb !important;
    padding: 6px 8px !important;
    border-radius: 8px;
    background: #eff6ff;
    transition: background .12s, box-shadow .12s;
  }
  .navbar-v3 .v3-all-link:hover {
    background: #2563eb !important;
    color: #fff !important;
    box-shadow: 0 4px 12px rgba(37, 99, 235, .25);
  }
  .navbar-v3 .v3-all-link:hover i { color: #fff; }
  .navbar-v3 .v3-all-link i { font-size: .75rem; transition: transform .15s; }
  .navbar-v3 .v3-all-link:hover i { transform: translateX(3px); }

} /* end @media desktop */


/* ══════════════════════════════
   MOBILE (≤ 750px)  — Acordeón
══════════════════════════════ */
@media (max-width: 750px) {

  /* ────────────────────────────────────────────────
     NIVEL 1 cascade: reset desktop props
  ──────────────────────────────────────────────── */
  .navbar-v3 .v3-cascade-l1 {
    position: static !important;
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
    pointer-events: auto !important;
    display: none;
    background: transparent !important;
    box-shadow: none !important;
    border: none !important;
    padding: 0 !important;
    margin: 4px 0 0 !important;
    max-height: none;
    overflow: visible;
  }
  .navbar-v3 .v3-cascade-l1.active {
    display: block;
  }

  .navbar-v3 .nav-menu.active {
    max-height: calc(100dvh - 50px);
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
  }

  .navbar-v3 .nav-menu.active.is-menu-peeking {
    opacity: .86;
    transform: translateY(-8px);
  }

  /* ────────────────────────────────────────────────
     CATEGORÍAS — filas compactas, LEFT-ALIGNED
     Icono ▸ Nombre ▸ Flecha — todo junto
  ──────────────────────────────────────────────── */
  .navbar-v3 .cascade-item {
    margin: 0 16px; /* Separado de los bordes de la pantalla */
    padding: 0;
    border-left: none;
    border-radius: 10px;
    overflow: hidden;
    transition: background .15s ease;
  }
  .navbar-v3 .cascade-item + .cascade-item {
    margin-top: 6px; /* Más separación entre categorías */
  }
  .navbar-v3 .cascade-item.open {
    background: #f0f5ff;
  }

  .navbar-v3 .cascade-cat-link {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;  /* LEFT aligned, not centered */
    text-align: left !important;
    gap: 14px !important; /* Más espacio entre icono y nombre */
    padding: 14px 16px !important; /* Zonas clickeables más amplias */
    color: #0f172a !important;               /* Texto muy oscuro */
    font-weight: 700;
    font-size: 1.05rem !important; /* Letra más grande y legible */
    width: 100%;
    cursor: pointer;
    border-radius: 10px;
    transition: background .12s ease;
  }
  .navbar-v3 .cascade-cat-link:active {
    background: #e8f0fe;
  }

  /* Icono cuadrado al LADO del nombre */
  .navbar-v3 .cascade-cat-icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: #eff6ff;
    border: 1px solid #dbeafe;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #2563eb;
    font-size: 1rem;
    flex-shrink: 0;
    transition: all .15s ease;
  }
  .navbar-v3 .cascade-item.open .cascade-cat-icon-wrap {
    background: #2563eb;
    border-color: #1d4ed8;
    color: #fff;
    box-shadow: 0 2px 8px rgba(37, 99, 235, .3);
  }

  /* Nombre: NO ocupa todo el espacio libre para que la flecha no se aleje */
  .navbar-v3 .cascade-cat-label {
    flex: 0 1 auto; /* Cambiado: antes era flex: 1 */
    text-align: left !important;
    line-height: 1.2;
  }

  /* Flecha: CERCA del nombre (no pegada al borde derecho) */
  .navbar-v3 .cascade-arrow {
    font-size: .75rem;
    color: #64748b;
    flex-shrink: 0;
    margin-left: 0;   /* pegada al nombre */
    transition: transform .25s cubic-bezier(.4,0,.2,1), color .15s;
  }
  .navbar-v3 .cascade-item.open > .cascade-cat-link .cascade-arrow {
    transform: rotate(90deg);
    color: #2563eb;
  }

  /* ────────────────────────────────────────────────
     SUB-MENÚ L2: acordeón con fondo claro y texto legible
  ──────────────────────────────────────────────── */
  .navbar-v3 .v3-cascade-l2 {
    position: static !important;
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
    pointer-events: auto !important;

    max-height: 0;
    overflow: hidden;
    transition: max-height .35s cubic-bezier(.4,0,.2,1),
                padding .2s ease;

    background: #f8fafc;
    border-radius: 0 0 10px 10px;
    box-shadow: none !important;
    border: none !important;
    border-top: 1px solid #e2e8f0 !important;
    padding: 0 !important;
    margin: 0 !important;
  }
  .navbar-v3 .cascade-item.open > .v3-cascade-l2 {
    max-height: 850px; /* Más alto por si el espaciado empuja todo abajo */
    padding: 8px 0 14px !important;
  }

  /* Header del L2 en mobile — oculto */
  .navbar-v3 .v3-l2-header {
    display: none;
  }

  /* ── Links de subservicios — texto OSCURO y legible, MUCHO ESPACIO ── */
  .navbar-v3 .v3-sub-link {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    text-align: left !important;
    gap: 12px;
    padding: 14px 16px 14px 30px !important;
    font-size: 1rem !important;
    color: #0f172a !important;
    font-weight: 500;
    border-radius: 6px;
    margin: 4px 10px;
    transition: background .1s ease, color .1s ease;
  }
  .navbar-v3 .v3-sub-link .v3-sub-arrow { font-size: .65rem; color: #3b82f6; flex-shrink: 0; }
  .navbar-v3 .v3-sub-link:hover,
  .navbar-v3 .v3-sub-link:active { background: #eff6ff !important; color: #2563eb !important; }
  .navbar-v3 .v3-sub-link:hover .v3-sub-arrow,
  .navbar-v3 .v3-sub-link:active .v3-sub-arrow { color: #2563eb; }

  /* ── Footer "Ver todos" en mobile ── */
  .navbar-v3 .v3-l2-footer { padding: 12px 12px 6px; margin-top: 8px; border-top: 1px solid #e2e8f0; }
  .navbar-v3 .v3-all-link {
    font-size: .95rem !important;
    font-weight: 700;
    color: #2563eb !important;
    padding: 14px !important;
    background: #eff6ff !important;
    border-radius: 8px;
    gap: 6px;
    display: flex !important;
    align-items: center;
    justify-content: center;
    transition: background .12s ease;
  }
  .navbar-v3 .v3-all-link:hover,
  .navbar-v3 .v3-all-link:active { background: #dbeafe !important; }
  .navbar-v3 .v3-all-link i { font-size: .7rem; }

} /* end @media mobile */

/* Opacidad parcial antes del hide completo */
.navbar.is-scrolling-down:not(.is-hidden) {
  opacity: 0.85;
  transition: opacity .3s ease;
}

.nav-reveal-zone {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 28px;
  z-index: 1001;
  pointer-events: none;
  background: transparent;
}

body.navbar-hidden .nav-reveal-zone {
  pointer-events: auto;
}
</style>

<script>
// ════════════════════════════════════════════════════════
//  Navbar 3.0 — JavaScript v3.2 — Full UX Overhaul
//  · Desktop: 4s auto-close, 2s cross-section, 3s exit grace
//  · Mobile: stable accordion, no accidental close on scroll
//  · Gap tolerance 400ms between nested items
//  · Click-outside closes all (including mobile hamburger)
//  · Progressive scroll-hide (2 scrolls to fully hide)
//  · All routes unchanged
// ════════════════════════════════════════════════════════

const IS_MOBILE = () => window.innerWidth <= 750;

// 1. HAMBURGER
const mobileMenuBtn = document.getElementById('mobile-menu');
const navMenu = document.getElementById('nav-menu');
mobileMenuBtn?.addEventListener('click', () => {
  navbarEl?.classList.remove('is-hidden', 'is-scrolling-down');
  const isOpen = mobileMenuBtn.classList.toggle('active');
  navMenu?.classList.toggle('active');
  navMenu?.classList.remove('is-menu-peeking');
  mobileMenuBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  if (!isOpen) closeAllCascades();
});

// 2. DROPDOWNS ESTÁNDAR (sin cascade — compatibilidad futura)
document.querySelectorAll('.has-dropdown:not(.has-cascade) > .nav-dd-trigger').forEach((trigger) => {
  trigger.addEventListener('click', (e) => {
    if (!IS_MOBILE()) return;
    e.preventDefault();
    const parent = trigger.parentElement;
    const menu = parent?.querySelector('.dropdown-menu');
    if (!menu) return;
    const isOpen = parent.classList.toggle('open');
    menu.classList.toggle('active', isOpen);
    trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    document.querySelectorAll('.has-dropdown.open').forEach((el) => {
      if (el !== parent) {
        el.classList.remove('open');
        el.querySelector('.dropdown-menu')?.classList.remove('active');
        el.querySelector('.nav-dd-trigger')?.setAttribute('aria-expanded', 'false');
      }
    });
  });
});

// ── Shared state ──
let autoCloseTimer = null;
let crossSectionTimer = null;
let lastOpenedCascade = null;
let activeCascade = null;
let desktopCloseTimer = null;

function clearTimers() {
  if (autoCloseTimer)    { clearTimeout(autoCloseTimer);    autoCloseTimer = null; }
  if (crossSectionTimer) { clearTimeout(crossSectionTimer); crossSectionTimer = null; }
  if (desktopCloseTimer) { clearTimeout(desktopCloseTimer); desktopCloseTimer = null; }
}

function openCascade(parent) {
  if (!parent) return;
  clearTimers();
  closeAllCascades(parent);
  parent.classList.add('open');
  parent.querySelector('.v3-cascade-l1')?.classList.add('active');
  parent.querySelector('.nav-dd-trigger')?.setAttribute('aria-expanded', 'true');
  lastOpenedCascade = parent;
  activeCascade = parent;
}

function closeCascade(el) {
  el.classList.remove('open');
  el.querySelector('.v3-cascade-l1')?.classList.remove('active');
  el.querySelector('.nav-dd-trigger')?.setAttribute('aria-expanded', 'false');
  el.querySelectorAll('.cascade-item.open').forEach((sub) => {
    sub.classList.remove('open');
    sub.querySelector('.cascade-cat-link')?.setAttribute('aria-expanded', 'false');
  });
  el.querySelectorAll('.cascade-item.intent-open').forEach((sub) => sub.classList.remove('intent-open'));
  if (activeCascade === el) activeCascade = null;
}

function closeAllCascades(except) {
  document.querySelectorAll('.has-cascade.open').forEach((el) => {
    if (el !== except) closeCascade(el);
  });
  activeCascade = except || null;
}

function closeMobileMenu() {
  navMenu?.classList.remove('active', 'is-menu-peeking');
  mobileMenuBtn?.classList.remove('active');
  mobileMenuBtn?.setAttribute('aria-expanded', 'false');
  closeAllCascades();
  lastOpenedCascade = null;
  activeCascade = null;
}

// 3. CASCADE TRIGGERS
document.querySelectorAll('.has-cascade > .nav-dd-trigger').forEach((trigger) => {
  const parent = trigger.parentElement;

  trigger.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    const wasOpen = parent.classList.contains('open');
    clearTimers();
    navbarEl?.classList.remove('is-hidden', 'is-scrolling-down');
    if (wasOpen) { closeCascade(parent); lastOpenedCascade = null; return; }
    openCascade(parent);
    // Desktop: auto-cierre 4s si el cursor nunca entra
    if (!IS_MOBILE()) {
      autoCloseTimer = setTimeout(() => {
        if (!parent.matches(':hover')) { closeCascade(parent); if (lastOpenedCascade === parent) lastOpenedCascade = null; }
      }, 4000);
    }
  });

  let exitTimer = null;
  parent.addEventListener('mouseenter', () => {
    if (IS_MOBILE()) return;
    clearTimers();
    if (exitTimer) { clearTimeout(exitTimer); exitTimer = null; }
    if (activeCascade !== parent) openCascade(parent);
  });
  parent.addEventListener('mouseleave', () => {
    if (IS_MOBILE() || !parent.classList.contains('open')) return;
    if (exitTimer) clearTimeout(exitTimer);
    exitTimer = setTimeout(() => {
      if (!parent.matches(':hover') && activeCascade === parent) {
        closeCascade(parent);
        if (lastOpenedCascade === parent) lastOpenedCascade = null;
      }
    }, 90);
  });
  trigger.addEventListener('mouseenter', () => {
    if (IS_MOBILE()) return;
    if (activeCascade !== parent) openCascade(parent);
  });
  trigger.addEventListener('mouseleave', () => {
    if (IS_MOBILE()) return;
    if (crossSectionTimer) { clearTimeout(crossSectionTimer); crossSectionTimer = null; }
  });
});

// 4. TOLERANCIA DE GAPS — L1 panel: 3s de gracia
document.querySelectorAll('.v3-cascade-l1').forEach((l1) => {
  let l1Timer = null;
  l1.addEventListener('mouseenter', () => { clearTimers(); if (l1Timer) { clearTimeout(l1Timer); l1Timer = null; } });
  l1.addEventListener('mouseleave', () => {
    if (IS_MOBILE()) return;
    const pc = l1.closest('.has-cascade');
    if (!pc?.classList.contains('open')) return;
    l1Timer = setTimeout(() => {
      if (!pc.matches(':hover')) { closeCascade(pc); if (lastOpenedCascade === pc) lastOpenedCascade = null; }
    }, 3000);
  });
});

// L2 items: 400ms de gracia entre opciones
document.querySelectorAll('.cascade-item').forEach((item) => {
  let gapTimer = null;
  item.addEventListener('mouseenter', () => {
    if (IS_MOBILE()) return;
    if (gapTimer) { clearTimeout(gapTimer); gapTimer = null; }
    if (item.querySelector('.v3-cascade-l2')) item.classList.add('intent-open');
  });
  item.addEventListener('mouseleave', () => {
    if (IS_MOBILE()) return;
    const l2 = item.querySelector('.v3-cascade-l2');
    if (!l2) return;
    gapTimer = setTimeout(() => {
      if (!item.matches(':hover') && !l2.matches(':hover')) {
        item.classList.remove('intent-open');
        item.classList.remove('open');
        item.querySelector('.cascade-cat-link')?.setAttribute('aria-expanded', 'false');
      }
    }, 450);
  });
});

// 5. CASCADE CATEGORÍAS
document.querySelectorAll('.cascade-cat-link').forEach((link) => {
  link.addEventListener('click', (e) => {
    const item = link.parentElement;
    const submenu = item?.querySelector('.v3-cascade-l2');
    if (!submenu) {
      const href = link.getAttribute('href');
      if (href && href !== '#') {
        link.getAttribute('target') === '_blank'
          ? window.open(href, '_blank', 'noopener,noreferrer')
          : (window.location.href = href);
      }
      return;
    }
    e.preventDefault();
    e.stopPropagation();
    const isOpen = item.classList.toggle('open');
    link.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    item.parentElement?.querySelectorAll('.cascade-item.open').forEach((sib) => {
      if (sib !== item) { sib.classList.remove('open'); sib.querySelector('.cascade-cat-link')?.setAttribute('aria-expanded', 'false'); }
    });
  });
});

// 6. CLICK FUERA
document.addEventListener('click', (e) => {
  const navbar = document.getElementById('navbar');
  if (navbar && !navbar.contains(e.target)) {
    clearTimers();
    if (IS_MOBILE() && navMenu?.classList.contains('active')) closeMobileMenu();
    else { closeAllCascades(); lastOpenedCascade = null; }
    return;
  }
  document.querySelectorAll('.has-cascade.open').forEach((el) => { if (!el.contains(e.target)) closeCascade(el); });
});

let mobileEdgeScrollCount = 0;
let touchStartY = 0;
let edgeResetTimer = null;
let lastEdgeRegisterAt = 0;
function registerMobileEdgeScroll(direction) {
  if (!IS_MOBILE() || !navMenu?.classList.contains('active')) return;
  if (Math.abs(direction) < 6) return;
  const atTop = navMenu.scrollTop <= 1;
  const atBottom = navMenu.scrollTop + navMenu.clientHeight >= navMenu.scrollHeight - 1;
  if ((direction > 0 && !atBottom) || (direction < 0 && !atTop)) {
    mobileEdgeScrollCount = 0;
    navMenu.classList.remove('is-menu-peeking');
    return;
  }
  const now = Date.now();
  if (now - lastEdgeRegisterAt < 350) return;
  lastEdgeRegisterAt = now;
  mobileEdgeScrollCount += 1;
  navMenu.classList.add('is-menu-peeking');
  clearTimeout(edgeResetTimer);
  edgeResetTimer = setTimeout(() => {
    mobileEdgeScrollCount = 0;
    navMenu?.classList.remove('is-menu-peeking');
  }, 900);
  if (mobileEdgeScrollCount >= 2) {
    closeMobileMenu();
    mobileEdgeScrollCount = 0;
  }
}

navMenu?.addEventListener('wheel', (e) => {
  registerMobileEdgeScroll(e.deltaY);
}, { passive: true });
navMenu?.addEventListener('touchstart', (e) => {
  touchStartY = e.touches[0]?.clientY || 0;
}, { passive: true });
navMenu?.addEventListener('touchmove', (e) => {
  const currentY = e.touches[0]?.clientY || touchStartY;
  registerMobileEdgeScroll(touchStartY - currentY);
}, { passive: true });

// 7. ADMIN GEAR
const adminGear = document.getElementById('nav-admin-gear');
if (adminGear) {
  fetch('/api/me', { credentials: 'include' })
    .then((r) => r.json()).then((d) => {
      if (d?.user?.role === 'admin') {
        adminGear.href = (location.hostname === 'localhost' || location.hostname === '127.0.0.1')
          ? 'https://pixon.com.mx/admin'
          : '/admin';
        adminGear.style.display = 'inline-flex';
      }
    })
    .catch(() => {});
}

// 8. SCROLL HIDE progresivo
let lastScroll = 0, ticking = false, scrollDownCount = 0;
const navbarEl = document.getElementById('navbar');
const navRevealZone = document.getElementById('nav-reveal-zone');

function syncNavbarHiddenState() {
  document.body.classList.toggle('navbar-hidden', Boolean(navbarEl?.classList.contains('is-hidden')));
}

function revealNavbarForInteraction() {
  if (IS_MOBILE()) return;
  scrollDownCount = 0;
  navbarEl?.classList.remove('is-hidden', 'is-scrolling-down');
  syncNavbarHiddenState();
}

navRevealZone?.addEventListener('mouseenter', revealNavbarForInteraction);
navbarEl?.addEventListener('mouseenter', revealNavbarForInteraction);
window.addEventListener('mousemove', (event) => {
  if (event.clientY <= 28 && navbarEl?.classList.contains('is-hidden')) {
    revealNavbarForInteraction();
  }
}, { passive: true });

function handleScroll() {
  const curr = window.pageYOffset;
  const delta = curr - lastScroll;
  if (curr > 80) navbarEl?.classList.add('is-scrolled'); else navbarEl?.classList.remove('is-scrolled');
  const menuOpen = IS_MOBILE() && navMenu?.classList.contains('active');
  if (menuOpen && Math.abs(delta) > 4) {
    navMenu?.classList.add('is-menu-peeking');
    window.setTimeout(() => closeMobileMenu(), 180);
  } else if (!menuOpen) {
    if (delta > 4 && curr > 220) {
      scrollDownCount++;
      navbarEl?.classList.add('is-scrolling-down');
      if (scrollDownCount >= 2) { navbarEl?.classList.add('is-hidden'); closeAllCascades(); lastOpenedCascade = null; }
    } else if (delta < -4) {
      scrollDownCount = 0;
      navbarEl?.classList.remove('is-hidden');
      navbarEl?.classList.remove('is-scrolling-down');
    }
  }
  syncNavbarHiddenState();
  lastScroll = Math.max(curr, 0);
  ticking = false;
}
window.addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(handleScroll); ticking = true; } }, { passive: true });
syncNavbarHiddenState();
</script>
