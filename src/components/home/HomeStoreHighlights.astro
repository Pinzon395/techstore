---
import storeCss from '../../styles/store.css?url';
---
<link rel="stylesheet" href={storeCss} />
<section class="home-store-highlights" aria-labelledby="home-store-title">
  <div class="store-shell">
    <header class="store-section-heading">
      <div>
        <p class="store-section-label">Marketplace Pixon PC</p>
        <h2 id="home-store-title">Equipos y ofertas disponibles</h2>
        <p>Equipos, hardware y servicios publicados con precio y disponibilidad administrados desde nuestro catálogo.</p>
      </div>
      <a class="home-store-link" href="/tienda">Ver toda la tienda <span aria-hidden="true">→</span></a>
    </header>
    <div class="home-store-grid" id="home-store-grid" aria-live="polite">
      {Array.from({ length: 3 }).map(() => <div class="home-store-skeleton" aria-hidden="true"></div>)}
    </div>
    <div class="store-state" id="home-store-empty" hidden>
      <h3>Estamos preparando nuevas publicaciones</h3>
      <p>Mientras tanto, cuéntanos qué equipo o servicio buscas.</p>
      <a href="/tickets">Crear solicitud</a>
    </div>
  </div>
</section>
<script src="/scripts/home-store.js?v=20260812-1" is:inline defer></script>

