</style>

<script is:inline>
(function() {
  'use strict';

  // Helpers de fecha en zona horaria Cancún
  function getCancunTodayISO() {
    var parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Cancun',
      year: 'numeric', month: '2-digit', day: '2-digit'
    }).formatToParts(new Date());
    var m = {};
    for (var i = 0; i < parts.length; i++) m[parts[i].type] = parts[i].value;
    return m.year + '-' + m.month + '-' + m.day;
  }

  function getCancunMonthISO() {
    return getCancunTodayISO().slice(0, 7);
  }

  function formatMonthTitle(isoMonth) {
    var segs = isoMonth.split('-').map(Number);
    var dt = new Date(Date.UTC(segs[0], segs[1] - 1, 1, 12));
    var str = dt.toLocaleDateString('es-MX', { month: 'long', year: 'numeric', timeZone: 'America/Cancun' });
    return str.charAt(0).toUpperCase() + str.slice(1);
  }

  function formatDateHuman(isoDate) {
    var segs = isoDate.split('-').map(Number);
    var dt = new Date(Date.UTC(segs[0], segs[1] - 1, segs[2], 12));
    var str = dt.toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'America/Cancun' });
    return str.charAt(0).toUpperCase() + str.slice(1);
  }

  // Estado del Wizard
  var currentMonth = getCancunMonthISO();
  var selectedDate = null;
  var selectedSlotTime = null;
  var monthAvailabilityData = null;
  var cachedDayData = {};

  // Elementos del DOM
  var monthLabel = document.getElementById('hac-month-label');
  var daysGrid = document.getElementById('hac-days-grid');
  var btnPrevMonth = document.getElementById('hac-btn-prev-month');
  var btnNextMonth = document.getElementById('hac-btn-next-month');
  var selectedDayLabel = document.getElementById('hac-selected-day-label');
  var slotsContainer = document.getElementById('hac-slots-container');

  var stepIndicator1 = document.getElementById('hac-step-indicator-1');
  var stepIndicator2 = document.getElementById('hac-step-indicator-2');
  var stepIndicator3 = document.getElementById('hac-step-indicator-3');

  var panelStep1 = document.getElementById('hac-panel-step1');
  var panelStep2 = document.getElementById('hac-panel-step2');
  var panelStep3 = document.getElementById('hac-panel-step3');

  var summaryDateTime = document.getElementById('hac-summary-datetime');
  var btnBackStep1 = document.getElementById('hac-btn-back-step1');
  var btnCancelStep2 = document.getElementById('hac-btn-cancel-step2');
  var bookingForm = document.getElementById('hac-booking-form');
  var submitError = document.getElementById('hac-submit-error');
  var submitErrorText = document.getElementById('hac-submit-error-text');
  var btnSubmitBooking = document.getElementById('hac-btn-submit-booking');

  var confFolio = document.getElementById('hac-conf-folio');
  var confDatetime = document.getElementById('hac-conf-datetime');
  var confDevice = document.getElementById('hac-conf-device');
  var confName = document.getElementById('hac-conf-name');
  var btnOpenWa = document.getElementById('hac-btn-open-wa');
  var btnResetWizard = document.getElementById('hac-btn-reset-wizard');

  // Inicializar diferido con IntersectionObserver para no bloquear first render ni cargar APIs a 2000px del viewport
  var calendarLoaded = false;
  function triggerCalendarLoad() {
    if (calendarLoaded) return;
    calendarLoaded = true;
    loadMonthAvailability(currentMonth);
  }

  function initCalendar() {
    if (monthLabel) monthLabel.textContent = formatMonthTitle(currentMonth);
    bindEvents();

    var section = document.getElementById('agendar-cita');
    if ('IntersectionObserver' in window && section) {
      var obs = new IntersectionObserver(function(entries) {
        if (entries.some(function(e) { return e.isIntersecting; })) {
          triggerCalendarLoad();
          obs.disconnect();
        }
      }, { rootMargin: '800px 0px' });
      obs.observe(section);
    } else {
      triggerCalendarLoad();
    }
  }

  function bindEvents() {
    if (btnPrevMonth) {
      btnPrevMonth.addEventListener('click', function() { changeMonth(-1); });
    }
    if (btnNextMonth) {
      btnNextMonth.addEventListener('click', function() { changeMonth(1); });
    }
    if (btnBackStep1) {
      btnBackStep1.addEventListener('click', function() { goToStep(1); });
    }
    if (btnCancelStep2) {
      btnCancelStep2.addEventListener('click', function() { goToStep(1); });
    }
    if (bookingForm) {
      bookingForm.addEventListener('submit', handleFormSubmit);
    }
    if (btnResetWizard) {
      btnResetWizard.addEventListener('click', function() {
        goToStep(1);
        bookingForm.reset();
        loadMonthAvailability(currentMonth);
      });
    }
  }

  function changeMonth(delta) {
    var segs = currentMonth.split('-').map(Number);
    var dt = new Date(Date.UTC(segs[0], segs[1] - 1 + delta, 1, 12));
    currentMonth = dt.toISOString().slice(0, 7);
    selectedDate = null;
    selectedSlotTime = null;
    renderEmptySlots();
    loadMonthAvailability(currentMonth);
  }

  // Carga de disponibilidad del mes desde la API de appointments
  async function loadMonthAvailability(isoMonth) {
    if (monthLabel) monthLabel.textContent = formatMonthTitle(isoMonth);
    if (daysGrid) {
      daysGrid.innerHTML = '<div class="hac-cal-loading"><span class="hac-spinner"></span><span>Actualizando disponibilidad en vivo…</span></div>';
    }

    try {
      var res = await fetch('/api/appointments/availability/month?month=' + encodeURIComponent(isoMonth) + '&type=DROP_OFF', { cache: 'no-store' });
      if (!res.ok) throw new Error('Status ' + res.status);
      var data = await res.json();
      monthAvailabilityData = data;
      renderCalendarDays(data.days || []);
    } catch (err) {
      console.warn('API month availability error:', err);
      if (daysGrid) {
        daysGrid.innerHTML = '<div class="hac-cal-loading" role="status"><p style="margin-bottom:8px;font-size:0.95rem;">Recepción activa de 11:00 AM a 10:00 PM en taller Cancún.</p><div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:6px;"><button type="button" class="hac-slot-btn" id="hac-retry-month">Reintentar</button><a href="https://wa.me/529986690777?text=Hola%20Pixon%20PC%2C%20quiero%20agendar%20cita%20en%20taller%20Canc%C3%BAn." class="hac-slot-btn" style="background:#25D366;color:#fff;text-decoration:none;display:inline-flex;align-items:center;gap:6px;" target="_blank"><i class="fa-brands fa-whatsapp"></i> Agendar por WhatsApp</a></div></div>';
        var retryMonth = document.getElementById('hac-retry-month');
        if (retryMonth) retryMonth.addEventListener('click', function() { loadMonthAvailability(isoMonth); });
      }
    }
  }

  function renderCalendarDays(days) {
    var todayISO = getCancunTodayISO();
    var segs = currentMonth.split('-').map(Number);
    var firstWeekday = new Date(Date.UTC(segs[0], segs[1] - 1, 1, 12)).getUTCDay();

    var html = '';
    // Celdas vacías iniciales para alinear días de la semana
    for (var i = 0; i < firstWeekday; i++) {
      html += '<div class="hac-day-cell empty" aria-hidden="true"></div>';
    }

    // Mapa de días recibido de la API
    var dayMap = {};
    for (var d = 0; d < days.length; d++) {
      dayMap[days[d].date] = days[d];
    }

    var totalDays = new Date(Date.UTC(segs[0], segs[1], 0)).getUTCDate();

    for (var dayNum = 1; dayNum <= totalDays; dayNum++) {
      var dateStr = currentMonth + '-' + String(dayNum).padStart(2, '0');
      var hasDayInfo = Object.prototype.hasOwnProperty.call(dayMap, dateStr);
      var dayInfo = dayMap[dateStr] || { status: 'UNKNOWN', available_slots: 0 };
      var isPast = dateStr < todayISO;
      var isToday = dateStr === todayISO;
      var isClosed = dayInfo.status === 'CLOSED';
      var isFull = dayInfo.status === 'FULL';
      var isLimited = dayInfo.status === 'LIMITED';
      var isClickable = hasDayInfo && !isPast && !isClosed && !isFull && Number(dayInfo.available_slots) > 0;

      var cellClass = 'hac-day-cell';
      var badgeText = '';

      if (isPast) {
        cellClass += ' past';
      } else if (!hasDayInfo) {
        cellClass += ' closed';
        badgeText = 'Sin datos';
      } else if (isClosed) {
        cellClass += ' closed';
        badgeText = 'Cerrado';
      } else if (isFull) {
        cellClass += ' full';
        badgeText = 'Lleno';
      } else if (isLimited && isClickable) {
        cellClass += ' limited clickable';
        badgeText = 'Últimos';
      } else if (isClickable) {
        cellClass += ' avail clickable';
        badgeText = 'Libre';
      } else {
        cellClass += ' full';
        badgeText = 'Sin turnos';
      }

      if (isToday) cellClass += ' today';
      if (selectedDate === dateStr) cellClass += ' selected';

      html += '<div class="' + cellClass + '" data-date="' + dateStr + '"' +
              (isClickable ? ' tabindex="0" role="button" aria-label="' + dateStr + ': ' + badgeText + '"' : ' aria-disabled="true"') + '>' +
              '<span class="hac-day-num">' + dayNum + '</span>' +
              (badgeText ? '<span class="hac-day-badge">' + badgeText + '</span>' : '') +
              '</div>';
    }

    if (daysGrid) {
      daysGrid.innerHTML = html;
      var clickableCells = daysGrid.querySelectorAll('.hac-day-cell.clickable');
      clickableCells.forEach(function(cell) {
        cell.addEventListener('click', function() { selectDate(cell.dataset.date); });
        cell.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            selectDate(cell.dataset.date);
          }
        });
      });
    }

    // Auto-seleccionar hoy o el primer día disponible si no hay seleccionado
    if (!selectedDate) {
      var firstAvailable = daysGrid ? daysGrid.querySelector('.hac-day-cell.clickable') : null;
      if (firstAvailable && firstAvailable.dataset.date) {
        selectDate(firstAvailable.dataset.date);
      }
    }
  }

  // Carga de horarios del día seleccionado
  async function selectDate(dateStr) {
    selectedDate = dateStr;
    selectedSlotTime = null;

    // Actualizar clase visual en el calendario
    if (daysGrid) {
      var cells = daysGrid.querySelectorAll('.hac-day-cell');
      cells.forEach(function(c) {
        c.classList.toggle('selected', c.dataset.date === dateStr);
      });
    }

    if (selectedDayLabel) {
      selectedDayLabel.textContent = formatDateHuman(dateStr);
    }

    if (slotsContainer) {
      slotsContainer.innerHTML = '<div class="hac-cal-loading"><span class="hac-spinner"></span><span>Consultando horarios en vivo…</span></div>';
    }

    try {
      var res = await fetch('/api/appointments/availability?date=' + encodeURIComponent(dateStr) + '&type=DROP_OFF', { cache: 'no-store' });
      if (!res.ok) throw new Error('Slots status ' + res.status);
      var data = await res.json();
      cachedDayData[dateStr] = data;
      renderSlots(dateStr, data);
    } catch (err) {
      console.warn('API slot availability error:', err);
      if (slotsContainer) slotsContainer.innerHTML = '<div class="hac-slots-empty-state" role="status"><h4>No pudimos consultar los horarios</h4><p>Intenta de nuevo antes de seleccionar un turno.</p><button type="button" class="hac-slot-btn" id="hac-retry-slots">Reintentar</button></div>';
      var retrySlots = document.getElementById('hac-retry-slots');
      if (retrySlots) retrySlots.addEventListener('click', function() { selectDate(dateStr); });
    }
  }

  function renderSlots(dateStr, data) {
    if (!slotsContainer) return;

    if (!data.is_open) {
      slotsContainer.innerHTML = '<div class="hac-slots-empty-state"><div class="hac-empty-icon"><i class="fa-solid fa-store-slash"></i></div><h4>Taller cerrado este día</h4><p>' + (data.message || 'El taller no tiene recepción en esta fecha.') + '</p></div>';
      return;
    }

    var slots = data.slots || [];
    if (!slots.length) {
      slotsContainer.innerHTML = '<div class="hac-slots-empty-state" role="status"><h4>Sin turnos disponibles</h4><p>Elige otro día o vuelve a consultar más tarde.</p></div>';
      return;
    }

    var html = '<div class="hac-slots-grid">';
    for (var i = 0; i < slots.length; i++) {
      var slot = slots[i];
      var isAvailable = slot.available;
      var timeFormatted = slot.time;

      if (isAvailable) {
        // Horario LIBRE -> Verde esmeralda (#059669 / #10b981)
        html += '<button type="button" class="hac-slot-btn" data-time="' + timeFormatted + '" data-date="' + dateStr + '">' +
                '<span class="hac-slot-time">' + timeFormatted + '</span>' +
                '<span class="hac-slot-tag-avail">Disponible</span>' +
                '</button>';
      } else {
        // Horario OCUPADO / CITA AGENDADA -> Azul corporativo (#0284c7 / #1e40af)
        html += '<div class="hac-slot-booked" title="Horario con cita ya agendada">' +
                '<span class="hac-slot-time">' + timeFormatted + '</span>' +
                '<span class="hac-slot-tag-booked">Cita agendada</span>' +
                '</div>';
      }
    }
    html += '</div>';

    slotsContainer.innerHTML = html;

    // Asignar listeners a los horarios libres
    var slotButtons = slotsContainer.querySelectorAll('.hac-slot-btn');
    slotButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        chooseSlot(btn.dataset.date, btn.dataset.time);
      });
    });
  }

  function renderEmptySlots() {
    if (slotsContainer) {
      slotsContainer.innerHTML = '<div class="hac-slots-empty-state"><div class="hac-empty-icon"><i class="fa-solid fa-clock"></i></div><h4>Selecciona un día</h4><p>Elige un día con disponibilidad en el calendario para ver los horarios.</p></div>';
    }
  }

  // Selección de Horario -> Avanza a Paso 2
  function chooseSlot(dateStr, timeStr) {
    selectedDate = dateStr;
    selectedSlotTime = timeStr;

    if (summaryDateTime) {
      summaryDateTime.textContent = formatDateHuman(dateStr) + ' · ' + timeStr;
    }

    goToStep(2);

    var nameField = document.getElementById('hac_name');
    if (nameField) {
      setTimeout(function() { nameField.focus(); }, 150);
    }
  }

  // Navegación entre Pasos del Stepper
  function goToStep(stepNumber) {
    if (panelStep1) panelStep1.hidden = (stepNumber !== 1);
    if (panelStep2) panelStep2.hidden = (stepNumber !== 2);
    if (panelStep3) panelStep3.hidden = (stepNumber !== 3);

    // Actualizar clases en stepper
    if (stepIndicator1) {
      stepIndicator1.classList.toggle('active', stepNumber === 1);
      stepIndicator1.classList.toggle('completed', stepNumber > 1);
    }
    if (stepIndicator2) {
      stepIndicator2.classList.toggle('active', stepNumber === 2);
      stepIndicator2.classList.toggle('completed', stepNumber > 2);
    }
    if (stepIndicator3) {
      stepIndicator3.classList.toggle('active', stepNumber === 3);
    }

    var card = document.getElementById('hac-wizard-card');
    if (card) {
      var rect = card.getBoundingClientRect();
      if (rect.top < 80 || rect.top > 400) {
        card.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  }

  // Envío del Formulario (Paso 2 -> Creación en vivo -> Paso 3)
  async function handleFormSubmit(e) {
    e.preventDefault();
    if (submitError) submitError.style.display = 'none';

    var nameInput = document.getElementById('hac_name');
    var phoneInput = document.getElementById('hac_phone');
    var deviceSelect = document.getElementById('hac_device');
    var serviceSelect = document.getElementById('hac_service_type');
    var notesInput = document.getElementById('hac_notes');

    var isValid = true;

    function validateField(input) {
      var val = (input.value || '').trim();
      var field = input.closest('.hac-field');
      if (!val) {
        if (field) field.classList.add('has-error');
        isValid = false;
      } else {
        if (field) field.classList.remove('has-error');
      }
      return val;
    }

    var nameVal = validateField(nameInput);
    var phoneVal = validateField(phoneInput);
    var deviceVal = validateField(deviceSelect);
    var serviceVal = serviceSelect ? serviceSelect.value : 'Diagnóstico técnico';
    var notesVal = notesInput ? notesInput.value.trim() : '';

    var cleanedPhone = phoneVal.replace(/\D/g, '');
    if (cleanedPhone.length < 10) {
      var phoneField = phoneInput.closest('.hac-field');
      if (phoneField) phoneField.classList.add('has-error');
      isValid = false;
    }

    if (!isValid) return;

    if (!selectedDate || !selectedSlotTime) {
      if (submitError) {
        submitError.style.display = 'flex';
        submitErrorText.textContent = 'Por favor regresa al paso 1 y selecciona una fecha y horario.';
      }
      return;
    }

    var originalBtnText = btnSubmitBooking.innerHTML;
    btnSubmitBooking.disabled = true;
    btnSubmitBooking.innerHTML = '<span class="hac-spinner" style="width:16px;height:16px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:8px;"></span> Agendando cita…';

    var payload = {
      customer_name: nameVal,
      customer_phone: phoneVal,
      date: selectedDate,
      time: selectedSlotTime,
      appointment_type: 'DROP_OFF',
      service_type: serviceVal,
      location_type: 'WORKSHOP',
      device_summary: deviceVal,
      customer_notes: notesVal || 'Cita generada desde el Home de Pixon PC',
      address_line: 'Cto. Hacienda Chimay, Cancún, Q.R.'
    };

    try {
      var res = await fetch('/api/appointments/hold', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'fetch'
        },
        body: JSON.stringify(payload)
      });

      var result = null;
      try {
        result = await res.json();
      } catch (_) {}

      if (!res.ok || (result && result.success === false)) {
        throw new Error((result && result.message) || 'El horario seleccionado ya no está disponible. Por favor elige otro.');
      }

      var appointmentObj = (result && result.appointment) || {};
      var ticketObj = (result && result.ticket) || {};
      var rawTicketCode = ticketObj.ticket_code || appointmentObj.ticket_code || (appointmentObj.id ? appointmentObj.id.slice(0, 6).toUpperCase() : 'PIXON');
      var folio = '#' + rawTicketCode;

      // Éxito: Completar datos de paso 3
      if (confFolio) confFolio.textContent = folio;
      if (confDatetime) confDatetime.textContent = formatDateHuman(selectedDate) + ' a las ' + selectedSlotTime;
      if (confDevice) confDevice.textContent = deviceVal + ' (' + serviceVal + ')';
      if (confName) confName.textContent = nameVal;

      // Configurar enlace de WhatsApp
      if (btnOpenWa) {
        var waMsg = encodeURIComponent(
          'Hola Pixon PC, acabo de agendar cita y registrar mi Orden de Servicio en su taller en Cancún.\n' +
          'Folio / Orden: ' + folio + '\n' +
          'Nombre: ' + nameVal + '\n' +
          'Fecha: ' + selectedDate + ' a las ' + selectedSlotTime + '\n' +
          'Equipo: ' + deviceVal + '\n' +
          'Servicio: ' + serviceVal + (notesVal ? ('\nDetalle: ' + notesVal) : '')
        );
        btnOpenWa.href = 'https://wa.me/529986690777?text=' + waMsg;
      }

      // Avanzar a Paso 3
      goToStep(3);

    } catch (err) {
      console.error('Error agendando cita:', err);
      if (submitError) {
        submitError.style.display = 'flex';
        submitErrorText.textContent = err.message || 'Ocurrió un error al agendar la cita. Puedes confirmarla directamente por WhatsApp.';
      }
    } finally {
      btnSubmitBooking.disabled = false;
      btnSubmitBooking.innerHTML = originalBtnText;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCalendar);
  } else {
    initCalendar();
  }

})();
</script>
