---
import LocalSpriteIcon from '../LocalSpriteIcon.astro';
import HomeSectionHeader from './HomeSectionHeader.astro';
import ServiceCategoryCard from './ServiceCategoryCard.astro';
import HomeFaq from './HomeFaq.astro';
import {
  homeServiceCategories,
  trustItems,
  maintenanceBenefits,
  specialties,
  businessSegments,
  processSteps,
  packageGroups,
  buildProfiles,
  workVideos,
  fallbackReviews,
  coverageZones,
  homeFaqs,
} from '../../data/home';

const googleMapsUrl = 'https://www.google.com/maps/search/?api=1&query=Pixon%20PC%20Cto.%20Hacienda%20Chimay%2077539%20Cancun%20Q.R.';
---

<main id="contenido-principal" class="home-main">
  <section class="home-trust" id="trust-badges" aria-label="Compromisos del servicio técnico Pixon PC">
    <div class="container home-trust__grid">
      {trustItems.map((item) => (
        <article class="home-trust__item">
          <span class="home-icon" aria-hidden="true"><LocalSpriteIcon name={item.icon} /></span>
          <div>
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="home-section home-services" id="servicios-principales" aria-labelledby="home-services-title">
    <div class="container">
      <div id="home-services-title">
        <HomeSectionHeader
          title="Servicio técnico especializado en Cancún"
          description="Elige el tipo de equipo. Cada categoría conduce al servicio real, con síntomas, proceso y rutas de diagnóstico específicas."
        />
      </div>
      <div class="home-services__grid">
        {homeServiceCategories.map((service, index) => (
          <ServiceCategoryCard service={service} featured={index === 0 || index === 7} />
        ))}
      </div>
      <div class="home-section-action">
        <a class="home-btn home-btn--primary" href="/servicios">Ver todos los servicios</a>
        <a class="home-btn home-btn--secondary" href="/tickets">Crear ticket</a>
      </div>
    </div>
  </section>

  <section class="home-section home-maintenance" id="clima-cancun" aria-labelledby="maintenance-title">
    <div class="container home-maintenance__layout">
      <div class="home-maintenance__media">
        <img
          src="/assets/images/mantenimiento-pc-escritorio.webp"
          alt="Mantenimiento preventivo de computadora realizado por Pixon PC en Cancún"
          width="1200"
          height="800"
          loading="lazy"
          decoding="async"
        />
        <div class="home-maintenance__note">
          <LocalSpriteIcon name="house-laptop" />
          <p><strong>Servicio a domicilio cuando aplica</strong><span>Confirmamos equipo, zona y agenda antes de la visita.</span></p>
        </div>
      </div>
      <div class="home-maintenance__content">
        <HomeSectionHeader
          title="Mantenimiento preventivo a domicilio en Cancún"
          description="Evita que polvo, calor, humedad y salitre avancen hasta convertirse en una falla costosa."
        />
        <p class="home-lead">Pixon PC no solo repara fallas. También ayuda a prevenirlas en equipos de casa, gaming y empresa.</p>
        <div class="home-check-grid">
          {maintenanceBenefits.map((benefit) => (
            <div><LocalSpriteIcon name="circle-check" /><span>{benefit}</span></div>
          ))}
        </div>
        <p class="home-maintenance__limit">
          Placa, humedad severa, microsoldadura, HDMI, pantallas, metal líquido y desarme avanzado pueden requerir trabajo en taller.
        </p>
        <div class="home-actions">
          <a class="home-btn home-btn--primary" href="https://wa.me/529986690777?text=Quiero%20agendar%20mantenimiento%20preventivo%20a%20domicilio%20en%20Cancun" data-wa-link>Agendar mantenimiento</a>
          <a class="home-btn home-btn--secondary" href="/paquetes">Ver paquetes</a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section home-specialties" id="especialidades" aria-labelledby="specialties-title">
    <div class="container">
      <div id="specialties-title">
        <HomeSectionHeader
          title="Especialidades técnicas de Pixon PC"
          description="Casos donde el diagnóstico, el orden de las pruebas y el manejo del riesgo importan tanto como la reparación."
        />
      </div>
      <div class="home-specialties__grid">
        {specialties.map((item, index) => (
          <article class:list={['home-specialty', { 'home-specialty--wide': index === 0 || index === 5 }]}>
            {item.anchor && <span class="home-anchor" id={item.anchor}></span>}
            <span class="home-icon" aria-hidden="true"><LocalSpriteIcon name={item.icon} /></span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <a class="home-text-link" href={item.href}>Revisar servicio <LocalSpriteIcon name="arrow-right" /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="home-inline-cta" id="servicio-express" aria-labelledby="mid-cta-title">
    <div class="container home-inline-cta__layout">
      <div>
        <h2 id="mid-cta-title">¿No sabes qué servicio necesita tu equipo?</h2>
        <p>Comparte modelo, síntomas y fotos. Te orientamos antes de moverlo o comprar una pieza.</p>
      </div>
      <div class="home-actions">
        <a class="home-btn home-btn--primary" href="https://wa.me/529986690777?text=Necesito%20orientacion%20para%20mi%20equipo" data-wa-link>Cotizar por WhatsApp</a>
        <a class="home-btn home-btn--secondary" href="/tickets">Crear ticket</a>
      </div>
    </div>
  </section>

  <section class="home-section home-business" id="soporte-empresas" aria-labelledby="business-title">
    <div class="container home-business__layout">
      <div class="home-business__intro">
        <HomeSectionHeader
          title="Soporte técnico para empresas en Cancún"
          description="Mantenimiento, equipos administrativos, impresoras, red y WiFi con prioridades definidas por la operación."
        />
        <p>Atendemos servicios puntuales y esquemas programados. Una póliza define alcance, frecuencia y tiempos; no prometemos soporte ilimitado sin acuerdo.</p>
        <div class="home-actions">
          <a class="home-btn home-btn--primary" href="/servicios/b2b">Ver soporte empresarial</a>
          <a class="home-btn home-btn--secondary" href="https://wa.me/529986690777?text=Solicito%20una%20revision%20tecnica%20para%20mi%20empresa" data-wa-link>Solicitar revisión</a>
        </div>
      </div>
      <div class="home-business__segments">
        {businessSegments.map((segment) => (
          <article>
            <span class="home-icon" aria-hidden="true"><LocalSpriteIcon name={segment.icon} /></span>
            <div><h3>{segment.title}</h3><p>{segment.text}</p></div>
          </article>
        ))}
        <a class="home-business__ticket" href="/tickets">
          <LocalSpriteIcon name="ticket" />
          <span><strong>Seguimiento por ticket</strong>Registra equipo, falla, prioridad y cita desde un solo flujo.</span>
          <LocalSpriteIcon name="arrow-right" />
        </a>
      </div>
    </div>
  </section>

  <section class="home-section home-about" id="sobre-nosotros" aria-labelledby="about-title">
    <div class="container home-about__layout">
      <div class="home-about__media">
        <img
          src="/assets/images/responsive/ensamble-pc-gamer-cancun.webp"
          alt="Técnico de Pixon PC trabajando en un equipo en Cancún"
          width="960"
          height="1280"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="home-about__content">
        <div id="about-title">
          <HomeSectionHeader
            title="Pixon PC: servicio técnico local con diagnóstico real"
            description="Experiencia, transparencia y atención directa para clientes particulares y empresas de Cancún."
          />
        </div>
        <p>Analizamos la causa de la falla, explicamos cada paso y recomendamos una ruta que tenga sentido para el equipo, los datos y el presupuesto.</p>
        <p>La formación TSMEC y el trabajo con equipos expuestos al clima de Cancún ayudan a reconocer problemas de temperatura, polvo, humedad y salitre sin convertir una sospecha en una promesa.</p>
        <blockquote>Reparamos con evidencia, explicamos con claridad y entregamos con garantía cuando corresponde.</blockquote>
        <ul class="home-about__proofs">
          <li><LocalSpriteIcon name="circle-check" /> Atención directa, sin intermediarios</li>
          <li><LocalSpriteIcon name="circle-check" /> Diagnóstico antes de cambiar piezas</li>
          <li><LocalSpriteIcon name="circle-check" /> Trabajo para hogar, gaming y empresa</li>
          <li><LocalSpriteIcon name="circle-check" /> Recolección según zona y disponibilidad</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="home-section home-process" id="como-funciona" aria-labelledby="process-title">
    <div class="container">
      <div id="process-title">
        <HomeSectionHeader
          title="¿Cómo funciona nuestro servicio técnico?"
          description="Un proceso visible desde el primer mensaje hasta las pruebas de entrega."
        />
      </div>
      <ol class="home-process__list">
        {processSteps.map((step, index) => (
          <li>
            <span class="home-process__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="home-icon" aria-hidden="true"><LocalSpriteIcon name={step.icon} /></span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="home-section home-offers" id="paquetes" aria-labelledby="packages-title">
    <div class="container">
      <div id="packages-title">
        <HomeSectionHeader
          title="Paquetes de mantenimiento en Cancún"
          description="Rutas de servicio para uso cotidiano, equipos gaming y operaciones con varios equipos."
        />
      </div>
      <div class="home-package-groups">
        {packageGroups.map((group) => (
          <a href={group.href}>
            <span class="home-icon" aria-hidden="true"><LocalSpriteIcon name={group.icon} /></span>
            <div><h3>{group.title}</h3><p>{group.text}</p></div>
            <LocalSpriteIcon name="arrow-right" />
          </a>
        ))}
      </div>

      <div class="home-builds" id="ensambles">
        <div class="home-builds__intro">
          <h2>Ensambles PC Gamer en Cancún</h2>
          <p>Configuraciones a medida con compatibilidad, ventilación y margen de actualización revisados antes de cotizar.</p>
          <a class="home-btn home-btn--secondary" href="/ensambles">Ver ensambles</a>
        </div>
        <div class="home-builds__grid">
          {buildProfiles.map((build) => (
            <a href="/ensambles" class="home-build-card">
              <img src={build.image} alt={build.alt} width="640" height="640" loading="lazy" decoding="async" />
              <div><h3>{build.title}</h3><p>{build.text}</p></div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="home-section home-work" id="trabajos" aria-labelledby="work-title">
    <span id="evidencia-real" class="home-anchor" aria-hidden="true"></span>
    <span id="catalogo" class="home-anchor" aria-hidden="true"></span>
    <div class="container">
      <div id="work-title">
        <HomeSectionHeader
          title="Trabajos reales, proceso visible"
          description="Una selección breve de servicios documentados en taller y en entornos empresariales."
        />
      </div>
      <div class="home-work__grid">
        {workVideos.map((video) => (
          <article class="home-work-card">
            <div class:list={['video-wrapper', { 'b2b-vertical-wrapper': video.landscape }] }>
              <button
                class="video-lazy-thumb"
                type="button"
                data-video-id={video.id}
                data-landscape={video.landscape ? 'true' : undefined}
                aria-label={`Reproducir ${video.title}`}
              >
                <img src={`https://img.youtube.com/vi/${video.id}/hqdefault.jpg`} alt={video.title} width="480" height="360" loading="lazy" decoding="async" />
                <span class="play-btn-overlay" aria-hidden="true"><LocalSpriteIcon name="play" /></span>
              </button>
            </div>
            <div><h3>{video.title}</h3><p>{video.subtitle}</p></div>
          </article>
        ))}
      </div>
      <div class="home-section-action">
        <a class="home-btn home-btn--secondary" href="https://www.tiktok.com/@pixonpc" target="_blank" rel="noopener noreferrer">Ver más trabajos</a>
      </div>
    </div>
  </section>

  <section class="home-section home-reviews" id="google-reviews" data-google-reviews aria-labelledby="reviews-title">
    <div class="container">
      <div id="reviews-title">
        <HomeSectionHeader
          title="Clientes en Cancún comparten su experiencia"
          description="Consulta opiniones, ubicación y datos públicos antes de agendar."
        />
      </div>
      <div class="home-reviews__summary">
        <div>
          <LocalSpriteIcon name="star" />
          <span><strong data-google-review-summary>Opiniones verificables en Google</strong>Los datos se actualizan desde el perfil público cuando están disponibles.</span>
        </div>
        <a class="home-btn home-btn--secondary" href={googleMapsUrl} target="_blank" rel="noopener noreferrer" data-google-maps-link>Ver Google Maps</a>
      </div>
      <div class="google-review-grid" data-review-list>
        {fallbackReviews.map((review) => (
          <article class="google-review-card">
            <div class="review-avatar" aria-hidden="true">{review.name.charAt(0)}</div>
            <div>
              <div class="review-card-head"><h3>{review.name}</h3><p class="review-stars" aria-label={`${review.rating} estrellas`}>★★★★★</p></div>
              <p class="review-date">{review.date}</p>
              <div class="review-text" data-review-text><p>{review.text}</p></div>
              <button class="review-more" type="button" data-review-toggle hidden aria-expanded="false">Ver más</button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <HomeFaq items={homeFaqs} />

  <section class="home-section home-contact" id="contacto" aria-labelledby="contact-title">
    <div class="container">
      <div id="contact-title">
        <HomeSectionHeader
          title="Ubicación y contacto en Cancún"
          description="Atención con cita previa, recolección según zona y mantenimiento a domicilio cuando el servicio lo permite."
        />
      </div>
      <div class="home-contact__layout">
        <div class="home-contact__details">
          <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer"><LocalSpriteIcon name="location-dot" /><span><strong>Ubicación</strong>Cto. Hacienda Chimay, 77539 Cancún, Q.R.</span></a>
          <a href="https://wa.me/529986690777" data-wa-link><LocalSpriteIcon name="whatsapp" /><span><strong>WhatsApp</strong>+52 998 669 0777</span></a>
          <a href="mailto:pixonpc@gmail.com"><LocalSpriteIcon name="paper-plane" /><span><strong>Correo</strong>pixonpc@gmail.com</span></a>
          <div><LocalSpriteIcon name="clock" /><span><strong>Horario</strong>Lunes a domingo con cita previa</span></div>
        </div>
        <div class="home-contact__coverage">
          <h3>Zonas que cubrimos</h3>
          <p>La disponibilidad depende del tipo de servicio y la agenda del día.</p>
          <div class="home-coverage-chips">
            {coverageZones.map((zone) => <span>{zone}</span>)}
          </div>
          <p class="home-contact__question">¿No ves tu zona? Escríbenos y revisamos disponibilidad, incluyendo Puerto Morelos cuando la agenda lo permite.</p>
        </div>
      </div>
      <div class="home-contact__closing">
        <div><h2>Cuéntanos qué falla y definimos el siguiente paso</h2><p>WhatsApp para orientación rápida. Ticket para registrar equipo, síntomas y cita.</p></div>
        <div class="home-actions">
          <a class="home-btn home-btn--primary" href="https://wa.me/529986690777?text=Quiero%20cotizar%20un%20servicio%20tecnico" data-wa-link>Cotizar por WhatsApp</a>
          <a class="home-btn home-btn--secondary" href="/tickets">Crear ticket</a>
        </div>
      </div>
    </div>
  </section>
</main>
