---
interface Props {
  title: string;
  description: string;
  align?: 'left' | 'center';
  inverse?: boolean;
}

const { title, description, align = 'left', inverse = false } = Astro.props;
---

<header class:list={['home-section-header', `home-section-header--${align}`, { 'home-section-header--inverse': inverse }] }>
  <h2>{title}</h2>
  <p>{description}</p>
</header>

