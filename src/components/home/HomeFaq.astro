---
import HomeSectionHeader from './HomeSectionHeader.astro';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<section class="home-section home-faq" id="faq" aria-labelledby="home-faq-title">
  <div class="container home-narrow">
    <div id="home-faq-title">
      <HomeSectionHeader
        title="Preguntas frecuentes sobre reparación en Cancún"
        description="Respuestas claras antes de agendar un diagnóstico, mantenimiento o recolección."
      />
    </div>
    <div class="home-faq__list">
      {items.map((item) => (
        <details class="home-faq__item">
          <summary>{item.question}<span aria-hidden="true">+</span></summary>
          <div><p>{item.answer}</p></div>
        </details>
      ))}
    </div>
    <div class="home-section-action">
      <a class="home-btn home-btn--primary" href="https://wa.me/529986690777?text=Quiero%20agendar%20un%20diagnostico" data-wa-link>
        Agendar diagnóstico
      </a>
      <a class="home-text-link" href="/preguntas-frecuentes">Ver todas las preguntas</a>
    </div>
  </div>
</section>
