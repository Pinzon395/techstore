---
interface Props {
  id?: string;
}

const { id = 'contacto' } = Astro.props;
---

<section class="contact section-padding" id={id}>
  <div class="container">
    <div class="contact-grid">
      <div class="contact-left">
        <h2>Ubicación y Contacto</h2>
        <p class="description-text">Encuéntranos en Cancún, Quintana Roo.</p>
        <p style="color: #64748b; font-size: 0.95rem; max-width: 600px; margin: 5px 0;">
          Brindamos servicio técnico de computadoras en Cancún con cobertura en Zona Hotelera, Huayacán, Polígono Sur, Puerto Juárez y alrededores.
        </p>
        <ul class="contact-details mt-2 contact-details--uniform">
          <li>
            <span class="contact-icon-box" aria-hidden="true">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-location-dot"></use></svg>
            </span>
            <div>
              <strong>Ubicación</strong>
              <p>Haciendas, Cancún, Quintana Roo 77539</p>
            </div>
          </li>
          <li>
            <span class="contact-icon-box" aria-hidden="true">
              <svg class="fa-icon fa-brands" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-whatsapp"></use></svg>
            </span>
            <div>
              <strong>WhatsApp Rápido</strong>
              <p>+52 998 669 0777</p>
            </div>
          </li>
          <li>
            <span class="contact-icon-box" aria-hidden="true">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-envelope"></use></svg>
            </span>
            <div>
              <strong>Correo</strong>
              <p><a href="mailto:pixonpc@gmail.com">pixonpc@gmail.com</a></p>
            </div>
          </li>
          <li>
            <span class="contact-icon-box" aria-hidden="true">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-clock"></use></svg>
            </span>
            <div>
              <strong>Horario</strong>
              <p>Lunes - Domingo · con cita previa</p>
            </div>
          </li>
        </ul>

        <div id="location-placeholder"></div>
      </div>

      <div class="contact-right">
        <div class="contact-form glass-card" style="width:100%; max-width:500px;">
          <h3 class="text-center">¿Te ayudamos?</h3>
          <p class="text-center">Haz clic en lo que necesites reparar hoy.</p>
          <div class="form-group mb-3 mt-4">
            <div class="device-buttons flex-row">
              <button
                type="button"
                class="btn btn-outline dev-btn"
                onclick="smartWaRedirect('https://wa.me/529986690777?text=Quiero%20reparar%20una%20laptop')"
              >
                <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-laptop"></use></svg> Laptop
              </button>
              <button
                type="button"
                class="btn btn-outline dev-btn"
                onclick="smartWaRedirect('https://wa.me/529986690777?text=Necesito%20soporte%20o%20reparaci%C3%B3n%20para%20PC%20Gamer')"
              >
                <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-desktop"></use></svg> PC Gamer
              </button>
              <button
                type="button"
                class="btn btn-outline dev-btn"
                onclick="smartWaRedirect('https://wa.me/529986690777?text=Quiero%20reparar%20mi%20celular')"
              >
                <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-mobile"></use></svg> Celular
              </button>
              <button
                type="button"
                class="btn btn-outline dev-btn"
                onclick="smartWaRedirect('https://wa.me/529986690777?text=Necesito%20reparar%20una%20impresora')"
              >
                <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-print"></use></svg> Impresora
              </button>
              <button
                type="button"
                class="btn btn-outline dev-btn"
                onclick="smartWaRedirect('https://wa.me/529986690777?text=Quiero%20mantenimiento%20para%20consola')"
              >
                <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-gamepad"></use></svg> Consola
              </button>
              <button
                type="button"
                class="btn btn-primary dev-btn"
                onclick="smartWaRedirect('https://wa.me/529986690777?text=Soy%20empresa%20y%20necesito%20soporte%20t%C3%A9cnico%20B2B')"
              >
                <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-building"></use></svg> B2B
              </button>
            </div>
          </div>
        </div>

        <div class="coverage-area" id="cobertura">
          <p class="coverage-title" style="font-weight:700; font-size:1.1rem;">
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-map-location-dot"></use></svg> Zonas que Cubrimos
          </p>
          <p class="coverage-subtitle">Recolección y entrega a tu puerta en Cancún y alrededores.</p>
          <div class="coverage-zones">
            <span class="coverage-zone coverage-zone--primary">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-circle-check"></use></svg> Zona Hotelera
            </span>
            <span class="coverage-zone coverage-zone--primary">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-circle-check"></use></svg> Haciendas
            </span>
            <span class="coverage-zone coverage-zone--primary">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-circle-check"></use></svg> Supermanzanas
            </span>
            <span class="coverage-zone">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-circle-check"></use></svg> Polígono Sur
            </span>
            <span class="coverage-zone">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-circle-check"></use></svg> Huayacán
            </span>
            <span class="coverage-zone">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-circle-check"></use></svg> Puerto Morelos
            </span>
            <span class="coverage-zone">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-circle-check"></use></svg> Puerto Juárez
            </span>
            <span class="coverage-zone coverage-zone--ask">
              <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-circle-question"></use></svg> ¿Otra zona? ¡Pregunta!
            </span>
          </div>
          <button
            type="button"
            onclick="smartWaRedirect('https://wa.me/529986690777?text=Quiero%20que%20recojan%20mi%20equipo%20a%20domicilio%20en%20Canc%C3%BAn')"
            class="btn btn-outline coverage-cta-btn"
            id="btn-cobertura-pickup"
          >
            <svg class="fa-icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#fa-truck"></use></svg> Pedir Recolección a Domicilio
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-details--uniform li {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 30px;
  }

  .contact-details--uniform li:last-child {
    margin-bottom: 0;
  }

  .contact-icon-box {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: #eaf2ff;
    color: #3b82f6;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 56px;
  }

  .contact-icon-box .fa-icon,
  .contact-icon-box i,
  .contact-icon-box svg {
    width: 24px;
    height: 24px;
    color: #3b82f6;
    font-size: 24px;
    display: block;
  }

  .contact-details--uniform strong,
  .contact-details--uniform p {
    margin: 0;
  }

  .contact-details--uniform a {
    color: inherit;
  }

  @media (max-width: 640px) {
    .contact-details--uniform li {
      gap: 18px;
      margin-bottom: 28px;
      align-items: flex-start;
    }
  }
</style>
