---
const { message = 'Hola%2C%20ven%C3%ADa%20de%20la%20web%20y%20quiero%20informaci%C3%B3n' } = Astro.props;
const waUrl = `https://wa.me/529986690777?text=${message}`;
---

<a
  href={waUrl}
  data-smart-wa
  class="whatsapp-float"
  id="whatsapp-float"
  title="Contáctanos por WhatsApp"
  aria-label="Contáctanos por WhatsApp"
>
  <i class="fa-brands fa-whatsapp"></i>
</a>

<script>
  const floats = Array.from(document.querySelectorAll('.whatsapp-float'));
  const whatsappFloat = floats[floats.length - 1];

  floats.slice(0, -1).forEach((node) => node.remove());
  whatsappFloat?.setAttribute('id', 'whatsapp-float');

  whatsappFloat?.addEventListener('click', (event) => {
    event.preventDefault();
    const href = whatsappFloat.getAttribute('href');
    if (href) window.smartWaRedirect(href);
  });

  window.addEventListener('scroll', () => {
    if (window.scrollY > 300) {
      whatsappFloat?.classList.add('visible');
    } else {
      whatsappFloat?.classList.remove('visible');
    }
  });
</script>
