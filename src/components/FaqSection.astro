---
interface FaqItem {
  question: string;
  answer: string;
  icon?: string;
}

interface Props {
  title: string;
  description?: string;
  items: FaqItem[];
  viewMoreHref?: string;
  viewMoreLabel?: string;
  faqAccent?: string;
  id?: string;
  ariaLabel?: string;
  sectionClass?: string;
  gridClass?: string;
  backgroundColor?: string;
  questionColor?: string;
  titleColor?: string;
  descriptionColor?: string;
  itemGap?: string;
  questionPadding?: string;
}

const {
  title,
  description,
  items,
  viewMoreHref,
  viewMoreLabel,
  faqAccent = '#3b82f6',
  id,
  ariaLabel,
  sectionClass = '',
  gridClass = '',
  backgroundColor = 'transparent',
  questionColor = 'var(--text-main, #0F2A4A)',
  titleColor,
  descriptionColor,
  itemGap = '16px',
  questionPadding = '24px',
} = Astro.props;

const isNetworkFaq = sectionClass.split(' ').includes('sdv-network-faq');
const networkFaqTextStyle = isNetworkFaq ? 'color:#0F2A4A;' : undefined;
---

<section class={`section-padding faq-page-content faq-section ${sectionClass}`} id={id} aria-label={ariaLabel} style={`background:${backgroundColor}; --faq-question-color:${questionColor}; --faq-item-gap:${itemGap}; --faq-question-padding:${questionPadding}; padding: 60px 0;`}>
  <div class="container" style="max-width: 900px;">
    <div class="section-title text-center" style="margin-bottom:40px;">
      <h2 style={`color:${titleColor || 'var(--text-main)'}; font-weight:800; font-family:'Kanit', sans-serif;`}>{title}</h2>
      {description && <p style={`color:${descriptionColor || 'var(--text-muted)'}; font-size:1.1rem;`}>{description}</p>}
    </div>
    
    <div class={`faq-page-grid ${gridClass}`}>
      {items.map((item, index) => (
        <div class="faq-item" id={`faq-${id || 'section'}-${index}`}>
          <button class="faq-question" type="button" aria-expanded="false" aria-controls={`faq-answer-${id || 'section'}-${index}`} style={networkFaqTextStyle}>
            <span style={networkFaqTextStyle}>
              {item.icon && <i class={`${item.icon} faq-q-icon`}></i>}
              {item.question}
            </span>
            <i class="fa-solid fa-chevron-down faq-chevron" style={networkFaqTextStyle}></i>
          </button>
          <div class="faq-answer" id={`faq-answer-${id || 'section'}-${index}`} aria-hidden="true">
            <div class="faq-answer-inner" style={networkFaqTextStyle} set:html={item.answer}></div>
          </div>
        </div>
      ))}
    </div>

    {viewMoreHref && viewMoreLabel && (
      <div class="text-center" style="margin-top:30px;">
        <a href={viewMoreHref} class="btn btn-outline" style="border:2px solid #3b82f6; color: #3b82f6; background: transparent; padding: 12px 24px; border-radius: 8px; font-weight: 600; text-decoration: none; display: inline-block;"><i class="fa-solid fa-comments"></i> {viewMoreLabel}</a>
      </div>
    )}
  </div>
</section>

<style is:global>
  .faq-page-grid {
    display: flex;
    flex-direction: column;
    gap: var(--faq-item-gap, 16px);
  }
  .faq-item {
    background: #fff;
    border: 1px solid rgba(15, 42, 74, 0.14);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
    box-shadow: 0 1px 2px rgba(15, 42, 74, 0.04);
  }
  .faq-item:hover {
    border-color: rgba(59, 130, 246, 0.32);
    box-shadow: 0 4px 14px rgba(15, 42, 74, 0.07);
  }
  .faq-item--open {
    background: #fff;
    border-color: rgba(59, 130, 246, 0.45);
    box-shadow: 0 5px 18px rgba(15, 42, 74, 0.08);
  }
  .faq-question {
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    padding: var(--faq-question-padding, 24px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--faq-question-color, #fff);
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
  }
  .faq-question:hover,
  .faq-question:hover span,
  .faq-question:hover .faq-chevron,
  .faq-question:focus,
  .faq-question:focus span,
  .faq-question:focus .faq-chevron {
    color: var(--faq-question-color, #0F2A4A);
  }
  .faq-question span {
    color: inherit;
  }
  .faq-page-content .faq-item--open .faq-question {
    color: var(--faq-question-color, #fff);
  }
  .faq-chevron {
    color: #38BDF8;
    transition: transform 0.3s ease;
  }
  .faq-item--open .faq-chevron {
    transform: rotate(180deg);
  }
  .sdv-network-faq .faq-item {
    border: 1px solid rgba(15, 42, 74, 0.22);
    box-shadow: 0 4px 14px rgba(15, 42, 74, 0.08);
  }
  .sdv-network-faq .faq-item:hover,
  .sdv-network-faq .faq-item--open {
    border-color: rgba(15, 42, 74, 0.32);
    box-shadow: 0 6px 18px rgba(15, 42, 74, 0.1);
  }
  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  .faq-answer-inner {
    padding: 0 24px 24px;
    color: #475569;
    line-height: 1.7;
    font-size: 0.95rem;
  }
</style>
