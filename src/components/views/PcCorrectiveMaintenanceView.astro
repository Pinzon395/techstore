    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.3);
    padding: 16px;
    overflow: hidden;
  }
  .pcc-svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 540 / 440;
  }
  .pcc-visual-caption {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 12px;
