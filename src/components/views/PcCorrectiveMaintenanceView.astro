    font-size: 0.68rem;
  }
  .pcc-caption-sep {
    color: #64748b !important;
    font-weight: 800;
  }

  /* Desktop 2-column layout (52% copy / 48% visual) */
  @media (min-width: 1000px) {
    .pcc-hero {
      padding: clamp(54px, 6.5vw, 84px) 0;
      min-height: 560px;
      display: grid;
      align-items: center;
    }
    .pcc-hero__grid {
      grid-template-areas:
        "eyebrow media"
        "title   media"
        "summary media"
        "actions media"
        "trust   media";
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      gap: 16px 40px;
    }
    .pcc-hero__visual-wrap {
      max-width: 520px;
    }
  }

  /* ==================== ESTILOS COMUNES DE SECCIÓN ==================== */
  .pcc-section {
    padding: clamp(48px, 6vw, 76px) 0;
  }
  .pcc-heading {
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .pcc-heading--center {
    text-align: center;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }
  .pcc-kicker {
    display: inline-block;
    color: #0284c7 !important;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .pcc-kicker--light {
    color: #38bdf8 !important;
  }
  .pcc-heading h2 {
    font-size: clamp(1.75rem, 3.2vw, 2.35rem);
    font-weight: 900;
    line-height: 1.2;
    margin: 0 0 12px;
    font-family: 'Kanit', sans-serif;
    color: var(--azul-oscuro) !important;
  }
  .pcc-heading p {
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--azul-muted) !important;
    margin: 0;
  }
  .pcc-text-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #0284c7 !important;
    font-size: 0.88rem;
    font-weight: 800;
    text-decoration: none;
