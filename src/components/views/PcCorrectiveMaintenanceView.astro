    color: #e2e8f0 !important;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .pcc-badges li i { color: #38bdf8; }

  /* Visual Stage Hero */
  .pcc-visual-stage {
    margin: 0;
    width: 100%;
    border-radius: 18px;
    background: rgba(6, 22, 38, 0.6);
