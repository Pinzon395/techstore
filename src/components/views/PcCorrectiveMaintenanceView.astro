    <CommentsSection />
    <ContactSection />
  </main>
  <Footer />
</div>

<style>
  /* ==================== VARIABLES Y SCOPE ==================== */
  .pc-corrective-page {
    --azul-oscuro: #071F3A;
    --azul-muted: #334155;
    --azul-borde: #e2e8f0;
    --azul-glow: #38bdf8;
    --verde-cta: #16a34a;
    font-family: 'Red Hat Display', sans-serif;
    color: var(--azul-oscuro);
    background: #ffffff;
    overflow-x: hidden;
  }

  /* Forzar estricto azul oscuro en todos los textos fuera del hero */
  .pc-corrective-page main,
  .pc-corrective-page main p,
  .pc-corrective-page main h2,
  .pc-corrective-page main h3,
  .pc-corrective-page main h4,
  .pc-corrective-page main li,
  .pc-corrective-page main span,
  .pc-corrective-page main strong {
    color: var(--azul-oscuro);
  }

  /* ==================== 1. HERO SECTION (SIMÉTRICO) ==================== */
  .pcc-hero {
    position: relative;
    background: linear-gradient(135deg, #071F3A 0%, #0c2b4e 55%, #071829 100%);
    color: #ffffff;
    padding: clamp(36px, 5vw, 70px) 0 clamp(44px, 6vw, 80px);
    overflow: hidden;
  }
  .pcc-hero-glow {
    position: absolute;
    top: -120px;
    right: -100px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.16) 0%, rgba(7, 31, 58, 0) 70%);
    pointer-events: none;
  }

  /* Grid móvil: H1 -> Visual -> Copy -> CTAs -> Trust */
  .pcc-hero__grid {
    display: grid;
    grid-template-areas:
      "eyebrow"
      "title"
      "media"
      "summary"
      "actions"
      "trust";
    grid-template-columns: 1fr;
    gap: 18px;
    align-items: center;
  }
  .pcc-hero__eyebrow-wrap { grid-area: eyebrow; }
  .pcc-hero__title { grid-area: title; }
  .pcc-hero__visual-wrap {
    grid-area: media;
    width: 100%;
    max-width: 540px;
    justify-self: center;
  }
  .pcc-hero__summary {
    grid-area: summary;
    max-width: 660px;
  }
  .pcc-hero__actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 4px;
  }
  .pcc-hero__trust { grid-area: trust; }

  .pcc-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: #67e8f9 !important;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pcc-hero h1 {
    margin: 6px 0 10px;
    font-size: clamp(1.95rem, 4.2vw, 3.1rem);
    font-weight: 900;
    line-height: 1.14;
    color: #ffffff !important;
    font-family: 'Kanit', sans-serif;
  }
  .pcc-hero h1 span {
    display: block;
  }
  .pcc-hero h1 span:last-child {
    color: #38bdf8 !important;
  }
  .pcc-lead {
    margin: 0 0 10px;
    font-size: clamp(1.05rem, 1.8vw, 1.22rem);
    font-weight: 700;
    line-height: 1.45;
    color: #ffffff !important;
  }
  .pcc-description {
    margin: 0;
    font-size: 0.96rem;
    line-height: 1.65;
    color: #cbd5e1 !important;
  }

  /* Botones Hero */
  .pcc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 12px 24px;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }
  .pcc-btn--primary {
    background: #16a34a !important;
    color: #ffffff !important;
    box-shadow: 0 10px 24px rgba(22, 163, 74, 0.3);
  }
  .pcc-btn--primary:hover {
    background: #15803d !important;
    transform: translateY(-2px);
    box-shadow: 0 14px 28px rgba(22, 163, 74, 0.4);
  }
  .pcc-btn--secondary {
    background: rgba(255, 255, 255, 0.08) !important;
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(8px);
  }
  .pcc-btn--secondary:hover {
    background: rgba(255, 255, 255, 0.16) !important;
    border-color: #38bdf8;
    color: #38bdf8 !important;
    transform: translateY(-2px);
  }
  .pcc-btn--lg {
    min-height: 52px;
    padding: 14px 30px;
    font-size: 1.02rem;
  }

  /* Badges de Confianza */
  .pcc-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }
