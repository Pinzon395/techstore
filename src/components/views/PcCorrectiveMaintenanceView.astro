<div class="pc-corrective-page">
  <!-- ==================== 1. HERO SECTION SIMÉTRICO ==================== -->
  <header class="pcc-hero" aria-labelledby="pcc-hero-title">
    <div class="pcc-hero-glow" aria-hidden="true"></div>
    <div class="container pcc-hero__grid">
      <!-- 1. Eyebrow -->
      <div class="pcc-hero__eyebrow-wrap">
        <p class="pcc-eyebrow">
          <i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i> FALLAS DE HARDWARE Y SOFTWARE · SERVICIO TÉCNICO EN CANCÚN
        </p>
      </div>

      <!-- 2. H1 -->
      <h1 id="pcc-hero-title" class="pcc-hero__title">
        <span>Mantenimiento correctivo y</span>
        <span>reparación de PC en Cancún</span>
      </h1>

      <!-- 3. Visual de Diagnóstico y Reparación (Debajo del H1 en mobile, a la derecha en desktop) -->
      <div class="pcc-hero__visual-wrap">
        <figure class="pcc-visual-stage" aria-label="Esquema técnico de diagnóstico y reparación de componentes de PC">
          <svg class="pcc-svg" viewBox="0 0 540 440" width="540" height="440" role="img" aria-label="Gabinete de PC con indicadores de análisis de hardware: energía, almacenamiento, memoria y video">
            <defs>
              <linearGradient id="pcc-case-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#0f2942" />
                <stop offset="100%" stop-color="#071829" />
              </linearGradient>
              <linearGradient id="pcc-mobo-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#0d3b66" />
                <stop offset="100%" stop-color="#09223a" />
              </linearGradient>
              <linearGradient id="pcc-card-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#143859" />
                <stop offset="100%" stop-color="#0b2138" />
              </linearGradient>
              <filter id="pcc-glow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="5" result="blur" />
                <feComposite in="SourceGraphic" in2="blur" operator="over" />
              </filter>
            </defs>

            <!-- Gabinete / Chasis de la PC -->
            <rect x="70" y="30" width="400" height="380" rx="20" fill="url(#pcc-case-grad)" stroke="#1e4e79" stroke-width="2" />
            <rect x="85" y="45" width="370" height="350" rx="14" fill="#061626" stroke="#123555" stroke-width="1.5" />

            <!-- Placa Madre (Motherboard) interna -->
            <rect x="100" y="60" width="260" height="320" rx="8" fill="url(#pcc-mobo-grad)" stroke="#1a5585" stroke-width="1" />

            <!-- CPU Socket & Cooler Fan -->
            <g class="pcc-cpu-unit" transform="translate(180, 120)">
