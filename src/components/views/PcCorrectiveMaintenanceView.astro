      description="Respuestas técnicas transparentes a las dudas más comunes de nuestros clientes en Cancún sobre fallas de hardware, software, diagnóstico y garantías:"
      items={correctiveFaqs}
      titleColor="#071F3A"
      descriptionColor="#071F3A"
      questionColor="#071F3A"
    />

    <!-- ==================== 12. FINAL CTA & CONTACT ==================== -->
