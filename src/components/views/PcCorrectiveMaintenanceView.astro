            <!-- Diagnostic Status Badges (Clean, no fake numbers) -->
            <g class="pcc-diag-tags" transform="translate(350, 55)">
              <!-- Tag Power -->
              <rect x="0" y="0" width="165" height="42" rx="8" fill="url(#pcc-card-grad)" stroke="#38bdf8" stroke-width="1.2" filter="url(#pcc-glow)" />
              <circle cx="18" cy="21" r="9" fill="#0284c7" />
              <text x="18" y="25" font-size="10" font-weight="900" fill="#ffffff" text-anchor="middle">⚡</text>
              <text x="36" y="19" font-size="9" font-family="'Kanit', sans-serif" font-weight="800" fill="#ffffff">POWER · 12V</text>
              <text x="36" y="32" font-size="7.5" fill="#bae6fd">Línea de alimentación</text>
            </g>

            <g class="pcc-diag-tags" transform="translate(350, 110)">
              <!-- Tag RAM -->
              <rect x="0" y="0" width="165" height="42" rx="8" fill="url(#pcc-card-grad)" stroke="#38bdf8" stroke-width="1.2" />
              <circle cx="18" cy="21" r="9" fill="#0369a1" />
              <text x="18" y="25" font-size="10" font-weight="900" fill="#ffffff" text-anchor="middle">▦</text>
              <text x="36" y="19" font-size="9" font-family="'Kanit', sans-serif" font-weight="800" fill="#ffffff">RAM · MEMORIA</text>
              <text x="36" y="32" font-size="7.5" fill="#bae6fd">Integridad de módulos</text>
            </g>

            <g class="pcc-diag-tags" transform="translate(350, 165)">
              <!-- Tag Storage -->
              <rect x="0" y="0" width="165" height="42" rx="8" fill="url(#pcc-card-grad)" stroke="#38bdf8" stroke-width="1.2" />
              <circle cx="18" cy="21" r="9" fill="#075985" />
              <text x="18" y="25" font-size="10" font-weight="900" fill="#ffffff" text-anchor="middle">▤</text>
              <text x="36" y="19" font-size="9" font-family="'Kanit', sans-serif" font-weight="800" fill="#ffffff">STORAGE · SMART</text>
              <text x="36" y="32" font-size="7.5" fill="#bae6fd">Salud de SSD / HDD</text>
            </g>

            <g class="pcc-diag-tags" transform="translate(350, 220)">
              <!-- Tag GPU -->
              <rect x="0" y="0" width="165" height="42" rx="8" fill="url(#pcc-card-grad)" stroke="#38bdf8" stroke-width="1.2" />
              <circle cx="18" cy="21" r="9" fill="#0c4a6e" />
              <text x="18" y="25" font-size="10" font-weight="900" fill="#ffffff" text-anchor="middle">◈</text>
              <text x="36" y="19" font-size="9" font-family="'Kanit', sans-serif" font-weight="800" fill="#ffffff">VIDEO · GPU</text>
              <text x="36" y="32" font-size="7.5" fill="#bae6fd">Carga y temperaturas</text>
            </g>

            <g class="pcc-diag-tags" transform="translate(350, 275)">
              <!-- Tag System -->
              <rect x="0" y="0" width="165" height="42" rx="8" fill="url(#pcc-card-grad)" stroke="#10b981" stroke-width="1.2" filter="url(#pcc-glow)" />
              <circle cx="18" cy="21" r="9" fill="#059669" />
              <path d="M 14 21 L 17 24 L 23 18" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              <text x="36" y="19" font-size="9" font-family="'Kanit', sans-serif" font-weight="800" fill="#ffffff">SISTEMA · ESTABILIDAD</text>
              <text x="36" y="32" font-size="7.5" fill="#a7f3d0">Pruebas bajo carga</text>
            </g>
          </svg>
          <figcaption class="pcc-visual-caption">
            <span class="pcc-caption-step"><strong class="pcc-step-num">1</strong> Detección de falla</span>
            <span class="pcc-caption-sep" aria-hidden="true">→</span>
            <span class="pcc-caption-step"><strong class="pcc-step-num">2</strong> Presupuesto previo</span>
            <span class="pcc-caption-sep" aria-hidden="true">→</span>
            <span class="pcc-caption-step"><strong class="pcc-step-num">3</strong> Reparación y pruebas</span>
          </figcaption>
        </figure>
      </div>

      <!-- 4. Subcopy / Resumen -->
      <div class="pcc-hero__summary">
        <p class="pcc-lead">Cuando una PC falla, no adivines qué pieza cambiar. Identificamos la causa real antes de reparar.</p>
        <p class="pcc-description">
          Diagnosticamos y reparamos fallas en computadoras de escritorio, PC gamer y estaciones de trabajo en Cancún: no enciende, reinicios aleatorios, pantalla azul, falta de video, sobrecalentamiento, fuente de poder, tarjeta madre y discos dañados. Presupuesto previo claro antes de comprar refacciones o intervenir el equipo.
        </p>
      </div>

      <!-- 5. CTAs -->
      <div class="pcc-hero__actions">
        <a class="pcc-btn pcc-btn--primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-wa-link data-event-placement="corrective_hero_primary">
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Revisar falla de mi PC
        </a>
        <a class="pcc-btn pcc-btn--secondary" href="#sintomas">
          Identificar síntoma <span aria-hidden="true">↓</span>
        </a>
      </div>

      <!-- 6. Trust Badges -->
      <div class="pcc-hero__trust">
        <ul class="pcc-badges" aria-label="Garantías y certezas del servicio">
          <li><i class="fa-solid fa-check" aria-hidden="true"></i> Diagnóstico por pruebas</li>
          <li><i class="fa-solid fa-check" aria-hidden="true"></i> Hardware y Software</li>
          <li><i class="fa-solid fa-check" aria-hidden="true"></i> PC Gamer y Oficina</li>
          <li><i class="fa-solid fa-check" aria-hidden="true"></i> Garantía por escrito</li>
        </ul>
      </div>
    </div>
  </header>

  <main id="corrective-content">
    <!-- ==================== 2. MATRIZ DE SÍNTOMAS COMUNES ==================== -->
    <section id="sintomas" class="pcc-section pcc-symptoms-section" aria-labelledby="symptoms-title">
      <div class="container">
        <div class="pcc-heading pcc-heading--center">
          <span class="pcc-kicker">Identificación de Problemas</span>
          <h2 id="symptoms-title">¿Qué falla presenta tu computadora?</h2>
          <p>
            El síntoma que experimentas no siempre señala al culpable evidente. Una computadora que se apaga no necesariamente tiene un virus, ni una que no da video tiene la tarjeta gráfica quemada. Aislamos la causa con instrumental técnico en taller:
          </p>
        </div>

        <div class="pcc-symptoms-grid">
          {symptomsList.map((item) => (
            <article class="pcc-symptom-card" id={item.id}>
              <div class="pcc-symptom-card__header">
                <div class="pcc-symptom-card__icon" aria-hidden="true">
                  <i class={item.icon}></i>
                </div>
                <div class="pcc-symptom-card__titles">
                  <h3>{item.title}</h3>
                  <span class="pcc-symptom-subtitle">{item.subtitle}</span>
                </div>
              </div>
              <div class="pcc-symptom-card__body">
                <div class="pcc-symptom-card__field">
                  <strong>Causas probables:</strong>
                  <p>{item.probableCauses}</p>
                </div>
                <div class="pcc-symptom-card__field pcc-symptom-card__field--warning">
                  <strong>Qué no se debe asumir:</strong>
                  <p>{item.notToAssume}</p>
                </div>
              </div>
              <div class="pcc-symptom-card__footer">
                <a href={item.ownerHref} class="pcc-text-link">
                  {item.ownerLabel} <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>

        <div class="pcc-symptoms-cta">
          <p>¿Tu computadora presenta una falla diferente o intermitente que no aparece en la lista?</p>
          <a class="pcc-btn pcc-btn--primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-wa-link data-event-placement="symptoms_cta">
            <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Describir síntoma por WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- ==================== 3. COMPONENTES QUE REPARAMOS O SUSTITUIMOS ==================== -->
    <section id="componentes" class="pcc-section pcc-components-section" aria-labelledby="components-title">
      <div class="container">
        <div class="pcc-heading pcc-heading--center">
          <span class="pcc-kicker">Cobertura Integral de Hardware</span>
          <h2 id="components-title">Componentes y etapas que reparamos en tu PC</h2>
          <p>
            Trabajamos con arquitectura física modular de computadoras de escritorio, torres gamer y workstations. Cada componente intervenido se somete a validación de voltajes, temperaturas y compatibilidad:
          </p>
        </div>

        <div class="pcc-components-grid">
          {componentsList.map((comp) => (
            <article class="pcc-component-card">
              <div class="pcc-component-card__icon" aria-hidden="true">
                <i class={comp.icon}></i>
              </div>
              <h3>{comp.title}</h3>
              <p>{comp.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ==================== 4. DIAGNÓSTICO VS MANTENIMIENTO CORRECTIVO ==================== -->
    <section id="diagnostico-vs-reparacion" class="pcc-section pcc-triage-section" aria-labelledby="triage-title">
      <div class="container">
        <div class="pcc-triage-card">
          <div class="pcc-triage-content">
            <span class="pcc-kicker">Transparencia Técnica</span>
            <h2 id="triage-title">Diagnóstico vs Mantenimiento Correctivo: ¿Cuál es la diferencia?</h2>
            <div class="pcc-triage-columns">
              <div class="pcc-triage-col">
                <div class="pcc-triage-col__header">
                  <i class="fa-solid fa-stethoscope" aria-hidden="true"></i>
                  <h3>1. El Diagnóstico Técnico</h3>
                </div>
                <p>
                  Es la etapa de inspección, medición y pruebas de descarte en banco de trabajo. Su objetivo exclusivo es localizar la causa raíz de la falla y evaluar si la pieza tiene reparación electrónica viable o si requiere reemplazo. <strong>El diagnóstico no incluye la refacción ni la reparación de antemano</strong>, ya que primero debes conocer qué tiene tu equipo y cuánto costará repararlo.
                </p>
                <a href="/servicios/pc/diagnostico" class="pcc-text-link">Conocer servicio de diagnóstico →</a>
              </div>

              <div class="pcc-triage-col">
                <div class="pcc-triage-col__header">
                  <i class="fa-solid fa-wrench" aria-hidden="true"></i>
                  <h3>2. El Mantenimiento Correctivo</h3>
                </div>
                <p>
                  Es la ejecución del trabajo autorizado: sustituir la fuente de poder dañada, reparar los condensadores de la placa madre, reemplazar la memoria RAM defectuosa, migrar un disco a SSD o reinstalar controladores limpios. <strong>Se cotiza de forma previa y transparente</strong>, desglosando refacción y mano de obra con garantía por escrito.
                </p>
                <a href="#contacto" class="pcc-text-link">Solicitar presupuesto correctivo →</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== 5. FALLA FÍSICA (HARDWARE) VS FALLA LÓGICA (SOFTWARE) ==================== -->
    <section id="hardware-vs-software" class="pcc-section pcc-compare-section" aria-labelledby="compare-title">
      <div class="container">
        <div class="pcc-heading pcc-heading--center">
          <span class="pcc-kicker">Clasificación del Problema</span>
          <h2 id="compare-title">¿La falla de tu PC es de Hardware o de Software?</h2>
          <p>
            Identificar si el origen del fallo es físico o de sistema operativo ahorra tiempo y dinero. En Pixon PC evaluamos ambas áreas:
          </p>
        </div>

        <div class="pcc-compare-grid">
          <!-- Columna Hardware -->
          <div class="pcc-compare-card pcc-compare-card--hw">
            <div class="pcc-compare-card__header">
              <span class="pcc-compare-badge"><i class="fa-solid fa-microchip" aria-hidden="true"></i> Nivel Físico</span>
              <h3>Fallas de Hardware</h3>
            </div>
            <ul class="pcc-compare-list">
              <li><strong>Síntomas comunes:</strong> No prende ningún LED, se apaga de golpe, la pantalla se queda negra con ventiladores al 100%, clics mecánicos o reinicios aleatorios sin mensaje de error.</li>
              <li><strong>Causas habituales:</strong> Condensadores desgastados, fuente con caída de 12V, celdas de RAM con errores, pistas sulfatadas por salitre o pasta térmica seca.</li>
              <li><strong>Procedimiento:</strong> Pruebas eléctricas con multímetro, sustitución de componentes averiados, microelectrónica si aplica y validación de temperaturas.</li>
            </ul>
          </div>

          <!-- Columna Software -->
          <div class="pcc-compare-card pcc-compare-card--sw">
            <div class="pcc-compare-card__header">
              <span class="pcc-compare-badge pcc-compare-badge--sw"><i class="fa-brands fa-windows" aria-hidden="true"></i> Nivel Lógico</span>
              <h3>Fallas de Software</h3>
            </div>
            <ul class="pcc-compare-list">
              <li><strong>Síntomas comunes:</strong> Pantallas azules con código de excepción, bucle de carga de Windows, aplicaciones que se cierran solas, virus, malware o lentitud severa.</li>
              <li><strong>Causas habituales:</strong> Actualizaciones fallidas de Windows, drivers de GPU incompatibles, archivos de sistema corruptos o infecciones de malware.</li>
              <li><strong>Procedimiento:</strong> Reparación de arranque BCD, desinfección profunda, reinstalación limpia de Windows con drivers certificados y respaldo previo de datos.</li>
            </ul>
            <div class="pcc-compare-footer">
              <a href="/servicios/pc/formateo" class="pcc-text-link">Ver servicio de formateo y Windows →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== 6. ¿CONVIENE REPARAR O CAMBIAR LA PC? ==================== -->
    <section id="decision" class="pcc-section pcc-decision-section" aria-labelledby="decision-title">
      <div class="container">
        <div class="pcc-decision-box">
          <div class="pcc-heading">
            <span class="pcc-kicker">Asesoría Honesta</span>
            <h2 id="decision-title">¿Conviene reparar tu PC o armar una completamente nueva?</h2>
            <p>
              No todas las computadoras deben repararse a cualquier costo. Actuamos con total transparencia: si el costo de la reparación no es rentable para ti, te lo decimos claro antes de que gastes un solo peso.
            </p>
          </div>

          <div class="pcc-decision-grid">
            <div class="pcc-decision-card pcc-decision-card--yes">
              <div class="pcc-decision-card__header">
                <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                <h3>Cuándo SÍ conviene reparar</h3>
              </div>
              <ul>
                <li>Tu equipo cuenta con una plataforma actual (DDR4 o DDR5, sockets AMD AM4/AM5 o Intel recientes).</li>
                <li>La falla está localizada en un único componente accesible (fuente de poder, ventilador, SSD o módulo de RAM).</li>
                <li>El costo de la refacción y mano de obra es significativamente menor al valor de un equipo nuevo equivalente.</li>
                <li>La computadora cumple perfectamente tu carga habitual de trabajo, escuela o gaming una vez reparada.</li>
              </ul>
            </div>

            <div class="pcc-decision-card pcc-decision-card--no">
              <div class="pcc-decision-card__header">
                <i class="fa-solid fa-circle-xmark" aria-hidden="true"></i>
                <h3>Cuándo NO conviene reparar</h3>
              </div>
              <ul>
                <li>Plataforma muy antigua (memorias DDR2/DDR3, procesadores de más de 10 años sin soporte oficial).</li>
                <li>Múltiples componentes críticos dañados simultáneamente (placa madre perforada + fuente + procesador).</li>
                <li>Las refacciones solo se consiguen usadas, sin garantía o a precios inflados por escasez en el mercado.</li>
                <li>El presupuesto de reparación se acerca al costo de una PC nueva ensamblada con tecnología actual y garantía completa.</li>
              </ul>
              <div class="pcc-decision-footer">
                <a href="/ensambles" class="pcc-text-link">Ver armado de PC Gamer y Oficina por piezas →</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== 7. PROCESO TÉCNICO EN 6 PASOS ==================== -->
    <section id="proceso" class="pcc-section pcc-process-section" aria-labelledby="process-title">
      <div class="container">
        <div class="pcc-heading pcc-heading--center">
          <span class="pcc-kicker">Metodología de Trabajo</span>
          <h2 id="process-title">Proceso técnico de mantenimiento correctivo en Cancún</h2>
          <p>
            Trabajamos con un protocolo ordenado para garantizar que tu computadora quede completamente funcional, estable y con presupuesto autorizado:
          </p>
        </div>

        <div class="pcc-process-grid">
          {processSteps.map((step) => (
            <div class="pcc-step-card">
              <span class="pcc-step-card__num">{step.num}</span>
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ==================== 8. PROTOCOLO DE PRUEBAS POST-REPARACIÓN ==================== -->
    <section id="pruebas" class="pcc-section pcc-testing-section" aria-labelledby="testing-title">
      <div class="container">
        <div class="pcc-testing-layout">
          <div class="pcc-testing-content">
            <span class="pcc-kicker">Control de Calidad</span>
            <h2 id="testing-title">Pruebas técnicas adaptadas a cada componente intervenido</h2>
            <p>
              No asumimos que una computadora está lista simplemente porque encendió. Las pruebas finales dependen de la pieza reparada o reemplazada para verificar su rendimiento bajo condiciones reales de exigencia:
            </p>

            <div class="pcc-tests-list">
              <div class="pcc-test-item">
                <i class="fa-solid fa-plug-circle-bolt" aria-hidden="true"></i>
                <div>
                  <strong>Fuentes de poder y alimentación:</strong>
                  <p>Medición de voltajes estables (+12V, +5V, +3.3V) bajo consumo máximo para certificar que no haya caídas repentinas.</p>
                </div>
              </div>

              <div class="pcc-test-item">
                <i class="fa-solid fa-memory" aria-hidden="true"></i>
                <div>
                  <strong>Memoria RAM:</strong>
                  <p>Pruebas de ciclos de lectura y escritura para descartar celdas inestables que causan congelamientos o pantallas azules.</p>
                </div>
              </div>

              <div class="pcc-test-item">
                <i class="fa-solid fa-hard-drive" aria-hidden="true"></i>
                <div>
                  <strong>Unidades de almacenamiento SSD/HDD:</strong>
                  <p>Comprobación de registros SMART, velocidades de lectura secuencial y aleatoria, y temperatura del controlador M.2.</p>
                </div>
              </div>

              <div class="pcc-test-item">
                <i class="fa-solid fa-vr-cardboard" aria-hidden="true"></i>
                <div>
                  <strong>Tarjetas gráficas y procesadores:</strong>
