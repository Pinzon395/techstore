  display: inline-flex; align-items: center; gap: 8px;
  padding: 13px 22px; border-radius: 10px;
  background: linear-gradient(135deg, #16a34a, #15803d);
  color: #f8fafc; font-weight: 700; font-size: 0.92rem;
  text-decoration: none; transition: transform 0.2s, box-shadow 0.2s;
  box-shadow: 0 4px 14px rgba(22,163,74,0.3);
}
.fid-btn-wa:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(22,163,74,0.4); }
.fid-btn-wa--sm { padding: 10px 18px; font-size: 0.88rem; }
.fid-btn-outline {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 20px; border-radius: 10px; border: 1px solid rgba(59,130,246,0.4);
  color: #93c5fd; font-weight: 600; font-size: 0.92rem;
  text-decoration: none; transition: border-color 0.2s, background 0.2s;
}
.fid-btn-outline:hover { border-color: var(--fid-primary); background: rgba(59,130,246,0.08); }
.fid-micro { color: var(--fid-muted); font-size: 0.8rem; }

/* ── Hero Card ── */
.fid-hero-card-wrap { display: flex; justify-content: center; }
.fid-hero-card {
  background: linear-gradient(145deg, #111d34, #0d1a2d);
  border: 1px solid rgba(59,130,246,0.2); border-radius: 20px; padding: 24px;
  width: 100%; max-width: 360px; box-shadow: 0 20px 60px rgba(0,0,0,0.4);
}
.fid-card-header {
  display: flex; align-items: center; gap: 8px; font-size: 0.84rem;
  font-weight: 700; color: #93c5fd; margin-bottom: 20px;
}

/* Face Visual */
.fid-face-visual {
  display: flex; flex-direction: column; align-items: center;
  gap: 10px; margin-bottom: 20px;
}
.fid-face-scan {
  width: 160px; height: 160px; position: relative;
  display: flex; align-items: center; justify-content: center;
}
.fid-scan-ring {
  position: absolute; border-radius: 999px;
  border: 2px solid rgba(59,130,246,0.3);
}
.fid-scan-ring--1 { width: 160px; height: 160px; animation: fid-pulse 2.4s ease-in-out infinite; }
.fid-scan-ring--2 { width: 120px; height: 120px; animation: fid-pulse 2.4s ease-in-out 0.4s infinite; border-color: rgba(96,165,250,0.4); }
.fid-scan-ring--3 { width: 80px; height: 80px;  animation: fid-pulse 2.4s ease-in-out 0.8s infinite; border-color: rgba(147,197,253,0.5); }
@keyframes fid-pulse {
  0%,100% { opacity: 0.5; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.04); }
}
.fid-face-icon {
  position: relative; z-index: 2; font-size: 2.5rem; color: #60a5fa;
  filter: drop-shadow(0 0 14px rgba(96,165,250,0.5));
}
.fid-scan-line {
  position: absolute; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, transparent, rgba(96,165,250,0.9), transparent);
  box-shadow: 0 0 10px rgba(96,165,250,0.5);
  animation: fid-scan 2s ease-in-out infinite;
}
@keyframes fid-scan {
  0% { top: 0; opacity: 0; }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% { top: 100%; opacity: 0; }
}
.fid-dots-grid {
  position: absolute; inset: 0; display: grid; grid-template-columns: repeat(5,1fr);
  gap: 4px; padding: 12px; pointer-events: none;
}
.fid-dot {
  width: 4px; height: 4px; border-radius: 999px;
  background: rgba(96,165,250,0.4);
  animation: fid-dot-blink 3s ease-in-out infinite;
}
.fid-dot:nth-child(odd) { animation-delay: 0.3s; }
.fid-dot:nth-child(3n) { animation-delay: 0.7s; }
@keyframes fid-dot-blink {
  0%,100% { opacity: 0.2; }
  50% { opacity: 0.9; }
}
.fid-truedepth-label {
  display: flex; align-items: center; gap: 6px;
  font-size: 0.72rem; font-weight: 700; color: #93c5fd;
  background: rgba(59,130,246,0.1); border: 1px solid rgba(59,130,246,0.2);
  padding: 5px 12px; border-radius: 999px;
}

/* Card checks */
.fid-card-checks { list-style: none; padding: 0; margin: 0 0 16px; display: grid; gap: 8px; }
.fid-card-checks li { display: flex; align-items: center; gap: 8px; font-size: 0.84rem; color: #cbd5e1; }
.fid-card-checks i { color: #22c55e; }

.fid-card-cta {
  display: flex; align-items: center; justify-content: center; gap: 8px;
  width: 100%; padding: 11px; border-radius: 10px;
  background: linear-gradient(135deg, #16a34a, #15803d);
  color: #f8fafc; font-weight: 700; font-size: 0.87rem;
  text-decoration: none; transition: opacity 0.2s;
}
.fid-card-cta:hover { opacity: 0.92; }

/* ══════════════════════════════════════════════════
   SECCIÓN 2 · STATS
══════════════════════════════════════════════════ */
.fid-stats {
  background: #f8fafc;
  border-top: 1px solid rgba(15,42,74,0.1);
  border-bottom: 1px solid rgba(15,42,74,0.1);
  padding: 32px 0;
}
.fid-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.fid-stat-card {
  display: flex; flex-direction: column; align-items: center;
  gap: 8px; text-align: center; padding: 20px 12px;
  border-radius: 16px; border: 1px solid rgba(15,42,74,0.12);
  background: #ffffff;
  box-shadow: 0 14px 34px rgba(15,42,74,0.07);
  transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
}
.fid-stat-card:hover {
  border-color: rgba(37,99,235,0.3);
  transform: translateY(-2px);
  box-shadow: 0 18px 42px rgba(15,42,74,0.11);
}
.fid-stat-icon {
  width: 44px; height: 44px; border-radius: 12px;
  display: flex; align-items: center; justify-content: center; font-size: 1.2rem;
}
.fid-stat-num { font-size: 1.6rem; font-weight: 900; font-family: 'Kanit', sans-serif; color: var(--fid-dark-text); }
.fid-stat-label { font-size: 0.78rem; color: #244766; font-weight: 800; }

/* ══════════════════════════════════════════════════
   SECCIÓN 3 · SÍNTOMAS
══════════════════════════════════════════════════ */
.fid-sintomas { padding: 64px 0; background: var(--fid-light-bg); }
.fid-sintomas .fid-eyebrow { color: #1D4ED8; }
.fid-sintomas .fid-eyebrow i { color: #1D4ED8; }
.fid-sintomas .fid-h2 { color: var(--fid-dark-text); }
.fid-sintomas .fid-desc { color: var(--fid-soft-text); }

.fid-sintomas-grid { display: grid; grid-template-columns: repeat(12, minmax(0,1fr)); gap: 16px; }
.fid-sintoma-card {
  grid-column: span 4; display: flex; align-items: flex-start; gap: 14px;
  background: #f8fafc; border: 1px solid rgba(15,42,74,0.12); border-radius: 16px;
  padding: 18px 16px; position: relative;
  box-shadow: 0 14px 34px rgba(15,42,74,0.07);
  transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
}
.fid-sintoma-card:hover { border-color: rgba(59,130,246,0.3); transform: translateY(-2px); }
.fid-sintoma-card--urgent { border-color: rgba(239,68,68,0.3); background: #fff7f7; }
.fid-sintoma-card--urgent:hover { border-color: rgba(239,68,68,0.5); }
.fid-sintoma-num { font-size: 0.65rem; font-weight: 800; color: var(--fid-muted); position: absolute; top: 12px; right: 14px; }
.fid-sintoma-icon {
  width: 42px; height: 42px; border-radius: 10px;
  background: rgba(59,130,246,0.1); display: flex; align-items: center;
  justify-content: center; flex-shrink: 0;
}
.fid-sintoma-icon i { color: var(--fid-primary-light); font-size: 1.1rem; }
.fid-sintoma-card--urgent .fid-sintoma-icon { background: rgba(239,68,68,0.1); }
.fid-sintoma-card--urgent .fid-sintoma-icon i { color: #f87171; }
.fid-sintoma-body h3 { font-size: 0.9rem; font-weight: 700; color: var(--fid-dark-text); margin-bottom: 4px; }
.fid-sintoma-body p { font-size: 0.82rem; color: var(--fid-soft-text); line-height: 1.5; margin: 0; }
.fid-sintoma-urgent-tag {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 0.72rem; font-weight: 700; color: #dc2626; margin-top: 8px;
}
.fid-sintoma-cta-card {
  grid-column: span 4; display: flex; flex-direction: column;
  align-items: center; justify-content: center; text-align: center; gap: 10px;
  background: linear-gradient(135deg, #eef6ff, #f8fafc);
  border: 1px solid rgba(37,99,235,0.18); border-radius: 16px; padding: 24px 16px;
  box-shadow: 0 14px 34px rgba(15,42,74,0.08);
}
.fid-sintoma-cta-card i.fa-brands { font-size: 2rem; color: var(--fid-primary-light); }
.fid-sintoma-cta-card strong { color: var(--fid-dark-text); font-size: 0.95rem; }
.fid-sintoma-cta-card p { color: var(--fid-soft-text); font-size: 0.83rem; margin: 0; }
.fid-sintoma-cta-card a {
  display: inline-flex; align-items: center; gap: 7px; padding: 9px 18px;
  border-radius: 8px; background: #16a34a; color: #f8fafc;
  font-weight: 700; font-size: 0.85rem; text-decoration: none; transition: opacity 0.2s;
}
.fid-sintoma-cta-card a:hover { opacity: 0.88; }

/* ══════════════════════════════════════════════════
   SECCIÓN 4 · CÓMO FUNCIONA
══════════════════════════════════════════════════ */
.fid-como-funciona { padding: 64px 0; background: var(--fid-bg2); }
.fid-como-funciona {
  background:
    linear-gradient(135deg, rgba(37,99,235,0.08), transparent 42%),
    var(--fid-light-bg);
}
.fid-como-funciona .fid-eyebrow { color: #1D4ED8; }
.fid-como-funciona .fid-eyebrow i { color: #1D4ED8; }
.fid-como-funciona .fid-h2,
.fid-como-funciona .fid-desc { color: var(--fid-dark-text); }
.fid-como-funciona .fid-desc { opacity: 0.88; }
.fid-como-grid {
  display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 16px; margin-bottom: 24px;
}
.fid-como-card {
  background: #ffffff;
  border: 1px solid rgba(15,42,74,0.12);
  border-radius: 18px;
  padding: 22px;
  position: relative;
  box-shadow: 0 16px 36px rgba(15,42,74,0.08);
  transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
}
.fid-como-card:hover {
  border-color: rgba(37,99,235,0.32);
  transform: translateY(-2px);
  box-shadow: 0 20px 46px rgba(15,42,74,0.12);
}
.fid-como-num {
  font-size: 0.72rem; font-weight: 900; color: #1D4ED8;
  position: absolute; top: 14px; right: 16px; letter-spacing: 0.04em;
}
.fid-como-icon {
  width: 44px; height: 44px; border-radius: 12px;
  background: #eaf2ff; display: flex; align-items: center;
  justify-content: center; margin-bottom: 14px;
}
.fid-como-icon i { color: #1D4ED8; font-size: 1.1rem; }
.fid-como-card h3 { font-size: 0.96rem; font-weight: 800; color: var(--fid-dark-text); margin-bottom: 8px; }
.fid-como-card p { font-size: 0.84rem; color: #244766; line-height: 1.58; margin: 0; }
.fid-como-note {
  display: flex; align-items: flex-start; gap: 10px;
  background: #eef6ff; border: 1px solid rgba(37,99,235,0.18);
  border-radius: 14px; padding: 16px 20px;
  color: var(--fid-dark-text); font-size: 0.9rem; line-height: 1.6;
  box-shadow: 0 14px 34px rgba(15,42,74,0.08);
}
.fid-como-note i { color: #1D4ED8; flex-shrink: 0; margin-top: 2px; }
.fid-como-note strong { color: #0b2d52; }

/* ══════════════════════════════════════════════════
   SECCIÓN 5 · CAUSAS
══════════════════════════════════════════════════ */
.fid-causas { padding: 64px 0; background: var(--fid-light-bg); }
.fid-causas .fid-eyebrow { color: #1D4ED8; }
.fid-causas .fid-eyebrow i { color: #1D4ED8; }
.fid-causas .fid-h2 { color: var(--fid-dark-text); }
.fid-causas .fid-desc { color: var(--fid-soft-text); }
.fid-causas-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 16px; }
.fid-causa-card {
  display: flex; align-items: flex-start; gap: 16px;
  background: #f8fafc; border: 1px solid rgba(15,42,74,0.12);
  border-left: 4px solid var(--causa-color, #3b82f6);
  border-radius: 14px; padding: 18px;
  box-shadow: 0 12px 28px rgba(15,42,74,0.07);
  transition: transform 0.2s, box-shadow 0.2s;
}
.fid-causa-card:hover { transform: translateY(-2px); box-shadow: 0 18px 40px rgba(15,42,74,0.1); }
.fid-causa-icon {
  width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0;
  background: color-mix(in srgb, var(--causa-color) 12%, #f8fafc);
  display: flex; align-items: center; justify-content: center;
}
.fid-causa-icon i { color: var(--causa-color); font-size: 1.1rem; }
.fid-causa-header { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 6px; }
.fid-causa-body h3 { font-size: 0.92rem; font-weight: 700; color: var(--fid-dark-text); margin: 0; }
.fid-causa-body p { font-size: 0.82rem; color: var(--fid-soft-text); line-height: 1.5; margin: 0; }
.fid-causa-nivel {
  font-size: 0.68rem; font-weight: 800; flex-shrink: 0;
  padding: 4px 9px; border-radius: 999px;
  background: color-mix(in srgb, var(--causa-color) 12%, #f1f5f9);
  color: var(--causa-color); border: 1px solid color-mix(in srgb, var(--causa-color) 30%, transparent);
}

/* ══════════════════════════════════════════════════
   SECCIÓN 6 · ADVERTENCIAS
══════════════════════════════════════════════════ */
.fid-advertencias {
  padding: 64px 0;
  background: linear-gradient(180deg, #0f172a, #0B1120);
}
.fid-advertencias .fid-h2 { color: var(--fid-text); }
.fid-advertencias .fid-desc--light { color: var(--fid-muted); }
.fid-advertencias-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 16px; }
.fid-advertencia-card {
  display: flex; align-items: flex-start; gap: 16px;
  background: rgba(255,255,255,0.04); border: 1px solid var(--fid-border);
  border-left: 4px solid var(--adv-color, #3b82f6);
  border-radius: 16px; padding: 20px;
  transition: border-color 0.2s, transform 0.2s;
}
.fid-advertencia-card:hover { border-color: color-mix(in srgb, var(--adv-color) 60%, transparent); transform: translateY(-2px); }
.fid-adv-icon {
  width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0;
  background: color-mix(in srgb, var(--adv-color) 14%, transparent);
  display: flex; align-items: center; justify-content: center;
}
.fid-adv-icon i { color: var(--adv-color); font-size: 1.15rem; }
.fid-advertencia-card h3 { font-size: 0.9rem; font-weight: 700; color: var(--fid-text); margin-bottom: 6px; line-height: 1.3; }
.fid-advertencia-card p { font-size: 0.82rem; color: var(--fid-muted); line-height: 1.55; margin: 0; }

/* ══════════════════════════════════════════════════
   SECCIÓN 7 · TIPOS DE REPARACIÓN
══════════════════════════════════════════════════ */
.fid-tipos { padding: 64px 0; background: #eef6ff; }
.fid-tipos .fid-eyebrow { color: #1D4ED8; }
.fid-tipos .fid-eyebrow i { color: #1D4ED8; }
.fid-tipos .fid-h2 { color: var(--fid-dark-text); }
.fid-tipos .fid-desc { color: var(--fid-soft-text); }
.fid-tipos-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 16px; margin-bottom: 20px; }
.fid-tipo-card {
  background: #f8fafc; border: 1px solid rgba(15,42,74,0.12);
  border-top: 4px solid var(--tipo-color, #3b82f6);
  border-radius: 16px; padding: 20px; display: flex; flex-direction: column; gap: 14px;
  box-shadow: 0 14px 34px rgba(15,42,74,0.08);
  transition: box-shadow 0.25s, transform 0.25s;
}
.fid-tipo-card:hover { box-shadow: 0 20px 48px rgba(15,42,74,0.12); transform: translateY(-2px); }
.fid-tipo-badge {
  display: inline-flex; color: color-mix(in srgb, var(--tipo-color) 80%, #1D4ED8);
  background: color-mix(in srgb, var(--tipo-color) 10%, #f1f5f9);
  border: 1px solid color-mix(in srgb, var(--tipo-color) 25%, transparent);
  border-radius: 999px; padding: 5px 12px; font-size: 0.72rem; font-weight: 850;
}
.fid-tipo-card h3 { font-size: 1rem; font-weight: 800; color: var(--fid-dark-text); margin: 0; font-family: 'Kanit', sans-serif; }
.fid-tipo-card p { font-size: 0.84rem; color: var(--fid-soft-text); line-height: 1.52; margin: 0; }
.fid-tipo-checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
.fid-tipo-checks li { display: flex; align-items: flex-start; gap: 7px; color: var(--fid-dark-text); font-size: 0.8rem; font-weight: 700; }
.fid-tipo-checks svg { width: 15px; height: 15px; flex: 0 0 15px; margin-top: 1px; fill: var(--tipo-color); }
.fid-tipos-cta {
  display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
  background: #f8fafc; border: 1px solid rgba(37,99,235,0.14);
  border-radius: 14px; padding: 16px 20px;
  color: var(--fid-soft-text); font-size: 0.86rem;
}
.fid-tipos-cta i { color: #1D4ED8; flex-shrink: 0; }
.fid-tipos-cta span { flex: 1; }

/* ══════════════════════════════════════════════════
   SECCIÓN 8 · PROCESO
══════════════════════════════════════════════════ */
.fid-proceso { padding: 64px 0; background: #f8fafc; }
.fid-proceso .fid-eyebrow { color: #1D4ED8; }
.fid-proceso .fid-eyebrow i { color: #1D4ED8; }
.fid-proceso-head {
  display: grid; grid-template-columns: minmax(0,1fr) auto;
  gap: 22px; align-items: end; margin-bottom: 30px;
}
.fid-proceso-copy .fid-h2 { color: var(--fid-dark-text); }
.fid-proceso-copy .fid-desc { color: var(--fid-soft-text); }
.fid-proceso-tags { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; max-width: 430px; }
.fid-proceso-tags span {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 8px 11px; border-radius: 999px; border: 1px solid rgba(37,99,235,0.16);
  color: var(--fid-dark-text); font-size: 0.76rem; font-weight: 850; background: #eef6ff;
}

.fid-proceso-steps {
  display: grid; grid-template-columns: repeat(7, minmax(0,1fr)); gap: 10px; margin-bottom: 20px;
  position: relative;
}
.fid-proceso-steps::before {
  content: ''; position: absolute; left: 6%; right: 6%; top: 28px; height: 2px;
  background: linear-gradient(90deg, rgba(37,99,235,0.1), rgba(37,99,235,0.42), rgba(37,99,235,0.1));
}
.fid-step {
  position: relative; z-index: 1; display: flex; flex-direction: column; gap: 10px;
  background: #f8fafc; border: 1px solid rgba(15,42,74,0.12);
  box-shadow: 0 12px 28px rgba(15,42,74,0.07); border-radius: 14px; padding: 12px;
  transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
}
.fid-step:hover { border-color: rgba(59,130,246,0.25); transform: translateY(-2px); }
.fid-step-num {
  width: 34px; height: 34px; display: grid; place-items: center;
  color: #f8fafc; background: #2563eb; border: 3px solid #eef6ff;
  border-radius: 999px; font-family: 'Kanit', sans-serif; font-size: 0.74rem; font-weight: 950;
  box-shadow: 0 8px 22px rgba(37,99,235,0.24);
}
.fid-step-icon {
  width: 30px; height: 30px; border-radius: 8px;
  background: rgba(59,130,246,0.1); display: flex; align-items: center;
  justify-content: center; margin-bottom: 6px;
}
.fid-step-icon i { color: #2563eb; font-size: 0.88rem; }
.fid-step-body h3 { font-size: 0.8rem; font-weight: 820; color: var(--fid-dark-text); line-height: 1.2; margin-bottom: 5px; }
.fid-step-body p { font-size: 0.73rem; color: var(--fid-soft-text); line-height: 1.44; margin: 0; }

.fid-proceso-proof {
  display: grid; grid-template-columns: 44px minmax(0,1fr) auto;
  align-items: center; gap: 14px; padding: 16px; border-radius: 18px;
  background: #0B1120; border: 1px solid rgba(147,197,253,0.18);
  box-shadow: 0 18px 44px rgba(15,42,74,0.14);
}
.fid-proof-icon {
  width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center;
  background: rgba(34,197,94,0.14);
