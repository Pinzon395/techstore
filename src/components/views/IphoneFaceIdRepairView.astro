    <div class="container fid-stats-grid">
      {stats.map((s) => (
        <div class="fid-stat-card">
          <div class="fid-stat-icon" style={`background: ${s.color}18; color: ${s.color};`}>
            <i class={`fa-solid ${s.icon}`}></i>
          </div>
          <strong class="fid-stat-num">{s.num}</strong>
          <span class="fid-stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 3 · SÍNTOMAS
  ═══════════════════════════════════════════════ -->
  <section class="fid-sintomas">
    <div class="container">
      <div class="fid-section-head">
        <span class="fid-eyebrow"><i class="fa-solid fa-stethoscope"></i> Síntomas</span>
        <h2 class="fid-h2">¿Tu iPhone presenta alguno de estos síntomas de Face ID?</h2>
