      </div>

      <div class="fid-sintomas-grid">
        {sintomas.map((s, i) => (
          <article class={`fid-sintoma-card${s.urgent ? ' fid-sintoma-card--urgent' : ''}`}>
            <div class="fid-sintoma-num">{String(i + 1).padStart(2, '0')}</div>
            <div class="fid-sintoma-icon">
              <i class={`fa-solid ${s.icon}`}></i>
            </div>
            <div class="fid-sintoma-body">
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              {s.urgent && <span class="fid-sintoma-urgent-tag"><i class="fa-solid fa-triangle-exclamation"></i> Requiere revisión urgente</span>}
            </div>
          </article>
        ))}

        <div class="fid-sintoma-cta-card">
          <i class="fa-brands fa-apple"></i>
          <strong>¿Tu iPhone tiene este problema?</strong>
          <p>Envíanos modelo y descripción de cuándo y cómo falló Face ID para orientarte.</p>
          <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-whatsapp"></i> Escribir ahora
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 4 · CÓMO FUNCIONA FACE ID
  ═══════════════════════════════════════════════ -->
  <section class="fid-como-funciona">
