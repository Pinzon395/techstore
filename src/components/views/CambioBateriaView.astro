.cb-sintomas {
  background:
    radial-gradient(circle at 8% 12%, rgba(59, 130, 246, 0.12), transparent 28%),
    linear-gradient(180deg, #f8fafc 0%, #eef6ff 100%);
  padding-top: 44px;
  padding-bottom: 46px;
}

.cb-section-header {
  margin-bottom: 50px;
}

.cb-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #3b82f6;
  font-size: 0.85rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 12px;
}

.cb-h2-section {
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 16px;
}

.cb-desc {
  color: #475569;
  font-size: 1rem;
  max-width: 700px;
  margin: 0;
  line-height: 1.65;
}

.cb-diagnostico-layout {
  display: grid;
  grid-template-columns: minmax(0, 0.84fr) minmax(0, 1.16fr);
  gap: 22px;
  align-items: center;
}

.cb-diagnostico-copy {
  position: sticky;
  top: 84px;
}

.cb-diagnostico-copy .cb-eyebrow {
  margin-bottom: 8px;
}

.cb-diagnostico-copy .cb-h2-section {
  font-size: clamp(1.26rem, 2.25vw, 1.68rem);
  margin-bottom: 8px;
}

.cb-diagnostico-copy .cb-desc {
  margin: 0;
  max-width: 560px;
  font-size: 0.9rem;
  line-height: 1.46;
}

.cb-diagnostico-summary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  margin: 13px 0;
}

.cb-diagnostico-summary div,
.cb-diag-stat {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 10px 11px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.22);
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
}

.cb-diag-stat > i {
  color: #3b82f6;
  font-size: 0.78rem;
  margin-bottom: 2px;
}

.cb-diagnostico-summary strong,
.cb-diag-stat strong {
  display: block;
  color: #0f172a;
  font-size: 0.84rem;
  font-weight: 700;
  margin-bottom: 1px;
}

.cb-diagnostico-summary span,
.cb-diag-stat span {
  display: block;
  color: #64748b;
  font-size: 0.72rem;
  line-height: 1.28;
}

.cb-diagnostico-visual {
  position: relative;
  min-height: 190px;
  border-radius: 20px;
  overflow: hidden;
  background: #0f172a;
  box-shadow: 0 24px 55px rgba(15, 23, 42, 0.18);
}

.cb-diagnostico-visual::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(15, 23, 42, 0.04), rgba(15, 23, 42, 0.82)),
    linear-gradient(90deg, rgba(15, 23, 42, 0.18), rgba(37, 99, 235, 0.14));
}

.cb-diagnostico-visual img {
  width: 100%;
  height: 100%;
  min-height: 190px;
  object-fit: cover;
  object-position: center;
  display: block;
}

.cb-diagnostico-overlay {
  position: absolute;
  right: 12px;
  top: 12px;
  z-index: 1;
  width: min(150px, calc(100% - 24px));
  padding: 9px 10px;
  border-radius: 15px;
  background: rgba(10, 15, 30, 0.82);
  border: 1px solid rgba(255, 255, 255, 0.14);
  backdrop-filter: blur(18px);
  color: #fff;
}

.cb-diag-ov-row {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #93c5fd;
  font-size: 0.68rem;
  font-weight: 700;
  margin-bottom: 5px;
}

.cb-diag-ov-pct {
  display: block;
  font-size: 1.75rem;
  font-weight: 900;
  line-height: 1;
  color: #f97316;
  margin-bottom: 5px;
}

.cb-diag-ov-bar {
  height: 4px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 999px;
  overflow: hidden;
  margin-bottom: 5px;
}

.cb-diag-ov-bar > div {
  height: 100%;
  background: linear-gradient(90deg, #f97316, #ef4444);
  border-radius: 999px;
}

.cb-diagnostico-overlay small {
  display: block;
  color: #94a3b8;
  font-size: 0.61rem;
  font-weight: 600;
  line-height: 1.25;
}

.cb-diagnostico-alert {
  position: absolute;
  left: 12px;
  right: 12px;
  bottom: 12px;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 10px;
  border-radius: 14px;
  background: rgba(127, 29, 29, 0.82);
  border: 1px solid rgba(252, 165, 165, 0.28);
  color: #fee2e2;
  font-size: 0.76rem;
  font-weight: 700;
  backdrop-filter: blur(12px);
}

.cb-sintomas-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 9px;
}

.cb-sintoma-card {
  position: relative;
  display: grid;
  grid-template-columns: 38px 1fr;
  gap: 10px;
  background: #fff;
  padding: 10px;
  border-radius: 14px;
  border: 1px solid rgba(148, 163, 184, 0.24);
  box-shadow: 0 14px 36px rgba(15, 23, 42, 0.06);
  overflow: hidden;
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}

.cb-sintoma-card:hover {
  transform: translateY(-4px);
  border-color: rgba(59, 130, 246, 0.34);
  box-shadow: 0 18px 42px rgba(15, 23, 42, 0.1);
}

.cb-sintoma-card.is-urgent {
  background: linear-gradient(135deg, #fff 0%, #fff7ed 100%);
  border-color: rgba(249, 115, 22, 0.35);
}

.cb-sintoma-index {
  position: absolute;
  right: 10px;
  top: 9px;
  color: rgba(15, 23, 42, 0.08);
  font-size: 1.35rem;
  font-weight: 900;
  line-height: 1;
}

.cb-sintoma-icon {
  width: 38px;
  height: 38px;
  background: linear-gradient(135deg, #3b82f6, #6366f1);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 0.95rem;
  flex-shrink: 0;
}

.cb-sintoma-card.is-urgent .cb-sintoma-icon {
  background: linear-gradient(135deg, #f97316, #ef4444);
}

.cb-sintoma-content h3 {
  font-size: 0.84rem;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 3px;
  padding-right: 24px;
}

.cb-sintoma-content p {
  font-size: 0.74rem;
  color: #64748b;
  line-height: 1.34;
}

.cb-sintoma-cta {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px;
  border-radius: 15px;
  background: #0f172a;
  color: #fff;
  box-shadow: 0 18px 44px rgba(15, 23, 42, 0.18);
}

.cb-sintoma-cta span,
.cb-sintoma-cta strong {
  display: block;
}

.cb-sintoma-cta span {
  color: #93c5fd;
  font-size: 0.72rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-bottom: 3px;
}

.cb-sintoma-cta strong {
  color: #f8fafc;
  font-size: 0.88rem;
  line-height: 1.25;
}

.cb-sintoma-cta a,
.cb-sintoma-cta-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 38px;
  padding: 9px 14px;
  border-radius: 999px;
  background: #16a34a;
  color: #fff;
  font-weight: 800;
  font-size: 0.82rem;
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
  transition: background 0.2s, transform 0.2s;
  box-shadow: 0 6px 18px rgba(22, 163, 74, 0.28);
}

.cb-sintoma-cta a:hover,
.cb-sintoma-cta-btn:hover {
  background: #15803d;
  transform: translateY(-1px);
}

/* SECTION 3: RESULTADOS (SEO local) */
.cb-resultados {
  background: #f8fafc;
  border-top: 1px solid #e2e8f0;
  padding: 48px 0 40px;       /* override section-pad: compacto */
}

.cb-res-header {
  max-width: 760px;
  margin-bottom: 22px;
}

.cb-res-header .cb-h2-section {
  font-size: clamp(1.3rem, 2.5vw, 1.7rem);
  margin-bottom: 10px;
}

.cb-res-desc {
  margin: 0;
  max-width: 720px;
  font-size: 0.93rem;
  line-height: 1.6;
}

.cb-res-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 22px;
}

.cb-res-card {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  padding: 14px 14px 12px;
  transition: box-shadow 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
}

.cb-res-card:hover {
  border-color: rgba(59, 130, 246, 0.3);
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
  transform: translateY(-2px);
}

.cb-res-card-top {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 8px;
}

.cb-res-icon {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  border: 1px solid rgba(59, 130, 246, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2563eb;
  font-size: 0.88rem;
  flex-shrink: 0;
}

.cb-res-dato {
  display: inline-block;
  padding: 3px 8px;
  border-radius: 999px;
  background: rgba(34, 197, 94, 0.1);
  border: 1px solid rgba(34, 197, 94, 0.22);
  color: #16a34a;
  font-size: 0.68rem;
  font-weight: 700;
  white-space: nowrap;
}

.cb-res-card h3 {
  font-size: 0.88rem;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 5px;
  line-height: 1.3;
}

.cb-res-card p {
  font-size: 0.78rem;
  color: #475569;
  line-height: 1.55;
}

.cb-res-card p strong {
  color: #1e3a8a;
  font-weight: 600;
}

/* CTA final de la secciÃ³n */
.cb-res-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
  padding: 20px 26px;
  border-radius: 18px;
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  box-shadow: 0 16px 40px rgba(15, 23, 42, 0.18);
}

.cb-res-cta-text strong {
  display: block;
  color: #f8fafc;
  font-size: 0.98rem;
  font-weight: 700;
  margin-bottom: 4px;
}

.cb-res-cta-text p {
  color: #94a3b8;
  font-size: 0.82rem;
  line-height: 1.5;
  margin: 0;
}

/* SECTION 4: PROCESO TÃ‰CNICO / KEYBOARD */
.cb-proceso {
  background:
    linear-gradient(135deg, rgba(15, 23, 42, 0.96), rgba(30, 41, 59, 0.94)),
    radial-gradient(circle at 10% 0%, rgba(59, 130, 246, 0.22), transparent 34%);
  overflow: hidden;
}

.cb-process-shell {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  gap: 28px;
  align-items: center;
}

.cb-process-copy .cb-eyebrow {
  color: #93c5fd;
}

.cb-process-copy .cb-h2-section {
  color: #f8fafc;
  font-size: clamp(1.45rem, 2.8vw, 2.2rem);
  line-height: 1.18;
  margin-bottom: 14px;
}

.cb-process-copy .cb-desc {
  color: #cbd5e1;
  max-width: 600px;
}

.cb-process-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin: 22px 0;
}

.cb-process-tags span {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 11px;
  border: 1px solid rgba(148, 163, 184, 0.24);
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.62);
  color: #dbeafe;
  font-size: 0.78rem;
  font-weight: 700;
}

.cb-process-tags i {
  color: #38bdf8;
}

.cb-keyboard-stage {
  position: relative;
  padding: 18px;
  border-radius: 22px;
  border: 1px solid rgba(96, 165, 250, 0.22);
  background:
    linear-gradient(180deg, rgba(30, 41, 59, 0.94), rgba(2, 6, 23, 0.94));
  box-shadow: 0 24px 70px rgba(2, 6, 23, 0.38), inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

.cb-keyboard-screen {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
  padding: 10px 12px;
  border-radius: 12px;
  background: #020617;
  border: 1px solid rgba(34, 197, 94, 0.22);
  color: #86efac;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.76rem;
}

.cb-keyboard-screen strong {
  color: #bae6fd;
  font-weight: 800;
}

.cb-keyboard-row {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(48px, 1fr);
  gap: 8px;
  margin-top: 8px;
}

.cb-key {
  min-height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10px;
  border-radius: 10px;
  background: linear-gradient(180deg, #1e293b, #0f172a);
  border: 1px solid rgba(148, 163, 184, 0.2);
  box-shadow: inset 0 -3px 0 rgba(2, 6, 23, 0.8);
  color: #cbd5e1;
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-align: center;
}

.cb-key.is-active {
  color: #eff6ff;
  border-color: rgba(59, 130, 246, 0.55);
  background: linear-gradient(180deg, #2563eb, #1d4ed8);
}

.cb-key.is-blue {
  color: #e0f2fe;
  border-color: rgba(14, 165, 233, 0.48);
}

.cb-key.is-green {
  color: #dcfce7;
  border-color: rgba(34, 197, 94, 0.5);
}

.cb-key.is-space {
  grid-column: span 3;
}

.cb-process-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.cb-process-step {
  display: grid;
  grid-template-columns: 44px 1fr;
  gap: 12px;
  min-height: 118px;
  padding: 15px;
  border-radius: 16px;
  background: rgba(248, 250, 252, 0.96);
  border: 1px solid rgba(226, 232, 240, 0.95);
  box-shadow: 0 18px 44px rgba(2, 6, 23, 0.18);
}

.cb-process-key {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 11px;
  background: linear-gradient(180deg, #0f172a, #1e293b);
  color: #93c5fd;
  font-size: 0.78rem;
  font-weight: 900;
  box-shadow: inset 0 -3px 0 rgba(2, 6, 23, 0.82);
}

.cb-process-step h3 {
  margin: 0 0 5px;
  color: #0f172a;
  font-size: 0.96rem;
  font-weight: 800;
}

.cb-process-step p {
  margin: 0;
  color: #475569;
  font-size: 0.82rem;
  line-height: 1.45;
}

/* SECTION 5: CUIDADO / TICKET */
.cb-cuidado {
  background:
    radial-gradient(circle at 78% 14%, rgba(34, 197, 94, 0.12), transparent 30%),
    linear-gradient(180deg, #0f172a 0%, #111827 100%);
}

.cb-care-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
  gap: 24px;
  align-items: stretch;
  margin-bottom: 24px;
}

.cb-care-main {
  padding: 30px;
  border-radius: 22px;
  background:
    linear-gradient(135deg, rgba(30, 41, 59, 0.86), rgba(15, 23, 42, 0.92));
  border: 1px solid rgba(148, 163, 184, 0.14);
  box-shadow: 0 24px 70px rgba(2, 6, 23, 0.34);
}

.cb-care-main .cb-section-header {
  margin-bottom: 22px;
}

.cb-care-main .cb-eyebrow {
  color: #86efac;
}

.cb-care-main .cb-h2-section {
  color: #f8fafc;
  max-width: 760px;
}

.cb-care-main .cb-desc {
  color: #cbd5e1;
  max-width: 760px;
}

.cb-care-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 16px;
  border-radius: 16px;
  background: rgba(15, 23, 42, 0.72);
  border: 1px solid rgba(34, 197, 94, 0.22);
}

.cb-care-value strong,
.cb-care-value span {
  display: block;
}

.cb-care-value strong {
  color: #dcfce7;
  font-size: 0.9rem;
  margin-bottom: 4px;
}

.cb-care-value span {
  color: #94a3b8;
  font-size: 0.82rem;
  line-height: 1.45;
}

.cb-care-value a {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 0 14px;
  border-radius: 10px;
  background: #16a34a;
  color: #fff;
  font-size: 0.82rem;
  font-weight: 800;
  text-decoration: none;
}

.cb-ticket-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 100%;
  padding: 26px;
  border-radius: 22px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  box-shadow: 0 24px 70px rgba(2, 6, 23, 0.28);
}

.cb-ticket-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  width: fit-content;
  padding: 7px 10px;
  border-radius: 999px;
  background: #e0f2fe;
  color: #0369a1;
  font-size: 0.76rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.cb-ticket-card h3 {
  color: #0f172a;
  font-size: 1.45rem;
  line-height: 1.18;
  font-weight: 900;
  margin: 18px 0 10px;
}

.cb-ticket-card p {
  color: #475569;
  font-size: 0.9rem;
  line-height: 1.55;
  margin: 0 0 16px;
}

.cb-ticket-checks {
  display: grid;
  gap: 8px;
  margin-bottom: 12px;
}

.cb-ticket-checks span {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #334155;
  font-size: 0.84rem;
  font-weight: 700;
}

.cb-ticket-checks i {
  color: #16a34a;
}

.cb-ticket-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  border-radius: 12px;
  background: #0f172a;
  color: #fff;
  font-size: 0.9rem;
  font-weight: 900;
  text-decoration: none;
}

.cb-tips-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}

.cb-tip-card {
  display: grid;
  grid-template-columns: 44px 1fr;
  gap: 12px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 16px;
  padding: 16px;
  transition: all 0.3s;
}

.cb-tip-card:hover {
  border-color: rgba(59, 130, 246, 0.3);
}

.cb-tip-icon {
  width: 44px;
  height: 44px;
  background: rgba(34, 197, 94, 0.14);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #86efac;
  font-size: 1.1rem;
}

.cb-tip-card h3 {
  color: #fff;
  font-weight: 700;
  font-size: 0.94rem;
  margin: 0 0 5px;
}

.cb-tip-card p {
  color: #94a3b8;
  font-size: 0.8rem;
  line-height: 1.45;
  margin: 0;
}

/* SECTION 6: SOBRECALENTAMIENTO */
.cb-attention-panel {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(270px, 0.85fr) minmax(220px, 0.55fr);
  gap: 22px;
  align-items: stretch;
  background: linear-gradient(135deg, #ffffff 0%, #f8fafc 48%, #eff6ff 100%);
  border: 1px solid #e2e8f0;
  border-radius: 24px;
  padding: 28px;
  box-shadow: 0 24px 60px rgba(15, 23, 42, 0.09);
}

.cb-attention-copy h2 {
  color: #0f172a;
}

.cb-attention-copy p {
  color: #475569;
}

.cb-attention-note {
  margin: 14px 0 0;
  color: #2563eb !important;
  font-weight: 700;
  font-size: 0.92rem;
}

.cb-attention-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16px;
}

.cb-heat-factors {
  display: grid;
  gap: 10px;
}

.cb-factor {
  display: flex;
  align-items: center;
  gap: 8px;
