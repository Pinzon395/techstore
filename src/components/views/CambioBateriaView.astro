---
// CambioBateriaView.astro - Premium redesign for laptop battery replacement
const { service, category } = Astro.props;

import FaqSection from '../FaqSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';

const waMessage = encodeURIComponent(`Hola, necesito el servicio de ${service.label} para mi ${category.title}. ¿Me podrían cotizar?`);

// FAQ personalizada para batería
const bateriaFaqs = [
  { question: '¿Cuánto tarda el cambio de batería de laptop en Cancún?', answer: 'Normalmente toma de 24 a 48 horas según el modelo y disponibilidad de la batería. Antes de reemplazarla revisamos ciclos, capacidad real, sistema de carga, cargador y temperatura del equipo.' },
  { question: '¿Cómo sé si mi laptop necesita batería nueva o diagnóstico de carga?', answer: 'Si la laptop no enciende sin cargador, se apaga de golpe, carga intermitente o no detecta batería, puede ser batería, cargador, flex, conector o circuito de carga. Por eso hacemos diagnóstico antes de cambiar piezas.' },
  { question: '¿Qué pasa si la batería está inflada?', answer: 'Una batería inflada debe atenderse de inmediato. Recomendamos apagar el equipo, no cargarlo y traerlo a revisión para evitar presión sobre touchpad, carcasa, pantalla o placa.' },
  { question: '¿El cambio incluye calibración y garantía?', answer: 'Sí. Después del reemplazo revisamos carga, lectura del sistema, estabilidad y calibración inicial. La garantía se entrega por escrito sobre la batería instalada y la mano de obra.' },
  { question: '¿Qué marcas de laptops trabajan?', answer: 'Trabajamos cambio de batería para HP, Dell, Lenovo, Asus, Acer, MSI, Toshiba, Samsung, MacBook Pro y MacBook Air, validando compatibilidad por modelo antes de pedir o instalar la pieza.' }
];

// Síntomas para la sección de diagnóstico visual
const sintomas = [
  { icon: 'fa-battery-empty', title: 'Batería dura poco', desc: 'Se agota en 20 a 30 minutos en lugar de durar horas.' },
  { icon: 'fa-power-off', title: 'Apagados inesperados', desc: 'Se apaga sin aviso cuando está desconectada.' },
  { icon: 'fa-triangle-exclamation', title: 'Batería inflada', desc: 'El equipo se levanta, el touchpad se siente raro o la tapa ya no cierra bien.' },
  { icon: 'fa-plug', title: 'Carga inestable', desc: 'No carga correctamente o se desconecta mientras está cargando.' },
  { icon: 'fa-temperature-high', title: 'Sobrecalentamiento', desc: 'Se calienta más de lo normal al usarla o cargarla.' },
  { icon: 'fa-bolt', title: 'Windows avisa', desc: 'Aparece una alerta recomendando reemplazar la batería.' },
  { icon: 'fa-gauge-high', title: 'Lentitud', desc: 'El equipo baja rendimiento por energía inestable.' }
];

// Proceso / Metodología
const proceso = [
  { step: '01', title: 'Diagnóstico inicial', desc: 'Medimos capacidad real, ciclos y desgaste de la batería actual' },
  { step: '02', title: 'Test de batería', desc: 'Ejecutamos pruebas de carga, descarga y verificación de celdas' },
  { step: '03', title: 'Revisión térmica', desc: 'Verificamos estado del sistema de ventilación y temperatura' },
  { step: '04', title: 'Cotización', desc: 'Te damos opciones de batería original o certificada con precios' },
  { step: '05', title: 'Reemplazo', desc: 'Desarmado profesional, intercambio de batería, conexiones seguras' },
  { step: '06', title: 'Calibración', desc: 'Carga completa, descarga y recarga para optimizar ciclos del SO' },
  { step: '07', title: 'Entrega', desc: 'Pruebas de autonomie y estabilidad antes de entregarte el equipo' }
];

// Tips de cuidado
const tips = [
  { icon: 'fa-percentage', title: 'Carga inteligente', desc: 'Te orientamos para cuidar ciclos y evitar desgaste prematuro después del reemplazo.' },
  { icon: 'fa-temperature-low', title: 'Menos temperatura', desc: 'Revisar ventilación ayuda a que la batería nueva trabaje más fría y estable.' },
  { icon: 'fa-fan', title: 'Limpieza interna', desc: 'Un equipo con buen flujo de aire conserva mejor autonomía y rendimiento diario.' },
  { icon: 'fa-rotate', title: 'Calibración correcta', desc: 'Entregamos la laptop probada para que el sistema lea mejor la nueva batería.' },
  { icon: 'fa-wrench', title: 'Mantenimiento preventivo', desc: 'Aprovecha el servicio para detectar fallas de carga, temperatura o desgaste interno.' },
  { icon: 'fa-plug', title: 'Cargador compatible', desc: 'Validamos voltaje y estabilidad del cargador para proteger batería y tarjeta madre.' }
];

// Marcas
const marcas = ['Dell', 'HP', 'Lenovo', 'Asus', 'Acer', 'Apple', 'Samsung', 'Toshiba', 'MSI', 'Razer'];
---

<div class="cambio-bateria-wrapper theme-premium-dark">
  
  <!-- SECCIÓN 1: HERO PREMIUM -->
  <section class="cb-hero">
    <div class="cb-hero-glow"></div>
    <div class="container cb-hero-container">
      <div class="cb-hero-content">
        <span class="cb-badge"><i class="fa-solid fa-battery-half"></i> Diagnóstico de batería para laptop</span>
        <h1 class="cb-h1">Cambio de batería de laptop en <span class="cb-gradient-text">Cancún</span></h1>
        <h2 class="cb-h2">Recupera la autonomía de tu equipo sin arriesgar tu laptop</h2>
        <p class="cb-intro">Si tu laptop se apaga al desconectarla, dura muy poco, no carga bien o marca batería inflada, revisamos ciclos reales, sistema de carga, adaptador, temperatura y compatibilidad antes de instalar una batería nueva.</p>

        <div class="cb-chips-grid">
          <div class="cb-chip"><i class="fa-solid fa-rotate"></i> Ciclos reales y desgaste</div>
          <div class="cb-chip"><i class="fa-solid fa-plug"></i> Sistema de carga y adaptador</div>
          <div class="cb-chip"><i class="fa-solid fa-temperature-half"></i> Temperatura y ventilación</div>
          <div class="cb-chip"><i class="fa-solid fa-microchip"></i> Compatibilidad exacta por modelo</div>
          <div class="cb-chip cb-chip--green"><i class="fa-solid fa-shield-check"></i> Batería nueva con garantía</div>
        </div>

        <div class="cb-trust-bar">
          <div class="cb-trust-item"><i class="fa-solid fa-star"></i> 5.0 en Google</div>
          <div class="cb-trust-item"><i class="fa-solid fa-shield-halved"></i> Garantía 6 meses</div>
          <div class="cb-trust-item"><i class="fa-solid fa-stopwatch"></i> 24-48 horas</div>
        </div>

        <div class="cb-cta-group">
          <a href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank" class="cb-btn-wa">
            <i class="fa-brands fa-whatsapp"></i> Cotizar batería por WhatsApp
          </a>
          <a href="#proceso" class="cb-btn-secondary">
            Revisar compatibilidad <i class="fa-solid fa-arrow-down"></i>
          </a>
        </div>
        <p class="cb-cta-micro">Envíanos marca, modelo o foto de la etiqueta para confirmar compatibilidad.</p>
      </div>

      <div class="cb-hero-visual">
        <div class="cb-battery-card">
          <div class="cb-bc-top">
            <div class="cb-bc-label">
              <i class="fa-solid fa-clipboard-check"></i>
              <span>Diagnóstico + cambio de batería</span>
            </div>
            <div class="cb-bc-badge-hp">
              <i class="fa-solid fa-bolt"></i> HP · Dell · Mac · Lenovo
            </div>
          </div>

          <div class="cb-bc-health">
            <div class="cb-bc-health-ring">
              <svg viewBox="0 0 80 80" class="cb-ring-svg" aria-hidden="true">
                <circle cx="40" cy="40" r="32" class="cb-ring-bg"/>
                <circle cx="40" cy="40" r="32" class="cb-ring-fill" style="stroke-dasharray: 80 201; stroke-dashoffset: 0;"/>
              </svg>
              <div class="cb-ring-inner">
                <span class="cb-ring-pct">42%</span>
                <small>salud</small>
              </div>
            </div>
            <div class="cb-bc-health-info">
              <div class="cb-bc-status">
                <span class="cb-status-dot is-warn"></span>
                <strong>Batería degradada</strong>
              </div>
              <p>Ciclos agotados  → reemplazo recomendado</p>
              <div class="cb-bc-bar-wrap" aria-label="Nivel de salud 42%">
                <div class="cb-bc-bar"><div class="cb-bc-bar-fill" style="width:42%"></div></div>
              </div>
            </div>
          </div>

          <div class="cb-bc-divider"></div>

          <div class="cb-bc-price-block">
            <span class="cb-bc-price-label">Inversión desde</span>
            <strong class="cb-bc-price">$1,550 MXN</strong>
            <p class="cb-bc-price-note">Precio final según modelo, disponibilidad, tipo de batería y compatibilidad.</p>
          </div>

          <ul class="cb-bc-list">
            <li><i class="fa-solid fa-circle-check"></i> Ciclos reales y desgaste</li>
            <li><i class="fa-solid fa-circle-check"></i> Sistema de carga y adaptador</li>
            <li><i class="fa-solid fa-circle-check"></i> Temperatura y ventilación</li>
            <li><i class="fa-solid fa-circle-check"></i> Compatibilidad exacta por modelo</li>
            <li><i class="fa-solid fa-circle-check"></i> Batería nueva con garantía</li>
          </ul>

          <div class="cb-bc-alert">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>Si tu laptop se apaga al desconectarla o marca batería inflada, conviene revisarla cuanto antes.</span>
          </div>

          <a href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank" class="cb-bc-cta">
            <i class="fa-brands fa-whatsapp"></i> Cotizar mi batería
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 2: DIAGNÓSTICO -->
  <section class="cb-sintomas section-pad">
    <div class="container">
      <div class="cb-diagnostico-layout">

        <!-- Columna izquierda: texto + visual -->
        <div class="cb-diagnostico-copy">
          <span class="cb-eyebrow"><i class="fa-solid fa-stethoscope"></i> Diagnóstico</span>
          <h2 class="cb-h2-section">¿Tu laptop presenta alguno de estos síntomas?</h2>
          <p class="cb-desc">Muchos problemas de autonomía, sobrecalentamiento o apagados repentinos comienzan con una batería degradada, ciclos agotados o un sistema térmico descuidado. Detectar estas señales a tiempo puede evitar daños mayores y mejorar el rendimiento diario del equipo.</p>

          <div class="cb-diagnostico-summary" aria-label="Resumen de diagnóstico">
            <div class="cb-diag-stat">
              <i class="fa-solid fa-rotate"></i>
              <strong>3 pruebas clave</strong>
              <span>Ciclos, carga y temperatura</span>
            </div>
            <div class="cb-diag-stat">
              <i class="fa-solid fa-circle-check"></i>
              <strong>Sin adivinar</strong>
              <span>Primero se confirma la causa</span>
            </div>
          </div>

          <div class="cb-diagnostico-visual" role="img" aria-label="Laptop en revisión de batería, salud estimada 42%">
            <img src="/assets/images/responsive/mantenimiento-macbook-cancun.webp" alt="Técnico revisando laptop para diagnóstico de batería en Cancún" loading="lazy" />
            <div class="cb-diagnostico-overlay">
              <div class="cb-diag-ov-row">
                <i class="fa-solid fa-battery-quarter"></i>
                <span>Batería degradada</span>
              </div>
              <strong class="cb-diag-ov-pct">42%</strong>
              <div class="cb-diag-ov-bar"><div style="width:42%"></div></div>
              <small>salud estimada · revisión recomendada</small>
            </div>
            <div class="cb-diagnostico-alert">
              <i class="fa-solid fa-triangle-exclamation"></i>
              <span>Si la batería está inflada, no la sigas cargando.</span>
            </div>
          </div>
        </div>

        <!-- Columna derecha: grid de síntomas -->
        <div class="cb-sintomas-grid" aria-label="Síntomas frecuentes de batería dañada">
          {sintomas.map((s, i) => (
            <div class={`cb-sintoma-card ${i === 2 ? 'is-urgent' : ''}`}>
              <div class="cb-sintoma-index">{String(i + 1).padStart(2, '0')}</div>
              <div class="cb-sintoma-icon"><i class={`fa-solid ${s.icon}`}></i></div>
              <div class="cb-sintoma-content">
                <h3>{s.title}</h3>
                <p>{s.desc}</p>
              </div>
            </div>
          ))}
          <div class="cb-sintoma-cta">
            <div class="cb-sintoma-cta-text">
              <span>¿Te pasa más de uno?</span>
              <strong>Revisamos batería, cargador y temperatura antes de cotizar.</strong>
            </div>
            <a href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank" class="cb-sintoma-cta-btn">
              <i class="fa-brands fa-whatsapp"></i> Revisar mi laptop
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- SECCIÓN 3: RESULTADOS (SEO local) -->
  <section class="cb-resultados section-pad">
    <div class="container">
      <div class="cb-res-header">
        <span class="cb-eyebrow"><i class="fa-solid fa-chart-line"></i> Resultados</span>
        <h2 class="cb-h2-section">¿Qué mejoras obtienes al cambiar la batería de tu laptop en Cancún?</h2>
        <p class="cb-desc cb-res-desc">Cambiar la batería de una laptop no solo mejora la duración de carga. También ayuda a reducir apagones repentinos, fallas de energía, calentamiento innecesario y pérdida de rendimiento. En Pixon PC revisamos batería, cargador, ciclos, temperatura y compatibilidad antes de instalar una batería nueva.</p>
      </div>

      <div class="cb-res-grid">

        <article class="cb-res-card">
          <div class="cb-res-card-top">
            <div class="cb-res-icon"><i class="fa-solid fa-battery-full"></i></div>
            <span class="cb-res-dato">4-8 horas sin cargar</span>
          </div>
          <h3>Más autonomía real para tu laptop</h3>
          <p>Una batería nueva puede recuperar varias horas de uso sin estar conectada, dependiendo del modelo, consumo y estado general del equipo. Si tu <strong>batería de laptop dura poco en Cancún</strong>, el reemplazo puede ser la solución.</p>
        </article>

        <article class="cb-res-card">
          <div class="cb-res-card-top">
            <div class="cb-res-icon"><i class="fa-solid fa-shield-halved"></i></div>
            <span class="cb-res-dato">Mayor estabilidad</span>
          </div>
          <h3>Menos apagones repentinos</h3>
          <p>Si tu <strong>laptop se apaga al desconectarla</strong> o baja de porcentaje de golpe, el reemplazo puede devolver estabilidad al sistema de energía y eliminar cortes inesperados durante el uso diario.</p>
        </article>

        <article class="cb-res-card">
          <div class="cb-res-card-top">
            <div class="cb-res-icon"><i class="fa-solid fa-gauge-high"></i></div>
            <span class="cb-res-dato">Energía más constante</span>
          </div>
          <h3>Mejor rendimiento del equipo</h3>
          <p>Una batería en mal estado puede afectar el rendimiento cuando el sistema detecta energía inestable o ciclos degradados. El <strong>reemplazo de batería para laptop en Cancún</strong> puede mejorar la velocidad de respuesta del equipo.</p>
        </article>

        <article class="cb-res-card">
          <div class="cb-res-card-top">
            <div class="cb-res-icon"><i class="fa-solid fa-temperature-low"></i></div>
            <span class="cb-res-dato">Menos temperatura</span>
          </div>
          <h3>Menos calor y menor estrés interno</h3>
          <p>Una batería eficiente puede ayudar a reducir temperatura innecesaria y evitar esfuerzo extra sobre componentes internos, prolongando la vida útil del resto del equipo.</p>
        </article>

        <article class="cb-res-card">
          <div class="cb-res-card-top">
            <div class="cb-res-icon"><i class="fa-solid fa-rotate"></i></div>
            <span class="cb-res-dato">Batería nueva</span>
          </div>
          <h3>Ciclos saludables desde el inicio</h3>
          <p>Instalamos batería nueva compatible con tu modelo, validando conector y capacidad para que el equipo trabaje con ciclos correctos desde el primer día. <strong>Cambio de batería de laptop en Cancún</strong> con garantía por escrito.</p>
        </article>

        <article class="cb-res-card">
          <div class="cb-res-card-top">
            <div class="cb-res-icon"><i class="fa-solid fa-plug-circle-check"></i></div>
            <span class="cb-res-dato">Carga segura</span>
          </div>
          <h3>Protección contra fallas de carga</h3>
          <p>Antes de instalar revisamos cargador, centro de carga y sistema de alimentación para evitar que una falla externa dañe la batería nueva. <strong>Servicio técnico de laptops en Cancún</strong> con revisión completa.</p>
        </article>

      </div>

      <div class="cb-res-cta">
        <div class="cb-res-cta-text">
          <strong>¿Quieres saber si tu laptop necesita batería nueva?</strong>
          <p>Envíanos marca, modelo o una foto de la etiqueta y revisamos compatibilidad antes de cotizar.</p>
        </div>
        <a href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank" class="cb-btn-wa">
          <i class="fa-brands fa-whatsapp"></i> Cotizar batería por WhatsApp
        </a>
      </div>

    </div>
  </section>

  <!-- SECCIÓN 4: PROCESO TÉCNICO -->
  <section class="cb-proceso section-pad" id="proceso">
    <div class="container">
      <div class="cb-process-shell">
        <div class="cb-process-copy">
          <span class="cb-eyebrow"><i class="fa-solid fa-keyboard"></i> Proceso técnico</span>
          <h2 class="cb-h2-section">Cambio de batería de laptop con diagnóstico, calibración y pruebas reales</h2>
          <p class="cb-desc">Antes de reemplazar la batería revisamos ciclos, salud energética, cargador, temperatura y compatibilidad exacta del modelo. Así el servicio se hace con datos reales, piezas correctas y garantía por escrito en Cancún.</p>

          <div class="cb-process-tags" aria-label="Puntos clave del proceso">
            <span><i class="fa-solid fa-microchip"></i> Diagnóstico de batería</span>
            <span><i class="fa-solid fa-temperature-half"></i> Revisión térmica</span>
            <span><i class="fa-solid fa-plug-circle-bolt"></i> Sistema de carga</span>
            <span><i class="fa-solid fa-shield-check"></i> Garantía 6 meses</span>
          </div>

          <div class="cb-keyboard-stage" aria-hidden="true">
            <div class="cb-keyboard-screen">
              <span>BATTERY_SERVICE.EXE</span>
              <strong>status: ready</strong>
            </div>
            <div class="cb-keyboard-row">
              <span class="cb-key">ESC</span><span class="cb-key">F1</span><span class="cb-key is-active">DIAG</span><span class="cb-key">TEMP</span><span class="cb-key">LOAD</span>
            </div>
            <div class="cb-keyboard-row">
              <span class="cb-key">CTRL</span><span class="cb-key is-blue">CYCLES</span><span class="cb-key">CELL</span><span class="cb-key is-green">PASS</span>
            </div>
            <div class="cb-keyboard-row">
              <span class="cb-key is-space">CALIBRATION MODE</span><span class="cb-key">ENTER</span>
            </div>
          </div>
        </div>

        <div class="cb-process-grid">
          {proceso.map((p) => (
            <article class="cb-process-step">
              <div class="cb-process-key">{p.step}</div>
              <div>
                <h3>{p.title}</h3>
                <p>{p.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 4.5: TICKET DE SERVICIO -->
  <ServiceTicketSection 
    defaultDevice="Laptop" 
    defaultService="Cambio de batería" 
    title="Crear Ticket de Batería" 
    subtitle="Cuéntanos los síntomas de tu equipo y cotizaremos la batería correcta."
  />

  <!-- SECCIÓN 5: CUIDADO + TICKET -->
  <section class="cb-cuidado section-pad">
    <div class="container">
      <div class="cb-care-layout">
        <div class="cb-care-main">
          <div class="cb-section-header">
            <span class="cb-eyebrow"><i class="fa-solid fa-shield-heart"></i> Protección completa</span>
            <h2 class="cb-h2-section">No solo cambies la batería: deja tu laptop lista para trabajar más tiempo</h2>
            <p class="cb-desc">Una batería nueva rinde mejor cuando el equipo está limpio, ventila bien y usa el cargador correcto. En Pixon PC revisamos el estado general de tu laptop para que el cambio de batería no sea solo una reparación, sino una mejora real de autonomía, temperatura y estabilidad.</p>
          </div>

          <div class="cb-care-value">
            <div>
              <strong>Servicio recomendado</strong>
              <span>Cambio de batería + revisión térmica + prueba de cargador</span>
            </div>
            <a href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank">Cotizar revisión</a>
          </div>
        </div>

        <div class="cb-ticket-card">
          <span class="cb-ticket-label"><i class="fa-solid fa-clipboard-check"></i> Revisión recomendada</span>
          <h3>Agenda revisión antes de que falle más</h3>
          <p>Cuéntanos marca, modelo y síntomas. Con eso revisamos compatibilidad de batería, disponibilidad y el siguiente paso para tu laptop.</p>
          <div class="cb-ticket-checks">
            <span><i class="fa-solid fa-check"></i> Seguimiento del equipo</span>
            <span><i class="fa-solid fa-check"></i> Diagnóstico documentado</span>
            <span><i class="fa-solid fa-check"></i> Cotización clara</span>
          </div>
          <a href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank" class="cb-ticket-btn">
            Cotizar por WhatsApp <i class="fa-brands fa-whatsapp"></i>
          </a>
        </div>
      </div>

      <div class="cb-tips-grid cb-tips-grid--sales">
        {tips.map((t) => (
          <article class="cb-tip-card">
            <div class="cb-tip-icon"><i class={`fa-solid ${t.icon}`}></i></div>
            <div>
              <h3>{t.title}</h3>
              <p>{t.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SECCIÓN 6: SOBRECALENTAMIENTO -->
  <section class="cb-sobrecalentamiento section-pad">
    <div class="container">
      <div class="cb-attention-panel">
        <div class="cb-attention-copy">
          <span class="cb-eyebrow"><i class="fa-solid fa-temperature-high"></i> Attention</span>
          <h2 class="cb-h2-section">El sobrecalentamiento también afecta la batería</h2>
          <p class="cb-desc">El exceso de temperatura acelera el desgaste químico de la batería y puede reducir drásticamente su vida útil. El polvo acumulado, la pasta térmica degradada y una ventilación deficiente generan temperaturas más altas que terminan afectando tanto el rendimiento como la autonomía del equipo.</p>
          <p class="cb-attention-note">En Pixon PC Cancún revisamos batería, ventilación, pasta térmica y sistema de carga antes de recomendar un reemplazo.</p>
        </div>
        <div class="cb-attention-actions">
          <div class="cb-heat-factors">
            <div class="cb-factor"><i class="fa-solid fa-dust"></i><span>Polvo acumulado</span></div>
            <div class="cb-factor"><i class="fa-solid fa-fire"></i><span>Pasta térmica</span></div>
