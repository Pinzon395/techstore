---
import FaqSection from '../FaqSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';

const { service, category } = Astro.props;

const waMessage = encodeURIComponent(
  'Hola, quiero cotizar mantenimiento preventivo de MacBook en Cancún. Necesito una limpieza interna.'
);

const macFaqs = [
  {
    question: '¿Cada cuánto tiempo debe realizarse un mantenimiento preventivo a una MacBook?',
    answer: 'En el clima costero de Cancún, recomendamos realizar una limpieza interna y cambio de compuesto térmico cada **12 a 18 meses**. Si utilizas tu MacBook Pro o Air en exteriores, cerca de ventanas abiertas o para tareas exigentes (edición, renderizado, código), es aconsejable programarlo anualmente.',
  },
  {
    question: '¿Se pierde la información o se borran archivos durante la limpieza?',
    answer: 'No. El mantenimiento físico preventivo consiste en limpiar el polvo, ventiladores, disipador y cambiar la pasta térmica. No modificamos ni tocamos el almacenamiento SSD ni el sistema macOS. De igual forma, como medida de seguridad informática estándar, siempre sugerimos tener una copia en Time Machine.',
  },
  {
    question: '¿Qué incluye la optimización del sistema macOS?',
    answer: 'Revisamos ítems de inicio innecesarios, eliminamos archivos temporales caché del sistema, auditamos la salud de la batería y validamos que no existan procesos en segundo plano consumiendo procesador (CPU) de forma anormal.',
  },
  {
    question: '¿Qué modelos de MacBook atienden en Cancún?',
    answer: 'Atendemos toda la gama de Apple: MacBook Air y MacBook Pro con procesadores Intel y chips Apple Silicon (M1, M2, M3 en todas sus variantes Max, Pro y estándar). También damos mantenimiento preventivo a iMac y Mac mini.',
  },
  {
    question: '¿El mantenimiento preventivo de MacBook incluye garantía?',
    answer: 'Al tratarse de un servicio de limpieza y optimización térmica preventiva (y no un reemplazo de partes dañadas), garantizamos la correcta aplicación del compuesto térmico premium, el ensamble seguro bajo especificaciones de torque de Apple y que tu equipo se entrega frío y silencioso. No aplica garantía sobre componentes de hardware preexistentes.',
  },
];

const macSymptoms = [
  {
    icon: 'fa-fan',
    title: 'Ventilador ruidoso o acelerado',
    desc: 'El ventilador gira al máximo constantemente, incluso al abrir tareas sencillas como el navegador o documentos de texto.',
  },
  {
    icon: 'fa-temperature-arrow-up',
    title: 'Sobrecalentamiento en la base',
    desc: 'La carcasa de aluminio de tu MacBook se siente sumamente caliente al tacto, sobre todo cerca de la bisagra y el teclado.',
  },
  {
    icon: 'fa-gauge-high',
    title: 'MacBook lenta o congelada',
    desc: 'Aparición constante del cursor de espera de colores (beach ball). El sistema reduce su velocidad para autoprotegerse del calor.',
  },
  {
    icon: 'fa-battery-quarter',
    title: 'Descarga rápida de batería',
    desc: 'Las altas temperaturas internas aceleran la degradación de la batería y elevan el consumo eléctrico de los ventiladores.',
  },
];

const macSteps = [
  {
    num: '01',
    title: 'Diagnóstico de entrada y pruebas térmicas',
    desc: 'Medimos temperaturas en reposo y bajo estrés, auditamos la velocidad de los ventiladores y revisamos la salud general de la batería.',
  },
  {
    num: '02',
    title: 'Desarmado seguro con herramienta pentalobe',
    desc: 'Abrimos la MacBook utilizando destornilladores específicos para tornillos de seguridad Apple, cuidando de no dañar roscas ni el chasis.',
  },
  {
    num: '03',
    title: 'Limpieza interna de ventiladores y disipación',
    desc: 'Removemos el polvo acumulado en las aspas, limpiamos los conductos del disipador de cobre y soplamos la placa lógica con aire controlado.',
  },
  {
    num: '04',
    title: 'Cambio de pasta térmica premium',
    desc: 'Limpiamos los residuos secos del procesador Intel o Apple Silicon y aplicamos compuesto de alta conductividad (Arctic MX-4 o similar).',
  },
  {
    num: '05',
    title: 'Optimización de macOS y pruebas finales',
    desc: 'Revisamos procesos de inicio, eliminamos caché obsoleta y realizamos pruebas de estrés para confirmar que la Mac trabaje silenciosa y fría.',
  },
];
---

<div class="mac-preventive-page">
  <!-- HERO SECTION -->
  <section class="mpm-hero">
    <div class="mpm-hero-glow"></div>
    <div class="container mpm-hero-grid">
      <div class="mpm-hero-copy">
        <span class="mpm-kicker"><i class="fa-brands fa-apple"></i> Servicio Apple en Cancún</span>
        <h1>Mantenimiento Preventivo MacBook en Cancún | Limpieza, Optimización y Diagnóstico Profesional</h1>
        <h2>Mantén tu MacBook Air o MacBook Pro fría, rápida y libre de polvo o salitre costero.</h2>
        <p>
          Si buscas un **servicio macbook cancún** confiable, te ayudamos a proteger tu inversión. El polvo fino,
          la humedad y el salitre del Caribe se acumulan en el ventilador de tu Mac, provocando lentitud y fallas costosas.
          Nuestro servicio especializado de **mantenimiento preventivo macbook cancún** optimiza el sistema y reduce las temperaturas de inmediato.
        </p>
        <div class="mpm-badges">
          <span>Limpieza interna macbook</span>
          <span>MacBook Air y Pro</span>
          <span>Cambio de pasta térmica</span>
          <span>Optimización macOS</span>
          <span>Taller local Cancún</span>
        </div>
        <div class="mpm-actions">
          <a class="mpm-primary" href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank">
            <i class="fa-brands fa-whatsapp"></i> Cotizar mantenimiento preventivo
          </a>
          <a class="mpm-secondary" href="#que-incluye">Ver qué incluye el servicio</a>
        </div>
      </div>

      <aside class="mpm-hero-panel">
        <div class="mpm-visual-img" aria-hidden="true">
          <img src="/assets/images/mantenimiento-macbook-cancun.webp" alt="Mantenimiento preventivo MacBook en taller local Cancún" class="mpm-img-hero" />
          <div class="mpm-img-overlay"></div>
        </div>
        <div class="mpm-panel-info">
          <span>Optimización y limpieza</span>
          <strong>{service.fromPrice || 'Desde $750 MXN'}</strong>
          <small>Evita daños severos en placa lógica aplicando mantenimiento preventivo anual.</small>
        </div>
        <ul class="mpm-features-list">
          <li><i class="fa-solid fa-circle-check"></i> Técnicos Apple certificados</li>
          <li><i class="fa-solid fa-circle-check"></i> Herramientas e insumos premium de ensamble</li>
          <li><i class="fa-solid fa-circle-check"></i> Fotos reales del estado interno de tu Mac</li>
          <li><i class="fa-solid fa-circle-check"></i> Soporte técnico personalizado en Cancún</li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- SECCIÓN 1: QUÉ INCLUYE Y BENEFICIOS -->
  <section class="mpm-section mpm-light-bg" id="que-incluye">
    <div class="container">
      <div class="mpm-split-grid">
        <div class="mpm-split-text">
          <span class="mpm-eyebrow">Detalles del servicio</span>
          <h2>¿Qué Incluye Nuestro Servicio de Mantenimiento Preventivo para MacBook en Cancún?</h2>
          <p class="mpm-large-text">
            Si buscas un **técnico macbook cancún** experimentado, en Pixon nos tomamos en serio tu Mac. Nuestro
            mantenimiento preventivo no es una limpieza superficial con aire; es un proceso minucioso de restauración térmica.
          </p>
          <p>
            El servicio incluye la apertura del chasis con destornilladores pentalobe adecuados, la remoción completa de polvo y pelusas
            en las aspas de los ventiladores, limpieza ultrasónica ligera en conectores expuestos a la humedad para remover salitre,
            y el **cambio pasta térmica macbook cancún** utilizando compuestos de alto rendimiento que duran años.
          </p>
        </div>
        <div class="mpm-split-text">
          <span class="mpm-eyebrow">Prevención activa</span>
          <h2>Beneficios de Realizar Mantenimiento Preventivo a Tu MacBook a Tiempo</h2>
          <p class="mpm-large-text">
            El calor ambiente y la humedad costera disminuyen drásticamente la vida útil de los circuitos integrados de Apple.
            Un mantenimiento regular reduce la temperatura interna hasta en 20°C bajo carga de trabajo.
          </p>
          <p>
            Realizar este servicio evita la degradación acelerada de la batería (que suele inflarse por calor extremo), reduce el estrés térmico
            en el procesador y chip gráfico, elimina molestos ruidos del ventilador y previene reparaciones complejas de microelectrónica en placa base.
            Es la forma más inteligente de prolongar la vida útil de tu inversión.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 2: AIR/PRO Y SOBRECALENTAMIENTO -->
  <section class="mpm-section mpm-dark-bg">
    <div class="container">
      <div class="mpm-split-grid">
        <div class="mpm-split-card">
          <div class="card-image-wrapper" aria-hidden="true">
            <img src="/assets/images/reparacion-mac-cancun.webp" alt="Limpieza interna MacBook Pro y Air en Cancún" class="card-inline-image" />
          </div>
          <div>
            <span class="mpm-eyebrow">Modelos Air y Pro</span>
            <h2>Limpieza Interna Profesional para MacBook Air y MacBook Pro</h2>
            <p class="mpm-large-text">
              Cada modelo de portátil Apple requiere un enfoque técnico distinto. El **mantenimiento macbook pro cancún** se enfoca
              en sistemas de doble ventilación de alta densidad, donde el polvo obstruye fácilmente las pequeñas ranuras de salida de aire.
              En cambio, el **mantenimiento macbook air cancún** (especialmente los modelos Apple Silicon sin ventilador) depende de
              disipadores pasivos de aluminio que requieren un contacto térmico óptimo con la carcasa.
            </p>
            <p>
              Ya sea que uses una MacBook Pro de 16" para edición de video o una MacBook Air M1 para estudio, limpiamos a fondo la acumulación
              de suciedad en la placa lógica y aseguramos que el sistema térmico disipe el calor tal como fue diseñado.
            </p>
          </div>
        </div>

        <div class="mpm-split-card">
          <div class="card-image-wrapper" aria-hidden="true">
            <img src="/assets/images/mantenimiento-macbook-cancun.webp" alt="Solución de sobrecalentamiento en MacBook Cancún" class="card-inline-image" />
          </div>
          <div>
            <span class="mpm-eyebrow">Control térmico</span>
            <h2>Solución de Sobrecalentamiento y Alto Consumo de Recursos en MacBook</h2>
            <p class="mpm-large-text">
              ¿Tu Mac se traba o tarda en responder? Si notas tu **macbook lenta solución cancún** es realizar una auditoría térmica.
              Cuando el disipador se satura, macOS reduce dinámicamente la velocidad del procesador (thermal throttling) para evitar
              daños físicos. Esto se traduce en congelamientos, la famosa "pelota de playa" de colores y lentitud extrema.
            </p>
            <p>
              Nuestro servicio realiza un **diagnóstico macbook cancún** completo para separar las fallas lógicas de las físicas.
              Solucionamos los cuellos de botella de temperatura para que el procesador pueda trabajar a su máxima frecuencia sin calentarse
              ni consumir recursos de manera excesiva.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 3: PASTA TÉRMICA Y OPTIMIZACIÓN -->
  <section class="mpm-section">
    <div class="container">
      <div class="mpm-split-grid">
        <div class="mpm-split-text">
          <span class="mpm-eyebrow">Compuesto térmico</span>
          <h2>Cambio de Pasta Térmica y Optimización del Sistema macOS</h2>
          <p class="mpm-large-text">
            La pasta térmica que Apple coloca de fábrica suele secarse y perder sus propiedades disipadoras después de 2 años de uso continuo.
            Esto bloquea la transferencia de calor del procesador al disipador. Nuestro servicio incluye el reemplazo por compuestos térmicos
            de alta gama (como Arctic MX-4 o Kryonaut) que garantizan conductividad térmica superior.
          </p>
          <p>
            Complementamos el servicio de limpieza con una **optimización macbook cancún** a nivel de software. Limpiamos archivos temporales caché,
            desactivamos programas innecesarios en el inicio del sistema y auditamos el comportamiento de macOS para liberar memoria RAM y
            reducir el consumo general de batería.
          </p>
        </div>
        <div class="mpm-split-text">
          <span class="mpm-eyebrow">iMac y Mac mini</span>
          <h2>Mantenimiento para MacBook Air, MacBook Pro e iMac en Cancún</h2>
          <p class="mpm-large-text">
            No solo atendemos portátiles Apple. Los equipos de escritorio como la iMac y la Mac mini también sufren por el calor de Cancún.
            La iMac aspira aire desde la parte inferior y acumula cantidades masivas de polvo detrás de la pantalla, dañando con frecuencia
            los discos mecánicos, la fuente de poder interna y acelerando el ventilador principal.
          </p>
          <p>
            Ofrecemos un **mantenimiento macbook cancún** y soporte integral de escritorio. Desarmamos de forma segura tu iMac (despegando la pantalla
            con herramientas especiales y volviendo a sellarla con adhesivos premium originales de Apple) o abrimos tu Mac mini para garantizar
            que sigan operando de manera silenciosa en tu oficina o negocio.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SEÑALES DE ALERTA -->
  <section class="mpm-section mpm-dark-bg">
    <div class="container">
      <div class="mpm-head-center">
        <span class="mpm-eyebrow">¿Tu Mac te avisa?</span>
        <h2>Señales de que Tu MacBook Necesita Mantenimiento Preventivo</h2>
        <p class="mpm-center-desc">
          Tu equipo Apple suele mostrar ciertos síntomas cuando el sistema de disipación interna está saturado o la pasta térmica ha caducado.
          Presta atención a las siguientes alertas antes de que se convierta en una **reparación macbook cancún** de placa lógica.
        </p>
      </div>

      <div class="mpm-symptom-grid">
        {macSymptoms.map((symptom) => (
          <article class="mpm-symptom-card">
            <i class={`fa-solid ${symptom.icon}`}></i>
            <h3>{symptom.title}</h3>
            <p>{symptom.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESO TÉCNICO -->
  <section class="mpm-section mpm-process">
    <div class="container">
      <div class="mpm-head-center">
        <span class="mpm-eyebrow">Nuestro Método Técnico</span>
        <h2>¿Cómo realizamos el mantenimiento preventivo de MacBook?</h2>
        <p class="mpm-center-desc">
          En Pixon seguimos protocolos estrictos de calidad Apple para asegurar que tu MacBook sea tratada con la máxima delicadeza y seguridad.
        </p>
      </div>

      <div class="mpm-process-timeline">
        {macSteps.map((step) => (
          <div class="mpm-timeline-item">
            <span class="mpm-timeline-number">{step.num}</span>
            <div class="mpm-timeline-content">
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LLAMADO A LA ACCIÓN (CTA) -->
  <section class="mpm-section mpm-light-bg mpm-cta-section">
    <div class="container mpm-cta-layout">
      <div class="mpm-cta-text">
        <span class="mpm-eyebrow">Rendimiento óptimo</span>
        <h2>Recupera el Rendimiento Original de Tu MacBook</h2>
        <p>
          No dejes que el polvo y el salitre de Quintana Roo acaben con tu herramienta de trabajo o estudio.
          Un servicio oportuno de **limpieza interna macbook cancún** o **limpieza ventiladores macbook cancún** cuesta una fracción
          de lo que costaría reparar un cortocircuito en placa lógica o reemplazar una batería inflada.
        </p>
        <p>
          Visítanos en nuestro taller físico o agenda tu cita por WhatsApp. Te entregamos un reporte detallado con fotos
          del estado interno antes y después del servicio.
        </p>
        <a class="mpm-primary" href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank">
          <i class="fa-brands fa-whatsapp"></i> Agendar Limpieza de MacBook
        </a>
      </div>
      <div class="mpm-cta-badges">
        <div class="cta-badge"><i class="fa-solid fa-wind"></i> Sin ruidos de turbina</div>
        <div class="cta-badge"><i class="fa-solid fa-temperature-arrow-down"></i> Temperaturas bajo control</div>
        <div class="cta-badge"><i class="fa-solid fa-bolt"></i> Rendimiento estable</div>
        <div class="cta-badge"><i class="fa-solid fa-database"></i> Datos 100% protegidos</div>
      </div>
    </div>
  </section>

  <!-- RELATED SERVICES -->
  <RelatedServicesSection
    category={category}
    service={service}
    title="Servicios relacionados para Mac"
    eyebrow="Más servicios técnicos"
    includeCategoryServices={true}
    initialLimit={8}
  />

  <!-- PREGUNTAS FRECUENTES -->
  <FaqSection
    id="faq"
    title="Preguntas Frecuentes Sobre Mantenimiento de MacBook en Cancún"
    description="Resolvemos tus dudas sobre el servicio de limpieza, optimización térmica, pasta térmica, macOS y modelos Apple compatibles en Cancún."
    items={macFaqs}
    ariaLabel="Preguntas frecuentes sobre mantenimiento de MacBook en Cancún"
    viewMoreHref="/preguntas-frecuentes"
    viewMoreLabel="Ver más preguntas frecuentes"
    sectionClass="faq-section"
    gridClass="faq-grid"
    backgroundColor="#F8FAFC"
    questionColor="#0F2A4A"
    itemGap="8px"
    questionPadding="16px 18px"
  />

  <!-- COMENTARIOS Y CONTACTO -->
  <CommentsSection dark={true} viewMoreHref="/comentarios" viewMoreLabel="Ver todas las reseñas" id="comentarios" />
  <ContactSection id="ubicacion" />
</div>

<style is:global>
  .mac-preventive-page {
    background: #0b1120;
    color: #e2e8f0;
    font-family: 'Inter', sans-serif;
  }

  .mpm-hero {
    position: relative;
    overflow: hidden;
    padding: 40px 0 50px;
    background:
      radial-gradient(circle at 10% 20%, rgba(13, 148, 136, 0.15), transparent 30%),
      radial-gradient(circle at 90% 20%, rgba(30, 58, 95, 0.15), transparent 30%),
      linear-gradient(135deg, #070e1a 0%, #0b1120 50%, #0c233a 100%);
  }

  .mpm-hero-glow {
    position: absolute;
    bottom: -150px;
    right: -100px;
    width: 450px;
    height: 450px;
    border-radius: 999px;
    background: rgba(13, 148, 136, 0.12);
    filter: blur(40px);
    pointer-events: none;
  }

  .mpm-hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
    gap: 32px;
    align-items: center;
  }

  .mpm-kicker,
  .mpm-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #2dd4bf;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mpm-hero h1 {
    margin: 12px 0;
    color: #ffffff;
    font-family: 'Kanit', sans-serif;
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    line-height: 1.08;
    font-weight: 700;
  }

  .mpm-hero h2 {
    margin: 0 0 16px;
    color: #a7f3d0;
    font-family: 'Kanit', sans-serif;
    font-size: clamp(1.1rem, 2.2vw, 1.6rem);
    line-height: 1.25;
    font-weight: 400;
  }

  .mpm-hero p {
    margin: 0 0 20px;
    color: #cbd5e1;
    line-height: 1.65;
    font-weight: 400;
    font-size: 1.05rem;
  }

  .mpm-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0;
  }

  .mpm-badges span {
    color: #e2f9f5;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(45, 212, 191, 0.2);
    border-radius: 999px;
    padding: 6px 12px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .mpm-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }

  .mpm-primary,
  .mpm-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border-radius: 12px;
    padding: 14px 20px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .mpm-primary {
    color: #ffffff !important;
    background: #0d9488;
    box-shadow: 0 10px 25px rgba(13, 148, 136, 0.3);
  }

  .mpm-primary:hover {
    background: #0f766e;
    transform: translateY(-2px);
  }

  .mpm-secondary {
    color: #99f6e4 !important;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.05);
  }

  .mpm-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .mpm-hero-panel {
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(148, 163, 184, 0.15);
    border-radius: 24px;
    padding: 20px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
  }

  .mpm-visual-img {
    position: relative;
    min-height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 18px;
    background: #0f172a;
    border: 1px solid rgba(45, 212, 191, 0.15);
  }

  .mpm-img-hero {
    width: 100%;
    height: 180px;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .mpm-hero-panel:hover .mpm-img-hero {
    transform: scale(1.05);
  }

  .mpm-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.8) 0%, transparent 60%);
    pointer-events: none;
  }

  .mpm-panel-info {
    display: grid;
    gap: 4px;
    margin: 16px 0;
  }

  .mpm-panel-info span {
    color: #2dd4bf;
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
  }

  .mpm-panel-info strong {
    color: #a7f3d0;
    font-family: 'Kanit', sans-serif;
    font-size: 1.95rem;
    line-height: 1;
  }

  .mpm-panel-info small {
    color: #94a3b8;
    line-height: 1.4;
    font-size: 0.82rem;
  }

  .mpm-features-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  .mpm-features-list li {
    color: #cbd5e1;
    display: flex;
    align-items: center;
    gap: 8px;
