---
import FaqSection from '../FaqSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import Footer from '../Footer.astro';

const { service, category } = Astro.props;
const waMessage = encodeURIComponent('Hola Pixon PC, necesito WiFi empresarial en Cancún. La red va lenta, se cae o la impresora no aparece.');

const issues = [
  ['WiFi lento', 'La red se satura y deja de rendir en horas de trabajo.'],
  ['Cobertura débil', 'Hay áreas donde la señal llega, pero no sostiene conexión.'],
  ['Impresora de red', 'El equipo imprime en un puesto y en otro no aparece.'],
  ['Switch o cableado', 'Un solo punto de falla tumba varias áreas.'],
];

const actions = [
  ['Levantamiento', 'Ubicamos qué equipo, área o punto de acceso está afectando el trabajo.'],
  ['Pruebas', 'Medimos cobertura, saturación, IP, cableado y red compartida.'],
  ['Ajuste', 'Corregimos configuración o reemplazamos el punto que falla.'],
  ['Validación', 'Probamos impresión, navegación y acceso compartido antes de cerrar.'],
];

const zones = ['Cancún Centro', 'Bonampak', 'Av. Tulum', 'Puerto Cancún', 'Cumbres', 'Huayacán', 'Polígono Sur', 'Supermanzanas'];

const faqs = [
  { question: '¿Por qué el WiFi de oficina se siente lento?', answer: 'Suele ser por saturación, mala ubicación del router, interferencia, demasiados equipos o una configuración que no coincide con el tamaño real de la red.' },
  { question: '¿También revisan impresoras de red?', answer: 'Sí. Revisamos IP, driver, cola de impresión, permisos y conexión para que pueda imprimir desde varios equipos.' },
  { question: '¿Pueden separar red de trabajo e invitados?', answer: 'Sí. Esa separación mejora la estabilidad y evita que el tráfico de invitados afecte la operación interna.' },
  { question: '¿Atienden oficinas con varios equipos?', answer: 'Sí. Podemos revisar una oficina completa o atender por lote según prioridad y carga de trabajo.' },
  { question: '¿Hacen diagnóstico antes de cambiar equipo?', answer: 'Sí. Primero confirmamos si la falla es cobertura, configuración, cableado o hardware antes de recomendar compras.' },
];

const relatedItems = [
  {
    href: '/servicios/b2b/soporte-oficinas',
    icon: 'fa-building-shield',
    label: 'Soporte TI para oficinas',
    desc: 'Ideal si además de red tienes PCs lentas, impresoras o problemas de Windows.',
    cta: 'Ver servicio →',
  },
  {
    href: '/servicios/b2b/soporte-restaurantes',
    icon: 'fa-utensils',
    label: 'Soporte TI para restaurantes',
    desc: 'Útil para caja, comandas, impresoras y red operativa de alto movimiento.',
    cta: 'Ver servicio →',
  },
  {
    href: '/servicios/b2b/soporte-hoteles',
    icon: 'fa-hotel',
    label: 'Soporte TI para hoteles',
    desc: 'Para recepción, reservas, WiFi de huéspedes, impresoras y operación continua.',
    cta: 'Ver servicio →',
  },
  {
    href: '/servicios/b2b/polizas-mantenimiento',
    icon: 'fa-clipboard-list',
    label: 'Pólizas de mantenimiento TI',
    desc: 'Si quieres visitas programadas, tickets y seguimiento mensual de equipos.',
    cta: 'Ver servicio →',
  },
];
---

<div class="wifi-page">
  <section class="wifi-hero">
    <div class="container wifi-hero-grid">
      <div class="wifi-head">
        <span class="wifi-kicker"><i class="fa-solid fa-wifi"></i> Servicio técnico local en Cancún</span>
        <h1>WiFi empresarial en Cancún para oficinas, cobertura estable y red ordenada</h1>
      </div>

      <aside class="wifi-collage">
        <div class="wifi-side-card">
          <span class="wifi-side-label">Red empresarial</span>
          <h3>Señal, impresión y acceso compartido</h3>
          <ul>
            <li><i class="fa-solid fa-circle-check"></i> Router, switches y APs</li>
            <li><i class="fa-solid fa-circle-check"></i> IP, DNS y permisos</li>
            <li><i class="fa-solid fa-circle-check"></i> Impresoras de red</li>
          </ul>
        </div>
        <img src="/assets/images/soporte-hoteles-hero.webp" alt="WiFi empresarial y soporte de red en Cancún" class="wifi-main" loading="eager" fetchpriority="high" decoding="async" />
        <img src="/assets/images/reparacion-impresoras-cancun.webp" alt="Impresora conectada a red empresarial en Cancún" class="wifi-top" loading="lazy" decoding="async" />
        <img src="/assets/images/mantenimiento-pc-escritorio.webp" alt="Computadoras de oficina conectadas a red empresarial" class="wifi-bottom" loading="lazy" decoding="async" />
        <div class="wifi-hero-note">
          <strong>{service.fromPrice || 'Cotización según alcance'}</strong>
          <span>{service.eta || 'Respuesta según prioridad'}</span>
        </div>
      </aside>

      <div class="wifi-body">
        <p class="wifi-lead">Si la red se cae, la impresora no aparece o el internet no alcanza para el ritmo de la oficina, revisamos la causa y te damos una corrección concreta.</p>
        <div class="wifi-actions">
          <a class="wifi-btn wifi-btn--primary" href="#ticket-wifi-empresarial"><i class="fa-solid fa-ticket"></i> Crear ticket</a>
          <a class="wifi-btn wifi-btn--secondary" href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp"></i> Solicitar revisión</a>
        </div>
        <div class="wifi-pills">
          <span>Red operativa</span>
          <span>Cobertura real</span>
          <span>Impresoras y equipos compartidos</span>
        </div>
        <div class="wifi-metrics">
          <div><strong>01</strong><span>Diagnóstico de red</span></div>
          <div><strong>02</strong><span>Corrección por área</span></div>
          <div><strong>03</strong><span>Prueba de estabilidad</span></div>
        </div>
        <p class="wifi-alert">Si la red de invitados y la de trabajo están mezcladas, el problema casi siempre vuelve. Primero ordenamos la base.</p>
      </div>
    </div>
  </section>

  <section class="wifi-section">
    <div class="container wifi-split">
      <div class="wifi-copy-block">
        <span class="wifi-eyebrow">Qué falla</span>
        <h2>Los problemas de red que sí detienen el trabajo</h2>
        <p>Normalmente no es “solo internet”. La falla suele estar en la cobertura, la saturación, el punto de acceso, la impresora de red o un switch que ya no sostiene la carga.</p>
      </div>
      <div class="wifi-issues">
        {issues.map(([title, text]) => (
          <article>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="wifi-section wifi-section--band">
    <div class="container wifi-band">
      <figure>
        <img src="/assets/images/optimizacion-pc-cancun.webp" alt="Optimización de equipo de oficina sobre red empresarial en Cancún" loading="lazy" decoding="async" />
      </figure>
      <div>
        <span class="wifi-eyebrow">Qué hacemos</span>
        <h2>Una red empresarial útil se nota en la operación, no en el discurso</h2>
        <h3>Red interna estable</h3>
        <p>Revisamos router, switches, APs, cableado e interferencias para que la red aguante horarios de trabajo.</p>
        <h3>Acceso ordenado</h3>
        <p>Configuramos IP, permisos y segmentación para que la red de trabajo no compita con invitados o usos secundarios.</p>
        <h3>Impresoras y recursos compartidos</h3>
        <p>Corregimos drivers, IP y colas para que la impresora no desaparezca de un equipo a otro.</p>
      </div>
    </div>
  </section>

  <section class="wifi-section">
    <div class="container">
      <div class="wifi-head">
        <span class="wifi-eyebrow">Proceso corto</span>
        <h2>Cómo resolvemos la red sin vueltas</h2>
      </div>
      <div class="wifi-actions-grid">
        {actions.map(([title, text], index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="wifi-section wifi-section--band">
    <div class="container wifi-gallery">
      <figure><img src="/assets/images/reparacion-impresoras-cancun.webp" alt="Impresora de red lista para oficina en Cancún" loading="lazy" decoding="async" /></figure>
      <figure><img src="/assets/images/laptop-feliz-limpia.webp" alt="Laptop de oficina con conexión estable y optimizada en Cancún" loading="lazy" decoding="async" /></figure>
      <figure><img src="/assets/images/formateo-windows-cancun.webp" alt="Equipo de oficina funcionando con red y Windows ajustado en Cancún" loading="lazy" decoding="async" /></figure>
    </div>
  </section>

  <section class="wifi-section">
    <div class="container wifi-split wifi-split--reverse">
      <div>
        <span class="wifi-eyebrow">Cobertura</span>
        <h2>Atención para negocios en zonas clave de Cancún</h2>
        <p>La cobertura se planea según el negocio, pero atendemos con frecuencia oficinas y locales en Cancún Centro, Bonampak, Av. Tulum, Puerto Cancún, Cumbres, Huayacán y Polígono Sur.</p>
      </div>
      <div class="wifi-zone-panel">
        <img src="/assets/images/soporte-hoteles-hero.webp" alt="Red empresarial y puntos de acceso en Cancún" loading="lazy" decoding="async" />
        <ul>{zones.map((zone) => <li><i class="fa-solid fa-map-pin"></i> {zone}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="wifi-section">
    <div class="container wifi-copy-block wifi-copy-block--narrow">
      <span class="wifi-eyebrow">SEO local</span>
      <h2>WiFi empresarial en Cancún con intención real de servicio</h2>
      <p>Este servicio está pensado para resolver red lenta, cobertura débil, impresoras de red y equipos compartidos. Si la solución correcta es cambiar configuración, reordenar puntos de acceso o ajustar la segmentación, te lo decimos directo.</p>
    </div>
  </section>

  <ServiceTicketSection id="ticket-wifi-empresarial" sourcePage={Astro.url.pathname} defaultDevice="Equipo empresarial / B2B" defaultService={service.label} title="Crear ticket de WiFi empresarial" subtitle="Cuéntanos qué área falla, cuántos equipos tienes y qué síntoma ves en la red." />
  <RelatedServicesSection items={relatedItems} light={true} title="Servicios relacionados para red" eyebrow="Más soluciones B2B" />
  <FaqSection id="faq-wifi-empresarial" title="Preguntas frecuentes sobre WiFi empresarial" description="Aquí respondemos lo básico antes de intervenir: por qué falla la red, qué revisamos y cuándo conviene ajustar configuración o hardware." items={faqs} sectionClass="wifi-faq" titleColor="#ffffff" descriptionColor="#e2e8f0" questionColor="#071F3A" />
  <CommentsSection id="comentarios-wifi-empresarial" title="Comentarios de clientes" description="Comparte tu experiencia con la red empresarial." dark={false} />
  <ContactSection id="contacto-wifi-empresarial" />
  <Footer />
</div>

<style>
  .wifi-page, .wifi-page h1, .wifi-page h2, .wifi-page h3, .wifi-page p, .wifi-page li, .wifi-page span, .wifi-page strong, .wifi-page figcaption { color:#071F3A; }
  .wifi-hero{background:linear-gradient(135deg,#061429 0%,#0b2a4a 100%);padding:72px 0 58px;color:#fff}
  .wifi-hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.95fr);grid-template-areas:"head visual" "body visual";gap:32px;align-items:center}
  .wifi-head{grid-area:head;min-width:0}
  .wifi-collage{grid-area:visual}
  .wifi-body{grid-area:body;min-width:0}
  .wifi-kicker,.wifi-eyebrow{color:#7dd3fc;font-weight:800;text-transform:uppercase;letter-spacing:.04em}
  .wifi-hero h1{font-family:'Kanit',sans-serif;font-size:clamp(2rem,3.2vw,3.25rem);line-height:1.08;margin:14px 0;max-width:13ch;color:#fff}
  .wifi-lead{color:#e2e8f0;max-width:56ch;line-height:1.65}
  .wifi-actions{display:flex;gap:12px;flex-wrap:wrap;margin:20px 0}
  .wifi-btn{display:inline-flex;gap:10px;align-items:center;padding:13px 18px;border-radius:12px;text-decoration:none;font-weight:800}
  .wifi-btn--primary{background:#f59e0b;color:#0f172a}
  .wifi-btn--secondary{border:1px solid rgba(255,255,255,.18);color:#fff;background:rgba(255,255,255,.05)}
  .wifi-pills{display:flex;gap:10px;flex-wrap:wrap}
  .wifi-pills span{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);color:#e2e8f0;padding:10px 12px;border-radius:999px}
  .wifi-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:18px}
  .wifi-metrics div{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:12px}
  .wifi-metrics strong{display:block;color:#fff;font-size:1.15rem;margin-bottom:4px}
  .wifi-metrics span{color:#cbd5e1;font-size:.92rem;line-height:1.3}
  .wifi-alert{margin-top:16px;max-width:56ch;color:#dbeafe;line-height:1.55}
  .wifi-collage{position:relative;min-height:440px}
  .wifi-collage img{position:absolute;display:block;border-radius:18px;object-fit:cover;box-shadow:0 24px 60px rgba(0,0,0,.28)}
  .wifi-side-card{position:absolute;left:0;top:0;z-index:3;background:rgba(255,255,255,.96);border-radius:18px;padding:16px 18px;box-shadow:0 18px 42px rgba(0,0,0,.2);max-width:260px}
  .wifi-side-label{display:block;color:#1d4ed8;font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px}
  .wifi-side-card h3{color:#071F3A;font-size:1.05rem;line-height:1.2;margin:0 0 10px}
  .wifi-side-card ul{list-style:none;padding:0;margin:0;display:grid;gap:8px}
  .wifi-side-card li{display:flex;gap:8px;align-items:flex-start;color:#071F3A;font-size:.92rem;line-height:1.35}
  .wifi-side-card i{color:#1d4ed8;margin-top:2px;flex:0 0 auto}
  .wifi-main{inset:0;width:68%;height:100%}
  .wifi-top{right:0;top:0;width:44%;height:46%}
  .wifi-bottom{right:0;bottom:0;width:44%;height:46%}
  .wifi-hero-note{position:absolute;left:24px;bottom:24px;background:rgba(255,255,255,.95);border-radius:16px;padding:14px 16px;box-shadow:0 16px 40px rgba(0,0,0,.18);display:flex;flex-direction:column;gap:2px}
  .wifi-section{padding:64px 0}
  .wifi-section--band{background:#f8fbff}
  .wifi-faq{background:#071f3a}
  .wifi-page .wifi-faq .section-title h2,
  .wifi-page .wifi-faq .section-title p{color:#fff !important}
  .wifi-page .wifi-faq .faq-item,
  .wifi-page .wifi-faq .faq-item--open{background:#fff}
  .wifi-split{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,1fr);gap:26px;align-items:center}
  .wifi-split--reverse{grid-template-columns:minmax(320px,1fr) minmax(0,1fr)}
  .wifi-copy-block{max-width:760px}
  .wifi-copy-block--narrow{max-width:900px}
  .wifi-copy-block h2,.wifi-head h2,.wifi-band h2{font-family:'Kanit',sans-serif;font-size:clamp(1.7rem,2.4vw,2.35rem);line-height:1.15;margin:10px 0 12px}
  .wifi-copy-block p,.wifi-band p,.wifi-zone-panel li,.wifi-issues p,.wifi-actions-grid p{line-height:1.65}
  .wifi-issues{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
  .wifi-issues article,.wifi-actions-grid article,.wifi-zone-panel{border:1px solid rgba(7,31,58,.12);border-radius:16px;background:#fff;padding:18px}
  .wifi-issues h3,.wifi-issues p,.wifi-actions-grid h3,.wifi-actions-grid p,.wifi-zone-panel li,.wifi-copy-block p,.wifi-band p,.wifi-page .comments-section-container h2,.wifi-page .comments-section-container p,.wifi-page .contact h2,.wifi-page .contact h3,.wifi-page .contact p,.wifi-page .contact li,.wifi-page .contact strong,.wifi-page .contact a{color:#071F3A !important}
  .wifi-issues h3,.wifi-actions-grid h3,.wifi-band h3{margin:0 0 8px;font-size:1.03rem}
  .wifi-actions-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
  .wifi-actions-grid article{display:flex;gap:14px;align-items:flex-start}
  .wifi-actions-grid span{width:40px;height:40px;border-radius:999px;background:#eff6ff;color:#1d4ed8;display:inline-flex;align-items:center;justify-content:center;font-weight:800;flex:0 0 auto}
  .wifi-band{display:grid;grid-template-columns:minmax(300px,.9fr) minmax(0,1.1fr);gap:28px;align-items:center}
  .wifi-band img,.wifi-zone-panel img,.wifi-gallery img{width:100%;display:block;border-radius:18px}
  .wifi-gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
  .wifi-gallery img{aspect-ratio:4/3;object-fit:cover}
  .wifi-zone-panel ul{list-style:none;padding:16px 0 0;margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .wifi-zone-panel li{display:flex;gap:8px;align-items:center;font-weight:600}
  .wifi-zone-panel i{color:#1d4ed8}
  @media (max-width: 1024px){
    .wifi-hero-grid,.wifi-split,.wifi-band{grid-template-columns:1fr}
    .wifi-hero-grid{grid-template-areas:"head" "visual" "body"}
    .wifi-collage{min-height:360px}
  }
  @media (max-width: 768px){
    .wifi-issues,.wifi-actions-grid,.wifi-gallery,.wifi-zone-panel ul{grid-template-columns:1fr}
    .wifi-hero{padding:56px 0 46px}
    .wifi-collage{min-height:300px}
    .wifi-side-card{position:relative;left:auto;top:auto;max-width:none;margin-bottom:12px}
    .wifi-main{width:72%}
    .wifi-top,.wifi-bottom{width:42%}
    .wifi-hero-note{left:14px;bottom:14px}
    .wifi-metrics{grid-template-columns:1fr}
  }
</style>
