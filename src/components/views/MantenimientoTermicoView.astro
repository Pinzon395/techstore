---
import FaqSection from '../FaqSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';

const { service, category } = Astro.props;

const waMessage = encodeURIComponent(
  'Hola, quiero cotizar diagnóstico por sobrecalentamiento de consola en Cancún. Mi consola se calienta, suena fuerte o se apaga al jugar.'
);

const overheatFaqs = [
  {
    question: '¿Cuánto cuesta revisar una consola que se calienta en Cancún?',
    answer: 'El costo depende del modelo y de la causa real: polvo, pasta térmica, metal líquido en PS5, ventilador, fuente o daño en placa. Primero hacemos diagnóstico térmico para saber si basta limpieza, cambio de compuesto, ventilador o una reparación más profunda.',
  },
  {
    question: '¿Por qué mi PS5 se calienta aunque el ventilador funciona?',
    answer: 'En PS5 puede existir polvo bloqueando el disipador, metal líquido desplazado, zonas secas sobre el APU o mala ventilación externa. Aunque el ventilador gire, si el calor no se transfiere bien al disipador, la consola puede apagarse o bajar rendimiento.',
  },
  {
    question: '¿El ruido fuerte siempre significa que debo cambiar el ventilador?',
    answer: 'No siempre. Muchas consolas suenan fuerte porque el disipador está tapado y el ventilador trabaja al máximo. Si hay ruido de rodamiento, vibración, clics o el ventilador no mantiene RPM estables, entonces sí puede requerir reemplazo.',
  },
  {
    question: '¿Pueden reparar sobrecalentamiento de Xbox Series X o Xbox One?',
    answer: 'Sí. Revisamos Xbox Series X, Series S, Xbox One, One S y One X con apagados, calor excesivo, ruido fuerte o baja de rendimiento. Validamos polvo, pasta térmica, ventilador, fuente y flujo de aire antes de cotizar.',
  },
  {
    question: '¿Atienden Nintendo Switch, Steam Deck, ROG Ally y consolas portátiles?',
    answer: 'Sí. Las consolas portátiles tienen menos espacio para disipar calor, por eso requieren limpieza y revisión térmica cuidadosa. Revisamos ventilador, pasta, batería, polvo, rejillas y estabilidad en carga.',
  },
  {
    question: '¿Cuánto tarda solucionar el sobrecalentamiento de una consola?',
    answer: 'Normalmente toma de 24 a 72 horas según modelo, nivel de suciedad, pruebas necesarias y disponibilidad de refacciones. Si detectamos ventilador, fuente o daño en placa, te avisamos antes de continuar.',
  },
];

const symptoms = [
  ['fa-volume-high', 'Ventilador suena muy fuerte', 'Puede haber polvo bloqueando disipador, pasta degradada o ventilador forzado por temperatura.'],
  ['fa-temperature-high', 'Se calienta y se apaga jugando', 'La consola se protege para evitar daño en APU, GPU, fuente o placa.'],
  ['fa-gauge-high', 'Baja FPS o se traba', 'El sistema puede reducir rendimiento por throttling térmico cuando no logra enfriar.'],
  ['fa-triangle-exclamation', 'Mensaje de temperatura alta', 'Es una alerta crítica: conviene apagarla y revisarla antes de seguir jugando.'],
  ['fa-fan', 'Ventilador no gira o vibra', 'Puede ser motor dañado, conector, suciedad pegada o falla de alimentación.'],
  ['fa-box', 'Está dentro de un mueble cerrado', 'El aire caliente se recicla y aumenta la temperatura interna de forma constante.'],
];

const platforms = [
  ['fa-brands fa-playstation', 'PS5 y PS4', 'Revisión de metal líquido en PS5, pasta térmica en PS4, ventilador, disipador y flujo de aire.'],
  ['fa-brands fa-xbox', 'Xbox Series y Xbox One', 'Diagnóstico de disipador, pasta térmica, fuente, ventilador y apagados por calor bajo carga.'],
  ['fa-solid fa-gamepad', 'Nintendo Switch', 'Limpieza de rejillas, ventilador, pasta térmica, dock y pruebas de temperatura en modo portátil o TV.'],
  ['fa-solid fa-mobile-screen-button', 'Steam Deck y ROG Ally', 'Mantenimiento térmico para portátiles gamer compactas con alto rendimiento y poco margen de ventilación.'],
];

const process = [
  ['01', 'Prueba inicial', 'Registramos ruido, apagados, mensaje de temperatura, tiempo de uso y comportamiento al jugar.'],
  ['02', 'Diagnóstico térmico', 'Revisamos ventilador, disipador, pasta, metal líquido cuando aplica, fuente, polvo y señales de humedad.'],
  ['03', 'Solución correcta', 'Aplicamos limpieza, compuesto térmico, revisión de metal líquido, cambio de ventilador o reparación si es necesario.'],
  ['04', 'Prueba final', 'Probamos encendido, estabilidad, ruido, temperatura y uso real antes de entregar.'],
];
---

<div class="console-overheat-page">
  <section class="co-hero">
    <div class="co-hero-glow"></div>
    <div class="container co-hero-grid">
      <div class="co-hero-copy">
        <span class="co-kicker"><i class="fa-solid fa-location-dot"></i> Servicio técnico de consolas en Cancún</span>
        <h1>Sobrecalentamiento de consola en Cancún</h1>
        <h2>Solución para PS5, Xbox, Nintendo Switch, Steam Deck y ROG Ally que se calientan, suenan fuerte o se apagan al jugar.</h2>
        <p>Si tu consola parece turbina, baja rendimiento, muestra aviso de temperatura o se apaga en juegos pesados, revisamos polvo, ventilador, disipador, pasta térmica, metal líquido en PS5, fuente y flujo de aire antes de cotizar.</p>
        <div class="co-badges">
          <span>PS5 metal líquido</span>
          <span>Xbox Series</span>
          <span>Nintendo Switch</span>
          <span>Portátiles gamer</span>
          <span>Diagnóstico térmico</span>
        </div>
        <div class="co-actions">
          <a class="co-primary" href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank"><i class="fa-brands fa-whatsapp"></i> Cotizar sobrecalentamiento</a>
          <a class="co-secondary" href="#diagnostico-sobrecalentamiento">Ver diagnóstico</a>
        </div>
      </div>
      <aside class="co-hero-panel">
        <div class="co-console-visual" aria-hidden="true">
          <i class="fa-solid fa-gamepad"></i>
          <span class="heat-ring ring-a"></span>
          <span class="heat-ring ring-b"></span>
          <span class="heat-dot dot-a"></span>
          <span class="heat-dot dot-b"></span>
        </div>
        <div class="co-panel-price">
          <span>Diagnóstico térmico</span>
          <strong>{service.fromPrice || 'Desde $700 MXN'}</strong>
          <small>El costo final depende de limpieza, pasta, metal líquido, ventilador o daño adicional.</small>
        </div>
        <ul>
          <li><i class="fa-solid fa-check"></i> Medición de síntomas y ruido</li>
          <li><i class="fa-solid fa-check"></i> Revisión de polvo y disipador</li>
          <li><i class="fa-solid fa-check"></i> Pasta térmica o metal líquido</li>
          <li><i class="fa-solid fa-check"></i> Prueba de estabilidad al jugar</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="co-section co-symptoms" id="diagnostico-sobrecalentamiento">
    <div class="container co-split">
      <div class="co-section-copy">
        <span class="co-eyebrow">Diagnóstico frecuente</span>
        <h2>Señales de sobrecalentamiento en consolas</h2>
        <p>En Cancún el calor, la humedad y el polvo hacen que las consolas trabajen con menos margen térmico. No cambiamos piezas por suposición: primero identificamos si el problema es suciedad, compuesto térmico, ventilador, fuente o placa.</p>
      </div>
      <div class="co-symptom-list">
        {symptoms.map(([icon, title, text]) => (
          <article>
            <i class={`fa-solid ${icon}`}></i>
            <div>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="co-section co-ps5">
    <div class="container co-ps5-panel">
      <div>
        <span class="co-eyebrow">PS5 y metal líquido</span>
        <h2>Sobrecalentamiento de PS5 en Cancún: polvo, ventilador y metal líquido</h2>
        <p>La PS5 usa metal líquido sobre el APU. Si se desplaza, queda mal distribuido o el disipador está saturado de polvo, la consola puede calentarse aunque el ventilador funcione. Revisamos con cuidado antes de tocarlo.</p>
      </div>
      <div class="co-ps5-checks">
        <article><h3>Metal líquido</h3><p>Validamos si hay zonas secas, desplazamiento o mala transferencia térmica.</p></article>
        <article><h3>Disipador</h3><p>Revisamos si el polvo bloquea aletas internas y salidas de aire.</p></article>
        <article><h3>Ventilador</h3><p>Confirmamos RPM, ruido, vibración y estado de conectores.</p></article>
      </div>
    </div>
  </section>

  <section class="co-section co-platforms">
    <div class="container">
      <div class="co-head-center">
        <span class="co-eyebrow">Consolas que atendemos</span>
        <h2>Refrigeración para PS5, Xbox, Nintendo Switch y consolas portátiles</h2>
        <p>Cada consola tiene un diseño térmico distinto. Por eso el proceso no es igual para una PS5, una Xbox Series X, una Nintendo Switch o una portátil tipo Steam Deck.</p>
      </div>
      <div class="co-platform-grid">
        {platforms.map(([icon, title, text]) => (
          <article>
            <i class={icon}></i>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="co-section co-decision">
    <div class="container co-decision-grid">
      <div>
        <span class="co-eyebrow">Diagnóstico claro</span>
        <h2>¿Necesita limpieza, pasta, metal líquido o cambio de ventilador?</h2>
        <p>El síntoma puede parecer igual, pero la causa no siempre lo es. Una consola puede apagarse por polvo, por pasta seca, por metal líquido mal distribuido, por fuente, por ventilador o por daño en placa.</p>
        <a class="co-primary" href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank">Quiero diagnóstico de mi consola</a>
      </div>
      <div class="co-compare">
        <article>
          <h3>Puede bastar mantenimiento si:</h3>
          <ul>
            <li>Suena fuerte pero enciende normal</li>
            <li>Se calienta después de jugar</li>
            <li>Tiene polvo visible en rejillas</li>
            <li>Nunca se ha limpiado</li>
          </ul>
        </article>
        <article>
          <h3>Puede requerir reparación si:</h3>
          <ul>
            <li>Se apaga al instante</li>
            <li>El ventilador no gira</li>
            <li>Huele a quemado</li>
            <li>Sigue fallando después de limpieza</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="co-section co-process">
    <div class="container">
      <div class="co-head-center">
        <span class="co-eyebrow">Proceso técnico</span>
        <h2>Cómo resolvemos el sobrecalentamiento de tu consola</h2>
        <p>No entregamos una consola solo porque ya se ve limpia. Validamos ruido, temperatura, encendido, flujo de aire y estabilidad con uso real.</p>
      </div>
      <div class="co-process-line">
        {process.map(([num, title, text]) => (
          <article>
            <span>{num}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="co-section co-cancun">
    <div class="container co-cancun-panel">
      <div>
        <span class="co-eyebrow">SEO local Cancún</span>
        <h2>El clima de Cancún acelera el polvo, humedad y calor dentro de tu consola</h2>
        <p>La humedad pega el polvo, el calor ambiente reduce el margen de enfriamiento y los muebles cerrados reciclan aire caliente. Por eso en Cancún una consola puede requerir revisión térmica antes que en ciudades secas.</p>
      </div>
      <div class="co-cancun-strip">
        <span><i class="fa-solid fa-water"></i> Humedad</span>
        <span><i class="fa-solid fa-temperature-high"></i> Calor</span>
        <span><i class="fa-solid fa-wind"></i> Polvo fino</span>
        <span><i class="fa-solid fa-box"></i> Muebles cerrados</span>
      </div>
    </div>
  </section>

  <RelatedServicesSection
    category={category}
    service={service}
    title="Servicios relacionados para consolas"
    eyebrow="Servicios complementarios"
    includeCategoryServices={true}
    initialLimit={8}
  />

  <FaqSection
    id="faq"
    title="Preguntas frecuentes sobre sobrecalentamiento de consolas en Cancún"
    description="Resolvemos dudas sobre PS5, Xbox, Nintendo Switch, metal líquido, pasta térmica, ventilador, apagados, ruido y garantía."
    items={overheatFaqs}
    ariaLabel="Preguntas frecuentes sobre sobrecalentamiento de consolas en Cancún"
    viewMoreHref="/preguntas-frecuentes"
    viewMoreLabel="Ver más preguntas frecuentes"
    sectionClass="faq-section"
    gridClass="faq-grid"
    backgroundColor="#F8FAFC"
    questionColor="#0F2A4A"
    itemGap="8px"
    questionPadding="16px 18px"
  />

  <CommentsSection dark={true} viewMoreHref="/comentarios" viewMoreLabel="Ver todas las reseñas" id="comentarios" />
  <ContactSection id="ubicacion" />
</div>

<style is:global>
  .console-overheat-page {
    background: #0b1120;
    color: #e2e8f0;
  }
  .co-hero {
    position: relative;
    overflow: hidden;
    padding: 34px 0 44px;
    background:
      radial-gradient(circle at 14% 18%, rgba(239,68,68,.18), transparent 28%),
      radial-gradient(circle at 80% 18%, rgba(56,189,248,.16), transparent 30%),
      linear-gradient(135deg, #07111f 0%, #0b1120 52%, #101b32 100%);
  }
  .co-hero-glow {
    position: absolute;
    inset: auto -120px -180px auto;
    width: 420px;
    height: 420px;
    border-radius: 999px;
    background: rgba(59,130,246,.18);
    filter: blur(30px);
  }
  .co-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0,1.12fr) minmax(320px,.88fr);
    gap: 28px;
    align-items: center;
  }
  .co-kicker,
  .co-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #67e8f9;
    font-size: .78rem;
    font-weight: 950;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .co-hero h1 {
    max-width: 820px;
    margin: 10px 0;
    color: #fff;
    font-family: 'Kanit', sans-serif;
    font-size: clamp(2.15rem, 4.7vw, 4.15rem);
    line-height: .98;
  }
  .co-hero h2 {
    max-width: 760px;
    margin: 0 0 12px;
    color: #ccfbf1;
    font-family: 'Kanit', sans-serif;
    font-size: clamp(1.05rem, 2vw, 1.5rem);
    line-height: 1.18;
  }
  .co-hero p {
    max-width: 760px;
    margin: 0;
    color: #cbd5e1;
    line-height: 1.62;
    font-weight: 650;
  }
  .co-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0;
  }
  .co-badges span {
    color: #e0f2fe;
    background: rgba(255,255,255,.07);
    border: 1px solid rgba(125,211,252,.18);
    border-radius: 999px;
    padding: 8px 11px;
    font-size: .82rem;
    font-weight: 850;
  }
  .co-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
  .co-primary,
  .co-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border-radius: 12px;
    padding: 13px 18px;
    font-weight: 900;
    text-decoration: none;
  }
  .co-primary {
    color: #fff !important;
    background: #2563eb;
    box-shadow: 0 18px 38px rgba(37,99,235,.24);
  }
  .co-secondary {
    color: #dbeafe !important;
    border: 1px solid rgba(255,255,255,.18);
    background: rgba(255,255,255,.06);
  }
  .co-hero-panel {
    background: rgba(15,23,42,.82);
    border: 1px solid rgba(148,163,184,.2);
    border-radius: 22px;
    padding: 16px;
    box-shadow: 0 28px 80px rgba(0,0,0,.34);
  }
  .co-console-visual {
    position: relative;
    min-height: 156px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 20px;
    background:
      linear-gradient(90deg, rgba(125,211,252,.1) 1px, transparent 1px),
      linear-gradient(0deg, rgba(125,211,252,.1) 1px, transparent 1px),
      radial-gradient(circle, rgba(239,68,68,.2), transparent 48%);
    background-size: 34px 34px, 34px 34px, auto;
  }
  .co-console-visual > i {
    position: relative;
    z-index: 2;
    color: #f8fafc;
    font-size: 4.1rem;
    filter: drop-shadow(0 18px 30px rgba(0,0,0,.36));
  }
  .heat-ring {
    position: absolute;
    border: 1px solid rgba(248,113,113,.38);
    border-radius: 999px;
  }
  .ring-a { width: 118px; height: 118px; }
  .ring-b { width: 178px; height: 178px; opacity: .55; }
  .heat-dot {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background: #f97316;
    box-shadow: 0 0 24px rgba(249,115,22,.75);
  }
  .dot-a { left: 22%; top: 26%; }
  .dot-b { right: 18%; bottom: 24%; }
  .co-panel-price {
    display: grid;
    gap: 5px;
    margin: 12px 0;
  }
  .co-panel-price span { color: #bfdbfe; font-weight: 850; }
  .co-panel-price strong {
    color: #67e8f9;
    font-family: 'Kanit', sans-serif;
    font-size: 1.8rem;
    line-height: 1;
  }
  .co-panel-price small { color: #cbd5e1; line-height: 1.45; }
  .co-hero-panel ul {
    display: grid;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .co-hero-panel li {
    color: #dbeafe;
    display: flex;
    gap: 9px;
    font-weight: 740;
    font-size: .9rem;
  }
  .co-hero-panel li i { color: #22c55e; margin-top: 3px; }
  .co-section { padding: 62px 0; }
  .co-section:nth-of-type(odd) { background: #f8fafc; }
  .co-section:nth-of-type(even) { background: #0b1120; }
  .co-split,
  .co-ps5-panel,
  .co-decision-grid,
  .co-cancun-panel {
    display: grid;
    grid-template-columns: .92fr 1.08fr;
    gap: 28px;
    align-items: center;
  }
  .co-section h2,
  .co-head-center h2 {
    color: #0f2a4a;
    font-family: 'Kanit', sans-serif;
    font-size: clamp(1.85rem, 3.4vw, 3rem);
    line-height: 1.06;
    margin: 10px 0 12px;
  }
  .co-section p,
  .co-head-center p {
    color: #475569;
    line-height: 1.64;
    margin: 0;
  }
  .co-section:nth-of-type(even) h2,
  .co-section:nth-of-type(even) .co-head-center h2 {
    color: #f8fafc;
  }
  .co-section:nth-of-type(even) p,
  .co-section:nth-of-type(even) .co-head-center p {
    color: #cbd5e1;
  }
  .co-symptom-list {
    display: grid;
    gap: 0;
    border-top: 1px solid rgba(15,42,74,.13);
    border-bottom: 1px solid rgba(15,42,74,.13);
  }
  .co-symptom-list article {
    display: grid;
    grid-template-columns: 46px minmax(0,1fr);
    gap: 13px;
    padding: 16px 0;
    border-bottom: 1px solid rgba(15,42,74,.1);
  }
  .co-symptom-list article:last-child { border-bottom: 0; }
  .co-symptom-list i {
    color: #0ea5e9;
    font-size: 1.15rem;
    margin-top: 3px;
  }
  .co-symptom-list h3,
  .co-ps5-checks h3,
  .co-platform-grid h3,
  .co-compare h3,
  .co-process-line h3 {
    color: #0f2a4a;
    font-family: 'Kanit', sans-serif;
    font-size: 1.08rem;
    margin: 0 0 6px;
  }
  .co-ps5 {
    background:
      radial-gradient(circle at 90% 20%, rgba(34,211,238,.12), transparent 28%),
      #0b1120 !important;
  }
  .co-ps5-checks,
  .co-platform-grid,
  .co-compare,
  .co-process-line {
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    gap: 12px;
  }
  .co-ps5-checks article,
  .co-platform-grid article,
  .co-compare article,
  .co-process-line article {
    background: #fff;
    border: 1px solid rgba(15,42,74,.1);
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 14px 34px rgba(15,42,74,.07);
  }
  .co-ps5 .co-ps5-checks article {
    background: rgba(255,255,255,.06);
    border-color: rgba(125,211,252,.18);
  }
  .co-ps5 .co-ps5-checks h3 { color: #f8fafc; }
  .co-ps5 .co-ps5-checks p { color: #cbd5e1; }
  .co-symptoms,
  .co-ps5,
  .co-process {
    background: #0b1120 !important;
  }
  .co-platforms,
  .co-decision,
  .co-cancun {
    background: #f8fafc !important;
  }
  .co-symptoms h2,
  .co-symptoms .co-symptom-list h3,
  .co-ps5 h2,
  .co-process h2 {
    color: #f8fafc !important;
  }
  .co-symptoms p,
  .co-symptoms .co-symptom-list p,
  .co-ps5 p,
  .co-process .co-head-center p {
    color: #cbd5e1 !important;
  }
  .co-platforms h2,
  .co-decision h2,
  .co-cancun h2 {
    color: #0f2a4a !important;
  }
  .co-platforms p,
  .co-decision p,
  .co-cancun p {
    color: #475569 !important;
  }
  .co-platform-grid article,
  .co-compare article,
  .co-process-line article {
    background: #fff;
  }
  .co-platform-grid article h3,
  .co-compare article h3,
  .co-process-line article h3 {
    color: #0f2a4a !important;
  }
  .co-platform-grid article p,
  .co-compare article p,
  .co-process-line article p {
    color: #475569 !important;
  }
  .co-symptoms .co-symptom-list {
    border-color: rgba(255,255,255,.14);
  }
