---
import FaqSection from '../FaqSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import Footer from '../Footer.astro';

const { service, category } = Astro.props;

const whatsappText = encodeURIComponent(
  'Hola, quiero diagnostico para una laptop Dell en Cancun. Es Inspiron, Latitude, XPS, Vostro, Alienware, Precision u otro modelo.'
);

const dellLines = [
  ['fa-house-laptop', 'Dell Inspiron para casa, escuela y oficina', 'Reparamos Inspiron 14, 15, x360 y All-in-One portatiles con pantalla rota, teclado, bateria, carga, bisagras, SSD, RAM y Windows lento.'],
  ['fa-briefcase', 'Dell Latitude empresarial', 'Revisamos Latitude para oficina y trabajo: carga USB-C, docking, teclado, pantalla, bateria, WiFi, seguridad, SSD y rendimiento.'],
  ['fa-gem', 'Dell XPS premium', 'Atendemos XPS con chasis de aluminio y fibra de carbono, pantalla InfinityEdge, bisagras, bateria interna, puertos USB-C/Thunderbolt y fallas de display.'],
  ['fa-building', 'Dell Vostro para negocio y oficina', 'Soporte para Vostro de trabajo diario: bisagras, bateria, Windows, lentitud, pantalla, puertos, teclado y mantenimiento.'],
  ['fa-gamepad', 'Dell Alienware y G-Series gamer', 'Servicio para Alienware y G3/G5/G15 con GPU dedicada, alta temperatura, bajo FPS, ventiladores, pasta termica, thermal pads, disipacion y drivers.'],
  ['fa-server', 'Dell Precision workstation', 'Soporte para Precision de diseño y ingenieria: rendimiento maximo, GPU Quadro/RTX, disipacion, memoria ECC, SSD y problemas de placa.'],
];

const problems = [
  ['fa-plug-circle-bolt', 'Dell no carga o no enciende', 'Probamos cargador original (evita error "AC adapter not determined"), puerto de carga, bateria, boton power y placa.'],
  ['fa-display', 'Pantalla Dell rota o con manchas', 'Confirmamos panel, flex, bisagras, resolucion y numero de parte compatible exacto.'],
  ['fa-temperature-arrow-up', 'Alienware o G-Series se calienta jugando', 'Revisamos polvo, ventiladores, pasta termica, thermal pads, drivers y perfiles de ventilacion.'],
  ['fa-keyboard', 'Teclado Dell fallando o mojado', 'Validamos idioma (español o ingles), backlit, flex, conector y teclas que no responden.'],
  ['fa-hard-drive', 'Dell lenta, congelada o Windows dañado', 'Upgrade a SSD, ampliacion de RAM, eliminacion de virus y optimizacion del sistema sin perder datos.'],
  ['fa-droplet', 'Derrame de liquido o humedad', 'Apagamos riesgo electrico, revisamos placa, teclado, bateria y disco antes de energizar.'],
];

const process = [
  ['01', 'Modelo Dell exacto', 'Identificamos serie, Service Tag, Express Service Code y variante para confirmar compatibilidad de piezas exactas.'],
  ['02', 'Diagnostico por componente', 'Probamos cargador (importante en Dell), bateria, pantalla, teclado, RAM, SSD, ventilador, BIOS y placa.'],
  ['03', 'Ruta de reparacion', 'Te explicamos si conviene reparar, cambiar pieza, hacer mantenimiento, instalar SSD/RAM o reinstalar Windows.'],
  ['04', 'Intervencion segura', 'Abrimos con herramienta adecuada, cuidando clips, flex, bisagras, tornilleria y disipador.'],
  ['05', 'Pruebas finales', 'Validamos carga, bateria, pantalla, teclado, WiFi, camara, audio, temperatura y estabilidad antes de entregar.'],
];

const seoTags = [
  'Reparacion Dell Inspiron Cancun',
  'Servicio Dell Latitude Cancun',
  'Reparacion Dell XPS premium',
  'Mantenimiento Alienware Cancun',
  'Soporte Dell Vostro oficina',
  'Dell Precision workstation',
  'Cambio de pantalla Dell Cancun',
  'Laptop Dell lenta o no enciende',
];

const faqItems = [
  {
    question: '¿Reparan Dell Inspiron, Latitude, XPS, Vostro, Alienware y Precision?',
    answer: 'Si. Revisamos esas familias por modelo exacto, Service Tag y falla: pantalla, teclado, carga, bateria, SSD, RAM, Windows, temperatura, bisagras, placa y mantenimiento.',
  },
  {
    question: '¿Cuanto cuesta reparar una laptop Dell en Cancun?',
    answer: 'Depende de la falla real y disponibilidad de pieza. Primero confirmamos si es cargador, bateria, pantalla, teclado, SSD, RAM, Windows, temperatura o placa. Cotizamos antes de reparar.',
  },
  {
    question: '¿Mi Dell Alienware o G-Series se calienta al jugar, tiene solucion?',
    answer: 'Si. Revisamos limpieza interna de disipadores, ventiladores, pasta termica, thermal pads, drivers de video, BIOS y estabilidad en carga real.',
  },
  {
    question: '¿Por que mi Dell dice "AC adapter type cannot be determined"?',
    answer: 'Dell usa un pin central en el cargador para identificarlo. Si el cargador esta dañado, el puerto esta roto o hay falla en placa, la laptop no cargara la bateria o ira lenta. Probamos cada parte para darte la solucion.',
  },
  {
    question: '¿Pueden cambiar pantalla de Dell XPS con bordes delgados?',
    answer: 'Si, pero se valida compatibilidad exacta por resolucion (FHD/4K), touch, conector e integridad de la tapa. Son pantallas premium de alta precision.',
  },
  {
    question: '¿Pueden hacer mi Dell mas rapida con SSD o RAM?',
    answer: 'Si. Validamos si soporta SSD SATA, NVMe o ampliacion de RAM. Muchas Inspiron, Vostro y Latitude mejoran drasticamente con SSD y limpieza de Windows.',
  },
];
---

<div class="dell-page">
  <section class="dell-hero">
    <div class="dell-shell dell-hero-grid">
      <div class="dell-copy">
        <span class="dell-kicker"><i class="fa-solid fa-laptop-medical"></i> Servicio Dell en Cancún</span>
        <h1>Reparación de laptop Dell en Cancún</h1>
        <h2>Inspiron, Latitude, XPS, Vostro, Alienware y Precision: diagnóstico por modelo antes de cambiar piezas.</h2>
        <p>Atendemos laptops Dell de oficina, escuela, empresa, gaming y gama premium. Revisamos encendido, carga, pantalla, teclado, batería, SSD, RAM, temperatura, Windows, bisagras y placa.</p>
        <div class="dell-actions">
          <a class="dell-btn dell-btn-primary" href={`https://wa.me/529986690777?text=${whatsappText}`}><i class="fa-brands fa-whatsapp"></i> Cotizar Dell</a>
          <a class="dell-btn dell-btn-soft" href="#modelos-dell"><i class="fa-solid fa-layer-group"></i> Ver modelos Dell</a>
        </div>
      </div>
      <div class="dell-visual">
        <div class="dell-laptop">
          <div class="dell-screen">
            <span>DELL</span>
            <strong>Inspiron · Latitude · XPS</strong>
          </div>
          <div class="dell-base"></div>
        </div>
        <div class="dell-chip chip-a">Inspiron</div>
        <div class="dell-chip chip-b">XPS</div>
        <div class="dell-chip chip-c">Latitude</div>
      </div>
    </div>
  </section>

  <section class="dell-section" id="modelos-dell">
    <div class="dell-shell">
      <div class="dell-head">
        <span>Versiones Dell</span>
        <h2>Reparamos Dell gamer, Dell de oficina, Dell empresarial, Dell premium y Dell escolar</h2>
        <p>Cada familia Dell cambia en pantalla, cargador, disipador, bisagras, batería, BIOS, SSD, RAM y forma de desarmado.</p>
      </div>
      <div class="dell-model-grid">
        {dellLines.map(([icon, title, text]) => (
          <article>
            <i class={`fa-solid ${icon}`}></i>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="dell-section dell-dark">
    <div class="dell-shell">
      <div class="dell-head dell-head-light">
        <span>Fallas comunes</span>
        <h2>Problemas frecuentes en laptops Dell que resolvemos en Cancún</h2>
        <p>Primero se prueba. Muchas fallas vienen de cargador, batería, SSD, RAM, pantalla, flex, temperatura, BIOS, drivers o Windows.</p>
      </div>
      <div class="dell-problem-grid">
        {problems.map(([icon, title, text]) => (
          <article>
            <i class={`fa-solid ${icon}`}></i>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="dell-section">
    <div class="dell-shell dell-split">
      <div>
        <span class="dell-eyebrow">Diagnóstico técnico</span>
        <h2>Cómo trabajamos una laptop Dell antes de cotizar</h2>
        <p>Validamos modelo, Service Tag, síntoma y pruebas por módulo. Así evitamos cambiar pantalla, batería, teclado o placa cuando la falla viene de otra causa.</p>
        <img src="/assets/images/laptop-feliz-limpia.webp" alt="Reparación de laptop Dell en Cancún" loading="lazy" decoding="async" />
      </div>
      <div class="dell-process">
        {process.map(([step, title, text]) => (
          <article>
            <strong>{step}</strong>
            <div>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="dell-section dell-seo">
    <div class="dell-shell dell-seo-grid">
      <div>
        <span class="dell-eyebrow">SEO local Cancún</span>
        <h2>Servicio técnico Dell en Cancún para casa, oficina, empresa y gaming</h2>
        <p>Atendemos Dell en Cancún Centro, Huayacán, Cumbres, Bonampak, Puerto Cancún, Zona Hotelera y alrededores según agenda.</p>
      </div>
      <div class="dell-tags">
        {dellLines.map((line) => line[1]).concat(seoTags).filter((v, i, a) => a.indexOf(v) === i).slice(0, 8).map((item) => (
          <span><i class="fa-solid fa-check"></i>{item}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="dell-section dell-images">
    <div class="dell-shell dell-image-grid">
      <article>
        <img src="/assets/images/cambio-pantalla-laptop.webp" alt="Cambio de pantalla para laptop Dell en Cancún" loading="lazy" decoding="async" />
        <div>
          <span>Pantalla Dell</span>
          <h2>Pantalla, bisagras y flex para Inspiron, Latitude y XPS</h2>
          <p>Confirmamos panel, touch, flex, bisagras, resolución, tamaño y número de parte antes de pedir una pantalla Dell.</p>
        </div>
      </article>
      <article>
        <img src="/assets/images/mantenimiento-pastaternima-thermalpads.webp" alt="Mantenimiento térmico para Dell Alienware y G-Series" loading="lazy" decoding="async" />
        <div>
          <span>Gaming Dell</span>
          <h2>Mantenimiento térmico para Alienware y G-Series</h2>
          <p>Revisamos ventiladores, polvo, pasta térmica, thermal pads, GPU, CPU, drivers y estabilidad en carga real.</p>
        </div>
      </article>
      <article>
        <img src="/assets/images/cambio-ssd.webp" alt="Upgrade SSD y RAM para laptop Dell lenta" loading="lazy" decoding="async" />
        <div>
          <span>Rendimiento Dell</span>
          <h2>SSD, RAM y Windows para Dell lenta</h2>
          <p>En Inspiron, Vostro y Latitude revisamos si conviene instalar SSD, ampliar RAM, clonar Windows o reinstalar.</p>
        </div>
      </article>
    </div>
  </section>

  <ServiceTicketSection
    id="ticket-dell"
    defaultDevice="Laptop Dell"
    defaultService="Reparación laptop Dell"
    title="Agenda diagnóstico para laptop Dell"
    subtitle="Indica si es Inspiron, Latitude, XPS, Vostro, Alienware, Precision u otro modelo y qué falla presenta."
  />

  <RelatedServicesSection
    service={service}
    category={category}
    initialLimit={6}
    title="Servicios relacionados para laptop Dell"
  />

  <FaqSection
    id="faq-dell"
    title="Preguntas frecuentes sobre reparación de laptop Dell en Cancún"
    description="Dudas sobre Inspiron, Latitude, XPS, Vostro, Alienware, Precision, carga, pantalla, teclado, SSD, RAM, temperatura y Windows."
    items={faqItems}
    backgroundColor="#0B1120"
    titleColor="#ffffff"
    descriptionColor="#dbeafe"
    questionColor="#0f2a4a"
    faqAccent="#0284c7"
  />

  <CommentsSection />
  <ContactSection />
  <Footer />
</div>

<style>
  .dell-page { background: #f8fafc; color: #0f2a4a; overflow: hidden; }
  .dell-shell { width: min(1180px, calc(100% - (var(--page-gutter) * 2))); margin: 0 auto; }
  .dell-hero {
    padding: 48px 0 38px;
    background:
      radial-gradient(circle at 12% 18%, rgba(2, 132, 199, 0.24), transparent 28%),
      radial-gradient(circle at 86% 12%, rgba(14, 165, 233, 0.18), transparent 30%),
      linear-gradient(135deg, #07111f 0%, #102a43 52%, #0b1120 100%);
  }
  .dell-hero-grid { display: grid; grid-template-columns: minmax(0, 1.04fr) minmax(340px, .96fr); gap: clamp(22px, 4vw, 54px); align-items: center; }
  .dell-kicker, .dell-eyebrow, .dell-head span, .dell-image-grid span {
    display: inline-flex; align-items: center; gap: 8px; color: #0284c7; font-size: .78rem; font-weight: 950; letter-spacing: .08em; text-transform: uppercase;
  }
  .dell-kicker { color: #93c5fd; }
  .dell-copy h1 { margin: 10px 0; color: #fff; font-family: 'Kanit', sans-serif; font-size: clamp(2rem, 4.1vw, 3.55rem); line-height: 1; }
  .dell-copy h2 { margin: 0 0 12px; color: #bfdbfe; font-family: 'Kanit', sans-serif; font-size: clamp(1.02rem, 1.8vw, 1.42rem); line-height: 1.2; }
  .dell-copy p { margin: 0; color: #dbeafe; font-weight: 650; line-height: 1.62; }
  .dell-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
  .dell-btn { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 46px; padding: 12px 17px; border-radius: 12px; text-decoration: none; font-weight: 950; }
  .dell-btn-primary { color: #fff; background: #16a34a; box-shadow: 0 18px 34px rgba(22, 163, 74, .24); }
  .dell-btn-soft { color: #dbeafe; border: 1px solid rgba(191,219,254,.26); background: rgba(255,255,255,.08); }
  .dell-visual { position: relative; min-height: 310px; display: grid; place-items: center; }
  .dell-laptop { width: min(100%, 480px); }
  .dell-screen {
    min-height: 220px; padding: 24px; border: 1px solid rgba(147,197,253,.22); border-radius: 24px 24px 12px 12px;
    background: linear-gradient(90deg, rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(0deg, rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(135deg, #0f172a 0%, #0284c7 100%);
    background-size: 30px 30px, 30px 30px, auto; box-shadow: 0 24px 70px rgba(0,0,0,.32);
  }
  .dell-screen span { color: #93c5fd; font-weight: 950; letter-spacing: .18em; }
  .dell-screen strong { display: block; margin-top: 54px; color: #fff; font-family: 'Kanit', sans-serif; font-size: 1.55rem; }
  .dell-base { height: 24px; margin: 0 34px; border-radius: 0 0 22px 22px; background: #cbd5e1; box-shadow: 0 18px 34px rgba(0,0,0,.26); }
  .dell-chip { position: absolute; padding: 10px 13px; border: 1px solid rgba(191,219,254,.22); border-radius: 999px; color: #dbeafe; background: rgba(15,23,42,.78); font-weight: 950; box-shadow: 0 14px 30px rgba(0,0,0,.22); }
  .chip-a { left: 0; top: 36px; } .chip-b { right: 6px; top: 80px; } .chip-c { left: 46px; bottom: 32px; }
  .dell-section { padding: 64px 0; background: #f8fafc; }
  .dell-head { max-width: 930px; margin: 0 auto 28px; text-align: center; }
  .dell-head h2, .dell-split h2, .dell-seo h2, .dell-image-grid h2 { margin: 8px 0 12px; color: #0f2a4a; font-family: 'Kanit', sans-serif; font-size: clamp(1.85rem, 3.3vw, 3.05rem); line-height: 1.06; }
  .dell-head p, .dell-split p, .dell-seo p, .dell-image-grid p { margin: 0; color: #334e68; font-weight: 650; line-height: 1.66; }
  .dell-model-grid, .dell-problem-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 14px; }
  .dell-model-grid article, .dell-problem-grid article { padding: 20px; border: 1px solid rgba(15,42,74,.14); border-radius: 20px; background: #fff; box-shadow: 0 14px 34px rgba(15,42,74,.08); }
  .dell-model-grid i, .dell-problem-grid i { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 14px; border-radius: 14px; color: #0284c7; background: #dbeafe; }
  .dell-model-grid h3, .dell-problem-grid h3, .dell-process h3 { margin: 0 0 8px; color: #0f2a4a; font-family: 'Kanit', sans-serif; font-size: 1.1rem; line-height: 1.2; }
  .dell-model-grid p, .dell-problem-grid p, .dell-process p { margin: 0; color: #334e68; line-height: 1.58; font-weight: 620; }
  .dell-dark { background: radial-gradient(circle at 14% 10%, rgba(2,132,199,.18), transparent 30%), linear-gradient(135deg, #07111f 0%, #0b1f38 100%); }
  .dell-head-light span { color: #93c5fd; }
  .dell-head-light h2 { color: #fff; }
  .dell-head-light p { color: #dbeafe; }
  .dell-problem-grid article { background: rgba(255,255,255,.08); border-color: rgba(147,197,253,.18); box-shadow: none; }
  .dell-problem-grid i { color: #bfdbfe; background: rgba(147,197,253,.16); }
  .dell-problem-grid h3 { color: #fff; }
  .dell-problem-grid p { color: #dbeafe; }
  .dell-split, .dell-seo-grid { display: grid; grid-template-columns: .88fr 1.12fr; gap: 32px; align-items: center; }
  .dell-split img { width: 100%; margin-top: 22px; border-radius: 22px; box-shadow: 0 18px 46px rgba(15,42,74,.14); }
  .dell-process { display: grid; gap: 12px; }
  .dell-process article { display: grid; grid-template-columns: 58px minmax(0,1fr); gap: 14px; padding: 18px; border: 1px solid rgba(15,42,74,.14); border-radius: 18px; background: #fff; box-shadow: 0 12px 28px rgba(15,42,74,.07); }
  .dell-process strong { color: #0284c7; font-family: 'Kanit', sans-serif; font-size: 1.2rem; }
  .dell-seo { background: #eef6ff; }
  .dell-tags { display: flex; flex-wrap: wrap; gap: 10px; }
  .dell-tags span { display: inline-flex; align-items: center; gap: 8px; padding: 10px 12px; border-radius: 999px; color: #0f2a4a; background: #fff; border: 1px solid rgba(15,42,74,.12); font-weight: 900; }
  .dell-tags i { color: #16a34a; }
  .dell-images { background: #fff; }
  .dell-image-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 18px; }
  .dell-image-grid article { overflow: hidden; border: 1px solid rgba(15,42,74,.14); border-radius: 24px; background: #f8fafc; box-shadow: 0 18px 42px rgba(15,42,74,.1); }
  .dell-image-grid img { width: 100%; height: 230px; display: block; object-fit: cover; }
  .dell-image-grid div { padding: 22px; }
  .dell-image-grid h2 { font-size: clamp(1.35rem, 2.2vw, 1.95rem); }
  @media (max-width: 980px) {
    .dell-hero-grid, .dell-split, .dell-seo-grid { grid-template-columns: 1fr; }
    .dell-model-grid, .dell-problem-grid, .dell-image-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
  }
  @media (max-width: 640px) {
    .dell-hero { padding: 34px 0 30px; }
    .dell-visual { min-height: 260px; }
    .dell-screen { min-height: 190px; padding: 18px; }
    .dell-screen strong { margin-top: 42px; font-size: 1.2rem; }
    .dell-chip { display: none; }
    .dell-section { padding: 46px 0; }
    .dell-model-grid, .dell-problem-grid, .dell-image-grid { grid-template-columns: 1fr; }
    .dell-actions { display: grid; }
    .dell-process article { grid-template-columns: 1fr; }
    .dell-image-grid img { height: 220px; }
  }
</style>
