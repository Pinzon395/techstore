---
import Base from '../../layouts/Base.astro';
import Navbar from '../Navbar.astro';
import Breadcrumb from '../Breadcrumb.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import FaqSection from '../FaqSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import DarkTechnicalSection from '../DarkTechnicalSection.astro';
import Footer from '../Footer.astro';

const pageTitle = 'Póliza de Soporte TI para empresas en Cancún | Mantenimiento y sistemas';
const pageDescription = 'Outsourcing de soporte TI empresarial en Cancún. Pólizas de mantenimiento preventivo de computadoras, instalación de redes, igualas mensuales de soporte técnico y consultoría técnica para oficinas, hoteles y PyMEs.';
const canonicalUrl = 'https://pixon.com.mx/empresas';

const faqs = [
  { 
    question: '¿Qué servicios cubre una póliza de soporte TI empresarial en Cancún?', 
    answer: 'Nuestras pólizas de soporte técnico empresarial cubren el mantenimiento preventivo de computadoras y flotillas de laptops, limpieza interna profunda de hardware para evitar sobrecalentamiento, administración y configuración de redes cableadas y redes WiFi, soporte para sistemas operativos de Windows y macOS, mantenimiento de impresoras compartidas, gestión de antivirus corporativos, políticas de respaldos de información periódicos y soporte técnico remoto y presencial de urgencia.' 
  },
  { 
    question: '¿Cómo se estructuran las igualas mensuales de soporte técnico en Cancún?', 
    answer: 'Diseñamos igualas mensuales de sistemas a la medida de tu oficina, negocio, hotel o restaurante en Cancún. Definimos una cantidad fija de visitas técnicas programadas al mes para tareas de mantenimiento preventivo y optimización de computadoras, combinadas con una mesa de ayuda remota ilimitada y asistencia presencial prioritaria ante emergencias críticas en tus equipos o redes.' 
  },
  { 
    question: '¿Qué ventajas ofrece el mantenimiento preventivo de computadoras para oficinas?', 
    answer: 'Realizar una limpieza interna y cambio de pasta térmica de manera programada previene fallas catastróficas, pantallas azules e inestabilidad en las computadoras de tu personal. En Cancún, la humedad relativa y el polvo costero aceleran la corrosión y el sobrecalentamiento de los equipos. El soporte preventivo prolonga la vida útil del hardware y reduce los paros operativos costosos.' 
  },
  { 
    question: '¿Manejan soporte técnico para hoteles y restaurantes en Cancún?', 
    answer: 'Sí. Ofrecemos pólizas especiales y soporte de TI prioritario para la industria hotelera y restaurantera en Cancún, cubriendo áreas críticas como computadoras de recepción, sistemas de reservas, terminales de punto de venta (POS), impresoras de comandas, redes de facturación CFDI y estabilidad de la red de WiFi empresarial para huéspedes.' 
  },
  { 
    question: '¿Incluye la administración de altas, bajas y accesos de personal?', 
    answer: 'Sí. Como parte de nuestro servicio de administración de sistemas y soporte TI empresarial, nos encargamos de preparar equipos informáticos para nuevos colaboradores, configurar correos corporativos, asignar accesos compartidos y carpetas de red, y realizar respaldos de información y resguardo de datos cuando un colaborador se retira de la empresa.' 
  },
  { 
    question: '¿Facturan los servicios de mantenimiento y soporte de sistemas?', 
    answer: 'Sí. Todos nuestros servicios de soporte técnico, pólizas mensuales de TI, mantenimiento de flotillas e instalaciones de red cuentan con facturación mexicana CFDI vigente para facilitar los procesos contables y administrativos de tu negocio.' 
  },
];

const zones = [
  'Cancún Centro', 'Zona Hotelera', 'Avenida Huayacán', 'Avenida Cobá', 'Avenida Bonampak', 
  'Avenida Tulum', 'Cumbres', 'Alfredo V. Bonfil', 'Puerto Cancún', 'Puerto Juárez', 
  'Polígono Sur', 'Supermanzanas', 'Haciendas'
];

const relatedItems = [
  { href: '/servicios/b2b/soporte-oficinas', icon: 'fa-building', label: 'Soporte TI para oficinas', desc: 'Soporte técnico de computadoras, impresoras, servidores y red local en Cancún.', cta: 'Ver servicio →' },
  { href: '/servicios/b2b/soporte-hoteles', icon: 'fa-hotel', label: 'Soporte TI para hoteles', desc: 'Asistencia para sistemas de recepción, terminales operativas e impresión continua.', cta: 'Ver servicio →' },
  { href: '/servicios/b2b/soporte-restaurantes', icon: 'fa-utensils', label: 'Soporte TI para restaurantes', desc: 'Configuración de puntos de venta (POS), comandas, red local e impresoras térmicas.', cta: 'Ver servicio →' },
  { href: '/servicios/b2b/wifi-empresarial', icon: 'fa-wifi', label: 'Redes y WiFi empresarial', desc: 'Instalación de cableado estructurado, access points, switches y routers.', cta: 'Ver servicio →' },
  { href: '/servicios/b2b/polizas-mantenimiento', icon: 'fa-file-contract', label: 'Pólizas de mantenimiento TI', desc: 'Contratos mensuales de soporte técnico y visitas programadas en Cancún.', cta: 'Ver servicio →' },
];

const supportMap = [
  ['fa-desktop', 'Soporte de hardware y sistemas', 'Mantenimiento preventivo y correctivo de computadoras de escritorio, laptops y estaciones de trabajo HP, Dell, Lenovo y Apple.'],
  ['fa-shield-halved', 'Limpieza y mantenimiento térmico', 'Limpieza interna de equipos, soplado de ventiladores, cambio de pasta térmica de alto rendimiento y prevención de corrosión.'],
  ['fa-windows', 'Software y sistemas operativos', 'Instalación y optimización de Windows, macOS, configuración de paquetería de oficina, antivirus corporativos y software administrativo.'],
  ['fa-print', 'Soporte de impresoras y periféricos', 'Configuración de impresoras compartidas, escáneres en red, terminales POS de cobro y periféricos indispensables para tu oficina.'],
  ['fa-wifi', 'Instalación de redes y WiFi', 'Diseño de redes locales, cableado estructurado, routers, access points y optimización de WiFi empresarial para evitar lentitud de internet.'],
  ['fa-cloud-arrow-up', 'Respaldos y seguridad de datos', 'Implementación de políticas de copia de seguridad local y en la nube de archivos empresariales y bases de datos críticas.'],
];

const incidentSteps = [
  { title: 'Análisis y clasificación de impacto', description: 'Determinamos rápidamente si la falla bloquea la operación general del negocio (recepción, cajas de cobro, facturación CFDI) o si es una incidencia de menor prioridad.' },
  { title: 'Contención y aislamiento de riesgo', description: 'Aplicamos medidas inmediatas para resguardar archivos importantes, desconectar hardware defectuoso y evitar fallas en cascada en tu red local.' },
  { title: 'Restauración del servicio y continuidad', description: 'Implementamos la solución técnica definitiva o habilitamos una vía alterna de contingencia para que tus colaboradores retomen el trabajo sin demora.' },
  { title: 'Reporte técnico y medidas preventivas', description: 'Documentamos todo lo realizado en el ticket empresarial, identificamos la raíz de la falla y sugerimos mejoras en el mantenimiento de las computadoras.' },
];

const schemas = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Soporte TI empresarial en Cancún', serviceType: 'Soporte TI empresarial', url: canonicalUrl, description: pageDescription, areaServed: { '@type': 'City', name: 'Cancún' }, provider: { '@type': 'LocalBusiness', name: 'Pixon PC / Rentalap', telephone: '+52 998 669 0777', email: 'pixonpc@gmail.com', address: { '@type': 'PostalAddress', streetAddress: 'Cto. Hacienda Chimay', addressLocality: 'Cancún', addressRegion: 'Q.R.', postalCode: '77539', addressCountry: 'MX' } } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://pixon.com.mx/' }, { '@type': 'ListItem', position: 2, name: 'Soporte TI para empresas', item: canonicalUrl }] },
];
---

<Base title={pageTitle} description={pageDescription} canonical={canonicalUrl} image="/assets/images/soporte-hoteles-hero.webp" schema={schemas}>
  <Navbar />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Soporte TI para empresas' }]} />

  <div class="business-page">
    
    <!-- REDISEÑADO HERO SECCIÓN EMPRESAS -->
    <section class="business-hero section-dark">
      <div class="business-hero-glow"></div>
      <div class="business-shell business-hero__layout">
        <div class="business-hero__copy">
          <span class="business-kicker"><i class="fa-solid fa-building-shield"></i> Pólizas Mensuales de Soporte TI en Cancún</span>
          <h1>Soporte técnico para empresas y mantenimiento de computadoras en Cancún</h1>
          <p>
            Asegura la continuidad de tus oficinas, hoteles, agencias y negocios con un equipo de sistemas dedicado. Nos encargamos del <strong>mantenimiento preventivo de computadoras y laptops</strong> por lote, limpieza interna de equipos de cómputo, <strong>administración de redes y WiFi empresarial</strong>, igualas de soporte técnico mensuales y soluciones tecnológicas diseñadas para evitar la inactividad de tu personal.
          </p>
          <div class="business-actions">
            <a class="business-btn business-btn--primary" href="#ticket-enterprise"><i class="fa-solid fa-clipboard-check"></i> Solicitar cotización de póliza</a>
            <a class="business-btn business-btn--whatsapp" href="https://wa.me/529986690777?text=Hola,%20requiero%20información%20sobre%20las%20pólizas%20de%20soporte%20TI%20y%20mantenimiento%20preventivo%20para%20mi%20empresa%20en%20Cancún." target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-whatsapp"></i> Hablar con un técnico por WhatsApp</a>
          </div>
          <div class="business-hero__proof">
            <span><i class="fa-solid fa-file-invoice-dollar"></i> Facturación CFDI deducible</span>
            <span><i class="fa-solid fa-business-time"></i> Soporte por urgencia técnica</span>
            <span><i class="fa-solid fa-clipboard-list"></i> Inventario de equipos de cómputo</span>
          </div>
        </div>
        <div class="business-hero__visual">
          <div class="business-hero__visual-inner">
            <img src="/assets/images/soporte-hoteles-hero.webp" alt="Soporte técnico de computadoras, redes y servidores para empresas en Cancún — Pixon PC" width="1200" height="900" loading="eager" fetchpriority="high" decoding="async" />
            <div class="business-hero__status">
              <span class="status-pulse-dot"></span>
              <div>
                <span>Soporte TI activo en Cancún</span>
                <strong>Mesa de ayuda presencial y remota</strong>
              </div>
            </div>
            <div class="business-hero__priority">
              <span>Soporte de sistemas</span>
              <strong>Continuidad de negocio sin retrasos</strong>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- MAPA DE SOPORTE -->
    <section class="business-map">
      <div class="business-shell">
        <header class="business-heading">
          <span>Outsourcing de TI en Cancún</span>
          <h2>Servicio técnico de computadoras, redes y soporte de sistemas en Cancún</h2>
          <p>Unificamos todas las fallas de hardware, software, lentitud de red, sobrecalentamiento, respaldos de información, limpieza de equipos y telefonía en un canal de soporte técnico simplificado.</p>
        </header>
        <div class="business-map__grid">
          {supportMap.map(([icon, title, description], index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <i class={`fa-solid ${icon}`}></i>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CONTINUIDAD OPERATIVA -->
    <section class="business-priority">
      <div class="business-priority__image" role="img" aria-label="Mantenimiento preventivo de computadoras y soporte de redes de oficina en Cancún"></div>
      <div class="business-shell business-priority__content">
        <span>Prioridad Operativa Garantizada</span>
        <h2>¿Por qué contratar una póliza de mantenimiento preventivo y soporte TI en Cancún?</h2>
        <p>Una computadora lenta o problemas menores de software pueden calendarizarse; una falla en la red de la oficina, problemas con la facturación electrónica, caídas del WiFi empresarial o el equipo de recepción de un hotel detenido requieren atención de urgencia. Clasificamos las incidencias por niveles de impacto técnico:</p>
        <div>
          <strong>Prioridad Crítica</strong><span>Sistemas de ventas, cajas de cobro, servidores locales, facturación CFDI y enlaces de red primarios.</span>
          <strong>Prioridad Operativa</strong><span>Soporte de sistemas para usuarios individuales, impresoras de red compartidas y paquetería de oficina.</span>
          <strong>Servicio Programable</strong><span>Mantenimiento preventivo de computadoras por lote, limpieza de flotilla de laptops, upgrades de hardware e inventarios.</span>
        </div>
      </div>
    </section>

    <!-- CICLO DE VIDA -->
    <section class="business-lifecycle">
      <div class="business-shell">
        <header class="business-heading">
          <span>Ciclo de hardware empresarial</span>
          <h2>Administración de sistemas informáticos y ciclo de vida de los equipos</h2>
          <p>La eficiencia de tu personal en Cancún mejora cuando cada computadora tiene un responsable asignado, historial de mantenimiento preventivo y actualizaciones de sistema programadas.</p>
        </header>
        <ol>
          <li><strong>01</strong><h3>Alta de personal</h3><p>Preparación de la computadora o laptop, configuración de usuarios, correo corporativo, impresoras locales y programas necesarios para su área de trabajo.</p></li>
          <li><strong>02</strong><h3>Soporte TI activo</h3><p>Atención oportuna de fallas diarias, optimización de velocidad de Windows, antivirus comercial, soporte técnico de red y resolución de dudas de usuarios.</p></li>
          <li><strong>03</strong><h3>Mantenimiento de cómputo</h3><p>Limpieza interna de hardware, remoción de polvo costero, cambio de pasta térmica en procesadores, revisión de batería de laptops y diagnóstico de discos duros o SSD.</p></li>
          <li><strong>04</strong><h3>Reasignación segura</h3><p>Respaldo de información completo, formateo seguro del equipo, limpieza de perfiles y reinstalación de programas para un nuevo colaborador en la oficina.</p></li>
          <li><strong>05</strong><h3>Baja de equipo</h3><p>Retiro ordenado de accesos del usuario saliente, respaldo y resguardo de datos críticos, y diagnóstico final para determinar si el equipo es apto para donación, actualización o desecho.</p></li>
        </ol>
      </div>
    </section>

    <!-- RESPUESTA A INCIDENTES -->
    <DarkTechnicalSection 
      id="respuesta-incidentes" 
      eyebrow="Resolución de fallas técnicas" 
      title="Soporte técnico de computadoras en Cancún: primero estabilizamos la operación, luego prevenimos fallas" 
      description="Una computadora que se calienta y se apaga sola, una red inestable o la pérdida de datos inesperada requieren un protocolo ordenado. Actuamos con rapidez y documentamos las soluciones aplicadas." 
      steps={incidentSteps} 
      topFadeColor="#ffffff" 
      bottomFadeColor="#f4f8fb" 
    />

    <!-- CONTROL ADMINISTRATIVO -->
    <section class="business-control">
      <div class="business-shell business-control__layout">
        <header>
          <span>Control administrativo de TI</span>
          <h2>Auditoría de computadoras, inventario de sistemas e historial de mantenimiento</h2>
          <p>Ayudamos a los directores y administradores en Cancún a conocer con certeza qué equipos existen, quién los tiene a su cargo, qué incidencias reportan y cuándo es rentable realizar una renovación de hardware.</p>
        </header>
        <div class="business-register">
          <div class="business-register__top"><strong>Inventario operativo de hardware</strong><span>Vista administrativa</span></div>
          <div class="business-register__row"><b>LT-ADM-04</b><span>Mantenimiento Preventivo</span><i>Limpieza y pasta térmica aplicada</i><strong>Operativo</strong></div>
          <div class="business-register__row"><b>PC-REC-02</b><span>Recepción Hotel</span><i>Reemplazo de SSD y mantenimiento</i><strong>Prioridad Crítica</strong></div>
          <div class="business-register__row"><b>IMP-CAJA-01</b><span>Impresora de Cajas</span><i>Red y WiFi configurados</i><strong>Operativo</strong></div>
          <div class="business-register__summary"><span>Identificador</span><span>Área asignada</span><span>Historial técnico</span><span>Estatus de operación</span></div>
        </div>
      </div>
    </section>

    <!-- SOLUCIONES Y TEMAS ADICIONALES -->
    <section class="business-new-topics">
      <div class="business-shell">
        <header class="business-heading">
          <span>Soluciones de tecnología empresarial</span>
          <h2>Servicios de TI y consultoría técnica para mejorar la productividad en tu oficina</h2>
          <p>Además de la reparación de computadoras e impresoras, cubrimos las necesidades informáticas diarias de tu negocio en Cancún para que tu equipo de trabajo solo se enfoque en vender.</p>
        </header>
        <div class="business-topics-grid">
          <article><i class="fa-solid fa-user-plus"></i><h3>Altas y bajas de personal</h3><p>Configuración de equipos, cuentas de usuario, correos electrónicos, perfiles de red corporativos e impresoras compartidas.</p></article>
          <article><i class="fa-solid fa-shield-halved"></i><h3>Seguridad de la información</h3><p>Instalación de licencias de antivirus corporativo, administración de firewalls, actualizaciones de Windows y eliminación de malware o virus.</p></article>
          <article><i class="fa-solid fa-cloud-arrow-up"></i><h3>Respaldo y backup automático</h3><p>Diseño e implementación de políticas de respaldo automático en la nube y discos duros locales NAS para no perder archivos de contabilidad o ventas.</p></article>
          <article><i class="fa-solid fa-video"></i><h3>Soporte para salas de juntas</h3><p>Configuración e instalación de pantallas, cámaras web de alta resolución, micrófonos omnidireccionales y WiFi estable para videollamadas fluidas.</p></article>
          <article><i class="fa-solid fa-house-laptop"></i><h3>Soporte para trabajo híbrido</h3><p>Configuración de conexiones remotas VPN seguras, laptops de trabajo y periféricos para un home office productivo y sin fallas en Cancún.</p></article>
          <article><i class="fa-solid fa-cart-shopping"></i><h3>Compras de equipo y renovación</h3><p>Consultoría técnica en la adquisición de computadoras, discos SSD, memoria RAM y servidores, maximizando el retorno de tu inversión.</p></article>
        </div>
      </div>
    </section>

    <!-- PREVENCIÓN POR LOTE -->
    <section class="business-maintenance">
      <div class="business-shell">
        <header>
          <span>Póliza de mantenimiento de flotillas</span>
          <h2>Mantenimiento preventivo de computadoras por lote y limpieza de hardware sin paros en la oficina</h2>
          <p>Para evitar que el calor y la humedad de Cancún secan la pasta térmica y dañen el disipador, programamos limpiezas internas profundas. Organizamos los mantenimientos en horarios flexibles o fines de semana para no interferir con las actividades diarias de tu personal.</p>
        </header>
        <div class="business-maintenance__flow">
          <div><strong>Diagnóstico Inicial</strong><span>Evaluación de hardware y temperaturas</span></div>
          <i class="fa-solid fa-arrow-right"></i>
          <div><strong>Planificación</strong><span>Calendario de limpiezas por lotes de computadoras</span></div>
          <i class="fa-solid fa-arrow-right"></i>
          <div><strong>Intervención física</strong><span>Limpieza interna de ventiladores y cambio de pasta térmica</span></div>
          <i class="fa-solid fa-arrow-right"></i>
          <div><strong>Reporte técnico</strong><span>Fotografías de antes y después de cada equipo</span></div>
        </div>
      </div>
    </section>

    <!-- DATOS Y RECUPERACIÓN -->
    <section class="business-data">
      <div class="business-shell business-data__layout">
        <div>
          <span>Resguardo de información</span>
          <h2>Protección y recuperación de datos empresarial antes de cualquier reparación o formateo</h2>
          <p>Los archivos de tu empresa son el activo más valioso. Antes de realizar cambios de disco duro, formateos de sistema o actualizaciones de sistema operativo, realizamos un respaldo preventivo de todas tus carpetas importantes, bases de datos y correos configurados.</p>
        </div>
        <dl>
          <div><dt>Respaldo Operativo</dt><dd>Copia de seguridad rápida de archivos de contabilidad, administración o facturas antes de cualquier servicio técnico en taller.</dd></div>
          <div><dt>Migración de datos</dt><dd>Pasamos toda la información de una laptop o PC vieja a una computadora nueva de manera transparente y sin perder archivos o configuraciones.</dd></div>
          <div><dt>Recuperación de archivos</dt><dd>Si un disco duro de tu oficina dejó de funcionar, no arranca o tiene sectores dañados, aplicamos métodos para recuperar la información.</dd></div>
          <div><dt>Borrado seguro</dt><dd>Cuando una computadora de la flotilla se da de baja, eliminamos de forma permanente los archivos confidenciales antes del reciclaje del equipo.</dd></div>
        </dl>
      </div>
    </section>

    <!-- SECTORES DE ATENCIÓN -->
    <section class="business-sectors">
      <div class="business-shell">
        <header class="business-heading">
          <span>Servicio TI a la medida</span>
          <h2>Igualas de soporte técnico especializadas según las necesidades de tu sector en Cancún</h2>
          <p>No aplicamos el mismo flujo de soporte de sistemas a una oficina administrativa, un hotel corporativo, una agencia de viajes o un restaurante en la Zona Hotelera.</p>
        </header>
        <div class="business-sector-list">
          <a href="/servicios/b2b/soporte-oficinas"><span>01</span><i class="fa-solid fa-building" aria-hidden="true"></i><strong>Oficinas Corporativas</strong><p>Soporte de impresoras en red, optimización de velocidad de computadoras, redes WiFi estables y software de oficina.</p><b>Administración fluida</b><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
          <a href="/servicios/b2b/soporte-hoteles"><span>02</span><i class="fa-solid fa-hotel" aria-hidden="true"></i><strong>Hoteles y Hostales</strong><p>Atención a computadoras de recepción 24/7, sistemas de reservas, red de huéspedes e impresión en punto de venta.</p><b>Continuidad hotelera</b><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
          <a href="/servicios/b2b/soporte-restaurantes"><span>03</span><i class="fa-solid fa-utensils" aria-hidden="true"></i><strong>Restaurantes y Cafeterías</strong><p>Soporte técnico para terminales de cobro (POS), impresoras de comandas, switches de comunicación y estabilidad en horas de alta demanda.</p><b>Ventas sin interrupción</b><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
          <a href="/servicios/b2b/soporte-agencias"><span>04</span><i class="fa-solid fa-pen-ruler" aria-hidden="true"></i><strong>Agencias Creativas y de Viajes</strong><p>Rendimiento para software de diseño gráfico, edición de video, almacenamiento en la nube y configuración de laptops gamer de alto desempeño.</p><b>Productividad creativa</b><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </div>
      </div>
    </section>

    <!-- COBERTURA LOCAL -->
    <section class="business-zones">
      <div class="business-shell business-zones__layout">
        <div>
          <span>Cobertura de servicio de TI</span>
          <h2>Soporte técnico para empresas y oficinas en todo Cancún</h2>
          <p>Coordinamos visitas de mantenimiento preventivo de computadoras por lote y soporte presencial de red en las principales áreas de negocios y comerciales de Cancún, Quintana Roo.</p>
        </div>
        <div class="business-zone-cloud">
          {zones.map((zone) => <span>{zone}</span>)}
        </div>
      </div>
    </section>

    <!-- LLAMADA A LA ACCIÓN -->
    <section class="business-cta">
      <div class="business-shell">
        <div>
          <span>Mesa de ayuda técnica</span>
          <h2>¿Cuántas computadoras tiene tu empresa y qué problemas presentan?</h2>
