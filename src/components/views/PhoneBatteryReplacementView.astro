<style is:global>
/* VARIABLES Y SISTEMA DE COLOR */
.phone-battery-page {
  --azul-oscuro: #071F3A;
  --pb-ink: #071F3A;
  --pb-blue: #0f5ea8;
  --pb-cyan: #0ea5e9;
  --pb-green: #16a34a;
  --pb-amber: #f59e0b;
  --pb-red: #ef4444;
  --pb-soft: #f8fbff;
  --pb-card-bg: #ffffff;
  --pb-border: rgba(7, 31, 58, 0.12);
  --pb-border-focus: #0ea5e9;
  color: var(--pb-ink);
  background: var(--pb-soft);
  overflow-x: hidden;
}

.phone-battery-page h1,
.phone-battery-page h2,
.phone-battery-page h3 {
  font-family: 'Kanit', sans-serif;
  letter-spacing: -0.01em;
  text-wrap: balance;
}

/* REGLA AGENTS.MD: Todo texto fuera del hero debe usar --azul-oscuro: #071F3A */
.phone-battery-page section:not(.pb-hero),
.phone-battery-page section:not(.pb-hero) h2,
.phone-battery-page section:not(.pb-hero) h3,
.phone-battery-page section:not(.pb-hero) p,
.phone-battery-page section:not(.pb-hero) span,
.phone-battery-page section:not(.pb-hero) strong,
.phone-battery-page section:not(.pb-hero) li,
.phone-battery-page section:not(.pb-hero) small {
  color: var(--azul-oscuro);
}

/* HERO SECTION */
.pb-hero {
  position: relative;
  min-height: 640px;
  display: grid;
  align-items: center;
  padding: 56px 0 48px;
  color: #f8fafc;
  background:
    radial-gradient(circle at 80% 20%, rgba(14, 165, 233, 0.32), transparent 35%),
    radial-gradient(circle at 90% 80%, rgba(22, 163, 74, 0.22), transparent 30%),
    linear-gradient(135deg, #050e1a 0%, #071F3A 55%, #0a294d 100%);
}

.pb-hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(320px, 0.85fr);
  gap: clamp(24px, 4vw, 48px);
  align-items: center;
}

.pb-hero-copy {
  max-width: 720px;
}

.pb-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 14px;
  padding: 6px 14px;
  border-radius: 999px;
  background: rgba(14, 165, 233, 0.15);
  border: 1px solid rgba(56, 189, 248, 0.35);
  color: #7dd3fc;
  font-size: 0.82rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.pb-hero h1 {
  margin: 0 0 14px;
  color: #ffffff;
  font-size: clamp(2.2rem, 4.5vw, 4.2rem);
  line-height: 1.02;
}

.pb-hero-sub {
  margin: 0 0 24px;
  color: #dbeafe;
  font-size: clamp(1.05rem, 1.8vw, 1.25rem);
  line-height: 1.55;
  text-wrap: pretty;
}

.pb-hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 22px;
}

.pb-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 48px;
  padding: 12px 20px;
  border-radius: 12px;
  font-weight: 800;
  font-size: 0.95rem;
  text-decoration: none;
  border: 1px solid transparent;
  transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1), background-color 180ms ease, box-shadow 180ms ease;
}

.pb-btn:active {
  transform: scale(0.97);
}

.pb-btn-primary {
  background: var(--pb-green);
  color: #ffffff !important;
  box-shadow: 0 12px 28px rgba(22, 163, 74, 0.28);
}

.pb-btn-primary:hover {
  background: #15803d;
}

.pb-btn-secondary {
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.25);
  color: #ffffff !important;
}

.pb-btn-secondary:hover {
  background: rgba(255, 255, 255, 0.2);
}

.pb-btn-urgent {
  background: #dc2626;
  color: #ffffff !important;
  box-shadow: 0 10px 24px rgba(220, 38, 38, 0.3);
}

.pb-btn-light {
  background: #ffffff;
  border-color: rgba(7, 31, 58, 0.2);
  color: var(--azul-oscuro) !important;
}

.pb-hero-trust {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.pb-trust-chip {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 6px 12px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.14);
  color: #e2e8f0;
  font-size: 0.84rem;
  font-weight: 700;
}

.pb-trust-chip i {
  color: #4ade80;
}

/* ANIMACIÓN SVG + CSS DEL HERO — V2 CINEMATOGRÁFICO */
.pb-hero-visual {
  display: grid;
  place-items: center;
  position: relative;
  isolation: isolate;
}

.pb-stage {
  position: relative;
  width: min(100%, 360px);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Ambient glow orbs behind the phone */
.pb-ambient-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(60px);
  pointer-events: none;
  z-index: -1;
}
.pb-orb-1 {
  width: 220px;
  height: 220px;
  background: rgba(14, 165, 233, 0.25);
  top: 10%;
  left: -20%;
  animation: pbOrbFloat1 13s infinite ease-in-out;
}
.pb-orb-2 {
  width: 180px;
  height: 180px;
  background: rgba(239, 68, 68, 0.18);
  bottom: 15%;
  right: -15%;
  animation: pbOrbFloat2 13s infinite ease-in-out;
}

@keyframes pbOrbFloat1 {
  0%, 100% { transform: translate(0, 0) scale(1); background: rgba(239, 68, 68, 0.2); }
  30% { background: rgba(245, 158, 11, 0.25); }
  58% { transform: translate(20px, -15px) scale(1.15); background: rgba(14, 165, 233, 0.3); }
  82% { transform: translate(-10px, 10px) scale(1.05); background: rgba(34, 197, 94, 0.25); }
}
@keyframes pbOrbFloat2 {
  0%, 100% { transform: translate(0, 0) scale(1); background: rgba(239, 68, 68, 0.15); }
  45% { transform: translate(-15px, 10px) scale(1.2); background: rgba(220, 38, 38, 0.25); }
  68% { background: rgba(59, 130, 246, 0.2); }
  82% { transform: translate(10px, -8px) scale(0.95); background: rgba(34, 197, 94, 0.2); }
}

.pb-phone-svg {
  width: 100%;
  height: auto;
  filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.55)) drop-shadow(0 8px 20px rgba(0, 0, 0, 0.3));
  animation: pbPhoneFloat 6s infinite ease-in-out;
}

@keyframes pbPhoneFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6px); }
}

/* Badge dots */
.pb-badge-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  display: inline-block;
  flex-shrink: 0;
  animation: pbDotPulse 2s infinite ease-in-out;
}
@keyframes pbDotPulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.7); }
}

/* Badges dinámicos — barra ENCIMA del teléfono */
.pb-state-badges {
  position: relative;
  width: 100%;
  height: 44px;
  display: grid;
  place-items: center;
  margin-bottom: 12px;
  pointer-events: none;
  z-index: 5;
}

.pb-badge-state {
  position: absolute;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 20px;
  border-radius: 999px;
  font-size: 0.82rem;
  font-weight: 800;
  white-space: nowrap;
  opacity: 0;
  transform: translateY(-8px) scale(0.92);
  backdrop-filter: blur(12px);
  box-shadow: 0 6px 24px rgba(0,0,0,0.3);
  letter-spacing: 0.01em;
}

.pb-state-1 {
  background: rgba(239, 68, 68, 0.92);
  color: #ffffff;
  border: 1px solid rgba(239, 68, 68, 0.5);
  animation: pbState1 13s infinite cubic-bezier(0.23, 1, 0.32, 1);
}
.pb-state-2 {
  background: rgba(249, 115, 22, 0.92);
  color: #ffffff;
  border: 1px solid rgba(249, 115, 22, 0.5);
  animation: pbState2 13s infinite cubic-bezier(0.23, 1, 0.32, 1);
}
.pb-state-3 {
  background: rgba(245, 158, 11, 0.92);
  color: #071f3a;
  border: 1px solid rgba(245, 158, 11, 0.5);
  animation: pbState3 13s infinite cubic-bezier(0.23, 1, 0.32, 1);
}
.pb-state-4 {
  background: rgba(220, 38, 38, 0.92);
  color: #ffffff;
  border: 1px solid rgba(220, 38, 38, 0.5);
  animation: pbState4 13s infinite cubic-bezier(0.23, 1, 0.32, 1);
}
.pb-state-5 {
  background: rgba(14, 165, 233, 0.92);
  color: #ffffff;
  border: 1px solid rgba(14, 165, 233, 0.5);
  animation: pbState5 13s infinite cubic-bezier(0.23, 1, 0.32, 1);
}
.pb-state-6 {
  background: rgba(59, 130, 246, 0.92);
  color: #ffffff;
  border: 1px solid rgba(59, 130, 246, 0.5);
  animation: pbState6 13s infinite cubic-bezier(0.23, 1, 0.32, 1);
}
.pb-state-7 {
  background: rgba(22, 163, 74, 0.92);
  color: #ffffff;
  border: 1px solid rgba(34, 197, 94, 0.5);
  box-shadow: 0 0 24px rgba(34, 197, 94, 0.45), 0 4px 20px rgba(0,0,0,0.2);
  animation: pbState7 13s infinite cubic-bezier(0.23, 1, 0.32, 1);
}

/* Telemetría — Glassmorphism upgrade */
.pb-diag-telemetry {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 4px;
  width: 100%;
  margin-top: -24px;
  padding: 12px 10px;
  border-radius: 14px;
  background: rgba(7, 19, 38, 0.88);
  border: 1px solid rgba(56, 189, 248, 0.2);
  backdrop-filter: blur(12px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.3), inset 0 1px 0 rgba(56, 189, 248, 0.1);
  z-index: 2;
  animation: pbTelemFade 13s infinite;
}

@keyframes pbTelemFade {
  0%, 56% { opacity: 0.5; border-color: rgba(56, 189, 248, 0.1); }
  58%, 67% { opacity: 1; border-color: rgba(56, 189, 248, 0.4); box-shadow: 0 8px 32px rgba(0,0,0,0.3), 0 0 20px rgba(14, 165, 233, 0.15), inset 0 1px 0 rgba(56, 189, 248, 0.2); }
  68%, 100% { opacity: 0.6; border-color: rgba(56, 189, 248, 0.15); }
}

.pb-telem-item {
  text-align: center;
  padding: 4px 2px;
}

.pb-telem-item small {
  display: block;
  font-size: 0.6rem;
  color: #64748b;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 2px;
}

.pb-telem-val {
  display: block;
  font-size: 0.78rem;
  color: #38bdf8;
  font-weight: 800;
  font-family: 'Courier New', monospace;
}

.pb-telem-ok {
  color: #4ade80 !important;
}

/* ============ SVG ELEMENT ANIMATIONS (15s loop) ============ */

/* --- Status bar battery icon color sync --- */
.pb-ui-batt-fill {
  animation: pbUIBatt 15s infinite;
}
@keyframes pbUIBatt {
  0%, 14% { fill: #ef4444; width: 4px; }
  15%, 29% { fill: #f97316; width: 6px; }
  30%, 44% { fill: #f59e0b; width: 5px; }
  45%, 57% { fill: #dc2626; width: 3px; }
  58%, 67% { fill: #38bdf8; width: 8px; }
  68%, 81% { fill: #3b82f6; width: 10px; }
  82%, 96% { fill: #22c55e; width: 13px; }
  97%, 100% { fill: #ef4444; width: 4px; }
}

/* --- Damaged cell --- */
.pb-cell-problematic {
  animation: pbProblemCell 15s infinite ease-in-out;
}
.pb-batt-pct {
  fill: #ffffff;
  font-size: 36px;
  font-weight: 900;
  font-family: 'Kanit', sans-serif;
  animation: pbProblemPct 15s infinite;
}
.pb-bolt-icon {
  animation: pbBoltPulse 2s infinite ease-in-out;
}
@keyframes pbBoltPulse {
  0%, 100% { opacity: 0.85; transform: translate(77px, 100px) scale(1); }
  50% { opacity: 0.5; transform: translate(77px, 100px) scale(0.9); }
}

/* --- Screen UI elements --- */
.pb-screen-ui {
  animation: pbScreenUI 15s infinite;
}
.pb-pct-ring {
  animation: pbPctRing 15s infinite;
  transition: stroke 0.5s ease;
}
.pb-screen-pct {
  animation: pbScreenPctText 15s infinite;
}
@keyframes pbScreenUI {
  0%, 67% { opacity: 1; }
  68%, 81% { opacity: 0.3; }
  82%, 96% { opacity: 1; }
  97%, 100% { opacity: 1; }
}
@keyframes pbPctRing {
  0%, 14% { stroke: #ef4444; stroke-dasharray: 33 294; }
  15%, 29% { stroke: #f97316; stroke-dasharray: 33 294; }
  30%, 44% { stroke: #f59e0b; stroke-dasharray: 33 294; }
  45%, 57% { stroke: #dc2626; stroke-dasharray: 20 307; }
  58%, 67% { stroke: #38bdf8; stroke-dasharray: 164 163; }
  68%, 81% { stroke: #3b82f6; stroke-dasharray: 260 67; }
  82%, 96% { stroke: #22c55e; stroke-dasharray: 327 0; }
  97%, 100% { stroke: #ef4444; stroke-dasharray: 33 294; }
}
@keyframes pbScreenPctText {
  0%, 14% { fill: #ffffff; }
  58%, 67% { fill: #38bdf8; }
  82%, 96% { fill: #4ade80; }
  97%, 100% { fill: #ffffff; }
}
.pb-stat-health {
  animation: pbStatHealth 15s infinite;
}
@keyframes pbStatHealth {
  0%, 57% { fill: #ef4444; }
  58%, 67% { fill: #38bdf8; }
  68%, 81% { fill: #3b82f6; }
  82%, 96% { fill: #22c55e; }
  97%, 100% { fill: #ef4444; }
}

/* --- Healthy cell --- */
.pb-cell-healthy {
  opacity: 0;
  animation: pbHealthyCell 15s infinite ease-in-out;
}
.pb-healthy-pct {
  fill: #ffffff;
  font-size: 36px;
  font-weight: 900;
  font-family: 'Kanit', sans-serif;
}

/* Shimmer sweep on healthy cell */
.pb-shimmer {
  opacity: 0;
  animation: pbShimmerSweep 15s infinite linear;
}
@keyframes pbShimmerSweep {
  0%, 67% { opacity: 0; transform: translateX(-50px); }
  72% { opacity: 1; transform: translateX(0); }
  78% { opacity: 1; transform: translateX(140px); }
  82%, 100% { opacity: 0; transform: translateX(180px); }
}

/* --- LED indicator --- */
.pb-led-indicator {
  animation: pbLedColor 15s infinite;
}
.pb-led-glow {
  animation: pbLedGlow 15s infinite;
}
@keyframes pbLedColor {
  0%, 57% { fill: #ef4444; }
  58%, 67% { fill: #38bdf8; }
  68%, 81% { fill: #3b82f6; }
  82%, 96% { fill: #22c55e; }
  97%, 100% { fill: #ef4444; }
}
@keyframes pbLedGlow {
  0%, 57% { fill: rgba(239,68,68,0.25); r: 8; }
  58%, 67% { fill: rgba(56,189,248,0.3); r: 10; }
  68%, 81% { fill: rgba(59,130,246,0.25); r: 9; }
  82%, 96% { fill: rgba(34,197,94,0.35); r: 12; }
  97%, 100% { fill: rgba(239,68,68,0.25); r: 8; }
}

/* --- Thermal waves (State 3) --- */
.pb-thermal-wave {
  opacity: 0;
  transform-origin: 120px 105px;
  animation: pbThermalPulse 15s infinite;
}
.pb-thermal-wave.wave-2 {
  animation-delay: 0.3s;
}
.pb-thermal-wave.wave-3 {
  animation-delay: 0.6s;
}

/* --- Tapa separation (State 4) --- */
.pb-tapa-borde {
  opacity: 0;
  animation: pbTapaSeparation 15s infinite;
}

/* --- Electrical sparks (State 4) --- */
.pb-sparks {
  opacity: 0;
  animation: pbSparksFlashes 15s infinite;
}

/* --- Diagnostic grid (State 5) --- */
.pb-diag-grid {
  opacity: 0;
  animation: pbDiagGrid 15s infinite;
}

/* --- Scan beam (State 5) --- */
.pb-scan-beam {
  opacity: 0;
  animation: pbScanBeam 15s infinite linear;
}
.pb-scan-line {
  animation: pbScanMove 15s infinite linear;
}
.pb-scan-trail {
  animation: pbScanTrail 15s infinite linear;
}

/* --- Energy particles --- */
.pb-particle {
  opacity: 0;
}
.pb-particle.p1 {
  animation: pbParticle1 15s infinite ease-in-out;
}
.pb-particle.p2 {
  animation: pbParticle2 15s infinite ease-in-out 0.5s;
}
.pb-particle.p3 {
  animation: pbParticle3 15s infinite ease-in-out 1s;
}
.pb-particle.p4 {
  animation: pbParticle4 15s infinite ease-in-out 0.3s;
}
.pb-particle.p5 {
  animation: pbParticle5 15s infinite ease-in-out 0.7s;
