---
// PhoneBatteryReplacementView.astro - Cambio de batería de celular en Cancún (Multimarca / General)
const { service, category } = Astro.props;

import FaqSection from '../FaqSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import Footer from '../Footer.astro';

const waMessage = encodeURIComponent('Hola, quiero cotizar cambio de batería de celular en Cancún. Mi equipo se descarga rápido, se apaga, se calienta o tiene batería inflada. ¿Me podrían asesorar?');

