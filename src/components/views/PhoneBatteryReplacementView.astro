  'Diagnóstico primero',
  'Cotización antes de instalar',
  'Pruebas de carga y temperatura',
];

const symptoms = [
  {
    title: 'La batería dura pocas horas',
    text: 'El porcentaje disminuye rápidamente incluso con poco uso, pierde energía durante la noche o exige conectarlo varias veces al día.',
    icon: 'fa-battery-quarter',
  },
  {
    title: 'El celular se apaga con porcentaje',
    text: 'Marca 20%, 30% o más y se apaga de golpe al abrir la cámara, usar datos móviles, GPS o reproducir contenido de alto consumo.',
