---
// IphoneHumidityRepairView.astro — Reparación de iPhone Mojado / por Humedad en Cancún
// SEO local | Pixon PC
const { service, category } = Astro.props;

import FaqSection from '../FaqSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import Footer from '../Footer.astro';

const waMsg = encodeURIComponent('Hola, mi iPhone se mojó y quiero cotizar el servicio de diagnóstico y limpieza por humedad en Cancún. Puedo enviar modelo y detalles del caso.');

// ── DATOS ──────────────────────────────────────────────────────────────────

const primerAuxilio = [
  { do: false, icon: 'fa-ban', title: 'NO lo pongas en arroz', desc: 'El arroz no limpia la placa y puede dejar polvo dentro de puertos, bocinas o bandeja SIM. La humedad interna requiere apertura y diagnóstico.' },
  { do: false, icon: 'fa-plug-circle-xmark', title: 'NO lo cargues', desc: 'Introducir corriente eléctrica a un circuito húmedo puede causar cortocircuitos en placa lógica, puerto de carga, batería o sensores internos.' },
  { do: false, icon: 'fa-power-off', title: 'NO intentes encenderlo', desc: 'Si el equipo se apagó solo, déjalo así. Intentar encenderlo fuerza el paso de corriente por áreas mojadas, quemando componentes.' },
  { do: false, icon: 'fa-wind', title: 'NO uses secadora o calor extremo', desc: 'El aire a presión empuja el agua más adentro del iPhone, y el calor excesivo deforma los adhesivos de sellado y daña la batería.' },
  { do: true, icon: 'fa-droplet-slash', title: 'Séquelo superficialmente', desc: 'Usa una toalla de microfibra o absorbente para remover todo el líquido visible en el exterior, ranuras y bandejas.' },
  { do: true, icon: 'fa-sim-card', title: 'Retira la bandeja SIM', desc: 'Saca el porta-SIM de inmediato. Esto abre un canal de ventilación mínimo y te permite ver si el indicador de humedad (LCI) está activado en rojo.' },
  { do: true, icon: 'fa-clock', title: 'Tráelo lo antes posible', desc: 'El tiempo es el peor enemigo. Cada hora cuenta: la corrosión por sulfatación comienza en menos de 24 horas y degrada la placa progresivamente.' },
];

const stats = [
  { num: 'Urgente', label: 'Revisión por humedad', icon: 'fa-heart-circle-check', color: '#06b6d4' },
  { num: '+100', label: 'iPhones atendidos', icon: 'fa-mobile-screen', color: '#3b82f6' },
  { num: '2–4h', label: 'Diagnóstico inicial', icon: 'fa-clock', color: '#22c55e' },
  { num: 'Tina', label: 'Limpieza ultrasónica', icon: 'fa-water', color: '#8b5cf6' },
];

const sintomas = [
  { icon: 'fa-power-off', title: 'El iPhone no enciende', desc: 'El teléfono se apagó después de mojarse y no da señales de vida ni responde al botón.', urgent: true },
  { icon: 'fa-battery-half', title: 'Se calienta demasiado', desc: 'Sientes calor anormal en la parte trasera del iPhone, señal de un cortocircuito activo drenando la batería.', urgent: true },
  { icon: 'fa-mobile-retro', title: 'Pantalla con líneas o parpadeo', desc: 'La pantalla muestra imagen distorsionada, líneas de colores, manchas oscuras o se queda totalmente verde/blanca.', urgent: false },
  { icon: 'fa-hand-pointer', title: 'Touch loco o fantasma', desc: 'La pantalla táctil no responde, tiene zonas muertas o pulsa botones sola sin que la toques.', urgent: false },
  { icon: 'fa-camera', title: 'Cámaras empañadas', desc: 'Ves gotas de condensación, agua o humedad visible en los lentes de la cámara trasera o frontal.', urgent: false },
  { icon: 'fa-volume-xmark', title: 'Audio ahogado o sin sonido', desc: 'Las bocinas distorsionan mucho el sonido, el volumen es extremadamente bajo o el micrófono no capta tu voz.', urgent: false },
  { icon: 'fa-triangle-exclamation', title: 'Fallo de Face ID', desc: 'Aparece un mensaje indicando problemas en la cámara TrueDepth o Face ID ha dejado de registrar tu rostro.', urgent: false },
  { icon: 'fa-plug', title: 'Error de líquido en el puerto', desc: 'El iPhone muestra la advertencia de detección de líquido en el puerto Lightning o USB-C e impide cargarlo.', urgent: false },
];

const proceso = [
  { step: '01', icon: 'fa-stethoscope', title: 'Recepción y apertura inmediata', desc: 'Registramos el tipo de líquido (dulce, salado, cloro) y abrimos el iPhone de inmediato para desconectar la batería y detener el daño.' },
  { step: '02', icon: 'fa-magnifying-glass', title: 'Desarmado completo de componentes', desc: 'Desmontamos pantalla, cámaras, bocinas y blindajes metálicos de la placa para que ningún residuo de agua quede atrapado debajo.' },
  { step: '03', icon: 'fa-shower', title: 'Limpieza ultrasónica de placa', desc: 'Cuando aplica, limpiamos la placa con tina ultrasónica y alcohol isopropílico para remover depósitos de sal, cloro y minerales.' },
  { step: '04', icon: 'fa-wind', title: 'Secado controlado', desc: 'Secamos placa y periféricos con temperatura controlada para reducir humedad atrapada sin deformar adhesivos ni dañar batería.' },
  { step: '05', icon: 'fa-microchip', title: 'Diagnóstico en microscopio de placa', desc: 'Inspeccionamos la placa a nivel micro, buscando soldaduras frías, conectores quemados, capacitores en corto y pistas oxidadas.' },
  { step: '06', icon: 'fa-screwdriver-wrench', title: 'Microsoldadura si es requerida', desc: 'Si hay pistas o componentes dañados, evaluamos reconstrucción de líneas y cambio de circuitos afectados por corrosión.' },
  { step: '07', icon: 'fa-shield-halved', title: 'Reensamble, pruebas e impermeabilización', desc: 'Reensamblamos aplicando un nuevo sello adhesivo contra humedad y polvo, realizando pruebas completas de consumo y funciones.' },
];

const advertencias = [
  { icon: 'fa-triangle-exclamation', color: '#ef4444', title: 'El agua salada acelera la corrosión', desc: 'El salitre del mar es conductor y puede avanzar rápido dentro del iPhone. Si cayó al mar en Cancún, apágalo, no lo cargues y tráelo al taller lo antes posible.' },
  { icon: 'fa-bolt', color: '#f59e0b', title: 'No basta con dejarlo secar al sol', desc: 'El agua puede evaporarse de zonas visibles, pero la humedad queda atrapada bajo blindajes, conectores y cámaras. Ahí puede iniciar corrosión aunque el iPhone parezca funcionar.' },
  { icon: 'fa-circle-info', color: '#ef4444', title: 'La resistencia al agua no es permanente', desc: 'Los sellos internos se degradan con golpes, calor y años de uso. Aunque el iPhone tenga certificación IP, el daño por líquido puede afectar pantalla, batería, cámaras, Face ID o placa lógica.' },
  { icon: 'fa-clock', color: '#22c55e', title: 'El tiempo cambia el diagnóstico', desc: 'Una revisión temprana puede limitar corrosión y sulfatación. Esperar días o semanas aumenta la probabilidad de microsoldadura, cambio de componentes o daño permanente en placa.' },
];

const modelos = [
  'iPhone 16 Pro Max', 'iPhone 16 Pro', 'iPhone 16 Plus', 'iPhone 16',
  'iPhone 15 Pro Max', 'iPhone 15 Pro', 'iPhone 15 Plus', 'iPhone 15',
  'iPhone 14 Pro Max', 'iPhone 14 Pro', 'iPhone 14 Plus', 'iPhone 14',
  'iPhone 13 Pro Max', 'iPhone 13 Pro', 'iPhone 13 Mini', 'iPhone 13',
  'iPhone 12 Pro Max', 'iPhone 12 Pro', 'iPhone 12 Mini', 'iPhone 12',
  'iPhone 11 Pro Max', 'iPhone 11 Pro', 'iPhone 11',
  'iPhone XS Max', 'iPhone XS', 'iPhone XR', 'iPhone X',
  'iPhone 8 Plus', 'iPhone 8', 'iPhone SE (2da/3ra gen)',
];

const porqueElegirnos = [
  { icon: 'fa-water', title: 'Tina ultrasónica para placa', desc: 'Usamos limpieza ultrasónica y alcohol isopropílico para remover residuos, sales y corrosión en zonas donde un cepillo no llega.' },
  { icon: 'fa-microchip', title: 'Microsoldadura cuando aplica', desc: 'Si la humedad dañó conectores, líneas o componentes, evaluamos reparación a nivel placa antes de sugerir cambios innecesarios.' },
  { icon: 'fa-heart-circle-check', title: 'Diagnóstico claro', desc: 'Si el equipo no tiene reparación viable o el costo no conviene, te lo explicamos antes de avanzar con cualquier intervención.' },
  { icon: 'fa-droplet-slash', title: 'Revisión del sello adhesivo', desc: 'Al cerrar el iPhone revisamos y reemplazamos el empaque cuando aplica para mejorar el cierre contra polvo y humedad ambiental.' },
  { icon: 'fa-comments', title: 'Reporte con Fotos y Evidencia', desc: 'Te enviamos imágenes microscópicas de la placa mojada y el resultado de la limpieza para que veas el trabajo real.' },
  { icon: 'fa-shield-halved', title: 'Garantía sobre el Trabajo', desc: 'Nuestra limpieza y reparaciones de placa cuentan con garantía por escrito detallada en tu ticket físico o digital.' },
];

const garantia = [
  { icon: 'fa-file-signature', title: 'Garantía por escrito', desc: 'Recibes un ticket digital o impreso que especifica las partes reparadas, la fecha y los plazos de cobertura clara.' },
  { icon: 'fa-hand-shake', title: 'Términos transparentes', desc: 'Nuestra garantía cubre las piezas instaladas y la mano de obra relacionada con la reparación de la humedad.' },
  { icon: 'fa-triangle-exclamation', title: 'Limitaciones normales', desc: 'La garantía no aplica si el equipo se vuelve a mojar, se golpea o es abierto por técnicos fuera de nuestro taller.' },
  { icon: 'fa-heart', title: 'Respaldo técnico continuo', desc: 'Aunque un equipo mojado sea crítico, te damos asesoría para cuidar la vida útil de tu batería y periféricos post-reparación.' },
];

const comparacion = [
  { aspecto: 'Desconexión inmediata de batería', pixon: true, otro: false },
  { aspecto: 'Limpieza ultrasónica de placa', pixon: true, otro: false },
  { aspecto: 'Inspección con microscopio binocular', pixon: true, otro: false },
  { aspecto: 'Microsoldadura a nivel componente', pixon: true, otro: false },
  { aspecto: 'Prueba de consumo eléctrico en placa', pixon: true, otro: false },
  { aspecto: 'Restauración del sello adhesivo', pixon: true, otro: false },
  { aspecto: 'Tratamiento exprés para agua salada', pixon: true, otro: false },
];

const checkList = [
  'Consumo eléctrico en reposo normal (sin calentamiento)',
  'Pantalla táctil responde fluida en toda el área',
  'Cámaras frontal y trasera enfocan y capturan sin humedad',
  'Face ID / Touch ID funciona de forma segura',
  'Sensores de proximidad y luz ambiental calibrados',
  'Carga normal y comunicación USB estables',
  'Micrófonos y bocinas con audio limpio y sin distorsión',
  'Conexión de red celular, WiFi y Bluetooth estables',
];

const related = [
  { href: '/servicios/telefono/reparacion-pantalla-iphone', icon: 'fa-display', label: 'Reparación de pantalla iPhone', desc: 'Si la humedad manchó de agua, quemó el backlight o rompió el display.' },
  { href: '/servicios/telefono/cambio-bateria-iphone', icon: 'fa-battery-half', label: 'Cambio de batería iPhone', desc: 'Si la batería se cortocircuitó, se infló o drena energía rápidamente.' },
  { href: '/servicios/telefono/reparacion-face-id-iphone', icon: 'fa-face-smile', label: 'Reparación de Face ID iPhone', desc: 'Servicio para recuperar el desbloqueo facial si el módulo TrueDepth se mojó.' },
  { href: '/servicios/telefono/reparacion-carga-iphone', icon: 'fa-plug', label: 'Reparación de carga iPhone', desc: 'Si el puerto de carga se sulfató, está oxidado o marca error de líquido.' },
  { href: '/servicios/telefono/diagnostico-iphone', icon: 'fa-stethoscope', label: 'Diagnóstico general', desc: 'Para evaluar fallas confusas o verificar si vale la pena reparar tu equipo.' },
  { href: '/servicios/telefono/reparacion-iphone', icon: 'fa-mobile-screen', label: 'Servicio Técnico Completo', desc: 'Accede a todo nuestro catálogo de reparaciones y mantenimiento de iPhone.' },
];

const faqItems = [
  { question: '¿Qué probabilidad hay de recuperar un iPhone mojado?', answer: 'Depende del líquido, el tiempo transcurrido y si intentaste cargarlo o encenderlo. Cuando el equipo llega apagado y rápido al taller, hay más margen para limpiar placa, desconectar batería y revisar corrosión antes de que avance. Si hubo agua salada o semanas de espera, hacemos diagnóstico en microscopio antes de prometer resultados.' },
  { question: '¿Por qué no recomiendan el arroz para un iPhone mojado?', answer: 'El arroz no limpia la placa lógica ni remueve sales, minerales o azúcar. Puede absorber humedad superficial, pero no llega debajo de blindajes, conectores ni componentes. Lo correcto es apagar el equipo, no cargarlo y hacer diagnóstico por humedad con apertura, limpieza y secado controlado.' },
  { question: '¿Cuánto cuesta reparar un iPhone por humedad en Cancún?', answer: 'El costo depende del modelo, el tipo de líquido, el tiempo que pasó y si hay daño en pantalla, batería, puerto de carga, Face ID o placa lógica. Primero revisamos en Pixon PC Cancún y te damos una cotización clara antes de instalar piezas o hacer microsoldadura.' },
  { question: '¿Cuánto tarda el diagnóstico de humedad?', answer: 'El diagnóstico inicial suele tomar de 2 a 4 horas porque implica abrir, desconectar batería, revisar indicadores de líquido, limpiar zonas críticas y medir consumo. Si encontramos cortos o corrosión bajo componentes, la reparación de placa puede tomar más tiempo y se cotiza por separado.' },
  { question: '¿El agua salada del mar daña más rápido el iPhone?', answer: 'Sí. El agua de mar acelera corrosión y sulfatación, especialmente si el iPhone sigue encendido o se conecta al cargador. Si tu iPhone cayó al mar en Cancún, apágalo, no lo seques al sol y tráelo lo antes posible para limpieza y diagnóstico.' },
  { question: '¿Perderé mis fotos y archivos?', answer: 'No borramos información como parte del diagnóstico por humedad. Si la placa y memoria siguen operativas, tus fotos y archivos normalmente permanecen en el equipo. Si el daño está en placa lógica, te explicamos primero si conviene reparar para recuperar funcionamiento o priorizar datos.' },
  { question: '¿Tienen garantía los equipos reparados por humedad?', answer: 'Sí entregamos garantía por escrito sobre la intervención realizada y las piezas instaladas cuando aplica. Como el daño por líquido puede dejar secuelas internas, aclaramos condiciones, límites y plazo de cobertura en el ticket antes de entregar el iPhone.' },
];
---

<div class="hum-wrapper">

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 1 · HERO
  ═══════════════════════════════════════════════ -->
  <section class="hum-hero">
    <div class="hum-hero-glow" aria-hidden="true"></div>
    <div class="hum-hero-grid-bg" aria-hidden="true"></div>
    <div class="container hum-hero-inner">

      <div class="hum-hero-copy">
        <span class="hum-badge">
          <i class="fa-solid fa-triangle-exclamation"></i> Emergencia por líquidos · Cancún
        </span>
        <h1 class="hum-h1">
          Reparación de iPhone mojado en Cancún
        </h1>
        <p class="hum-sub">Desconexión rápida de batería · Limpieza ultrasónica y diagnóstico de placa</p>
        <p class="hum-copy">
          ¿Tu iPhone se cayó al agua, al mar, alberca o se mojó con lluvia? El tiempo es crítico. En nuestro taller local en Cancún abrimos el equipo, desconectamos batería, revisamos corrosión y aplicamos limpieza ultrasónica cuando el diagnóstico lo permite.
        </p>
        <p class="hum-copy hum-copy--secondary">
          Atendemos iPhone X al 16 Pro Max mojados, con diagnóstico por humedad, revisión de placa lógica, puerto de carga, pantalla, batería, cámaras y Face ID afectado por líquido.
        </p>

        <div class="hum-chips">
          <div class="hum-chip hum-chip--cyan"><i class="fa-solid fa-water"></i> Tina Ultrasónica</div>
          <div class="hum-chip"><i class="fa-solid fa-microchip"></i> Expertos en Placa</div>
          <div class="hum-chip hum-chip--green"><i class="fa-solid fa-shield-halved"></i> Garantía por escrito</div>
          <div class="hum-chip"><i class="fa-solid fa-bolt"></i> Apertura inmediata</div>
          <div class="hum-chip"><i class="fa-solid fa-stethoscope"></i> Evidencia con fotos</div>
          <div class="hum-chip"><i class="fa-solid fa-location-dot"></i> Centro físico en Cancún</div>
        </div>

        <div class="hum-trust-bar">
          <span><i class="fa-solid fa-star"></i> 5.0 en Google</span>
          <span><i class="fa-solid fa-heart-pulse"></i> 85% de éxito al traerlo rápido</span>
          <span><i class="fa-solid fa-comments"></i> WhatsApp activo</span>
        </div>

        <div class="hum-cta-group">
          <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="hum-btn-wa">
            <i class="fa-brands fa-whatsapp"></i> Cotizar iPhone mojado
          </a>
          <a href="#primeros-auxilios" class="hum-btn-outline">
            Ver primeros auxilios <i class="fa-solid fa-arrow-down"></i>
          </a>
        </div>
        <p class="hum-micro">Mantén el iPhone apagado y no intentes cargarlo bajo ninguna circunstancia.</p>
      </div>

      <!-- Tarjeta visual de rescate -->
      <div class="hum-hero-card-wrap">
        <div class="hum-hero-card">
          <div class="hum-card-header">
            <i class="fa-solid fa-kit-medical"></i>
            <span>Protocolo por humedad Pixon PC</span>
          </div>

          <!-- Animación visual del agua -->
          <div class="hum-water-visual" aria-hidden="true">
            <div class="hum-water-container">
              <div class="hum-wave"></div>
              <div class="hum-wave hum-wave--back"></div>
              <div class="hum-phone-icon"><i class="fa-solid fa-mobile-button"></i></div>
              <div class="hum-bubbles">
                <span></span><span></span><span></span><span></span><span></span>
              </div>
            </div>
            <div class="hum-status-label">
              <i class="fa-solid fa-triangle-exclamation"></i> Detén la electrólisis
            </div>
          </div>

          <ul class="hum-card-checks">
            <li><i class="fa-solid fa-circle-check"></i> Desconexión de batería en 5 min</li>
            <li><i class="fa-solid fa-circle-check"></i> Lavado químico ultrasónico</li>
            <li><i class="fa-solid fa-circle-check"></i> Diagnóstico de corto en placa</li>
            <li><i class="fa-solid fa-circle-check"></i> Remoción de sal y minerales</li>
            <li><i class="fa-solid fa-circle-check"></i> Reemplazo de empaque de agua</li>
            <li><i class="fa-solid fa-circle-check"></i> Evidencias bajo microscopio</li>
          </ul>

          <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="hum-card-cta">
            <i class="fa-brands fa-whatsapp"></i> Agendar auxilio exprés
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 2 · STATS / POR QUÉ CADA HORA CUENTA
  ═══════════════════════════════════════════════ -->
  <section class="hum-stats">
    <div class="container">
      <div class="hum-section-head hum-section-head--compact text-center">
        <span class="hum-eyebrow"><i class="fa-solid fa-clock"></i> Diagnóstico en Cancún</span>
        <h2 class="hum-h2">Por qué cada hora cuenta cuando un iPhone se moja</h2>
      </div>
      <div class="hum-stats-grid">
        {stats.map((s) => (
          <div class="hum-stat-card">
            <div class="hum-stat-icon" style={`background: ${s.color}18; color: ${s.color};`}>
              <i class={`fa-solid ${s.icon}`}></i>
            </div>
            <div>
              <strong class="hum-stat-num">{s.num}</strong>
              <span class="hum-stat-label">{s.label}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 3 · GUÍA DE PRIMEROS AUXILIOS (Crucial)
  ═══════════════════════════════════════════════ -->
  <section class="hum-auxilios" id="primeros-auxilios">
    <div class="container">
      <div class="hum-section-head text-center">
        <span class="hum-eyebrow hum-eyebrow--amber"><i class="fa-solid fa-kit-medical"></i> Primeros Auxilios</span>
        <h2 class="hum-h2">¿Tu iPhone se acaba de mojar? Qué hacer y qué NO hacer</h2>
        <p class="hum-desc hum-desc--center">Lo que hagas durante las primeras horas puede reducir corrosión, sulfatación y daño en placa lógica. Mantén el iPhone apagado y evita conectarlo al cargador.</p>
      </div>

      <div class="hum-auxilios-split">
        <!-- Columna de Errores Críticos -->
        <div class="hum-aux-col hum-aux-col--donot">
          <h3 class="hum-aux-title"><i class="fa-solid fa-ban"></i> Lo que NUNCA debes hacer</h3>
          <div class="hum-aux-cards">
            {primerAuxilio.filter(a => !a.do).map((item) => (
              <div class="hum-aux-card hum-aux-card--danger">
                <div class="hum-aux-icon"><i class={`fa-solid ${item.icon}`}></i></div>
                <div class="hum-aux-body">
                  <h3>{item.title}</h3>
                  <p>{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Columna de Buenas Prácticas -->
        <div class="hum-aux-col hum-aux-col--do">
          <h3 class="hum-aux-title"><i class="fa-solid fa-circle-check"></i> Lo que debes hacer ya</h3>
          <div class="hum-aux-cards">
            {primerAuxilio.filter(a => a.do).map((item) => (
              <div class="hum-aux-card hum-aux-card--success">
                <div class="hum-aux-icon"><i class={`fa-solid ${item.icon}`}></i></div>
                <div class="hum-aux-body">
                  <h3>{item.title}</h3>
                  <p>{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="hum-emergency-box">
        <div class="hum-em-icon"><i class="fa-solid fa-truck-ramp-box"></i></div>
        <div class="hum-em-body">
          <h3>¿Agua salada del mar de Cancún? Revisión prioritaria</h3>
          <p>El agua salada acelera la corrosión y puede afectar puerto de carga, pantalla, cámaras, batería y placa lógica. Apágalo, no lo cargues y evita secarlo al sol. Escríbenos por WhatsApp para indicarte cómo moverlo de forma segura al taller.</p>
        </div>
        <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="hum-em-btn">
          <i class="fa-brands fa-whatsapp"></i> Pedir orientación
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 4 · SÍNTOMAS DE DAÑO
  ═══════════════════════════════════════════════ -->
  <section class="hum-sintomas">
    <div class="container">
      <div class="hum-section-head">
        <span class="hum-eyebrow"><i class="fa-solid fa-stethoscope"></i> Identifica la falla</span>
        <h2 class="hum-h2">Síntomas comunes de daño por humedad en iPhone</h2>
        <p class="hum-desc">La humedad no siempre mata al iPhone al instante. A veces penetra lentamente, alterando funciones específicas de forma progresiva. Reconocer el síntoma ayuda a detener daños colaterales.</p>
      </div>

      <div class="hum-sintomas-grid">
        {sintomas.map((s, i) => (
          <article class={`hum-sintoma-card${s.urgent ? ' hum-sintoma-card--urgent' : ''}`}>
