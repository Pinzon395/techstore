    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hum-hero__zone {
    font-size: 0.82rem;
    color: #94a3b8;
    font-weight: 500;
  }

  .hum-hero__title {
    font-size: clamp(2rem, 3.8vw, 3.1rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.03em;
    color: #ffffff !important;
    margin: 0 0 18px;
  }

  .hum-hero__lead {
    font-size: clamp(1.02rem, 1.6vw, 1.15rem);
    line-height: 1.65;
    color: #cbd5e1 !important;
    margin: 0 0 22px;
  }

  .hum-hero__lead strong {
    color: #ffffff;
    font-weight: 700;
  }

  /* Cobertura local chips */
  .hum-hero__coverage {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    padding: 8px 14px;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    font-size: 0.82rem;
    color: #94a3b8;
    margin-bottom: 26px;
  }

  .hum-cov-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .hum-cov-item i {
    color: #38bdf8;
  }

  .hum-cov-dot {
    opacity: 0.4;
  }

  .hum-hero__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }

  .hum-hero__warning-strip {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 14px;
    background: rgba(245, 158, 11, 0.12);
    border-left: 3px solid #f59e0b;
    border-radius: 6px;
    font-size: 0.84rem;
    line-height: 1.5;
    color: #fef3c7;
    margin: 0;
  }

  .hum-hero__warning-strip i {
    color: #fbbf24;
    margin-top: 2px;
  }

  .hum-hero__warning-strip strong {
    color: #ffffff;
  }

  /* Tarjeta de Evidencia Fotográfica Real */
  .hum-evidence-card {
    background: #07172a;
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 20px;
    padding: 16px;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    margin: 0;
  }

  .hum-evidence-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .hum-evidence-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 800;
    color: #38bdf8;
    letter-spacing: 0.05em;
    font-family: monospace;
  }

  .hum-evidence-badge {
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.35);
    font-weight: 600;
  }

  .hum-evidence-card__image-wrap {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: #020710;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hum-evidence-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 30%;
    transition: transform 0.4s ease;
  }

  .hum-evidence-card:hover .hum-evidence-img {
    transform: scale(1.02);
  }

  .hum-evidence-caption {
    font-size: 0.8rem;
    line-height: 1.5;
    color: #94a3b8;
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hum-evidence-caption strong {
    color: #e2e8f0;
  }

  /* ══════════════════════════════════════════════════════
     SECCIÓN 1: PRIMEROS AUXILIOS (2 COLUMNAS)
  ══════════════════════════════════════════════════════ */
  .hum-first-aid-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(20px, 3.5vw, 36px);
    margin-bottom: 28px;
  }

  .hum-aid-col {
    background: #ffffff;
    border-radius: 16px;
    padding: clamp(20px, 3vw, 32px);
    box-shadow: 0 4px 20px rgba(7, 31, 58, 0.06);
    border: 1px solid var(--border-light);
  }

  .hum-aid-col--donot {
    border-top: 4px solid #ef4444;
  }

  .hum-aid-col--do {
    border-top: 4px solid #10b981;
  }

  .hum-aid-col__header {
    margin-bottom: 22px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-light);
  }

  .hum-aid-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 4px 10px;
    border-radius: 6px;
  }

  .hum-aid-badge--danger {
    background: #fee2e2;
    color: #b91c1c;
  }

  .hum-aid-badge--success {
    background: #d1fae5;
    color: #047857;
  }

  .hum-aid-col__sub {
    font-size: 0.86rem;
    color: var(--azul-oscuro) !important;
    opacity: 0.8;
    margin: 8px 0 0;
  }

  .hum-aid-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .hum-aid-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .hum-aid-icon {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    font-size: 1rem;
  }

  .hum-aid-icon--danger {
    background: #fee2e2;
    color: #dc2626;
  }

  .hum-aid-icon--success {
    background: #d1fae5;
    color: #059669;
  }

  .hum-aid-item__title {
    display: block;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--azul-oscuro) !important;
    margin-bottom: 4px;
  }

  .hum-aid-item__desc {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--azul-oscuro) !important;
    opacity: 0.88;
    margin: 0;
  }

  /* Callout de Agua Salada */
  .hum-saltwater-callout {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 20px;
    padding: 20px 24px;
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-left: 5px solid #d97706;
    border-radius: 12px;
  }

  .hum-saltwater-callout__icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fef3c7;
    color: #d97706;
    display: grid;
    place-items: center;
    font-size: 1.25rem;
  }

  .hum-saltwater-callout__title {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    color: var(--azul-oscuro) !important;
    margin-bottom: 4px;
  }

  .hum-saltwater-callout__text {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--azul-oscuro) !important;
    opacity: 0.88;
    margin: 0;
  }

  /* ══════════════════════════════════════════════════════
     SECCIÓN 2: TURISTAS Y FLUJO HOTELERO
  ══════════════════════════════════════════════════════ */
  .hum-hotel-layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(28px, 4.5vw, 48px);
    align-items: start;
  }

  .hum-scenarios-title {
    display: block;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--azul-oscuro) !important;
    margin-bottom: 12px;
  }

  .hum-scenarios-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .hum-scenario-card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 14px;
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(7, 31, 58, 0.04);
  }

  .hum-scenario-card__icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: #e0f2fe;
    color: #0284c7;
    display: grid;
    place-items: center;
    font-size: 0.9rem;
  }

  .hum-scenario-card__name {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--azul-oscuro) !important;
    margin: 0 0 3px;
  }

  .hum-scenario-card__desc {
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--azul-oscuro) !important;
    opacity: 0.85;
    margin: 0;
  }

  /* Tarjeta de flujo hotelero */
  .hum-hotel-flow-card {
    background: #ffffff;
    border: 1px solid #bfdbfe;
    border-radius: 18px;
    padding: clamp(20px, 3vw, 30px);
    box-shadow: 0 8px 30px rgba(7, 31, 58, 0.08);
  }

  .hum-flow-label {
    font-size: 0.72rem;
    font-weight: 800;
    color: #0284c7;
    letter-spacing: 0.06em;
    font-family: monospace;
    display: block;
    margin-bottom: 6px;
  }

  .hum-flow-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--azul-oscuro) !important;
    margin: 0 0 18px;
    line-height: 1.3;
  }

  .hum-flow-steps {
    list-style: none;
    padding: 0;
    margin: 0 0 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hum-flow-steps li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .hum-flow-num {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #071F3A;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 800;
    display: grid;
    place-items: center;
    font-family: monospace;
  }

  .hum-flow-steps strong {
    display: block;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--azul-oscuro) !important;
    margin-bottom: 2px;
  }

  .hum-flow-steps p {
    font-size: 0.84rem;
    line-height: 1.48;
    color: var(--azul-oscuro) !important;
    opacity: 0.85;
    margin: 0;
  }

  /* ══════════════════════════════════════════════════════
     SECCIÓN 3: ELECTROQUÍMICA Y CIENCIA
  ══════════════════════════════════════════════════════ */
  .hum-electrochem-container {
    margin-bottom: 40px;
  }

  .hum-science-editorial {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(24px, 4vw, 44px);
    align-items: center;
    background: var(--bg-alt);
    border: 1px solid var(--border-light);
    border-radius: 16px;
    padding: clamp(20px, 3.5vw, 36px);
  }

  .hum-science-editorial__photo {
    margin: 0;
  }

  .hum-science-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid var(--border-subtle);
  }

  .hum-photo-caption {
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--azul-oscuro) !important;
    opacity: 0.85;
    margin-top: 8px;
  }

  .hum-photo-caption strong {
    color: var(--azul-oscuro);
  }

  /* ══════════════════════════════════════════════════════
     SECCIÓN 4: MATRIZ DE SÍNTOMAS (Tabla Compacta)
  ══════════════════════════════════════════════════════ */
  .hum-symptom-table-wrap {
    overflow-x: auto;
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 14px;
    box-shadow: 0 4px 18px rgba(7, 31, 58, 0.05);
    margin-bottom: 24px;
  }

  .hum-symptom-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
    min-width: 680px;
  }

  .hum-symptom-table th {
    background: #f1f5f9;
    color: var(--azul-oscuro);
    font-weight: 800;
    padding: 14px 18px;
    border-bottom: 2px solid var(--border-light);
    letter-spacing: -0.01em;
  }

  .hum-symptom-table td {
    padding: 14px 18px;
    border-bottom: 1px solid var(--border-light);
    vertical-align: top;
    color: var(--azul-oscuro) !important;
  }

  .hum-symptom-table tr:last-child td {
    border-bottom: none;
  }

  .hum-symptom-table tr:hover td {
    background: #f8fafc;
  }

  .hum-td-symptom__inner {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hum-td-symptom__inner i {
    color: #0284c7;
    font-size: 0.95rem;
    width: 16px;
  }

  .hum-symptom-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 16px 20px;
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 12px;
    flex-wrap: wrap;
  }

  .hum-symptom-cta__text {
    margin: 0;
    font-size: 0.92rem;
    color: var(--azul-oscuro) !important;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hum-symptom-cta__text i {
    color: #0284c7;
  }

  /* ══════════════════════════════════════════════════════
     SECCIÓN 5: TIPOS DE LÍQUIDO
  ══════════════════════════════════════════════════════ */
  .hum-liquids-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
    margin-bottom: 28px;
  }

  .hum-liquid-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 14px;
    padding: 20px;
    box-shadow: 0 4px 14px rgba(7, 31, 58, 0.04);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hum-liquid-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .hum-liquid-badge {
    font-size: 0.72rem;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid;
    letter-spacing: 0.03em;
  }

  .hum-liquid-speed {
    font-size: 0.74rem;
    color: var(--azul-oscuro) !important;
    opacity: 0.75;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .hum-liquid-card__title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--azul-oscuro) !important;
    margin: 0;
  }

  .hum-liquid-card__cond {
    font-size: 0.82rem;
    color: var(--azul-oscuro) !important;
    opacity: 0.85;
    margin: 0;
  }

  .hum-liquid-card__danger {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--azul-oscuro) !important;
    opacity: 0.9;
    margin: 0;
  }

  /* Contexto de Cancún */
  .hum-cancun-context {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    align-items: center;
    padding: 20px 24px;
    background: #f0f7ff;
    border: 1px solid #bae6fd;
    border-radius: 14px;
  }

  .hum-cancun-context__icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: #e0f2fe;
    color: #0284c7;
    display: grid;
    place-items: center;
    font-size: 1.3rem;
  }

  .hum-cancun-context__title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--azul-oscuro) !important;
    margin: 0 0 6px;
  }

  .hum-cancun-context__text {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--azul-oscuro) !important;
    opacity: 0.9;
    margin: 0;
  }

  /* ══════════════════════════════════════════════════════
     SECCIÓN 6: PROTOCOLO TÉCNICO EN 7 PASOS
  ══════════════════════════════════════════════════════ */
  .hum-pipeline-layout {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(24px, 4vw, 44px);
    align-items: start;
  }

  .hum-pipeline-steps {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hum-pipe-step {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 12px;
    padding: 16px 18px;
    box-shadow: 0 2px 8px rgba(7, 31, 58, 0.04);
  }

  .hum-pipe-step__badge {
    flex-shrink: 0;
  }

  .hum-pipe-step__num {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: #071F3A;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 800;
    font-family: monospace;
  }

  .hum-pipe-step__title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }

  .hum-pipe-step__title-wrap i {
    color: #0284c7;
    font-size: 0.9rem;
  }

  .hum-pipe-step__title {
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--azul-oscuro) !important;
    margin: 0;
  }

  .hum-pipe-step__desc {
    font-size: 0.86rem;
    line-height: 1.52;
    color: var(--azul-oscuro) !important;
    opacity: 0.88;
    margin: 0;
  }

  /* Aside del pipeline */
  .hum-aside-photo-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 16px;
    padding: 14px;
    margin: 0 0 16px;
    box-shadow: 0 4px 16px rgba(7, 31, 58, 0.06);
  }

  .hum-aside-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid var(--border-subtle);
  }

  .hum-aside-tip {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 16px;
    background: #e0f2fe;
    border: 1px solid #bae6fd;
    border-radius: 10px;
    font-size: 0.84rem;
    line-height: 1.48;
    color: var(--azul-oscuro) !important;
  }

  .hum-aside-tip i {
    color: #0284c7;
    font-size: 1.1rem;
    margin-top: 2px;
  }

  .hum-aside-tip strong {
    display: block;
    margin-bottom: 2px;
  }

  .hum-aside-tip p {
    margin: 0;
    opacity: 0.9;
  }

  /* ══════════════════════════════════════════════════════
     SECCIÓN 7: MICROSOLDADURA
  ══════════════════════════════════════════════════════ */
  .hum-microsolder-layout {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(24px, 4.5vw, 48px);
    align-items: center;
  }

  .hum-solder-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 16px;
    padding: 14px;
    margin: 0;
    box-shadow: 0 6px 24px rgba(7, 31, 58, 0.07);
  }

  .hum-solder-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid var(--border-subtle);
  }

  .hum-solder-capabilities {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hum-solder-capabilities li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .hum-solder-capabilities i {
    color: #0284c7;
    font-size: 1rem;
    margin-top: 3px;
  }

  .hum-solder-capabilities strong {
    display: block;
    font-size: 0.94rem;
    color: var(--azul-oscuro) !important;
    margin-bottom: 2px;
  }

  .hum-solder-capabilities div {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--azul-oscuro) !important;
    opacity: 0.88;
  }

  /* ══════════════════════════════════════════════════════
     SECCIÓN 8: RECUPERACIÓN DE DATOS
  ══════════════════════════════════════════════════════ */
  .hum-data-box {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(20px, 3.5vw, 36px);
    background: #ffffff;
    border: 1px solid #bfdbfe;
    border-radius: 20px;
    padding: clamp(24px, 4vw, 44px);
    box-shadow: 0 8px 32px rgba(7, 31, 58, 0.07);
  }

  .hum-data-box__icon {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: #e0f2fe;
    color: #0284c7;
    display: grid;
    place-items: center;
    font-size: 1.6rem;
  }

  .hum-data-points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin: 22px 0 24px;
  }

  .hum-data-point {
    background: #f8fafc;
    border: 1px solid var(--border-light);
    border-radius: 10px;
