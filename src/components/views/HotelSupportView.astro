---
import FaqSection from '../FaqSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import Footer from '../Footer.astro';

const { service, category } = Astro.props;

const waMessage = encodeURIComponent(
  'Hola, me interesa el servicio de Soporte TI para hoteles en Cancún. Me gustaría cotizar para nuestro hotel.'
);

const problems = [
  {
    icon: 'fa-hotel',
    title: 'Terminales de check-in lentas',
    h3: '¿Por qué la recepción tarda tanto en registrar a los huéspedes?',
    desc: 'Diagnosticamos cuellos de botella en computadoras de recepción: discos mecánicos lentos, falta de RAM, malware, configuraciones de red erróneas y software PMS desoptimizado.',
    tags: ['Check-in / Check-out', 'Terminales lentas', 'PMS Opera / Sabre', 'Cancún Z.H.'],
  },
  {
    icon: 'fa-wifi',
    title: 'WiFi de huéspedes inestable',
    h3: 'WiFi intermitente o lento en las habitaciones del hotel',
    desc: 'Mapeamos zonas sin cobertura (puntos muertos), saturación de canales, interferencias físicas del edificio y fallas en Access Points (Ubiquiti, Ruckus, Aruba).',
    tags: ['Ubiquiti UniFi', 'Portal cautivo', 'Balanceo de carga', 'Aruba Networks'],
  },
  {
    icon: 'fa-print',
    title: 'Impresoras de tickets bloqueadas',
    h3: 'Fallas de impresión de reservaciones, facturas o comandas',
    desc: 'Solucionamos problemas con impresoras térmicas de tickets y multifuncionales en administración. Corregimos colas de impresión, drivers corruptos y rodillos desgastados.',
    tags: ['Epson / Zebra', 'Impresión de tickets', 'Cola de impresión', 'Limpieza rodillos'],
  },
  {
    icon: 'fa-server',
    title: 'Pérdida de conexión con el PMS',
    h3: 'Caídas del sistema de gestión hotelera y bases de datos SQL',
    desc: 'Revisamos enlaces de red local, cableado estructurado, latencia en switches y fallas en el servidor local de base de datos para restaurar la conexión del PMS.',
    tags: ['PMS local / cloud', 'Bases de datos SQL', 'Switches administrados', 'Servidor caída'],
  },
  {
    icon: 'fa-shield-halved',
    title: 'CCTV e infraestructura fuera de línea',
    h3: 'Cámaras de seguridad o sistemas de acceso caídos',
    desc: 'Monitoreamos y damos mantenimiento a grabadores NVR, cámaras IP con falso contacto, switches PoE saturados de calor y control de accesos de tarjetas.',
    tags: ['CCTV IP', 'Grabadores NVR', 'Switches PoE', 'Control de acceso'],
  },
  {
    icon: 'fa-laptop',
    title: 'Laptops de administración lentas',
    h3: 'Equipos administrativos con errores de Windows o virus',
    desc: 'Realizamos mantenimiento preventivo físico interno, optimización del sistema, eliminación de malware, antivirus empresarial y reinstalación limpia de Windows/macOS.',
    tags: ['Windows / macOS', 'Antivirus corporativo', 'Limpieza física', 'Actualización a SSD'],
  },
  {
    icon: 'fa-network-wired',
    title: 'Red hotelera lenta o vulnerable',
    h3: 'Mezcla de red de operación del hotel y WiFi de huéspedes',
    desc: 'Segmentamos tu red local con VLANs para aislar y proteger los datos administrativos de las reservas y check-in del acceso general de los huéspedes.',
    tags: ['Segmentación VLAN', 'Firewall / Router', 'Seguridad de red', 'Políticas TI'],
  },
  {
    icon: 'fa-clock-rotate-left',
    title: 'Falta de respaldo de reservaciones',
    h3: 'Riesgo de pérdida de historial hotelero por apagones',
    desc: 'Implementamos respaldos redundantes automáticos en la nube y dispositivos NAS locales para bases de datos PMS, correos de ventas y archivos compartidos.',
    tags: ['Cloud Backup', 'NAS Synology', 'Respaldo automático', 'Protección contra cortes'],
  },
];

const steps = [
  {
    num: '01',
    title: 'Auditoría y levantamiento técnico',
    desc: 'Realizamos una inspección presencial para inventariar equipos de cómputo, servidores, switches, Access Points y cableado en recepción y oficinas.',
    icon: 'fa-magnifying-glass',
  },
  {
    num: '02',
    title: 'Estabilización operativa inmediata',
    desc: 'Solucionamos de inmediato las fallas críticas que detienen tu check-in o administración: terminales lentas, impresoras sin red o caídas de internet.',
    icon: 'fa-bolt',
  },
  {
    num: '03',
    title: 'Implementación de seguridad y respaldos',
    desc: 'Segmentamos redes con VLANs para aislar tráfico y configuramos respaldos automáticos de bases de datos del PMS y archivos administrativos críticos.',
    icon: 'fa-shield-halved',
  },
  {
    num: '04',
    title: 'Mantenimiento preventivo por lotes',
    desc: 'Programamos limpieza física interna, cambio de compuesto térmico y actualización de software de computadoras administrativas en horarios de baja ocupación.',
    icon: 'fa-screwdriver-wrench',
  },
  {
    num: '05',
    title: 'Soporte 24/7 y monitoreo activo',
    desc: 'Activamos la línea de soporte prioritario para atención remota y presencial urgente en Zona Hotelera, garantizando que recepción nunca detenga su operación.',
    icon: 'fa-headset',
  },
];

const risks = [
  {
    icon: 'fa-triangle-exclamation',
    title: 'No ignores terminales inestables',
    text: 'Una PC que se congela en recepción retrasa el check-in y genera una mala experiencia inicial en el huésped desde el primer minuto.',
  },
  {
    icon: 'fa-circle-nodes',
    title: 'No compartas la misma red WiFi',
    text: 'Permitir que los huéspedes accedan a la misma red de tus computadoras de recepción y PMS expone datos confidenciales e incumple normas de seguridad.',
  },
  {
    icon: 'fa-hard-drive',
    title: 'No postergues respaldos del PMS',
    text: 'Las fluctuaciones eléctricas de Cancún pueden dañar discos de servidores locales. Sin respaldo automático diario, arriesgas el registro de reservaciones activas.',
  },
  {
    icon: 'fa-wind',
    title: 'No ignores la acumulación de salitre',
    text: 'En Cancún y Zona Hotelera, la humedad y el salitre corroen ventiladores y placas rápidamente. El mantenimiento preventivo evita paros de servicio costosos.',
  },
];

const faqs = [
  {
    question: '¿Qué tiempo de respuesta manejan para incidentes en hoteles de Cancún?',
    answer: 'Manejamos tiempos de respuesta prioritarios de menos de 2 horas para incidentes críticos presenciales en Zona Hotelera y Cancún Centro, y soporte remoto inmediato en minutos para que recepción no se detenga.',
  },
  {
    question: '¿Dan soporte a sistemas de reservaciones o PMS como Opera, Sabre o similares?',
    answer: 'Sí. Damos soporte técnico a la infraestructura y terminales donde corren estos sistemas (servidores de base de datos SQL locales, computadoras de recepción, cableado local, red y WiFi). Nos coordinamos con el soporte oficial del software si es una falla interna de su plataforma.',
  },
  {
    question: '¿Pueden facturar con CFDI y emitir reportes de servicio?',
    answer: 'Sí, emitimos facturas CFDI detalladas por todos nuestros servicios. Para pólizas de soporte o trabajos preventivos por lote, entregamos reportes técnicos detallados con el inventario, estado de equipos, incidencias resueltas y recomendaciones futuras.',
  },
  {
    question: '¿Qué zonas de cobertura atienden para soporte hotelero?',
    answer: 'Cubrimos toda la Zona Hotelera de Cancún, Cancún Centro, Puerto Cancún, Huayacán, Cumbres, Aeropuerto, Bonfil, y extendemos cobertura a la Riviera Maya (Puerto Morelos, Playa del Carmen) bajo planes de póliza mensual.',
  },
  {
    question: '¿Ofrecen pólizas de soporte mensual para hoteles o solo servicios bajo demanda?',
    answer: 'Ofrecemos ambas opciones. Podemos intervenir bajo demanda para resolver problemas específicos (diagnóstico de red WiFi, mantenimiento preventivo de flotillas por lote, reinstalación de servidores) o estructurar una póliza mensual de soporte adaptada al tamaño del hotel.',
  },
  {
    question: '¿Cómo resuelven los problemas de WiFi lento para los huéspedes (Hotspot)?',
    answer: 'Realizamos análisis de espectro inalámbrico para detectar canales saturados, reubicamos o cambiamos Access Points dañados, configuramos portal cautivo para administración de usuarios, y aplicamos políticas de balanceo y límite de ancho de banda por habitación.',
  },
  {
    question: '¿Trabajan en horarios nocturnos para no afectar la operación de check-in?',
    answer: 'Sí, entendemos que la operación hotelera es 24/7. Las intervenciones de mantenimiento preventivo a gran escala, cableado estructurado o cambios en racks de comunicación se programan en horarios de baja actividad operativa para no interferir con el servicio al huésped.',
  },
  {
    question: '¿Cuentan con servicio de préstamo de equipos en caso de fallas graves?',
    answer: 'Bajo esquemas de póliza de soporte mensual, contamos con stock de computadoras, laptops e impresoras de tickets de respaldo para instalación inmediata en áreas críticas de check-in o reservas, asegurando la continuidad del negocio mientras reparamos tu equipo.',
  },
];

const targetAreas = [
  { name: 'Recepción y Lobby', icon: 'fa-hotel', note: 'Check-in y terminales' },
  { name: 'Reservaciones y Ventas', icon: 'fa-clipboard-list', note: 'PCs, laptops y telefonía' },
  { name: 'Oficinas Administrativas', icon: 'fa-calculator', note: 'Facturación, nómina e impresoras' },
  { name: 'Red WiFi de Huéspedes', icon: 'fa-wifi', note: 'Portal cautivo y hotspots' },
  { name: 'Servidores y Rack de Red', icon: 'fa-server', note: 'Bases de datos PMS y VPN' },
  { name: 'Sistemas de CCTV y NVR', icon: 'fa-video', note: 'Seguridad y monitoreo IP' },
  { name: 'POS y Comanderas', icon: 'fa-utensils', note: 'Restaurantes y bares del hotel' },
  { name: 'Control de Accesos', icon: 'fa-key', note: 'Tarjetas magnéticas y chapas' },
];
---

<div class="hsv-page">

  <!-- ═══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════ -->
  <section class="hsv-hero">
    <div class="hsv-hero-glow hsv-glow-1"></div>
    <div class="hsv-hero-glow hsv-glow-2"></div>
    <div class="container hsv-hero-grid">

      <div class="hsv-hero-copy">
        <span class="hsv-kicker">
          <i class="fa-solid fa-building-shield"></i> Soporte TI para Hoteles en Cancún
        </span>
        <h1>Soporte TI para Hoteles en Cancún | Soluciones Tecnológicas y Soporte 24/7</h1>
        <p class="hsv-hero-sub">
          Evita retrasos en check-in, quejas por WiFi lento y caídas de sistema. 
          Garantizamos la estabilidad técnica en recepción, reservaciones y administración 
          con soporte inmediato, mantenimiento preventivo por lote y pólizas adaptadas.
        </p>
        <div class="hsv-badges">
          <span><i class="fa-solid fa-hotel"></i> Recepción y Check-in</span>
          <span><i class="fa-solid fa-wifi"></i> WiFi Hotspot Huéspedes</span>
          <span><i class="fa-solid fa-server"></i> Conectividad PMS Opera</span>
          <span><i class="fa-solid fa-print"></i> Impresoras de Tickets</span>
          <span><i class="fa-solid fa-headset"></i> Pólizas TI 24/7</span>
        </div>
        <div class="hsv-actions">
          <a
            class="hsv-btn-primary"
            href={`https://wa.me/529986690777?text=${waMessage}`}
            target="_blank"
            id="hsv-hero-wa-btn"
          >
            <i class="fa-brands fa-whatsapp"></i> Cotizar soporte hotelero
          </a>
          <a class="hsv-btn-secondary" href="#fallas-hoteleras" id="hsv-hero-ver-btn">
            Ver problemas que resolvemos
          </a>
        </div>
      </div>

      <aside class="hsv-hero-panel">
        <div class="hsv-panel-img-wrap">
          <img
            src="/assets/images/soporte-hoteles-hero.webp"
            alt="Soporte técnico y TI para hoteles en Cancún — Pixon PC"
            class="hsv-panel-img"
          />
          <div class="hsv-panel-img-overlay"></div>
        </div>
        <div class="hsv-panel-price-row">
          <div>
            <span class="hsv-price-label">Soporte técnico y pólizas</span>
            <strong class="hsv-price-value">Cotización</strong>
          </div>
          <span class="hsv-price-eta">
            <i class="fa-regular fa-clock"></i> Respuesta inmediata
          </span>
        </div>
        <ul class="hsv-panel-checks">
          <li><i class="fa-solid fa-circle-check"></i> Diagnóstico en sitio sin costo inicial</li>
          <li><i class="fa-solid fa-circle-check"></i> Cobertura en toda la Zona Hotelera</li>
          <li><i class="fa-solid fa-circle-check"></i> Guardia nocturna y fines de semana</li>
          <li><i class="fa-solid fa-circle-check"></i> Soporte a hardware, red, WiFi y PMS</li>
          <li><i class="fa-solid fa-circle-check"></i> Facturación CFDI y Reportes detallados</li>
        </ul>
      </aside>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       INTRO — qué hacemos y por qué importa
  ══════════════════════════════════════════════ -->
  <section class="hsv-section hsv-light" id="que-hacemos">
    <div class="container">
      <div class="hsv-two-col">
        <div>
          <span class="hsv-eyebrow">Operación 24/7</span>
          <h2>Estabilidad Tecnológica para Recepción, Reservas y Administración</h2>
          <p>
            En el sector hotelero de Cancún y la Riviera Maya, la tecnología no puede parar. Una falla en las 
            computadoras de check-in o una desconexión del PMS (Property Management System) durante horas pico 
            significa retrasos, huéspedes molestos y pérdidas operativas directas.
          </p>
          <p>
            Nuestro servicio de <strong>soporte TI para hoteles en Cancún</strong> está diseñado con un enfoque 
            100% operativo: priorizamos las áreas críticas que afectan el servicio al cliente y mantenemos tu 
            infraestructura de red, servidores y terminales trabajando con máxima estabilidad.
          </p>
        </div>
        <div>
          <span class="hsv-eyebrow">Prevención primero</span>
          <h2>¿Qué Incluye Nuestro Servicio de Soporte TI para Hoteles en Cancún y Riviera Maya?</h2>
          <p>
            No somos técnicos que solo atienden cuando algo ya falló. Nos enfocamos en el mantenimiento 
            preventivo y en la reestructuración de tu red para evitar incidentes.
          </p>
          <p>
            Ofrecemos levantamientos técnicos, auditorías de cobertura WiFi, limpieza física de flotillas de cómputo, 
            configuración de respaldos locales y en la nube de bases de datos críticas, y un canal de comunicación directo 
            para soporte urgente de mesa de ayuda presencial y remota.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PROBLEMAS — grilla de 8 tarjetas
  ══════════════════════════════════════════════ -->
  <section class="hsv-section hsv-dark" id="fallas-hoteleras">
    <div class="container">
      <div class="hsv-head-center hsv-head-navy-panel">
        <span class="hsv-eyebrow hsv-eyebrow-light">Fallas que resolvemos</span>
        <h2>Problemas de Soporte Técnico y Redes en Hoteles</h2>
        <p class="hsv-center-desc">
          Desde computadoras lentas en la recepción de la Zona Hotelera hasta fallas de conexión con bases de datos PMS, 
          aquí detallamos cómo resolvemos los problemas más comunes en la infraestructura hotelera.
        </p>
      </div>

      <div class="hsv-problems-grid">
        {problems.map((p) => (
          <article class="hsv-problem-card">
            <div class="hsv-problem-icon-wrap">
              <i class={`fa-solid ${p.icon}`}></i>
            </div>
            <div class="hsv-problem-body">
              <h3>{p.h3}</h3>
              <p class="hsv-problem-label">{p.title}</p>
              <p>{p.desc}</p>
              <div class="hsv-problem-tags">
                {p.tags.map((t) => <span>{t}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SPLIT — wifi hotspot + pms/servidores
  ══════════════════════════════════════════════ -->
  <section class="hsv-section hsv-light">
    <div class="container">
      <div class="hsv-split-cards">

        <div class="hsv-split-card hsv-split-card--img">
          <div class="hsv-split-img-wrap">
            <img
              src="/assets/images/reparacion-impresoras-cancun.webp"
              alt="Mantenimiento preventivo de impresoras y PCs en hoteles de Cancún"
              class="hsv-split-img"
            />
          </div>
          <span class="hsv-eyebrow">Redes WiFi Hotspot</span>
          <h2>Redes WiFi Hotspot y Conectividad para Huéspedes sin Interrupciones</h2>
          <p>
            El WiFi lento en las habitaciones es una de las principales causas de malas calificaciones en plataformas de reservas. 
            Diagnosticamos la cobertura de tus Access Points en áreas comunes y habitaciones, optimizamos el ancho de banda 
            para evitar que descargas masivas saturen la red, y configuramos portales cautivos seguros.
          </p>
          <p>
            Nuestros ingenieros aíslan el tráfico de los huéspedes del tráfico operativo del hotel mediante VLANs, 
            garantizando estabilidad y protegiendo la información bancaria y de reservas en recepción.
          </p>
          <a
            class="hsv-btn-sm"
            href={`https://wa.me/529986690777?text=${waMessage}`}
            target="_blank"
          >
            <i class="fa-brands fa-whatsapp"></i> Consultar sobre redes WiFi
          </a>
        </div>

        <div class="hsv-split-card hsv-split-card--dark">
          <span class="hsv-eyebrow hsv-eyebrow-light">Infraestructura Crítica</span>
          <h2>Soporte para PMS (Property Management Systems) y Servidores Locales</h2>
          <p>
            Los servidores locales que alojan el PMS (Opera, Sabre, Sihot, etc.) y las bases de datos de cobro 
            deben contar con redundancia, protección contra cortes eléctricos y sistemas de respaldo diarios automáticos. 
            Damos soporte técnico preventivo a los servidores, switches, racks de comunicación y cableado estructurado del hotel.
          </p>
          <p>
            En Cancún, los cortes de luz y variaciones de voltaje son frecuentes. Nos aseguramos de instalar y configurar 
            sistemas UPS y plantas de respaldo para mantener tus servidores en línea sin pérdida de bases de datos.
          </p>
          <ul class="hsv-checklist">
            <li><i class="fa-solid fa-check"></i> Soporte a hardware de servidores locales</li>
            <li><i class="fa-solid fa-check"></i> Respaldos automáticos en la nube y NAS local</li>
            <li><i class="fa-solid fa-check"></i> Diagnóstico de cableado estructurado y switches</li>
            <li><i class="fa-solid fa-check"></i> Limpieza y mantenimiento de racks de red</li>
            <li><i class="fa-solid fa-check"></i> Configuración de sistemas UPS para servidores</li>
            <li><i class="fa-solid fa-check"></i> Coordinación técnica con proveedores externos</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       ÁREAS DE ATENCIÓN
  ═══════════════════════════════════════════ -->
  <section class="hsv-section hsv-dark hsv-areas-section">
    <div class="container">
      <div class="hsv-head-center">
        <span class="hsv-eyebrow hsv-eyebrow-light">Alcance del soporte</span>
        <h2>Áreas y Sistemas que Atendemos en Cancún y Riviera Maya</h2>
        <p class="hsv-center-desc">
          Cubrimos todos los puntos clave de la infraestructura tecnológica de tu hotel, 
          garantizando continuidad operativa y seguridad informática.
        </p>
      </div>
      <div class="hsv-areas-grid">
        {targetAreas.map((a) => (
          <div class="hsv-area-pill">
            <i class={`fa-solid ${a.icon}`}></i>
            <div>
              <strong>{a.name}</strong>
              <small>{a.note}</small>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PROCESO
  ══════════════════════════════════════════════ -->
  <section class="hsv-section hsv-light" id="proceso-hoteles">
    <div class="container">
      <div class="hsv-head-center hsv-head-dark">
        <span class="hsv-eyebrow">Metodología de trabajo</span>
        <h2>¿Cómo Es el Proceso de Soporte TI para Hoteles?</h2>
        <p class="hsv-center-desc hsv-center-desc--dark">
          Trabajamos de forma ordenada para no afectar tus niveles de ocupación. 
          Establecemos prioridades de servicio para garantizar la estabilidad técnica.
        </p>
      </div>
      <div class="hsv-process-list">
        {steps.map((s) => (
          <div class="hsv-process-item">
            <div class="hsv-process-num-wrap">
              <span class="hsv-process-num">{s.num}</span>
              <div class="hsv-process-line"></div>
            </div>
            <div class="hsv-process-content">
              <div class="hsv-process-icon"><i class={`fa-solid ${s.icon}`}></i></div>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       ADVERTENCIAS / RIESGOS
  ══════════════════════════════════════════════ -->
  <section class="hsv-section hsv-dark">
    <div class="container">
      <div class="hsv-head-center hsv-head-navy-panel">
        <span class="hsv-eyebrow hsv-eyebrow-light">Prevención de Incidentes</span>
        <h2>Riesgos Operativos en la Infraestructura TI Hotelera</h2>
        <p class="hsv-center-desc">
          Evita que fallas menores escalen a paros de servicio en recepción o quejas 
          de huéspedes que afecten la reputación online del hotel.
        </p>
      </div>
      <div class="hsv-risks-grid">
        {risks.map((r) => (
          <div class="hsv-risk-card">
            <div class="hsv-risk-icon"><i class={`fa-solid ${r.icon}`}></i></div>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       MANTENIMIENTO POR LOTE — sección especial
  ══════════════════════════════════════════════ -->
  <section class="hsv-section hsv-light hsv-maintenance-section">
    <div class="container">
      <div class="hsv-maintenance-grid">
        <div class="hsv-maintenance-copy">
          <span class="hsv-eyebrow">Flotillas de Cómputo</span>
          <h2>Mantenimiento Preventivo y Limpieza de Flotillas de Cómputo</h2>
          <p>
            El clima de Cancún (humedad y salitre) acelera la corrosión y acumulación de polvo dentro de los equipos de oficina. 
            Las computadoras en administración, ventas y recepción acumulan salitre rápidamente, lo que causa fallas eléctricas en la placa y sobrecalentamiento.
          </p>
          <p>
            Programamos <strong>mantenimientos preventivos físicos por lote</strong>. Realizamos limpieza interna profunda, 
