---
import HeroWithFloatingCards from '../HeroWithFloatingCards.astro';
import DiagnosticSection from '../DiagnosticSection.astro';
import BeforeAfterSection from '../BeforeAfterSection.astro';
import DarkTechnicalSection from '../DarkTechnicalSection.astro';
import FaqSection from '../FaqSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import Footer from '../Footer.astro';

const { service, category } = Astro.props;
const whatsappText = encodeURIComponent('Hola, necesito revisar el sobrecalentamiento de mi laptop o PC y saber si requiere cambio de pasta térmica.');

const diagnosticItems = [
  { label: 'CPU', detail: 'Temperatura, frecuencia y estabilidad bajo carga.', status: 'Medición', icon: 'fa-microchip' },
  { label: 'GPU', detail: 'Calor, ventilación y pérdida de rendimiento gráfico.', status: 'Prueba', icon: 'fa-display' },
  { label: 'Ventilador', detail: 'Velocidad, ruido, desgaste y movimiento de aire.', status: 'Inspección', icon: 'fa-fan' },
  { label: 'Disipador', detail: 'Contacto, polvo, presión y estado de heatpipes.', status: 'Revisión', icon: 'fa-temperature-half' },
  { label: 'Pasta térmica', detail: 'Estado, cobertura y compuesto adecuado al equipo.', status: 'Decisión', icon: 'fa-droplet' },
];

const technicalSteps = [
  { title: 'Medimos antes de abrir', description: 'Registramos temperatura, ruido y rendimiento para no intervenir por intuición.' },
  { title: 'Localizamos la restricción', description: 'Revisamos ventiladores, rejillas, disipador, pasta, pads y flujo de aire.' },
  { title: 'Hacemos el servicio necesario', description: 'Limpiamos, ajustamos o reemplazamos el compuesto solo cuando corresponde.' },
  { title: 'Comprobamos bajo carga', description: 'Validamos temperatura, estabilidad y respuesta antes de entregar.' },
];

const process = [
  ['01', 'Abrimos', 'Desarmado seguro según modelo y arquitectura térmica.'],
  ['02', 'Limpiamos', 'Retiro de polvo en ventiladores, rejillas y disipadores.'],
  ['03', 'Revisamos', 'Pasta, thermal pads, heatpipes, presión y conectores.'],
  ['04', 'Ensamblamos', 'Aplicación correcta y cierre sin forzar clips o flex.'],
  ['05', 'Probamos', 'Carga controlada, temperatura, ruido y estabilidad final.'],
];

const relatedCards = [
  { href: '/servicios/laptop/mantenimiento-preventivo', icon: 'fa-screwdriver-wrench', label: 'Mantenimiento de laptop', desc: 'Limpieza interna, ventilación, batería, almacenamiento y temperatura.', cta: 'Ver servicio' },
  { href: '/servicios/pc/limpieza-profunda', icon: 'fa-computer', label: 'Limpieza profunda de PC', desc: 'Gabinetes con polvo, ventiladores saturados y flujo de aire limitado.', cta: 'Ver servicio' },
  { href: '/servicios/pc/tarjeta-video-gpu', icon: 'fa-microchip', label: 'Revisión de tarjeta gráfica', desc: 'GPU con temperatura alta, artefactos, cierres o ventiladores ruidosos.', cta: 'Ver servicio' },
  { href: '/servicios/laptop/diagnostico', icon: 'fa-stethoscope', label: 'Diagnóstico de laptop', desc: 'Para apagados o lentitud donde la causa aún no está clara.', cta: 'Ver servicio' },
  { href: '/servicios/laptop/laptop-mojada', icon: 'fa-droplet', label: 'Laptop mojada o con corrosión', desc: 'Líquido y humedad requieren revisión distinta antes de intervenir.', cta: 'Ver servicio' },
  { href: '/servicios/pc/instalacion-componentes', icon: 'fa-memory', label: 'Instalación de componentes', desc: 'Ventiladores, disipadores y componentes con compatibilidad previa.', cta: 'Ver servicio' },
];

const faqs = [
  { question: '¿Cuánto cuesta el cambio de pasta térmica en Cancún?', answer: 'El servicio inicia desde $550 MXN. El costo depende del equipo, complejidad de apertura, cantidad de chips, estado de ventiladores y si necesita thermal pads o reparación adicional. Se confirma después del diagnóstico.' },
  { question: '¿Cada cuánto debe cambiarse la pasta térmica?', answer: 'No existe un intervalo idéntico para todos los equipos. Conviene revisarla cuando aparecen temperaturas anormales, ruido, pérdida de rendimiento o después de un periodo prolongado sin mantenimiento.' },
  { question: '¿Cambiar la pasta térmica siempre baja la temperatura?', answer: 'No necesariamente. Si la causa es un ventilador dañado, heatpipe defectuoso, mala ventilación, software o un disipador mal instalado, cambiar solo la pasta no resuelve el problema.' },
  { question: '¿Atienden PC gamer y laptop gamer?', answer: 'Sí. Revisamos laptops gamer, PC ensambladas, equipos de oficina y workstations. La intervención cambia según su sistema de refrigeración.' },
  { question: '¿También cambian thermal pads?', answer: 'Sí, cuando están dañados y se puede confirmar material y grosor correctos. Un pad incorrecto puede empeorar el contacto del disipador.' },
  { question: '¿Cuánto tarda el servicio?', answer: 'Normalmente entre 24 y 48 horas. Puede tomar más si hay apagados intermitentes, ventiladores dañados, enfriamiento líquido o necesidad de pruebas prolongadas.' },
];
---

<div class="thermal-page">
  <HeroWithFloatingCards
    eyebrow="Servicio térmico para laptop y PC en Cancún"
    title="Sobrecalentamiento y cambio de pasta térmica en Cancún"
    description="Diagnosticamos equipos que se calientan, hacen demasiado ruido, pierden rendimiento o se apagan. Revisamos la causa antes de cambiar pasta térmica o recomendar piezas."
    image="/assets/images/mantenimiento-pastaternima-thermalpads.webp"
    imageAlt="Cambio de pasta térmica y revisión de sobrecalentamiento en Cancún"
    badges={[
      { icon: 'fa-stethoscope', label: 'Diagnóstico', value: 'Térmico y funcional' },
      { icon: 'fa-fan', label: 'Servicio', value: 'Limpieza interna' },
    ]}
    price={service.fromPrice || '$550 MXN'}
    primaryHref={`https://wa.me/529986690777?text=${whatsappText}`}
    primaryLabel="Solicitar revisión"
    secondaryHref="#ticket-sobrecalentamiento"
    secondaryLabel="Crear ticket"
    benefits={['Diagnóstico antes de intervenir', 'Laptop, PC y gamer', 'Prueba térmica final']}
  />

  <main>
    <DiagnosticSection
      eyebrow="Diagnóstico térmico"
      title="Cinco puntos que revisamos antes de recomendar una solución"
      description="El calor es un síntoma. Este tablero resume los componentes que determinan si el equipo necesita limpieza, pasta térmica, ventilador, ajuste de montaje o una reparación distinta."
      items={diagnosticItems}
    />

    <DarkTechnicalSection
      id="ruta-tecnica"
      eyebrow="Ruta técnica"
      title="La solución cambia según dónde se queda atrapado el calor"
      description="No tratamos igual una pasta seca, un ventilador desgastado, un heatpipe defectuoso o un gabinete sin flujo de aire. La medición guía la intervención."
      steps={technicalSteps}
      topFadeColor="#f4f8fb"
      bottomFadeColor="#ffffff"
    />

    <BeforeAfterSection
      title="Cómo se ve una respuesta térmica más estable"
      description="La meta no es perseguir una cifra universal, sino evitar picos, ruido excesivo y pérdida de frecuencia. La comparación muestra el tipo de cambio que buscamos y medimos."
    />

    <section class="process-section">
      <div class="page-shell">
        <header class="section-intro">
          <span>Limpieza interna</span>
          <h2>Un proceso continuo, no una foto decorativa</h2>
          <p>La calidad del servicio depende de cómo se abre, limpia, inspecciona, ensambla y prueba el equipo. Cada paso deja preparado el siguiente.</p>
        </header>
        <ol class="process-track">
          {process.map(([number, title, description]) => (
            <li><strong>{number}</strong><div><h3>{title}</h3><p>{description}</p></div></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="device-section">
      <div class="device-section__media" role="img" aria-label="Mantenimiento térmico para laptop gamer y PC en Cancún"></div>
      <div class="page-shell device-section__content">
        <span class="section-label">Equipos de alto rendimiento</span>
        <h2>Laptop gamer, PC ensamblada y workstation</h2>
        <p>En equipos de juego, arquitectura, edición o render revisamos CPU y GPU como un sistema. También verificamos la ventilación del gabinete, presión del disipador, pads de memoria y enfriamiento líquido cuando aplica.</p>
        <div class="device-metrics">
          <div><strong>CPU + GPU</strong><span>Evaluación conjunta</span></div>
          <div><strong>Aire + contacto</strong><span>Dos rutas de calor</span></div>
          <div><strong>Carga real</strong><span>Prueba según uso</span></div>
        </div>
      </div>
    </section>

    <section class="brands-section" aria-label="Marcas de laptop gamer atendidas">
      <div class="page-shell">
        <header class="brands-section__heading">
          <span>Compatibilidad por modelo</span>
          <h2>El sistema térmico cambia por fabricante. El procedimiento también.</h2>
          <p>Antes de abrir confirmamos modelo, distribución de heatpipes, número de ventiladores y tipo de compuesto. Así evitamos tratar todos los equipos como si fueran iguales.</p>
        </header>

        <div class="brand-matrix">
          <article><span>01</span><div><strong>ASUS ROG</strong><small>ROG / TUF</small></div><p>Doble ventilador, GPU dedicada y disipadores compartidos.</p></article>
          <article><span>02</span><div><strong>MSI</strong><small>Katana / Raider</small></div><p>Varias zonas térmicas y acceso distinto según chasis.</p></article>
          <article><span>03</span><div><strong>LENOVO LEGION</strong><small>Legion / LOQ</small></div><p>Heatpipes amplios, pads y salidas traseras de aire.</p></article>
          <article><span>04</span><div><strong>ACER NITRO</strong><small>Nitro / Predator</small></div><p>Rejillas sensibles al polvo y ventilación lateral.</p></article>
          <article><span>05</span><div><strong>HP OMEN</strong><small>Omen / Victus</small></div><p>Montaje térmico compacto y presión uniforme crítica.</p></article>
          <article><span>06</span><div><strong>DELL G</strong><small>G Series / Alienware</small></div><p>Diseño interno por generación y módulos de ventilación.</p></article>
        </div>

        <div class="office-band">
          <div><i class="fa-solid fa-laptop" aria-hidden="true"></i><span>Oficina y ultrabooks</span></div>
          <p>También atendemos HP, Dell, Lenovo, Acer, Asus y otros fabricantes. Confirmamos el modelo exacto antes de desarmar porque incluso dentro de una misma marca cambia la apertura.</p>
          <span>Modelo primero</span>
        </div>
      </div>
    </section>

    <section class="decision-section">
      <div class="page-shell decision-grid">
        <header><span>Decisión técnica</span><h2>No todo sobrecalentamiento se resuelve con pasta térmica</h2></header>
        <div class="decision-list">
          <article><strong>01</strong><h3>Solo limpieza</h3><p>Cuando el compuesto está bien pero el disipador y las rejillas están bloqueados.</p></article>
          <article><strong>02</strong><h3>Pasta y mantenimiento</h3><p>Cuando hay compuesto seco, polvo y pérdida de transferencia térmica.</p></article>
          <article><strong>03</strong><h3>Cambio de ventilador</h3><p>Cuando gira lento, se detiene, vibra o ya no mueve suficiente aire.</p></article>
          <article><strong>04</strong><h3>Diagnóstico adicional</h3><p>Cuando la causa está en bomba, sensor, placa, software o alimentación.</p></article>
        </div>
      </div>
    </section>

    <section class="local-section">
      <div class="page-shell local-grid">
        <div><span>Servicio local</span><h2>El clima de Cancún exige revisar polvo, humedad y salitre</h2><p>Atendemos equipos de Cancún Centro, Huayacán, Cumbres, Bonfil, Polígono Sur, Puerto Cancún, Av. Tulum, Bonampak, Puerto Juárez, Zona Hotelera y Supermanzanas.</p></div>
        <aside><strong>Pixon PC / Rentalap</strong><span>Cto. Hacienda Chimay, 77539 Cancún, Q.R.</span><a href="tel:+529986690777">+52 998 669 0777</a><a href="mailto:pixonpc@gmail.com">pixonpc@gmail.com</a></aside>
      </div>
    </section>

    <section class="mid-cta">
      <div class="page-shell"><div><span>Diagnóstico antes de gastar</span><h2>Confirma la causa antes de cambiar piezas</h2><p>Cuéntanos cuándo se calienta, qué ruido hace y en qué tareas pierde rendimiento.</p></div><a href="#ticket-sobrecalentamiento">Agendar diagnóstico <i class="fa-solid fa-arrow-right"></i></a></div>
    </section>

    <ServiceTicketSection id="ticket-sobrecalentamiento" defaultDevice="Laptop / PC" defaultService="Sobrecalentamiento y pasta térmica" title="Solicita diagnóstico de temperatura" subtitle="Indica modelo, temperatura aproximada, ruido, apagados y en qué tareas aparece el problema." />
    <RelatedServicesSection category={category} service={service} title="Servicios relacionados con temperatura y rendimiento" eyebrow="Diagnóstico conectado" items={relatedCards} compact={true} initialLimit={6} />
    <FaqSection id="faq-sobrecalentamiento" title="Preguntas frecuentes sobre sobrecalentamiento y pasta térmica" description="Respuestas sobre diagnóstico, costos, tiempos, thermal pads y mantenimiento para laptop y PC en Cancún." items={faqs} viewMoreHref="/preguntas-frecuentes" viewMoreLabel="Ver más preguntas frecuentes" ariaLabel="Preguntas frecuentes sobre sobrecalentamiento y cambio de pasta térmica" backgroundColor="#f5f8fb" titleColor="#071F3A" descriptionColor="#24435f" questionColor="#071F3A" />
    <CommentsSection serviceId={service.slug} serviceName="Sobrecalentamiento y pasta térmica" category={category.slug} />
    <ContactSection />
  </main>
  <Footer />
</div>

<style>
  .thermal-page { --navy: #071f3a; --blue: #1683e5; color: var(--navy); background: #fff; overflow: hidden; }
  .thermal-page :global(*) { box-sizing: border-box; }
  .page-shell { width: min(1180px, calc(100% - 32px)); margin: 0 auto; }
  .section-intro { max-width: 760px; margin-bottom: 48px; }
  .section-intro > span, .section-label, .brands-section__heading > span, .decision-grid header > span, .local-grid > div > span, .mid-cta span { color: #1672ca; font-size: .78rem; font-weight: 850; letter-spacing: .04em; text-transform: uppercase; }
  .section-intro h2, .device-section h2, .brands-section h2, .decision-section h2, .local-section h2, .mid-cta h2 { margin: 10px 0 16px; color: var(--navy); font-family: 'Kanit', sans-serif; font-size: clamp(2rem, 3.5vw, 3.15rem); line-height: 1.05; letter-spacing: 0; text-wrap: balance; }
  .section-intro p, .device-section p, .brands-section p, .decision-section p, .local-section p, .mid-cta p { margin: 0; color: #294963; line-height: 1.7; }
  .process-section { padding: clamp(76px, 9vw, 116px) 0; background: #fff; }
  .process-track { display: grid; grid-template-columns: repeat(5, 1fr); margin: 0; padding: 0; border-top: 1px solid #cfdce7; list-style: none; }
  .process-track li { position: relative; padding: 26px 20px 0 0; }
  .process-track li::before { content: ''; position: absolute; top: -5px; left: 0; width: 9px; height: 9px; border-radius: 50%; background: var(--blue); box-shadow: 0 0 0 5px #eaf4fd; }
  .process-track strong { display: block; margin-bottom: 38px; color: #6b8296; font-size: .75rem; }
  .process-track h3 { margin: 0 0 8px; color: var(--navy); font-size: 1.08rem; }
  .process-track p { margin: 0; color: #31506c; font-size: .9rem; line-height: 1.6; }
  .device-section { position: relative; min-height: 680px; display: grid; align-items: end; overflow: hidden; color: #fff; background: #071f3a !important; isolation: isolate; }
  .device-section__media { position: absolute; inset: 0; z-index: 0; background: url('/assets/images/ensamble-pc-gamer-cancun.webp') center 43% / cover no-repeat; }
  .device-section::after { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgb(3 17 31 / 91%) 0%, rgb(3 17 31 / 72%) 46%, rgb(3 17 31 / 18%) 100%); pointer-events: none; }
  .device-section__content { position: relative; z-index: 2; padding-bottom: 66px; }
  .device-section__content > * { max-width: 670px; }
  .device-section .section-label { color: #bfe2ff; }
  .device-section h2 { margin: 10px 0 16px; color: #fff !important; }
  .device-section p { color: rgb(255 255 255 / 82%) !important; }
  .device-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; max-width: 700px; margin-top: 30px; background: rgb(255 255 255 / 22%); }
  .device-metrics div { display: grid; gap: 4px; padding: 17px; background: rgb(5 25 45 / 76%); backdrop-filter: blur(8px); }
  .device-metrics strong { color: #fff; }
  .device-metrics span { color: rgb(255 255 255 / 72%); font-size: .78rem; }
  .brands-section { padding: clamp(72px, 8vw, 100px) 0; background: #f4f8fb; }
  .brands-section__heading { max-width: 760px; }
  .brands-section__heading h2 { margin: 10px 0 16px; }
  .brands-section__heading p { max-width: 66ch; }
  .brand-matrix { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 42px; border-top: 1px solid #cbd9e4; border-left: 1px solid #cbd9e4; background: #fff; }
  .brand-matrix article { display: grid; grid-template-columns: 30px 1fr; gap: 16px; min-height: 185px; padding: 24px; border-right: 1px solid #cbd9e4; border-bottom: 1px solid #cbd9e4; }
  .brand-matrix article > span { color: var(--blue); font-size: .72rem; font-weight: 900; }
  .brand-matrix article div { display: grid; align-content: start; gap: 5px; }
  .brand-matrix strong { color: var(--navy); font-size: 1rem; }
  .brand-matrix small { color: #607a91; font-size: .75rem; font-weight: 750; }
  .brand-matrix p { grid-column: 2; align-self: end; color: #31506c; font-size: .88rem; line-height: 1.55; }
  .office-band { display: grid; grid-template-columns: 220px 1fr auto; gap: 26px; align-items: center; margin-top: 20px; padding: 22px 24px; border-left: 3px solid var(--blue); background: #e8f2fa; }
  .office-band > div { display: flex; align-items: center; gap: 11px; }
  .office-band i { color: var(--blue); }
  .office-band div span { color: var(--navy); font-weight: 850; }
  .office-band p { color: #294963; font-size: .9rem; line-height: 1.6; }
  .office-band > span { padding: 7px 10px; border: 1px solid #b5cde0; border-radius: 5px; color: #0a67b6; font-size: .72rem; font-weight: 850; text-transform: uppercase; white-space: nowrap; }
  .decision-section { padding: clamp(76px, 9vw, 116px) 0; }
  .decision-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(40px, 8vw, 100px); }
  .decision-grid header h2 { margin-top: 12px; }
  .decision-list { border-top: 1px solid #cad8e4; }
  .decision-list article { display: grid; grid-template-columns: 44px 180px 1fr; gap: 18px; align-items: baseline; padding: 23px 0; border-bottom: 1px solid #cad8e4; }
  .decision-list strong { color: var(--blue); font-size: .75rem; }
  .decision-list h3 { margin: 0; color: var(--navy); font-size: 1rem; }
  .local-section { padding: 76px 0; background: #f4f8fb; }
  .local-grid { display: grid; grid-template-columns: 1fr 320px; gap: clamp(38px, 8vw, 100px); }
  .local-grid h2 { margin: 10px 0 16px; }
  .local-grid aside { display: grid; align-content: start; gap: 10px; padding-left: 24px; border-left: 3px solid var(--blue); }
  .local-grid aside :where(strong, span, a) { color: var(--navy); text-decoration: none; }
  .mid-cta { padding: 42px 0; background: #fff; }
  .mid-cta .page-shell { display: flex; align-items: center; justify-content: space-between; gap: 35px; padding: 34px 38px; border: 1px solid #cfdee9; border-radius: 8px; }
  .mid-cta h2 { margin: 8px 0; font-size: clamp(1.65rem, 2.7vw, 2.35rem); }
  .mid-cta a { display: inline-flex; flex: 0 0 auto; min-height: 48px; align-items: center; gap: 9px; padding: 0 20px; border-radius: 7px; background: var(--blue); color: #fff; font-weight: 800; text-decoration: none; transition: transform 180ms ease-out, background-color 180ms ease-out; }
  .mid-cta a:active { transform: scale(.97); }
  @media (hover: hover) and (pointer: fine) { .mid-cta a:hover { transform: translateY(-2px); background: #0874d2; } }
  @media (max-width: 900px) {
    .process-track { grid-template-columns: repeat(2, 1fr); gap: 32px 0; border-top: 0; } .process-track li { border-top: 1px solid #cfdce7; }
    .brand-matrix { grid-template-columns: repeat(2, 1fr); }
    .office-band { grid-template-columns: 1fr; gap: 12px; }
    .office-band > span { width: fit-content; }
    .decision-grid, .local-grid { grid-template-columns: 1fr; }
    .local-grid aside { padding: 20px 0 0; border-top: 3px solid var(--blue); border-left: 0; }
  }
  @media (max-width: 640px) {
    .process-track { grid-template-columns: 1fr; } .process-track strong { margin-bottom: 18px; }
    .device-section { min-height: 720px; } .device-section::after { background: linear-gradient(0deg, rgb(3 17 31 / 94%) 0%, rgb(3 17 31 / 65%) 66%, rgb(3 17 31 / 28%) 100%); }
    .device-metrics { grid-template-columns: 1fr; }
    .brand-matrix { grid-template-columns: 1fr; border-left: 0; }
    .brand-matrix article { min-height: 150px; padding: 22px 0; border-right: 0; }
    .decision-list article { grid-template-columns: 34px 1fr; } .decision-list article p { grid-column: 2; }
    .mid-cta .page-shell { align-items: stretch; flex-direction: column; padding: 27px 22px; } .mid-cta a { justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) { .mid-cta a { transition: none; } }
</style>
