---
import FaqSection from '../FaqSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import Footer from '../Footer.astro';

const { service, category } = Astro.props;

const waPrefill = encodeURIComponent(
  'Hola, necesito diagnóstico para mi Mac en Cancún.\n' +
  '• Tipo: MacBook / iMac / Mac mini\n' +
  '• Modelo o año aprox:\n' +
  '• Chip (Intel / M1 / M2 / M3 / M4 / No sé):\n' +
  '• Síntoma principal:\n' +
  '• ¿Enciende?: Sí / No\n' +
  '• ¿Carga?: Sí / No\n' +
  '• ¿Hubo líquido o golpe?: Sí / No\n' +
  '• ¿Fue manipulada antes?: Sí / No'
);
const whatsappUrl = `https://wa.me/529986690777?text=${waPrefill}`;

const triageItems = [
  {
    icon: 'fa-power-off',
    title: 'No enciende o no carga',
    desc: 'Medición de cargador USB-C o MagSafe, batería, consumo de corriente en fuente y líneas de alimentación.',
    ownerHref: '/servicios/mac/macbook-no-enciende',
    ownerLabel: 'Ver MacBook no enciende',
  },
  {
    icon: 'fa-display',
    title: 'Pantalla negra o sin imagen',
    desc: 'Descarte de brillo, backlight, flex de video, salida a monitor externo, arranque de macOS y circuito gráfico.',
    ownerHref: '/servicios/mac/cambio-pantalla-macbook',
    ownerLabel: 'Ver Cambio de pantalla MacBook',
  },
  {
    icon: 'fa-laptop-code',
    title: 'macOS no arranca o se reinicia',
    desc: 'Análisis de disco de arranque, partición APFS, modo Recovery, First Aid y logs del sistema antes de reinstalar.',
    ownerHref: '/servicios/mac/software-macos',
    ownerLabel: 'Ver Software macOS',
  },
  {
    icon: 'fa-gauge-high',
    title: 'Mac lenta, congelada o beach ball',
    desc: 'Medición de salud del SSD, estrangulamiento térmico (throttling), memoria unificada y procesos en conflicto.',
    ownerHref: '#diagnostico-capas',
    ownerLabel: 'Revisión técnica en taller',
  },
  {
    icon: 'fa-temperature-arrow-up',
    title: 'Calor excesivo o ruido de ventilador',
    desc: 'Inspección de disipadores, pasta térmica en modelos Intel, sensores SMC y flujo de ventilación.',
    ownerHref: '/servicios/mac/mantenimiento-macbook',
    ownerLabel: 'Ver Mantenimiento MacBook',
  },
  {
    icon: 'fa-keyboard',
    title: 'Teclado, trackpad o puertos USB-C',
    desc: 'Comprobación de flex, batería hinchada presionando el trackpad, top case y sulfatación en puertos.',
    ownerHref: '/servicios/mac/teclado-macbook',
    ownerLabel: 'Ver Teclado MacBook',
  },
  {
    icon: 'fa-droplet',
    title: 'Derrame de líquido o humedad',
    desc: 'Inspección inmediata de sulfatación en placa lógica, corrosión bajo integrados y aislamiento de batería.',
    ownerHref: '/servicios/mac/limpieza-liquido-macbook',
    ownerLabel: 'Ver Limpieza por líquido MacBook',
  },
  {
    icon: 'fa-database',
    title: 'Archivos inaccesibles o fotos en riesgo',
    desc: 'Evaluación del almacenamiento NAND o unidad externa para verificar si es legible antes de alterar el sistema.',
    ownerHref: '/servicios/mac/recuperacion-datos-mac',
    ownerLabel: 'Ver Recuperación de datos Mac',
  },
];

const diagnosticLayers = [
  {
    step: '01',
    layer: 'Alimentación y Entrada',
    desc: 'Medimos cargador USB-C o MagSafe, cable, voltajes de entrada y circuito de detección de carga.',
    icon: 'fa-plug-circle-bolt',
  },
  {
    step: '02',
    layer: 'Encendido y Consumo',
    desc: 'Prueba en fuente de laboratorio, medición de amperios, rieles de voltaje y controladores PMIC/SMC.',
    icon: 'fa-bolt',
  },
  {
    step: '03',
    layer: 'Video e Imagen',
    desc: 'Validación de panel Retina, flex de video, backlight, sensor de tapa y salida DisplayPort/HDMI.',
    icon: 'fa-display',
  },
  {
    step: '04',
    layer: 'Almacenamiento y macOS',
    desc: 'Estado de celdas SSD/NAND, partición APFS, modo Recovery y posibilidad de respaldo previo.',
    icon: 'fa-hard-drive',
  },
  {
    step: '05',
    layer: 'Periféricos e Interfaces',
    desc: 'Comprobación tecla por tecla, trackpad, puertos Thunderbolt, cámara, audio y conectividad WiFi.',
    icon: 'fa-keyboard',
  },
  {
    step: '06',
    layer: 'Comportamiento Térmico',
    desc: 'Monitoreo de sensores de calor, disipador, ventiladores y detección de thermal throttling.',
    icon: 'fa-temperature-three-quarters',
  },
  {
    step: '07',
    layer: 'Placa Lógica y Circuitos',
    desc: 'Inspección bajo microscopio óptico, detección de corrosión, sulfatación y líneas en corto.',
    icon: 'fa-microchip',
  },
];

const modelMatrix = [
  {
    device: 'MacBook Air',
    sizes: '11”, 13” y 15”',
    chips: 'Intel Core i5/i7 (2013-2020) y Apple Silicon (M1, M2, M3)',
    notes: 'Revisión de consumo ultra bajo, baterías integradas, puertos USB-C/MagSafe y disipación pasiva en modelos M.',
  },
  {
    device: 'MacBook Pro',
    sizes: '13”, 14”, 15” y 16”',
    chips: 'Intel (2013-2020) y Apple Silicon (M1 Pro/Max, M2, M3, M4)',
    notes: 'Pruebas de pantallas Retina Liquid XDR, baterías de alta densidad, ventilación activa dual y GPU dedicada en Intel.',
  },
  {
    device: 'iMac',
    sizes: '21.5”, 24” y 27”',
    chips: 'Intel Retina 4K/5K y Apple Silicon (M1, M3)',
    notes: 'Diagnóstico de fuentes de poder internas, pantallas todo-en-uno, conectividad, sensores y ventilación.',
  },
  {
    device: 'Mac mini',
    sizes: 'Chasis compacto',
    chips: 'Intel (2014-2018) y Apple Silicon (M1, M2, M2 Pro, M4)',
    notes: 'Inspección de módulo de alimentación interna, puertos HDMI/Thunderbolt, antenas de red y arranque de macOS.',
  },
];

const postDiagnosisOutcomes = [
  {
    status: 'No requiere reparación',
    icon: 'fa-circle-check',
    color: '#0284c7',
    desc: 'El fallo se debía a configuración corrupta de macOS, cargador defectuoso ajeno o conflicto de software menor.',
  },
  {
    status: 'Mantenimiento térmico',
    icon: 'fa-temperature-arrow-down',
    color: '#0284c7',
    desc: 'Limpieza interna profunda de disipadores y ventilación para recuperar temperaturas de fábrica sin comprar refacciones.',
  },
  {
    status: 'Reemplazo de refacción',
    icon: 'fa-screwdriver-wrench',
    color: '#0284c7',
    desc: 'Batería, pantalla, teclado, top case o flex dañados. Se cotiza la pieza exacta compatible antes de proceder.',
  },
  {
    status: 'Intervención en placa lógica',
    icon: 'fa-microchip',
    color: '#0284c7',
    desc: 'Falla electrónica, sulfatación o líneas en corto; evaluamos viabilidad, tasa de éxito y presupuesto previo.',
  },
  {
    status: 'Prioridad rescate de datos',
    icon: 'fa-database',
    color: '#0284c7',
    desc: 'Si el equipo tiene daño severo en placa pero el almacenamiento es legible, se canaliza a extracción de archivos.',
  },
  {
    status: 'No conviene reparar',
    icon: 'fa-scale-balanced',
    color: '#0284c7',
    desc: 'Si el costo de las refacciones supera el valor de mercado de la Mac, te lo decimos con honestidad para que no gastes de más.',
  },
];

const riskActionRows = [
  {
    situation: 'Derrame de líquido, café o agua',
    avoid: 'No conectar cargador ni usar secadora de pelo o arroz.',
    action: 'Apagar de inmediato y llevar a taller para desconectar batería e inspeccionar sulfatación.',
  },
  {
    situation: 'Falla de arranque o carpeta con signo “?”',
    avoid: 'No forzar formateos repetidos ni reinstalaciones a ciegas.',
    action: 'Evaluar la salud del almacenamiento SSD antes de manipular particiones que comprometan datos.',
  },
  {
    situation: 'Batería inflada o trackpad levantado',
    avoid: 'No presionar la carcasa ni forzar clics en el trackpad.',
    action: 'Detener el uso para evitar deformación permanente en el top case, teclado o rotura de pantalla.',
  },
  {
    situation: 'Sobrecalentamiento o ventilador al 100%',
    avoid: 'No utilizar la Mac sobre camas, cobijas o superficies blandas.',
    action: 'Permitir que el equipo repose y programar revisión técnica del sistema de disipación y sensores.',
  },
];

const relatedServices = [
  { href: '/servicios/mac/reparacion-macbook', icon: 'fa-laptop-medical', label: 'Reparación MacBook', desc: 'Revisión integral para MacBook Air y Pro con falla identificada.' },
  { href: '/servicios/mac/macbook-no-enciende', icon: 'fa-power-off', label: 'MacBook no enciende', desc: 'Diagnóstico específico de energía, cargador, consumo y placa.' },
  { href: '/servicios/mac/mantenimiento-macbook', icon: 'fa-fan', label: 'Mantenimiento MacBook', desc: 'Limpieza interna, control térmico y pasta térmica en Cancún.' },
  { href: '/servicios/mac/software-macos', icon: 'fa-laptop-code', label: 'Software macOS', desc: 'Reinstalación, actualización y soporte de sistema operativo.' },
  { href: '/servicios/mac/cambio-bateria-macbook', icon: 'fa-battery-half', label: 'Cambio batería MacBook', desc: 'Baterías compatibles para Air y Pro con diagnóstico de carga.' },
  { href: '/servicios/mac/cambio-pantalla-macbook', icon: 'fa-display', label: 'Cambio pantalla MacBook', desc: 'Reemplazo de ensamble de pantalla Retina por modelo exacto.' },
  { href: '/servicios/mac/teclado-macbook', icon: 'fa-keyboard', label: 'Teclado MacBook', desc: 'Reparación de teclado, flex, top case y trackpad en Cancún.' },
  { href: '/servicios/mac/limpieza-liquido-macbook', icon: 'fa-droplet', label: 'Limpieza por líquido', desc: 'Atención por agua, café, humedad o salitre sin energizar.' },
  { href: '/servicios/mac/recuperacion-datos-mac', icon: 'fa-database', label: 'Recuperación de datos Mac', desc: 'Prioridad de archivos cuando el equipo o SSD están en riesgo.' },
  { href: '/servicios/mac/reparacion-imac-mac-mini', icon: 'fa-desktop', label: 'Reparación iMac y Mac mini', desc: 'Servicio técnico para computadoras de escritorio Apple.' },
];

const faqs = service?.faqs ?? [];
---

<main class="mac-diag-page" id="main-content">
  <!-- HERO SECTION: Mobile first (Eyebrow -> H1 -> Clean Photo -> Copy -> CTA -> Trust) -->
  <header class="md-hero" aria-labelledby="hero-title">
    <div class="container md-hero__grid">
      <div class="md-hero__copy">
        <p class="md-hero__eyebrow" id="hero-eyebrow">
          <i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i> Diagnóstico Técnico en Cancún
        </p>
        <h1 class="md-hero__title" id="hero-title">Diagnóstico Mac en Cancún</h1>

        <!-- Mobile photo placement: immediately after H1 on mobile viewports, without obstructions -->
        <div class="md-hero__visual md-hero__visual--mobile" aria-hidden="true">
          <img
            src="/assets/images/responsive/mantenimiento-macbook-cancun.webp"
            alt="Técnico realizando diagnóstico de MacBook en Cancún con mediciones de placa lógica y energía"
            width="800"
            height="800"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        <p class="md-hero__lead">
          Revisamos MacBook, iMac y Mac mini cuando la causa de la falla aún no está confirmada. Separamos problemas de energía, pantalla, batería, almacenamiento, macOS, temperatura, humedad y placa lógica antes de cotizar una reparación.
        </p>

        <div class="md-hero__actions">
          <a
            class="md-btn md-btn--primary"
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            id="md-hero-cta-wa"
          >
            <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Diagnosticar mi Mac
          </a>
          <a
            class="md-btn md-btn--secondary"
            href="#ticket-form"
            id="md-hero-cta-ticket"
          >
            <i class="fa-solid fa-ticket" aria-hidden="true"></i> Crear ticket de revisión
          </a>
        </div>

        <ul class="md-hero__trust" aria-label="Condiciones clave del diagnóstico">
          <li>
            <i class="fa-solid fa-tag" aria-hidden="true"></i>
            <span><strong>Desde $600 MXN</strong>Revisión técnica inicial</span>
          </li>
          <li>
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <span><strong>Sin adivinanzas</strong>Pruebas por módulos antes de comprar piezas</span>
          </li>
          <li>
            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
            <span><strong>Datos cuidados</strong>Evaluación previa de almacenamiento</span>
          </li>
          <li>
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            <span><strong>Taller en Cancún</strong>Atención con cita previa y seguimiento</span>
          </li>
        </ul>
      </div>

      <!-- Desktop photo placement: balanced right column -->
      <figure class="md-hero__visual md-hero__visual--desktop">
        <img
          src="/assets/images/responsive/mantenimiento-macbook-cancun.webp"
          alt="Técnico realizando diagnóstico de MacBook en Cancún con mediciones de placa lógica y energía"
          width="800"
          height="800"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption class="md-hero__caption">
          <i class="fa-solid fa-microchip" aria-hidden="true"></i> Inspección modular de energía, hardware y macOS
        </figcaption>
      </figure>
    </div>
  </header>

  <!-- SECCIÓN 1: TRIAJE VISUAL ¿QUÉ LE PASA A TU MAC? -->
  <section class="md-section" id="triaje" aria-labelledby="triaje-title">
    <div class="container">
      <div class="md-section__header">
        <span class="md-kicker"><i class="fa-solid fa-list-check" aria-hidden="true"></i> Triaje Inicial</span>
        <h2 id="triaje-title">¿Qué le pasa a tu Mac?</h2>
        <p>
          Identifica el síntoma principal. Si no sabes qué componente falla, el diagnóstico técnico determina la causa raíz en taller. Si tu equipo ya presenta un daño específico evidente, te derivamos directamente al área correspondiente.
        </p>
      </div>

      <div class="md-triage-grid">
        {triageItems.map((item) => (
          <article class="md-triage-card">
            <div class="md-triage-card__head">
              <span class="md-icon-box"><i class={`fa-solid ${item.icon}`} aria-hidden="true"></i></span>
              <h3>{item.title}</h3>
            </div>
            <p class="md-triage-card__desc">{item.desc}</p>
            <a class="md-triage-card__link" href={item.ownerHref}>
              {item.ownerLabel} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SECCIÓN 2: DIAGNÓSTICO POR CAPAS -->
  <section class="md-section md-section--alt" id="diagnostico-capas" aria-labelledby="capas-title">
    <div class="container">
      <div class="md-section__header">
        <span class="md-kicker"><i class="fa-solid fa-layer-group" aria-hidden="true"></i> Metodología Modular</span>
        <h2 id="capas-title">Diagnóstico por capas: de la alimentación a la placa lógica</h2>
        <p>
          Un síntoma no es un veredicto. Una Mac que no carga puede deberse al cargador, al cable, al puerto USB-C/MagSafe, a la batería, a un sensor SMC o a un integrado de alimentación en placa. Aplicamos pruebas progresivas para confirmar el origen real de la falla.
        </p>
      </div>

      <div class="md-layers-flow">
        {diagnosticLayers.map((l) => (
          <div class="md-layer-item">
            <div class="md-layer-item__num">{l.step}</div>
            <div class="md-layer-item__body">
              <div class="md-layer-item__title">
                <i class={`fa-solid ${l.icon}`} aria-hidden="true"></i>
                <h3>{l.layer}</h3>
              </div>
              <p>{l.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="md-note">
        <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
        <em>Nota técnica:</em> El orden y profundidad de las pruebas se adaptan al modelo exacto y al síntoma reportado.
      </p>
    </div>
  </section>

  <!-- SECCIÓN 3: HARDWARE VS MACOS VS DATOS -->
  <section class="md-section" id="areas-diagnostico" aria-labelledby="areas-title">
    <div class="container">
      <div class="md-section__header">
        <span class="md-kicker"><i class="fa-solid fa-diagram-project" aria-hidden="true"></i> Alcance Técnico</span>
        <h2 id="areas-title">Separamos el problema: Hardware, macOS o Datos</h2>
        <p>
          Una Mac lenta o con problemas de arranque puede deberse a desgaste físico, archivos de sistema corruptos o sectores inestables en almacenamiento. Identificar el área evita intervenciones innecesarias o destructivas.
        </p>
      </div>

      <div class="md-areas-grid">
        <article class="md-area-card">
          <div class="md-area-card__top">
            <span class="md-icon-box"><i class="fa-solid fa-microchip" aria-hidden="true"></i></span>
            <h3>Hardware Físico y Electrónico</h3>
          </div>
          <p>
            Alimentación, cargador, batería, panel Retina, puertos Thunderbolt, disipadores, chips de gestión de energía o circuitos soldados.
          </p>
          <ul class="md-area-card__list">
            <li>Medición eléctrica en rieles de voltaje</li>
            <li>Inspección de cortos y consumo en amperios</li>
            <li>Las fallas físicas no se resuelven formateando</li>
          </ul>
        </article>

        <article class="md-area-card">
          <div class="md-area-card__top">
            <span class="md-icon-box"><i class="fa-solid fa-laptop-code" aria-hidden="true"></i></span>
            <h3>macOS y Software de Sistema</h3>
          </div>
          <p>
            Actualizaciones interrumpidas, incompatibilidades de versión, extensiones dañadas, permisos de usuario o saturación de procesos.
          </p>
          <ul class="md-area-card__list">
            <li>Pruebas en modo Recovery y First Aid</li>
            <li>Análisis de logs de pánico de kernel (Kernel Panic)</li>
            <li>Optimización o reinstalación limpia conservando archivos</li>
          </ul>
        </article>

        <article class="md-area-card">
          <div class="md-area-card__top">
            <span class="md-icon-box"><i class="fa-solid fa-database" aria-hidden="true"></i></span>
            <h3>Almacenamiento y Datos</h3>
          </div>
          <p>
            Salud de las celdas NAND del SSD, tablas de partición APFS, archivos de trabajo, proyectos y documentos personales del cliente.
          </p>
          <ul class="md-area-card__list">
            <li>Evaluación previa de legibilidad de la unidad</li>
            <li>Prioridad de rescate antes de procedimientos agresivos</li>
            <li>No formateamos sin previa autorización escrita</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 4: INTEL VS APPLE SILICON -->
  <section class="md-section md-section--alt" id="arquitectura" aria-labelledby="arquitectura-title">
    <div class="container">
      <div class="md-section__header">
        <span class="md-kicker"><i class="fa-solid fa-atom" aria-hidden="true"></i> Arquitectura Apple</span>
        <h2 id="arquitectura-title">Diagnóstico para Mac Intel y Apple Silicon (M1 a M4)</h2>
        <p>
          La estructura de una Mac cambia radicalmente según la plataforma de procesamiento. Conocer la arquitectura nos permite diagnosticar con exactitud los puntos críticos de cada generación.
        </p>
      </div>

      <div class="md-arch-grid">
        <article class="md-arch-card">
          <div class="md-arch-card__badge">SoC Integrado</div>
          <h3>Apple Silicon (M1, M2, M3, M4)</h3>
          <p class="md-arch-card__summary">
            Diseño System on Chip con CPU, GPU y Neural Engine en el mismo encapsulado. Memoria unificada (UMA) y almacenamiento SSD soldados directamente en placa lógica.
          </p>
          <ul class="md-arch-list">
            <li><strong>Gestión de energía:</strong> Diagnóstico de controladores PMIC integrados y rieles de bajo voltaje.</li>
            <li><strong>Almacenamiento cifrado:</strong> Enlazado al procesador mediante Secure Enclave; el rescate requiere estabilizar la placa.</li>
            <li><strong>Modo de recuperación:</strong> Diagnóstico desde menú <em>Startup Options</em> manteniendo presionado el botón de encendido.</li>
            <li><strong>Restauración de firmware:</strong> Pruebas DFU con herramientas de soporte cuando el equipo queda en bucle de arranque.</li>
          </ul>
        </article>

        <article class="md-arch-card">
          <div class="md-arch-card__badge">Arquitectura Clásica</div>
          <h3>Modelos Mac con Procesador Intel</h3>
          <p class="md-arch-card__summary">
            Procesador modular independiente con puente sur/PCH y, en modelos de 15” y 16”, gráficos dedicados (GPU AMD/NVIDIA).
          </p>
          <ul class="md-arch-list">
            <li><strong>Gestión térmica:</strong> Mayor susceptibilidad a acumulación de polvo y degradación de pasta térmica en disipadores.</li>
            <li><strong>Controlador SMC:</strong> Diagnóstico y reinicio de System Management Controller ante fallas de ventilación o carga.</li>
            <li><strong>NVRAM / PRAM:</strong> Almacena configuraciones de arranque y resolución de pantalla; comprobación de batería interna.</li>
            <li><strong>Compatibilidad macOS:</strong> Evaluación de versiones compatibles según año y parches oficiales de seguridad.</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 5: MATRIZ DE MODELOS -->
  <section class="md-section" id="modelos" aria-labelledby="modelos-title">
    <div class="container">
      <div class="md-section__header">
        <span class="md-kicker"><i class="fa-solid fa-laptop" aria-hidden="true"></i> Compatibilidad</span>
        <h2 id="modelos-title">Modelos de Mac que diagnosticamos en Cancún</h2>
        <p>
          Atendemos portátiles y computadoras de escritorio Apple de uso personal, profesional o para empresas.
        </p>
      </div>

      <div class="md-matrix-grid">
        {modelMatrix.map((m) => (
          <article class="md-matrix-card">
            <div class="md-matrix-card__head">
              <h3>{m.device}</h3>
              <span class="md-matrix-card__sizes">{m.sizes}</span>
            </div>
            <div class="md-matrix-card__chips">
              <strong>Plataformas:</strong> {m.chips}
            </div>
            <p>{m.notes}</p>
          </article>
        ))}
      </div>

      <div class="md-matrix-footer">
        <i class="fa-solid fa-circle-question" aria-hidden="true"></i>
        <span>
