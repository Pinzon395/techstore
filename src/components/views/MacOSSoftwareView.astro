---
import FaqSection from '../FaqSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';

const { service, category } = Astro.props;

const waMessage = encodeURIComponent(
  'Hola, necesito soporte de macOS en Cancún. Mi Mac tiene un problema de software y quiero cotizar.'
);

const problems = [
  {
    icon: 'fa-gauge-high',
    title: 'macOS lento en Cancún',
    h3: '¿Por qué mi Mac va lenta después de actualizar macOS?',
    desc: 'Revisamos almacenamiento SSD casi lleno, apps con consumo excesivo, procesos de indexación de Spotlight, login items acumulados y temperatura antes de recomendar reinstalación.',
    tags: ['macOS Ventura', 'macOS Sonoma', 'macOS Sequoia', 'MacBook Air M1/M2'],
  },
  {
    icon: 'fa-power-off',
    title: 'Mac no termina de iniciar',
    h3: '¿Qué hacer si mi Mac se queda en la pantalla de carga?',
    desc: 'Probamos modo seguro, recuperación, diagnóstico de disco con First Aid, revisión de partición de arranque, y evaluamos si el problema es software o almacenamiento antes de formatear.',
    tags: ['Pantalla barra de progreso', 'Modo Recovery', 'Apple Silicon', 'Intel'],
  },
  {
    icon: 'fa-arrow-up-from-bracket',
    title: 'Actualización de macOS fallida',
    h3: 'Cómo actualizar macOS sin perder archivos en Cancún',
    desc: 'Validamos espacio disponible, salud del SSD, versión de firmware y compatibilidad del modelo. Realizamos respaldo previo y guiamos la actualización para evitar errores de instalación.',
    tags: ['Sonoma', 'Sequoia', 'M3', 'MacBook Pro'],
  },
  {
    icon: 'fa-window-close',
    title: 'Apps que no abren o dan error',
    h3: 'Solución para aplicaciones dañadas o incompatibles en Mac',
    desc: 'Revisamos permisos de Gatekeeper, archivos de preferencias corruptos, versión de macOS requerida por la app, conflictos de extensiones de kernel y caché del sistema.',
    tags: ['Gatekeeper', 'Rosetta 2', 'App Store', 'Apps terceros'],
  },
  {
    icon: 'fa-database',
    title: 'Respaldo y migración de datos Mac',
    h3: 'Respaldo con Time Machine y migración a nueva Mac en Cancún',
    desc: 'Configuramos Time Machine en disco externo o NAS, realizamos migración completa con Migration Assistant entre Macs, y validamos integridad de datos antes de formatear.',
    tags: ['Time Machine', 'Migration Assistant', 'iCloud', 'disco externo'],
  },
  {
    icon: 'fa-rotate',
    title: 'Reinstalación limpia de macOS',
    h3: 'Reinstalación de macOS Sonoma y Sequoia sin perder tus datos',
    desc: 'Realizamos reinstalación sobre el sistema actual o formateo completo con APFS según la falla. Respaldamos datos, reinstalamos macOS desde Recovery y configuramos el usuario desde cero.',
    tags: ['macOS Sequoia', 'APFS', 'Formateo', 'Recovery Mode'],
  },
  {
    icon: 'fa-shield-virus',
    title: 'Malware y adware en Mac',
    h3: 'Eliminación de virus, adware y software no deseado en macOS',
    desc: 'Analizamos extensiones de navegador sospechosas, procesos en segundo plano no reconocidos, perfiles de configuración instalados y Launch Agents sin autorización.',
    tags: ['Adware', 'Browser hijack', 'Launch Agents', 'Safari/Chrome'],
  },
  {
    icon: 'fa-wifi',
    title: 'Problemas de WiFi y Bluetooth en Mac',
    h3: 'Mac sin WiFi, Bluetooth fallando o sin red en Cancún',
    desc: 'Resetamos NVRAM, SMC y preferencias de red. Revisamos conflictos de VPN, interfaces duplicadas, permisos de red y descartamos falla de hardware en el módulo inalámbrico.',
    tags: ['NVRAM reset', 'SMC reset', 'Preferencias de red', 'AirDrop'],
  },
];

const steps = [
  {
    num: '01',
    title: 'Diagnóstico remoto o presencial',
    desc: 'Evalúas por WhatsApp o traes tu Mac. Identificamos si la falla es de software, almacenamiento o hardware para no invertir en lo que no corresponde.',
    icon: 'fa-magnifying-glass-chart',
  },
  {
    num: '02',
    title: 'Revisión del estado del sistema',
    desc: 'Accedemos a Actividad del Sistema, Console.app y herramientas de diagnóstico para mapear procesos con alto consumo, errores de kernel y salud del SSD.',
    icon: 'fa-terminal',
  },
  {
    num: '03',
    title: 'Respaldo antes de cualquier cambio',
    desc: 'Si hay riesgo de pérdida de datos por el proceso, priorizamos Time Machine o copia manual antes de reinstalar macOS, formatear o intervenir el almacenamiento.',
    icon: 'fa-database',
  },
  {
    num: '04',
    title: 'Reparación o reinstalación controlada',
    desc: 'Ejecutamos la solución más conservadora: desde reparar permisos y limpiar caché hasta reinstalación completa de macOS Sequoia o Sonoma según el caso.',
    icon: 'fa-screwdriver-wrench',
  },
  {
    num: '05',
    title: 'Configuración, apps y pruebas finales',
    desc: 'Restauramos usuario, instalamos apps esenciales, validamos rendimiento, temperatura, WiFi, Bluetooth, carga y estabilidad antes de entregar.',
    icon: 'fa-circle-check',
  },
];

const risks = [
  {
    icon: 'fa-triangle-exclamation',
    title: 'No formatees sin respaldo',
    text: 'Si macOS falla o el sistema no inicia, reinstalar sin respaldo previo puede significar pérdida permanente de fotos, documentos y proyectos.',
  },
  {
    icon: 'fa-rotate-right',
    title: 'No fuerces reinicios repetidos',
    text: 'Reiniciar a la fuerza una Mac con falla de sistema puede corromper el sistema de archivos APFS y complicar la recuperación de datos.',
  },
  {
    icon: 'fa-hard-drive',
    title: 'No ignores el almacenamiento lleno',
    text: 'macOS necesita espacio libre para crear archivos de intercambio de memoria. Sin espacio, el sistema se congela, los procesos fallan y la Mac se vuelve inutilizable.',
  },
  {
    icon: 'fa-download',
    title: 'No actualices si tienes falla activa',
    text: 'Actualizar macOS con una falla de disco, arranque inestable o SSD dañado puede interrumpir la instalación y dejar el sistema irrecuperable sin acceso a los datos.',
  },
];

const faqs = [
  {
    question: '¿Pueden solucionar macOS lento o que no termina de iniciar en Cancún?',
    answer: 'Sí. Revisamos procesos con alto consumo de CPU y RAM, almacenamiento casi lleno, login items, temperatura, salud del SSD y versión de macOS para encontrar la causa real antes de reinstalar.',
  },
  {
    question: '¿Pierdo mis archivos si reinstalan macOS en mi Mac?',
    answer: 'No necesariamente. La reinstalación sobre el sistema actual preserva tus datos en la mayoría de los casos. Si hay riesgo de pérdida, primero hacemos respaldo con Time Machine o copia manual antes de proceder.',
  },
  {
    question: '¿Instalan macOS Sequoia o Sonoma en Macs antiguas en Cancún?',
    answer: 'Sí. Validamos compatibilidad del modelo con la versión de macOS requerida, espacio disponible, firmware y te indicamos si conviene actualizar o mantener la versión actual según el rendimiento del equipo.',
  },
  {
    question: '¿Pueden solucionar problemas de apps que no abren o dan error en Mac?',
    answer: 'Sí. Revisamos permisos de Gatekeeper, archivos de preferencias corruptos, conflictos de Rosetta 2 en chips M1/M2/M3, extensiones incompatibles y caché del sistema para restaurar el funcionamiento sin reinstalar todo.',
  },
  {
    question: '¿Hacen respaldo con Time Machine y migración de datos entre Macs?',
    answer: 'Sí. Configuramos Time Machine en disco externo o NAS, y realizamos migraciones con Migration Assistant entre equipos Apple. También copiamos manualmente documentos, fotos, configuraciones y apps según el caso.',
  },
  {
    question: '¿Pueden eliminar malware, adware o programas no deseados de mi Mac?',
    answer: 'Sí. Revisamos extensiones de navegador, Launch Agents, perfiles de configuración instalados sin permiso, procesos en segundo plano y archivos sospechosos en el sistema para limpiar la Mac sin reinstalar si es posible.',
  },
  {
    question: '¿Solucionan problemas de WiFi y Bluetooth en Mac en Cancún?',
    answer: 'Sí. Reseteamos NVRAM, SMC y preferencias de red, revisamos conflictos con VPN o interfaces duplicadas, y descartamos falla de hardware en el módulo inalámbrico antes de concluir si necesita reparación física.',
  },
  {
    question: '¿Cuánto tiempo tarda el soporte de software macOS en Cancún?',
    answer: 'Problemas comunes de sistema, apps o rendimiento pueden resolverse en 24 a 48 horas. Reinstalaciones completas, migraciones de datos o equipos con almacenamiento comprometido pueden requerir hasta 72 horas según el caso.',
  },
];

const versions = [
  { name: 'macOS Sequoia', icon: 'fa-brands fa-apple', note: '15.x — Compatible' },
  { name: 'macOS Sonoma', icon: 'fa-brands fa-apple', note: '14.x — Compatible' },
  { name: 'macOS Ventura', icon: 'fa-brands fa-apple', note: '13.x — Compatible' },
  { name: 'macOS Monterey', icon: 'fa-brands fa-apple', note: '12.x — Compatible' },
  { name: 'MacBook Air M1/M2/M3', icon: 'fa-solid fa-laptop', note: 'Apple Silicon' },
  { name: 'MacBook Pro M1/M2/M3', icon: 'fa-solid fa-laptop', note: 'Apple Silicon' },
  { name: 'MacBook Air/Pro Intel', icon: 'fa-solid fa-laptop', note: 'Intel x86' },
  { name: 'iMac / Mac mini', icon: 'fa-solid fa-desktop', note: 'Escritorio Apple' },
];
---

<div class="mos-page">

  <!-- ═══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════ -->
  <section class="mos-hero">
    <div class="mos-hero-glow mos-glow-1"></div>
    <div class="mos-hero-glow mos-glow-2"></div>
    <div class="container mos-hero-grid">

      <div class="mos-hero-copy">
        <span class="mos-kicker">
          <i class="fa-brands fa-apple"></i> Soporte macOS en Cancún
        </span>
        <h1>Software macOS en Cancún | Reinstalación, Optimización y Soporte Profesional</h1>
        <p class="mos-hero-sub">
          ¿Tu Mac va lenta, no inicia, falla una app o necesitas actualizar macOS sin perder tus archivos?
          Resolvemos problemas de software en MacBook Air, MacBook Pro, iMac y Mac mini con diagnóstico
          honesto, respaldo previo y solución real en Cancún.
        </p>
        <div class="mos-badges">
          <span><i class="fa-solid fa-rotate"></i> Reinstalación macOS</span>
          <span><i class="fa-solid fa-gauge-high"></i> Mac lenta — Solución</span>
          <span><i class="fa-solid fa-database"></i> Respaldo y migración</span>
          <span><i class="fa-solid fa-shield-virus"></i> Limpieza de malware</span>
          <span><i class="fa-brands fa-apple"></i> M1 / M2 / M3 / Intel</span>
        </div>
        <div class="mos-actions">
          <a
            class="mos-btn-primary"
            href={`https://wa.me/529986690777?text=${waMessage}`}
            target="_blank"
            id="mos-hero-wa-btn"
          >
            <i class="fa-brands fa-whatsapp"></i> Cotizar soporte macOS
          </a>
          <a class="mos-btn-secondary" href="#problemas-macos" id="mos-hero-ver-btn">
            Ver problemas que resolvemos
          </a>
        </div>
      </div>

      <aside class="mos-hero-panel">
        <div class="mos-panel-img-wrap">
          <img
            src="/assets/images/mantenimiento-macbook-cancun.webp"
            alt="Soporte y software macOS en Cancún — Pixon PC"
            class="mos-panel-img"
          />
          <div class="mos-panel-img-overlay"></div>
        </div>
        <div class="mos-panel-price-row">
          <div>
            <span class="mos-price-label">Soporte de software</span>
            <strong class="mos-price-value">{service.fromPrice || 'Desde $550 MXN'}</strong>
          </div>
          <span class="mos-price-eta">
            <i class="fa-regular fa-clock"></i> 24-72 h
          </span>
        </div>
        <ul class="mos-panel-checks">
          <li><i class="fa-solid fa-circle-check"></i> Diagnóstico antes de reinstalar</li>
          <li><i class="fa-solid fa-circle-check"></i> Respaldo previo incluido si aplica</li>
          <li><i class="fa-solid fa-circle-check"></i> Sin formatear si no es necesario</li>
          <li><i class="fa-solid fa-circle-check"></i> MacBook Air, Pro, iMac y Mac mini</li>
          <li><i class="fa-solid fa-circle-check"></i> Intel y Apple Silicon M1/M2/M3</li>
        </ul>
      </aside>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       INTRO — qué hacemos y por qué importa
  ══════════════════════════════════════════════ -->
  <section class="mos-section mos-light" id="que-hacemos">
    <div class="container">
      <div class="mos-two-col">
        <div>
          <span class="mos-eyebrow">¿Qué resolvemos?</span>
          <h2>Soporte de Software y Sistema para Mac en Cancún</h2>
          <p>
            El sistema operativo macOS es robusto pero no infalible. En Cancún, la combinación de
            calor, humedad, actualizaciones automáticas y el uso intensivo de apps puede provocar
            fallas de arranque, lentitud extrema, pérdida de datos y errores del sistema que
            parecen hardware pero son completamente de software.
          </p>
          <p>
            Nuestro servicio de <strong>soporte macOS en Cancún</strong> cubre desde optimización
            del sistema hasta reinstalación limpia de <strong>macOS Sonoma o Sequoia</strong>,
            siempre priorizando tus datos antes de cualquier cambio invasivo.
          </p>
        </div>
        <div>
          <span class="mos-eyebrow">¿Por qué no formatear a la primera?</span>
          <h2>Diagnóstico Real Antes de Reinstalar macOS</h2>
          <p>
            Muchos problemas que parecen requerir formateo tienen solución sin borrar nada: caché
            corrupta, login items que crashean, almacenamiento lleno que paraliza el sistema,
            o una extensión de kernel incompatible tras una actualización.
          </p>
          <p>
            Primero diagnosticamos. Solo reinstalamos o formateamos cuando es la solución correcta,
            no la más rápida para el técnico. Y si hay riesgo para tus archivos, primero respaldamos.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PROBLEMAS — grilla de 8 tarjetas
  ══════════════════════════════════════════════ -->
  <section class="mos-section mos-dark" id="problemas-macos">
    <div class="container">
      <div class="mos-head-center">
        <span class="mos-eyebrow mos-eyebrow-light">Fallas que atendemos</span>
        <h2>Problemas de Software macOS que Resolvemos en Cancún</h2>
        <p class="mos-center-desc">
          Desde <strong>macOS lento en Cancún</strong> hasta reinstalación completa de Sequoia, aquí
          detallamos exactamente qué revisamos en cada falla y cómo lo resolvemos.
        </p>
      </div>

      <div class="mos-problems-grid">
        {problems.map((p) => (
          <article class="mos-problem-card">
            <div class="mos-problem-icon-wrap">
              <i class={`fa-solid ${p.icon}`}></i>
            </div>
            <div class="mos-problem-body">
              <h3>{p.h3}</h3>
              <p class="mos-problem-label">{p.title}</p>
              <p>{p.desc}</p>
              <div class="mos-problem-tags">
                {p.tags.map((t) => <span>{t}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SPLIT — mac lenta + reinstalación
  ══════════════════════════════════════════════ -->
  <section class="mos-section mos-light">
    <div class="container">
      <div class="mos-split-cards">

        <div class="mos-split-card mos-split-card--img">
          <div class="mos-split-img-wrap">
            <img
              src="/assets/images/reparacion-mac-cancun.webp"
              alt="Mac lenta por macOS corrupto — diagnóstico en Cancún"
              class="mos-split-img"
              loading="lazy"
              decoding="async"
              width="600"
              height="400"
            />
          </div>
          <span class="mos-eyebrow">Optimización del sistema</span>
          <h2>¿Mac Lenta en Cancún? Solución sin Formatear</h2>
          <p>
            La mayoría de las Macs que "van lentas" no necesitan formateo. Necesitan que alguien
            revise correctamente: almacenamiento SSD lleno o con sectores dañados, demasiados
            programas ejecutándose al inicio, una actualización de macOS incompleta, procesos
            zombies consumiendo CPU o RAM, o la temperatura alta que activa el thermal throttling.
          </p>
          <p>
            Nuestro servicio de <strong>optimización macOS en Cancún</strong> identifica la causa
            real en menos de una hora y aplica la solución mínima necesaria. Sin borrar. Sin
            reiniciar. Sin pérdida de tiempo.
          </p>
          <a
            class="mos-btn-sm"
            href={`https://wa.me/529986690777?text=${waMessage}`}
            target="_blank"
          >
            <i class="fa-brands fa-whatsapp"></i> Consultar ahora
          </a>
        </div>

        <div class="mos-split-card mos-split-card--dark">
          <span class="mos-eyebrow mos-eyebrow-light">Reinstalación macOS Cancún</span>
          <h2>Reinstalación de macOS Sonoma y Sequoia sin Perder Datos</h2>
          <p>
            Cuando el sistema está tan corrupto que optimizar ya no es viable, realizamos una
            <strong>reinstalación limpia de macOS en Cancún</strong>. Hay dos rutas: reinstalar
            sobre el sistema actual (preserva todos tus datos y apps) o formateo completo con
            instalación desde cero (para fallas graves de partición o APFS).
          </p>
          <p>
            Antes de cualquier ruta, respaldamos con Time Machine o copia manual. Te indicamos
            exactamente qué perderás y qué no antes de autorizar el proceso. Sin sorpresas.
          </p>
          <ul class="mos-checklist">
            <li><i class="fa-solid fa-check"></i> macOS Sonoma 14.x y Sequoia 15.x</li>
            <li><i class="fa-solid fa-check"></i> MacBook Air y Pro Intel y Apple Silicon</li>
            <li><i class="fa-solid fa-check"></i> iMac Intel e iMac Apple Silicon</li>
            <li><i class="fa-solid fa-check"></i> Mac mini M1, M2 e Intel</li>
            <li><i class="fa-solid fa-check"></i> Reinstalación desde Recovery Mode</li>
            <li><i class="fa-solid fa-check"></i> Respaldo previo incluido si aplica</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       VERSIONES COMPATIBLES
  ══════════════════════════════════════════════ -->
  <section class="mos-section mos-dark mos-versions-section">
    <div class="container">
      <div class="mos-head-center">
        <span class="mos-eyebrow mos-eyebrow-light">Compatibilidad</span>
        <h2>Versiones de macOS y Modelos Apple que Atendemos en Cancún</h2>
        <p class="mos-center-desc">
          Trabajamos con toda la línea Mac, desde equipos Intel hasta los chips
          más recientes <strong>Apple M3 Pro y M3 Max</strong>.
        </p>
      </div>
      <div class="mos-versions-grid">
        {versions.map((v) => (
          <div class="mos-version-pill">
            <i class={v.icon}></i>
            <div>
              <strong>{v.name}</strong>
              <small>{v.note}</small>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PROCESO
  ══════════════════════════════════════════════ -->
  <section class="mos-section mos-light" id="proceso-macos">
    <div class="container">
      <div class="mos-head-center mos-head-dark">
        <span class="mos-eyebrow">Cómo trabajamos</span>
        <h2>¿Cómo Es el Proceso de Soporte macOS en Cancún?</h2>
        <p class="mos-center-desc mos-center-desc--dark">
          Sin improvisación. Sin formatear a ciegas. Seguimos un proceso ordenado para resolver
          tu problema de macOS de la forma más conservadora posible.
        </p>
      </div>
      <div class="mos-process-list">
        {steps.map((s) => (
          <div class="mos-process-item">
            <div class="mos-process-num-wrap">
              <span class="mos-process-num">{s.num}</span>
              <div class="mos-process-line"></div>
            </div>
            <div class="mos-process-content">
              <div class="mos-process-icon"><i class={`fa-solid ${s.icon}`}></i></div>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       ADVERTENCIAS — NO hagas esto
  ══════════════════════════════════════════════ -->
  <section class="mos-section mos-dark mos-risks-section">
    <div class="container">
      <div class="mos-head-center">
        <span class="mos-eyebrow mos-eyebrow-light">Antes de intentarlo solo</span>
        <h2>Errores Comunes que Complican la Recuperación de macOS</h2>
        <p class="mos-center-desc">
          Hacer esto antes de llevar tu Mac puede convertir un problema simple de software
          en una pérdida de datos difícil de recuperar.
        </p>
      </div>
      <div class="mos-risks-grid">
        {risks.map((r) => (
          <div class="mos-risk-card">
            <div class="mos-risk-icon"><i class={`fa-solid ${r.icon}`}></i></div>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       RESPALDO Y MIGRACIÓN — sección especial
  ══════════════════════════════════════════════ -->
  <section class="mos-section mos-light mos-migration-section">
    <div class="container">
      <div class="mos-migration-grid">
        <div class="mos-migration-copy">
          <span class="mos-eyebrow">Time Machine y Migration Assistant</span>
          <h2>Respaldo, Migración de Datos y Cambio de Mac en Cancún</h2>
          <p>
            ¿Compraste una Mac nueva y necesitas mover todo desde la anterior? ¿Quieres configurar
            Time Machine correctamente para tener respaldo automático? ¿Tu Mac antigua falló y
            necesitas recuperar datos antes de formatear?
          </p>
          <p>
            Realizamos <strong>migraciones completas entre Macs</strong> usando Migration Assistant,
            configuramos Time Machine en disco externo USB-C o NAS de red, y si el equipo anterior
            ya no enciende, evaluamos recuperación de datos desde el SSD según el modelo y chip.
          </p>
          <div class="mos-migration-points">
            <div class="mos-mp">
              <i class="fa-solid fa-arrow-right-arrow-left"></i>
              <span>Migración completa Mac a Mac</span>
            </div>
            <div class="mos-mp">
              <i class="fa-solid fa-clock-rotate-left"></i>
              <span>Configuración de Time Machine</span>
            </div>
            <div class="mos-mp">
              <i class="fa-solid fa-cloud"></i>
              <span>Sincronización y migración iCloud</span>
            </div>
            <div class="mos-mp">
              <i class="fa-solid fa-hard-drive"></i>
              <span>Recuperación de datos desde SSD Mac</span>
            </div>
          </div>
        </div>
        <div class="mos-migration-img-wrap">
          <img
            src="/assets/images/mac-mini.webp"
            alt="Migración de datos y respaldo Mac en Cancún — Pixon PC"
            class="mos-migration-img"
            loading="lazy"
            decoding="async"
            width="600"
            height="400"
          />
          <div class="mos-migration-badge">
            <i class="fa-solid fa-database"></i>
            <span>Datos protegidos<br><strong>siempre primero</strong></span>
          </div>
        </div>
      </div>
    </div>
  </section>

