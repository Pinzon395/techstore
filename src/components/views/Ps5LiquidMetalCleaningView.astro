---
import FaqSection from '../FaqSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import Footer from '../Footer.astro';

const { service, category } = Astro.props;

const whatsappText = encodeURIComponent(
  'Hola, quiero limpieza de PS5 en Cancún con revisión de metal líquido. Mi consola se calienta, suena fuerte o se apaga al jugar.'
);

const symptoms = [
  ['fa-power-off', 'PS5 se apaga al jugar', 'Revisamos temperatura, fuente, polvo, ventilador y contacto térmico del APU antes de tocar el metal líquido.'],
  ['fa-volume-high', 'Ventilador fuerte o ruido constante', 'El polvo en disipador y rejillas obliga al ventilador a trabajar más, incluso si la consola todavía enciende normal.'],
  ['fa-temperature-arrow-up', 'Sobrecalentamiento en juegos pesados', 'Probamos estabilidad con carga real para confirmar si la falla viene de flujo de aire, metal líquido o fuente.'],
  ['fa-droplet', 'Metal líquido desplazado o seco', 'Inspeccionamos distribución, sello de contención, zonas secas y posible fuga con técnica controlada.'],
  ['fa-wind', 'Disipador saturado de polvo', 'La limpieza profunda libera el flujo de aire interno, no solo el polvo visible de la carcasa.'],
  ['fa-triangle-exclamation', 'Nunca se ha limpiado', 'En Cancún el calor, polvo y humedad aceleran mantenimiento pendiente en consolas de uso diario.'],
];

const process = [
  ['01', 'Recepción y diagnóstico', 'Registramos modelo, síntomas, apagados, ruido, ubicación de la consola, horas de uso y antecedentes de mantenimiento.'],
  ['02', 'Prueba térmica inicial', 'Revisamos ruido, encendido, video, ventilación y comportamiento bajo carga para no abrir sin criterio.'],
  ['03', 'Desarmado técnico', 'Abrimos con herramienta adecuada, cuidando flex, tornillos, carcasa, ventilador, fuente, disipador y placa.'],
  ['04', 'Limpieza profunda PS5', 'Retiramos polvo de ventilador, disipador, rejillas, fuente y zonas internas donde se bloquea el flujo de aire.'],
  ['05', 'Revisión de metal líquido', 'Validamos si está bien distribuido, seco por zonas, desplazado o con riesgo de fuga; solo se corrige si hace falta.'],
  ['06', 'Pruebas y entrega', 'Probamos encendido, video, ruido, temperatura, estabilidad con juego y dejamos recomendación de uso.'],
];

const localBlocks = [
  {
    title: 'Limpieza de PS5 en Cancún Centro, Huayacán y Cumbres',
    text: 'Atendemos PS5 Fat, PS5 Slim y PlayStation de uso familiar o intensivo en Cancún. El objetivo es reducir calor, ruido y apagados antes de que el daño llegue a fuente o placa.',
  },
  {
    title: 'Mantenimiento PS5 por calor y humedad de Cancún',
    text: 'El clima local favorece polvo pegado, humedad ambiental y alta temperatura. Por eso revisamos flujo de aire completo, no solo el ventilador visible.',
  },
  {
    title: 'Servicio técnico PS5 con garantía por escrito',
    text: 'Te explicamos si basta limpieza, si el metal líquido requiere corrección o si hay señales de fuente, HDMI, ventilador o placa antes de invertir de más.',
  },
];

const faqItems = [
  {
    question: '¿La limpieza de PS5 incluye revisar el metal líquido?',
    answer: 'Sí. La PS5 usa metal líquido sobre el APU. Revisamos distribución, zonas secas, sello de contención y posible fuga. No lo manipulamos sin necesidad; si requiere corrección, te lo explicamos antes.',
  },
  {
    question: '¿Cada cuánto conviene limpiar una PS5 en Cancún?',
    answer: 'En Cancún recomendamos revisión cada 12 a 18 meses. Si la consola está en mueble cerrado, cerca del piso, suena fuerte o se apaga jugando, conviene revisarla antes.',
  },
  {
    question: '¿Por qué mi PS5 se apaga solo con juegos pesados?',
    answer: 'Puede ser polvo bloqueando el disipador, metal líquido mal distribuido, fuente fatigada, ventilador con bajo flujo o temperatura alta del APU. Por eso primero hacemos diagnóstico térmico.',
  },
  {
    question: '¿Es peligroso cambiar metal líquido en PS5?',
    answer: 'Sí puede ser riesgoso si se hace sin aislamiento, limpieza correcta y control de cantidad. El metal líquido es conductor; por eso lo revisamos con cuidado y solo se interviene cuando el síntoma lo justifica.',
  },
  {
    question: '¿Cuánto tarda la limpieza de PS5 con revisión térmica?',
    answer: 'Normalmente de 24 a 48 horas. Si hay apagados intermitentes, fuente sospechosa, humedad o pruebas extendidas, puede tomar más para confirmar la causa real.',
  },
  {
    question: '¿Dan garantía por la limpieza de PS5?',
    answer: 'Sí. Entregamos garantía por escrito sobre el servicio realizado. Si encontramos daño adicional en fuente, ventilador, HDMI o placa, lo cotizamos aparte antes de avanzar.',
  },
];
---

<div class="ps5lm-page">
  <section class="ps5lm-hero">
    <div class="ps5lm-bg" aria-hidden="true"></div>
    <div class="ps5lm-container ps5lm-hero-grid">
      <div class="ps5lm-hero-copy">
        <p class="ps5lm-eyebrow">Servicio técnico PlayStation en Cancún</p>
        <h1>Limpieza de PS5 en Cancún con revisión de metal líquido</h1>
        <p class="ps5lm-lead">
          Mantenimiento profesional para PS5 que se calienta, suena fuerte, se apaga al jugar o nunca ha recibido limpieza interna.
          Revisamos polvo, ventilador, disipador, fuente, sellos y metal líquido antes de tocar piezas delicadas.
        </p>
        <div class="ps5lm-actions">
          <a class="ps5lm-btn ps5lm-btn-primary" href={`https://wa.me/529986690777?text=${whatsappText}`}>
            Cotizar por WhatsApp
          </a>
          <a class="ps5lm-btn ps5lm-btn-ghost" href="#diagnostico-ps5-cancun">
            Ver diagnóstico térmico
          </a>
        </div>
        <div class="ps5lm-trust">
          <span>PS5 Fat y Slim</span>
          <span>Metal líquido</span>
          <span>Prueba con juego</span>
          <span>Garantía por escrito</span>
        </div>
      </div>

      <div class="ps5lm-visual">
        <img src="/assets/images/responsive/mantenimiento-metal-liquido-cancun.webp" alt="Limpieza de PS5 con revisión de metal líquido en Cancún" loading="eager" />
        <div class="ps5lm-card-float">
          <span>Diagnóstico térmico real</span>
          <strong>APU, ventilador, disipador, fuente y flujo de aire</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="ps5lm-section ps5lm-light" id="diagnostico-ps5-cancun">
    <div class="ps5lm-container">
      <div class="ps5lm-head">
        <p class="ps5lm-eyebrow">SEO local y servicio técnico real</p>
        <h2>Limpieza PS5 Cancún: polvo, calor, ruido y apagados</h2>
        <p>
          No toda PS5 caliente necesita “cambiar metal líquido”. Primero separamos polvo acumulado,
          ventilación bloqueada, fuente, temperatura del APU, distribución del metal líquido y fallas de placa.
        </p>
      </div>
      <div class="ps5lm-local-grid">
        {localBlocks.map((item) => (
          <article>
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ps5lm-section ps5lm-dark">
    <div class="ps5lm-container ps5lm-split">
      <div>
        <p class="ps5lm-eyebrow">Síntomas comunes</p>
        <h2>PS5 se calienta, suena fuerte o se apaga jugando en Cancún</h2>
        <p>
          Estos síntomas pueden parecer simples, pero en PS5 el sistema térmico depende de limpieza interna,
          presión del disipador, metal líquido y ventilación externa.
        </p>
      </div>
      <div class="ps5lm-symptoms">
        {symptoms.map(([icon, title, text]) => (
          <article>
            <i class={`fa-solid ${icon}`}></i>
            <div>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ps5lm-section ps5lm-metal">
    <div class="ps5lm-container ps5lm-image-grid">
      <div class="ps5lm-image-wrap">
        <img src="/assets/images/responsive/ps5_xbox.webp" alt="Mantenimiento interno de consola PS5 en Cancún" loading="lazy" />
      </div>
      <div>
        <p class="ps5lm-eyebrow">Metal líquido PS5</p>
        <h2>La PS5 no usa pasta térmica común: usa metal líquido sobre el APU</h2>
        <p>
          El metal líquido transfiere muy bien el calor, pero también exige cuidado. Si queda mal distribuido,
          seco en zonas críticas o fuera del área protegida, puede provocar temperatura alta, apagados o riesgo eléctrico.
        </p>
        <ul class="ps5lm-checks">
          <li>Inspección de distribución y zonas secas</li>
          <li>Revisión del sello de contención</li>
          <li>Limpieza controlada del disipador</li>
          <li>Corrección solo si el diagnóstico lo justifica</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="ps5lm-section ps5lm-light">
    <div class="ps5lm-container">
      <div class="ps5lm-head">
        <p class="ps5lm-eyebrow">Proceso profesional</p>
        <h2>Cómo hacemos el mantenimiento de PS5 con metal líquido</h2>
        <p>Proceso ordenado, documentado y pensado para evitar riesgos innecesarios en placa, flex, fuente y sistema térmico.</p>
      </div>
      <div class="ps5lm-process">
        {process.map(([step, title, text]) => (
          <article>
            <span>{step}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ps5lm-section ps5lm-zones">
    <div class="ps5lm-container">
      <p class="ps5lm-eyebrow">Cobertura local</p>
      <h2>Limpieza de PlayStation 5 en Cancún, Zona Hotelera, Huayacán y Cumbres</h2>
      <p>
        Atendemos PS5 de uso familiar, gamers, renta vacacional, departamentos, estudios y negocios.
        Puedes escribir por WhatsApp con foto, video del ruido o descripción del apagado antes de traerla.
      </p>
      <div class="ps5lm-zone-list">
        <span>Cancún Centro</span>
        <span>Zona Hotelera</span>
        <span>Huayacán</span>
        <span>Cumbres</span>
        <span>Bonampak</span>
        <span>Puerto Cancún</span>
      </div>
    </div>
  </section>

  <ServiceTicketSection
    id="ticket"
    defaultDevice="PS5"
    defaultService="Limpieza PS5 con metal líquido"
    title="Agenda limpieza de PS5 en Cancún"
    subtitle="Cuéntanos si tu PS5 se apaga, suena fuerte, se calienta, muestra aviso de temperatura, nunca se ha limpiado o tuvo mantenimiento previo."
  />

  <RelatedServicesSection category={category} service={service} title="Servicios relacionados para PS5 en Cancún" />

  <FaqSection
    title="Preguntas frecuentes sobre limpieza de PS5 y metal líquido en Cancún"
    description="Resolvemos dudas sobre temperatura, ruido, apagados, metal líquido, garantía, tiempos y mantenimiento preventivo de PlayStation 5."
    items={faqItems}
    titleColor="#ffffff"
    descriptionColor="#ffffff"
    questionColor="#0f2a4a"
  />

  <CommentsSection dark={true} viewMoreHref="/comentarios" viewMoreLabel="Ver todas las reseñas" id="comentarios-ps5-metal" />
  <ContactSection id="ubicacion-ps5-metal" />
  <Footer />
</div>

<style>
  .ps5lm-page {
    background: #07111f;
    color: #e2e8f0;
    overflow: hidden;
  }
  .ps5lm-container {
    width: min(1160px, calc(100% - 32px));
    margin: 0 auto;
  }
  .ps5lm-hero {
    position: relative;
    padding: 86px 0 78px;
    background:
      radial-gradient(circle at 18% 12%, rgba(59, 130, 246, 0.28), transparent 34%),
      radial-gradient(circle at 88% 16%, rgba(14, 165, 233, 0.2), transparent 34%),
      linear-gradient(135deg, #07111f 0%, #0f2a4a 52%, #0b1120 100%);
  }
  .ps5lm-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: linear-gradient(to bottom, #000, transparent 86%);
  }
  .ps5lm-hero-grid,
  .ps5lm-split,
  .ps5lm-image-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
    gap: 42px;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .ps5lm-eyebrow {
    color: #67e8f9;
    font-weight: 950;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.78rem;
    margin: 0 0 10px;
  }
  .ps5lm-hero h1,
  .ps5lm-section h2 {
    font-family: 'Kanit', sans-serif;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }
  .ps5lm-hero h1 {
    color: #fff;
    font-size: clamp(2.6rem, 6vw, 5.35rem);
    margin: 0 0 18px;
  }
  .ps5lm-lead {
    color: #cbd5e1;
    font-size: clamp(1.05rem, 2vw, 1.24rem);
    line-height: 1.68;
    margin: 0;
    max-width: 720px;
  }
  .ps5lm-actions,
  .ps5lm-trust,
  .ps5lm-zone-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .ps5lm-actions {
    margin: 28px 0 24px;
  }
  .ps5lm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border-radius: 999px;
    padding: 13px 18px;
    font-weight: 900;
    text-decoration: none;
  }
  .ps5lm-btn-primary {
    background: #38bdf8;
    color: #06131f;
    box-shadow: 0 20px 44px rgba(56, 189, 248, 0.28);
  }
  .ps5lm-btn-ghost {
    color: #e0f2fe;
    border: 1px solid rgba(224, 242, 254, 0.24);
    background: rgba(255,255,255,0.06);
  }
  .ps5lm-trust span,
  .ps5lm-zone-list span {
    border-radius: 999px;
    padding: 10px 14px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(103,232,249,0.2);
    color: #e0f2fe;
    font-weight: 850;
  }
  .ps5lm-visual {
    position: relative;
    padding: 14px;
    border-radius: 30px;
    border: 1px solid rgba(148, 163, 184, 0.18);
    background: rgba(255,255,255,0.07);
    box-shadow: 0 30px 70px rgba(0,0,0,0.32);
  }
  .ps5lm-visual img,
  .ps5lm-image-wrap img {
    width: 100%;
    display: block;
    border-radius: 22px;
    object-fit: cover;
  }
  .ps5lm-visual img {
    aspect-ratio: 4 / 3;
  }
  .ps5lm-card-float {
    position: absolute;
    left: 28px;
    right: 28px;
    bottom: 28px;
    padding: 16px;
    border-radius: 18px;
    background: rgba(7, 17, 31, 0.86);
    border: 1px solid rgba(103, 232, 249, 0.26);
  }
  .ps5lm-card-float span {
    display: block;
    color: #67e8f9;
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .ps5lm-card-float strong {
    color: #fff;
  }
  .ps5lm-section {
    padding: 74px 0;
  }
  .ps5lm-light,
  .ps5lm-metal {
    background: #f8fafc;
    color: #0f2a4a;
  }
  .ps5lm-dark {
    background: #eef6ff;
    color: #0f2a4a;
  }
  .ps5lm-head {
    max-width: 900px;
    margin: 0 auto 30px;
    text-align: center;
  }
  .ps5lm-section h2 {
    font-size: clamp(1.9rem, 4vw, 3.2rem);
    margin: 0 0 12px;
  }
  .ps5lm-section p {
    line-height: 1.72;
    margin: 0;
  }
  .ps5lm-light p,
  .ps5lm-metal p {
    color: #334155;
  }
  .ps5lm-dark p {
    color: #0f2a4a;
  }
  .ps5lm-dark .ps5lm-eyebrow,
  .ps5lm-dark h2 {
    color: #0f2a4a;
  }
  .ps5lm-local-grid,
  .ps5lm-process {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .ps5lm-local-grid article,
  .ps5lm-process article,
  .ps5lm-symptoms article {
    border-radius: 22px;
    border: 1px solid rgba(15, 42, 74, 0.12);
    background: #fff;
    box-shadow: 0 18px 44px rgba(15, 42, 74, 0.08);
    padding: 22px;
  }
  .ps5lm-local-grid h2,
  .ps5lm-process h3,
  .ps5lm-symptoms h3 {
    font-family: 'Kanit', sans-serif;
    color: #0f2a4a;
    line-height: 1.2;
    margin: 0 0 8px;
  }
  .ps5lm-symptoms {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .ps5lm-symptoms article {
    display: flex;
    gap: 14px;
    background: #ffffff;
    border-color: rgba(15,42,74,0.12);
    box-shadow: 0 18px 44px rgba(15, 42, 74, 0.08);
  }
  .ps5lm-symptoms i {
    width: 42px;
    height: 42px;
    border-radius: 14px;
    background: rgba(15,42,74,0.08);
    color: #0f2a4a;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }
  .ps5lm-symptoms h3 {
    color: #0f2a4a;
  }
  .ps5lm-symptoms p {
    color: #0f2a4a;
  }
  .ps5lm-image-wrap img {
    aspect-ratio: 16 / 10;
    box-shadow: 0 22px 58px rgba(15,23,42,0.18);
  }
  .ps5lm-checks {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .ps5lm-checks li {
    padding: 12px 14px;
    border-radius: 14px;
    background: #fff;
    border: 1px solid rgba(14, 165, 233, 0.16);
    font-weight: 850;
    color: #0f2a4a;
  }
  .ps5lm-process {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }
  .ps5lm-process span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: #dbeafe;
    color: #0f2a4a;
    font-weight: 950;
    margin-bottom: 12px;
  }
  .ps5lm-process p {
    font-size: 0.92rem;
  }
  .ps5lm-zones {
    background:
      radial-gradient(circle at 15% 18%, rgba(56, 189, 248, 0.22), transparent 30%),
      linear-gradient(135deg, #0f172a, #0f2a4a);
    color: #fff;
    text-align: center;
  }
  .ps5lm-zones p {
    color: #cbd5e1;
    max-width: 880px;
    margin: 0 auto;
  }
  .ps5lm-zone-list {
    justify-content: center;
    margin-top: 24px;
  }
  @media (max-width: 1100px) {
    .ps5lm-process {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 980px) {
    .ps5lm-hero-grid,
    .ps5lm-split,
    .ps5lm-image-grid,
    .ps5lm-local-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 680px) {
    .ps5lm-hero {
      padding: 52px 0 58px;
    }
    .ps5lm-actions {
      flex-direction: column;
    }
    .ps5lm-btn {
      width: 100%;
    }
    .ps5lm-section {
      padding: 50px 0;
    }
    .ps5lm-symptoms,
    .ps5lm-process {
      grid-template-columns: 1fr;
    }
    .ps5lm-card-float {
      position: static;
      margin-top: 12px;
    }
  }
</style>
