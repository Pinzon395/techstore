---
import FaqSection from '../FaqSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import Footer from '../Footer.astro';

const { service, category } = Astro.props;

const whatsappText = encodeURIComponent(
  'Hola Pixon PC, mi computadora tiene fallas con la fuente de poder. Quisiera agendar un diagnóstico técnico en Cancún para revisar voltajes o cotizar una instalación.'
);

const symptoms = [
  {
    icon: 'fa-gamepad',
    title: 'Se reinicia sola al abrir juegos',
    desc: 'Bajo demanda gráfica, la GPU exige más Watts de los que la fuente degradada o de pocos watts puede suministrar, forzando un reinicio de seguridad.',
    recommendation: 'Revisamos el consumo real de tu CPU y GPU para instalar la capacidad de Watts ideal.',
  },
  {
    icon: 'fa-plug-circle-xmark',
    title: 'La PC no hace nada (muerta)',
    desc: 'Al presionar el botón de encendido no da luces ni ventiladores. La fuente está completamente inactiva o en corto interno.',
    recommendation: 'No insistas. Realizamos pruebas con tester de PSU y descargo de cortos antes de cambiar piezas.',
  },
  {
    icon: 'fa-wind',
    title: 'Ventilador ruidoso o trabado',
    desc: 'El ventilador de la fuente acumula polvo y humedad local, provocando ruidos fuertes o deteniéndose por completo, sobrecalentando la fuente.',
    recommendation: 'Reemplazamos el ventilador o instalamos una fuente nueva con sistema Zero RPM inteligente.',
  },
  {
    icon: 'fa-triangle-exclamation',
    title: 'Chispazo, olor a quemado o humo',
    desc: 'Fallo catastrófico en los capacitores primarios o puente rectificador. Los fusibles internos de protección de la fuente se han fundido.',
    recommendation: 'Desconecta el cable de corriente de inmediato. No intentes encenderla bajo ninguna circunstancia.',
  },
];

const diagnosticSteps = [
  {
    title: 'Prueba de voltajes con PSU Tester',
    desc: 'Medimos de forma aislada los rieles de +12V, +5V, +3.3V y -12V de la fuente de poder para corroborar que estén dentro del rango de tolerancia ATX.',
  },
  {
    title: 'Test de carga simulada',
    desc: 'Verificamos si la fuente mantiene estables los voltajes al ser sometida a un consumo eléctrico similar al de tu tarjeta de video y procesador.',
  },
  {
    title: 'Prueba cruzada de descarte',
    desc: 'Probamos tu computadora con una fuente de laboratorio garantizada para descartar que la falla de encendido venga de la tarjeta madre o procesador.',
  },
  {
    title: 'Inspección de conectores y cables',
    desc: 'Revisamos que los conectores EPS de 8 pines, ATX de 24 pines y PCIe no muestren plástico derretido, pines quemados o humedad.',
  },
];

const psuFormats = [
  {
    type: 'Fuentes ATX Estándar',
    desc: 'Formato común para la mayoría de gabinetes de escritorio de oficina, PC gamer y estaciones de trabajo de torre mediana a grande.',
  },
  {
    type: 'Fuentes SFX / ITX',
    desc: 'Fuentes ultracompactas diseñadas para gabinetes Small Form Factor (SFF) o mini PC que requieren alta potencia en poco espacio.',
  },
  {
    type: 'Certificaciones 80 Plus',
    desc: 'Instalamos fuentes certificadas 80+ White, Bronze, Silver, Gold, Platinum y Titanium para garantizar la máxima eficiencia de energía.',
  },
  {
    type: 'Fuentes Modulares',
    desc: 'Permiten conectar solo los cables necesarios, optimizando el flujo de aire interno de tu PC y facilitando el mantenimiento futuro.',
  },
];

const risks = [
  {
    title: 'Riesgo de daño a componentes caros',
    desc: 'Una fuente de mala calidad o genérica carece de protecciones básicas (OVP, UVP, SCP, OPP). Al fallar, puede enviar un pico de 12V directo a tu tarjeta de video (GPU), procesador (CPU) o tarjeta madre, quemándolos por completo.',
  },
  {
    title: 'Inestabilidad del sistema y pantallazos azules',
    desc: 'Las fuentes genéricas no entregan la potencia etiquetada en picos de consumo. Esto causa caídas de voltaje temporales que resultan en crashes aleatorios, BSOD de Windows y congelamientos de pantalla.',
  },
  {
    title: 'Consumo eléctrico excesivo y calor interno',
    desc: 'Las fuentes de baja eficiencia desperdician hasta un 40% de la energía eléctrica convirtiéndola en calor residual. Esto eleva la temperatura interna de tu gabinete y acorta la vida útil de tus ventiladores.',
  },
  {
    title: 'Pérdida de garantía de componentes nuevos',
    desc: 'Al instalar una tarjeta de video potente de última generación, los fabricantes exigen una fuente con certificación y Watts mínimos especificados. Usar una inferior anula garantías por daño eléctrico.',
  },
];

const relatedServices = [
  { title: 'PC no enciende', desc: 'Diagnóstico de cortocircuitos eléctricos, botón de encendido y componentes primarios.', link: '/servicios/pc/no-enciende' },
  { title: 'Tarjeta madre PC', desc: 'Diagnóstico de pistas rotas, condensadores inflados, BIOS y transistores en placa.', link: '/servicios/pc/tarjeta-madre' },
  { title: 'Tarjeta de video GPU', desc: 'Soporte térmico, cambio de pasta y diagnóstico para tarjetas gráficas gamer.', link: '/servicios/pc/tarjeta-video-gpu' },
  { title: 'Diagnóstico de PC', desc: 'Revisión completa de hardware y sistema operativo para localizar fallas intermitentes.', link: '/servicios/pc/diagnostico' },
  { title: 'Reparación general', desc: 'Soporte técnico integral para todo tipo de computadoras de escritorio y workstations.', link: '/reparaciones' },
  { title: 'Ensambles PC Gamer', desc: 'Diseño, ensamble de computadoras personalizadas con balanceo eléctrico óptimo.', link: '/ensambles' },
  { title: 'Mantenimiento preventivo', desc: 'Limpieza de polvo y pelusa acumulada en la rejilla de ventilación de la fuente.', link: '/mantenimiento-preventivo-computadora' },
  { title: 'Mantenimiento correctivo', desc: 'Sustitución de componentes defectuosos con pruebas de estabilidad eléctrica.', link: '/servicios/pc/mantenimiento-correctivo' },
];

const faqItems = [
  { question: '¿Cuánto cuesta cambiar la fuente de poder de una PC en Cancún?', answer: 'El diagnóstico técnico de la fuente inicia desde $600 MXN. Si requiere reemplazo, cotizamos mano de obra y refacción según el modelo exacto, potencia requerida, certificación y disponibilidad. Te confirmamos el importe antes de instalar.' },
  { question: '¿Cuánto cuesta el diagnóstico de la fuente de poder?', answer: 'El diagnóstico técnico inicia desde $600 MXN y se paga por adelantado para confirmar la cita. La reparación o sustitución se cotiza por separado según el modelo y la falla encontrada.' },
  { question: '¿Por qué mi computadora se apaga sola mientras juego o trabajo?', answer: 'Suele deberse a sobrecalentamiento o a una fuente de poder degradada que ya no soporta la demanda eléctrica de la tarjeta de video (GPU). También puede ser un corto en la tarjeta madre.' },
  { question: '¿Qué es la certificación 80 Plus (Bronze, Gold, etc.)?', answer: 'Es un estándar de eficiencia energética. Una fuente 80 Plus Gold desperdicia menos electricidad en forma de calor, lo cual es vital en el clima cálido de Cancún, y protege mejor los componentes.' },
  { question: '¿Cómo sé cuántos Watts necesita mi PC gamer?', answer: 'Depende principalmente de tu procesador (CPU) y tarjeta gráfica (GPU). Para una GPU gama media sugerimos mínimo 650W, mientras que gamas altas requieren 750W o 850W con certificación Gold.' },
  { question: '¿Los apagones de CFE en Cancún pueden quemar la fuente?', answer: 'Sí, los apagones y picos de voltaje son la causa número uno de fuentes quemadas en Cancún. El pico eléctrico daña los capacitores primarios de la fuente, impidiendo el paso de energía.' },
  { question: '¿Tienen fuentes de poder en stock para entrega inmediata?', answer: 'Sí, manejamos stock constante de fuentes de poder certificadas de 500W a 850W de marcas líderes como Corsair, EVGA, XPG y Gigabyte, ideales para PC gamer u oficina.' },
  { question: '¿Qué pasa si mi PC huele a quemado o dio un chispazo?', answer: 'Desconéctala inmediatamente. La fuente de poder tiene fusibles y protecciones internas, pero si se puentean, el corto puede pasar directamente a la tarjeta madre, RAM y procesador.' },
  { question: '¿Qué garantía tienen las fuentes de poder que instalan?', answer: 'Ofrecemos garantía por escrito en nuestra mano de obra de instalación. Las refacciones cuentan con garantía directa de fabricante que va desde 1 hasta 5 o 10 años, según la marca y modelo.' },
  { question: '¿Reparan fuentes de poder o solo las cambian?', answer: 'Evaluamos la viabilidad. Para fuentes genéricas o de bajo costo, no conviene repararlas por seguridad. En fuentes gamer premium de gama alta, diagnosticamos si la falla es menor (fusible, capacitor de entrada) o si lo más seguro es reemplazarla.' },
];
---

<div class="pcps-page">
  <!-- 1. Hero principal (Premium Dark) -->
  <section class="pcps-hero" aria-label="Introducción al servicio">
    <div class="pcps-shell pcps-hero-grid">
      <div class="pcps-hero-head">
        <span class="pcps-kicker"><i class="fa-solid fa-bolt-lightning"></i> Especialistas en Hardware</span>
        <h1>Fuente de poder PC en Cancún</h1>
        <h2>Instalación, cambio y diagnóstico técnico para fuentes de poder ATX, SFX de PC gamer, oficina o workstations.</h2>
      </div>

      <!-- Tarjeta destacada lateral -->
      <div class="pcps-hero-visual">
        <div class="pcps-highlight-card">
          <div class="pcps-card-header">
            <span class="pcps-pulse"></span>
            <h3>No arriesgues tu PC: Diagnóstico primero</h3>
          </div>
          <p>
            No conectes una fuente nueva si sospechas de un cortocircuito grave. Medimos los componentes en placa con multímetro para proteger tu procesador y GPU de sobrevoltajes letales.
          </p>
          <div class="pcps-card-img-wrap">
            <img src="/assets/images/ensamble-pc-gamer-cancun.webp" alt="Instalación de fuente de poder en Cancún" loading="eager" />
          </div>
        </div>
      </div>

      <div class="pcps-hero-body">
        <p class="pcps-lead">
          ¿Tu PC se apaga sola, huele a quemado o no enciende tras un apagón eléctrico? En <strong>Pixon PC</strong> realizamos un diagnóstico técnico desde $600 MXN bajo carga para confirmar si requiere reparación menor o reemplazo por seguridad.
        </p>

        <!-- Datos rápidos -->
        <div class="pcps-specs-grid">
          <div class="pcps-spec-item">
            <i class="fa-solid fa-circle-dollar-to-slot"></i>
            <div>
              <span>Mano de obra</span>
              <strong>Desde $650 MXN</strong>
            </div>
          </div>
          <div class="pcps-spec-item">
            <i class="fa-solid fa-hourglass-half"></i>
            <div>
              <span>Tiempo de cambio</span>
              <strong>24h - 48h</strong>
            </div>
          </div>
          <div class="pcps-spec-item">
            <i class="fa-solid fa-shield-halved"></i>
            <div>
              <span>Garantía refacción</span>
              <strong>Hasta 5+ años</strong>
            </div>
          </div>
        </div>

        <div class="pcps-hero-actions">
          <a href={`https://wa.me/529986690777?text=${whatsappText}`} class="pcps-btn pcps-btn-primary" onclick="smartWaRedirect(this.href); return false;">
            <i class="fa-brands fa-whatsapp"></i> WhatsApp Técnico
          </a>
          <a href="#ticket-pc-fuente-poder" class="pcps-btn pcps-btn-soft">
            <i class="fa-solid fa-ticket"></i> Generar Ticket
          </a>
        </div>

        <!-- Cobertura -->
        <div class="pcps-hero-zones">
          <span>Servicio con cita previa en Cancún:</span>
          <div class="pcps-zone-chips">
            <span class="pcps-chip">Cancún Centro</span>
            <span class="pcps-chip">Huayacán</span>
            <span class="pcps-chip">Zona Hotelera</span>
            <span class="pcps-chip">Cumbres</span>
            <span class="pcps-chip">Polígono Sur</span>
            <span class="pcps-chip">Bonfil</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Síntomas de una fuente dañada (H2 local / Intención de búsqueda) -->
  <section class="pcps-section pcps-bg-light">
    <div class="pcps-shell">
      <div class="pcps-section-head">
        <span>Fallas comunes</span>
        <h2>¿Por qué tu computadora se apaga sola o no enciende?</h2>
        <p>Estos son los comportamientos típicos que indican que tu fuente de poder (PSU) está fallando o es insuficiente.</p>
      </div>

      <div class="pcps-symptoms-grid">
        {symptoms.map((item) => (
          <div class="pcps-symptom-card">
            <div class="pcps-symptom-icon">
              <i class={`fa-solid ${item.icon}`}></i>
            </div>
            <h3>{item.title}</h3>
            <p class="pcps-symptom-desc">{item.desc}</p>
            <p class="pcps-symptom-rec"><strong>En taller:</strong> {item.recommendation}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Diagnóstico técnico (H2 SEO) -->
  <section class="pcps-section pcps-bg-dark">
    <div class="pcps-shell pcps-split-grid">
      <div class="pcps-split-content">
        <span class="pcps-eyebrow">Precisión Eléctrica</span>
        <h2>Diagnóstico técnico de fuente de poder en Cancún: Descartando cortos y voltajes</h2>
        <p>
          En Pixon PC no adivinamos. Desarmamos el chasis, aislamos la fuente de poder y aplicamos un protocolo de pruebas exhaustivo para medir la salida exacta de corriente.
        </p>
        <p>
          Verificamos los rieles principales de corriente y la estabilidad bajo carga constante utilizando herramientas profesionales antes de sugerir que compres un repuesto.
        </p>
        <div class="pcps-badge-trust">
          <i class="fa-solid fa-circle-check"></i>
          <span>Diagnóstico de fuente desde $600 MXN con cita previa.</span>
        </div>
      </div>

      <div class="pcps-checklist-card">
        <h3>Protocolo de Pruebas PSU</h3>
        <ul class="pcps-checklist">
          {diagnosticSteps.map((step) => (
            <li>
              <div class="pcps-check-circle"><i class="fa-solid fa-check"></i></div>
              <div>
                <h4>{step.title}</h4>
                <p>{step.desc}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 4. Formatos e Instalación (H2 SEO) -->
  <section class="pcps-section">
    <div class="pcps-shell">
      <div class="pcps-section-head">
        <span>Gama Gamer y Oficina</span>
        <h2>Instalación y cambio de fuente de poder gamer y de oficina en Cancún</h2>
        <p>Asesoría en Watts y eficiencias para configurar tu PC con la protección y potencia correctas.</p>
      </div>

      <div class="pcps-formats-grid">
        {psuFormats.map((item) => (
          <div class="pcps-format-card">
            <h3>{item.type}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
      <p class="pcps-format-note">
        <i class="fa-solid fa-info-circle"></i> Trabajamos con las mejores marcas del mercado: Corsair, EVGA, Cooler Master, Seasonic, ASUS, Gigabyte, XPG y MSI.
      </p>
    </div>
  </section>

  <!-- NUEVA SECCIÓN ADICIONAL 1 (Con imagen): Selección de fuente gamer -->
  <section class="pcps-section pcps-bg-light">
    <div class="pcps-shell pcps-split-grid" style="grid-template-columns: 0.9fr 1.1fr;">
      <div class="pcps-visual-wrap">
        <img src="/assets/images/pc-gamer-gama-alta.webp" alt="Elección de fuente de poder gamer de gama alta en Cancún" class="pcps-split-img" width="600" height="400" loading="lazy" decoding="async" style="width: 100%; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.15);" />
      </div>
      <div class="pcps-split-text-content">
        <span class="pcps-eyebrow">PC Gamer Cancún</span>
        <h2>¿Cómo elegir la fuente de poder ideal para tu PC gamer en Cancún?</h2>
        <p>
          Las tarjetas de video modernas como la serie NVIDIA RTX 40 o AMD Radeon 7000 consumen energía en microsegundos de carga pico. Si tu fuente de poder no es capaz de amortiguar estas demandas rápidas de corriente, tu juego se cerrará o la PC se apagará súbitamente.
        </p>
        <p>
          En el taller de **Pixon PC** evaluamos las especificaciones de tu tarjeta de video y procesador. Te asesoramos para elegir la capacidad correcta de Watts reales y te recomendamos fuentes con la nueva norma **ATX 3.0** y conectores **PCIe 5.0 (12VHPWR)** nativos para alimentar tus componentes de gama alta con total estabilidad y sin adaptadores riesgosos.
        </p>
      </div>
    </div>
  </section>

  <!-- 5. Clima local y CFE (H2 SEO local potente) -->
  <section class="pcps-section pcps-local-block">
    <div class="pcps-shell pcps-local-inner">
      <div class="pcps-local-copy">
        <span class="pcps-eyebrow">Entorno Caribeño</span>
        <h2>Apagones de CFE, humedad y salitre: Daño común en fuentes de poder en Cancún</h2>
        <p>
          Las variaciones de voltaje repentinas causadas por apagones de CFE frecuentes en la Península de Yucatán son la causa de daño eléctrico número uno de computadoras en Cancún.
        </p>
        <p>
          El calor extremo de Quintana Roo obliga a los ventiladores de la fuente a trabajar a máximas revoluciones, jalando polvo fino y humedad con salitre. Esta mezcla se deposita sobre los componentes calientes de la fuente, oxidando las soldaduras y provocando arcos eléctricos que funden los capacitores.
        </p>
        <p>
          Por ello, al instalar una fuente nueva en nuestro taller de Cancún, aplicamos tratamientos preventivos antisulfatación básicos e instalamos protecciones eléctricas robustas.
        </p>
      </div>

      <div class="pcps-local-zones">
        <h3>Zonas de reparación de PC en Cancún</h3>
        <p>Cobertura local con cita previa en las supermanzanas y avenidas principales:</p>
        <div class="pcps-zones-grid">
          <span><i class="fa-solid fa-location-dot"></i> Huayacán y Cumbres</span>
          <span><i class="fa-solid fa-location-dot"></i> Cancún Centro</span>
          <span><i class="fa-solid fa-location-dot"></i> Zona Hotelera</span>
          <span><i class="fa-solid fa-location-dot"></i> Av. Tulum y Bonampak</span>
          <span><i class="fa-solid fa-location-dot"></i> Puerto Cancún</span>
          <span><i class="fa-solid fa-location-dot"></i> Alfredo V. Bonfil</span>
          <span><i class="fa-solid fa-location-dot"></i> Polígono Sur y SMs</span>
          <span><i class="fa-solid fa-location-dot"></i> Puerto Juárez</span>
        </div>
      </div>
    </div>
  </section>

  <!-- NUEVA SECCIÓN ADICIONAL 2 (Con imagen): Mantenimiento de PSU -->
  <section class="pcps-section pcps-bg-dark">
    <div class="pcps-shell pcps-split-grid" style="grid-template-columns: 1.15fr 0.85fr;">
      <div class="pcps-split-text-content">
        <span class="pcps-eyebrow" style="color: #fbbf24;">Prevención de Explosiones</span>
        <h2 style="color: #ffffff;">Mantenimiento preventivo de fuentes de poder: Evita cortocircuitos por salitre y polvo</h2>
        <p style="color: #94a3b8;">
          La fuente de poder actúa como el escudo de tu computadora. Su ventilador inferior absorbe aire de la parte más baja del gabinete, que es donde se acumula la mayor cantidad de polvo y pelusa. En Cancún, la combinación de este polvo con la humedad tropical genera una pasta conductora de electricidad que se adhiere a los transformadores y bobinas de la fuente.
        </p>
        <p style="color: #cbd5e1;">
          Con nuestro servicio de mantenimiento preventivo, desarmamos el gabinete, soplamos el interior de la fuente con aire seco controlado, limpiamos el ventilador de aspas y verificamos el estado físico de los capacitores antes de que se hinchen o exploten, alargando la vida de tu inversión.
        </p>
      </div>
      <div class="pcps-visual-wrap">
        <img src="/assets/images/mantenimiento-pc-escritorio.webp" alt="Mantenimiento preventivo y limpieza de fuente de poder en taller Cancún" class="pcps-split-img" width="600" height="400" loading="lazy" decoding="async" style="width: 100%; border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.1);" />
      </div>
    </div>
  </section>

  <!-- 6. Formulario de ticket -->
  <div class="pcps-ticket-wrapper">
    <ServiceTicketSection
      id="ticket-pc-fuente-poder"
      defaultDevice="PC de escritorio"
      defaultService="Fuente de poder"
      title="Crear ticket para revisión de fuente de poder"
      subtitle="Cuéntanos qué síntomas presenta tu PC (si se apaga sola, huele a quemado, no prende nada o dio un chispazo) para prepararte opciones de diagnóstico y refacciones."
    />
  </div>

  <!-- NUEVA SECCIÓN ADICIONAL 3 (Con imagen): Reparación en taller -->
  <section class="pcps-section">
    <div class="pcps-shell pcps-split-grid" style="grid-template-columns: 0.9fr 1.1fr;">
      <div class="pcps-visual-wrap">
        <img src="/assets/images/reparacion-sulfatacion-cancun.webp" alt="Técnico de computadoras reparando fuente de poder en Cancún" class="pcps-split-img" width="600" height="400" loading="lazy" decoding="async" style="width: 100%; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.1);" />
      </div>
      <div class="pcps-split-text-content">
        <span class="pcps-eyebrow">Reparación a Nivel Componente</span>
        <h2>¿Qué hacemos en nuestro taller técnico si tu fuente sufrió un cortocircuito?</h2>
        <p>
          Cuando una fuente de poder gamer premium de gama alta deja de funcionar tras una descarga, no siempre es necesario tirarla. En **Pixon PC** desarmamos la fuente en un entorno seguro y realizamos un lavado químico ultrasónico especial para eliminar la corrosión provocada por el salitre caribeño.
        </p>
        <p>
          Utilizando microscopios de inspección y estaciones de soldadura profesional, localizamos fusibles abiertos, diodos quemados o capacitores secos. Si el circuito integrado principal o los MOSFETs están sanos, podemos cambiar los componentes dañados, devolviendo la fuente a su funcionamiento original con una fracción del costo de un equipo nuevo.
        </p>
      </div>
    </div>
  </section>

  <!-- 7. Riesgos de fuente genérica (H2 SEO) -->
  <section class="pcps-section pcps-bg-light">
    <div class="pcps-shell">
      <div class="pcps-section-head">
        <span>Prevención de hardware</span>
        <h2>Riesgos de usar una fuente de poder genérica o dañada</h2>
        <p>Ahorrar en la fuente de poder es el error más común y peligroso al armar o reparar una computadora.</p>
      </div>

      <div class="pcps-risks-grid">
        {risks.map((item) => (
          <div class="pcps-risk-card">
            <div class="pcps-risk-header">
              <i class="fa-solid fa-circle-exclamation"></i>
              <h3>{item.title}</h3>
            </div>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- NUEVA SECCIÓN ADICIONAL 4 (Con imagen): Actualización de hardware (GPU) -->
  <section class="pcps-section">
