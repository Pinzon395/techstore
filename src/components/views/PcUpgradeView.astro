  }
  .pcup-caption-sep {
    color: #64748b !important;
    font-weight: 800;
  }

  /* Desktop 2-column layout */
  @media (min-width: 1000px) {
    .pcup-hero {
      padding: clamp(56px, 7vw, 90px) 0;
      min-height: 560px;
      display: grid;
