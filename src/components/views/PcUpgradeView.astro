    text-align: center;
  }
  .pcup-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #0369a1 !important;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .pcup-heading h2 {
    margin: 4px 0 12px;
    font-size: clamp(1.85rem, 3.4vw, 2.6rem);
    font-weight: 900;
    line-height: 1.18;
    color: var(--azul-oscuro, #071F3A) !important;
  }
  .pcup-heading p {
    font-size: 1.02rem;
    line-height: 1.65;
    color: #334155 !important;
    margin: 0;
  }

  /* ==================== 1. HERO SECTION ==================== */
  .pcup-hero {
    position: relative;
    padding: clamp(40px, 6vw, 64px) 0 clamp(48px, 7vw, 76px);
    background: radial-gradient(ellipse at 85% 45%, #123951 0, #071f3a 65%);
    color: #ffffff;
    overflow: hidden;
  }
  .pcup-hero-glow {
    position: absolute;
    top: -150px;
    right: -100px;
    width: 650px;
    height: 650px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.15) 0%, rgba(2, 132, 199, 0) 70%);
    pointer-events: none;
  }
  .pcup-hero__grid {
    display: grid;
    grid-template-areas:
      "eyebrow"
      "title"
      "media"
      "summary"
      "actions"
      "trust";
    grid-template-columns: 1fr;
    gap: 18px;
    align-items: center;
  }
