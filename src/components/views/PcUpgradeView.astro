    gap: 14px;
    margin-top: 4px;
  }
  .pcup-hero__trust { grid-area: trust; }

  .pcup-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: #67e8f9 !important;
    font-size: 0.78rem;
