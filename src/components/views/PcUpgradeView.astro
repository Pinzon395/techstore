  }

  /* Forzar estrictamente color azul oscuro en todos los textos fuera del hero y del final CTA */
  .pc-upgrade-page main :is(p, h2, h3, h4, span, a, li, label, strong, summary, button):not(.pcup-btn--primary):not(.pcup-verdict-pill):not(.pcup-usecase-badge):not(.pcup-step-card__num) {
