  .pcup-eyebrow-wrap { grid-area: eyebrow; }
  .pcup-hero__title { grid-area: title; }
  .pcup-hero__visual-wrap {
    grid-area: media;
    width: 100%;
    max-width: 540px;
    justify-self: center;
  }
  .pcup-hero__summary {
    grid-area: summary;
    max-width: 660px;
  }
  .pcup-hero__actions {
