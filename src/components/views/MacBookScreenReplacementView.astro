---
import type { ServiceCategory, ServiceItem } from '../../data/services';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import FaqSection from '../FaqSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import Footer from '../Footer.astro';

interface Props {
  service: ServiceItem;
  category: ServiceCategory;
  faqs: { question: string; answer: string }[];
}

const { service, faqs } = Astro.props;
const whatsappText = encodeURIComponent(`Hola Pixon PC. Quiero cotizar la pantalla de mi MacBook.

Equipo: MacBook Air / Pro
Modelo o número Axxxx (si lo sé):
Año aproximado:
Síntoma: Rota / Líneas / Negra / Parpadea / Manchas / Sin brillo / Otro
¿Hubo golpe? Sí / No
¿Hubo líquido? Sí / No

Puedo enviar fotos del equipo y del daño.`);
const whatsappUrl = `https://wa.me/529986690777?text=${whatsappText}`;

const symptoms = [
  { key: 'Fractura', title: 'Rota o estrellada', copy: 'Cristal fracturado, golpe, presión sobre la tapa o panel con pérdida parcial de imagen.' },
  { key: 'Líneas', title: 'Líneas verticales u horizontales', copy: 'Pueden involucrar panel, flex, conector, presión o señal de video. Se revisa antes de pedir pieza.' },
  { key: 'Sin imagen', title: 'Pantalla negra pero enciende', copy: 'Que la MacBook suene o dé imagen externa no identifica por sí solo el componente dañado.' },
  { key: 'Parpadeo', title: 'Parpadea o cambia al mover la tapa', copy: 'El ángulo de apertura puede orientar hacia flex o conexión, sin convertirlo en diagnóstico definitivo.' },
  { key: 'Manchas', title: 'Manchas, black bleed o zonas oscuras', copy: 'Revisamos presión, golpe, líquido, panel y retroiluminación irregular.' },
  { key: 'Backlight', title: 'Imagen tenue o sin brillo', copy: 'Puede existir imagen sin retroiluminación. También se revisan alimentación, sensor y placa lógica.' },
];

const process = [
  ['Identificar', 'MacBook Air o Pro, número Axxxx, año aproximado, color y fotos del daño.'],
  ['Confirmar falla', 'Panel, flex, backlight, sensor, conector, alimentación y salida externa según el caso.'],
  ['Cotizar pantalla', 'Pieza, origen o calidad disponible, mano de obra, garantía y plazo real por modelo.'],
  ['Autorizar', 'No pedimos ni instalamos una pantalla sin tu aprobación del alcance.'],
  ['Instalar', 'Desmontaje y montaje según el ensamble y la generación de la MacBook.'],
  ['Probar', 'Imagen, brillo, apertura, parpadeo, suspensión y componentes relacionados cuando aplica.'],
];

const routes = [
  { href: '/servicios/mac/diagnostico-mac', title: 'Diagnóstico Mac', copy: 'Cuando la falla aún no está identificada o aparecen varios síntomas.' },
  { href: '/servicios/mac/macbook-no-enciende', title: 'MacBook no enciende', copy: 'Si no hay señal de vida, carga, sonido ni respuesta al botón.' },
  { href: '/servicios/mac/limpieza-liquido-macbook', title: 'Daño por líquido', copy: 'Si hubo agua, café, humedad o corrosión, aunque la imagen sea el síntoma visible.' },
  { href: '/servicios/mac/reparacion-macbook', title: 'Reparación MacBook', copy: 'Para fallas generales que no pertenecen únicamente al sistema de pantalla.' },
];
---

<main class="ms-page">
  <section class="ms-hero" id="inicio">
    <div class="container ms-hero__grid">
      <div class="ms-hero__copy">
        <p class="ms-hero__eyebrow"><span></span> Pantallas MacBook Air y Pro · Cancún</p>
        <h1>Cambio de pantalla MacBook en Cancún</h1>

        <p class="ms-hero__lead">Pantalla rota, líneas, manchas, parpadeo o MacBook sin imagen.</p>
        <p class="ms-hero__body">Confirmamos modelo, panel, flex y retroiluminación antes de cotizar la pantalla correcta. Una pantalla negra no significa automáticamente que el display esté dañado.</p>
        <div class="ms-actions">
          <a class="ms-btn ms-btn--primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Cotizar pantalla de mi MacBook</a>
          <a class="ms-btn ms-btn--secondary" href="#ticket"><i class="fa-solid fa-clipboard-list" aria-hidden="true"></i> Crear ticket</a>
        </div>
        <ul class="ms-trust" aria-label="Puntos del servicio">
          <li>MacBook Air y Pro</li>
          <li>Cotización por modelo</li>
          <li>Revisión de panel y flex</li>
          <li>Prueba de imagen final</li>
        </ul>
      </div>

      <div class="ms-hero__visual">
        <figure class="ms-macbook" data-macbook-animation>
          <svg viewBox="0 0 720 500" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="ms-screen" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#0b5a94"/><stop offset=".5" stop-color="#082b55"/><stop offset="1" stop-color="#071a33"/></linearGradient>
              <linearGradient id="ms-shell" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#d8e1e9"/><stop offset="1" stop-color="#8093a6"/></linearGradient>
              <radialGradient id="ms-bleed" cx="48%" cy="48%" r="55%"><stop stop-color="#020710" stop-opacity=".96"/><stop offset=".45" stop-color="#06101e" stop-opacity=".82"/><stop offset="1" stop-color="#071a33" stop-opacity="0"/></radialGradient>
              <clipPath id="ms-screen-clip"><rect x="116" y="72" width="488" height="305" rx="12"/></clipPath>
              <filter id="ms-glow"><feGaussianBlur stdDeviation="5"/></filter>
            </defs>
            <ellipse cx="360" cy="451" rx="290" ry="20" fill="#00101f" opacity=".35" filter="url(#ms-glow)"/>
            <rect x="94" y="48" width="532" height="354" rx="25" fill="#06101c" stroke="url(#ms-shell)" stroke-width="8"/>
            <rect x="116" y="72" width="488" height="305" rx="12" fill="url(#ms-screen)"/>
            <g clip-path="url(#ms-screen-clip)">
              <path d="M115 294 C210 215 252 245 333 168 S489 106 608 154" fill="none" stroke="#28a8ee" stroke-opacity=".2" stroke-width="48"/>
              <path d="M150 332 C262 268 359 302 424 226 S542 138 617 181" fill="none" stroke="#8ddcff" stroke-opacity=".12" stroke-width="22"/>
              <path class="ms-bleed" d="M428 164 C464 140 507 151 527 190 C543 220 520 252 481 248 C446 244 414 205 428 164Z" fill="url(#ms-bleed)"/>
              <g class="ms-panel-lines">
                <rect x="487" y="72" width="2" height="305" fill="#85d5ff" opacity=".65"/>
                <rect x="501" y="72" width="1" height="305" fill="#d7f3ff" opacity=".5"/>
                <rect x="516" y="72" width="3" height="305" fill="#3eaee6" opacity=".34"/>
              </g>
              <g class="ms-cracks" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <circle class="ms-impact-ring" cx="434" cy="188" r="8" stroke="#d9f4ff" stroke-width="1.6"/>
                <circle class="ms-impact-dot" cx="434" cy="188" r="2.5" fill="#e8f8ff" stroke="none"/>
                <g class="ms-crack ms-crack--primary" stroke="#dff6ff" stroke-width="2.2">
                  <path d="M434 188 L399 156 L364 143 L330 114 L287 98"/>
                  <path d="M434 188 L470 160 L500 122 L548 96"/>
                  <path d="M434 188 L470 205 L511 216 L564 248 L595 286"/>
                  <path d="M434 188 L420 229 L391 263 L383 314 L360 364"/>
                  <path d="M434 188 L395 198 L354 220 L304 223 L255 252 L201 258"/>
                </g>
                <g class="ms-crack ms-crack--secondary" stroke="#bfeaff" stroke-width="1.25">
                  <path d="M399 156 L408 126 L400 96"/><path d="M364 143 L340 159 L312 162"/>
                  <path d="M470 160 L469 129 L482 101"/><path d="M500 122 L524 130 L550 126"/>
                  <path d="M470 205 L480 237 L472 269"/><path d="M511 216 L535 200 L568 197"/>
                  <path d="M420 229 L438 254 L441 290"/><path d="M391 263 L366 277 L345 303"/>
                  <path d="M354 220 L344 191 L326 177"/><path d="M304 223 L290 244 L271 268"/>
                </g>
                <g class="ms-crack ms-crack--micro" stroke="#b8e6fa" stroke-width=".75">
                  <path d="M434 188 l-9 -18 l2 -15"/><path d="M434 188 l17 -8 l12 -16"/><path d="M434 188 l12 17 l1 16"/>
                  <path d="M399 156 l-14 -13 l-4 -12"/><path d="M470 205 l18 4 l11 12"/><path d="M391 263 l-8 22 l5 18"/>
                </g>
              </g>
            </g>
            <circle cx="360" cy="61" r="2.8" fill="#60778b"/>
            <path d="M52 402 H668 L700 440 Q703 451 686 454 H34 Q17 451 20 440Z" fill="url(#ms-shell)" stroke="#60758a" stroke-width="2"/>
            <path d="M292 402 H428 L417 416 H303Z" fill="#71879a" opacity=".75"/>
          </svg>
          <figcaption><span class="ms-status-dot"></span><span data-animation-status>Analizando sistema de pantalla</span></figcaption>
          <button class="ms-replay" type="button" data-animation-replay aria-label="Reproducir de nuevo la animación de la pantalla"><i class="fa-solid fa-rotate-right" aria-hidden="true"></i> Repetir</button>
        </figure>
      </div>
    </div>
  </section>

  <section class="ms-section ms-symptoms" id="sintomas">
    <div class="container">
      <div class="ms-heading"><p>Seis señales, varias causas posibles</p><h2>¿Qué falla tiene la pantalla de tu MacBook?</h2><span>El síntoma orienta la revisión; no identifica una pieza al cien por ciento.</span></div>
      <div class="ms-symptom-console">
        <div class="ms-mini-display" aria-hidden="true"><span class="ms-mini-crack"></span><span class="ms-mini-line"></span><span class="ms-mini-spot"></span></div>
        <div class="ms-symptom-list">
          {symptoms.map((item, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><div><small>{item.key}</small><h3>{item.title}</h3><p>{item.copy}</p></div></article>)}
        </div>
      </div>
    </div>
  </section>

  <section class="ms-section ms-decision" id="diagnostico">
    <div class="container">
      <div class="ms-heading ms-heading--dark"><p>Diagnóstico antes de pantalla</p><h2>¿Es pantalla, flex, retroiluminación o placa?</h2><span>Este flujo ayuda a ordenar las pruebas. El resultado final requiere revisar el equipo.</span></div>
      <div class="ms-flow" aria-label="Flujo orientativo de diagnóstico de pantalla MacBook">
        <article><strong>01</strong><h3>¿La Mac enciende?</h3><p>Buscamos sonido, carga, respuesta y señales de arranque.</p><span>Si no hay vida → <a href="/servicios/mac/macbook-no-enciende">owner de no enciende</a></span></article>
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        <article><strong>02</strong><h3>¿Da imagen externa?</h3><p>Ayuda a separar sistema de pantalla, video y arranque.</p><span>No confirma por sí sola un panel dañado.</span></article>
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        <article><strong>03</strong><h3>¿Cambia al mover la tapa?</h3><p>Observamos flex, conector, bisagra y comportamiento intermitente.</p><span>No se fuerza la tapa durante la prueba.</span></article>
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        <article><strong>04</strong><h3>¿Hay golpe o fractura?</h3><p>Revisamos panel, tapa, bisagras, marco y puntos de presión.</p><span>Panel / flex / backlight / placa / revisión adicional.</span></article>
      </div>
      <p class="ms-flow__note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> Antes de cotizar un ensamble, confirmamos que el problema realmente está en el sistema de pantalla.</p>
    </div>
  </section>

  <section class="ms-section ms-identify" id="modelo">
    <div class="container ms-identify__grid">
      <div>
        <p class="ms-section-label">Una pantalla no es universal</p>
        <h2>¿Por qué necesitamos el modelo exacto antes de cotizar?</h2>
        <p>Entre generaciones cambian tamaño, resolución, conectores, tapa, color, sensores, cámara y número de parte. El chip ayuda a ubicar la familia, pero no define por sí solo qué pantalla usa tu MacBook.</p>
        <p>Según el modelo y tipo de daño, la reparación puede involucrar panel, flex o un ensamble de pantalla. No asumimos que siempre debe cambiarse todo ni prometemos “solo cristal” sin verificar el procedimiento disponible.</p>
      </div>
      <aside>
        <h3>Envíanos esto por WhatsApp</h3>
        <ol><li><span>1</span>MacBook Air o MacBook Pro</li><li><span>2</span>Número de modelo Axxxx</li><li><span>3</span>Año aproximado y color</li><li><span>4</span>Foto del daño y de la información disponible</li></ol>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Enviar datos y fotos <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
      </aside>
    </div>
  </section>

  <section class="ms-section ms-compatibility" id="compatibilidad">
    <div class="container">
      <div class="ms-heading"><p>Compatibilidad por familia</p><h2>Pantallas para MacBook Air y MacBook Pro</h2><span>Atendemos equipos Intel y Apple Silicon cuando existe una pantalla compatible y un procedimiento viable para el modelo exacto.</span></div>
      <div class="ms-matrix">
        <div class="ms-matrix__corner">Familia</div><div class="ms-matrix__head">Intel</div><div class="ms-matrix__head">Apple Silicon</div>
        <div class="ms-matrix__model"><strong>MacBook Air</strong><span>Delgada, distintos tamaños y acabados</span></div><div><strong>Generaciones Intel</strong><p>Se valida año, tamaño, Axxxx, resolución, conector y color.</p></div><div><strong>M1 · M2 · M3 · M4</strong><p>La disponibilidad se confirma por generación y ensamble, no solo por chip.</p></div>
        <div class="ms-matrix__model"><strong>MacBook Pro</strong><span>Variantes de tamaño y pantalla por generación</span></div><div><strong>Generaciones Intel</strong><p>Se revisan panel, flex, tapa, bisagras y número de parte.</p></div><div><strong>M1 · M2 · M3 · M4</strong><p>Se confirma tamaño, acabado, sensores y pieza disponible para el modelo.</p></div>
      </div>
      <p class="ms-matrix__note">Origen y calidad de la refacción, compatibilidad, garantía y disponibilidad se explican antes de cotizar. No publicamos una promesa universal de “pantalla original”.</p>
    </div>
  </section>

  <section class="ms-section ms-process" id="proceso">
    <div class="container">
      <div class="ms-heading ms-heading--dark"><p>Del modelo a la prueba final</p><h2>Proceso para cambiar el display de una MacBook</h2><span>El tiempo se confirma junto con la disponibilidad de la pantalla.</span></div>
      <ol class="ms-timeline">{process.map((item, index) => <li><span>{index + 1}</span><div><h3>{item[0]}</h3><p>{item[1]}</p></div></li>)}</ol>
    </div>
  </section>

  <section class="ms-section ms-risks" id="cuidados">
    <div class="container ms-risks__grid">
      <div><p class="ms-section-label">Antes de seguir usando la Mac</p><h2>Golpe, bisagra y líquido cambian la revisión</h2><p>Una bisagra dura o una tapa deformada puede mantener tensión sobre el display o el flex. Si hubo líquido, el síntoma visible puede esconder corrosión en conectores o placa.</p></div>
      <div class="ms-risk-rows">
        <a href="/servicios/mac/limpieza-liquido-macbook"><i class="fa-solid fa-droplet" aria-hidden="true"></i><span><strong>Hubo líquido</strong>Tratar como daño por líquido antes de asumir que basta una pantalla.</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        <a href="/servicios/mac/macbook-no-enciende"><i class="fa-solid fa-power-off" aria-hidden="true"></i><span><strong>No da señal de vida</strong>La ruta correcta comienza por alimentación y arranque.</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        <a href="/servicios/mac/reparacion-macbook"><i class="fa-solid fa-laptop-medical" aria-hidden="true"></i><span><strong>Hay varias fallas</strong>Una revisión general puede evitar atribuir todo al display.</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </section>

  <ServiceTicketSection id="ticket" defaultDevice="MacBook" defaultService={service.label} sourcePage="/servicios/mac/cambio-pantalla-macbook" title="Cotizar pantalla de mi MacBook" subtitle="Indica si es Air o Pro, número Axxxx si lo conoces, año aproximado, síntoma, golpe o líquido. Puedes enviarnos fotos por WhatsApp." />

  <section class="ms-section ms-related" id="rutas">
    <div class="container">
      <div class="ms-heading"><p>Si el problema no es el panel</p><h2>Cada falla conserva su propia ruta</h2><span>Esta landing es la especialista en pantalla MacBook. Estas rutas atienden intenciones diferentes.</span></div>
      <div class="ms-route-list">{routes.map((route, index) => <a href={route.href}><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{route.title}</h3><p>{route.copy}</p></div><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>)}</div>
    </div>
  </section>

  <FaqSection id="faq" title="Preguntas frecuentes sobre pantallas MacBook" description="Precio por modelo, compatibilidad, funciones, datos, tiempos y garantía antes de autorizar." items={faqs} viewMoreHref="/preguntas-frecuentes" viewMoreLabel="Ver más preguntas frecuentes" backgroundColor="#f4f8fc" questionColor="#071F3A" titleColor="#071F3A" descriptionColor="#294963" itemGap="8px" questionPadding="16px 18px" />
  <CommentsSection viewMoreHref="/comentarios" viewMoreLabel="Ver todas las reseñas" id="comentarios" dark={true} />
  <ContactSection id="ubicacion" />
  <Footer />
</main>

<script>
  const visual = document.querySelector<HTMLElement>('[data-macbook-animation]');
  if (visual) {
    const status = visual.querySelector<HTMLElement>('[data-animation-status]');
    const replay = visual.querySelector<HTMLButtonElement>('[data-animation-replay]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let played = false;
    const play = () => {
      if (played && !visual.classList.contains('ms-replay-requested')) return;
      played = true;
      visual.classList.remove('is-playing', 'is-complete', 'ms-replay-requested');
      void visual.offsetWidth;
      visual.classList.add('is-playing');
      if (status) status.textContent = 'Verificando panel, flex y retroiluminación';
      window.setTimeout(() => {
        visual.classList.remove('is-playing');
        visual.classList.add('is-complete');
        if (status) status.textContent = 'Daño de pantalla visible · diagnóstico pendiente';
      }, 3600);
    };
    if (reduced) {
      visual.classList.add('is-complete');
      if (status) status.textContent = 'Daño de pantalla visible · diagnóstico pendiente';
    } else {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting && entry.intersectionRatio >= .55)) {
          play();
          observer.disconnect();
        }
      }, { threshold: [.55] });
      observer.observe(visual);
      replay?.addEventListener('click', () => { visual.classList.add('ms-replay-requested'); play(); });
    }
  }
</script>

<style>
  .ms-page{--navy:#071f3a;--blue:#087ec1;--cyan:#62c8f4;--ink:#071f3a;--muted:#36556d;--line:#cad8e4;--soft:#f4f8fc;background:#fff;color:var(--ink);font-family:var(--font-main,'Red Hat Display',sans-serif);overflow:hidden}.ms-page :where(h1,h2,h3,p){color:inherit}.ms-page :where(h1,h2,h3){font-family:var(--font-heading,'Kanit',sans-serif);text-wrap:balance}.ms-page p{text-wrap:pretty}.ms-hero{background:radial-gradient(circle at 76% 34%,rgba(25,142,205,.24),transparent 32%),linear-gradient(135deg,#041321 0%,#071f3a 52%,#0a3152 100%);color:#fff;padding:clamp(32px,5vw,64px) 0 34px}.ms-hero__grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(480px,1.1fr);align-items:center;gap:clamp(28px,5vw,68px)}.ms-hero__copy{min-width:0}.ms-hero__eyebrow{display:flex;align-items:center;gap:10px;margin:0 0 14px;color:#bfe9fb!important;font-weight:800;font-size:.86rem}.ms-hero__eyebrow span{width:28px;height:2px;background:#48b9ec}.ms-hero h1{font-size:clamp(2.45rem,4.7vw,4.85rem);line-height:.98;letter-spacing:-.035em;margin:0 0 20px;max-width:760px}.ms-hero__lead{font-size:clamp(1.16rem,2vw,1.48rem);font-weight:800;line-height:1.35;margin:0 0 8px}.ms-hero__body{color:#c9dce9!important;max-width:62ch;line-height:1.65;margin:0}.ms-actions{display:flex;flex-wrap:wrap;gap:10px;margin:24px 0 20px}.ms-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:48px;padding:12px 17px;border-radius:9px;font-weight:850;text-decoration:none;border:1px solid transparent;transition:transform .2s cubic-bezier(.22,1,.36,1),background .2s}.ms-btn:hover{transform:translateY(-2px)}.ms-btn:focus-visible,.ms-replay:focus-visible,.ms-page a:focus-visible{outline:3px solid #f5b942;outline-offset:3px}.ms-btn--primary{background:#12a85a;color:#fff}.ms-btn--secondary{border-color:#79b7d5;background:rgba(255,255,255,.08);color:#fff}.ms-trust{display:flex;flex-wrap:wrap;gap:8px 18px;margin:0;padding:18px 0 0;border-top:1px solid rgba(255,255,255,.18);list-style:none;colo