---
import FaqSection from '../FaqSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import Footer from '../Footer.astro';

const { service, category } = Astro.props;
const waText = encodeURIComponent('Hola, mi PC está lenta en Cancún. Quiero un diagnóstico para saber si el problema está en almacenamiento, RAM, Windows, temperatura o malware.');
const causes = [
  { icon:'fa-hard-drive', title:'Disco duro HDD lento o trabajando al 100%', copy:'Los discos mecánicos pueden convertirse en un límite para Windows moderno, sobre todo al arrancar, actualizar, abrir aplicaciones o trabajar con varios programas.', details:[['Windows tarda en iniciar desde HDD','Revisamos arranque, programas de inicio, actividad de disco y el estado de la unidad antes de recomendar una migración.'],['Disco trabajando constantemente al 100%','Puede relacionarse con almacenamiento, actualizaciones, procesos o errores. Es una señal para investigar, no un diagnóstico definitivo.']] },
  { icon:'fa-memory', title:'Memoria RAM insuficiente para los programas que utilizas', copy:'Cuando la memoria disponible se agota, Windows usa almacenamiento como memoria virtual y el equipo puede tardar más al cambiar entre aplicaciones o pestañas.', details:[['PC con 4 GB u 8 GB de RAM','La cantidad adecuada depende del sistema, los programas y la carga de trabajo. Revisamos el uso real antes de recomendar una ampliación.']] },
  { icon:'fa-windows', title:'Windows lento por programas de inicio y procesos en segundo plano', copy:'Aplicaciones que se cargan al iniciar sesión, servicios innecesarios o software mal configurado pueden consumir CPU, RAM, disco o red incluso sin que los estés usando.', details:[['Programas que arrancan con Windows','Identificamos qué se carga al iniciar y si realmente debe permanecer activo.'],['Procesos que consumen CPU y memoria','Revisamos procesos recurrentes y comportamiento anormal antes de cambiar hardware.']] },
  { icon:'fa-shield-virus', title:'Virus, malware o software no deseado', copy:'Adware, extensiones maliciosas, aplicaciones no deseadas o procesos sospechosos pueden afectar el rendimiento y la estabilidad.', link:{href:'/servicios/pc/virus-malware',label:'Ver eliminación de virus y malware'} },
  { icon:'fa-temperature-half', title:'PC lenta por temperatura y thermal throttling', copy:'Cuando CPU o GPU alcanzan sus límites térmicos, el hardware puede reducir frecuencia para protegerse. Revisamos temperaturas, ventilación y carga antes de atribuir la lentitud al sistema térmico.', details:[['CPU con temperatura elevada','El límite depende del procesador y de la carga; una temperatura aislada no explica por sí sola toda la lentitud.'],['Ventiladores y flujo de aire','Revisamos polvo, ventilación, comportamiento de ventiladores y limitaciones del gabinete.'],['Pasta térmica según condición','Se valora como parte de un diagnóstico térmico, sin prometer una reducción fija de temperatura.']] },
  { icon:'fa-hard-drive', title:'SSD lleno, degradado o con poco espacio disponible', copy:'Una unidad casi llena o con problemas puede afectar instalaciones, actualizaciones, cachés y escritura de archivos. Revisamos capacidad, estado y comportamiento antes de recomendar reemplazo.' },
];
const steps = [['01','Rendimiento','Revisamos CPU, RAM y procesos durante arranque, multitarea y uso normal.'],['02','Almacenamiento','Comprobamos HDD o SSD, capacidad, estado S.M.A.R.T. cuando aplica y posibles errores.'],['03','Temperatura','Evaluamos ventilación, comportamiento térmico y señales de reducción de frecuencia bajo carga.'],['04','Software','Analizamos inicio de Windows, procesos innecesarios, malware y configuraciones que afectan el rendimiento.'],['05','Recomendación','Te explicamos la causa, qué opción tiene sentido y alternativas según tu presupuesto.']];
const symptomRows = [['Tarda en prender','Almacenamiento / programas de inicio'],['Se congela con muchas aplicaciones','RAM / software'],['Pierde rendimiento jugando','Temperatura / CPU / GPU'],['Disco al 100%','Almacenamiento / procesos'],['Ventilador muy fuerte','Temperatura / carga']];
const gamer = [['Bajones de FPS durante partidas','Revisamos si el comportamiento aparece por temperatura, uso de CPU/GPU, memoria, almacenamiento o procesos que compiten con el juego.'],['PC Gamer que se calienta y pierde rendimiento','Buscamos si la caída aparece después de varios minutos y revisamos ventilación, disipación y carga real.'],['Juegos que tardan en cargar','El almacenamiento, el espacio disponible, la memoria y procesos en segundo plano pueden influir; aislamos la causa antes de actualizar.'],['PC que se congela al jugar','No asumimos que sea la GPU: revisamos estabilidad de RAM, almacenamiento, temperatura, controladores y alimentación según el síntoma.']];
const office = [['PC lenta con Excel y Office','Analizamos la carga de los archivos, memoria disponible, complementos, almacenamiento y aplicaciones en segundo plano.'],['Navegador lento con muchas pestañas','Revisamos uso real de RAM, extensiones, procesos del navegador y el estado general de Windows.'],['Computadora lenta al iniciar sesión','Medimos qué se carga con Windows, actividad de almacenamiento y servicios que retrasan el inicio.'],['PC de trabajo que se congela','Aislamos si el bloqueo viene de software, almacenamiento, memoria, red o un componente que necesita revisión.']];
const solutions = [
  ['fa-gauge-high','Optimización de Windows para una PC lenta','Cuando el hardware está en buen estado, revisamos programas de inicio, servicios, controladores y configuraciones que afectan el rendimiento.','/optimizacion','Ver optimización de Windows'],
  ['fa-hard-drive','Cambio de disco HDD a SSD','En equipos con disco mecánico, migrar a SSD puede mejorar los tiempos de arranque y apertura de aplicaciones cuando el almacenamiento es el principal límite.','/servicios/pc/upgrade','Ver cambio de SSD y ampliación de RAM'],
  ['fa-memory','Ampliación de memoria RAM','Si el equipo se queda sin memoria durante el uso habitual, revisamos capacidad, compatibilidad, módulos instalados y límite de la plataforma antes de ampliar.','/servicios/pc/upgrade','Revisar opciones de RAM y SSD'],
  ['fa-fan','Limpieza y mantenimiento térmico','Cuando existe polvo, ventilación limitada o temperatura elevada, puede requerirse limpieza interna y revisión del sistema térmico.','/servicios/pc/limpieza-profunda','Ver limpieza interna de PC'],
  ['fa-arrows-rotate','Reinstalación de Windows cuando realmente conviene','Si el sistema está gravemente dañado, infectado o inestable y una reparación lógica no es razonable, podemos valorar respaldo y reinstalación limpia.','/servicios/pc/formateo','Ver reinstalación de Windows'],
];
const decisions = [['Cuándo un SSD puede ser suficiente','Cuando el almacenamiento es el cuello de botella y la plataforma sigue respondiendo a tu uso, un SSD puede ser una ruta razonable.'],['Cuándo ampliar RAM tiene sentido','Cuando la memoria se queda corta durante el trabajo real y la plataforma admite módulos compatibles.'],['Cuándo conviene optimizar Windows','Cuando las pruebas indican que el hardware está sano, pero el inicio, programas o configuración están afectando el uso diario.'],['Cuándo ya no vale la pena actualizar','Si la plataforma limita lo que necesitas hacer o el costo de continuar reparando deja de ser conveniente, te lo indicamos antes de invertir.']];
const prices = [['Precio del diagnóstico','El alcance depende de los síntomas y las pruebas necesarias. Confirmamos la revisión y cualquier trabajo adicional antes de avanzar.'],['Costo de cambio a SSD','Varía por capacidad, interfaz, compatibilidad y si es viable migrar el sistema actual.'],['Costo de ampliar RAM','Depende de la generación, módulos instalados, capacidad máxima y disponibilidad compatible.'],['Costo de optimización o reinstalación','No tienen el mismo alcance: se cotizan según el estado de Windows, respaldo requerido y la causa encontrada.']];
const zones = ['Cancún Centro','Zona Hotelera','Huayacán','Cumbres','Puerto Cancún','Bonampak','Puerto Juárez','Polígono Sur','Supermanzanas','Haciendas','Bonfil'];
const faqs = [
['¿Por qué mi PC está tan lenta de repente?','Una lentitud repentina puede relacionarse con actualizaciones, procesos nuevos, almacenamiento lleno o con errores, temperatura, memoria, software no deseado o una falla de hardware. Revisamos el comportamiento antes de recomendar una solución.'],['¿Por qué Windows tarda tanto en iniciar?','Puede influir el tipo y estado del almacenamiento, programas de inicio, servicios, actualizaciones o problemas en Windows. El diagnóstico identifica qué está retrasando el arranque.'],['¿Por qué el disco aparece al 100%?','El uso alto puede ser temporal o reflejar procesos, actualizaciones, software, falta de recursos o una unidad con problemas. No basta con ver un porcentaje: revisamos el proceso y el estado de la unidad.'],['¿Cómo saber si necesito un SSD?','Revisamos si el almacenamiento es el límite principal, la compatibilidad de tu equipo y el estado de la unidad actual. Si el SSD es la opción adecuada, te explicamos capacidad y migración posible.'],['¿8 GB de RAM son suficientes para mi PC?','Depende de Windows, programas, pestañas, archivos y carga de trabajo. Medimos el uso real para saber si ampliar memoria resolvería el problema.'],['¿Por qué mi PC se congela al abrir programas?','Puede deberse a memoria, almacenamiento, software, temperatura o hardware. Aislamos la causa para evitar cambiar piezas sin necesidad.'],['¿Un virus puede hacer lenta una computadora?','Sí. Malware, adware, extensiones sospechosas y software no deseado pueden consumir recursos o afectar la estabilidad. Aun así, no toda lentitud es un virus.'],['¿Una PC se puede poner lenta por temperatura?','Sí, algunos equipos reducen su frecuencia cuando alcanzan sus límites térmicos. La causa puede involucrar ventilación, polvo, carga, disipación o configuración; se revisa por modelo y condición.'],['¿Por qué mi PC Gamer pierde FPS después de jugar un rato?','Si aparece después de varios minutos, revisamos temperatura, comportamiento de CPU/GPU, memoria, procesos, almacenamiento y estabilidad general antes de sugerir un upgrade.'],['¿Conviene ampliar RAM o cambiar a SSD primero?','Depende del cuello de botella. Un SSD ayuda cuando el almacenamiento limita; más RAM ayuda cuando el uso real agota la memoria. El diagnóstico permite elegir con evidencia.'],['¿Puedo conservar mis archivos al cambiar HDD por SSD?','Cuando la unidad original está en condiciones adecuadas, se puede valorar una clonación. Si existen errores o daño físico, primero se prioriza la integridad de los datos y las opciones de respaldo.'],['¿Cuánto cuesta arreglar una PC lenta en Cancún?','Depende de la causa. Optimización, ampliación de RAM, cambio a SSD, mantenimiento térmico y reparación de hardware tienen alcances distintos. Te explicamos opciones antes de intervenir.'],['¿Necesito formatear Windows para acelerar mi computadora?','No siempre. Primero revisamos si la lentitud viene de software, almacenamiento, memoria o temperatura. La reinstalación limpia se valora cuando realmente resuelve el problema.'],['¿Atienden computadoras de oficina?','Sí. Revisamos equipos de oficina para problemas con arranque, Excel, navegadores, videollamadas, almacenamiento, memoria y software de inicio.'],['¿Atienden PC Gamer?','Sí. Revisamos PC Gamer con bajones de FPS, congelamientos, carga lenta, temperatura elevada y rendimiento inestable.'],['¿Atienden Zona Hotelera de Cancún?','Podemos coordinar atención para residentes, huéspedes, departamentos y negocios de Zona Hotelera según el tipo de equipo y disponibilidad. Confirma tu zona y síntomas antes de trasladarlo.'],['¿Trabajan mediante cita previa?','Sí. Cuéntanos el modelo, síntomas y zona por WhatsApp o mediante el formulario para coordinar la revisión.']].map(([question, answer]) => ({ question, answer }));
---

<div class="pclen-page">
  <section class="pclen-hero"><div class="pclen-shell pclen-hero-grid"><div class="pclen-copy"><span class="pclen-kicker"><i class="fa-solid fa-gauge-high"></i> Diagnóstico de rendimiento · PC Windows · Cancún</span><h1>¿Tu PC está lenta? Diagnóstico y solución en Cancún</h1><p class="pclen-lead">Si tu computadora tarda en encender, se congela, abre lento los programas o pierde rendimiento, revisamos almacenamiento, memoria RAM, procesos de Windows, temperatura y posibles fallas antes de recomendar cambios.</p><p class="pclen-support">El objetivo es encontrar qué está limitando realmente tu equipo antes de gastar en piezas, formateos o servicios que quizá no necesitas.</p><div class="pclen-actions"><a href="#ticket-pc-lenta" class="pclen-btn pclen-primary"><i class="fa-solid fa-stethoscope"></i> Diagnosticar mi PC</a><a href={`https://wa.me/529986690777?text=${waText}`} class="pclen-btn pclen-secondary" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-whatsapp"></i> Explicar el problema por WhatsApp</a></div><ul class="pclen-trust"><li>PC de escritorio</li><li>PC Gamer</li><li>PC de oficina</li><li>Cita previa</li></ul></div><aside class="pclen-visual" aria-label="Proceso conceptual de diagnóstico de lentitud"><div class="pclen-flow-head"><span>PC lenta</span><i class="fa-solid fa-arrow-down"></i><strong>Análisis</strong></div><div class="pclen-signals"><span><i class="fa-solid fa-microchip"></i> CPU</span><span><i class="fa-solid fa-memory"></i> RAM</span><span><i class="fa-solid fa-hard-drive"></i> Almacenamiento</span><span><i class="fa-solid fa-temperature-half"></i> Temperatura</span><span><i class="fa-solid fa-list-check"></i> Procesos</span></div><div class="pclen-flow"><strong>Se identifica el cuello de botella</strong><i class="fa-solid fa-arrow-down"></i><strong>Solución adecuada</strong><i class="fa-solid fa-arrow-down"></i><span>Rendimiento estable</span></div><p><i class="fa-solid fa-circle-info"></i> Ejemplo conceptual: no son mediciones de tu equipo.</p></aside></div></section>

  <nav class="pclen-nav" aria-label="Navegación de esta página"><div class="pclen-shell"><a href="#causas">¿Por qué está lenta?</a><a href="#diagnostico">Diagnóstico</a><a href="#soluciones">Soluciones</a><a href="#gamer">PC Gamer</a><a href="#oficina">Oficina</a><a href="#precio">Precio</a><a href="#faq-pc-lenta">FAQ</a></div></nav>

  <section class="pclen-section" id="sintomas"><div class="pclen-shell"><div class="pclen-heading"><span>Antes de recomendar una solución</span><h2>Diagnóstico para PC lenta en Cancún</h2><p>Una computadora puede sentirse lenta por muchas razones. Antes de recomendar un SSD, más RAM, limpieza o reinstalación de Windows, revisamos qué recurso se está saturando y en qué momento aparece la lentitud.</p></div><div class="pclen-grid pclen-three"><article><i class="fa-solid fa-power-off"></i><h3>PC que tarda mucho en prender</h3><p>Un arranque lento puede relacionarse con almacenamiento, demasiados programas de inicio, servicios de Windows, actualizaciones pendientes o una unidad con problemas.</p></article><article><i class="fa-solid fa-window-maximize"></i><h3>PC que se traba al abrir programas</h3><p>Cuando aplicaciones, navegadores o archivos tardan en responder, revisamos memoria RAM, uso de CPU, almacenamiento y procesos en segundo plano.</p></article><article><i class="fa-solid fa-snowflake"></i><h3>Computadora que se congela o deja de responder</h3><p>Los congelamientos pueden tener origen en software, almacenamiento, memoria, temperatura o hardware. Por eso primero aislamos la causa.</p></article></div></div></section>

  <section class="pclen-section pclen-dark" id="causas"><div class="pclen-shell"><div class="pclen-heading pclen-light"><span>Posibles áreas a revisar</span><h2>¿Por qué una computadora se vuelve lenta?</h2><p>La lentitud no tiene una sola causa. Estas son algunas de las áreas que revisamos cuando una PC pierde rendimiento.</p></div><div class="pclen-grid pclen-causes">{causes.map((cause) => <article><div class="pclen-cause-title"><i class={`fa-solid ${cause.icon}`}></i><h3>{cause.title}</h3></div><p>{cause.copy}</p>{cause.details?.map(([title, copy]) => <div class="pclen-detail"><h4>{title}</h4><p>{copy}</p></div>)}{cause.link && <a href={cause.link.href}>{cause.link.label} <i class="fa-solid fa-arrow-right"></i></a>}</article>)}</div></div></section>

  <section class="pclen-section pclen-tint"><div class="pclen-shell pclen-split"><div class="pclen-heading"><span>No es un diagnóstico automático</span><h2>Síntomas y posibles áreas a revisar</h2><p>Un mismo síntoma puede tener más de una causa. Esta guía ayuda a orientar la revisión, no sustituye el diagnóstico.</p></div><div class="pclen-table-wrap"><table><thead><tr><th>Síntoma</th><th>Posible área a revisar</th></tr></thead><tbody>{symptomRows.map(([symptom, area]) => <tr><td>{symptom}</td><td>{area}</td></tr>)}</tbody></table></div></div></section>

  <section class="pclen-section" id="gamer"><div class="pclen-shell"><div class="pclen-heading"><span>Rendimiento bajo carga</span><h2>PC Gamer lenta, con bajones de FPS o rendimiento inestable en Cancún</h2><p>Si tu PC Gamer empieza bien y pierde rendimiento después de varios minutos, se congela o tiene bajones repentinos, revisamos CPU, GPU, RAM, almacenamiento, temperaturas y procesos antes de concluir que necesitas una actualización.</p></div><div class="pclen-grid pclen-four">{gamer.map(([title, copy]) => <article><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section>
  <section class="pclen-section pclen-tint" id="oficina"><div class="pclen-shell"><div class="pclen-heading"><span>Trabajo diario sin fricción</span><h2>Computadora de oficina lenta en Cancún</h2><p>Para equipos administrativos revisamos arranque, Excel, navegadores, videollamadas, almacenamiento, memoria y software que se ejecuta automáticamente.</p></div><div class="pclen-grid pclen-four">{office.map(([title, copy]) => <article><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section>

  <section class="pclen-section" id="diagnostico"><div class="pclen-shell pclen-method"><div><div class="pclen-heading"><span>Método de revisión</span><h2>Cómo diagnosticamos una PC lenta en Cancún</h2><p>No cambiamos componentes por intuición. Revisamos el comportamiento del equipo y relacionamos los síntomas con mediciones y pruebas antes de recomendar una intervención.</p></div><img src="/assets/images/mantenimiento-pc-escritorio.webp" alt="Diagnóstico de computadora lenta y rendimiento de PC en Cancún" width="900" height="600" loading="lazy" decoding="async" /></div><ol>{steps.map(([number, title, copy]) => <li><span>{number}</span><div><h3>{title}</h3><p>{copy}</p></div></li>)}</ol></div></section>

  <section class="pclen-section pclen-tint" id="soluciones"><div class="pclen-shell"><div class="pclen-heading"><span>La solución depende de la causa</span><h2>Soluciones para una computadora lenta en Cancún</h2><p>Una PC puede necesitar optimización, limpieza, más memoria, un SSD, reinstalación de Windows o una reparación diferente.</p></div><div class="pclen-grid pclen-solutions">{solutions.map(([icon, title, copy, href, label]) => <article><i class={`fa-solid ${icon}`}></i><h3>{title}</h3><p>{copy}</p><a href={href}>{label} <i class="fa-solid fa-arrow-right"></i></a></article>)}</div></div></section>

  <section class="pclen-section"><div class="pclen-shell"><div class="pclen-heading"><span>Decisión informada</span><h2>¿Conviene reparar una PC lenta o comprar otra computadora?</h2><p>No siempre hace falta reemplazar el equipo completo. Evaluamos procesador, plataforma, memoria, almacenamiento y uso previsto para decirte si una actualización tiene sentido o si seguir invirtiendo dejaría de ser conveniente.</p></div><div class="pclen-grid pclen-four">{decisions.map(([title, copy]) => <article><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section>
  <section class="pclen-section pclen-tint" id="precio"><div class="pclen-shell pclen-split"><div class="pclen-heading"><span>Costos claros antes de intervenir</span><h2>¿Cuánto cuesta arreglar una PC lenta en Cancún?</h2><p>El costo depende de la causa. Una optimización de Windows, ampliación de RAM, cambio a SSD, mantenimiento térmico y reparación de hardware tienen alcances diferentes.</p></div><div class="pclen-price-list">{prices.map(([title, copy]) => <article><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section>
  <section class="pclen-section"><div class="pclen-shell pclen-split"><div class="pclen-heading"><span>Información primero</span><h2>¿Qué pasa con mis archivos si mi PC está lenta?</h2><p>Antes de clonaciones, reinstalaciones o trabajos que puedan modificar el almacenamiento, confirmamos contigo el alcance y las opciones de respaldo disponibles.</p></div><article class="pclen-data"><i class="fa-solid fa-database"></i><h3>Migración de HDD a SSD conservando el sistema cuando es viable</h3><p>Si la unidad original está en condiciones adecuadas, podemos valorar clonación. Cuando existen errores o daño físico, primero se prioriza la integridad de los datos.</p></article></div></section>
  <section class="pclen-section pclen-dark"><div class="pclen-shell"><div class="pclen-heading pclen-light"><span>Servicio local con cita previa</span><h2>Servicio para PC lenta en Cancún con cita previa</h2><p>Atendemos computadoras de escritorio, PC Gamer y equipos de oficina en Cancún mediante cita previa. Confirma modelo, síntomas y zona antes de trasladar el equipo.</p></div><div class="pclen-grid pclen-two pclen-local"><article><i class="fa-solid fa-location-dot"></i><h3>Diagnóstico de computadora lenta en Zona Hotelera de Cancún</h3><p>Podemos coordinar atención para residentes, huéspedes, departamentos y negocios de Zona Hotelera según el tipo de equipo y disponibilidad.</p></article><article><i class="fa-solid fa-map-location-dot"></i><h3>Zonas de atención</h3><ul>{zones.map((zone) => <li>{zone}</li>)}</ul></article></div></div></section>

  <ServiceTicketSection id="ticket-pc-lenta" defaultDevice="PC Windows" defaultService="Diagnóstico de PC lenta" title="Diagnostica tu PC lenta" subtitle="Cuéntanos el modelo, qué ocurre al iniciar o trabajar y desde cuándo notas la lentitud. Con esa información preparamos la revisión." />
  <RelatedServicesSection service={service} category={category} initialLimit={6} title="Soluciones relacionadas para una PC lenta" />
  <FaqSection id="faq-pc-lenta" title="Preguntas frecuentes sobre PC y computadoras lentas en Cancún" description="Respuestas antes de decidir entre optimización, SSD, RAM, limpieza, revisión térmica o reinstalación de Windows." items={faqs} backgroundColor="#f8fafc" titleColor="#071F3A" descriptionColor="#415a77" questionColor="#071F3A" faqAccent="#0b7eaa" />
  <section class="pclen-final"><div class="pclen-shell"><div><span>¿Tu PC sigue lenta?</span><h2>Descríbenos el síntoma y te orientamos hacia el diagnóstico adecuado.</h2></div><a href={`https://wa.me/529986690777?text=${waText}`} target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-whatsapp"></i> Hablar por WhatsApp</a></div></section>
  <CommentsSection /><ContactSection /><Footer />
