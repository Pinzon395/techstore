---
import FaqSection from '../FaqSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import Footer from '../Footer.astro';

const { service, category } = Astro.props;

const whatsappText = encodeURIComponent(
  'Hola Pixon PC, mi computadora no enciende. Quisiera agendar un diagnóstico técnico en Cancún para saber exactamente qué falla tiene mi equipo.'
);

const symptoms = [
  {
    icon: 'fa-ban',
    title: 'No prende ningún LED',
    cause: 'Fallo total en la fuente de poder (PSU), botón de encendido desconectado, o un cortocircuito grave en la línea de entrada de la tarjeta madre.',
    recommendation: 'Desconecta el cable de corriente y no intentes forzar el encendido para evitar daños en cascada.',
  },
  {
    icon: 'fa-rotate',
    title: 'Prenden ventiladores sin imagen',
    cause: 'Inestabilidad en la memoria RAM, BIOS corrupta, falta de alimentación al CPU, o un procesador/GPU que no está completando el POST.',
    recommendation: 'Verifica que el cable HDMI/DisplayPort esté conectado directamente a la tarjeta de video y no a la placa madre.',
  },
  {
    icon: 'fa-bolt-lightning',
    title: 'Se apaga al instante',
    cause: 'Activación del sistema de protección contra cortocircuito de la fuente de poder, o calentamiento crítico del CPU por disipador suelto.',
    recommendation: 'No insistas en encenderla repetidamente, ya que cada intento puede dañar transistores sensibles.',
  },
  {
    icon: 'fa-fire-flame-curved',
    title: 'Olor a quemado',
    cause: 'Fase de alimentación quemada (VRM), capacitores reventados o cables internos haciendo cortocircuito físico.',
    recommendation: 'Desconéctala de inmediato del tomacorriente. Es un riesgo de incendio y daño total irreversible.',
  },
  {
    icon: 'fa-triangle-exclamation',
    title: 'Pitidos o luces intermitentes',
    cause: 'Códigos de error de hardware (POST codes). Indican fallo específico en RAM, procesador, GPU o tarjeta madre.',
    recommendation: 'Anota la secuencia de pitidos o el color de los LEDs parpadeantes; nos ayudará en el prediagnóstico.',
  },
  {
    icon: 'fa-desktop',
    title: 'Pantalla negra tras encender',
    cause: 'Señal de video ausente, fallo de energía del monitor, o sistema operativo corrupto que impide cargar el cargador de arranque.',
    recommendation: 'Prueba conectando otro monitor o pantalla para descartar que sea solo un fallo de imagen.',
  },
];

const diagnosticSteps = [
  {
    title: 'Prueba de energía (PSU)',
    desc: 'Medimos los voltajes de los rieles de 12V, 5V y 3.3V de tu fuente de poder con herramientas de precisión para verificar estabilidad.',
  },
  {
    title: 'Inspección física microscópica',
    desc: 'Buscamos óxido, sulfatación por humedad de Cancún, transistores quemados, capacitores inflados y pistas abiertas.',
  },
  {
    title: 'Prueba individual de componentes',
    desc: 'Desmontamos el equipo y probamos procesador, RAM, GPU y discos por separado en nuestro banco de pruebas controlado.',
  },
  {
    title: 'Revisión lógica y compatibilidad',
    desc: 'Verificamos la integridad de la BIOS/UEFI, la pila de CMOS, y que no existan incompatibilidades físicas o eléctricas.',
  },
  {
    title: 'Recomendación honesta',
    desc: 'Te explicamos el diagnóstico final y te damos opciones claras: reparar tu componente, cambiarlo o no invertir más si no conviene.',
  },
];

const processSteps = [
  { num: '01', title: 'Recepción y síntoma', desc: 'Registramos el estado físico de tu PC y los síntomas que observaste.' },
  { num: '02', title: 'Prueba de energía', desc: 'Evaluamos el cableado y descartamos fallos básicos de la toma eléctrica o fuente.' },
  { num: '03', title: 'Diagnóstico profundo', desc: 'Desarmamos e inspeccionamos placa, RAM, GPU, cortocircuitos y sulfato.' },
  { num: '04', title: 'Cotización clara', desc: 'Te enviamos por WhatsApp la causa y el costo total de reparación para tu aprobación.' },
  { num: '05', title: 'Pruebas de estabilidad', desc: 'Sometemos tu PC a estrés térmico y eléctrico durante horas antes de avisarte.' },
  { num: '06', title: 'Entrega con explicación', desc: 'Te entregamos tu PC reparada con un reporte detallado y recomendaciones locales.' },
];

const compatibilityList = [
  { type: 'PC Gamer', desc: 'Equipos de alto rendimiento ensamblados, refrigeración líquida, GPUs potentes y fuentes certificadas.' },
  { type: 'PC de Oficina', desc: 'Computadoras corporativas compactas, estaciones de trabajo y equipos para tareas administrativas.' },
  { type: 'PC Ensamblada', desc: 'Equipos personalizados y armados a la medida de cualquier marca o configuración.' },
  { type: 'Workstation', desc: 'Estaciones de trabajo profesionales para diseño, renderizado, arquitectura y edición de video.' },
  { type: 'Mini PC', desc: 'Equipos ultracompactos tipo Intel NUC, ASUS PN o similares que requieren micro-componentes.' },
  { type: 'Marcas Comunes', desc: 'Soporte y refacciones compatibles con HP, Dell, Lenovo, Acer, Asus, MSI, Gigabyte y más.' },
];

const risks = [
  {
    title: 'No insistas si huele a quemado',
    desc: 'El olor a quemado indica un corto activo. Intentar encenderla nuevamente puede propagar el daño al procesador o discos.',
  },
  {
    title: 'Evita cables y extensiones dudosas',
    desc: 'Un cable de corriente delgado o un regulador de voltaje en mal estado puede provocar variaciones severas de voltaje.',
  },
  {
    title: 'No abras el equipo sin herramienta antiestática',
    desc: 'La electricidad estática de tus manos puede dañar componentes sensibles como la memoria RAM o el procesador de forma permanente.',
  },
  {
    title: 'No formatees si hay información importante',
    desc: 'Si la PC no enciende, tus archivos siguen intactos en el disco. No permitas que reinstalen Windows sin antes respaldar.',
  },
  {
    title: 'No compres refacciones antes del diagnóstico',
    desc: 'Comprar una fuente nueva creyendo que es la falla puede ser un gasto inútil si el cortocircuito real está en la tarjeta madre.',
  },
];

const relatedServices = [
  { title: 'Fuente de poder PC', desc: 'Diagnóstico de voltajes, reemplazo e instalación de fuentes de poder ATX certificadas.', link: '/servicios/pc/fuente-poder' },
  { title: 'Tarjeta madre PC', desc: 'Diagnóstico de cortos, BIOS corrupta, VRMs y fallas eléctricas en motherboards.', link: '/servicios/pc/tarjeta-madre' },
  { title: 'Diagnóstico de PC', desc: 'Revisión completa de hardware y software para todo tipo de fallas intermitentes.', link: '/servicios/pc/diagnostico' },
  { title: 'Recuperación de datos', desc: 'Extracción segura de archivos y documentos de discos cuyo equipo ya no arranca.', link: '/servicios/pc/recuperacion-datos' },
  { title: 'Reparación general', desc: 'Soporte técnico integral y correctivo para computadoras de escritorio y laptops.', link: '/reparaciones' },
  { title: 'Ensambles PC Gamer', desc: 'Diseño, ensamble, optimización y actualización de hardware gaming y workstations.', link: '/ensambles' },
  { title: 'Mantenimiento preventivo', desc: 'Limpieza profunda de polvo, flujo de aire y revisión técnica de PC.', link: '/mantenimiento-preventivo-computadora' },
  { title: 'Mantenimiento correctivo', desc: 'Corrección de fallas críticas de hardware, reemplazo de piezas y reinstalación.', link: '/servicios/pc/mantenimiento-correctivo' },
];

const faqItems = [
  { question: '¿Cuánto cuesta revisar una PC que no enciende en Cancún?', answer: 'El diagnóstico inicial en nuestro taller es gratis. Si decides realizar la reparación con nosotros, te presentaremos un presupuesto claro que incluye la pieza y la mano de obra a partir de $650 MXN.' },
  { question: '¿El diagnóstico es gratis?', answer: 'Sí, el diagnóstico básico en nuestro taller es completamente gratis y sin compromiso. Para fallas complejas que requieren pruebas de laboratorio de varias horas, te informaremos antes de realizar cualquier procedimiento avanzado.' },
  { question: '¿Qué pasa si mi PC prende ventiladores pero no da imagen?', answer: 'Este síntoma suele deberse a un problema con la memoria RAM, la tarjeta de video (GPU), una BIOS corrupta o fallas en las fases de alimentación de la tarjeta madre. Realizamos pruebas cruzadas para aislar el componente defectuoso.' },
  { question: '¿Puede ser la fuente de poder?', answer: 'Sí, es muy común. Si la fuente de poder sufrió una descarga por apagones en Cancún, puede entregar voltajes incorrectos: suficientes para encender ventiladores o LEDs, pero no para iniciar el procesador.' },
  { question: '¿Puede ser la tarjeta madre?', answer: 'Sí, la tarjeta madre coordina todo. Fallas por humedad, salitre local o cortocircuitos en los transistores VRM pueden impedir el arranque. En Pixon PC diagnosticamos si la placa tiene reparación a nivel componente o si requiere reemplazo.' },
  { question: '¿Puedo llevar una PC gamer ensamblada?', answer: 'Por supuesto. Somos especialistas en hardware de alto rendimiento. Revisamos PC gamer ensambladas por piezas, workstations, equipos de oficina y Mini PCs de cualquier marca.' },
  { question: '¿Pierdo mis archivos?', answer: 'No. Al revisar fallas de encendido no tocamos tus discos de almacenamiento. Tus datos están completamente seguros. Si detectamos que el almacenamiento está en riesgo, te avisamos para realizar un respaldo inmediato.' },
  { question: '¿Me dicen si conviene reparar o comprar otra PC?', answer: 'Sí, siempre actuamos con honestidad. Evaluamos el costo de las refacciones, la antigüedad de tu PC y tus necesidades. Si el costo de reparación se acerca al valor del equipo, te recomendaremos no invertir más.' },
  { question: '¿Dan garantía?', answer: 'Sí, entregamos garantía por escrito sobre la reparación realizada (mano de obra y refacciones instaladas). La garantía no cubre descargas eléctricas posteriores, humedad o problemas ajenos a la intervención.' },
  { question: '¿Atienden con cita previa?', answer: 'Sí, atendemos de Lunes a Domingo exclusivamente con cita previa para garantizarte una atención personalizada y sin esperas. Puedes agendar tu espacio por WhatsApp o a través de nuestro formulario de tickets.' },
];
---

<div class="pcno-page">
  <!-- 1. Hero principal (Premium Dark) -->
  <section class="pcno-hero" aria-label="Introducción al servicio">
    <div class="pcno-shell pcno-hero-grid">
      <div class="pcno-hero-copy">
        <span class="pcno-kicker"><i class="fa-solid fa-location-dot"></i> Servicio Local en Cancún</span>
        <h1>PC no enciende en Cancún</h1>
        <h2>Reparación y diagnóstico profesional para computadoras que no dan video, no prenden luces o se apagan al instante.</h2>
        <p class="pcno-lead">
          Antes de comprar refacciones o cambiar la tarjeta madre, visítanos. Identificamos si tu equipo tiene un corto reparable, fallo en la fuente de poder o memoria RAM con pruebas reales de laboratorio.
        </p>

        <!-- Datos clave rápidos -->
        <div class="pcno-specs-grid">
          <div class="pcno-spec-item">
            <i class="fa-solid fa-tag"></i>
            <div>
              <span>Precio</span>
              <strong>Desde $650 MXN</strong>
            </div>
          </div>
          <div class="pcno-spec-item">
            <i class="fa-solid fa-clock"></i>
            <div>
              <span>Tiempo estimado</span>
              <strong>24 - 72 horas</strong>
            </div>
          </div>
          <div class="pcno-spec-item">
            <i class="fa-solid fa-file-shield"></i>
            <div>
              <span>Garantía</span>
              <strong>Por escrito por reparación</strong>
            </div>
          </div>
        </div>

        <div class="pcno-hero-actions">
          <a href={`https://wa.me/529986690777?text=${whatsappText}`} class="pcno-btn pcno-btn-primary" onclick="smartWaRedirect(this.href); return false;">
            <i class="fa-brands fa-whatsapp"></i> Hablar con un Técnico
          </a>
          <a href="#ticket-pc-no-enciende" class="pcno-btn pcno-btn-soft">
            <i class="fa-solid fa-ticket"></i> Crear Ticket de Servicio
          </a>
        </div>

        <!-- Cobertura Chips -->
        <div class="pcno-hero-zones">
          <span>Zonas de atención con cita:</span>
          <div class="pcno-zone-chips">
            <span class="pcno-chip">Cancún Centro</span>
            <span class="pcno-chip">Zona Hotelera</span>
            <span class="pcno-chip">Huayacán</span>
            <span class="pcno-chip">Cumbres</span>
            <span class="pcno-chip">Bonfil</span>
            <span class="pcno-chip">Puerto Cancún</span>
          </div>
        </div>
      </div>

      <!-- Tarjeta destacada lateral -->
      <div class="pcno-hero-visual">
        <div class="pcno-highlight-card">
          <div class="pcno-card-header">
            <span class="pcno-pulse"></span>
            <h3>Diagnóstico antes de cambiar piezas</h3>
          </div>
          <p>
            Muchos técnicos recomiendan comprar una tarjeta madre nueva al primer intento fallido. En <strong>Pixon PC</strong> probamos cada fase de poder, descartamos periféricos y medimos componentes para reparar antes de reemplazar.
          </p>
          <div class="pcno-card-img-wrap">
            <img src="/assets/images/mantenimiento-pc-escritorio.webp" alt="Diagnóstico técnico de computadora que no enciende en Cancún" loading="eager" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Bloque de síntomas comunes -->
  <section class="pcno-section pcno-bg-light">
    <div class="pcno-shell">
      <div class="pcno-section-head">
        <span>Señales de Falla</span>
        <h2>Síntomas comunes cuando una PC no enciende</h2>
        <p>Identifica el comportamiento de tu computadora para orientar el diagnóstico preliminar.</p>
      </div>

      <div class="pcno-symptoms-grid">
        {symptoms.map((item) => (
          <div class="pcno-symptom-card">
            <div class="pcno-symptom-icon">
              <i class={`fa-solid ${item.icon}`}></i>
            </div>
            <h3>{item.title}</h3>
            <p class="pcno-symptom-cause"><strong>Posible Causa:</strong> {item.cause}</p>
            <p class="pcno-symptom-rec"><strong>Recomendación:</strong> {item.recommendation}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Diagnóstico Técnico -->
  <section class="pcno-section pcno-bg-dark">
    <div class="pcno-shell pcno-split-grid">
      <div class="pcno-split-content">
        <span class="pcno-eyebrow">Seguridad de Hardware</span>
        <h2>No cambiamos piezas sin confirmar la falla</h2>
        <p>
          Revisamos minuciosamente la fuente de poder, botón de encendido, placa madre, módulos de memoria RAM, tarjeta gráfica (GPU), almacenamiento, cableado interno, la BIOS/UEFI, disipación, temperaturas de reposo, y cortocircuitos eléctricos.
        </p>
        <p>
          Nuestro proceso asegura que solo compres lo que realmente necesitas, evitando gastos adivinatorios en refacciones que no resolverán el problema.
        </p>
        <div class="pcno-badge-trust">
          <i class="fa-solid fa-circle-check"></i>
          <span>Atención profesional con cita previa en Cancún.</span>
        </div>
      </div>

      <div class="pcno-checklist-card">
        <h3>Protocolo de Diagnóstico</h3>
        <ul class="pcno-checklist">
          {diagnosticSteps.map((step) => (
            <li>
              <div class="pcno-check-circle"><i class="fa-solid fa-check"></i></div>
              <div>
                <h4>{step.title}</h4>
                <p>{step.desc}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 4. Proceso de trabajo -->
  <section class="pcno-section">
    <div class="pcno-shell">
      <div class="pcno-section-head">
        <span>Metodología</span>
        <h2>Nuestro proceso de trabajo</h2>
        <p>Paso a paso técnico transparente desde que recibimos tu PC hasta que vuelve a funcionar.</p>
      </div>

      <div class="pcno-process-grid">
        {processSteps.map((step) => (
          <div class="pcno-process-card">
            <span class="pcno-process-number">{step.num}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Formulario de ticket -->
  <div class="pcno-ticket-wrapper">
    <ServiceTicketSection
      id="ticket-pc-no-enciende"
      defaultDevice="PC de escritorio"
      defaultService="PC no enciende"
      title="Crear ticket para PC que no enciende"
      subtitle="Cuéntanos qué pasó, desde cuándo falla y si hubo apagón, humedad, golpe, reparación previa o cambio de piezas. Tu cita queda pendiente de confirmación."
    />
  </div>

  <!-- 6. Compatibilidad -->
  <section class="pcno-section pcno-bg-light">
    <div class="pcno-shell">
      <div class="pcno-section-head">
        <span>Soporte</span>
        <h2>Compatibilidad y equipos soportados</h2>
        <p>Reparamos computadoras de todas las gamas y marcas comerciales del mercado.</p>
      </div>

      <div class="pcno-compat-grid">
        {compatibilityList.map((item) => (
          <div class="pcno-compat-card">
            <h3>{item.type}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
      <p class="pcno-compat-note">
        <i class="fa-solid fa-circle-info"></i> Si tu modelo o tipo de equipo no aparece en la lista, podemos revisarlo con cita previa.
      </p>
    </div>
  </section>

  <!-- 7. Riesgos y recomendaciones -->
  <section class="pcno-section">
    <div class="pcno-shell">
      <div class="pcno-section-head">
        <span>Prevención</span>
        <h2>Riesgos y recomendaciones críticas</h2>
        <p>Sigue estas pautas para proteger tu equipo y la integridad de tu información.</p>
      </div>

      <div class="pcno-risks-grid">
        {risks.map((item) => (
          <div class="pcno-risk-card">
            <div class="pcno-risk-header">
              <i class="fa-solid fa-triangle-exclamation"></i>
              <h3>{item.title}</h3>
            </div>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Garantía y cobertura -->
  <section class="pcno-section pcno-bg-dark">
    <div class="pcno-shell">
      <div class="pcno-section-head pcno-text-white">
        <span>Respaldo</span>
        <h2>Garantía real y cobertura de servicio</h2>
        <p>Trabajamos con lineamientos de calidad rigurosos para ofrecerte tranquilidad total.</p>
      </div>

      <div class="pcno-warranty-grid">
        <div class="pcno-warranty-card">
          <i class="fa-solid fa-file-signature"></i>
          <h3>Garantía por Escrito</h3>
          <p>Te entregamos un reporte detallado con garantía específica sobre la intervención realizada (mano de obra y componentes instalados).</p>
        </div>
        <div class="pcno-warranty-card">
          <i class="fa-solid fa-vial-circle-check"></i>
          <h3>Pruebas de Arranque</h3>
          <p>Realizamos pruebas de estabilidad eléctrica, arranque continuo y control térmico antes de entregarte el equipo para certificar su estado.</p>
        </div>
        <div class="pcno-warranty-card">
          <i class="fa-solid fa-magnifying-glass-chart"></i>
          <h3>Diagnóstico Detallado</h3>
          <p>Te explicamos de forma sencilla si la falla viene de la placa lógica, humedad ambiental, o factores de carga externa.</p>
        </div>
        <div class="pcno-warranty-card">
          <i class="fa-solid fa-user-clock"></i>
          <h3>Atención con Cita Previa</h3>
          <p>Agendamos tu visita de forma organizada para brindarte un servicio personalizado, eficiente y sin pérdidas de tiempo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Bloque local Cancún -->
  <section class="pcno-section pcno-local-block">
    <div class="pcno-shell pcno-local-inner">
      <div class="pcno-local-copy">
        <span class="pcno-eyebrow">Clima y Entorno</span>
        <h2>Reparación de PC pensada para el uso real en Cancún</h2>
        <p>
          El calor extremo de Quintana Roo, la humedad tropical constante, el polvo ambiental acumulado por ventanas abiertas, el salitre costero y las variaciones de voltaje constantes por tormentas o fallas en la red eléctrica son los peores enemigos del hardware.
        </p>
        <p>
          Estos factores aceleran la degradación de las fuentes de poder, sulfatan los conectores de la tarjeta madre y resecan la pasta térmica del CPU provocando cortocircuitos. En Pixon PC diseñamos soluciones adaptadas a estas condiciones locales.
        </p>
      </div>

      <div class="pcno-local-zones">
        <h3>Área de cobertura en Cancún</h3>
        <p>Atendemos con cita previa a clientes de las siguientes zonas y alrededores:</p>
        <div class="pcno-zones-grid">
          <span><i class="fa-solid fa-location-dot"></i> Zona Hotelera</span>
          <span><i class="fa-solid fa-location-dot"></i> Cancún Centro</span>
          <span><i class="fa-solid fa-location-dot"></i> Av. Tulum</span>
          <span><i class="fa-solid fa-location-dot"></i> Bonampak</span>
          <span><i class="fa-solid fa-location-dot"></i> Puerto Cancún</span>
          <span><i class="fa-solid fa-location-dot"></i> Cumbres</span>
          <span><i class="fa-solid fa-location-dot"></i> Huayacán</span>
          <span><i class="fa-solid fa-location-dot"></i> Bonfil</span>
          <span><i class="fa-solid fa-location-dot"></i> Aeropuerto</span>
          <span><i class="fa-solid fa-location-dot"></i> Parque Industrial</span>
          <span><i class="fa-solid fa-location-dot"></i> Polígono Sur</span>
          <span><i class="fa-solid fa-location-dot"></i> Puerto Juárez</span>
          <span><i class="fa-solid fa-location-dot"></i> Haciendas</span>
          <span><i class="fa-solid fa-location-dot"></i> Supermanzanas</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 10. Servicios relacionados -->
  <section class="pcno-section pcno-bg-light">
    <div class="pcno-shell">
      <div class="pcno-section-head">
        <span>Otros Servicios</span>
        <h2>Servicios técnicos relacionados en Cancún</h2>
        <p>Soluciones complementarias de hardware y software para computadoras y laptops.</p>
      </div>

      <div class="pcno-related-grid">
        {relatedServices.map((item) => (
          <div class="pcno-related-card">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
            <a href={item.link} class="pcno-related-link">Ver servicio <i class="fa-solid fa-arrow-right"></i></a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 11. Preguntas frecuentes (FAQ) -->
  <FaqSection
    id="faq-pc-no-enciende"
    title="Preguntas frecuentes sobre PC que no encienden en Cancún"
    description="Respuestas técnicas y comerciales a las dudas más comunes sobre computadoras que no prenden."
    items={faqItems}
    backgroundColor="#0b1329"
    titleColor="#ffffff"
    descriptionColor="#94a3b8"
    questionColor="#080e1e"
    faqAccent="#f59e0b"
  />

