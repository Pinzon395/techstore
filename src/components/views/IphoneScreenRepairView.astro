<!-- ═════════════════════════════════════════════════════════════════════════
     SCRIPTS DE MICROINTERACCIÓN & TELEMETRÍA SEGURA (SIN PII)
═════════════════════════════════════════════════════════════════════════ -->
<script is:inline>
  (function () {
    // 1. Simulación de fractura en Hero (Play once)
    const phoneDemo = document.getElementById('isr-phone-demo');
    const replayBtn = document.getElementById('isr-replay-btn');

    if (phoneDemo) {
      // Activar fractura tras 250ms de carga
      setTimeout(() => {
        phoneDemo.classList.add('isr-phone--cracked');
      }, 250);

      if (replayBtn) {
        replayBtn.addEventListener('click', () => {
          phoneDemo.classList.remove('isr-phone--cracked');
          void phoneDemo.offsetWidth; // Forzar reflow
          setTimeout(() => {
            phoneDemo.classList.add('isr-phone--cracked');
          }, 80);
        });
      }
    }

    // 2. Telemetría segura sin PII hacia endpoint /api/track/event si existe
    function trackEvent(name, data = {}) {
      try {
        if (navigator.sendBeacon) {
          navigator.sendBeacon('/api/track/event', JSON.stringify({ event: name, ...data }));
        }
      } catch (_) {}
    }

    // Rastrear clicks en acciones clave
    document.querySelectorAll('.isr-track-action').forEach((el) => {
      el.addEventListener('click', () => {
        const action = el.getAttribute('data-action') || 'iphone_screen_click';
        const model = el.getAttribute('data-model') || undefined;
        trackEvent(action, { model });
      });
    });

    // 3. Section Reach Observer
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.target.id) {
            trackEvent('section_reach', { sectionId: entry.target.id });
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.3 });

      const sections = ['hero', 'opciones-pantalla', 'sintomas-falla', 'modelos-cotizar', 'faq-pantalla-iphone'];
      sections.forEach((id) => {
        const el = document.getElementById(id);
        if (el) observer.observe(el);
      });
    }
  })();
</script>

