---
// IphoneScreenRepairView.astro — Reparación de pantalla iPhone en Cancún
// SEO local premium | Pixon PC
const { service, category } = Astro.props;

import FaqSection from '../FaqSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import Footer from '../Footer.astro';

const waMsg = encodeURIComponent('Hola, quiero cotizar reparación de pantalla de iPhone en Cancún. Puedo enviar modelo y foto del daño.');
const iphoneScreenVideoId = '1k70SHGLxuc';

const sintomas = [
  { icon: 'fa-display', title: 'Pantalla negra', desc: 'Enciende, vibra o hace sonidos pero no muestra imagen.', urgent: false },
  { icon: 'fa-hand-pointer', title: 'Touch no responde', desc: 'La pantalla no detecta toques o tiene zonas muertas.', urgent: false },
  { icon: 'fa-bolt', title: 'Líneas o manchas', desc: 'Aparecen líneas verticales, manchas tipo tinta o parpadeos.', urgent: false },
  { icon: 'fa-mobile-screen', title: 'Cristal estrellado', desc: 'El cristal está quebrado, aunque la imagen todavía funcione.', urgent: false },
  { icon: 'fa-droplet', title: 'Daño por humedad', desc: 'El iPhone se mojó y la pantalla parpadea, se mancha o falla por zonas.', urgent: true },
  { icon: 'fa-sun', title: 'Brillo o colores incorrectos', desc: 'Colores apagados, brillo irregular o tonalidad diferente a la original.', urgent: false },
  { icon: 'fa-camera', title: 'Cámara frontal o sensores fallando', desc: 'Después de una caída pueden fallar cámara frontal, proximidad o desbloqueo facial.', urgent: false },
];

const modelos = [
  'iPhone 16 Pro Max', 'iPhone 16 Pro', 'iPhone 16 Plus', 'iPhone 16',
  'iPhone 15 Pro Max', 'iPhone 15 Pro', 'iPhone 15 Plus', 'iPhone 15',
  'iPhone 14 Pro Max', 'iPhone 14 Pro', 'iPhone 14 Plus', 'iPhone 14',
  'iPhone 13 Pro Max', 'iPhone 13 Pro', 'iPhone 13 Mini', 'iPhone 13',
  'iPhone 12 Pro Max', 'iPhone 12 Pro', 'iPhone 12 Mini', 'iPhone 12',
  'iPhone 11 Pro Max', 'iPhone 11 Pro', 'iPhone 11',
  'iPhone XS Max', 'iPhone XS', 'iPhone XR',
];

const proceso = [
  { step: '01', icon: 'fa-stethoscope', title: 'Recepción y revisión inicial', desc: 'Confirmamos modelo exacto, daño visible, estado del frame, touch, cámara frontal y señales de humedad.' },
  { step: '02', icon: 'fa-droplet', title: 'Revisión de humedad', desc: 'Inspeccionamos indicadores LCI y conectores antes de abrir o instalar cualquier pantalla.' },
  { step: '03', icon: 'fa-tag', title: 'Opciones de pantalla', desc: 'Te explicamos disponibilidad real: OLED original, OLED OEM o Incell, con diferencias de brillo, color y costo.' },
  { step: '04', icon: 'fa-screwdriver-wrench', title: 'Instalación controlada', desc: 'Abrimos con herramienta adecuada, respetamos flex, cámara frontal, sensores y colocamos adhesivo nuevo.' },
  { step: '05', icon: 'fa-magnifying-glass', title: 'Pruebas de uso real', desc: 'Probamos touch en toda la pantalla, brillo, colores, cámara frontal, llamada, audio y sensor de proximidad.' },
  { step: '06', icon: 'fa-shield-halved', title: 'Entrega documentada', desc: 'Te entregamos el equipo probado, con recomendación de cuidado y garantía por escrito sobre la pantalla instalada.' },
];

const tiposPantalla = [
  {
    tipo: 'OLED Original',
    calidad: 'La mejor',
    desc: 'La opción de mayor calidad cuando está disponible. Conserva mejor brillo, color, respuesta táctil y experiencia visual.',
    ideal: 'Quienes buscan la experiencia más cercana a fábrica.',
    points: ['Mejor brillo y color', 'Mejor experiencia táctil', 'Recomendada para modelos Pro', 'Mayor costo'],
    quality: 5,
    price: 5,
    color: '#22c55e',
  },
  {
    tipo: 'OLED OEM / Refurbished',
    calidad: 'Muy buena',
    desc: 'Opción equilibrada para mantener calidad alta con buen balance entre precio, colores y rendimiento.',
    ideal: 'Usuarios que quieren buena calidad sin irse al precio más alto.',
    points: ['Buena calidad de imagen', 'Buen touch', 'Mejor costo que original', 'Disponible según modelo'],
    quality: 4,
    price: 3,
    color: '#3b82f6',
  },
  {
    tipo: 'Incell LCD',
    calidad: 'Económica',
    desc: 'Opción accesible para modelos compatibles. Funciona bien para uso diario, aunque con menor brillo y contraste que OLED.',
    ideal: 'Quienes buscan reparar sin gastar demasiado.',
    points: ['Precio más accesible', 'Touch funcional', 'Buena para uso básico', 'Menor contraste que OLED'],
    quality: 3,
    price: 2,
    color: '#f59e0b',
  },
];

const faqItems = [
  { question: '¿Cuánto cuesta reparar la pantalla de un iPhone en Cancún?', answer: 'El costo depende del modelo de iPhone y del tipo de pantalla disponible: OLED original, OLED OEM o Incell. Te pedimos modelo y foto del daño para cotizar con más precisión antes de instalar.' },
  { question: '¿Cuánto tarda el cambio de pantalla?', answer: 'En muchos modelos el servicio puede realizarse en 1 a 2 horas en taller, siempre que la pantalla esté disponible y no exista daño adicional por humedad, frame doblado o conectores.' },
  { question: '¿Se conserva el desbloqueo facial después del cambio?', answer: 'Respetamos el módulo de sensores durante el proceso. Si el desbloqueo facial funcionaba antes y no existe daño previo por golpe, humedad o reparación anterior, se trabaja para conservarlo correctamente.' },
  { question: '¿Qué pasa si mi iPhone se mojó?', answer: 'Primero revisamos indicadores de humedad, conectores y estado interno. No recomendamos instalar pantalla nueva sin revisar líquido, porque la falla puede regresar o afectar otros componentes.' },
  { question: '¿Qué diferencia hay entre pantalla OLED original, OEM e Incell?', answer: 'La OLED original ofrece mejor brillo, colores y experiencia. La OLED OEM mantiene calidad alta con mejor costo. La Incell es más económica, pero con menor contraste y brillo.' },
  { question: '¿Dan garantía por la reparación?', answer: 'Sí, entregamos garantía por escrito sobre la pantalla instalada y la mano de obra, siempre que no exista daño posterior por golpe, humedad o manipulación externa.' },
];

const related = [
  { href: '/servicios/telefono/cambio-bateria-iphone', icon: 'fa-battery-half', label: 'Cambio de batería iPhone', desc: 'Si la batería drena rápido o el equipo se apaga, revisamos salud y capacidad real.' },
  { href: '/servicios/telefono/reparacion-carga-iphone', icon: 'fa-plug', label: 'Reparación de carga iPhone', desc: 'Puerto de carga, cable Lightning o USB-C que no conecta correctamente.' },
  { href: '/servicios/telefono/reparacion-face-id-iphone', icon: 'fa-face-smile', label: 'Revisión de sensores iPhone', desc: 'Desbloqueo facial, cámara frontal o proximidad tras caída o reparación previa.' },
  { href: '/servicios/telefono/reparacion-camara-iphone', icon: 'fa-camera', label: 'Reparación de cámara iPhone', desc: 'Cámara frontal o trasera con manchas, enfoque fallido o imagen oscura.' },
  { href: '/servicios/telefono/diagnostico-iphone', icon: 'fa-stethoscope', label: 'Diagnóstico iPhone', desc: 'Si no estás seguro de qué falla, primero revisamos y luego cotizamos.' },
  { href: '/servicios/telefono/reparacion-iphone', icon: 'fa-mobile-screen', label: 'Todos los servicios iPhone', desc: 'Pantalla, batería, carga, bocina, botones, humedad y más.' },
];
---

<div class="isr-wrapper">

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 1 · HERO
  ═══════════════════════════════════════════════ -->
  <section class="isr-hero">
    <div class="isr-hero-glow" aria-hidden="true"></div>
    <div class="isr-hero-grid-bg" aria-hidden="true"></div>
    <div class="container isr-hero-inner">

      <!-- Columna texto -->
      <div class="isr-hero-copy">
        <span class="isr-badge">
          <i class="fa-brands fa-apple"></i> Servicio técnico de iPhone en Cancún
        </span>
        <h1 class="isr-h1">
          Reparación de pantalla de iPhone en Cancún
        </h1>
        <p class="isr-sub">
          Cambio de display con diagnóstico y garantía por escrito
        </p>
        <p class="isr-copy">
          Pantalla estrellada, líneas, manchas, touch fallando o pantalla negra. Revisamos display, touch, frame y humedad antes de cambiar la pieza.
        </p>
        <p class="isr-copy isr-copy--secondary">
          Atendemos iPhone 11 al 16 Pro Max con opciones OLED original, OLED OEM o Incell según modelo y presupuesto.
        </p>

        <div class="isr-chips">
          <div class="isr-chip"><i class="fa-solid fa-magnifying-glass"></i> Diagnóstico antes de cotizar</div>
          <div class="isr-chip"><i class="fa-solid fa-face-smile"></i> Respetamos tus sensores</div>
          <div class="isr-chip isr-chip--green"><i class="fa-solid fa-shield-halved"></i> Garantía por escrito</div>
          <div class="isr-chip"><i class="fa-solid fa-stopwatch"></i> 1-2 horas en taller</div>
          <div class="isr-chip"><i class="fa-brands fa-apple"></i> iPhone 11 al 16 Pro Max</div>
          <div class="isr-chip"><i class="fa-solid fa-location-dot"></i> Servicio local en Cancún</div>
        </div>

        <div class="isr-trust-bar">
          <span><i class="fa-solid fa-star"></i> 5.0 en Google</span>
          <span><i class="fa-solid fa-location-dot"></i> Cancún, Q. Roo</span>
          <span><i class="fa-solid fa-clock"></i> Cita el mismo día</span>
        </div>

        <div class="isr-cta-group">
          <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="isr-btn-wa">
            <i class="fa-brands fa-whatsapp"></i> Cotizar pantalla por WhatsApp
          </a>
          <a href="#proceso" class="isr-btn-outline">
            Ver proceso <i class="fa-solid fa-arrow-down"></i>
          </a>
        </div>
        <p class="isr-micro">Envía modelo y foto del daño para darte una cotización más exacta.</p>
      </div>

      <!-- Columna visual: tarjeta de diagnóstico -->
      <div class="isr-hero-card-wrap">
        <div class="isr-hero-card">
          <div class="isr-card-header">
            <i class="fa-brands fa-apple"></i>
            <span>Diagnóstico de pantalla iPhone</span>
          </div>

          <div class="isr-phone-visual" aria-hidden="true">
            <div class="isr-phone-frame">
              <div class="isr-phone-notch"></div>
              <div class="isr-phone-screen">
                <div class="isr-crack isr-crack-a"></div>
                <div class="isr-crack isr-crack-b"></div>
                <div class="isr-crack isr-crack-c"></div>
                <div class="isr-screen-glow"></div>
              </div>
              <div class="isr-phone-home"></div>
            </div>
          </div>

          <ul class="isr-card-checks">
            <li><i class="fa-solid fa-circle-check"></i> Display, touch y brillo</li>
            <li><i class="fa-solid fa-circle-check"></i> Cámara frontal y sensores</li>
            <li><i class="fa-solid fa-circle-check"></i> Frame y conectores</li>
            <li><i class="fa-solid fa-circle-check"></i> Indicadores de humedad</li>
            <li><i class="fa-solid fa-circle-check"></i> OLED original</li>
            <li><i class="fa-solid fa-circle-check"></i> OLED OEM</li>
            <li><i class="fa-solid fa-circle-check"></i> Incell</li>
          </ul>

          <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="isr-card-cta">
            <i class="fa-brands fa-whatsapp"></i> Cotizar por modelo
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 2 · SÍNTOMAS
  ═══════════════════════════════════════════════ -->
  <section class="isr-sintomas">
    <div class="container">
      <div class="isr-section-head">
        <span class="isr-eyebrow"><i class="fa-solid fa-stethoscope"></i> Diagnóstico</span>
        <h2 class="isr-h2">¿Tu iPhone presenta alguno de estos síntomas?</h2>
        <p class="isr-desc">Muchos problemas de pantalla en iPhone tienen solución directa, pero algunos requieren revisar humedad, frame, conectores o sensores antes de instalar. Aquí identificamos qué aplica para tu caso.</p>
      </div>

      <div class="isr-sintomas-grid">
        {sintomas.map((s, i) => (
          <article class={`isr-sintoma-card${s.urgent ? ' isr-sintoma-card--urgent' : ''}`}>
            <div class="isr-sintoma-num">{String(i + 1).padStart(2, '0')}</div>
            <div class="isr-sintoma-icon">
              <i class={`fa-solid ${s.icon}`}></i>
            </div>
            <div class="isr-sintoma-body">
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              {s.urgent && <span class="isr-sintoma-urgent-tag"><i class="fa-solid fa-triangle-exclamation"></i> Atender antes de cargar</span>}
            </div>
          </article>
        ))}
        <div class="isr-sintoma-cta-card">
          <i class="fa-brands fa-apple"></i>
          <strong>¿Reconoces tu falla?</strong>
          <p>Envíanos el modelo y la descripción para cotizar sin compromiso.</p>
          <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-whatsapp"></i> Escribir ahora
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 3 · TIPOS DE PANTALLA
  ═══════════════════════════════════════════════ -->
  <section class="isr-tipos">
    <div class="container">
      <div class="isr-section-head">
        <span class="isr-eyebrow"><i class="fa-solid fa-layer-group"></i> Calidades disponibles</span>
        <h2 class="isr-h2">¿Qué tipo de pantalla se usa en la reparación?</h2>
        <p class="isr-desc">No todas las pantallas de iPhone son iguales. Te explicamos las opciones disponibles para que elijas según tu modelo, presupuesto y nivel de calidad que buscas.</p>
      </div>

      <div class="isr-tipos-panel" aria-label="Comparación de calidades de pantalla para iPhone">
        {tiposPantalla.map((t) => (
          <div class="isr-tipo-card" style={`--tipo-color: ${t.color}`}>
            <div class="isr-tipo-header">
              <div>
                <strong class="isr-tipo-name">{t.tipo}</strong>
                <span class="isr-tipo-label">Cambio de display iPhone Cancún</span>
              </div>
              <span class="isr-tipo-quality">{t.calidad}</span>
            </div>
            <p class="isr-tipo-desc">{t.desc}</p>
            <ul class="isr-tipo-points">
              {t.points.map((point) => (
                <li>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.4 11.4 2.9 7.9l1.4-1.4 2.1 2.1 5.3-5.3 1.4 1.4z"></path></svg>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
            <div class="isr-tipo-ideal">
              <span>Ideal para</span>
              <p>{t.ideal}</p>
            </div>
            <div class="isr-tipo-meters" aria-label={`Indicadores de calidad y precio para ${t.tipo}`}>
              <div>
                <span>Calidad</span>
                <meter min="0" max="5" value={t.quality}></meter>
              </div>
              <div>
                <span>Precio</span>
                <meter min="0" max="5" value={t.price}></meter>
              </div>
            </div>
          </div>
        ))}
      </div>

      <p class="isr-tipos-note">
        <i class="fa-solid fa-circle-info"></i>
        La disponibilidad depende del modelo. Te confirmamos opciones reales antes de cotizar pantalla OLED iPhone Cancún, pantalla iPhone original Cancún o reparación de pantalla iPhone en Cancún.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 4 · MODELOS ATENDIDOS
  ═══════════════════════════════════════════════ -->
  <section class="isr-modelos">
    <div class="container">
      <div class="isr-section-head">
        <span class="isr-eyebrow"><i class="fa-brands fa-apple"></i> Compatibilidad</span>
        <h2 class="isr-h2">Pantalla iPhone 11, 12, 13, 14, 15 y 16 en Cancún</h2>
        <p class="isr-desc">Atendemos pantalla iPhone rota en Cancún, cambio de display iPhone Cancún y reparación iPhone Cancún desde iPhone 11 hasta iPhone 16 Pro Max. Si tienes un modelo anterior, revisamos disponibilidad antes de cotizar.</p>
      </div>
      <div class="isr-modelos-grid">
        {modelos.map((m) => (
          <div class="isr-modelo-tag">
            <i class="fa-brands fa-apple"></i> {m}
          </div>
        ))}
      </div>
      <p class="isr-tipos-note">
        <i class="fa-solid fa-mobile-screen"></i>
        ¿No ves tu modelo? Escríbenos — también atendemos modelos anteriores según disponibilidad de pantalla.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 5 · PROCESO TÉCNICO
  ═══════════════════════════════════════════════ -->
  <section class="isr-proceso" id="proceso">
    <div class="container">
      <div class="isr-proceso-head">
        <div class="isr-proceso-copy">
          <span class="isr-eyebrow"><i class="fa-solid fa-list-check"></i> Proceso técnico</span>
          <h2 class="isr-h2">Proceso de cambio de pantalla de iPhone en Cancún</h2>
          <p class="isr-desc">Antes de instalar confirmamos modelo, daño real y tipo de display compatible. Así evitamos cambiar una pantalla cuando el problema viene de humedad, frame doblado, conector o una reparación previa.</p>
        </div>

        <div class="isr-proceso-tags" aria-label="Puntos técnicos del cambio de pantalla">
          <span><i class="fa-solid fa-droplet-slash"></i> Revisión de humedad</span>
          <span><i class="fa-solid fa-face-smile"></i> Cuidado de sensores</span>
          <span><i class="fa-solid fa-certificate"></i> Adhesivo nuevo</span>
          <span><i class="fa-solid fa-shield-halved"></i> Garantía incluida</span>
        </div>
      </div>

      <div class="isr-proceso-flow" aria-label="Flujo de servicio para cambio de pantalla de iPhone">
        <div class="isr-proceso-steps">
          {proceso.map((p) => (
            <article class="isr-step">
              <div class="isr-step-num">{p.step}</div>
              <div class="isr-step-body">
                <div class="isr-step-icon"><i class={`fa-solid ${p.icon}`}></i></div>
                <h3>{p.title}</h3>
                <p>{p.desc}</p>
              </div>
            </article>
          ))}
        </div>

        <div class="isr-proceso-proof">
          <div class="isr-proof-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M9.4 16.6 4.8 12l1.4-1.4 3.2 3.2 8.4-8.4 1.4 1.4z"></path></svg>
          </div>
          <div>
            <h3>No entregamos sin probar</h3>
            <p>Validamos touch, brillo, color, sensores, cámara frontal y funcionamiento general antes de avisarte por WhatsApp.</p>
          </div>
          <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="isr-proof-cta">
            <i class="fa-brands fa-whatsapp"></i> Cotizar cambio de pantalla
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 6 · TICKET DE SERVICIO
  ═══════════════════════════════════════════════ -->
  <ServiceTicketSection
    defaultDevice="iPhone"
    defaultService="Reparación de pantalla"
    title="Crear ticket de pantalla iPhone"
    subtitle="Cuéntanos el modelo y el daño. Te cotizamos la opción correcta sin compromiso."
  />

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 7 · VIDEO REAL
  ═══════════════════════════════════════════════ -->
  <section class="isr-galeria">
    <div class="container">
      <div class="isr-galeria-layout">
        <div class="isr-galeria-copy">
          <span class="isr-eyebrow"><i class="fa-solid fa-play"></i> Proceso en taller</span>
          <h2 class="isr-h2">Cambio de pantalla de iPhone 11 realizado por Pixon PC</h2>
          <p class="isr-desc">El video muestra un cambio de pantalla iPhone 11 Cancún desde el desmontaje hasta la prueba final. Se revisa que el módulo nuevo responda al tacto, conserve buen brillo, cierre correctamente con el frame y quede listo para uso diario.</p>

          <div class="isr-galeria-checks">
            <span><i class="fa-solid fa-hand-pointer"></i> Prueba de touch</span>
            <span><i class="fa-solid fa-sun"></i> Brillo y colores</span>
            <span><i class="fa-solid fa-camera"></i> Cámara frontal</span>
            <span><i class="fa-solid fa-face-smile"></i> Sensores si aplica</span>
            <span><i class="fa-solid fa-volume-high"></i> Audio y sensor de proximidad</span>
            <span><i class="fa-solid fa-clipboard-check"></i> Revisión antes de entregar</span>
          </div>

          <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="isr-btn-wa isr-btn-wa--sm">
            <i class="fa-brands fa-whatsapp"></i> Agendar revisión
          </a>
        </div>

        <div class="isr-video-card">
          <div class="isr-video-frame">
            <iframe
              src={`https://www.youtube.com/embed/${iphoneScreenVideoId}`}
              title="Cambio de pantalla de iPhone 11 en Cancún por Pixon PC"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
          <div class="isr-video-meta">
            <span><i class="fa-brands fa-youtube"></i> Proceso de taller Pixon PC</span>
            <strong>Cambio Pantalla iPhone 11</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 8 · POR QUÉ ELEGIRNOS
  ═══════════════════════════════════════════════ -->
  <section class="isr-porque">
    <div class="container">
      <div class="isr-section-head text-center">
        <span class="isr-eyebrow"><i class="fa-solid fa-award"></i> Diferencial</span>
        <h2 class="isr-h2">¿Por qué reparar tu pantalla de iPhone con Pixon PC Cancún?</h2>
        <p class="isr-desc">Una pantalla rota no siempre se resuelve solo cambiando el módulo. Revisamos el daño alrededor del display, el marco, conectores y señales de humedad para cotizar con claridad antes de abrir tu equipo.</p>
      </div>

      <div class="isr-porque-grid">
        <div class="isr-porque-card">
          <div class="isr-porque-icon"><i class="fa-solid fa-stethoscope"></i></div>
          <h3>Diagnóstico primero</h3>
          <p>Antes de abrir el iPhone revisamos display, touch, humedad, frame y sensores para saber exactamente qué necesitas.</p>
        </div>
        <div class="isr-porque-card">
