---
// IphoneScreenRepairView.astro — Reparación de pantalla iPhone en Cancún
// SEO local premium | Pixon PC
const { service, category } = Astro.props;

import FaqSection from '../FaqSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';

const waMsg = encodeURIComponent('Hola, quiero cotizar reparación de pantalla de iPhone en Cancún. Puedo enviar modelo y foto del daño.');

const sintomas = [
  { icon: 'fa-display', title: 'Pantalla negra', desc: 'Enciende, vibra o hace sonidos pero no muestra imagen.', urgent: false },
  { icon: 'fa-hand-pointer', title: 'Touch no responde', desc: 'La pantalla no detecta toques o tiene zonas muertas.', urgent: false },
  { icon: 'fa-bolt', title: 'Líneas o manchas', desc: 'Aparecen líneas verticales, manchas de tinta o parpadeos.', urgent: false },
  { icon: 'fa-mobile-screen', title: 'Cristal estrellado', desc: 'El cristal está quebrado, aunque display e imagen funcionen.', urgent: false },
  { icon: 'fa-droplet', title: 'Daño por humedad', desc: 'El iPhone se mojó y la pantalla parpadea o tiene manchas.', urgent: true },
  { icon: 'fa-sun', title: 'Brillo o colores mal', desc: 'Colores apagados, tonalidad amarillenta o brillo irregular.', urgent: false },
  { icon: 'fa-camera', title: 'Cámara frontal mal', desc: 'Sensor de proximidad o Face ID fallan tras caída.', urgent: false },
];

const modelos = [
  'iPhone 16 Pro Max', 'iPhone 16 Pro', 'iPhone 16 Plus', 'iPhone 16',
  'iPhone 15 Pro Max', 'iPhone 15 Pro', 'iPhone 15 Plus', 'iPhone 15',
  'iPhone 14 Pro Max', 'iPhone 14 Pro', 'iPhone 14 Plus', 'iPhone 14',
  'iPhone 13 Pro Max', 'iPhone 13 Pro', 'iPhone 13 Mini', 'iPhone 13',
  'iPhone 12 Pro Max', 'iPhone 12 Pro', 'iPhone 12 Mini', 'iPhone 12',
  'iPhone 11 Pro Max', 'iPhone 11 Pro', 'iPhone 11',
  'iPhone XS Max', 'iPhone XS', 'iPhone XR',
];

const proceso = [
  { step: '01', icon: 'fa-stethoscope', title: 'Diagnóstico visual', desc: 'Revisamos display, touch, frame, Face ID, cámara frontal y sensores de proximidad.' },
  { step: '02', icon: 'fa-droplet', title: 'Revisión de humedad', desc: 'Inspeccionamos indicadores LCI y conectores antes de abrir o instalar cualquier pantalla.' },
  { step: '03', icon: 'fa-tag', title: 'Cotización clara', desc: 'Confirmamos modelo, tipo de pantalla disponible (OLED original, OLED OEM, Incell) y precio final.' },
  { step: '04', icon: 'fa-screwdriver-wrench', title: 'Reemplazo con herramienta certificada', desc: 'Desmontaje seguro, sellado con adhesivo nuevo, correcta presión de pantalla y marcos.' },
  { step: '05', icon: 'fa-magnifying-glass', title: 'Pruebas post-instalación', desc: 'Verificamos touch, brillo, colores, Face ID, cámara frontal, proximidad y audio.' },
  { step: '06', icon: 'fa-shield-halved', title: 'Entrega con garantía', desc: 'Entregamos con garantía por escrito sobre la pantalla instalada y la mano de obra.' },
];

const tiposPantalla = [
  { tipo: 'OLED Original', calidad: 'La mejor', desc: 'Mismos colores, brillo máximo y respuesta táctil que de fábrica. Ideal para modelos Pro y Pro Max.', color: '#22c55e' },
  { tipo: 'OLED OEM / Refurbished', calidad: 'Muy buena', desc: 'Paneles OLED con calidad cercana al original, colores profundos y tacto preciso.', color: '#3b82f6' },
  { tipo: 'Incell LCD', calidad: 'Buena', desc: 'Opción económica para modelos compatibles. Touch preciso aunque brillo y contraste son menores que OLED.', color: '#f59e0b' },
];

const faqItems = [
  { question: '¿Cuánto cuesta reparar la pantalla de un iPhone en Cancún?', answer: 'El costo depende del modelo, el tipo de pantalla disponible (OLED original, OLED OEM o Incell) y si hay daño adicional en el frame o conectores. Antes de instalar te explicamos opciones y precios reales para que decidas con toda la información.' },
  { question: '¿Afecta el Face ID al cambiar la pantalla?', answer: 'El Face ID depende del módulo TrueDepth fijo en el frame, no en el panel mismo. Si el Face ID funciona antes del cambio y el técnico tiene el cuidado de no dañar el flex del sensor, debería quedar igual. En Pixon PC hacemos prueba de Face ID antes y después de instalar.' },
  { question: '¿Cuánto tarda el cambio de pantalla de iPhone?', answer: 'En la mayoría de modelos el reemplazo toma de 1 a 2 horas en taller. Si el equipo tiene daño adicional en frame, flex o humedad que requiera atención previa, te avisamos el tiempo real antes de comenzar.' },
  { question: '¿Qué pasa si el iPhone se cayó al agua antes de romperse?', answer: 'Si hubo contacto con agua, conviene revisar humedad, indicadores LCI y conectores antes de instalar una pantalla nueva. Cambiar pantalla sobre un iPhone con humedad interna puede causar que la nueva pantalla falle en poco tiempo.' },
  { question: '¿Qué diferencia hay entre pantalla original y OEM?', answer: 'La pantalla original de Apple ofrece los mismos colores, brillo máximo y tacto exacto que de fábrica. La OEM/refurbished usa panel OLED de calidad muy cercana con precio menor. La Incell es la opción más económica para modelos compatibles pero con brillo y contraste menores. Te explicamos cada opción según tu modelo.' },
  { question: '¿La reparación tiene garantía?', answer: 'Sí, entregamos garantía por escrito sobre la pantalla instalada y la mano de obra. No cubre nuevos golpes, caídas, presión excesiva sobre el display, humedad posterior o manipulación externa después de la entrega.' },
];

const related = [
  { href: '/servicios/telefono/cambio-bateria-iphone', icon: 'fa-battery-half', label: 'Cambio de batería iPhone', desc: 'Si la batería drena rápido o el equipo se apaga, revisamos salud y capacidad real.' },
  { href: '/servicios/telefono/reparacion-carga-iphone', icon: 'fa-plug', label: 'Reparación de carga iPhone', desc: 'Puerto de carga, cable Lightning o USB-C que no conecta correctamente.' },
  { href: '/servicios/telefono/reparacion-face-id-iphone', icon: 'fa-face-smile', label: 'Reparación de Face ID', desc: 'Face ID deja de funcionar tras caída o cambio previo de pantalla.' },
  { href: '/servicios/telefono/reparacion-camara-iphone', icon: 'fa-camera', label: 'Reparación de cámara iPhone', desc: 'Cámara frontal o trasera con manchas, enfoque fallido o imagen oscura.' },
  { href: '/servicios/telefono/diagnostico-iphone', icon: 'fa-stethoscope', label: 'Diagnóstico iPhone', desc: 'Si no estás seguro de qué falla, primero revisamos y luego cotizamos.' },
  { href: '/servicios/telefono/reparacion-iphone', icon: 'fa-mobile-screen', label: 'Todos los servicios iPhone', desc: 'Batería, Face ID, carga, bocina, botones, humedad y más.' },
];
---

<div class="isr-wrapper">

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 1 · HERO
  ═══════════════════════════════════════════════ -->
  <section class="isr-hero">
    <div class="isr-hero-glow" aria-hidden="true"></div>
    <div class="isr-hero-grid-bg" aria-hidden="true"></div>
    <div class="container isr-hero-inner">

      <!-- Columna texto -->
      <div class="isr-hero-copy">
        <span class="isr-badge">
          <i class="fa-brands fa-apple"></i> Servicio técnico de iPhone en Cancún
        </span>
        <h1 class="isr-h1">
          Reparación de pantalla de <span class="isr-gradient">iPhone en Cancún</span>
        </h1>
        <p class="isr-sub">
          Revisamos display, touch, Frame, Face ID y humedad antes de instalar cualquier pantalla nueva. Sin cambios a ciegas.
        </p>

        <div class="isr-chips">
          <div class="isr-chip"><i class="fa-solid fa-magnifying-glass"></i> Diagnóstico antes de cotizar</div>
          <div class="isr-chip"><i class="fa-solid fa-face-smile"></i> Face ID preservado</div>
          <div class="isr-chip isr-chip--green"><i class="fa-solid fa-shield-halved"></i> Garantía por escrito</div>
          <div class="isr-chip"><i class="fa-solid fa-stopwatch"></i> 1-2 horas en taller</div>
          <div class="isr-chip"><i class="fa-brands fa-apple"></i> iPhone 11 al 16 Pro Max</div>
        </div>

        <div class="isr-trust-bar">
          <span><i class="fa-solid fa-star"></i> 5.0 en Google</span>
          <span><i class="fa-solid fa-location-dot"></i> Cancún, Q. Roo</span>
          <span><i class="fa-solid fa-clock"></i> Cita el mismo día</span>
        </div>

        <div class="isr-cta-group">
          <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="isr-btn-wa">
            <i class="fa-brands fa-whatsapp"></i> Cotizar pantalla por WhatsApp
          </a>
          <a href="#proceso" class="isr-btn-outline">
            Ver proceso <i class="fa-solid fa-arrow-down"></i>
          </a>
        </div>
        <p class="isr-micro">Envía modelo y foto del daño para cotización exacta.</p>
      </div>

      <!-- Columna visual: tarjeta de diagnóstico -->
      <div class="isr-hero-card-wrap">
        <div class="isr-hero-card">
          <div class="isr-card-header">
            <i class="fa-brands fa-apple"></i>
            <span>Diagnóstico de pantalla iPhone</span>
          </div>

          <div class="isr-phone-visual" aria-hidden="true">
            <div class="isr-phone-frame">
              <div class="isr-phone-notch"></div>
              <div class="isr-phone-screen">
                <div class="isr-crack isr-crack-a"></div>
                <div class="isr-crack isr-crack-b"></div>
                <div class="isr-crack isr-crack-c"></div>
                <div class="isr-screen-glow"></div>
              </div>
              <div class="isr-phone-home"></div>
            </div>
          </div>

          <ul class="isr-card-checks">
            <li><i class="fa-solid fa-circle-check"></i> Display, touch y brillo</li>
            <li><i class="fa-solid fa-circle-check"></i> Face ID y cámara frontal</li>
            <li><i class="fa-solid fa-circle-check"></i> Frame y conectores</li>
            <li><i class="fa-solid fa-circle-check"></i> Indicadores de humedad</li>
          </ul>

          <div class="isr-card-types">
            <span class="isr-type isr-type--oled">OLED Original</span>
            <span class="isr-type isr-type--oem">OLED OEM</span>
            <span class="isr-type isr-type--incell">Incell</span>
          </div>

          <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="isr-card-cta">
            <i class="fa-brands fa-whatsapp"></i> Cotizar por modelo
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 2 · SÍNTOMAS
  ═══════════════════════════════════════════════ -->
  <section class="isr-sintomas">
    <div class="container">
      <div class="isr-section-head">
        <span class="isr-eyebrow"><i class="fa-solid fa-stethoscope"></i> Diagnóstico</span>
        <h2 class="isr-h2">¿Tu iPhone presenta alguno de estos síntomas?</h2>
        <p class="isr-desc">Muchos problemas de pantalla en iPhone tienen solución directa, pero algunos requieren revisar humedad, frame o conectores antes de instalar. Aquí identificamos qué aplica para tu caso.</p>
      </div>

      <div class="isr-sintomas-grid">
        {sintomas.map((s, i) => (
          <article class={`isr-sintoma-card${s.urgent ? ' isr-sintoma-card--urgent' : ''}`}>
            <div class="isr-sintoma-num">{String(i + 1).padStart(2, '0')}</div>
            <div class="isr-sintoma-icon">
              <i class={`fa-solid ${s.icon}`}></i>
            </div>
            <div class="isr-sintoma-body">
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              {s.urgent && <span class="isr-sintoma-urgent-tag"><i class="fa-solid fa-triangle-exclamation"></i> Atender antes de cargar</span>}
            </div>
          </article>
        ))}
        <div class="isr-sintoma-cta-card">
          <i class="fa-brands fa-apple"></i>
          <strong>¿Reconoces tu falla?</strong>
          <p>Envíanos el modelo y la descripción para cotizar sin compromiso.</p>
          <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-whatsapp"></i> Escribir ahora
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 3 · TIPOS DE PANTALLA
  ═══════════════════════════════════════════════ -->
  <section class="isr-tipos">
    <div class="container">
      <div class="isr-section-head">
        <span class="isr-eyebrow"><i class="fa-solid fa-layer-group"></i> Calidades disponibles</span>
        <h2 class="isr-h2">¿Qué tipo de pantalla se usa en la reparación?</h2>
        <p class="isr-desc">No todas las pantallas de iPhone son iguales. Te explicamos cada opción disponible para que decidas según tu presupuesto y exigencia.</p>
      </div>

      <div class="isr-tipos-grid">
        {tiposPantalla.map((t) => (
          <div class="isr-tipo-card" style={`--tipo-color: ${t.color}`}>
            <div class="isr-tipo-header">
              <strong class="isr-tipo-name">{t.tipo}</strong>
              <span class="isr-tipo-quality">{t.calidad}</span>
            </div>
            <p class="isr-tipo-desc">{t.desc}</p>
            <div class="isr-tipo-dot" aria-hidden="true"></div>
          </div>
        ))}
      </div>

      <p class="isr-tipos-note">
        <i class="fa-solid fa-circle-info"></i>
        La disponibilidad depende del modelo. Te confirmamos opciones reales antes de cotizar.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 4 · MODELOS ATENDIDOS
  ═══════════════════════════════════════════════ -->
  <section class="isr-modelos">
    <div class="container">
      <div class="isr-section-head">
        <span class="isr-eyebrow"><i class="fa-brands fa-apple"></i> Compatibilidad</span>
        <h2 class="isr-h2">Modelos de iPhone que atendemos en Cancún</h2>
        <p class="isr-desc">Desde iPhone 11 hasta el iPhone 16 Pro Max. Si tienes un modelo más antiguo, pregúntanos disponibilidad.</p>
      </div>
      <div class="isr-modelos-grid">
        {modelos.map((m) => (
          <div class="isr-modelo-tag">
            <i class="fa-brands fa-apple"></i> {m}
          </div>
        ))}
      </div>
      <p class="isr-tipos-note">
        <i class="fa-solid fa-mobile-screen"></i>
        ¿No ves tu modelo? Escríbenos — también atendemos modelos anteriores según disponibilidad de pantalla.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 5 · PROCESO TÉCNICO
  ═══════════════════════════════════════════════ -->
  <section class="isr-proceso" id="proceso">
    <div class="container">
      <div class="isr-proceso-layout">
        <div class="isr-proceso-copy">
          <span class="isr-eyebrow"><i class="fa-solid fa-list-check"></i> Proceso técnico</span>
          <h2 class="isr-h2">Así hacemos el cambio de pantalla de iPhone en Cancún</h2>
          <p class="isr-desc">No instalamos pantalla sin revisar primero. Cada iPhone pasa por diagnóstico real antes de abrir — así evitamos cambios que no resuelven la falla o daños adicionales durante el servicio.</p>

          <div class="isr-proceso-tags">
            <span><i class="fa-solid fa-droplet-slash"></i> Revisión de humedad</span>
            <span><i class="fa-solid fa-face-smile"></i> Face ID preservado</span>
            <span><i class="fa-solid fa-certificate"></i> Adhesivo nuevo</span>
            <span><i class="fa-solid fa-shield-check"></i> Garantía incluida</span>
          </div>

          <!-- Imagen contextual -->
          <div class="isr-proceso-img">
            <img
              src="/assets/images/responsive/reparacion-celulares-cancun.webp"
              srcset="/assets/images/responsive/reparacion-celulares-cancun-sm.webp 480w, /assets/images/responsive/reparacion-celulares-cancun-md.webp 768w, /assets/images/responsive/reparacion-celulares-cancun.webp 1200w"
              sizes="(max-width: 640px) 480px, (max-width: 1024px) 768px, 560px"
              alt="Técnico reparando pantalla de iPhone en Cancún en taller Pixon PC"
              loading="lazy"
              decoding="async"
            />
            <div class="isr-img-badge">
              <i class="fa-brands fa-apple"></i>
              <span>Reparación especializada iPhone · Cancún</span>
            </div>
          </div>
        </div>

        <div class="isr-proceso-steps">
          {proceso.map((p) => (
            <article class="isr-step">
              <div class="isr-step-num">{p.step}</div>
              <div class="isr-step-icon"><i class={`fa-solid ${p.icon}`}></i></div>
              <div class="isr-step-body">
                <h3>{p.title}</h3>
                <p>{p.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 6 · TICKET DE SERVICIO
  ═══════════════════════════════════════════════ -->
  <ServiceTicketSection
    defaultDevice="iPhone"
    defaultService="Reparación de pantalla"
    title="Crear ticket de pantalla iPhone"
    subtitle="Cuéntanos el modelo y el daño. Te cotizamos la opción correcta sin compromiso."
  />

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 7 · GALERÍA / ANTES Y DESPUÉS
  ═══════════════════════════════════════════════ -->
  <section class="isr-galeria">
    <div class="container">
      <div class="isr-galeria-layout">
        <div class="isr-galeria-copy">
          <span class="isr-eyebrow"><i class="fa-solid fa-images"></i> Proceso real</span>
          <h2 class="isr-h2">Cómo queda el iPhone tras la reparación de pantalla</h2>
          <p class="isr-desc">Después de instalar la pantalla hacemos pruebas completas: touch en toda la superficie, brillo al máximo, colores, Face ID, cámara frontal, proximidad y audio. No entregamos hasta validar todo.</p>

          <div class="isr-galeria-checks">
            <span><i class="fa-solid fa-hand-pointer"></i> Touch completo</span>
            <span><i class="fa-solid fa-sun"></i> Brillo y colores</span>
            <span><i class="fa-solid fa-face-smile"></i> Face ID funcional</span>
            <span><i class="fa-solid fa-camera"></i> Cámara frontal</span>
            <span><i class="fa-solid fa-volume-high"></i> Audio y auricular</span>
          </div>

          <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="isr-btn-wa isr-btn-wa--sm">
            <i class="fa-brands fa-whatsapp"></i> Agendar revisión
          </a>
        </div>

        <div class="isr-galeria-imgs">
          <div class="isr-galeria-main">
            <img
              src="/assets/images/responsive/servicio-celulares-cancun.webp"
              srcset="/assets/images/responsive/servicio-celulares-cancun-sm.webp 480w, /assets/images/responsive/servicio-celulares-cancun-md.webp 768w, /assets/images/responsive/servicio-celulares-cancun.webp 1200w"
              sizes="(max-width: 640px) 480px, (max-width: 1024px) 768px, 600px"
              alt="Pantalla de iPhone reparada en Cancún — taller Pixon PC"
              loading="lazy"
              decoding="async"
            />
            <div class="isr-galeria-label"><i class="fa-solid fa-circle-check"></i> Reparación completada</div>
          </div>
          <div class="isr-galeria-side">
            <div class="isr-galeria-item">
              <img
                src="/assets/images/responsive/reparacion-celulares-cancun.webp"
                alt="Revisión técnica de iPhone antes de reparar pantalla en Cancún"
                loading="lazy"
                decoding="async"
              />
              <span>Diagnóstico previo</span>
            </div>
            <div class="isr-galeria-item">
              <img
                src="/assets/images/responsive/servicio-celulares-cancun.webp"
                alt="iPhone con pantalla reparada y prueba de touch en Cancún"
                loading="lazy"
                decoding="async"
              />
              <span>Prueba final</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 8 · POR QUÉ ELEGIRNOS
  ═══════════════════════════════════════════════ -->
  <section class="isr-porque">
    <div class="container">
      <div class="isr-section-head text-center">
        <span class="isr-eyebrow"><i class="fa-solid fa-award"></i> Diferencial</span>
        <h2 class="isr-h2">¿Por qué confiar tu iPhone a Pixon PC Cancún?</h2>
        <p class="isr-desc">No instalamos pantallas sin diagnóstico. No prometemos lo que no podemos garantizar. Trabajamos con herramienta certificada, adhesivo nuevo, pruebas completas y garantía por escrito.</p>
      </div>

      <div class="isr-porque-grid">
        <div class="isr-porque-card">
          <div class="isr-porque-icon"><i class="fa-solid fa-stethoscope"></i></div>
          <h3>Diagnóstico primero</h3>
          <p>Antes de abrir el iPhone revisamos display, touch, humedad, frame y sensores para saber exactamente qué necesitas.</p>
        </div>
        <div class="isr-porque-card">
          <div class="isr-porque-icon"><i class="fa-solid fa-face-smile"></i></div>
          <h3>Face ID preservado</h3>
          <p>Cuidamos el módulo TrueDepth durante el proceso para que Face ID quede funcionando igual que antes.</p>
        </div>
        <div class="isr-porque-card">
          <div class="isr-porque-icon"><i class="fa-solid fa-layer-group"></i></div>
          <h3>Opciones de calidad reales</h3>
          <p>Te explicamos diferencia entre OLED original, OEM e Incell para que elijas según tu modelo y presupuesto.</p>
        </div>
        <div class="isr-porque-card">
          <div class="isr-porque-icon"><i class="fa-solid fa-shield-halved"></i></div>
          <h3>Garantía por escrito</h3>
          <p>Entregamos garantía sobre la pantalla instalada y la mano de obra. No son palabras, es un documento.</p>
        </div>
        <div class="isr-porque-card">
          <div class="isr-porque-icon"><i class="fa-solid fa-vial"></i></div>
          <h3>Pruebas antes de entregar</h3>
          <p>Touch, brillo, colores, Face ID, cámara frontal, sensor de proximidad y audio. Todo validado en taller.</p>
        </div>
        <div class="isr-porque-card">
          <div class="isr-porque-icon"><i class="fa-solid fa-location-dot"></i></div>
          <h3>Servicio local en Cancún</h3>
          <p>Taller físico en Cancún. Sin envíos de riesgo, sin tiempos de espera a distancia. Tu iPhone en manos locales.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 9 · SERVICIOS RELACIONADOS
  ═══════════════════════════════════════════════ -->
