---
// IphoneScreenRepairView.astro — Reparación de pantalla iPhone en Cancún
// SEO local extremo | Pixon PC
const { service, category } = Astro.props;

import FaqSection from '../FaqSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import Footer from '../Footer.astro';

const waMsg = encodeURIComponent('Hola, quiero cotizar reparación de pantalla de iPhone en Cancún. Puedo enviar modelo y foto del daño.');
const iphoneScreenVideoId = '1k70SHGLxuc';

// ── Síntomas con H3 individuales para SEO de intención ─────────────────────────
const sintomas = [
  {
    icon: 'fa-mobile-screen',
    h3: 'Pantalla rota o cristal estrellado',
    desc: 'El cristal frontal está quebrado, astillado o con fisuras visibles. Si el panel touch y la imagen aún responden, diagnosticamos si el impacto dañó las capas internas o el marco para evitar cortes o fallas progresivas.',
    urgent: false,
  },
  {
    icon: 'fa-display',
    h3: 'Pantalla negra pero el iPhone sigue encendido',
    desc: 'El iPhone vibra, recibe notificaciones o llamadas pero no da imagen. Suele deberse a un display OLED colapsado por impacto, desprendimiento de flex o corte en la línea de retroalimentación de pantalla.',
    urgent: false,
  },
  {
    icon: 'fa-hand-pointer',
    h3: 'Touch que no responde o tiene zonas muertas',
    desc: 'El touch no detecta el dedo, no abre apps, tiene toques fantasma (ghost touch) o franjas completas congeladas tras una caída. Evaluamos si el daño es del digitalizador del display o flex presionado.',
    urgent: false,
  },
  {
    icon: 'fa-bolt',
    h3: 'Líneas verdes, blancas o verticales en la pantalla',
    desc: 'Aparición de una línea verde fija, líneas blancas o franjas de colores que atraviesan la pantalla. Es el síntoma típico de daño físico en las pistas internas del panel OLED Super Retina tras una caída.',
    urgent: false,
  },
  {
    icon: 'fa-droplet',
    h3: 'Manchas negras, tinta o parpadeos',
    desc: 'Puntos negros oscuros que crecen como fuga de tinta líquida, parpadeos repentinos o brillo inestable. Ocurre por ruptura del panel OLED interno o filtración de humedad en conectores.',
    urgent: true,
  },
  {
    icon: 'fa-arrows-up-to-line',
    h3: 'Pantalla levantada o frame doblado',
    desc: 'El cristal se despega del marco, hay separación visible en las esquinas o el chasis de aluminio/acero está doblado. Revisamos si la batería está inflada o si el frame necesita enderezado antes de colocar la pantalla nueva.',
    urgent: true,
  },
];

// ── Modelos agrupados por generación con H3 ──────────────────────────────────
const modelosGeneraciones = [
  {
    h3: 'Pantalla iPhone 16, Plus, Pro y Pro Max',
    desc: 'Reparación y cambio de display para iPhone 16, 16 Plus, 16 Pro y 16 Pro Max con Dynamic Island y paneles Super Retina XDR OLED. Instalación milimétrica con sellado contra polvo y humedad.',
    tags: ['iPhone 16 Pro Max', 'iPhone 16 Pro', 'iPhone 16 Plus', 'iPhone 16'],
  },
  {
    h3: 'Pantalla iPhone 15, Plus, Pro y Pro Max',
    desc: 'Servicio para iPhone 15, 15 Plus, 15 Pro y 15 Pro Max con conector USB-C. Cuidado riguroso de sensores TrueDepth, marco de titanio en modelos Pro y prueba de respuesta táctil.',
    tags: ['iPhone 15 Pro Max', 'iPhone 15 Pro', 'iPhone 15 Plus', 'iPhone 15'],
  },
  {
    h3: 'Pantalla iPhone 14, Plus, Pro y Pro Max',
    desc: 'Solución para pantallas estrelladas y touch fantasma en iPhone 14, 14 Plus, 14 Pro y 14 Pro Max. Conservamos sensores superiores y calibración adecuada de brillo.',
    tags: ['iPhone 14 Pro Max', 'iPhone 14 Pro', 'iPhone 14 Plus', 'iPhone 14'],
  },
  {
    h3: 'Pantalla iPhone 13, Mini, Pro y Pro Max',
    desc: 'Cambio de pantalla para iPhone 13, 13 Mini, 13 Pro y 13 Pro Max. Atención especial al refresco ProMotion en modelos Pro y ajuste exacto en chasis compactos como el Mini.',
    tags: ['iPhone 13 Pro Max', 'iPhone 13 Pro', 'iPhone 13 Mini', 'iPhone 13'],
  },
  {
    h3: 'Pantalla iPhone 12, Mini, Pro y Pro Max',
    desc: 'Atención completa para iPhone 12, 12 Mini, 12 Pro y 12 Pro Max con cristal Ceramic Shield. Diagnóstico de líneas verdes y reemplazo de display con adhesivo térmico perimetral.',
    tags: ['iPhone 12 Pro Max', 'iPhone 12 Pro', 'iPhone 12 Mini', 'iPhone 12'],
  },
  {
    h3: 'Pantalla iPhone 11, 11 Pro y 11 Pro Max',
    desc: 'Opciones de pantalla LCD Liquid Retina para iPhone 11 y Super Retina OLED para iPhone 11 Pro y Pro Max. Excelente relación costo-beneficio con prueba inmediata en taller.',
    tags: ['iPhone 11 Pro Max', 'iPhone 11 Pro', 'iPhone 11'],
  },
  {
    h3: 'Pantalla iPhone XR, XS y XS Max',
    desc: 'Disponibilidad constante para generaciones iPhone XR, XS y XS Max. Recuperación de touch, eliminación de pantalla negra y entrega el mismo día.',
    tags: ['iPhone XS Max', 'iPhone XS', 'iPhone XR'],
  },
];

// ── Tipos de pantalla disponibles ─────────────────────────────────────────────
const tiposPantalla = [
  {
    tipo: 'OLED Original',
    calidad: 'Máxima fidelidad',
    desc: 'Panel idéntico al de fábrica. Mantiene brillo máximo bajo el sol de Cancún, contraste infinito, ángulos de visión perfectos y menor consumo de batería.',
    ideal: 'Para usuarios exigentes y modelos Pro que buscan conservar la experiencia nativa de Apple.',
    points: ['Brillo máximo y color original', 'Fluidez y respuesta táctil perfecta', 'Menor consumo de batería', 'Ajuste exacto al milímetro'],
    quality: 5,
    price: 5,
    color: '#22c55e',
  },
  {
    tipo: 'OLED OEM / Refurbished',
    calidad: 'Alta calidad equilibrada',
    desc: 'Módulo con panel OLED manufacturado con especificaciones idénticas o display original reacondicionado con cristal nuevo. Excelente balance entre rendimiento y presupuesto.',
    ideal: 'Quienes quieren tecnología OLED real y colores vívidos con un costo más accesible.',
    points: ['Negros puros y buen contraste', 'Excelente sensibilidad al touch', 'Costo más moderado que original', 'Garantía por escrito'],
    quality: 4,
    price: 3,
    color: '#3b82f6',
  },
  {
    tipo: 'Incell LCD',
    calidad: 'Opción económica funcional',
    desc: 'Tecnología LCD compacta con digitalizador integrado. Permite recuperar tu iPhone cuando necesitas una reparación económica para llamadas, WhatsApp y trabajo cotidiano.',
    ideal: 'Para presupuestos ajustados o equipos secundarios que requieren volver a funcionar.',
    points: ['El costo más bajo de cambio', 'Touch funcional para uso diario', 'Contraste y brillo menores a OLED', 'Mayor grosor milimétrico'],
    quality: 3,
    price: 2,
    color: '#f59e0b',
  },
];

// ── Proceso de cambio ──────────────────────────────────────────────────────────
const proceso = [
  {
    step: '01',
    icon: 'fa-stethoscope',
    title: 'Diagnóstico de pantalla, touch y humedad',
    desc: 'Evaluamos el estado físico del equipo, probamos touch, revisamos si hay esquinas sumidas en el marco y verificamos los sellos LCI contra humedad antes de desmontar.',
  },
  {
    step: '02',
    icon: 'fa-tag',
    title: 'Cotización según modelo y calidad',
    desc: 'Te explicamos los tipos de pantalla disponibles (OLED original, OEM o Incell) con precios exactos y transparentes. No se instala ninguna refacción sin tu previa confirmación y autorización.',
  },
  {
    step: '03',
    icon: 'fa-screwdriver-wrench',
    title: 'Instalación y adhesivo nuevo',
    desc: 'Desmontamos a temperatura controlada, transferimos con cuidado el flex de sensores superiores, limpiamos residuos viejos y colocamos sello adhesivo perimetral nuevo.',
  },
  {
    step: '04',
    icon: 'fa-magnifying-glass',
    title: 'Prueba de touch, brillo y sensores',
    desc: 'Comprobamos el touch en cada cuadrante de la pantalla, sensor de proximidad en llamada, cámara frontal, nivel de brillo y reproducción de colores antes de cerrar.',
  },
  {
    step: '05',
    icon: 'fa-shield-halved',
    title: 'Entrega y garantía por escrito',
    desc: 'Recibes tu iPhone totalmente probado y funcional, con recomendaciones para protegerlo del calor y salitre de Cancún, respaldado por garantía formal por escrito.',
  },
];

// ── FAQ ampliada SEO y reglas operativas ───────────────────────────────────────
const faqItems = [
  {
    question: '¿Cuánto cuesta cambiar la pantalla de un iPhone en Cancún?',
    answer: 'El servicio inicia generalmente desde los 120 USD (o su equivalente en pesos mexicanos) para modelos estándar. El costo final depende del modelo exacto (un iPhone 11 vs. un 16 Pro Max), la tecnología elegida (OLED original, OEM o Incell), la distancia de recolección si aplica y la hora de solicitud. Siempre te damos precio previo y esperamos tu confirmación antes de instalar cualquier refacción.',
  },
  {
    question: '¿Se cobra recargo por servicios de urgencia o en domingos noche?',
    answer: 'Sí. En solicitudes en horarios nocturnos o días no laborables (como un domingo a las 11:00 PM o madrugadas), se aplica una tarifa de guardia por atención fuera de turno habitual. Todo se acuerda y autoriza con el cliente por WhatsApp antes de trasladar el equipo o iniciar el trabajo.',
  },
  {
    question: '¿Garantizan que el equipo encienda si tardé en llevarlo a reparar?',
    answer: 'Si el equipo sufrió una caída muy fuerte o tuvo contacto con agua y pasó mucho tiempo antes de recibir atención técnica, primero diagnosticamos la placa lógica. Si los componentes internos sufrieron sulfatación, corrosión o cortocircuitos severos, no podemos garantizar de antemano el encendido hasta evaluar si la placa recibe y distribuye corriente adecuadamente.',
  },
  {
    question: '¿Cuánto tarda el cambio de pantalla de un iPhone?',
    answer: 'En nuestro taller de Cancún, el cambio de display suele completarse en aproximadamente 1 a 2 horas para la mayoría de modelos con refacción en stock. Si el marco requiere enderezado o hay revisión por humedad, el tiempo puede extenderse para asegurar un sellado perfecto.',
  },
  {
    question: '¿Se pierde Face ID al cambiar la pantalla del iPhone?',
    answer: 'No, siempre y cuando los sensores TrueDepth (proyector de puntos y cámara infrarroja) no se hayan dañado durante el golpe previo. En Pixon PC cuidamos minuciosamente el flex de sensores superiores para trasplantarlo intacto a la nueva pantalla.',
  },
  {
    question: '¿Se pierde la función True Tone?',
    answer: 'True Tone requiere transferir los datos de calibración de la pantalla dañada al nuevo módulo mediante herramienta de programación. En pantallas OLED compatibles y pantallas originales realizamos este proceso siempre que la pantalla anterior permita lectura de datos.',
  },
  {
    question: '¿Se borran mis fotos o datos al cambiar la pantalla?',
    answer: 'No. El cambio de pantalla es una reparación estrictamente de hardware externo y no altera la memoria NAND ni el sistema operativo iOS. Tus fotos, mensajes, aplicaciones y configuración permanecen exactamente igual.',
  },
  {
    question: '¿Se puede cambiar únicamente el cristal si el touch y la imagen funcionan?',
    answer: 'En los modelos modernos de iPhone, el cristal exterior, el digitalizador touch y el panel OLED vienen laminados al vacío de fábrica. Separar solo el cristal en talleres sin hornos industriales suele dejar burbujas, polvo o fallas de touch. Por seguridad y durabilidad, instalamos módulos completos probados.',
  },
  {
    question: '¿Qué diferencia hay entre una pantalla OLED original y una Incell?',
    answer: 'La pantalla OLED original cuenta con píxeles autoiluminados, negros absolutos, menor grosor y visibilidad perfecta bajo el sol de Cancún. La pantalla Incell es tecnología LCD con retroiluminación trasera: es una alternativa más económica pero con menor viveza de colores, mayor consumo de batería y ángulo de visión más limitado.',
  },
  {
    question: '¿Atienden a turistas hospedados en la Zona Hotelera o Costa Mujeres?',
    answer: 'Sí. Atendemos a residentes locales y visitantes hospedados en hoteles de Zona Hotelera, Puerto Cancún, Costa Mujeres y Playa Mujeres. Puedes coordinar entrega o revisión express vía WhatsApp con atención en español e inglés.',
  },
];

// ── Servicios relacionados para enlazado interno SEO ──────────────────────────
const related = [
  { href: '/servicios/telefono/reparacion-iphone', icon: 'fa-mobile-screen', label: 'Reparación integral iPhone', desc: 'Servicio técnico especializado para todos los modelos de iPhone en Cancún.' },
  { href: '/servicios/telefono/cambio-bateria-iphone', icon: 'fa-battery-half', label: 'Cambio de batería iPhone', desc: 'Recupera la autonomía y el 100% de condición de batería sin reinicios.' },
  { href: '/servicios/telefono/reparacion-humedad-iphone', icon: 'fa-droplet', label: 'iPhone mojado en Cancún', desc: 'Desulfatación ultrasónica, secado térmico y rescate de placa lógica por agua.' },
  { href: '/servicios/telefono/reparacion-face-id-iphone', icon: 'fa-face-smile', label: 'Reparación de Face ID', desc: 'Diagnóstico de sensores TrueDepth, cámara frontal y proximidad.' },
  { href: '/servicios/telefono/reparacion-carga-iphone', icon: 'fa-plug', label: 'Puerto de carga Lightning / USB-C', desc: 'Limpieza y reemplazo de puerto para iPhone que no recibe carga o tiene falso contacto.' },
  { href: '/servicios/telefono/diagnostico-iphone', icon: 'fa-stethoscope', label: 'Diagnóstico técnico iPhone', desc: 'Revisión general de tarjeta lógica, consumo eléctrico y fallas intermitentes.' },
];
---

<div class="isr-wrapper">

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 1 · HERO (Único H1)
  ═══════════════════════════════════════════════ -->
  <section class="isr-hero" aria-labelledby="hero-title">
    <div class="isr-hero-glow" aria-hidden="true"></div>
    <div class="isr-hero-grid-bg" aria-hidden="true"></div>
    <div class="container isr-hero-inner">

      <!-- Columna texto -->
      <div class="isr-hero-copy">
        <span class="isr-badge">
          <i class="fa-brands fa-apple"></i> Servicio técnico Apple en Cancún
        </span>
        <h1 id="hero-title" class="isr-h1">
          Reparación de pantalla de iPhone en Cancún
        </h1>
        <p class="isr-sub">
          Cambio de display OLED y cristal con diagnóstico previo, prueba completa y garantía por escrito
        </p>
        <p class="isr-copy">
          ¿Tu iPhone sufrió una caída, se estrelló el cristal, tiene líneas verdes o la pantalla quedó completamente negra? En Pixon PC diagnosticamos el display, touch, sensores superiores y marco antes de instalar para darte una cotización transparente.
        </p>
        <p class="isr-copy isr-copy--secondary">
          Atendemos desde iPhone XR hasta iPhone 16 Pro Max con refacciones OLED Original, OLED OEM e Incell según tu presupuesto y necesidad.
        </p>

        <div class="isr-chips" aria-label="Beneficios destacados">
          <div class="isr-chip"><i class="fa-solid fa-magnifying-glass"></i> Diagnóstico antes de instalar</div>
          <div class="isr-chip"><i class="fa-solid fa-hand-holding-dollar"></i> Precios confirmados con el cliente</div>
          <div class="isr-chip isr-chip--green"><i class="fa-solid fa-shield-halved"></i> Garantía formal por escrito</div>
          <div class="isr-chip"><i class="fa-solid fa-clock"></i> 1 a 2 horas en taller</div>
          <div class="isr-chip"><i class="fa-solid fa-face-smile"></i> Cuidado de Face ID y sensores</div>
          <div class="isr-chip"><i class="fa-solid fa-location-dot"></i> Taller físico en Cancún</div>
        </div>

        <div class="isr-trust-bar">
          <span><i class="fa-solid fa-star"></i> 5.0 en Google</span>
          <span><i class="fa-solid fa-map-pin"></i> Cancún Centro y Zona Hotelera</span>
          <span><i class="fa-solid fa-calendar-check"></i> Citas y urgencias</span>
        </div>

        <div class="isr-cta-group">
          <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="isr-btn-wa">
            <i class="fa-brands fa-whatsapp"></i> Cotizar pantalla por WhatsApp
          </a>
          <a href="#sintomas" class="isr-btn-outline">
            Identificar falla <i class="fa-solid fa-arrow-down"></i>
          </a>
        </div>
        <p class="isr-micro">Envíanos una foto del daño y modelo de tu iPhone para cotizar al momento.</p>
      </div>

      <!-- Columna visual: tarjeta interactiva de diagnóstico -->
      <div class="isr-hero-card-wrap">
        <div class="isr-hero-card">
          <div class="isr-card-header">
            <i class="fa-brands fa-apple"></i>
            <span>Control de Calidad Pixon PC</span>
          </div>

          <div class="isr-phone-visual" aria-hidden="true">
            <div class="isr-phone-frame">
              <div class="isr-phone-notch"></div>
              <div class="isr-phone-screen">
                <div class="isr-crack isr-crack-a"></div>
                <div class="isr-crack isr-crack-b"></div>
                <div class="isr-crack isr-crack-c"></div>
                <div class="isr-screen-glow"></div>
              </div>
              <div class="isr-phone-home"></div>
            </div>
          </div>

          <ul class="isr-card-checks" aria-label="Verificaciones técnicas">
            <li><i class="fa-solid fa-circle-check"></i> Prueba táctil en todo el panel</li>
            <li><i class="fa-solid fa-circle-check"></i> Preservación de módulo Face ID</li>
            <li><i class="fa-solid fa-circle-check"></i> Revisión de marco y esquinas</li>
            <li><i class="fa-solid fa-circle-check"></i> Comprobación de sellos de humedad</li>
            <li><i class="fa-solid fa-circle-check"></i> Refacción autorizada por el cliente</li>
            <li><i class="fa-solid fa-circle-check"></i> Calibración de brillo y colores</li>
          </ul>

          <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="isr-card-cta">
            <i class="fa-brands fa-whatsapp"></i> Solicitar cotización inmediata
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 2 · SÍNTOMAS COMUNES (H2 y H3s)
  ═══════════════════════════════════════════════ -->
  <section class="isr-sintomas" id="sintomas" aria-labelledby="sintomas-title">
    <div class="container">
      <div class="isr-section-head">
        <span class="isr-eyebrow"><i class="fa-solid fa-stethoscope"></i> Diagnóstico de fallas</span>
        <h2 id="sintomas-title" class="isr-h2">¿Tu iPhone tiene la pantalla rota, negra o el touch no responde?</h2>
        <p class="isr-desc">
          Un golpe o caída no siempre afecta los componentes de la misma manera. Conoce los síntomas más frecuentes que resolvemos a diario en nuestro taller de Cancún:
        </p>
      </div>

      <div class="isr-sintomas-grid">
        {sintomas.map((s, i) => (
          <article class={`isr-sintoma-card ${s.urgent ? 'isr-sintoma-card--urgent' : ''}`}>
            <div class="isr-sintoma-num">{String(i + 1).padStart(2, '0')}</div>
            <div class="isr-sintoma-icon">
              <i class={`fa-solid ${s.icon}`}></i>
            </div>
            <div class="isr-sintoma-body">
              <h3 class="isr-sintoma-h3">{s.h3}</h3>
              <p>{s.desc}</p>
              {s.urgent && (
                <span class="isr-sintoma-tag"><i class="fa-solid fa-triangle-exclamation"></i> Requiere revisión pronta</span>
              )}
            </div>
          </article>
        ))}

        <div class="isr-sintoma-cta-card">
          <i class="fa-brands fa-apple"></i>
          <strong>¿No estás seguro de qué pieza falló?</strong>
          <p>Tráelo a revisión o mándanos un video de la falla por WhatsApp para asesorarte de inmediato.</p>
          <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-whatsapp"></i> Consultar con un técnico
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 3 · PRECIO Y POLÍTICA DE SERVICIO (H2 y H3s)
  ═══════════════════════════════════════════════ -->
  <section class="isr-precio" id="precio" aria-labelledby="precio-title">
    <div class="container">
      <div class="isr-section-head">
        <span class="isr-eyebrow"><i class="fa-solid fa-hand-holding-dollar"></i> Transparencia y costos</span>
        <h2 id="precio-title" class="isr-h2">¿Cuánto cuesta cambiar la pantalla de un iPhone en Cancún?</h2>
        <p class="isr-desc">
          En Pixon PC trabajamos con total claridad: el costo del servicio y reemplazo comienza generalmente desde los <strong>120 USD</strong> (o su equivalente en pesos mexicanos) según el modelo y panel. Te informamos el costo exacto antes de tocar tu equipo.
        </p>
      </div>

      <div class="isr-precio-factors-grid">
        <article class="isr-precio-factor-card">
          <div class="isr-pfactor-icon"><i class="fa-solid fa-mobile-screen-button"></i></div>
          <h3>Precio según modelo de iPhone</h3>
          <p>Un iPhone 11 con pantalla LCD tiene un costo de refacción significativamente distinto a un iPhone 15 o 16 Pro Max con display Super Retina XDR OLED a 120Hz. Cada generación utiliza herramental y módulos específicos.</p>
        </article>

        <article class="isr-precio-factor-card">
          <div class="isr-pfactor-icon"><i class="fa-solid fa-layer-group"></i></div>
          <h3>Precio según pantalla OLED, OEM o Incell</h3>
          <p>Disponemos de opciones para cada necesidad: pantallas OLED originales para quienes no aceptan compromisos en color y brillo, opciones OEM de alta fidelidad y paneles Incell para presupuestos moderados.</p>
        </article>

        <article class="isr-precio-factor-card">
          <div class="isr-pfactor-icon"><i class="fa-solid fa-wrench"></i></div>
          <h3>Daño de frame, humedad o conectores</h3>
          <p>Si el impacto dobló el chasis de aluminio, dañó los flexores superiores o el equipo tuvo contacto con agua, se te informa antes de iniciar. No se añade ningún cargo sin tu previa autorización.</p>
        </article>

        <article class="isr-precio-factor-card isr-precio-factor-card--highlight">
          <div class="isr-pfactor-icon"><i class="fa-solid fa-clock-rotate-left"></i></div>
          <h3>Horario, urgencias y días no laborables</h3>
          <p>Si requieres atención urgente fuera del horario comercial, en altas horas de la noche o en días no laborables (como un domingo a las 11:00 PM), el servicio tiene un costo adicional por guardia especial y distancia de traslado.</p>
        </article>
      </div>

      <div class="isr-precio-warning-box">
        <div class="isr-pwarn-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <div class="isr-pwarn-body">
          <strong>Aviso técnico sobre equipos que tardaron en revisarse:</strong>
          <p>
            Si tu iPhone sufrió un impacto severo o ingreso de líquidos y pasaron días o semanas antes de traerlo a servicio, primero diagnosticamos si la placa lógica enciende y distribuye corriente. No garantizamos de antemano el encendido completo si los circuitos internos ya presentan corrosión o pistas rotas por el tiempo transcurrido. Toda pieza se cotiza primero y se espera tu confirmación.
          </p>
