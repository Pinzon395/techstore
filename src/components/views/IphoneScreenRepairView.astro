  color: var(--isr-primary-light);
  margin-bottom: 12px;
}
.isr-eyebrow i { color: var(--isr-primary-light); }

.isr-h2 {
  font-size: clamp(1.45rem, 3vw, 2rem);
  font-weight: 800;
  color: var(--isr-text);
  line-height: 1.2;
  margin-bottom: 12px;
  font-family: 'Kanit', sans-serif;
}

.isr-desc {
  color: var(--isr-muted);
  font-size: 0.97rem;
  line-height: 1.7;
  max-width: 680px;
}

.isr-section-head {
  margin-bottom: 40px;
}
.isr-section-head.text-center {
  text-align: center;
}
.isr-section-head.text-center .isr-desc {
  margin: 0 auto;
}

/* ══════════════════════════════════════════════════
   SECCIÓN 1 · HERO
══════════════════════════════════════════════════ */
.isr-hero {
