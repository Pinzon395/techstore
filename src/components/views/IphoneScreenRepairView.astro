}

.isr-section-head {
  margin-bottom: 36px;
}
.isr-section-head.text-center {
  text-align: center;
}
.isr-section-head.text-center .isr-desc {
  margin-inline: auto;
}

/* ══════════════════════════════════════════════════
   HERO OSCURO ELEGANTE
═══════════════════════════════════════════════ */
.isr-hero {
  position: relative;
  background: radial-gradient(circle at 85% 20%, rgba(56, 189, 248, 0.18), transparent 35%),
              linear-gradient(135deg, #051426 0%, #071F3A 65%, #0c2b4d 100%);
  padding: clamp(48px, 7vw, 90px) 0 60px;
  overflow: hidden;
  color: #ffffff;
}

.isr-hero h1,
.isr-hero h2,
.isr-hero p,
.isr-hero span {
  color: inherit;
}

.isr-hero-inner {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 40px;
  align-items: center;
  position: relative;
  z-index: 2;
}

.isr-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 16px;
  border-radius: 999px;
  background: rgba(56, 189, 248, 0.12);
  border: 1px solid rgba(56, 189, 248, 0.3);
  color: #7dd3fc !important;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  margin-bottom: 16px;
}

.isr-h1 {
  font-family: 'Kanit', sans-serif;
  font-size: clamp(1.85rem, 4.2vw, 3.1rem);
  font-weight: 800;
  line-height: 1.12;
  color: #ffffff !important;
  margin-bottom: 14px;
}

.isr-sub {
  font-size: 1.08rem;
  font-weight: 600;
  color: #93c5fd !important;
  line-height: 1.5;
  margin-bottom: 14px;
}

.isr-copy {
  color: rgba(255, 255, 255, 0.86) !important;
  font-size: 0.98rem;
  line-height: 1.65;
  margin-bottom: 10px;
}

.isr-copy--secondary {
  color: rgba(255, 255, 255, 0.72) !important;
  font-size: 0.92rem;
}

.isr-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 22px 0 16px;
}

.isr-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #ffffff !important;
  font-size: 0.82rem;
  font-weight: 600;
}

.isr-chip--green {
  background: rgba(32, 164, 90, 0.2);
  border-color: rgba(32, 164, 90, 0.4);
  color: #86efac !important;
}

.isr-trust-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  margin-bottom: 24px;
  color: rgba(255, 255, 255, 0.7) !important;
  font-size: 0.84rem;
}

.isr-trust-bar span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.isr-trust-bar i { color: #38bdf8; }

.isr-cta-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 10px;
}

.isr-btn-wa {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 13px 24px;
  background: var(--verde-wa);
  color: #ffffff !important;
  border-radius: 10px;
  font-weight: 700;
  font-size: 0.95rem;
  text-decoration: none;
  box-shadow: 0 10px 24px rgba(32, 164, 90, 0.28);
  transition: transform 0.18s ease, background 0.18s ease;
}
.isr-btn-wa:hover {
  background: var(--verde-wa-hover);
  transform: translateY(-2px);
}
.isr-btn-wa--sm {
  padding: 10px 18px;
  font-size: 0.88rem;
}

.isr-btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 13px 22px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: #ffffff !important;
  border-radius: 10px;
  font-weight: 600;
  font-size: 0.92rem;
  text-decoration: none;
  transition: background 0.18s ease, border-color 0.18s ease;
}
.isr-btn-outline:hover {
  background: rgba(255, 255, 255, 0.15);
  border-color: rgba(255, 255, 255, 0.45);
}

.isr-micro {
  font-size: 0.8rem;
  color: rgba(255, 255, 255, 0.6) !important;
  margin-top: 6px;
}

/* Card Hero */
.isr-hero-card {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 20px;
  padding: 26px;
  backdrop-filter: blur(12px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
}

.isr-card-header {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 700;
  font-size: 0.92rem;
  color: #ffffff;
  margin-bottom: 16px;
}
.isr-card-header i { font-size: 1.2rem; color: #38bdf8; }

.isr-phone-visual {
  display: flex;
  justify-content: center;
  margin-bottom: 18px;
}
.isr-phone-frame {
  width: 78px;
  height: 136px;
  background: #0f172a;
  border: 2px solid #334155;
  border-radius: 16px;
  position: relative;
}
.isr-phone-notch {
  width: 26px;
  height: 5px;
  background: #020617;
  border-radius: 3px;
  margin: 6px auto 0;
}
.isr-phone-screen {
  margin: 5px 4px;
  height: 94px;
  background: #0a1b2e;
  border-radius: 8px;
  position: relative;
  overflow: hidden;
}
.isr-crack {
  position: absolute;
  background: rgba(255, 255, 255, 0.45);
  border-radius: 1px;
}
.isr-crack-a { width: 1.5px; height: 50px; top: 10px; left: 20px; transform: rotate(20deg); }
.isr-crack-b { width: 1.5px; height: 40px; top: 25px; left: 35px; transform: rotate(-25deg); }
.isr-crack-c { width: 1.5px; height: 35px; top: 15px; left: 50px; transform: rotate(15deg); }
.isr-screen-glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 40% 40%, rgba(56, 189, 248, 0.25), transparent 70%);
}
.isr-phone-home {
  width: 20px;
  height: 3px;
  background: #334155;
  border-radius: 2px;
  margin: 4px auto 0;
}

.isr-card-checks {
  list-style: none;
  padding: 0;
  margin: 0 0 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.isr-card-checks li {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.85rem;
  color: rgba(255, 255, 255, 0.88);
}
.isr-card-checks i { color: #20a45a; font-size: 0.9rem; }

.isr-card-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px;
  background: var(--verde-wa);
  color: #ffffff !important;
  border-radius: 10px;
  font-weight: 700;
  font-size: 0.9rem;
  text-decoration: none;
  transition: background 0.18s ease;
}
.isr-card-cta:hover { background: var(--verde-wa-hover); }

/* ══════════════════════════════════════════════════
   SECCIÓN 2 · SÍNTOMAS
══════════════════════════════════════════════════ */
.isr-sintomas {
  padding: 70px 0;
  background: #ffffff;
}

.isr-sintomas-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 20px;
}

.isr-sintoma-card {
  background: var(--gris-fondo);
  border: 1px solid var(--gris-borde);
  border-radius: 14px;
  padding: 22px;
  display: grid;
  grid-template-columns: 36px 1fr;
  gap: 0 14px;
  transition: transform 0.18s ease, border-color 0.18s ease;
}
.isr-sintoma-card:hover {
  transform: translateY(-2px);
  border-color: var(--azul-acento);
}
.isr-sintoma-card--urgent {
  border-left: 4px solid #ef4444;
}

.isr-sintoma-num {
  font-size: 0.75rem;
  font-weight: 800;
  color: #94a3b8;
}
.isr-sintoma-icon i {
  font-size: 1.3rem;
  color: var(--azul-acento);
}
.isr-sintoma-h3 {
  font-family: 'Kanit', sans-serif;
  font-size: 1.05rem;
  font-weight: 700;
  margin: 0 0 8px;
  color: var(--azul-oscuro) !important;
}
.isr-sintoma-body p {
  font-size: 0.88rem;
  color: var(--gris-texto);
  line-height: 1.6;
  margin: 0;
}
.isr-sintoma-tag {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  margin-top: 10px;
  font-size: 0.74rem;
  font-weight: 700;
  color: #b91c1c;
  background: #fef2f2;
  padding: 3px 8px;
  border-radius: 6px;
}

.isr-sintoma-cta-card {
  background: linear-gradient(135deg, #071F3A, #0c2b4d);
  color: #ffffff;
  border-radius: 14px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  gap: 10px;
}
.isr-sintoma-cta-card i { font-size: 1.8rem; color: #38bdf8; }
.isr-sintoma-cta-card strong { color: #ffffff !important; font-size: 1.02rem; }
.isr-sintoma-cta-card p { color: rgba(255, 255, 255, 0.8) !important; font-size: 0.88rem; margin: 0; }
.isr-sintoma-cta-card a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px;
  background: var(--verde-wa);
  color: #ffffff !important;
  border-radius: 8px;
  font-weight: 700;
  font-size: 0.88rem;
  text-decoration: none;
}

/* ══════════════════════════════════════════════════
   SECCIÓN 3 · PRECIO
══════════════════════════════════════════════════ */
.isr-precio {
  padding: 70px 0;
  background: var(--gris-fondo);
}

.isr-precio-factors-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 18px;
  margin-bottom: 26px;
}

.isr-precio-factor-card {
  background: #ffffff;
  border: 1px solid var(--gris-borde);
  border-radius: 14px;
  padding: 22px;
}
.isr-precio-factor-card--highlight {
  border: 1px solid #fed7aa;
  background: #fffaf5;
}
.isr-pfactor-icon i {
  font-size: 1.3rem;
  color: var(--azul-acento);
  margin-bottom: 12px;
}
.isr-precio-factor-card h3 {
  font-family: 'Kanit', sans-serif;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--azul-oscuro) !important;
  margin-bottom: 8px;
}
.isr-precio-factor-card p {
  font-size: 0.88rem;
  color: var(--gris-texto);
  line-height: 1.6;
  margin: 0;
}

.isr-precio-warning-box {
  display: flex;
  gap: 16px;
  padding: 20px 24px;
  background: #fffbeb;
  border: 1px solid #fef3c7;
  border-left: 4px solid #f59e0b;
  border-radius: 12px;
  margin-bottom: 30px;
}
.isr-pwarn-icon i { font-size: 1.4rem; color: #d97706; margin-top: 2px; }
.isr-pwarn-body strong { color: #92400e !important; font-size: 0.95rem; display: block; margin-bottom: 4px; }
.isr-pwarn-body p { color: #78350f !important; font-size: 0.88rem; line-height: 1.6; margin: 0; }

.isr-precio-cta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 18px;
  background: #ffffff;
  border: 1px solid var(--gris-borde);
  border-radius: 14px;
  padding: 22px 28px;
}
.isr-pcta-info strong { font-size: 1.02rem; color: var(--azul-oscuro) !important; display: block; }
.isr-pcta-info p { font-size: 0.88rem; color: var(--gris-texto); margin: 0; }

/* ══════════════════════════════════════════════════
   SECCIÓN 4 · TIPOS DE PANTALLA
══════════════════════════════════════════════════ */
.isr-tipos {
  padding: 70px 0;
  background: #ffffff;
}

.isr-tipos-panel {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 22px;
  margin-bottom: 32px;
}

.isr-tipo-card {
  background: var(--gris-fondo);
  border: 1px solid var(--gris-borde);
  border-top: 4px solid var(--tipo-color);
  border-radius: 14px;
  padding: 24px;
}

.isr-tipo-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12px;
}
.isr-tipo-name { font-size: 1.15rem; font-weight: 800; color: var(--azul-oscuro) !important; }
.isr-tipo-quality {
  font-size: 0.76rem;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 6px;
  background: #ffffff;
  border: 1px solid var(--gris-borde);
  color: var(--azul-oscuro);
}

.isr-tipo-desc { font-size: 0.88rem; color: var(--gris-texto); line-height: 1.6; margin-bottom: 16px; }

.isr-tipo-points {
  list-style: none;
  padding: 0;
  margin: 0 0 18px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.isr-tipo-points li {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.84rem;
  color: var(--azul-oscuro);
  font-weight: 500;
}
.isr-tipo-points svg { width: 14px; height: 14px; fill: var(--tipo-color); flex-shrink: 0; }

.isr-tipo-ideal {
  background: #ffffff;
  border: 1px solid var(--gris-borde);
  border-radius: 8px;
  padding: 10px 14px;
  margin-bottom: 16px;
}
.isr-tipo-ideal span {
  display: block;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  color: #94a3b8;
}
.isr-tipo-ideal p { font-size: 0.82rem; color: var(--azul-oscuro); margin: 0; }

.isr-tipo-meters { display: flex; flex-direction: column; gap: 6px; }
.isr-tipo-meters > div { display: flex; align-items: center; gap: 10px; font-size: 0.78rem; color: var(--gris-texto); }
.isr-tipo-meters span { min-width: 60px; }
.isr-tipo-meters meter { flex: 1; height: 8px; border-radius: 4px; }

.isr-calidades-guide {
  background: #f1f5f9;
  border-radius: 12px;
  padding: 22px 26px;
}
.isr-guide-h3 {
  font-family: 'Kanit', sans-serif;
  font-size: 1.1rem;
  margin: 0 0 8px;
  color: var(--azul-oscuro) !important;
}
.isr-calidades-guide p {
  font-size: 0.92rem;
  color: var(--gris-texto);
  line-height: 1.65;
  margin: 0;
}

/* ══════════════════════════════════════════════════
   SECCIÓN 5 · MODELOS
══════════════════════════════════════════════════ */
.isr-modelos {
  padding: 70px 0;
  background: var(--gris-fondo);
}

.isr-generaciones-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 20px;
  margin-bottom: 24px;
}

.isr-gen-card {
  background: #ffffff;
  border: 1px solid var(--gris-borde);
  border-radius: 14px;
  padding: 22px;
}
.isr-gen-h3 {
  font-family: 'Kanit', sans-serif;
  font-size: 1.08rem;
  color: var(--azul-oscuro) !important;
  margin: 0 0 8px;
}
.isr-gen-desc {
  font-size: 0.88rem;
  color: var(--gris-texto);
  line-height: 1.6;
  margin-bottom: 14px;
}
.isr-gen-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.isr-gen-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: #f1f5f9;
  border: 1px solid var(--gris-borde);
  border-radius: 6px;
  padding: 4px 10px;
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--azul-oscuro);
}

.isr-modelos-note {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.88rem;
  color: var(--gris-texto);
  padding: 14px 20px;
  background: #ffffff;
  border: 1px dashed var(--gris-borde);
  border-radius: 10px;
}
.isr-modelos-note i { color: var(--azul-acento); }

/* ══════════════════════════════════════════════════
   SECCIÓN 6 · SENSORES
══════════════════════════════════════════════════ */
.isr-sensores {
  padding: 70px 0;
  background: #ffffff;
}

.isr-sensores-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 20px;
}

.isr-sensor-card {
  background: var(--gris-fondo);
  border: 1px solid var(--gris-borde);
  border-radius: 14px;
  padding: 22px;
}
.isr-sensor-icon i {
  font-size: 1.4rem;
  color: var(--azul-acento);
  margin-bottom: 12px;
}
.isr-sensor-card h3 {
  font-family: 'Kanit', sans-serif;
  font-size: 1.05rem;
  color: var(--azul-oscuro) !important;
  margin: 0 0 8px;
}
.isr-sensor-card p {
  font-size: 0.88rem;
  color: var(--gris-texto);
  line-height: 1.6;
  margin: 0;
}

/* ══════════════════════════════════════════════════
   SECCIÓN 7 · PROCESO
══════════════════════════════════════════════════ */
.isr-proceso {
  padding: 70px 0;
  background: var(--gris-fondo);
}

.isr-proceso-head {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 30px;
  margin-bottom: 36px;
  align-items: start;
}

.isr-proceso-tags {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.isr-proceso-tags span {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.84rem;
  font-weight: 600;
  color: var(--azul-oscuro);
}
.isr-proceso-tags i { color: var(--azul-acento); }

.isr-proceso-flow {
  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  gap: 32px;
}

.isr-proceso-steps {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.isr-step {
  display: flex;
  gap: 16px;
  background: #ffffff;
  border: 1px solid var(--gris-borde);
  border-radius: 12px;
  padding: 18px;
}

.isr-step-num {
  font-size: 0.82rem;
  font-weight: 800;
  color: var(--azul-acento);
  min-width: 28px;
  padding-top: 2px;
}
.isr-step-h3 {
  font-family: 'Kanit', sans-serif;
  font-size: 1rem;
  margin: 0 0 6px;
  color: var(--azul-oscuro) !important;
}
.isr-step-body p {
  font-size: 0.86rem;
  color: var(--gris-texto);
  line-height: 1.55;
  margin: 0;
}

.isr-proceso-proof {
  background: #ffffff;
  border: 1px solid var(--gris-borde);
  border-radius: 14px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  align-self: start;
}
.isr-proof-icon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #ecfdf5;
  display: flex;
  align-items: center;
  justify-content: center;
}
.isr-proof-icon svg { width: 22px; fill: #10b981; }
.isr-proof-title { font-size: 1.05rem; color: var(--azul-oscuro) !important; }
.isr-proceso-proof p { font-size: 0.88rem; color: var(--gris-texto); line-height: 1.6; margin: 0; }
.isr-proof-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 18px;
  background: var(--verde-wa);
  color: #ffffff !important;
  border-radius: 10px;
  font-weight: 700;
  font-size: 0.88rem;
  text-decoration: none;
}

/* ══════════════════════════════════════════════════
   SECCIÓN 8 · TIEMPOS
══════════════════════════════════════════════════ */
.isr-tiempos {
  padding: 30px 0 60px;
  background: var(--gris-fondo);
}
.isr-tiempos-box {
  background: #ffffff;
  border: 1px solid var(--gris-borde);
  border-radius: 16px;
  padding: 32px 36px;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 30px;
  align-items: center;
}
.isr-tiempos-list {
  list-style: none;
  padding: 0;
  margin: 16px 0 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.isr-tiempos-list li {
  display: flex;
  align-items: baseline;
  gap: 10px;
  font-size: 0.9rem;
  color: var(--gris-texto);
}
.isr-tiempos-list i { color: #10b981; font-size: 0.85rem; }
