---
import FaqSection from '../FaqSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import Footer from '../Footer.astro';
import WaterDamageHeroVisual from '../WaterDamageHeroVisual.astro';

const { service } = Astro.props;

const whatsappText = encodeURIComponent(
  'Hola Pixon PC. Mi celular se mojó. Estoy en: ____. Modelo: ____. Líquido: ____. ¿Hace cuánto ocurrió?: ____.'
);
const whatsappUrl = `https://wa.me/529986690777?text=${whatsappText}`;
const hotelWhatsappText = encodeURIComponent(
  'Hola Pixon PC. Mi celular se mojó. Hotel o zona: ____. Modelo: ____. Líquido: ____. ¿Hace cuánto ocurrió?: ____.'
);
const hotelWhatsappUrl = `https://wa.me/529986690777?text=${hotelWhatsappText}`;

const immediateSteps = [
  {
    icon: 'fa-power-off',
    title: 'Apágalo y desconéctalo',
    text: 'Si puedes hacerlo de forma segura, apaga el equipo y retira cables o accesorios. No lo conectes para comprobar si carga.',
  },
  {
    icon: 'fa-hand',
    title: 'Deja de probarlo',
    text: 'No presiones botones repetidamente, no hagas llamadas de prueba y no intentes encenderlo otra vez.',
  },
  {
    icon: 'fa-wind',
    title: 'Seca solo el exterior',
    text: 'Usa un paño suave y deja el conector orientado hacia abajo, en un sitio seco y ventilado. No abras el equipo en casa.',
  },
  {
    icon: 'fa-clock',
    title: 'Solicita revisión',
    text: 'Indica el líquido, la hora del incidente y si se encendió o cargó después. Esa información cambia la ruta de diagnóstico.',
  },
];

const avoidActions = [
  {
    icon: 'fa-bowl-rice',
    title: 'Arroz',
    text: 'No elimina residuos ni corrosión y puede dejar partículas en los puertos.',
  },
  {
    icon: 'fa-temperature-arrow-up',
    title: 'Secadora o calor',
    text: 'El calor directo puede afectar adhesivos, batería, pantalla y componentes internos.',
  },
  {
    icon: 'fa-wind',
    title: 'Aire comprimido',
    text: 'Puede mover el líquido hacia otras zonas y no resuelve los residuos internos.',
  },
  {
    icon: 'fa-plug-circle-xmark',
    title: 'Cargar para probar',
    text: 'Aplicar corriente con humedad o residuos puede agravar un corto.',
  },
];

const symptoms = [
  {
    icon: 'fa-power-off',
    query: '“Mi celular se mojó y no prende”',
    text: 'Revisamos consumo, batería, pantalla, líneas de alimentación y placa antes de intentar energizarlo.',
  },
  {
    icon: 'fa-plug-circle-exclamation',
    query: '“Detecta humedad y no carga”',
    text: 'Inspeccionamos puerto USB-C o Lightning, flex, residuos, corrosión y el sistema de carga.',
  },
  {
    icon: 'fa-mobile-screen',
    query: '“Prende, pero la pantalla está negra”',
    text: 'Separamos una falla de display o flex de un problema de energía, retroiluminación o placa.',
  },
  {
    icon: 'fa-camera',
    query: '“Fallan cámara, audio o micrófono”',
    text: 'El líquido puede afectar módulos y conectores diferentes; probamos cada función antes de proponer piezas.',
  },
  {
    icon: 'fa-temperature-high',
    query: '“Se calienta o se reinicia”',
    text: 'Detén el uso. Medimos consumo y buscamos corrosión o cortos que puedan provocar fallas intermitentes.',
  },
  {
    icon: 'fa-images',
    query: '“Necesito recuperar mis fotos”',
    text: 'Marcamos los datos como prioridad y evaluamos una ruta de estabilización o recuperación antes de reparar por completo.',
  },
];

const liquids = [
  {
    label: 'Lluvia o agua dulce',
    level: 'Revisión por humedad',
    text: 'Puede alcanzar puerto, bocinas, cámaras, batería o placa aunque el exterior ya parezca seco.',
  },
  {
    label: 'Alberca con cloro',
    level: 'Residuos químicos',
    text: 'El cloro y otros compuestos químicos permanecen en conectores y aceleran el deterioro de contactos.',
  },
  {
    label: 'Mar o salitre',
    level: 'Alta prioridad',
    text: 'La sal deja residuos conductivos y corrosivos altamente agresivos; evita encender o cargar el equipo.',
  },
  {
    label: 'Refresco, café o bebidas',
    level: 'Residuo adherente',
    text: 'Azúcares, leche o ácidos requieren un protocolo de limpieza técnica distinto al del agua simple.',
  },
  {
    label: 'Vapor o humedad ambiental',
    level: 'Falla progresiva',
    text: 'En Cancún, la humedad y el salitre ambiental pueden agravar residuos previos en conectores comprometidos.',
  },
];

const processSteps = [
  {
    title: 'Recepción y antecedentes',
    text: 'Registramos modelo exacto, tipo de líquido, tiempo transcurrido, intentos de carga o encendido y prioridad de datos.',
  },
  {
    title: 'Apertura e inspección segura',
    text: 'Desconectamos batería y revisamos indicadores LCI, conectores, flex y zonas con residuos sin forzar componentes.',
  },
  {
    title: 'Diagnóstico visual y eléctrico',
    text: 'Buscamos corrosión microscópica y medimos líneas de alimentación para definir pruebas sin riesgo de corto.',
  },
  {
    title: 'Ruta técnica y cotización',
    text: 'Explicamos hallazgos, riesgos, alcance y opciones. El costo se determina por el daño real y no avanzamos sin autorización.',
  },
  {
    title: 'Intervención y pruebas',
    text: 'Realizamos limpieza técnica ultrasónica o reparación autorizada y validamos carga, display, audio, cámaras, red y sensores.',
  },
  {
    title: 'Entrega documentada',
    text: 'Entregamos el equipo con reporte de pruebas, recomendaciones de cuidado y garantía por escrito según el trabajo realizado.',
  },
];

const diagnosticRoutes = [
  {
    icon: 'fa-brush',
    title: 'Limpieza técnica',
    text: 'Para residuos y corrosión localizada cuando los componentes principales aún son recuperables. No se ofrece como solución automática universal.',
  },
  {
    icon: 'fa-puzzle-piece',
    title: 'Módulo o conector',
    text: 'Puerto de carga, batería, pantalla, bocina, micrófono, cámaras o flex pueden requerir reparación o reemplazo independiente.',
  },
  {
    icon: 'fa-microchip',
    title: 'Reparación de placa',
    text: 'Cuando las mediciones ubican corto, pistas o componentes afectados, se valora trabajo electrónico y microsoldadura.',
  },
  {
    icon: 'fa-hard-drive',
    title: 'Prioridad: recuperar datos',
    text: 'Si fotos y archivos son lo más importante, la estrategia puede enfocarse en estabilizar la placa para extraer información.',
  },
];

const intakeQuestions = [
  'Marca y modelo exactos del teléfono',
  'Qué líquido fue y cuánta cantidad aproximada',
  'Cuándo ocurrió el contacto con el líquido',
  'Si estaba encendido o conectado al cargador',
  'Si intentaste encenderlo o cargarlo después',
  'Qué síntomas presenta en este momento',
  'Si la información y fotos son la prioridad',
];

const cancunZones = [
  'Cancún Centro',
  'Zona Hotelera',
  'Av. Huayacán',
  'Residencial Cumbres',
  'Alfredo V. Bonfil',
  'Polígono Sur',
  'Puerto Cancún',
  'Av. Tulum',
  'Av. Bonampak',
  'Puerto Juárez',
  'Supermanzanas',
  'Haciendas Real del Caribe',
  'Costa Mujeres',
  'Playa Mujeres',
  'Punta Sam',
  'Isla Blanca',
];

const relatedServices = [
  {
    href: '/servicios/telefono/reparacion-humedad-iphone',
    icon: 'fa-mobile-screen',
    label: 'iPhone mojado',
    desc: 'Ruta específica para iPhone con alerta de líquido, fallas de carga, Face ID, cámara o placa.',
    cta: 'Ver servicio para iPhone →',
  },
  {
    href: '/servicios/telefono/celular-no-prende',
    icon: 'fa-power-off',
    label: 'Celular no prende',
    desc: 'Diagnóstico de energía, pantalla, batería y placa cuando no hubo contacto conocido con líquido.',
    cta: 'Ver diagnóstico →',
  },
  {
    href: '/servicios/telefono/centro-carga-celular',
    icon: 'fa-plug-circle-bolt',
    label: 'Centro de carga',
    desc: 'Para falso contacto, carga lenta, puerto dañado o alerta de humedad persistente.',
    cta: 'Ver reparación de carga →',
  },
  {
    href: '/servicios/telefono/diagnostico',
    icon: 'fa-stethoscope',
    label: 'Diagnóstico de celular',
    desc: 'Revisión general cuando el origen de la falla no está claro o existen varios síntomas.',
    cta: 'Ver diagnóstico →',
  },
  {
    href: '/servicios/telefono/reparacion-bocina',
    icon: 'fa-volume-high',
    label: 'Fallas de audio',
    desc: 'Bocina, auricular o micrófono con bajo volumen, distorsión o falla posterior a humedad.',
    cta: 'Ver reparación de audio →',
  },
];

const faqItems = service.faqs ?? [];
---

<main class="liquid-page">
  <header class="liquid-hero" aria-labelledby="liquid-title">
    <div class="liquid-shell liquid-hero__grid">
      <div class="liquid-hero__copy">
        <p class="liquid-eyebrow"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Atención urgente por líquido · Cancún</p>
        <h1 id="liquid-title">Servicio para celular mojado en Cancún</h1>
        <p class="liquid-hero__lead">
          Si tu celular cayó al mar, alberca, agua dulce o recibió algún líquido, <strong>apágalo, no lo cargues y no lo sacudas</strong>.
        </p>
        <div class="liquid-actions" aria-label="Solicitar atención">
          <a class="liquid-btn liquid-btn--primary" href="#revision-celular-mojado">
            <i class="fa-solid fa-calendar-check" aria-hidden="true"></i> Agenda tu cita
          </a>
          <a class="liquid-btn liquid-btn--whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Hablar por WhatsApp
          </a>
        </div>
        <p class="liquid-hero__urgency"><i class="fa-solid fa-bolt" aria-hidden="true"></i> <strong>Agenda tu cita ahora mismo.</strong> El tiempo es clave para mejorar las posibilidades de recuperación.</p>
      </div>

      <div class="liquid-hero__media">
        <WaterDamageHeroVisual />
      </div>
    </div>
  </header>

  <aside class="liquid-urgent" aria-label="Advertencia urgente">
    <div class="liquid-shell liquid-urgent__inner">
      <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
      <p><strong>Lo más importante ahora:</strong> mantenlo apagado y desconectado. Que todavía funcione no confirma que el interior esté libre de humedad o corrosión.</p>
      <a class="liquid-urgent__link" href="#que-hacer">Ver qué hacer ahora <i class="fa-solid fa-arrow-down" aria-hidden="true"></i></a>
    </div>
  </aside>

  <section class="liquid-section liquid-section--hotel" id="hotel-cancun" aria-labelledby="hotel-title">
    <div class="liquid-shell liquid-hotel-grid">
      <div>
        <p class="liquid-kicker"><i class="fa-solid fa-hotel" aria-hidden="true"></i> Atención para huéspedes</p>
        <h2 id="hotel-title">¿Tu celular se mojó durante tus vacaciones en Cancún?</h2>
        <p class="liquid-body-copy">Si el incidente ocurrió en la playa, el mar, la alberca de un resort, durante una excursión, bajo la lluvia o por una bebida en el hotel, mantenlo apagado y evita conectarlo. Coordinamos contigo el siguiente paso por WhatsApp.</p>
        <ul class="liquid-hotel-scenarios" aria-label="Situaciones de daño por líquido">
          <li><i class="fa-solid fa-umbrella-beach" aria-hidden="true"></i> Playa y agua de mar</li>
          <li><i class="fa-solid fa-person-swimming" aria-hidden="true"></i> Alberca o piscina</li>
          <li><i class="fa-solid fa-hotel" aria-hidden="true"></i> Hotel o resort</li>
          <li><i class="fa-solid fa-cloud-showers-heavy" aria-hidden="true"></i> Lluvia y humedad</li>
        </ul>
      </div>
      <aside class="liquid-hotel-card">
        <span class="liquid-hotel-card__label">Estoy en un hotel de Cancún</span>
        <h3>Coordinemos la recepción del equipo</h3>
        <p>Indica tu hotel o zona, el modelo y qué líquido lo alcanzó. No necesitas publicar el número de habitación.</p>
        <a class="liquid-btn liquid-btn--whatsapp" href={hotelWhatsappUrl} target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Estoy en un hotel de Cancún
        </a>
      </aside>
    </div>
  </section>

  <section class="liquid-section liquid-section--soft" id="zona-hotelera" aria-labelledby="hotel-zone-title">
    <div class="liquid-shell liquid-hotel-zone-grid">
      <div>
        <p class="liquid-kicker"><i class="fa-solid fa-map-location-dot" aria-hidden="true"></i> Cobertura coordinada</p>
        <h2 id="hotel-zone-title">Reparación de celular mojado en Zona Hotelera de Cancún</h2>
        <p class="liquid-body-copy">Si eres turista o huésped y tu celular cayó al mar o a la alberca, escríbenos con el nombre del hotel o la zona. Coordinamos la recepción o recolección del dispositivo; no afirmamos una reparación dentro de la habitación cuando el equipo necesita apertura, limpieza técnica o diagnóstico de placa.</p>
      </div>
      <div class="liquid-hotel-zone-note">
        <strong>Antes de trasladarlo</strong>
        <span>Mantenlo apagado, no lo cargues y no lo sacudas. La disponibilidad de recolección y el siguiente paso se confirman por WhatsApp.</span>
        <a class="liquid-btn liquid-btn--secondary" href={hotelWhatsappUrl} target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Coordinar por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <section class="liquid-section" id="que-hacer" aria-labelledby="what-now-title">
    <div class="liquid-shell">
      <div class="liquid-heading liquid-heading--split">
        <div>
          <p class="liquid-kicker">Primeros minutos</p>
          <h2 id="what-now-title">Qué hacer si tu celular se mojó</h2>
        </div>
        <p>Estas acciones no reparan el equipo; buscan evitar que una prueba innecesaria agrave el daño antes del diagnóstico.</p>
      </div>
      <ol class="liquid-first-aid">
        {immediateSteps.map((item, index) => (
          <li>
            <span class="liquid-step-number">0{index + 1}</span>
            <i class={`fa-solid ${item.icon}`} aria-hidden="true"></i>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="liquid-section liquid-section--soft" id="evita-dano" aria-labelledby="avoid-title">
    <div class="liquid-shell liquid-split">
      <div class="liquid-sticky-copy">
        <p class="liquid-kicker"><i class="fa-solid fa-shield-virus" aria-hidden="true"></i> Evita daño adicional</p>
        <h2 id="avoid-title">No uses arroz, calor ni cargadores para “probar”</h2>
        <p>
          Un teléfono puede parecer seco por fuera y conservar humedad, sales o residuos debajo de blindajes y conectores. La prioridad no es hacerlo encender: es evitar nueva corriente hasta conocer su condición.
        </p>
        <div class="liquid-avoid-action">
          <a class="liquid-btn liquid-btn--whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
            <span>Enviar modelo y detalles por WhatsApp</span>
          </a>
        </div>
      </div>
      <div class="liquid-avoid-list">
        {avoidActions.map((item) => (
          <article class="liquid-avoid-card">
            <div class="liquid-avoid-icon" aria-hidden="true">
              <i class={`fa-solid ${item.icon}`}></i>
            </div>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="liquid-section" aria-labelledby="symptoms-title">
    <div class="liquid-shell">
      <div class="liquid-heading">
        <p class="liquid-kicker">Diagnóstico por síntoma</p>
        <h2 id="symptoms-title">Problemas comunes después de mojarse un celular</h2>
        <p>No todos los equipos llegan completamente apagados. También revisamos fallas que aparecen horas o días después del contacto con líquido.</p>
      </div>
      <div class="liquid-symptoms">
        {symptoms.map((item) => (
          <article>
            <i class={`fa-solid ${item.icon}`} aria-hidden="true"></i>
            <h3>{item.query}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="liquid-section liquid-section--soft" aria-labelledby="liquids-title">
    <div class="liquid-shell liquid-split liquid-split--liquids">
      <div>
        <p class="liquid-kicker">El líquido sí importa</p>
        <h2 id="liquids-title">Agua, alberca, mar y bebidas dejan daños distintos</h2>
        <p class="liquid-body-copy">El tipo de líquido, el tiempo y la presencia de corriente cambian la urgencia. Agua salada, cloro y bebidas pueden dejar residuos aun después de evaporarse; por eso el diagnóstico no se limita a “dejarlo secar”.</p>
        <div class="liquid-context">
          <i class="fa-solid fa-water" aria-hidden="true"></i>
          <p><strong>Contexto local en Cancún:</strong> el salitre y la humedad costera aceleran la corrosión y sulfatación interna, especialmente si el equipo ya fue abierto o manipulado previamente.</p>
        </div>
      </div>
      <div class="liquid-types">
        {liquids.map((item) => (
          <article>
            <div>
              <h3>{item.label}</h3>
              <span>{item.level}</span>
            </div>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="liquid-section liquid-section--blue" aria-labelledby="process-title">
    <div class="liquid-shell">
      <div class="liquid-heading liquid-heading--split">
        <div>
          <p class="liquid-kicker">Proceso transparente</p>
          <h2 id="process-title">Cómo diagnosticamos un celular mojado</h2>
        </div>
        <p>No vendemos una limpieza automática. Primero identificamos el alcance y después definimos si conviene limpiar, reparar, cambiar un módulo o priorizar los datos.</p>
      </div>
      <ol class="liquid-process">
        {processSteps.map((item, index) => (
          <li>
            <span>{index + 1}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="liquid-section" aria-labelledby="routes-title">
    <div class="liquid-shell">
      <div class="liquid-heading">
        <p class="liquid-kicker">No todos los casos terminan igual</p>
        <h2 id="routes-title">Posibles rutas después del diagnóstico</h2>
        <p>La opción correcta depende de los hallazgos y de tu prioridad. Antes de intervenir te explicamos viabilidad, riesgos y alcance.</p>
      </div>
      <div class="liquid-routes">
        {diagnosticRoutes.map((item) => (
          <article>
            <i class={`fa-solid ${item.icon}`} aria-hidden="true"></i>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="liquid-section liquid-section--cost" aria-labelledby="cost-title">
    <div class="liquid-shell liquid-cost-grid">
      <div>
        <p class="liquid-kicker">Cotización responsable</p>
        <h2 id="cost-title">El costo se determina después de revisar el daño</h2>
        <p>No publicamos un precio fijo para celulares mojados porque el mismo síntoma puede requerir desde tratamiento de residuos hasta reparación de placa, módulos o una estrategia de recuperación de datos.</p>
        <p><strong>Recibes una explicación y una cotización antes de autorizar.</strong> No realizamos una intervención adicional sin tu confirmación.</p>
      </div>
      <aside aria-label="Factores de la cotización">
        <h3>La evaluación considera</h3>
        <ul>
          <li>Tipo de líquido y tiempo transcurrido</li>
          <li>Si el equipo recibió corriente después</li>
          <li>Zonas y componentes afectados</li>
          <li>Necesidad de piezas o trabajo en placa</li>
          <li>Prioridad y viabilidad de recuperar datos</li>
          <li>Pruebas necesarias antes de entregar</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="liquid-section liquid-section--data" aria-labelledby="data-title">
    <div class="liquid-shell liquid-data-grid">
      <div class="liquid-data-icon" aria-hidden="true">
        <i class="fa-solid fa-images"></i>
      </div>
      <div>
        <p class="liquid-kicker">Fotos y archivos importantes</p>
        <h2 id="data-title">Si los datos son la prioridad, dilo antes de reparar</h2>
        <p>Recuperar el uso del teléfono y recuperar la información no siempre requieren la misma estrategia. Si necesitas fotos, contactos, notas o archivos, lo registramos desde la recepción y evitamos procesos que no correspondan a ese objetivo.</p>
        <p class="liquid-data-note">La recuperación depende del estado de la placa y del almacenamiento; no prometemos resultados sin evaluar el equipo.</p>
      </div>
      <a class="liquid-btn liquid-btn--primary" href="#revision-celular-mojado">
        <i class="fa-solid fa-hard-drive" aria-hidden="true"></i>
        <span>Marcar datos como prioridad</span>
      </a>
    </div>
  </section>

  <section class="liquid-section liquid-section--soft" aria-labelledby="brands-title">
    <div class="liquid-shell liquid-brands-grid">
      <div>
        <p class="liquid-kicker">Servicio multimarca</p>
        <h2 id="brands-title">Revisión de celulares Android mojados en Cancún</h2>
        <p class="liquid-body-copy">Atendemos Samsung Galaxy, Xiaomi, Redmi, POCO, Motorola, Huawei, Honor, Oppo, Realme y otros modelos según diseño, refacciones y condición. Cada equipo se revisa por modelo exacto.</p>
        <nav class="liquid-brand-links" aria-label="Servicios por marca">
          <a href="/servicios/telefono/reparacion-samsung">Samsung</a>
          <a href="/servicios/telefono/reparacion-xiaomi">Xiaomi</a>
          <a href="/servicios/telefono/reparacion-motorola">Motorola</a>
          <a href="/servicios/telefono/reparacion-huawei">Huawei</a>
        </nav>
      </div>
      <aside class="liquid-iphone-route">
        <i class="fa-brands fa-apple" aria-hidden="true"></i>
        <div>
          <h3>¿Es un iPhone?</h3>
          <p>La página específica cubre alertas de líquido, Lightning o USB-C, Face ID, cámaras y particularidades de los modelos Apple.</p>
        </div>
