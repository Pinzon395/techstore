---
import FaqSection from '../FaqSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import Footer from '../Footer.astro';

const { service, category } = Astro.props;

const waMsg = encodeURIComponent('Hola, quiero diagnostico iPhone en Cancun. Mi iPhone presenta una falla y quiero saber si conviene reparar antes de cambiar piezas.');

const keywords = [
  'diagnostico iPhone Cancun',
  'reparar iPhone Cancun',
  'iPhone no prende',
  'iPhone pantalla negra',
  'iPhone no carga',
  'iPhone se queda en la manzana',
  'bateria iPhone se descarga rapido',
  'Face ID no funciona',
  'camara iPhone negra',
  'iPhone mojado',
  'fallas de placa iPhone',
  'servicio tecnico iPhone Cancun',
];

const symptomGroups = [
  { icon: 'fa-power-off', title: 'iPhone no prende', text: 'Revisamos bateria, puerto de carga, consumo, pantalla, flex, botones, humedad y placa antes de declarar perdida total.', intent: 'iPhone no enciende / no prende' },
  { icon: 'fa-mobile-screen', title: 'Pantalla negra o sin imagen', text: 'Probamos encendido real, brillo, display, touch, flex, golpe, humedad y respuesta del sistema.', intent: 'pantalla negra iPhone' },
  { icon: 'fa-plug-circle-xmark', title: 'No carga o carga lento', text: 'Descartamos cable, adaptador, puerto Lightning o USB-C, suciedad, bateria, flex y circuito de carga.', intent: 'iPhone no carga' },
  { icon: 'fa-apple-whole', title: 'Se queda en la manzana', text: 'Diagnosticamos bootloop, memoria llena, actualizacion fallida, software, bateria inestable o falla interna.', intent: 'iPhone se queda en logo Apple' },
  { icon: 'fa-battery-quarter', title: 'Bateria se descarga rapido', text: 'Medimos salud, ciclos, consumo, temperatura, carga y apps antes de recomendar cambio de bateria.', intent: 'bateria iPhone dura poco' },
  { icon: 'fa-temperature-half', title: 'Se calienta o se reinicia', text: 'Revisamos consumo anormal, bateria, placa, humedad, carga, software y sintomas bajo uso real.', intent: 'iPhone se calienta y se apaga' },
  { icon: 'fa-face-smile', title: 'Face ID no funciona', text: 'Probamos TrueDepth, camara frontal, sensores, flex, golpe, humedad y reparaciones previas.', intent: 'Face ID no disponible' },
  { icon: 'fa-camera', title: 'Camara falla', text: 'Revisamos camara frontal, trasera, enfoque, manchas, flash, vibracion, lente roto y humedad.', intent: 'camara iPhone negra o borrosa' },
  { icon: 'fa-volume-high', title: 'Audio o microfono fallan', text: 'Probamos bocina, auricular, microfonos, rejillas, Bluetooth, apps y posibles flex relacionados.', intent: 'bocina o microfono iPhone no funciona' },
  { icon: 'fa-droplet', title: 'iPhone mojado', text: 'Inspeccionamos indicadores, conectores, corrosion, carga, pantalla, bateria y placa antes de energizar.', intent: 'reparacion iPhone mojado Cancun' },
  { icon: 'fa-sim-card', title: 'Sin senal o SIM no detectada', text: 'Revisamos bandeja SIM, eSIM, configuracion, antenas, golpes, humedad y fallas de placa si aplica.', intent: 'iPhone sin servicio SIM no valida' },
  { icon: 'fa-gears', title: 'Falla de sistema o apps', text: 'Diagnosticamos iOS, almacenamiento lleno, actualizacion fallida, bloqueos, lentitud y restauracion segura.', intent: 'iPhone lento se traba actualizacion fallida' },
];

const diagnosticBlocks = [
  { icon: 'fa-bolt', title: 'Energia y encendido', text: 'Bateria, puerto, flex, boton power, consumo y corto. Ideal cuando el iPhone no prende, se apaga o no carga.' },
  { icon: 'fa-display', title: 'Pantalla y touch', text: 'Display, cristal, tactil, brillo, lineas, manchas, ghost touch, sensores superiores y golpes.' },
  { icon: 'fa-microchip', title: 'Placa y consumo', text: 'Revision para fallas intermitentes, calentamiento, reinicios, humedad, corto o consumo fuera de rango.' },
  { icon: 'fa-cloud-arrow-up', title: 'Software y datos', text: 'iOS, bootloop, logo de Apple, memoria llena, respaldo posible, restauracion y riesgos para datos.' },
];

const searchIntents = [
  ['iPhone no prende', 'Puede ser bateria descargada, pantalla sin imagen, puerto, boton, humedad o placa. No conviene cambiar bateria sin medir consumo.'],
  ['iPhone no carga', 'Primero se descarta cable y cargador; despues puerto, suciedad, flex, bateria, humedad y circuito de carga.'],
  ['iPhone se queda en la manzana', 'Puede venir de software, almacenamiento, bateria inestable, actualizacion fallida o falla de placa.'],
  ['iPhone se mojo', 'La prioridad es no cargarlo, revisar corrosion y evitar encenderlo sin diagnostico interno.'],
  ['Face ID no funciona', 'Requiere revisar modulo TrueDepth, sensores superiores, camara frontal, golpe y humedad.'],
  ['Camara iPhone negra', 'Puede ser modulo, lente, app, flex, humedad o reparacion previa; se prueba frontal y trasera.'],
  ['Bateria iPhone dura poco', 'Se revisa salud, ciclos, temperatura, consumo y carga antes de instalar una bateria nueva.'],
  ['iPhone se calienta', 'Puede haber consumo anormal, bateria, software, carga, humedad o componente en corto.'],
];

const process = [
  { step: '01', title: 'Registro del equipo', text: 'Anotamos modelo, falla reportada, golpes, humedad, reparaciones previas, bloqueo de cuenta y prioridad.' },
  { step: '02', title: 'Pruebas externas', text: 'Probamos encendido, pantalla, carga, botones, camaras, audio, microfonos, WiFi, Bluetooth y senal cuando el equipo permite acceso.' },
  { step: '03', title: 'Revision fisica', text: 'Buscamos cristal roto, marco doblado, puerto sucio, rejillas tapadas, lente roto, humedad visible o tornilleria alterada.' },
  { step: '04', title: 'Diagnostico interno', text: 'Si aplica, revisamos bateria, flex, conectores, indicadores de humedad, consumo y componentes relacionados.' },
  { step: '05', title: 'Cotizacion por ruta', text: 'Te decimos si conviene reparar pantalla, bateria, carga, camara, audio, Face ID, humedad, software o placa.' },
  { step: '06', title: 'Pruebas antes de entregar', text: 'Validamos funciones principales y dejamos claro que se reparo, que queda pendiente y que garantia aplica.' },
];

const decisionCards = [
  { icon: 'fa-circle-check', title: 'Si conviene reparar', text: 'Te damos costo, tiempo, pieza probable, garantia y riesgos antes de autorizar.' },
  { icon: 'fa-triangle-exclamation', title: 'Si requiere diagnostico avanzado', text: 'Te explicamos si hace falta abrir, medir consumo, revisar humedad o confirmar placa.' },
  { icon: 'fa-ban', title: 'Si no conviene reparar', text: 'Te lo decimos antes de gastar en piezas cuando el costo no tiene sentido frente al valor del equipo.' },
  { icon: 'fa-database', title: 'Si lo importante son tus datos', text: 'Priorizamos acceso a informacion y respaldo cuando el equipo esta inestable o mojado.' },
];

const repairRoutes = [
  { href: '/servicios/telefono/reparacion-pantalla-iphone', icon: 'fa-mobile-screen', title: 'Pantalla iPhone', text: 'Pantalla rota, lineas, manchas, touch loco, display negro o golpe en el frente.' },
  { href: '/servicios/telefono/cambio-bateria-iphone', icon: 'fa-battery-three-quarters', title: 'Bateria iPhone', text: 'Se descarga rapido, salud baja, se apaga, no retiene carga o se calienta.' },
  { href: '/servicios/telefono/reparacion-carga-iphone', icon: 'fa-plug', title: 'Carga iPhone', text: 'No carga, carga lento, falso contacto, puerto con liquido o no reconoce cable.' },
  { href: '/servicios/telefono/reparacion-camara-iphone', icon: 'fa-camera', title: 'Camara iPhone', text: 'Camara negra, manchas, lente roto, enfoque fallido, vibracion o flash sin funcionar.' },
  { href: '/servicios/telefono/reparacion-face-id-iphone', icon: 'fa-face-smile', title: 'Face ID iPhone', text: 'Face ID no disponible, no configura rostro, fallo despues de golpe o humedad.' },
  { href: '/servicios/telefono/reparacion-bocina-iphone', icon: 'fa-volume-high', title: 'Audio iPhone', text: 'Bocina baja, auricular mudo, microfono falla, llamadas sin audio o rejilla tapada.' },
  { href: '/servicios/telefono/reparacion-humedad-iphone', icon: 'fa-droplet', title: 'Humedad iPhone', text: 'Mojado, salitre, alberca, lluvia, vapor, corrosion, no carga o no prende despues de agua.' },
  { href: '/desbloqueo-icloud-cancun', icon: 'fa-lock', title: 'Desbloqueo de iCloud', text: 'Pantalla de activación, cuenta Apple ID olvidada o código de acceso deshabilitado.' },
  { href: '/servicios/telefono/reparacion-iphone', icon: 'fa-screwdriver-wrench', title: 'Reparacion iPhone', text: 'Ruta general para varias fallas o cuando no sabes que servicio pedir.' },
];

const models = [
  'iPhone 16 Pro Max', 'iPhone 16 Pro', 'iPhone 16 Plus', 'iPhone 16',
  'iPhone 15 Pro Max', 'iPhone 15 Pro', 'iPhone 15 Plus', 'iPhone 15',
  'iPhone 14 Pro Max', 'iPhone 14 Pro', 'iPhone 14 Plus', 'iPhone 14',
  'iPhone 13 Pro Max', 'iPhone 13 Pro', 'iPhone 13 Mini', 'iPhone 13',
  'iPhone 12 Pro Max', 'iPhone 12 Pro', 'iPhone 12 Mini', 'iPhone 12',
  'iPhone 11 Pro Max', 'iPhone 11 Pro', 'iPhone 11', 'iPhone XR', 'iPhone XS',
];

const beforeComing = [
  { icon: 'fa-lock', title: 'Trae tu codigo si es posible', text: 'Para probar camara, audio, WiFi, bateria, sensores y apps necesitamos acceder al sistema si el equipo prende.' },
  { icon: 'fa-cloud', title: 'Respalda si el iPhone aun funciona', text: 'Si el equipo esta inestable, evita restaurarlo sin saber si hay respaldo reciente.' },
  { icon: 'fa-plug-circle-xmark', title: 'No lo cargues si se mojo', text: 'Cargar un iPhone con humedad puede empeorar corrosion o corto en placa.' },
  { icon: 'fa-image', title: 'Envia fotos y sintomas', text: 'Fotos del equipo, puerto, pantalla y lente nos ayudan a orientar disponibilidad y riesgos.' },
  { icon: 'fa-box-open', title: 'Trae cable si la falla es carga', text: 'Asi probamos si el problema aparece con tu accesorio o con varios cargadores.' },
  { icon: 'fa-clock-rotate-left', title: 'Cuenta que paso antes de fallar', text: 'Golpe, agua, actualizacion, reparacion previa o bateria baja cambian la ruta de diagnostico.' },
];

const faqItems = [
  { question: 'Cuanto cuesta un diagnostico iPhone en Cancun?', answer: 'Depende de la falla y del nivel de revision. En muchos casos podemos orientar por WhatsApp con modelo, fotos y sintomas; si requiere abrir, medir consumo o revisar humedad, te confirmamos condiciones antes de avanzar.' },
  { question: 'Que revisan en un diagnostico de iPhone?', answer: 'Revisamos encendido, pantalla, bateria, carga, camaras, Face ID, audio, microfonos, botones, WiFi, Bluetooth, senal, humedad, software y sintomas reportados. Si aplica, tambien revisamos conectores internos, flex y consumo.' },
  { question: 'Mi iPhone no prende, se puede saber si tiene arreglo?', answer: 'Si. Primero se descarta carga, bateria, pantalla sin imagen, boton, humedad y consumo anormal. Con esas pruebas te decimos si conviene bateria, pantalla, carga, limpieza por humedad o diagnostico de placa.' },
  { question: 'El diagnostico borra mis fotos o datos?', answer: 'No borramos informacion para diagnosticar hardware. Si el problema requiere restauracion, actualizacion o trabajo de software que pueda borrar datos, te lo avisamos antes para que autorices.' },
  { question: 'Cuanto tarda diagnosticar un iPhone?', answer: 'Una revision inicial puede ser rapida si el equipo prende. Fallas por humedad, no enciende, reinicios, placa o sintomas intermitentes pueden requerir mas pruebas y tiempo de observacion.' },
  { question: 'Pueden diagnosticar iPhone mojado?', answer: 'Si. En esos casos priorizamos no energizarlo sin revisar, buscar indicadores de humedad, corrosion y conectores afectados. No recomendamos cargarlo ni calentarlo antes de traerlo.' },
  { question: 'Si ya lo repararon en otro taller, lo pueden revisar?', answer: 'Si. Revisamos reparaciones previas, conectores, tornilleria, sellos, flex, pieza instalada, humedad y sintomas actuales para saber si la falla viene de pieza, ensamble o placa.' },
  { question: 'Despues del diagnostico me dicen precio exacto?', answer: 'Te damos una ruta clara: pieza probable, costo, tiempo, riesgos y garantia. En fallas de placa o humedad avanzada puede haber diagnostico por etapas porque aparecen sintomas al recuperar funciones.' },
];
---

<div class="idi-page">
  <section class="idi-hero">
    <div class="idi-container idi-hero-grid">
      <div>
        <span class="idi-eyebrow"><i class="fa-brands fa-apple"></i> Servicio tecnico iPhone en Cancun</span>
        <h1>Diagnostico iPhone en Cancun</h1>
        <h2>Encuentra la causa real antes de cambiar pantalla, bateria, centro de carga, camara, bocina o placa</h2>
        <p class="idi-lead">Si tu iPhone no prende, no carga, tiene pantalla negra, se queda en la manzana, se calienta, se mojo o falla Face ID, hacemos pruebas por sintoma para decirte que conviene reparar y que no.</p>
        <p>La meta del diagnostico no es venderte una pieza: es separar falla de software, accesorio, bateria, pantalla, carga, humedad, flex, sensores o placa para que tomes una decision clara.</p>
        <div class="idi-keywords">
          {keywords.map((keyword) => <span>{keyword}</span>)}
        </div>
        <div class="idi-actions">
          <a class="idi-btn idi-btn-primary" href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-whatsapp"></i> Pedir diagnostico</a>
          <a class="idi-btn idi-btn-secondary" href="#fallas-iphone"><i class="fa-solid fa-magnifying-glass"></i> Ver fallas comunes</a>
        </div>
      </div>
      <aside class="idi-hero-card">
        <div class="idi-device" aria-hidden="true">
          <div class="idi-phone">
            <span class="idi-notch"></span>
            <i class="fa-brands fa-apple"></i>
            <span class="idi-scan idi-scan-a"></span>
            <span class="idi-scan idi-scan-b"></span>
            <span class="idi-chip"><i class="fa-solid fa-stethoscope"></i></span>
          </div>
        </div>
        <div class="idi-card-body">
          <h3>Diagnostico por sintomas</h3>
          <ul>
            {['No prende o pantalla negra', 'No carga o carga lento', 'Bateria y temperatura', 'Face ID, camaras y audio', 'Humedad y corrosion', 'Software, logo Apple y datos'].map((item) => (
              <li><i class="fa-solid fa-check"></i>{item}</li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <ServiceTicketSection
    defaultDevice="iPhone"
    defaultService="Diagnostico iPhone"
    sourcePage="/servicios/telefono/diagnostico-iphone"
    title="Crear ticket de diagnostico iPhone"
    subtitle="Cuentanos modelo, sintoma principal, si tuvo golpe, humedad, actualizacion fallida o reparacion previa."
  />

  <section class="idi-section idi-light" id="fallas-iphone">
    <div class="idi-container">
      <div class="idi-head">
        <span class="idi-eyebrow">Fallas mas buscadas</span>
        <h2>Diagnostico para los problemas de iPhone que mas buscan las personas</h2>
        <p>Organizamos la revision por intencion real de busqueda: no prende, no carga, pantalla negra, bateria, Face ID, camara, audio, humedad, logo de Apple, senal y sistema.</p>
      </div>
      <div class="idi-symptom-grid">
        {symptomGroups.map((item) => (
          <article class="idi-card">
            <i class={`fa-solid ${item.icon}`}></i>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <small>{item.intent}</small>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="idi-section idi-soft">
    <div class="idi-container idi-split">
      <div>
        <span class="idi-eyebrow">Diagnostico integral</span>
        <h2>No todas las fallas se arreglan cambiando una pieza</h2>
        <p>Un iPhone que no prende puede tener bateria, pantalla sin imagen, puerto dañado, flex, humedad o consumo en placa. Un iPhone que no carga puede fallar por cable, puerto, bateria o circuito. Por eso la revision debe separar causas antes de cotizar.</p>
        <a class="idi-btn idi-btn-primary" href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer">Quiero saber que falla tiene</a>
      </div>
      <div class="idi-grid-2">
        {diagnosticBlocks.map((item) => (
          <article class="idi-card">
            <i class={`fa-solid ${item.icon}`}></i>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="idi-section idi-dark">
    <div class="idi-container">
      <div class="idi-head">
        <span class="idi-eyebrow">SEO por sintoma</span>
        <h2>Lo que buscas en Google y como lo diagnosticamos en taller</h2>
        <p>Cada busqueda apunta a varias causas posibles. Nuestro trabajo es reducir incertidumbre antes de cambiar pantalla, bateria, carga o placa.</p>
      </div>
      <div class="idi-intent-list">
        {searchIntents.map(([query, answer]) => (
          <article>
            <strong>{query}</strong>
            <p>{answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="idi-section idi-light">
    <div class="idi-container idi-split">
      <div>
        <img class="idi-photo" src="/assets/images/responsive/reparacion-celulares-cancun.webp" alt="Diagnostico tecnico de iPhone en Cancun" loading="lazy" />
      </div>
      <div>
        <span class="idi-eyebrow">Antes de abrir</span>
        <h2>Pruebas iniciales para iPhone que prende, falla o responde a medias</h2>
        <p>Cuando el equipo permite acceso, revisamos funciones basicas para detectar si la falla esta concentrada en una pieza o si hay sintomas cruzados por humedad, golpe o sistema.</p>
        <div class="idi-check-list">
          {['Pantalla, touch, brillo y sensores', 'Carga, bateria, temperatura y consumo', 'Camara frontal, trasera, flash y Face ID', 'Bocina, auricular, microfonos y Bluetooth', 'WiFi, datos, SIM, eSIM y llamadas', 'Botones, vibrador, puerto y estado fisico'].map((item) => (
            <span><i class="fa-solid fa-circle-check"></i>{item}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="idi-section idi-soft">
    <div class="idi-container">
      <div class="idi-head">
        <span class="idi-eyebrow">Proceso tecnico</span>
        <h2>Como hacemos el diagnostico de iPhone paso a paso</h2>
        <p>El flujo cambia segun el sintoma, pero siempre buscamos confirmar causa, costo, riesgo y tiempo antes de que autorices una reparacion.</p>
      </div>
      <div class="idi-process">
        {process.map((item) => (
          <article>
            <span>{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="idi-section idi-dark">
    <div class="idi-container idi-split">
      <div>
        <span class="idi-eyebrow">Humedad en Cancun</span>
        <h2>iPhone mojado, con salitre o humedad: diagnostico antes de cargarlo</h2>
        <p>Si el iPhone tuvo lluvia, alberca, vapor, playa o salitre, no recomendamos cargarlo ni calentarlo. Primero se revisan indicadores, conectores, corrosion, bateria, pantalla, puerto y placa.</p>
        <a class="idi-btn idi-btn-secondary" href="/servicios/telefono/reparacion-humedad-iphone">Ver reparacion por humedad</a>
      </div>
      <div>
        <img class="idi-photo" src="/assets/images/responsive/reparacion-sulfatacion-cancun.webp" alt="Diagnostico de iPhone mojado o con humedad en Cancun" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="idi-section idi-light">
    <div class="idi-container">
      <div class="idi-head">
        <span class="idi-eyebrow">Despues del diagnostico</span>
        <h2>Te decimos si conviene reparar, esperar pieza o recuperar datos</h2>
        <p>Un buen diagnostico tambien debe decir cuando no conviene gastar. Te damos una ruta realista segun modelo, valor del equipo, refaccion, tiempo y riesgo.</p>
      </div>
      <div class="idi-grid-4">
        {decisionCards.map((item) => (
          <article class="idi-card">
            <i class={`fa-solid ${item.icon}`}></i>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="idi-section idi-soft">
    <div class="idi-container">
      <div class="idi-head">
        <span class="idi-eyebrow">Rutas de reparacion</span>
        <h2>Servicios que pueden salir del diagnostico iPhone</h2>
        <p>Si despues de revisar ya sabemos la causa, te mandamos a la reparacion correcta para pantalla, bateria, carga, camara, Face ID, audio, humedad o servicio completo.</p>
      </div>
      <div class="idi-route-grid">
        {repairRoutes.map((item) => (
          <a href={item.href} class="idi-route-card">
            <i class={`fa-solid ${item.icon}`}></i>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <span>Ver servicio</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="idi-section idi-light">
    <div class="idi-container">
      <div class="idi-head">
        <span class="idi-eyebrow">Modelos compatibles</span>
        <h2>Diagnostico para iPhone 11, 12, 13, 14, 15 y 16 en Cancun</h2>
        <p>Tambien podemos revisar modelos anteriores; la disponibilidad de piezas y el tipo de reparacion se confirma por modelo exacto.</p>
      </div>
      <div class="idi-models">
        {models.map((model) => <span><i class="fa-brands fa-apple"></i>{model}</span>)}
      </div>
    </div>
  </section>

  <section class="idi-section idi-dark">
    <div class="idi-container">
      <div class="idi-head">
        <span class="idi-eyebrow">Prepara tu visita</span>
        <h2>Que hacer antes de llevar tu iPhone a diagnostico</h2>
        <p>Estos pasos ayudan a proteger datos, reducir tiempos y evitar que una falla por humedad o carga empeore antes de llegar al taller.</p>
      </div>
      <div class="idi-grid-3">
        {beforeComing.map((item) => (
          <article class="idi-card">
            <i class={`fa-solid ${item.icon}`}></i>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="idi-related-shell">
    <RelatedServicesSection
      category={category}
      service={service}
      title="Servicios relacionados despues del diagnostico iPhone"
      eyebrow="Servicios relacionados"
      compact={true}
      includeCategoryServices={true}
      initialLimit={8}
    />
  </section>

  <FaqSection
    id="faq-diagnostico-iphone"
    title="Preguntas frecuentes sobre diagnostico iPhone en Cancun"
    description="Dudas sobre iPhone que no prende, no carga, pantalla negra, humedad, bateria, Face ID, camara, placa, software, datos y costos."
    items={faqItems}
    backgroundColor="#07111f"
    titleColor="#f8fafc"
    descriptionColor="#cfe7f6"
    questionColor="#f8fafc"
    faqAccent="#22d3ee"
    sectionClass="idi-faq"
  />

  <section class="idi-comments">
    <CommentsSection
      title="Opiniones de clientes que diagnosticaron su iPhone en Pixon PC"
