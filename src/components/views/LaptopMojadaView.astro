---
import Base from '../../layouts/Base.astro';
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import Breadcrumb from '../Breadcrumb.astro';
import FaqSection from '../FaqSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';

const pageTitle = 'Reparación de laptop mojada en Cancún | Daño por agua y corrosión';
const pageDescription = 'Servicio técnico para laptops mojadas en Cancún. Diagnóstico por daño de líquido, humedad, corrosión, limpieza profunda y revisión de tarjeta madre.';
const canonicalUrl = 'https://pixon.com.mx/servicios/laptop/laptop-mojada';
const whatsappUrl = 'https://wa.me/529986690777?text=Hola,%20mi%20laptop%20se%20moj%C3%B3%20y%20necesito%20una%20revisi%C3%B3n%20urgente.%20No%20la%20estoy%20encendiendo.';

const faqs = [
  { question: '¿Qué hago si mi laptop se mojó?', answer: 'Apágala, desconecta el cargador y no intentes prenderla. Lo ideal es llevarla a revisión cuanto antes para evitar corto o corrosión interna.' },
  { question: '¿Sirve meter la laptop en arroz?', answer: 'No es recomendable. El arroz no limpia residuos internos ni elimina corrosión. El líquido puede quedarse en la tarjeta, conectores o teclado.' },
  { question: '¿Una laptop mojada se puede salvar?', answer: 'Depende del tipo de líquido, el tiempo que pasó, si se encendió después del derrame y el nivel de daño en la tarjeta madre u otros componentes.' },
  { question: '¿Qué es la limpieza ultrasónica?', answer: 'Es un proceso de limpieza profunda que ayuda a remover residuos y corrosión en tarjetas electrónicas. Puede mejorar las posibilidades de rescate, pero no garantiza reparación si ya hubo daño eléctrico.' },
  { question: '¿Cuánto cuesta reparar una laptop mojada?', answer: 'El costo depende del diagnóstico. Puede requerir limpieza profunda, reparación de tarjeta madre, cambio de teclado, batería, cargador u otros componentes.' },
];

const relatedServices = [
  { href: '/reparaciones', icon: 'fa-laptop-medical', label: 'Reparación de laptop en Cancún', desc: 'Diagnóstico y reparación de pantalla, carga, batería, teclado, placa y fallas de encendido.' },
  { href: '/servicios/laptop/mantenimiento-preventivo', icon: 'fa-screwdriver-wrench', label: 'Mantenimiento de laptop en Cancún', desc: 'Limpieza interna, ventilación y revisión preventiva del equipo.' },
  { href: '/servicios/laptop/diagnostico', icon: 'fa-microchip', label: 'Diagnóstico de laptop', desc: 'Pruebas eléctricas para cortos, líneas de alimentación y componentes dañados.' },
  { href: '/servicios/laptop/cambio-teclado', icon: 'fa-keyboard', label: 'Cambio de teclado de laptop', desc: 'Reemplazo cuando el derrame afecta teclas, membrana, flex o conectores.' },
  { href: '/servicios/laptop/recuperacion-datos', icon: 'fa-hard-drive', label: 'Recuperación de información', desc: 'Evaluación de SSD o disco antes de insistir con encendidos que pongan en riesgo los archivos.' },
  { href: '/servicios/pc/diagnostico', icon: 'fa-desktop', label: 'Servicio técnico de computadoras en Cancún', desc: 'Diagnóstico de hardware, energía, almacenamiento y sistema para equipos de hogar o negocio.' },
  { href: '/servicios/laptop/formateo-windows-virus-cancun', icon: 'fa-window-restore', label: 'Formateo y Windows', desc: 'Respaldo, reinstalación limpia, drivers y optimización cuando el almacenamiento está sano.' },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonicalUrl}#service`,
  name: 'Reparación de laptop mojada en Cancún por daño de agua o humedad',
  serviceType: 'Diagnóstico y reparación de laptops dañadas por líquido, humedad y corrosión',
  url: canonicalUrl,
  image: 'https://pixon.com.mx/assets/images/responsive/reparacion-sulfatacion-cancun.webp',
  description: pageDescription,
  provider: { '@type': 'LocalBusiness', '@id': 'https://pixon.com.mx/#business', name: 'Pixon PC / Rentalap', telephone: '+529986690777', email: 'pixonpc@gmail.com' },
  areaServed: ['Cancún Centro', 'Zona Hotelera', 'Huayacán', 'Cumbres', 'Bonfil', 'Polígono Sur', 'Puerto Cancún', 'Av. Tulum', 'Bonampak', 'Puerto Juárez', 'Supermanzanas', 'Haciendas'],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://pixon.com.mx/' },
    { '@type': 'ListItem', position: 2, name: 'Servicios para laptop', item: 'https://pixon.com.mx/servicios/laptop' },
    { '@type': 'ListItem', position: 3, name: 'Laptop mojada', item: canonicalUrl },
  ],
};
---

<Base title={pageTitle} description={pageDescription} canonical={canonicalUrl} image="/assets/images/responsive/reparacion-sulfatacion-cancun.webp" schema={[serviceSchema, faqSchema, breadcrumbSchema]}>
  <Navbar />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Servicios', href: '/servicios' }, { label: 'Laptop', href: '/servicios/laptop' }, { label: 'Laptop mojada' }]} />

  <main class="wet-page">
    <header class="wet-hero">
      <div class="container wet-hero__grid">
        <div>
          <p class="wet-kicker">Atención prioritaria por derrame o humedad</p>
          <h1>Reparación de laptop mojada en Cancún por daño de agua o humedad</h1>
          <p class="wet-hero__lead">Si tu laptop se mojó, no la prendas ni la conectes. En Pixon PC revisamos daño por líquido, humedad y corrosión para aumentar las posibilidades de rescate del equipo.</p>
          <div class="wet-actions">
            <a class="wet-btn wet-btn--primary" href="#ticket-form">Solicitar revisión urgente</a>
            <a class="wet-btn wet-btn--secondary" href={whatsappUrl}><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Enviar mensaje por WhatsApp</a>
          </div>
          <div class="wet-fast" aria-label="Acciones inmediatas">
            <span><i class="fa-solid fa-power-off" aria-hidden="true"></i> No encender el equipo</span>
            <span><i class="fa-solid fa-plug-circle-xmark" aria-hidden="true"></i> No conectar el cargador</span>
            <span><i class="fa-solid fa-clock" aria-hidden="true"></i> Revisar el daño interno lo antes posible</span>
          </div>
        </div>
        <figure class="wet-hero__media">
          <img src="/assets/images/responsive/reparacion-sulfatacion-cancun.webp" alt="diagnóstico de laptop mojada en Cancún" width="720" height="720" loading="eager" fetchpriority="high" decoding="async" />
          <figcaption>Inspección de tarjeta madre bajo microscopio antes de energizar el equipo.</figcaption>
        </figure>
      </div>
    </header>

    <aside class="wet-alert" role="note">
      <div class="container wet-alert__inner"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i><p><strong>Importante:</strong> prender una laptop mojada puede causar corto en la tarjeta madre. Lo recomendable es desconectarla, apagarla y llevarla a revisión.</p></div>
    </aside>

    <section class="wet-section" id="que-hacer">
      <div class="container wet-two">
        <div><h2>Qué hacer si tu laptop se mojó</h2><p>La prioridad es detener el paso de corriente y evitar que el líquido se mueva hacia más conectores. No hace falta probar si todavía funciona: esa prueba puede convertir un derrame reparable en un corto.</p></div>
        <ol class="wet-steps">
          <li>Apágala inmediatamente.</li><li>Desconecta el cargador.</li><li>No intentes prenderla para probar.</li><li>No uses secadora ni calor directo.</li><li>No la pongas al sol.</li><li>No la metas en arroz.</li><li>Mantenla apagada y en una posición segura.</li><li>Llévala a diagnóstico lo antes posible.</li>
        </ol>
      </div>
    </section>

    <section class="wet-section wet-section--soft">
      <div class="container wet-two">
        <div><h2>Errores que debes evitar después de un derrame</h2><p>Encenderla, conectar el cargador o esperar varios días pensando que ya se secó puede acelerar el daño. Tampoco conviene usar secadora, ponerla al sol, meterla en arroz ni limpiar solo la parte exterior.</p><p>Seguir usándola porque todavía prende deja corriente circulando sobre residuos y humedad.</p></div>
        <blockquote>“Que una laptop prenda después de mojarse no significa que esté fuera de riesgo. La corrosión puede avanzar con el tiempo.”</blockquote>
      </div>
    </section>

    <section class="wet-section">
      <div class="container wet-two">
        <div><h2>Diagnóstico de daño por líquido en laptop</h2><p>Primero abrimos y revisamos el nivel real de daño. No prometemos reparación antes de identificar por dónde entró el líquido, qué zonas conservaron humedad y si hubo corriente durante el derrame.</p><p>El diagnóstico define si basta una limpieza, si debe repararse la tarjeta o si conviene proteger primero el SSD y la información.</p></div>
        <aside class="wet-panel"><h3>Componentes que revisamos</h3><ul><li>Tarjeta madre y zonas con humedad</li><li>Corrosión y conectores internos</li><li>Teclado y touchpad</li><li>Batería y puerto de carga</li><li>Flex de pantalla</li><li>Disco duro o SSD</li></ul></aside>
      </div>
    </section>

    <section class="wet-section wet-section--blue">
      <div class="container wet-grid">
        <article><h2>Limpieza ultrasónica para tarjetas dañadas</h2><p>La limpieza ultrasónica ayuda a remover residuos, minerales y corrosión en zonas delicadas de la tarjeta madre. Sin embargo, si ya hubo corto o componentes dañados, puede requerirse reparación adicional.</p><p>No es un proceso mágico ni garantiza recuperación total: su utilidad depende del líquido, tiempo transcurrido y daño eléctrico.</p></article>
        <article><h2>Reparación por corrosión en laptop</h2><p>La corrosión puede aparecer después de horas o días. Revisamos conectores sulfatados, pistas dañadas, componentes quemados, fallas intermitentes, teclado, puertos y equipos que prenden pero fallan.</p><p>En Cancún, la humedad ambiental puede acelerar este proceso si quedaron residuos dentro del equipo.</p></article>
      </div>
    </section>

    <section class="wet-section">
      <div class="container wet-two">
        <div><h2>Daño por humedad en laptops en Cancún</h2><p>La humedad, el salitre y el ambiente tropical pueden acelerar la corrosión interna, sobre todo en equipos que ya tuvieron contacto con líquido o se usan cerca de ventanas, playa, oficinas húmedas, hoteles o espacios sin buena ventilación.</p><p>Una revisión interna permite distinguir polvo húmedo, residuos de derrame y corrosión activa antes de que aparezcan fallas mayores.</p></div>
        <div class="wet-signal"><h2>Señales de que una laptop tiene corrosión interna</h2><ul><li>No enciende o se apaga sola.</li><li>No carga.</li><li>El teclado o touchpad falla.</li><li>La pantalla parpadea.</li><li>Los puertos USB dejan de responder.</li><li>Se calienta de forma extraña.</li><li>Huele a quemado.</li><li>Hay manchas verdes, blancas o negras internamente.</li></ul></div>
      </div>
    </section>

    <section class="wet-section wet-section--soft">
      <div class="container wet-grid">
        <article><h2>Laptop mojada que no enciende</h2><p>Puede existir corto en tarjeta madre, batería dañada, puerto de carga afectado, teclado en corto, flex o conectores dañados, o afectación en el SSD.</p><p class="wet-callout">No se debe insistir conectando cargadores diferentes. Eso puede empeorar el daño.</p></article>
        <article><h2>Laptop mojada que prende pero falla</h2><p>Puede presentar fallas de teclado, audio o WiFi, líneas en pantalla, apagones repentinos, carga irregular, lentitud, bloqueos o puertos que dejan de responder.</p><p class="wet-callout">En estos casos se recomienda revisión interna antes de seguir usándola.</p></article>
      </div>
    </section>

    <section class="wet-section">
      <div class="container wet-two">
        <div><h2>¿Se puede salvar una laptop dañada por agua?</h2><p><strong>Depende del tipo de líquido, el tiempo que pasó, si se encendió después del derrame y qué componentes fueron afectados.</strong></p><p>No se comportan igual el agua simple, café, refresco, alcohol, agua salada, líquidos con azúcar o humedad acumulada. Los residuos conductivos y azucarados suelen requerir una limpieza más profunda.</p></div>
        <aside class="wet-panel"><h3>La revisión considera</h3><ul><li>Tipo y cantidad de líquido</li><li>Tiempo antes de apagarla</li><li>Intentos de encendido posteriores</li><li>Zonas alcanzadas</li><li>Corrosión visible o bajo componentes</li><li>Estado del almacenamiento</li></ul></aside>
      </div>
    </section>

    <section class="wet-section wet-section--blue">
      <div class="container wet-two">
        <div><h2>Costo de reparar una laptop mojada</h2><p>El costo puede variar según el daño interno. Primero se realiza diagnóstico para saber si basta con limpieza profunda o si hay componentes que reparar o reemplazar.</p></div>
        <ul class="wet-cost"><li>Limpieza interna profunda o ultrasónica</li><li>Reparación de tarjeta madre</li><li>Cambio de teclado o batería</li><li>Revisión de SSD</li><li>Revisión de puerto de carga</li></ul>
      </div>
    </section>

    <section class="wet-urgent">
      <div class="container wet-urgent__inner"><div><h2>Servicio urgente para laptops mojadas en Cancún</h2><p>Mientras menos tiempo pase encendida o húmeda, mejores posibilidades hay de evitar daño mayor. Agenda una revisión lo antes posible y evita seguir conectando o prendiendo el equipo.</p></div><a class="wet-btn wet-btn--light" href="#ticket-form">Crear ticket urgente</a></div>
    </section>

    <ServiceTicketSection defaultDevice="Laptop" defaultService="Laptop mojada, humedad y corrosión" title="Solicitar revisión de laptop mojada" subtitle="Indica qué líquido cayó, cuándo ocurrió y si el equipo se encendió o conectó después del derrame." />
    <RelatedServicesSection title="Servicios relacionados con daño por líquido" eyebrow="Diagnóstico y recuperación" items={relatedServices} initialLimit={7} compact={true} light={true} />
    <FaqSection title="Preguntas frecuentes sobre laptops mojadas" description="Qué hacer, qué evitar y cómo se determina si el equipo puede repararse." items={faqs} id="faq-laptop-mojada" backgroundColor="#f8fafc" titleColor="#071F3A" descriptionColor="#334155" questionColor="#071F3A" viewMoreHref="/preguntas-frecuentes" viewMoreLabel="Ver todas las preguntas" />
    <CommentsSection viewMoreHref="/comentarios" />
    <ContactSection id="ubicacion" />
  </main>
  <Footer />

  <style>
    .wet-page{--ink:#071F3A;--muted:#334155;--line:#D6E0EC;--soft:#F7FAFC;--blue:#1659B7;--amber:#D97706;background:#fff;color:var(--ink)}
    .wet-hero{padding:clamp(54px,7vw,88px) 0 clamp(36px,5vw,56px);background:#EEF5FC;border-bottom:1px solid var(--line)}
    .wet-hero__grid,.wet-two,.wet-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(300px,.95fr);gap:clamp(20px,4vw,52px);align-items:center}
    .wet-kicker{display:inline-flex;margin:0 0 12px;padding:7px 12px;border:1px solid #F0C98A;border-radius:999px;background:#FFF8E8;color:#8A4B08!important;font-weight:850}
    .wet-hero h1{margin:0;max-width:720px;color:var(--ink);font-family:'Kanit',sans-serif;font-size:clamp(1.8rem,3.3vw,3rem);line-height:.94;letter-spacing:-.02em;text-wrap:balance}
    .wet-hero__lead{margin:16px 0 0;max-width:690px;color:var(--muted)!important;font-size:clamp(.98rem,1.4vw,1.1rem);line-height:1.52}
    .wet-actions,.wet-fast{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}.wet-fast{gap:8px 14px}.wet-fast span{display:flex;align-items:center;gap:8px;color:var(--ink)!important;font-weight:800;font-size:.94rem}.wet-fast i{color:var(--amber)}
    .wet-btn{min-height:48px;display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:13px 20px;border:1px solid transparent;border-radius:10px;font-weight:850;text-decoration:none;transition:transform 160ms cubic-bezier(.23,1,.32,1),background-color 160ms ease}.wet-btn:active{transform:scale(.98)}.wet-btn:focus-visible,a:focus-visible{outline:3px solid #F59E0B;outline-offset:3px}.wet-btn--primary{background:var(--blue);color:#fff!important}.wet-btn--primary:hover{background:#104A9C}.wet-btn--secondary{background:#fff;border-color:#AFC6DF;color:var(--ink)!important}.wet-btn--secondary:hover{background:#E4EDF7}
    .wet-hero__media{margin:0;position:relative}.wet-hero__media img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:14px;box-shadow:0 20px 48px rgba(7,31,58,.16)}.wet-hero__media figcaption{position:absolute;left:14px;right:14px;bottom:14px;padding:12px 14px;border-radius:10px;background:rgba(255,255,255,.94);color:var(--ink)!important;font-weight:800;line-height:1.3;font-size:.95rem}
    .wet-alert{background:#FFF8E8;border-bottom:1px solid #F0D39F}.wet-alert__inner{display:flex;align-items:flex-start;gap:14px;padding-top:20px;padding-bottom:20px}.wet-alert i{margin-top:3px;color:var(--amber);font-size:1.2rem}.wet-alert p{margin:0;color:var(--ink)!important;line-height:1.55}
    .wet-section{padding:clamp(54px,8vw,90px) 0;background:#fff}.wet-section--soft{background:var(--soft)}.wet-section--blue{background:#EDF5FF}.wet-section h2{margin:0 0 16px;color:var(--ink)!important;font-family:'Kanit',sans-serif;font-size:clamp(1.72rem,3vw,2.5rem);line-height:1.08;text-wrap:balance}.wet-section h3{margin:0 0 14px;color:var(--ink)!important;font-size:1.3rem}.wet-section p{margin:0 0 14px;max-width:72ch;color:var(--muted)!important;font-size:1.03rem;line-height:1.72}.wet-grid{align-items:stretch}.wet-grid article{padding-right:clamp(0px,2vw,24px)}
    .wet-steps{list-style:none;counter-reset:wet;padding:0;margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.wet-steps li{counter-increment:wet;display:flex;align-items:center;gap:10px;padding:12px 0;border-bottom:1px solid var(--line);color:var(--ink)!important;font-weight:750}.wet-steps li:before{content:counter(wet);display:grid;place-items:center;flex:0 0 30px;height:30px;border-radius:50%;background:#E1ECF9;color:#174EA6;font-weight:900}
    blockquote{margin:0;padding:clamp(24px,4vw,38px);border-left:5px solid var(--amber);background:#fff;color:var(--ink)!important;font-family:'Kanit',sans-serif;font-size:clamp(1.35rem,2.5vw,2rem);line-height:1.3}
    .wet-panel{padding:clamp(22px,3vw,30px);border:1px solid var(--line);border-radius:12px;background:#fff}.wet-panel ul,.wet-signal ul,.wet-cost{list-style:none;padding:0;margin:0;display:grid;gap:10px}.wet-panel li,.wet-signal li,.wet-cost li{position:relative;padding-left:21px;color:var(--ink)!important;font-weight:750;line-height:1.45}.wet-panel li:before,.wet-signal li:before,.wet-cost li:before{content:'';position:absolute;left:0;top:.62em;width:7px;height:7px;border-radius:50%;background:var(--blue)}
    .wet-callout{padding:14px 16px;border-left:4px solid var(--amber);background:#FFF8E8;color:var(--ink)!important;font-weight:850}.wet-cost{align-content:center;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 24px}
    .wet-urgent{padding:clamp(42px,6vw,62px) 0;background:#F7FAFF;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.wet-urgent__inner{display:flex;align-items:center;justify-content:space-between;gap:28px}.wet-urgent h2{margin:0 0 10px;color:var(--ink);font-family:'Kanit',sans-serif;font-size:clamp(1.55rem,2.8vw,2.35rem)}.wet-urgent p{margin:0;max-width:780px;color:var(--muted)!important;line-height:1.65}.wet-btn--light{background:var(--blue);color:#fff!important;flex:0 0 auto}.wet-btn--light:hover{background:#104A9C}
    .service-ticket-section{scroll-margin-top:92px}
    .wet-page .service-ticket-section :is(h2,h3,p,li,strong,label,span){color:var(--ink)!important}
    .wet-page .service-ticket-section p{color:var(--muted)!important}
    .wet-page .contact :is(h2,h3,p,li,strong),.wet-page .faq-page-content :is(h2,h3,p,li,strong),.wet-page .svc-related--light :is(h2,h3,h4,p),.wet-page .comments-section :is(h2,h3,p,li,strong){color:var(--ink)!important}
    @media(max-width:820px){.wet-hero__grid,.wet-two,.wet-grid{grid-template-columns:1fr}.wet-hero{padding-top:50px}.wet-hero__media{order:2}.wet-hero__media img{aspect-ratio:16/11;max-height:320px}.wet-hero__media figcaption{left:12px;right:12px;bottom:12px;padding:10px 12px;font-size:.9rem}.wet-urgent__inner{align-items:flex-start;flex-direction:column}.wet-steps,.wet-cost{grid-template-columns:1fr}.wet-btn{width:100%}}
    @media(prefers-reduced-motion:reduce){.wet-btn{transition:none}}
  </style>
</Base>
