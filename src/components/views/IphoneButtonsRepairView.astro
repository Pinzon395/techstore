---
import FaqSection from '../FaqSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import Footer from '../Footer.astro';

const { service, category } = Astro.props;

const waMsg = encodeURIComponent('Hola, quiero cotizar reparacion de botones iPhone en Cancun. Mi iPhone tiene falla en power, volumen, silencio, home o botones laterales.');

const keywords = [
  'reparacion botones iPhone Cancun',
  'boton power iPhone no funciona',
  'boton volumen iPhone no responde',
  'switch silencio iPhone falla',
  'boton home iPhone no funciona',
  'iPhone no enciende boton power',
  'iPhone sube volumen solo',
  'botones iPhone hundidos',
  'flex botones iPhone',
  'servicio tecnico iPhone Cancun',
];

const symptoms = [
  { icon: 'fa-power-off', title: 'Boton power no funciona', text: 'El iPhone no bloquea, no enciende con boton, no apaga pantalla o el boton se siente duro, hundido o sin clic.', tag: 'boton power iPhone' },
  { icon: 'fa-volume-high', title: 'Volumen no responde', text: 'Los botones de volumen no suben, no bajan, se activan solos o solo funcionan al presionar muy fuerte.', tag: 'volumen iPhone falla' },
  { icon: 'fa-toggle-on', title: 'Switch de silencio falla', text: 'El iPhone no entra o no sale de modo silencio, vibra raro o el switch se queda flojo.', tag: 'mute iPhone' },
  { icon: 'fa-house', title: 'Boton Home no responde', text: 'En modelos compatibles revisamos home, flex, clic, Touch ID, humedad y reparacion previa.', tag: 'home iPhone' },
  { icon: 'fa-mobile-screen-button', title: 'Botones laterales hundidos', text: 'Golpes, funda apretada o carcasa doblada pueden dejar botones atorados o sin recorrido.', tag: 'botones hundidos' },
  { icon: 'fa-bell', title: 'Volumen se activa solo', text: 'Puede ser boton presionado, flex dañado, humedad, suciedad, carcasa deformada o funda que hace presion.', tag: 'volumen se sube solo' },
  { icon: 'fa-droplet', title: 'Falla despues de mojarse', text: 'La humedad puede afectar flex, conectores, botones, placa y activar falsos contactos.', tag: 'humedad' },
  { icon: 'fa-screwdriver-wrench', title: 'Fallo tras reparacion previa', text: 'Si empezo despues de pantalla, bateria o carcasa, revisamos ensamble, flex y conectores.', tag: 'reparacion previa' },
];

const buttonTypes = [
  { icon: 'fa-power-off', title: 'Power / bloqueo', text: 'Diagnostico para iPhone que no bloquea, no despierta, no apaga pantalla o no responde al boton lateral.' },
  { icon: 'fa-volume-high', title: 'Volumen arriba y abajo', text: 'Revisamos botones fisicos, flex, carcasa, funda, configuracion, humedad y falsos contactos.' },
  { icon: 'fa-bell-slash', title: 'Silencio / mute', text: 'Cuando el switch se siente flojo, no cambia modo, vibra solo o queda trabado en silencio.' },
  { icon: 'fa-fingerprint', title: 'Home / Touch ID', text: 'En modelos con Home revisamos clic, flex, sensibilidad, humedad y funciones relacionadas.' },
];

const diagnosis = [
  ['01', 'Prueba fisica del boton', 'Revisamos recorrido, clic, presion, si esta hundido, si se atora o si la funda lo presiona.'],
  ['02', 'Prueba en sistema', 'Probamos bloqueo, apagado, capturas, volumen, silencio, AssistiveTouch y respuesta del equipo.'],
  ['03', 'Revision de carcasa', 'Buscamos golpes, marco doblado, suciedad, humedad o deformacion que impida el movimiento normal.'],
  ['04', 'Revision interna si aplica', 'Si la falla persiste, revisamos flex, conectores, tornilleria, humedad y reparaciones previas.'],
];

const causes = [
  { icon: 'fa-mobile-screen', title: 'Golpe o marco doblado', text: 'Una caida puede presionar el boton, deformar la carcasa o dejar el flex fuera de posicion.' },
  { icon: 'fa-droplet-slash', title: 'Humedad o corrosion', text: 'Liquido, vapor, sudor o salitre pueden generar falso contacto en botones y flex.' },
  { icon: 'fa-hand', title: 'Funda que presiona', text: 'Algunas fundas rigidas dejan volumen o power presionado y parecen una falla interna.' },
  { icon: 'fa-clock-rotate-left', title: 'Desgaste por uso', text: 'Con el tiempo el boton puede perder clic, quedar duro o necesitar reemplazo del flex.' },
  { icon: 'fa-screwdriver', title: 'Ensamble previo', text: 'Despues de abrir el iPhone, un conector mal asentado o tornillo incorrecto puede afectar botones.' },
  { icon: 'fa-microchip', title: 'Falla en placa', text: 'Si el flex y boton estan bien, se revisa consumo, linea de señal o daño interno.' },
];

const process = [
  { step: '01', title: 'Recepcion y sintomas', text: 'Confirmamos modelo, boton afectado, si hubo golpe, humedad, funda apretada o reparacion previa.' },
  { step: '02', title: 'Pruebas externas', text: 'Probamos power, volumen, silencio, capturas, bloqueo, apagado, vibracion y respuesta en iOS.' },
  { step: '03', title: 'Revision fisica', text: 'Inspeccionamos marco, botones, recorrido, suciedad, carcasa y presion de funda.' },
  { step: '04', title: 'Diagnostico interno', text: 'Si hace falta abrir, revisamos flex, conectores, humedad, tornillos y ensamble.' },
  { step: '05', title: 'Reparacion o reemplazo', text: 'Te decimos si conviene ajuste, limpieza, cambio de flex, boton, carcasa o revision de placa.' },
  { step: '06', title: 'Pruebas finales', text: 'Validamos botones, volumen, silencio, bloqueo, capturas, apagado y funciones relacionadas.' },
];

const tests = [
  { icon: 'fa-power-off', title: 'Bloqueo y encendido', text: 'Probamos que el boton lateral bloquee, despierte y responda de forma estable.' },
  { icon: 'fa-volume-high', title: 'Volumen', text: 'Validamos volumen arriba, abajo, capturas y que no se active solo.' },
  { icon: 'fa-bell-slash', title: 'Modo silencio', text: 'Confirmamos que el switch cambie estado y no quede trabado.' },
  { icon: 'fa-vibrate', title: 'Vibracion', text: 'Probamos respuesta haptica o vibracion relacionada al switch cuando aplica.' },
  { icon: 'fa-fingerprint', title: 'Home / Touch ID', text: 'En modelos compatibles verificamos clic y funciones disponibles.' },
  { icon: 'fa-circle-check', title: 'Uso real', text: 'Revisamos que la funda no presione y que el boton responda sin fuerza excesiva.' },
];

const care = [
  { icon: 'fa-shield-halved', title: 'Usa funda compatible', text: 'Evita fundas que presionen power o volumen de forma constante.' },
  { icon: 'fa-droplet-slash', title: 'Evita humedad', text: 'Vapor, playa, lluvia y sudor pueden afectar flex y conectores.' },
  { icon: 'fa-hand-pointer', title: 'No fuerces el boton', text: 'Si esta duro o hundido, forzarlo puede dañar flex o carcasa.' },
  { icon: 'fa-broom', title: 'No limpies con liquidos', text: 'Alcohol, aerosoles o limpiadores pueden entrar por el boton y empeorar la falla.' },
  { icon: 'fa-mobile-screen-button', title: 'Atiende golpes en marco', text: 'Si el marco esta doblado, puede volver a trabar el boton aunque el flex sea nuevo.' },
  { icon: 'fa-comment-dots', title: 'Describe el sintoma exacto', text: 'Dinos si falla power, volumen, silencio, home, capturas o si se activa solo.' },
];

const relatedItems = [
  { href: '/servicios/telefono/diagnostico-iphone', icon: 'fa-stethoscope', label: 'Diagnostico iPhone', desc: 'Si no sabes si falla boton, flex, carcasa, humedad o placa.' },
  { href: '/servicios/telefono/reparacion-pantalla-iphone', icon: 'fa-mobile-screen', label: 'Reparacion de pantalla iPhone', desc: 'Una caida puede dañar pantalla y botones laterales al mismo tiempo.' },
  { href: '/servicios/telefono/reparacion-carga-iphone', icon: 'fa-plug', label: 'Reparacion de carga iPhone', desc: 'Util si el boton fallo junto con carga, microfono o humedad.' },
  { href: '/servicios/telefono/reparacion-humedad-iphone', icon: 'fa-droplet', label: 'Reparacion por humedad iPhone', desc: 'Para botones que fallan despues de lluvia, vapor, alberca o salitre.' },
  { href: '/servicios/telefono/reparacion-bocina-iphone', icon: 'fa-volume-high', label: 'Reparacion de bocina iPhone', desc: 'Si ademas fallan volumen, audio, auricular o llamadas.' },
  { href: '/servicios/telefono/reparacion-iphone', icon: 'fa-screwdriver-wrench', label: 'Servicio tecnico iPhone', desc: 'Revision general para pantalla, bateria, carga, botones, audio, camaras y humedad.' },
];

const models = [
  'iPhone 16 Pro Max', 'iPhone 16 Pro', 'iPhone 16 Plus', 'iPhone 16',
  'iPhone 15 Pro Max', 'iPhone 15 Pro', 'iPhone 15 Plus', 'iPhone 15',
  'iPhone 14 Pro Max', 'iPhone 14 Pro', 'iPhone 14 Plus', 'iPhone 14',
  'iPhone 13 Pro Max', 'iPhone 13 Pro', 'iPhone 13 Mini', 'iPhone 13',
  'iPhone 12 Pro Max', 'iPhone 12 Pro', 'iPhone 12 Mini', 'iPhone 12',
  'iPhone 11 Pro Max', 'iPhone 11 Pro', 'iPhone 11', 'iPhone XR', 'iPhone XS',
  'iPhone 8 Plus', 'iPhone 8', 'iPhone SE',
];

const faqItems = [
  { question: 'Cuanto cuesta reparar botones de iPhone en Cancun?', answer: 'Depende del modelo, boton afectado y si la falla viene de boton fisico, flex, carcasa, humedad o placa. Primero revisamos el sintoma para cotizar con claridad.' },
  { question: 'Que botones de iPhone reparan?', answer: 'Revisamos boton power, volumen arriba, volumen abajo, switch de silencio, boton lateral, home en modelos compatibles, flex y funciones relacionadas como capturas, bloqueo y vibracion.' },
  { question: 'Mi iPhone sube o baja volumen solo, que puede ser?', answer: 'Puede ser funda presionando, boton atorado, flex dañado, humedad, marco doblado o falso contacto. No conviene cambiar pieza sin revisar presion fisica y comportamiento en sistema.' },
  { question: 'Si el boton power no funciona, pueden encender el iPhone?', answer: 'Podemos diagnosticar si el problema es boton, bateria, carga, pantalla o placa. Un iPhone que no enciende no siempre falla por boton power.' },
  { question: 'La reparacion de botones borra mis datos?', answer: 'No. Una reparacion fisica de botones normalmente no borra informacion. Si detectamos una falla de software o se requiere restauracion, te avisamos antes.' },
  { question: 'Cuanto tarda reparar botones de iPhone?', answer: 'Depende de modelo, disponibilidad de refaccion y si hay humedad o golpe en carcasa. Despues del diagnostico te damos tiempo estimado antes de iniciar.' },
  { question: 'Dan garantia por reparacion de botones iPhone?', answer: 'Si, entregamos garantia por escrito sobre la reparacion realizada, excepto daños posteriores por golpe, humedad, carcasa doblada, manipulacion externa o funda que vuelva a presionar el boton.' },
];
---

<div class="ibt-page">
  <section class="ibt-hero">
    <div class="ibt-container ibt-hero-grid">
      <div>
        <span class="ibt-eyebrow"><i class="fa-brands fa-apple"></i> Servicio tecnico iPhone en Cancun</span>
        <h1>Reparacion de botones iPhone en Cancun</h1>
        <h2>Power, volumen, switch de silencio, Home, boton lateral, flex y fallas por golpe o humedad</h2>
        <p class="ibt-lead">Si tu iPhone no bloquea, no sube volumen, se queda en silencio, los botones se hundieron o se activan solos, revisamos boton fisico, flex, carcasa, funda, humedad y placa antes de cambiar piezas.</p>
        <p>La falla de botones puede parecer simple, pero muchas veces viene de golpe en el marco, humedad, flex dañado, reparacion previa o una funda que presiona. Por eso hacemos diagnostico por sintoma.</p>
        <div class="ibt-keywords">
          {keywords.map((keyword) => <span>{keyword}</span>)}
        </div>
        <div class="ibt-actions">
          <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="ibt-btn ibt-btn-primary"><i class="fa-brands fa-whatsapp"></i> Cotizar botones iPhone</a>
          <a href="#fallas-botones" class="ibt-btn ibt-btn-secondary"><i class="fa-solid fa-arrow-down"></i> Ver fallas</a>
        </div>
      </div>
      <aside class="ibt-hero-card">
        <div class="ibt-phone-visual" aria-hidden="true">
          <div class="ibt-phone">
            <span class="ibt-notch"></span>
            <i class="fa-brands fa-apple"></i>
            <span class="ibt-side ibt-side-power"></span>
            <span class="ibt-side ibt-side-vol-a"></span>
            <span class="ibt-side ibt-side-vol-b"></span>
            <span class="ibt-pulse"></span>
          </div>
        </div>
        <div class="ibt-card-body">
          <h3>Pruebas de botones</h3>
          <ul>
            {['Power / bloqueo', 'Volumen arriba y abajo', 'Switch de silencio', 'Home y Touch ID si aplica', 'Flex y conectores', 'Golpe, funda o humedad'].map((item) => (
              <li><i class="fa-solid fa-check"></i>{item}</li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <ServiceTicketSection
    defaultDevice="iPhone"
    defaultService="Reparacion de botones iPhone"
    sourcePage="/servicios/telefono/reparacion-botones-iphone"
    title="Crear ticket de reparacion de botones iPhone"
    subtitle="Cuentanos si falla power, volumen, silencio, Home, si hubo golpe, humedad, funda apretada o reparacion previa."
  />

  <section class="ibt-section ibt-light" id="fallas-botones">
    <div class="ibt-container">
      <div class="ibt-head">
        <span class="ibt-eyebrow">Fallas mas comunes</span>
        <h2>Problemas de botones iPhone que diagnosticamos antes de cotizar</h2>
        <p>No todos los botones se reparan igual. Primero ubicamos si la falla esta en el boton fisico, flex, carcasa, humedad, software, funda o placa.</p>
      </div>
      <div class="ibt-grid ibt-grid-4">
        {symptoms.map((item) => (
          <article class="ibt-card">
            <i class={`fa-solid ${item.icon}`}></i>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <small>{item.tag}</small>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ibt-section ibt-soft">
    <div class="ibt-container ibt-split">
      <div>
        <span class="ibt-eyebrow">Tipos de botones</span>
        <h2>Power, volumen, silencio y Home requieren diagnosticos distintos</h2>
        <p>En iPhone, varios botones dependen de flex internos, carcasa y conectores. Si el marco esta doblado o hubo humedad, cambiar solo el boton puede no resolver la falla.</p>
        <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="ibt-btn ibt-btn-primary">Quiero revisar mi iPhone</a>
      </div>
      <div class="ibt-grid ibt-grid-2">
        {buttonTypes.map((item) => (
          <article class="ibt-card">
            <i class={`fa-solid ${item.icon}`}></i>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ibt-section ibt-light">
    <div class="ibt-container ibt-diagnosis-grid">
      <div>
        <span class="ibt-eyebrow">Diagnostico claro</span>
        <h2>Como sabemos si falla el boton, el flex, la carcasa o la placa</h2>
        <p>Probamos primero sin abrir cuando es posible. Si el sintoma apunta a flex, humedad o ensamble, revisamos internamente con autorizacion.</p>
      </div>
      <div class="ibt-steps">
        {diagnosis.map(([n, title, text]) => (
          <article>
            <span>{n}</span>
            <div>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ibt-section ibt-soft">
    <div class="ibt-container ibt-split">
      <div>
        <img class="ibt-photo" src="/assets/images/responsive/reparacion-celulares-cancun.webp" alt="Tecnico revisando botones de iPhone en Cancun" loading="lazy" />
      </div>
      <div>
        <span class="ibt-eyebrow">Causas reales</span>
        <h2>Por que fallan los botones de un iPhone</h2>
        <p>La causa puede estar fuera del boton: marco doblado, funda, humedad, flex, tornilleria o una reparacion previa. Revisar eso evita gastar en piezas incorrectas.</p>
        <div class="ibt-cause-list">
          {causes.map((item) => (
            <article>
              <i class={`fa-solid ${item.icon}`}></i>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="ibt-section ibt-light">
    <div class="ibt-container">
      <div class="ibt-head">
        <span class="ibt-eyebrow">Proceso tecnico</span>
        <h2>Proceso para reparar botones iPhone en Cancun</h2>
        <p>Trabajamos con pruebas, diagnostico y cotizacion antes de abrir o instalar refacciones.</p>
      </div>
      <div class="ibt-process">
        {process.map((item) => (
          <article>
            <span>{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ibt-section ibt-soft">
    <div class="ibt-container ibt-split">
      <div>
        <span class="ibt-eyebrow">Humedad y golpes</span>
        <h2>Si el boton fallo despues de agua o una caida, revisamos mas que el flex</h2>
        <p>Un golpe puede doblar carcasa y dejar el boton presionado. La humedad puede provocar falso contacto y dañar conectores. En ambos casos conviene diagnosticar antes de instalar pieza nueva.</p>
        <a href="/servicios/telefono/reparacion-humedad-iphone" class="ibt-btn ibt-btn-secondary">Ver revision por humedad</a>
      </div>
      <div>
        <img class="ibt-photo" src="/assets/images/responsive/reparacion-sulfatacion-cancun.webp" alt="Revision de humedad en botones y flex de iPhone" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="ibt-section ibt-light">
    <div class="ibt-container">
      <div class="ibt-head">
        <span class="ibt-eyebrow">Pruebas finales</span>
        <h2>Que probamos antes de entregar tu iPhone</h2>
        <p>No entregamos solo porque el boton ya hace clic. Probamos funciones reales para confirmar que no haya falsos contactos.</p>
      </div>
      <div class="ibt-grid">
        {tests.map((item) => (
          <article class="ibt-card">
            <i class={`fa-solid ${item.icon}`}></i>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ibt-section ibt-soft">
    <div class="ibt-container">
      <div class="ibt-head">
        <span class="ibt-eyebrow">Modelos compatibles</span>
        <h2>Reparacion de botones para iPhone 8, SE, 11, 12, 13, 14, 15 y 16</h2>
        <p>Confirmamos disponibilidad por modelo exacto, boton afectado y tipo de flex. Modelos con Home o Touch ID requieren revision especial.</p>
      </div>
      <div class="ibt-models">
        {models.map((model) => <span><i class="fa-brands fa-apple"></i>{model}</span>)}
      </div>
    </div>
  </section>

  <section class="ibt-section ibt-light">
    <div class="ibt-container">
      <div class="ibt-head">
        <span class="ibt-eyebrow">Cuidados posteriores</span>
        <h2>Como evitar que vuelvan a fallar los botones</h2>
        <p>Despues de reparar, conviene evitar presion excesiva, fundas incompatibles y humedad para conservar el recorrido y el clic correcto.</p>
      </div>
      <div class="ibt-grid">
        {care.map((item) => (
          <article class="ibt-card">
            <i class={`fa-solid ${item.icon}`}></i>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ibt-related-shell">
    <RelatedServicesSection
      items={relatedItems}
      title="Servicios relacionados con botones iPhone"
      eyebrow="Servicios relacionados"
      compact={true}
    />
  </section>

  <FaqSection
    id="faq-botones-iphone"
    title="Preguntas frecuentes sobre reparacion de botones iPhone en Cancun"
    description="Dudas sobre boton power, volumen, switch de silencio, Home, flex, carcasa, humedad, tiempos, precio y garantia."
    items={faqItems}
    backgroundColor="#07111f"
    titleColor="#f8fafc"
    descriptionColor="#cfe7f6"
    questionColor="#f8fafc"
    faqAccent="#22d3ee"
    sectionClass="ibt-faq"
  />

  <section class="ibt-comments">
    <CommentsSection
      title="Opiniones de clientes que repararon su iPhone en Pixon PC"
      description="Clientes en Cancun con fallas de botones, pantalla, bateria, carga, audio, humedad y diagnostico iPhone."
      dark={true}
      viewMoreHref="/comentarios"
      viewMoreLabel="Ver todas las reseñas"
      id="comentarios"
    />
  </section>

  <section class="ibt-contact-intro">
    <div class="ibt-container">
      <span class="ibt-eyebrow">Taller local en Cancun</span>
      <h2>Agenda reparacion de botones iPhone</h2>
      <p>Envia modelo, boton afectado y si hubo golpe, humedad o reparacion previa. Te orientamos por WhatsApp antes de traerlo.</p>
      <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="ibt-btn ibt-btn-primary"><i class="fa-brands fa-whatsapp"></i> Cotizar por WhatsApp</a>
    </div>
  </section>

  <section class="ibt-contact-shell">
    <ContactSection id="ubicacion" />
  </section>
</div>

<Footer />

<style is:global>
  .ibt-page {
    --ibt-ink: #0f2a4a;
    --ibt-muted: #334155;
    --ibt-blue: #1d4ed8;
    --ibt-cyan: #22d3ee;
    --ibt-soft: #eef7ff;
    --ibt-light: #f8fafc;
    --ibt-border: #dbe7f3;
    --ibt-dark: #07111f;
    background: var(--ibt-light);
    color: var(--ibt-ink);
    overflow-x: hidden;
  }
  .ibt-container { max-width: 1180px; margin: 0 auto; padding-inline: var(--page-gutter); }
  .ibt-hero { padding: 86px 0 74px; background: radial-gradient(circle at 84% 12%, rgba(34,211,238,.18), transparent 30%), linear-gradient(180deg, #f8fafc, #eef7ff); }
  .ibt-hero-grid, .ibt-split, .ibt-diagnosis-grid { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(320px, .72fr); gap: 40px; align-items: center; }
  .ibt-eyebrow { display: inline-flex; align-items: center; gap: 8px; color: var(--ibt-blue); font-size: .78rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 12px; }
