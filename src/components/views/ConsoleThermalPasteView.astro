---
import FaqSection from '../FaqSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';

const { service, category } = Astro.props;

const waMessage = encodeURIComponent(
  'Hola, quiero cotizar cambio de pasta térmica para consola en Cancún. Mi consola se calienta, suena fuerte o se apaga al jugar.'
);

const faqs = [
  {
    question: '¿Cuánto cuesta el cambio de pasta térmica de consola en Cancún?',
    answer: 'El servicio inicia desde $450 MXN, pero el costo final depende del modelo, nivel de suciedad, si requiere limpieza interna, ventilador, metal líquido en PS5 o pruebas adicionales. Primero revisamos la consola para confirmar si realmente necesita pasta, limpieza o reparación térmica.',
  },
  {
    question: '¿La PS5 usa pasta térmica o metal líquido?',
    answer: 'La PS5 usa metal líquido sobre el APU, no pasta térmica tradicional en esa zona. Por eso no se debe tratar igual que una PS4, Xbox o Nintendo Switch. Revisamos si el metal líquido está desplazado, seco por zonas o mal distribuido antes de tocarlo.',
  },
  {
    question: '¿Cambiar pasta térmica quita el ruido del ventilador?',
    answer: 'Puede reducir bastante el ruido si el ventilador estaba acelerado por temperatura alta. Si el ruido viene de rodamiento, vibración, aspas dañadas o suciedad pegada, también revisamos ventilador y disipador para no prometer una solución incompleta.',
  },
  {
    question: '¿Cada cuánto conviene cambiar la pasta térmica de una consola?',
    answer: 'En Cancún recomendamos revisar cada 12 a 18 meses por calor, humedad y polvo. Si juegas muchas horas, la consola está en mueble cerrado o se apaga en juegos pesados, conviene revisarla antes para evitar daño por temperatura.',
  },
  {
    question: '¿Atienden Xbox, Nintendo Switch, Steam Deck y ROG Ally?',
    answer: 'Sí. Revisamos Xbox Series, Xbox One, Nintendo Switch, Steam Deck, ROG Ally y otras portátiles gamer. Cada una usa sistema térmico distinto, así que ajustamos el proceso según disipador, pasta, pads, ventilador y espacio interno.',
  },
  {
    question: '¿Tiene garantía el cambio de pasta térmica?',
    answer: 'Sí, el servicio incluye garantía por escrito sobre la mano de obra realizada. La garantía no cubre golpes, humedad posterior, manipulación externa o fallas de placa no relacionadas, pero sí cubre la intervención térmica bajo condiciones normales.',
  },
];

const symptoms = [
  ['01', 'Ventilador a máxima velocidad', 'La consola intenta compensar mala transferencia térmica, polvo o disipador saturado.'],
  ['02', 'Se apaga en juegos pesados', 'El APU/GPU se protege por temperatura alta y corta energía para evitar daño mayor.'],
  ['03', 'Baja rendimiento o cierra juegos', 'Puede existir throttling térmico: la consola baja frecuencia para intentar enfriar.'],
  ['04', 'Más de 2 años sin mantenimiento', 'La pasta puede estar seca y el polvo puede bloquear aletas internas del disipador.'],
  ['05', 'PS5 vertical con avisos de calor', 'Revisamos distribución de metal líquido y contacto del disipador con el APU.'],
  ['06', 'Portátil gamer muy caliente', 'Steam Deck, ROG Ally y similares requieren cuidado por alto rendimiento en poco espacio.'],
];

const platforms = [
  ['fa-brands fa-playstation', 'PS5: metal líquido', 'Validamos metal líquido, sellado, presión del disipador, ventilador y polvo antes de intervenir.'],
  ['fa-brands fa-playstation', 'PS4 y PS4 Pro', 'Cambio de pasta térmica, limpieza de disipador, revisión de fuente de calor y ruido de ventilador.'],
  ['fa-brands fa-xbox', 'Xbox Series y Xbox One', 'Pasta térmica para APU, limpieza de disipador, revisión de fuente, ventilador y flujo de aire.'],
  ['fa-solid fa-gamepad', 'Nintendo Switch', 'Cambio de pasta y limpieza térmica para modo portátil o dock con pruebas de temperatura.'],
  ['fa-solid fa-mobile-screen-button', 'Steam Deck', 'Mantenimiento térmico en consola portátil con revisión de ventilador, pads y disipación compacta.'],
  ['fa-solid fa-microchip', 'ROG Ally y portátiles gamer', 'Revisión de pasta, temperatura, ventilador y estabilidad bajo carga en equipos portátiles de alto rendimiento.'],
];

const process = [
  ['Diagnóstico térmico', 'Revisamos síntoma, ruido, apagados, historial de uso, mueble cerrado, polvo y comportamiento al jugar.'],
  ['Apertura cuidada', 'Desarmamos según modelo, sin forzar clips, flex, blindajes, tornillería ni conectores delicados.'],
  ['Limpieza y compuesto', 'Retiramos pasta vieja o revisamos metal líquido en PS5. Limpiamos disipador y aplicamos compuesto correcto.'],
  ['Prueba real', 'Probamos encendido, ruido, estabilidad, flujo de aire y respuesta térmica antes de entregar.'],
];
---

<div class="console-paste-page">
  <section class="cp-hero">
    <div class="container cp-hero-grid">
      <div class="cp-hero-copy">
        <span class="cp-kicker"><i class="fa-solid fa-location-dot"></i> Servicio térmico de consolas en Cancún</span>
        <h1>Cambio de pasta térmica de consolas en Cancún</h1>
        <h2>PS5, PS4, Xbox, Nintendo Switch, Steam Deck y ROG Ally con revisión térmica real.</h2>
        <p>Si tu consola suena fuerte, se calienta, baja rendimiento o se apaga al jugar, revisamos pasta térmica, metal líquido en PS5, disipador, ventilador, polvo y flujo de aire antes de cotizar.</p>
        <div class="cp-tags">
          <span>PS5 metal líquido</span>
          <span>Xbox Series</span>
          <span>Nintendo Switch</span>
          <span>Steam Deck / ROG Ally</span>
          <span>Garantía por escrito</span>
        </div>
        <div class="cp-actions">
          <a class="cp-primary" href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank"><i class="fa-brands fa-whatsapp"></i> Cotizar pasta térmica</a>
          <a class="cp-secondary" href="#diagnostico-termico">Ver diagnóstico</a>
        </div>
      </div>

      <aside class="cp-hero-card">
        <div class="cp-chip-visual" aria-hidden="true">
          <span class="cp-chip-core"></span>
          <span class="cp-heat-line line-a"></span>
          <span class="cp-heat-line line-b"></span>
          <span class="cp-heat-line line-c"></span>
          <i class="fa-solid fa-temperature-arrow-down"></i>
        </div>
        <div class="cp-price">
          <span>Servicio desde</span>
          <strong>{service.fromPrice || '$450 MXN'}</strong>
          <small>Puede cambiar si requiere limpieza profunda, ventilador, pads, metal líquido o reparación adicional.</small>
        </div>
        <ul>
          <li><i class="fa-solid fa-check"></i> Diagnóstico antes de cambiar compuesto</li>
          <li><i class="fa-solid fa-check"></i> Pasta premium según modelo</li>
          <li><i class="fa-solid fa-check"></i> Revisión de metal líquido en PS5</li>
          <li><i class="fa-solid fa-check"></i> Prueba térmica y de ruido</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="cp-section cp-diagnostic" id="diagnostico-termico">
    <div class="container cp-diagnostic-grid">
      <div class="cp-section-copy">
        <span class="cp-eyebrow">Diagnóstico frecuente</span>
        <h2>Señales de que tu consola necesita revisión térmica</h2>
        <p>La pasta térmica seca, el metal líquido mal distribuido, el polvo en disipador y el ventilador forzado pueden verse como la misma falla. Por eso primero identificamos la causa real.</p>
      </div>
      <div class="cp-symptom-list">
        {symptoms.map(([num, title, text]) => (
          <article>
            <span>{num}</span>
            <div>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cp-section cp-ps5">
    <div class="container cp-ps5-panel">
      <div>
        <span class="cp-eyebrow">PS5 no es igual</span>
        <h2>Metal líquido en PS5: se revisa con cuidado, no se improvisa</h2>
        <p>La PlayStation 5 usa metal líquido para transferir calor del APU al disipador. Si está desplazado, hay zonas secas o el disipador no hace buen contacto, la consola puede calentarse aunque parezca limpia.</p>
      </div>
      <div class="cp-ps5-points">
        <article><strong>01</strong><h3>Distribución</h3><p>Validamos que el metal líquido cubra correctamente la superficie crítica.</p></article>
        <article><strong>02</strong><h3>Aislamiento</h3><p>Revisamos que no exista riesgo de derrame hacia zonas sensibles de placa.</p></article>
        <article><strong>03</strong><h3>Disipador</h3><p>Confirmamos presión, polvo interno y transferencia térmica antes de cerrar.</p></article>
      </div>
    </div>
  </section>

  <section class="cp-section cp-platforms">
    <div class="container">
      <div class="cp-head">
        <span class="cp-eyebrow">Compatibilidad real</span>
        <h2>Pasta térmica para PS5, Xbox, Switch y consolas portátiles gamer</h2>
        <p>Cada consola tiene arquitectura térmica distinta. No usamos el mismo criterio para una PS5, una Xbox Series X, una Nintendo Switch o una ROG Ally.</p>
      </div>
      <div class="cp-platform-grid">
        {platforms.map(([icon, title, text]) => (
          <article>
            <i class={icon}></i>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cp-section cp-decision">
    <div class="container cp-decision-panel">
      <div>
        <span class="cp-eyebrow">Decisión honesta</span>
        <h2>¿Solo pasta térmica o mantenimiento completo?</h2>
        <p>Cambiar pasta sin limpiar disipador o revisar ventilador puede dejar la falla a medias. Si la consola tiene polvo, humedad, ruido mecánico o apagados, te explicamos qué conviene hacer antes de abrir.</p>
      </div>
      <div class="cp-compare">
        <article>
          <h3>Puede ser solo pasta si:</h3>
          <ul>
            <li>La consola tiene más de 2 años</li>
            <li>Se calienta bajo carga</li>
            <li>No hay ruido mecánico del ventilador</li>
            <li>El disipador no está saturado</li>
          </ul>
        </article>
        <article>
          <h3>Puede requerir más si:</h3>
          <ul>
            <li>Se apaga al instante</li>
            <li>El ventilador no gira o vibra</li>
            <li>Hay polvo visible en rejillas</li>
            <li>La PS5 requiere revisión de metal líquido</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="cp-section cp-process">
    <div class="container">
      <div class="cp-head">
        <span class="cp-eyebrow">Proceso técnico</span>
        <h2>Cambio de compuesto térmico con prueba antes de entregar</h2>
        <p>No entregamos la consola solo porque ya cerró. Validamos ruido, temperatura percibida, encendido, ventilación y estabilidad con uso real.</p>
      </div>
      <div class="cp-process-list">
        {process.map(([title, text], index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cp-section cp-cancun">
    <div class="container cp-cancun-panel">
      <div>
        <span class="cp-eyebrow">Cancún afecta la temperatura</span>
        <h2>Calor, humedad y polvo aceleran el desgaste térmico de tu consola</h2>
        <p>En Cancún la humedad pega el polvo al disipador, el calor ambiente reduce el margen de enfriamiento y los muebles cerrados reciclan aire caliente. Por eso una revisión térmica preventiva puede evitar apagones y fallas más caras.</p>
      </div>
      <div class="cp-cancun-strip">
        <span><i class="fa-solid fa-water"></i> Humedad</span>
        <span><i class="fa-solid fa-temperature-high"></i> Calor</span>
        <span><i class="fa-solid fa-wind"></i> Polvo fino</span>
        <span><i class="fa-solid fa-box"></i> Muebles cerrados</span>
      </div>
    </div>
  </section>

  <RelatedServicesSection
    category={category}
    service={service}
    title="Servicios relacionados para consolas"
    eyebrow="Servicios complementarios"
    includeCategoryServices={true}
    initialLimit={8}
  />

  <FaqSection
    id="faq"
    title="Preguntas frecuentes sobre pasta térmica de consolas en Cancún"
    description="Resolvemos dudas sobre PS5, metal líquido, Xbox, Nintendo Switch, Steam Deck, ROG Ally, ruido, temperatura, tiempos, precio y garantía."
    items={faqs}
    ariaLabel="Preguntas frecuentes sobre pasta térmica de consolas en Cancún"
    viewMoreHref="/preguntas-frecuentes"
    viewMoreLabel="Ver más preguntas frecuentes"
    sectionClass="faq-section"
    gridClass="faq-grid"
    backgroundColor="#F8FAFC"
    questionColor="#0F2A4A"
    itemGap="8px"
    questionPadding="16px 18px"
  />

  <CommentsSection dark={true} viewMoreHref="/comentarios" viewMoreLabel="Ver todas las reseñas" id="comentarios" />
  <ContactSection id="ubicacion" />
</div>

<style is:global>
  .console-paste-page {
    background: #0b1120;
    color: #e2e8f0;
  }
  .cp-hero {
    position: relative;
    overflow: hidden;
    padding: 34px 0 46px;
    background:
      radial-gradient(circle at 12% 18%, rgba(14, 165, 233, .2), transparent 30%),
      radial-gradient(circle at 86% 18%, rgba(34, 197, 94, .14), transparent 31%),
      linear-gradient(135deg, #06111f 0%, #0b1120 52%, #0f1f35 100%);
  }
  .cp-hero-grid,
  .cp-diagnostic-grid,
  .cp-ps5-panel,
  .cp-decision-panel,
  .cp-cancun-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, .92fr);
    gap: 28px;
    align-items: center;
  }
  .cp-kicker,
  .cp-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #67e8f9;
    font-size: .78rem;
    font-weight: 950;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .cp-hero h1 {
    max-width: 820px;
    margin: 10px 0;
    color: #fff;
    font-family: 'Kanit', sans-serif;
    font-size: clamp(1.95rem, 4.15vw, 3.55rem);
    line-height: 1;
  }
  .cp-hero h2 {
    max-width: 760px;
    margin: 0 0 12px;
    color: #ccfbf1;
    font-family: 'Kanit', sans-serif;
    font-size: clamp(1.05rem, 1.9vw, 1.45rem);
    line-height: 1.2;
  }
  .cp-hero p {
    max-width: 760px;
    margin: 0;
    color: #cbd5e1;
    line-height: 1.6;
    font-weight: 650;
  }
  .cp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0;
  }
  .cp-tags span {
    color: #e0f2fe;
    background: rgba(255,255,255,.07);
    border: 1px solid rgba(125,211,252,.18);
    border-radius: 999px;
    padding: 8px 11px;
    font-size: .82rem;
    font-weight: 850;
  }
  .cp-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cp-primary,
  .cp-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border-radius: 12px;
    padding: 13px 18px;
    font-weight: 900;
    text-decoration: none;
  }
  .cp-primary {
    color: #fff !important;
    background: #2563eb;
    box-shadow: 0 18px 38px rgba(37,99,235,.24);
  }
  .cp-secondary {
    color: #dbeafe !important;
    border: 1px solid rgba(255,255,255,.18);
    background: rgba(255,255,255,.06);
  }
  .cp-hero-card {
    background: rgba(15,23,42,.82);
    border: 1px solid rgba(148,163,184,.2);
    border-radius: 22px;
    padding: 16px;
    box-shadow: 0 28px 80px rgba(0,0,0,.34);
  }
  .cp-chip-visual {
    position: relative;
    min-height: 160px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 18px;
    background:
      linear-gradient(90deg, rgba(125,211,252,.1) 1px, transparent 1px),
      linear-gradient(0deg, rgba(125,211,252,.1) 1px, transparent 1px),
      radial-gradient(circle, rgba(34,197,94,.18), transparent 48%);
    background-size: 34px 34px, 34px 34px, auto;
  }
  .cp-chip-core {
    width: 88px;
    height: 88px;
    border-radius: 22px;
    background: linear-gradient(135deg, #e0f2fe, #38bdf8);
    box-shadow: 0 18px 38px rgba(14,165,233,.28), inset 0 0 0 10px rgba(15,42,74,.18);
  }
  .cp-chip-visual i {
    position: absolute;
    right: 22px;
    bottom: 20px;
    color: #86efac;
    font-size: 2rem;
  }
  .cp-heat-line {
    position: absolute;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, #67e8f9, transparent);
  }
  .line-a { width: 160px; top: 34px; }
  .line-b { width: 210px; top: 78px; opacity: .72; }
  .line-c { width: 150px; bottom: 36px; opacity: .58; }
  .cp-price {
    display: grid;
    gap: 5px;
    margin: 12px 0;
  }
  .cp-price span { color: #bfdbfe; font-weight: 850; }
  .cp-price strong {
    color: #67e8f9;
    font-family: 'Kanit', sans-serif;
    font-size: 1.8rem;
    line-height: 1;
  }
  .cp-price small {
    color: #cbd5e1;
    line-height: 1.45;
  }
  .cp-hero-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 7px;
  }
  .cp-hero-card li {
    color: #dbeafe;
    display: flex;
    gap: 9px;
    font-weight: 740;
    font-size: .9rem;
  }
  .cp-hero-card li i { color: #22c55e; margin-top: 3px; }
  .cp-section {
    padding: 62px 0;
    background: #f8fafc;
  }
  .cp-section h2,
  .cp-head h2 {
    color: #0f2a4a;
    font-family: 'Kanit', sans-serif;
    font-size: clamp(1.85rem, 3.35vw, 3rem);
    line-height: 1.06;
    margin: 10px 0 12px;
  }
  .cp-section p,
  .cp-head p {
    color: #475569;
    line-height: 1.64;
    margin: 0;
  }
  .cp-diagnostic,
  .cp-ps5,
  .cp-process {
    background: #0b1120 !important;
  }
  .cp-diagnostic h2,
  .cp-ps5 h2,
  .cp-process h2,
  .cp-diagnostic .cp-symptom-list h3 {
    color: #f8fafc !important;
  }
  .cp-diagnostic p,
  .cp-ps5 p,
  .cp-process .cp-head p,
  .cp-diagnostic .cp-symptom-list p {
    color: #cbd5e1 !important;
  }
  .cp-symptom-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 22px;
    border-top: 1px solid rgba(255,255,255,.14);
    border-bottom: 1px solid rgba(255,255,255,.14);
  }
  .cp-symptom-list article {
    display: grid;
    grid-template-columns: 42px minmax(0,1fr);
    gap: 12px;
    padding: 16px 0;
    border-bottom: 1px solid rgba(255,255,255,.12);
  }
  .cp-symptom-list article:nth-last-child(-n + 2) { border-bottom: 0; }
  .cp-symptom-list span,
  .cp-process-list span,
  .cp-ps5-points strong {
    color: #67e8f9;
    font-family: 'Kanit', sans-serif;
    font-weight: 950;
  }
  .cp-symptom-list h3,
  .cp-platform-grid h3,
  .cp-compare h3,
  .cp-process-list h3,
  .cp-ps5-points h3 {
    font-family: 'Kanit', sans-serif;
    font-size: 1.08rem;
    line-height: 1.22;
    margin: 0 0 6px;
  }
  .cp-ps5 {
    background:
      radial-gradient(circle at 88% 18%, rgba(34,211,238,.12), transparent 28%),
      #0b1120 !important;
  }
  .cp-ps5-points,
  .cp-platform-grid,
  .cp-compare,
  .cp-process-list {
    display: grid;
    gap: 12px;
  }
  .cp-ps5-points {
    grid-template-columns: repeat(3, minmax(0,1fr));
  }
  .cp-ps5-points article {
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(125,211,252,.18);
    border-radius: 18px;
    padding: 18px;
  }
  .cp-ps5-points h3 { color: #f8fafc; }
  .cp-ps5-points p { color: #cbd5e1; }
  .cp-head {
    max-width: 900px;
    margin: 0 auto 28px;
    text-align: center;
  }
  .cp-platform-grid {
    grid-template-columns: repeat(3, minmax(0,1fr));
  }
  .cp-platform-grid article,
  .cp-compare article,
  .cp-process-list article {
    background: #fff;
    border: 1px solid rgba(15,42,74,.1);
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 14px 34px rgba(15,42,74,.07);
  }
  .cp-platform-grid i {
    color: #0ea5e9;
    font-size: 1.35rem;
    margin-bottom: 12px;
  }
  .cp-platform-grid h3,
  .cp-compare h3,
  .cp-process-list h3 {
    color: #0f2a4a !important;
  }
  .cp-platform-grid p,
  .cp-compare p,
  .cp-process-list p {
    color: #475569 !important;
  }
  .cp-decision {
    background: #eef6ff !important;
  }
  .cp-compare {
    grid-template-columns: repeat(2, minmax(0,1fr));
  }
  .cp-compare ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .cp-compare li {
    color: #334155;
    font-weight: 720;
    padding-left: 18px;
    position: relative;
  }
  .cp-compare li::before {
    content: "";
    position: absolute;
    left: 0;
    top: .68em;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #2563eb;
  }
  .cp-process-list {
    grid-template-columns: repeat(4, minmax(0,1fr));
  }
  .cp-cancun {
    background: #f8fafc !important;
  }
  .cp-cancun-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cp-cancun-strip span {
