    'Garantia por escrito sobre la pieza o intervencion realizada cuando aplica.',
    'Pruebas de carga, temperatura, pantalla, teclado, puertos y macOS antes de entregar.',
    'Diagnostico claro si la falla viene de bateria, pantalla, humedad, almacenamiento, sistema o placa.',
  ],
  redes: [
    'Configuracion documentada de router, red WiFi, IP, impresora o equipos conectados cuando aplica.',
    'Pruebas de cobertura, velocidad, conexion y estabilidad antes de cerrar la visita.',
    'Recomendaciones claras si conviene mejorar router, mesh, cableado o separar red de invitados.',
  ],
};
const warranties = service.warrantyPoints || warrantyPresets[category.slug] || [
  commercialCopy.es.warranty,
  'Pruebas de funcionamiento antes de entregar.',
  'Diagnostico claro si la falla viene de placa, humedad o piezas externas.',
];
const fallbackFaqs = [
  {
    question: '¿Cuánto tiempo toma este servicio en Cancún?',
    answer: 'El tiempo depende del tipo de intervención, disponibilidad de refacciones y gravedad de la falla. En servicios simples puede resolverse el mismo día; en reparaciones con piezas o pruebas extendidas puede tomar de 24 a 72 horas. Siempre te damos tiempo estimado antes de iniciar.',
  },
  {
    question: '¿Mi equipo está seguro durante la reparación?',
    answer: 'Trabajamos con área antiestática, herramienta adecuada y revisión documentada del estado del equipo. No borramos información ni cambiamos piezas sin autorización. Si el servicio implica riesgo para datos o componentes, te lo explicamos antes de continuar.',
  },
  {
    question: '¿Ofrecen garantía por escrito?',
    answer: 'Entregamos garantía por escrito según el tipo de servicio y pieza instalada. La garantía cubre la intervención realizada bajo uso normal, pero no aplica por golpes, humedad, manipulación externa, variaciones eléctricas o fallas en piezas no intervenidas.',
  },
  {
    question: '¿Qué marcas atienden en Cancún?',
    answer: 'Trabajamos con marcas comunes como HP, Dell, Lenovo, Asus, Acer, MSI, Apple, PlayStation, Xbox, Nintendo, Epson, Canon, Brother y equipos ensamblados. La compatibilidad final se confirma por modelo, síntoma y disponibilidad de refacciones.',
  },
  {
    question: '¿Tienen servicio a domicilio o debo llevar el equipo?',
    answer: 'Contamos con laboratorio técnico privado en Cancún para diagnósticos y reparaciones que requieren herramienta especializada. En algunos casos podemos coordinar recolección, entrega o visita según zona, disponibilidad y tipo de equipo. Te orientamos por WhatsApp antes de moverlo.',
  },
];
const faqs = service.faqs?.length ? service.faqs : providedFaqs.length ? providedFaqs : fallbackFaqs;
const ticketTitle = service.ticketTitle || `Crear ticket de ${service.label}`;
const ticketSubtitle = service.ticketSubtitle || (
  category.slug === 'redes'
    ? 'Cuentanos zona de Cancun, proveedor de internet, modelo de router, cantidad de equipos y donde falla la senal. Te contactaremos para confirmar visita o diagnostico.'
    : category.slug === 'mac'
    ? 'Cuentanos modelo de Mac, ano aproximado, sintomas, si hubo liquido, golpe, reinicios o reparacion previa. Te contactaremos para confirmar diagnostico y cotizacion.'
    : 'Cuentanos modelo, sintomas y si hubo golpe, humedad, reinicios o reparacion previa. Te contactaremos para confirmar diagnostico y cotizacion.'
);
const relatedTitle = service.relatedTitle || `Servicios relacionados con ${service.label}`;
const localZones = ['Zona Hotelera', 'Cancun Centro', 'Av. Tulum', 'Bonampak', 'Puerto Cancun', 'Cumbres', 'Huayacan', 'Bonfil', 'Aeropuerto', 'Parque Industrial'];
const localZoneCopy = `Atendemos clientes de ${localZones.slice(0, 5).join(', ')}, ${localZones.slice(5).join(', ')} y otras zonas de Quintana Roo.`;
const diagnosticCopy = category.slug === 'redes'
  ? 'Revisamos cobertura, velocidad, interferencia, ubicacion del router, cableado, IP, equipos conectados y seguridad basica. Si la falla requiere visita, te explicamos alcance antes de mover configuraciones.'
  : category.slug === 'mac'
  ? 'Revisamos el equipo por modelo exacto, energia, bateria, pantalla, teclado, trackpad, puertos USB-C o MagSafe, temperatura, almacenamiento, macOS y antecedentes de liquido o golpes antes de cotizar.'
  : 'Revisamos el equipo con pruebas funcionales, inspeccion fisica y contexto de uso. Si hay golpe, humedad, sobrecalentamiento, fallas previas o refacciones no compatibles, te lo explicamos antes de avanzar.';
const compatibilityTitle = category.slug === 'redes'
  ? 'Equipos, espacios y configuraciones que podemos revisar'
  : category.slug === 'mac'
  ? 'Modelos Mac que podemos revisar'
  : 'Marcas y modelos que podemos revisar';
const compatibilityCopy = category.slug === 'redes'
  ? 'La solucion depende del espacio, proveedor, router, muros, cantidad de usuarios y equipos conectados. Revisamos compatibilidad antes de cambiar hardware o mover configuraciones.'
  : category.slug === 'mac'
  ? 'La disponibilidad de piezas depende del modelo exacto, ano, chip y numero de parte. Si no aparece tu modelo, escribenos por WhatsApp y confirmamos compatibilidad.'
  : 'La disponibilidad de piezas depende del modelo exacto. Si no aparece tu marca, escribenos por WhatsApp y revisamos compatibilidad antes de mover tu equipo.';
const localUseTitle = category.slug === 'redes'
  ? 'Redes pensadas para casas, oficinas y negocios en Cancun'
  : category.slug === 'mac'
  ? 'Servicio Mac pensado para el uso real en Cancun'
  : 'Reparacion pensada para el uso real en Cancun';
const localUseCopy = category.slug === 'redes'
  ? 'Los muros, la distancia, la saturacion, los equipos conectados, las impresoras en red y los proveedores de internet cambian la solucion correcta. Por eso revisamos el sitio antes de recomendar mesh, cableado o configuracion.'
  : category.slug === 'mac'
  ? 'El calor, la humedad, el polvo, el salitre, los apagones y el uso intensivo afectan bateria, temperatura, puertos, teclado, almacenamiento y placa. Por eso revisamos sintomas, historial y urgencia antes de recomendar piezas.'
  : 'El calor, la humedad, el polvo, el salitre, los apagones y el uso intensivo cambian la forma correcta de diagnosticar un equipo. Por eso revisamos sintomas, historial, zona de uso y urgencia antes de recomendar refacciones.';

const imageByCategory: Record<string, string> = {
  pc: '/assets/images/mantenimiento-pc-escritorio.webp',
  laptop: '/assets/images/laptop-feliz-limpia.webp',
  telefono: '/assets/images/lavado-tarjeta-celular.webp',
  mac: '/assets/images/mac-mini.webp',
  consola: '/assets/images/ps5_xbox.webp',
  impresora: '/assets/images/reparacion-impresoras-cancun.webp',
  b2b: '/assets/images/mac-mini.webp',
  redes: '/assets/images/mantenimiento-pc-escritorio.webp',
};

const imageRules: Array<{ match: RegExp; image: string }> = [
  { match: /(mac|macbook|imac|mac-mini|macos)/, image: '/assets/images/mac-mini.webp' },
  { match: /(pantalla-iphone|pantalla-samsung|pantalla|display)/, image: '/assets/images/pantalla-rota-iphone.webp' },
  { match: /(iphone|face-id|camara|lente|tapa|senal|wifi|bluetooth|software)/, image: '/assets/images/iphone-desarmado-2.webp' },
  { match: /(humedad|mojado|placa|microfono|bocina|carga|flex)/, image: '/assets/images/microscopio-flexor.webp' },
  { match: /(ssd|upgrade|lentitud|instalacion-componentes)/, image: '/assets/images/cambio-ssd.webp' },
  { match: /(gamer|gpu|refrigeracion|limpieza|fuente|no-enciende|pantalla-azul)/, image: '/assets/images/mantenimiento-pc-escritorio.webp' },
  { match: /(laptop|teclado|bateria|thermal|pasta|bisagra)/, image: '/assets/images/laptop-gamer-rogstrix.webp' },
  { match: /(ps5|xbox|switch|consola|hdmi|drift)/, image: '/assets/images/ps5_xbox.webp' },
  { match: /(impresora|toner|tinta|rodillo)/, image: '/assets/images/reparacion-impresoras-cancun.webp' },
  { match: /(wifi|red|router|mesh|cableado)/, image: '/assets/images/mac-mini.webp' },
];

function getServiceImage() {
  if (service.featuredImage) return service.featuredImage;

  const key = `${category.slug}-${service.slug}`;

  if (category.slug === 'laptop') {
    if (/(pantalla|display)/.test(service.slug)) return '/assets/images/cambio-pantalla-laptop.webp';
    if (/(pasta|thermal|limpieza|mantenimiento)/.test(service.slug)) return '/assets/images/mantenimiento-pastaternima-thermalpads.webp';
    if (/(upgrade|ssd)/.test(service.slug)) return '/assets/images/cambio-ssd.webp';
    return imageByCategory.laptop;
  }

  if (category.slug === 'pc') {
    if (/(upgrade|ssd|lentitud|instalacion-componentes)/.test(service.slug)) return '/assets/images/cambio-ssd.webp';
    if (/(gamer|gpu)/.test(service.slug)) return '/assets/images/laptop-gamer-rogstrix.webp';
    return imageByCategory.pc;
  }

  if (category.slug === 'mac') {
    if (/(mantenimiento|teclado|pantalla|bateria|liquido|macbook)/.test(service.slug)) return '/assets/images/mantenimiento-macbook-cancun.webp';
    return imageByCategory.mac;
  }

  if (category.slug === 'redes') {
    return imageByCategory.redes;
  }

  return imageRules.find((rule) => rule.match.test(key))?.image || imageByCategory[category.slug] || '/assets/images/reparacion-mac-cancun.webp';
}

const serviceImage = getServiceImage();
const serviceImageAlt = isPs5HdmiService
  ? 'Cambio de HDMI PS5 en Cancún - servicio técnico Pixon PC'
  : `${keyword}${/cancun/i.test(keyword) ? '' : ' en Cancun'} - servicio tecnico Pixon PC`;
---

<link rel="stylesheet" href="/styles/service-detail.css">

<div class={`sdv sdv-category-${category.slug} ${serviceSlugClass} ${isMacBookRepair ? 'sdv-macbook-repair' : ''} ${isMacDiagnostic ? 'sdv-mac-diagnostic' : ''} ${isMacNoPower ? 'sdv-mac-no-power' : ''} ${isNetworkService ? 'sdv-network-service' : ''} ${isB2bMaintenancePremium ? 'sdv-b2b-policy' : ''}`}>
  <section class="sdv-hero">
    <div class="container sdv-hero-grid">
      <div class="sdv-hero-head">
        <span class="sdv-eyebrow"><i class={`fa-solid ${category.icon}`}></i> {category.title} en Cancun</span>
        <h1>{title}</h1>
      </div>
      <aside class="sdv-hero-card">
        <div class="sdv-hero-media">
          {isB2bMaintenancePremium ? (
            <div class="b2b-hero-collage" role="img" aria-label={`${title} para empresas en Cancun`}>
              <img src="/assets/images/soporte-hoteles-hero.webp" alt="Soporte TI para hoteles en Cancun" loading="eager" decoding="async" fetchpriority="high" />
              <img src="/assets/images/mantenimiento-pc-escritorio.webp" alt="Mantenimiento preventivo de computadoras para empresas" loading="eager" decoding="async" fetchpriority="high" />
              <img src="/assets/images/reparacion-impresoras-cancun.webp" alt="Soporte de impresoras empresariales en Cancun" loading="eager" decoding="async" fetchpriority="high" />
              <div class="b2b-hero-collage-badge">
                <i class="fa-solid fa-chart-line"></i>
                <strong>{isB2bFleetMaintenance ? 'Flotilla TI' : 'TI preventivo'}</strong>
                <span>menos paros, mas control</span>
              </div>
            </div>
          ) : isNetworkService ? (
            <div class="sdv-network-visual" role="img" aria-label={serviceImageAlt}>
              <div class="sdv-network-rings">
                <span></span>
                <span></span>
                <span></span>
              </div>
              <div class="sdv-network-router">
                <i class="fa-solid fa-wifi"></i>
                <strong>{service.slug === 'wifi-lento' ? 'WiFi' : service.slug === 'cableado-red' ? 'LAN' : service.slug === 'impresora-red' ? 'PRINT' : 'NET'}</strong>
              </div>
              <div class="sdv-network-node node-a"><i class="fa-solid fa-laptop"></i></div>
              <div class="sdv-network-node node-b"><i class="fa-solid fa-mobile-screen-button"></i></div>
              <div class="sdv-network-node node-c"><i class="fa-solid fa-print"></i></div>
              <div class="sdv-network-node node-d"><i class="fa-solid fa-network-wired"></i></div>
            </div>
          ) : (
            <img src={serviceImage} alt={serviceImageAlt} loading="eager" decoding="async" fetchpriority="high" />
          )}
          {(isMacPremiumView || isNetworkService) && (
            <div class="sdv-macbook-media-badge">
              <i class={`fa-solid ${isNetworkService ? 'fa-wifi' : isMacDiagnostic ? 'fa-circle-check' : 'fa-screwdriver-wrench'}`}></i>
              {isNetworkService ? 'Medición de cobertura' : isMacDiagnostic ? 'Diagnóstico por revisión' : 'Diagnóstico por módulo'}
            </div>
          )}
          {isPs5HdmiService && (
            <div class="sdv-hdmi-media-badge">
              <i class="fa-solid fa-screwdriver-wrench"></i>
              Microsoldadura PS5
            </div>
          )}
        </div>
        <div class="sdv-hero-card-body">
          {isPs5HdmiService ? (
            <div class="sdv-hdmi-diagnostic-card" aria-label="Resumen de diagnostico HDMI PS5">
              <span class="sdv-hdmi-kicker">Orden de revisión</span>
              <strong>Diagnóstico desde ${diagnosticPolicy.startingPriceMXN} MXN</strong>
              <div class="sdv-hdmi-checklist">
                <p><i class="fa-solid fa-magnifying-glass-chart"></i> Diagnóstico de puerto, pines, pads y filtros</p>
                <p><i class="fa-solid fa-clock"></i> {service.eta || '48-96 h según daño'}</p>
                <p><i class="fa-solid fa-shield-halved"></i> {service.warranty || 'Garantía por escrito'}</p>
                <p><i class="fa-solid fa-location-dot"></i> Taller local en Cancún</p>
              </div>
            </div>
          ) : (
            <>
              <strong>{service.fromPrice || 'Cotización por modelo'}</strong>
              <span>{service.fromPrice ? 'Precio desde' : 'Presupuesto'}</span>
              <div class="sdv-mini-list">
                <p><i class="fa-solid fa-clock"></i> {service.eta || commercialCopy.es.turnaround}</p>
                <p><i class="fa-solid fa-shield-halved"></i> {service.warranty || commercialCopy.es.warranty}</p>
                <p><i class="fa-solid fa-location-dot"></i> Servicio local en Cancun</p>
              </div>
            </>
          )}
        </div>
      </aside>
      <div class="sdv-hero-body">
        <p>{hook}</p>
        {isPs5HdmiService && (
          <div class="sdv-hdmi-hero-tags" aria-label="Síntomas frecuentes de HDMI PS5">
            <span><i class="fa-solid fa-tv"></i>Sin imagen</span>
            <span><i class="fa-solid fa-plug-circle-xmark"></i>Puerto flojo</span>
            <span><i class="fa-solid fa-wave-square"></i>Señal intermitente</span>
            <span><i class="fa-solid fa-microchip"></i>Pistas y pads</span>
          </div>
        )}
        {isB2bMaintenancePremium && (
          <>
            <div class="b2b-hero-tags" aria-label={b2bMaintenanceHeroAria}>
              <span><i class="fa-solid fa-calendar-check"></i>Visitas programadas</span>
              <span><i class="fa-solid fa-ticket"></i>Tickets y folios</span>
              <span><i class="fa-solid fa-file-invoice"></i>CFDI y reportes</span>
              <span><i class="fa-solid fa-wifi"></i>Red e impresoras</span>
              <span><i class="fa-solid fa-building-shield"></i>Hoteles y oficinas</span>
            </div>
            <div class="b2b-hero-metrics" aria-label={`Resumen de ${b2bMaintenanceLabel}`}>
              <span><strong>12+</strong>secciones SEO locales</span>
              <span><strong>Zona Hotelera</strong>Cancun Centro, Huayacan y Cumbres</span>
              <span><strong>PC / laptop / red</strong>{b2bMaintenanceHeroMetric}</span>
            </div>
          </>
        )}
        {(isMacPremiumView || isNetworkService) && (
          <>
            <div class="sdv-macbook-tags" aria-label={isNetworkService ? 'Servicios frecuentes de redes' : 'Fallas frecuentes de MacBook'}>
              {isMacDiagnostic ? (
                <>
                  <span><i class="fa-solid fa-circle-check"></i>Revisión</span>
                  <span><i class="fa-solid fa-power-off"></i>No prende</span>
                  <span><i class="fa-solid fa-gauge-high"></i>Lenta</span>
                  <span><i class="fa-solid fa-display"></i>Pantalla</span>
                  <span><i class="fa-solid fa-database"></i>Datos</span>
                </>
              ) : isNetworkService ? (
                <>
                  <span><i class="fa-solid fa-wifi"></i>WiFi lento</span>
                  <span><i class="fa-solid fa-server"></i>Router</span>
                  <span><i class="fa-solid fa-network-wired"></i>Ethernet</span>
                  <span><i class="fa-solid fa-print"></i>Impresoras</span>
                  <span><i class="fa-solid fa-signal"></i>Mesh</span>
                </>
              ) : (
                <>
                  <span><i class="fa-solid fa-power-off"></i>No prende</span>
                  <span><i class="fa-solid fa-plug-circle-xmark"></i>No carga</span>
                  <span><i class="fa-solid fa-keyboard"></i>Teclado</span>
                  <span><i class="fa-solid fa-display"></i>Pantalla</span>
                  <span><i class="fa-solid fa-droplet"></i>Humedad</span>
                </>
              )}
            </div>
            <div class="sdv-macbook-stats" aria-label="Resumen del servicio">
              <span><strong>{service.fromPrice || 'Por confirmar'}</strong>{isNetworkService ? 'Visita según sitio' : 'Diagnóstico según revisión'}</span>
              <span><strong>{service.eta || 'Por confirmar'}</strong>{isNetworkService ? 'Según sitio' : 'Después del diagnóstico'}</span>
              <span><strong>{isNetworkService ? 'Casa / negocio' : isMacDiagnostic ? 'Mac completa' : 'Air / Pro'}</strong>{isNetworkService ? 'Router, WiFi, cableado' : isMacDiagnostic ? 'Hardware, macOS y datos' : 'Intel, M1, M2, M3'}</span>
            </div>
          </>
        )}
        <div class="sdv-hero-actions">
          <a href="#ticket" class="sdv-btn sdv-btn-primary"><i class="fa-solid fa-clipboard-list"></i> Crear ticket</a>
          <a href={`https://wa.me/529986690777?text=${encodeURIComponent(`Hola, quiero cotizar ${service.label} en Cancun.`)}`} target="_blank" rel="noopener noreferrer" class="sdv-btn sdv-btn-secondary"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>
        </div>
      </div>
    </div>
    {(isMacPremiumView || isNetworkService) && (
      <div class="container sdv-macbook-rail" aria-label={isNetworkService ? 'Puntos de revision de red' : 'Puntos de revision MacBook'}>
        {isMacDiagnostic ? (
          <>
            <span><i class="fa-solid fa-bolt"></i>Energia, USB-C y MagSafe</span>
            <span><i class="fa-solid fa-laptop-code"></i>macOS, arranque y sistema</span>
            <span><i class="fa-solid fa-temperature-arrow-up"></i>Temperatura y rendimiento</span>
            <span><i class="fa-solid fa-database"></i>Datos, SSD y respaldo</span>
          </>
        ) : isNetworkService ? (
          <>
            <span><i class="fa-solid fa-gauge-high"></i>Velocidad real por zona</span>
            <span><i class="fa-solid fa-server"></i>Router, modem y canales</span>
            <span><i class="fa-solid fa-signal"></i>Repetidores, Mesh y cobertura</span>
            <span><i class="fa-solid fa-network-wired"></i>Cableado, switches e IP</span>
          </>
        ) : (
          <>
            <span><i class="fa-solid fa-bolt"></i>Energia, USB-C y MagSafe</span>
            <span><i class="fa-solid fa-keyboard"></i>Teclado, trackpad y top case</span>
            <span><i class="fa-solid fa-battery-quarter"></i>Bateria, ciclos y consumo</span>
            <span><i class="fa-solid fa-microchip"></i>Placa, humedad y temperatura</span>
          </>
        )}
      </div>
    )}
    {isB2bMaintenancePremium && (
      <div class="container sdv-macbook-rail b2b-hero-rail" aria-label={`Puntos fuertes de ${b2bMaintenanceLabel}`}>
        <span><i class="fa-solid fa-clipboard-check"></i>Inventario y seguimiento</span>
        <span><i class="fa-solid fa-screwdriver-wrench"></i>Mantenimiento preventivo</span>
        <span><i class="fa-solid fa-file-lines"></i>Reporte para gerencia</span>
        <span><i class="fa-solid fa-route"></i>Cobertura local Cancun</span>
      </div>
    )}
  </section>

  <nav class="sdv-anchor-nav" aria-label="Navegacion de la pagina">
    <div class="container">
      <a href="#sintomas">Sintomas</a>
      <a href="#diagnostico">Diagnostico</a>
      {educationalBlocks.length > 0 && <a href="#incluye">Que incluye</a>}
      <a href="#proceso">Proceso</a>
      {localSeoSections.length > 0 && <a href="#seo-local">SEO local</a>}
      {isB2bMaintenancePremium && <a href={`#${b2bMaintenanceCtaId}`}>{b2bMaintenanceShort}</a>}
      <a href="#modelos">Modelos</a>
      <a href="#garantia">Garantia</a>
      {faqs.length > 0 && <a href="#faq">FAQ</a>}
      <a href="#ubicacion">Contacto</a>
    </div>
  </nav>

  {trustStats.length > 0 && (
    <section class="sdv-trust-strip" aria-label="Resumen del servicio">
      <div class="container sdv-trust-grid">
        {trustStats.map((item: any) => (
          <article>
            <i class={`fa-solid ${item.icon || 'fa-circle-check'}`}></i>
            <strong>{item.value}</strong>
            <span>{item.label}</span>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="sdv-section sdv-light" id="sintomas">
    <div class="container">
      <div class="sdv-section-head">
        <span class="sdv-eyebrow-dark">Senales comunes</span>
        <h2>Sintomas que revisamos antes de cotizar</h2>
        <p>{description || `Si buscas ${keyword}, lo mas importante es confirmar la causa real antes de cambiar piezas.`}</p>
      </div>
      <div class="sdv-card-grid">
        {symptoms.slice(0, 8).map((item: any) => (
          <article class="sdv-card">
            <i class={`fa-solid ${item.icon || 'fa-circle-exclamation'}`}></i>
            <h3>{item.title || item}</h3>
            <p>{item.text || 'Revisamos esta falla con pruebas reales y te explicamos el siguiente paso.'}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sdv-section sdv-dark" id="diagnostico">
    <div class="container sdv-split">
      <div>
        <span class="sdv-eyebrow">Diagnostico tecnico</span>
        <h2>No cambiamos piezas sin confirmar la falla</h2>
        <p>{diagnosticCopy}</p>
      </div>
      <div class="sdv-proof-grid">
        {whyUs.map((item: any) => (
          <article>
            <i class={`fa-solid ${item.icon || 'fa-check-circle'}`}></i>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sdv-section sdv-light" id="proceso">
    <div class="container">
      <div class="sdv-section-head">
        <span class="sdv-eyebrow-dark">Proceso</span>
        <h2>Ruta de trabajo clara de inicio a entrega</h2>
