const { service, category, description = '' } = Astro.props;

const servicePath = `/servicios/${category.slug}/${service.slug}`;
const serviceSlugClass = service.label === 'Cambio HDMI PS5'
  ? 'sdv-service-cambio-hdmi-ps5'
  : `sdv-service-${service.slug}`;
const isPs5HdmiService = category.slug === 'consola' && service.slug === 'cambio-hdmi-ps5';
const isMacBookRepair = category.slug === 'mac' && service.slug === 'reparacion-macbook';
const isMacDiagnostic = category.slug === 'mac' && service.slug === 'diagnostico-mac';
const isMacNoPower = category.slug === 'mac' && service.slug === 'macbook-no-enciende';
const isMacPremiumView = isMacBookRepair || isMacDiagnostic || isMacNoPower;
const isNetworkService = category.slug === 'redes';
const isWifiSlowService = category.slug === 'redes' && service.slug === 'wifi-lento';
const isB2bMaintenancePolicy = category.slug === 'b2b' && service.slug === 'polizas-mantenimiento';
const isB2bFleetMaintenance = category.slug === 'b2b' && service.slug === 'mantenimiento-flotilla';
const isB2bMaintenancePremium = isB2bMaintenancePolicy || isB2bFleetMaintenance;
const b2bMaintenanceLabel = isB2bFleetMaintenance ? 'flotilla de equipos' : 'poliza de mantenimiento TI';
const b2bMaintenanceShort = isB2bFleetMaintenance ? 'Flotilla TI' : 'Poliza TI';
const b2bMaintenanceHeroAria = isB2bFleetMaintenance
  ? 'Servicios incluidos en mantenimiento de flotilla'
  : 'Servicios incluidos en poliza de mantenimiento TI';
const b2bMaintenanceHeroMetric = isB2bFleetMaintenance ? 'mantenimiento por lote' : 'mantenimiento preventivo integral';
const b2bMaintenanceCtaId = isB2bFleetMaintenance ? 'mantenimiento-flotilla-cancun' : 'mantenimiento-preventivo-ti-cancun';
const b2bMaintenanceVisualId = isB2bFleetMaintenance ? 'flotilla-ti-con-imagenes' : 'poliza-ti-con-imagenes';
const b2bMaintenanceBandsId = isB2bFleetMaintenance ? 'mantenimiento-flotilla-empresarial-cancun' : 'soporte-ti-empresarial-cancun';
