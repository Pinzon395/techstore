      .replace(/poliza local/gi, 'mantenimiento por flotilla')
      .replace(/poliza/gi, 'flotilla')
      .replace(/Polizas/gi, 'Mantenimiento de flotilla')
      .replace(/Poliza/gi, 'Flotilla')
      .replace(/bloques SEO locales/gi, 'secciones SEO locales')
      .replace(/visitas, prioridades y reportes/gi, 'lotes, prioridades y reportes')
      .replace(/Una mantenimiento por flotilla/gi, 'Un mantenimiento por flotilla')
      .replace(/flotillas TI para hoteles/gi, 'Mantenimiento de flotilla TI para hoteles')
      .replace(/La flotilla ordena/gi, 'El mantenimiento de flotilla ordena')
      .replace(/Una flotilla permite/gi, 'El mantenimiento de flotilla permite')
      .replace(/La flotilla permite/gi, 'El mantenimiento de flotilla permite')
      .replace(/La flotilla debe/gi, 'El mantenimiento de flotilla debe')
