---
import FaqSection from '../FaqSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import Footer from '../Footer.astro';

const { service, category, description = '' } = Astro.props;

const servicePath = `/servicios/${category.slug}/${service.slug}`;
const keyword = service.seoKeyword || service.label;
const title = service.h1 || keyword;
const hook = service.hook || service.intro || `Servicio tecnico de ${service.label} para ${category.title} en Cancun.`;
const bullets = Array.isArray(service.bullets) ? service.bullets : [];
const symptoms = service.symptoms || service.commonSymptoms || bullets.map((item: string) => ({
  icon: 'fa-circle-exclamation',
  title: item,
  text: `Revisamos esta condicion con diagnostico tecnico antes de cotizar piezas o mano de obra.`,
}));
const whyUs = service.whyUs || [
  { icon: 'fa-magnifying-glass', title: 'Diagnostico real', desc: 'Probamos la falla antes de recomendar cambios de piezas.' },
  { icon: 'fa-file-shield', title: 'Cotizacion clara', desc: 'Te explicamos costo, alcance y tiempo antes de iniciar.' },
  { icon: 'fa-shield-halved', title: 'Garantia por escrito', desc: 'Entregamos garantia sobre el trabajo realizado cuando aplica.' },
];
const process = service.process || [
  { title: 'Recepcion', desc: 'Registramos equipo, sintomas, accesorios y datos de contacto.' },
  { title: 'Diagnostico', desc: 'Revisamos hardware, software, conectores, humedad, desgaste o fallas visibles segun el caso.' },
  { title: 'Cotizacion', desc: 'Te indicamos opciones, disponibilidad de refaccion y tiempo estimado.' },
  { title: 'Pruebas y entrega', desc: 'Validamos funcionamiento antes de cerrar el ticket y entregar.' },
];
const compatible = service.compatibleBrands || category.brands || ['HP', 'Dell', 'Lenovo', 'Asus', 'Acer', 'Apple', 'Samsung', 'Xiaomi', 'Motorola', 'PlayStation', 'Xbox', 'Nintendo'];
const risks = service.risks || [
  { icon: 'fa-triangle-exclamation', title: 'Evita seguir usandolo si falla', text: 'Un equipo con corto, humedad, temperatura alta o reinicios puede empeorar si se fuerza.' },
  { icon: 'fa-plug-circle-xmark', title: 'No conectes cargadores dudosos', text: 'Cargadores, cables o extensiones dañadas pueden provocar fallas electricas.' },
  { icon: 'fa-screwdriver-wrench', title: 'No lo abras sin herramienta', text: 'Forzar clips, flex o conectores suele convertir una falla simple en una reparacion mas cara.' },
];
const warranties = service.warrantyPoints || [
  'Garantia por escrito sobre la intervencion realizada.',
  'Pruebas de funcionamiento antes de entregar.',
  'Diagnostico claro si la falla viene de placa, humedad o piezas externas.',
];
const faqs = service.faqs || [];
const ticketTitle = service.ticketTitle || `Crear ticket de ${service.label}`;
const ticketSubtitle = service.ticketSubtitle || `Cuentanos modelo, sintomas y si hubo golpe, humedad, reinicios o reparacion previa. Te contactaremos para confirmar diagnostico y cotizacion.`;
const relatedTitle = service.relatedTitle || `Servicios relacionados con ${service.label}`;
const localZones = ['Zona Hotelera', 'Cancun Centro', 'Av. Tulum', 'Bonampak', 'Puerto Cancun', 'Cumbres', 'Huayacan', 'Bonfil', 'Aeropuerto', 'Parque Industrial'];
const localZoneCopy = `Atendemos clientes de ${localZones.slice(0, 5).join(', ')}, ${localZones.slice(5).join(', ')} y otras zonas de Quintana Roo.`;

const imageByCategory: Record<string, string> = {
  pc: '/assets/images/mantenimiento-pc-escritorio.webp',
  laptop: '/assets/images/laptop-feliz-limpia.webp',
  telefono: '/assets/images/lavado-tarjeta-celular.webp',
  consola: '/assets/images/ps5_xbox.webp',
  impresora: '/assets/images/reparacion-impresoras-cancun.webp',
  b2b: '/assets/images/mac-mini.webp',
  tablet: '/assets/images/iphone-desarmado-2.webp',
  monitor: '/assets/images/mantenimiento-pc-escritorio.webp',
  redes: '/assets/images/mac-mini.webp',
};

const imageRules: Array<{ match: RegExp; image: string }> = [
  { match: /(pantalla-iphone|pantalla-samsung|pantalla|display)/, image: '/assets/images/pantalla-rota-iphone.webp' },
  { match: /(iphone|face-id|camara|lente|tapa|senal|wifi|bluetooth|software)/, image: '/assets/images/iphone-desarmado-2.webp' },
  { match: /(humedad|mojado|placa|microfono|bocina|carga|flex)/, image: '/assets/images/microscopio-flexor.webp' },
  { match: /(ssd|upgrade|lentitud|instalacion-componentes)/, image: '/assets/images/cambio-ssd.webp' },
  { match: /(gamer|gpu|refrigeracion|limpieza|fuente|no-enciende|pantalla-azul)/, image: '/assets/images/mantenimiento-pc-escritorio.webp' },
  { match: /(laptop|teclado|bateria|thermal|pasta|bisagra)/, image: '/assets/images/laptop-gamer-rogstrix.webp' },
  { match: /(ps5|xbox|switch|consola|hdmi|drift)/, image: '/assets/images/ps5_xbox.webp' },
  { match: /(impresora|toner|tinta|rodillo)/, image: '/assets/images/reparacion-impresoras-cancun.webp' },
  { match: /(ipad|tablet|tab)/, image: '/assets/images/iphone-desarmado-2.webp' },
  { match: /(monitor|display|hdmi-monitor)/, image: '/assets/images/mantenimiento-pc-escritorio.webp' },
  { match: /(wifi|red|router|mesh|cableado)/, image: '/assets/images/mac-mini.webp' },
];

function getServiceImage() {
  if (service.featuredImage) return service.featuredImage;

  const key = `${category.slug}-${service.slug}`;

  if (category.slug === 'laptop') {
    if (/(pantalla|display)/.test(service.slug)) return '/assets/images/cambio-pantalla-laptop.webp';
    if (/(pasta|thermal|limpieza|mantenimiento)/.test(service.slug)) return '/assets/images/mantenimiento-pastaternima-thermalpads.webp';
    if (/(upgrade|ssd)/.test(service.slug)) return '/assets/images/cambio-ssd.webp';
    return imageByCategory.laptop;
  }

  if (category.slug === 'pc') {
    if (/(upgrade|ssd|lentitud|instalacion-componentes)/.test(service.slug)) return '/assets/images/cambio-ssd.webp';
    if (/(gamer|gpu)/.test(service.slug)) return '/assets/images/laptop-gamer-rogstrix.webp';
    return imageByCategory.pc;
  }

  return imageRules.find((rule) => rule.match.test(key))?.image || imageByCategory[category.slug] || '/assets/images/reparacion-mac-cancun.webp';
}

const serviceImage = getServiceImage();
const serviceImageAlt = `${keyword} en Cancun - servicio tecnico Pixon PC`;
---

<div class={`sdv sdv-category-${category.slug}`}>
  <section class="sdv-hero">
    <div class="container sdv-hero-grid">
      <div class="sdv-hero-copy">
        <span class="sdv-eyebrow"><i class={`fa-solid ${category.icon}`}></i> {category.title} en Cancun</span>
        <h1>{title}</h1>
        <p>{hook}</p>
        <div class="sdv-hero-actions">
          <a href="#ticket" class="sdv-btn sdv-btn-primary"><i class="fa-solid fa-clipboard-list"></i> Crear ticket</a>
          <a href={`https://wa.me/529986690777?text=${encodeURIComponent(`Hola, quiero cotizar ${service.label} en Cancun.`)}`} target="_blank" rel="noopener noreferrer" class="sdv-btn sdv-btn-secondary"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>
        </div>
      </div>
      <aside class="sdv-hero-card">
        <div class="sdv-hero-media">
          <img src={serviceImage} alt={serviceImageAlt} loading="eager" decoding="async" fetchpriority="high" />
        </div>
        <div class="sdv-hero-card-body">
          <strong>{service.fromPrice || 'Cotizacion clara'}</strong>
          <span>Precio desde</span>
          <div class="sdv-mini-list">
            <p><i class="fa-solid fa-clock"></i> {service.eta || 'Tiempo segun diagnostico'}</p>
            <p><i class="fa-solid fa-shield-halved"></i> {service.warranty || 'Garantia por escrito'}</p>
            <p><i class="fa-solid fa-location-dot"></i> Servicio local en Cancun</p>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <nav class="sdv-anchor-nav" aria-label="Navegacion de la pagina">
    <div class="container">
      <a href="#sintomas">Sintomas</a>
      <a href="#diagnostico">Diagnostico</a>
      <a href="#proceso">Proceso</a>
      <a href="#modelos">Modelos</a>
      <a href="#garantia">Garantia</a>
      {faqs.length > 0 && <a href="#faq">FAQ</a>}
      <a href="#ubicacion">Contacto</a>
    </div>
  </nav>

  <section class="sdv-section sdv-light" id="sintomas">
    <div class="container">
      <div class="sdv-section-head">
        <span class="sdv-eyebrow-dark">Senales comunes</span>
        <h2>Sintomas que revisamos antes de cotizar</h2>
        <p>{description || `Si buscas ${keyword}, lo mas importante es confirmar la causa real antes de cambiar piezas.`}</p>
      </div>
      <div class="sdv-card-grid">
        {symptoms.slice(0, 8).map((item: any) => (
          <article class="sdv-card">
            <i class={`fa-solid ${item.icon || 'fa-circle-exclamation'}`}></i>
            <h3>{item.title || item}</h3>
            <p>{item.text || 'Revisamos esta falla con pruebas reales y te explicamos el siguiente paso.'}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sdv-section sdv-dark" id="diagnostico">
    <div class="container sdv-split">
      <div>
        <span class="sdv-eyebrow">Diagnostico tecnico</span>
        <h2>No cambiamos piezas sin confirmar la falla</h2>
        <p>Revisamos el equipo con pruebas funcionales, inspeccion fisica y contexto de uso. Si hay golpe, humedad, sobrecalentamiento, fallas previas o refacciones no compatibles, te lo explicamos antes de avanzar.</p>
      </div>
      <div class="sdv-proof-grid">
        {whyUs.map((item: any) => (
          <article>
            <i class={`fa-solid ${item.icon || 'fa-check-circle'}`}></i>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sdv-section sdv-light" id="proceso">
    <div class="container">
      <div class="sdv-section-head">
        <span class="sdv-eyebrow-dark">Proceso</span>
        <h2>Ruta de trabajo clara de inicio a entrega</h2>
      </div>
      <div class="sdv-process">
        {process.map((item: any, index: number) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ServiceTicketSection
    id="ticket"
    defaultDevice={category.title}
    defaultService={service.label}
    sourcePage={servicePath}
    title={ticketTitle}
    subtitle={ticketSubtitle}
  />

  <section class="sdv-section sdv-light" id="modelos">
    <div class="container sdv-split sdv-split-reverse">
      <div>
        <span class="sdv-eyebrow-dark">Compatibilidad</span>
        <h2>Marcas y modelos que podemos revisar</h2>
        <p>La disponibilidad de piezas depende del modelo exacto. Si no aparece tu marca, escribenos por WhatsApp y revisamos compatibilidad antes de mover tu equipo.</p>
      </div>
      <div class="sdv-tags">
        {compatible.map((item: string) => <span>{item}</span>)}
      </div>
    </div>
  </section>

  <section class="sdv-section sdv-dark" id="riesgos">
    <div class="container">
      <div class="sdv-section-head sdv-section-head-dark">
        <span class="sdv-eyebrow">Riesgos</span>
        <h2>Cuando conviene revisar antes de seguir usando el equipo</h2>
      </div>
      <div class="sdv-card-grid">
        {risks.map((item: any) => (
          <article class="sdv-card sdv-card-dark">
            <i class={`fa-solid ${item.icon || 'fa-triangle-exclamation'}`}></i>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sdv-section sdv-light" id="garantia">
    <div class="container sdv-split">
      <div>
        <span class="sdv-eyebrow-dark">Garantia y cobertura</span>
        <h2>Servicio local con explicacion clara</h2>
        <p>{localZoneCopy}</p>
      </div>
      <ul class="sdv-check-list">
        {warranties.map((item: string) => <li><i class="fa-solid fa-circle-check"></i>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="sdv-section sdv-local" id="zonas">
    <div class="container sdv-split">
      <div>
        <span class="sdv-eyebrow-dark">Cancun y alrededores</span>
        <h2>Reparacion pensada para el uso real en Cancun</h2>
        <p>El calor, la humedad, el polvo, el salitre, los apagones y el uso intensivo cambian la forma correcta de diagnosticar un equipo. Por eso revisamos sintomas, historial, zona de uso y urgencia antes de recomendar refacciones.</p>
      </div>
      <div class="sdv-zone-grid" aria-label="Zonas de servicio en Cancun">
        {localZones.map((zone: string) => <span><i class="fa-solid fa-location-dot"></i>{zone}</span>)}
      </div>
    </div>
  </section>

  <RelatedServicesSection
    category={category}
    service={service}
    title={relatedTitle}
    includeCategoryServices={true}
    initialLimit={8}
  />

  {faqs.length > 0 && (
    <FaqSection
      id="faq"
      title={`Preguntas frecuentes sobre ${service.label} en Cancun`}
      description="Dudas comunes antes de diagnosticar, cotizar o reparar."
      items={faqs}
      viewMoreHref="/preguntas-frecuentes"
      viewMoreLabel="Ver mas preguntas frecuentes"
      backgroundColor="#F8FAFC"
      questionColor="#0F2A4A"
      titleColor="#0F2A4A"
      descriptionColor="#475569"
      itemGap="8px"
      questionPadding="16px 18px"
    />
  )}

  <CommentsSection viewMoreHref="/comentarios" viewMoreLabel="Ver todas las resenas" id="comentarios" />
  <ContactSection id="ubicacion" />
  <Footer />

  <div class="sdv-mobile-cta" aria-label="Acciones rapidas">
    <a href={`https://wa.me/529986690777?text=${encodeURIComponent(`Hola, quiero cotizar ${service.label} en Cancun.`)}`} target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>
    <a href="#ticket"><i class="fa-solid fa-clipboard-list"></i> Ticket</a>
  </div>
</div>

<style>
  .sdv {
    --sdv-accent: #38BDF8;
    --sdv-accent-strong: #1D4ED8;
    --sdv-hero-start: #071425;
    --sdv-hero-mid: #0B2B54;
    --sdv-hero-end: #0F3B5F;
    background: #F8FAFC;
    color: #0F2A4A;
    padding-bottom: 0;
  }
  .sdv-category-pc {
    --sdv-accent: #22D3EE;
    --sdv-accent-strong: #0E7490;
    --sdv-hero-start: #07111F;
    --sdv-hero-mid: #123A5A;
    --sdv-hero-end: #0F766E;
  }
  .sdv-category-laptop {
    --sdv-accent: #60A5FA;
    --sdv-accent-strong: #2563EB;
    --sdv-hero-start: #08111F;
    --sdv-hero-mid: #123060;
    --sdv-hero-end: #075985;
  }
  .sdv-category-telefono {
    --sdv-accent: #2DD4BF;
    --sdv-accent-strong: #0F766E;
    --sdv-hero-start: #071425;
    --sdv-hero-mid: #0F2A4A;
    --sdv-hero-end: #155E75;
  }
  .sdv-category-consola {
    --sdv-accent: #A3E635;
    --sdv-accent-strong: #4D7C0F;
    --sdv-hero-start: #101018;
    --sdv-hero-mid: #1F2937;
    --sdv-hero-end: #365314;
  }
  .sdv-category-impresora {
    --sdv-accent: #F59E0B;
    --sdv-accent-strong: #B45309;
    --sdv-hero-start: #111827;
    --sdv-hero-mid: #1E3A5F;
    --sdv-hero-end: #92400E;
  }
  .sdv-category-b2b {
    --sdv-accent: #93C5FD;
    --sdv-accent-strong: #1D4ED8;
    --sdv-hero-start: #0F172A;
    --sdv-hero-mid: #1E293B;
    --sdv-hero-end: #164E63;
  }
  .sdv-category-tablet {
    --sdv-accent: #5EEAD4;
    --sdv-accent-strong: #0F766E;
    --sdv-hero-start: #061620;
    --sdv-hero-mid: #0F3440;
    --sdv-hero-end: #0E7490;
  }
  .sdv-category-monitor {
    --sdv-accent: #60A5FA;
    --sdv-accent-strong: #2563EB;
    --sdv-hero-start: #0B1120;
    --sdv-hero-mid: #172554;
    --sdv-hero-end: #1E40AF;
  }
  .sdv-category-redes {
    --sdv-accent: #22D3EE;
    --sdv-accent-strong: #0891B2;
    --sdv-hero-start: #082F49;
    --sdv-hero-mid: #155E75;
    --sdv-hero-end: #0E7490;
  }
  .sdv-hero {
    padding: 110px 0 58px;
    background: radial-gradient(circle at 12% 18%, color-mix(in srgb, var(--sdv-accent) 28%, transparent), transparent 30%), linear-gradient(135deg, var(--sdv-hero-start) 0%, var(--sdv-hero-mid) 54%, var(--sdv-hero-end) 100%);
    color: #F8FAFC;
    overflow: hidden;
  }
  .sdv-hero-grid,
  .sdv-split {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, .85fr);
    gap: 28px;
    align-items: center;
  }
  .sdv-hero h1,
  .sdv-section h2 {
    font-family: 'Kanit', sans-serif;
    letter-spacing: 0;
    margin: 0;
  }
  .sdv-hero h1 {
    font-size: clamp(2.2rem, 5vw, 4.6rem);
    line-height: .98;
    max-width: 780px;
  }
  .sdv-hero p,
  .sdv-dark p {
    color: #DCEBFA;
  }
  .sdv-hero p {
    max-width: 680px;
    font-size: 1.08rem;
    margin: 16px 0 0;
  }
  .sdv-eyebrow,
  .sdv-eyebrow-dark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: .78rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .sdv-eyebrow {
    color: color-mix(in srgb, var(--sdv-accent) 72%, #FFFFFF);
  }
  .sdv-eyebrow-dark {
    color: var(--sdv-accent-strong);
  }
  .sdv-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  .sdv-btn {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border-radius: 8px;
    padding: 12px 18px;
    font-weight: 900;
    text-decoration: none;
  }
  .sdv-btn-primary {
    background: var(--sdv-accent);
    color: #082F49;
  }
  .sdv-btn-secondary {
    background: rgba(255,255,255,.08);
    color: #F8FAFC;
    border: 1px solid rgba(255,255,255,.22);
  }
  .sdv-hero-card,
  .sdv-card,
  .sdv-process article,
  .sdv-proof-grid article {
    border-radius: 8px;
    border: 1px solid #D6E0EC;
    background: #FFFFFF;
    box-shadow: 0 18px 42px rgba(15,42,74,.08);
  }
  .sdv-hero-card {
    padding: 0;
    overflow: hidden;
    color: #0F2A4A;
  }
  .sdv-hero-media {
    position: relative;
    aspect-ratio: 16 / 11;
    background: #D6E0EC;
    overflow: hidden;
  }
  .sdv-hero-media::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 36%;
    background: linear-gradient(180deg, transparent, rgba(15,42,74,.42));
  }
  .sdv-hero-media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .sdv-hero-card-body {
    padding: 22px;
  }
  .sdv-hero-card strong {
    display: block;
    font-family: 'Kanit', sans-serif;
    font-size: 2rem;
    line-height: 1;
  }
  .sdv-hero-card span {
    color: #64748B;
    font-weight: 800;
  }
  .sdv-mini-list {
    display: grid;
    gap: 10px;
    margin-top: 18px;
  }
  .sdv-mini-list p {
    margin: 0;
    color: #334155;
    font-weight: 800;
  }
  .sdv-anchor-nav {
    position: sticky;
    top: 64px;
    z-index: 20;
    background: rgba(255,255,255,.92);
    border-bottom: 1px solid #D6E0EC;
    backdrop-filter: blur(10px);
  }
  .sdv-anchor-nav .container {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-top: 8px;
    padding-bottom: 8px;
  }
  .sdv-anchor-nav a {
    color: #0F2A4A;
    text-decoration: none;
    font-weight: 900;
    border-radius: 8px;
    padding: 8px 12px;
    white-space: nowrap;
  }
  .sdv-anchor-nav a:hover {
    background: #EAF2FF;
    color: var(--sdv-accent-strong);
  }
  .sdv-section {
    padding: 72px 0;
  }
  .sdv-light {
    background: #F8FAFC;
  }
  .sdv-dark {
    background: #0B1120;
    color: #F8FAFC;
  }
  .sdv-section-head {
    max-width: 780px;
    margin-bottom: 30px;
  }
  .sdv-section-head h2,
  .sdv-split h2 {
    color: #0F2A4A;
    font-size: clamp(1.8rem, 3vw, 2.55rem);
    line-height: 1.05;
  }
  .sdv-section-head p,
  .sdv-split p,
  .sdv-card p,
  .sdv-process p,
  .sdv-proof-grid p {
    color: #334155;
  }
  .sdv-section-head-dark h2 {
    color: #F8FAFC;
  }
  .sdv-card-grid,
