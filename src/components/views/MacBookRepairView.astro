---
import type { ServiceCategory, ServiceItem } from '../../data/services';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import FaqSection from '../FaqSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import Footer from '../Footer.astro';

interface Props {
  service: ServiceItem;
  category: ServiceCategory;
  faqs: { question: string; answer: string }[];
}

const { service, faqs } = Astro.props;

const whatsappText = encodeURIComponent(`Hola Pixon PC. Necesito revisar mi MacBook.

Modelo: MacBook Air / Pro
Año o chip (si lo sé):
Falla principal:
¿Enciende? Sí / No
¿Carga? Sí / No
¿Hubo líquido? Sí / No
¿Fue reparada antes? Sí / No

Puedo enviar fotos.`);
const whatsappUrl = `https://wa.me/529986690777?text=${whatsappText}`;

const symptoms = [
  { id: 'no-enciende', icon: 'fa-power-off', label: 'No enciende', title: 'No enciende o no da señal', desc: 'Probamos cargador, USB-C o MagSafe, batería, consumo, pantalla externa y placa antes de asumir la causa.', owner: { href: '/servicios/mac/macbook-no-enciende', label: 'Ver servicio de no enciende →' } },
  { id: 'no-carga', icon: 'fa-plug-circle-xmark', label: 'No carga', title: 'No carga o solo carga a veces', desc: 'Revisamos cable, adaptador, puerto USB-C o MagSafe, batería, SMC y posible daño en circuito de carga.', owner: null },
  { id: 'pantalla', icon: 'fa-display', label: 'Pantalla', title: 'Pantalla negra, rota o con líneas', desc: 'Separamos panel, flex, backlight, salida externa y placa antes de cotizar una pantalla.', owner: { href: '/servicios/mac/cambio-pantalla-macbook', label: 'Ver cambio de pantalla →' } },
  { id: 'bateria', icon: 'fa-battery-quarter', label: 'Batería', title: 'Batería se agota, infla o apaga', desc: 'Medimos ciclos, salud, consumo, temperatura y riesgo para trackpad y carcasa antes de instalar batería.', owner: { href: '/servicios/mac/cambio-bateria-macbook', label: 'Ver cambio de batería →' } },
  { id: 'teclado', icon: 'fa-keyboard', label: 'Teclado / Trackpad', title: 'Teclado o trackpad no responden', desc: 'Validamos teclas, flex, top case, batería inflada, humedad y compatibilidad antes de cotizar reemplazo.', owner: null },
  { id: 'usb', icon: 'fa-plug', label: 'USB-C / MagSafe', title: 'Puerto USB-C o MagSafe dañado', desc: 'Revisamos falso contacto, consumo, flex y circuito de carga para determinar el alcance real.', owner: null },
  { id: 'liquido', icon: 'fa-droplet', label: 'Líquido / Humedad', title: 'Derrame, humedad o salitre', desc: 'No recomendamos energizar. Revisamos placa, conectores y corrosión antes de aplicar corriente.', owner: { href: '/servicios/mac/limpieza-liquido-macbook', label: 'Ver daño por líquido →' } },
  { id: 'macos', icon: 'fa-hard-drive', label: 'macOS / Sistema', title: 'macOS lento, reinicios o datos', desc: 'Revisamos arranque, almacenamiento, temperatura, errores y respaldo antes de reinstalar.', owner: { href: '/servicios/mac/software-macos', label: 'Ver servicio de macOS →' } },
];

const repairTypes = [
  { id: 'modulo', label: 'Por módulo', icon: 'fa-puzzle-piece', items: ['Pantalla / display', 'Batería', 'Teclado / top case', 'Trackpad', 'Puertos modulares', 'Cámara'], note: 'Pieza identificada y reemplazada cuando la causa está confirmada.' },
  { id: 'placa', label: 'Nivel de componente', icon: 'fa-microchip', items: ['Circuito de alimentación', 'Carga USB-C / MagSafe', 'Cortos en placa', 'Corrosión por líquido', 'Conectores internos'], note: 'Se evalúa caso por caso. No toda falla de placa es reparable.' },
  { id: 'software', label: 'Sistema y software', icon: 'fa-terminal', items: ['macOS dañado o lento', 'Arranque / Recovery', 'Configuración de usuario', 'Datos y respaldo', 'FileVault / contraseñas'], note: 'Se deriva al owner especializado cuando corresponde.' },
];

const process = [
  { n: '01', title: 'Recepción', desc: 'Registramos modelo, chip, síntomas, cargador, golpes, líquido y reparaciones previas.' },
  { n: '02', title: 'Pruebas de energía', desc: 'Verificamos cargador, USB-C o MagSafe, consumo, batería, encendido y pantalla.' },
  { n: '03', title: 'Revisión de módulos', desc: 'Teclado, trackpad, flex, humedad, top case y comportamiento bajo macOS cuando inicia.' },
  { n: '04', title: 'Diagnóstico y hallazgo', desc: 'Identificamos causa, alcance de la falla y riesgo para datos antes de cotizar.' },
  { n: '05', title: 'Cotización y autorización', desc: 'Te enviamos opciones, tiempo y garantía por WhatsApp. No reparamos sin aprobación.' },
  { n: '06', title: 'Reparación y validación', desc: 'Instalamos, probamos carga, teclado, pantalla, temperatura y estabilidad antes de entregar.' },
];

const relatedOwners = [
  { href: '/servicios/mac/diagnostico-mac', icon: 'fa-magnifying-glass', label: 'Diagnóstico Mac', desc: 'Cuando la falla aún no está identificada.' },
  { href: '/servicios/mac/macbook-no-enciende', icon: 'fa-power-off', label: 'MacBook no enciende', desc: 'Sin señal de vida, carga ni respuesta.' },
  { href: '/servicios/mac/cambio-pantalla-macbook', icon: 'fa-display', label: 'Cambio de pantalla', desc: 'Pantalla rota, con líneas o sin imagen.' },
  { href: '/servicios/mac/cambio-bateria-macbook', icon: 'fa-battery-three-quarters', label: 'Cambio de batería', desc: 'Batería que no dura, se infla o se apaga.' },
  { href: '/servicios/mac/limpieza-liquido-macbook', icon: 'fa-droplet', label: 'Daño por líquido', desc: 'Derrame, humedad o salitre en la placa.' },
  { href: '/servicios/mac/software-macos', icon: 'fa-terminal', label: 'Software / macOS', desc: 'Arranque, errores de sistema y recuperación.' },
  { href: '/servicios/mac/mantenimiento-macbook', icon: 'fa-screwdriver-wrench', label: 'Mantenimiento', desc: 'Temperatura, ventilación y pasta térmica.' },
  { href: '/servicios/mac/diagnostico-mac', icon: 'fa-magnifying-glass-chart', label: 'No sé cuál es la falla', desc: 'El diagnóstico identifica la causa exacta.' },
];

const risks = [
  { icon: 'fa-plug-circle-xmark', title: 'No sigas conectando el cargador', desc: 'Si no carga, huele raro o tuvo líquido, conectar puede agravar batería, puerto o placa.', href: null },
  { icon: 'fa-keyboard', title: 'No fuerces teclas ni top case', desc: 'Trackpad levantado o carcasa abierta pueden indicar batería inflada o daño interno.', href: null },
  { icon: 'fa-database', title: 'No reinstales macOS sin respaldo', desc: 'Si hay reinicios o pantalla negra, primero revisamos datos antes de borrar o reinstalar.', href: '/servicios/mac/software-macos' },
  { icon: 'fa-droplet', title: 'Líquido y salitre avanzan rápido', desc: 'En Cancún la humedad acelera corrosión. Apaga el equipo y tráela antes de encender de nuevo.', href: '/servicios/mac/limpieza-liquido-macbook' },
];
---

<main class="mr-page">

  <!-- HERO -->
  <section class="mr-hero" id="inicio">
    <div class="container mr-hero__grid">
      <div class="mr-hero__copy">
        <p class="mr-eyebrow"><span></span>Servicio técnico Mac · Cancún</p>
        <h1>Reparación de MacBook en Cancún</h1>
        <p class="mr-lead">Cuando una MacBook falla, no empezamos cambiando piezas.</p>
        <p class="mr-body">Identificamos si el problema está en alimentación, carga, pantalla, batería, teclado, macOS o placa y cotizamos solo lo necesario.</p>
        <div class="mr-actions">
          <a class="mr-btn mr-btn--primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer" id="hero-wa-macbook-repair">
            <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Revisar mi MacBook
          </a>
          <a class="mr-btn mr-btn--secondary" href="#ticket" id="hero-ticket-macbook-repair">
            <i class="fa-solid fa-clipboard-list" aria-hidden="true"></i> Crear ticket
          </a>
        </div>
        <ul class="mr-trust" aria-label="Puntos del servicio">
          <li>MacBook Air y Pro</li>
          <li>Intel y Apple Silicon</li>
          <li>Diagnóstico antes de reparar</li>
          <li>Cotización previa</li>
        </ul>
      </div>

      <!-- MICROSCOPE VISUAL -->
      <div class="mr-hero__visual" aria-hidden="true">
        <figure class="mr-scope" data-scope-animation>
          <div class="mr-scope__ring">
            <div class="mr-scope__vignette"></div>
            <svg class="mr-scope__pcb" viewBox="0 0 480 480" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
              <defs>
                <radialGradient id="mr-pcb-bg" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#0c2235"/>
                  <stop offset="70%" stop-color="#081828"/>
                  <stop offset="100%" stop-color="#040e18"/>
                </radialGradient>
                <linearGradient id="mr-trace-h" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%" stop-color="#0e4f6e" stop-opacity="0"/>
                  <stop offset="30%" stop-color="#1b8ab8"/>
                  <stop offset="70%" stop-color="#62c8f4"/>
                  <stop offset="100%" stop-color="#0e4f6e" stop-opacity="0"/>
                </linearGradient>
                <linearGradient id="mr-trace-v" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#0e4f6e" stop-opacity="0"/>
                  <stop offset="30%" stop-color="#1b8ab8"/>
                  <stop offset="70%" stop-color="#62c8f4"/>
                  <stop offset="100%" stop-color="#0e4f6e" stop-opacity="0"/>
                </linearGradient>
                <radialGradient id="mr-ic-glow" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#62c8f4" stop-opacity="0.35"/>
                  <stop offset="100%" stop-color="#62c8f4" stop-opacity="0"/>
                </radialGradient>
                <radialGradient id="mr-solder-glow" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#f5a623" stop-opacity="0.9"/>
                  <stop offset="50%" stop-color="#e07b0a" stop-opacity="0.5"/>
                  <stop offset="100%" stop-color="#e07b0a" stop-opacity="0"/>
                </radialGradient>
                <clipPath id="mr-scope-mask">
                  <circle cx="240" cy="240" r="225"/>
                </clipPath>
                <filter id="mr-glow-sm">
                  <feGaussianBlur stdDeviation="3" result="blur"/>
                  <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                </filter>
              </defs>
              <g clip-path="url(#mr-scope-mask)">
                <circle cx="240" cy="240" r="240" fill="url(#mr-pcb-bg)"/>
                <g opacity="0.07" stroke="#4ab3d4" stroke-width="0.5">
                  <line x1="44" y1="0" x2="44" y2="480"/><line x1="88" y1="0" x2="88" y2="480"/><line x1="132" y1="0" x2="132" y2="480"/>
                  <line x1="176" y1="0" x2="176" y2="480"/><line x1="220" y1="0" x2="220" y2="480"/><line x1="264" y1="0" x2="264" y2="480"/>
                  <line x1="308" y1="0" x2="308" y2="480"/><line x1="352" y1="0" x2="352" y2="480"/><line x1="396" y1="0" x2="396" y2="480"/>
                  <line x1="440" y1="0" x2="440" y2="480"/><line x1="0" y1="44" x2="480" y2="44"/><line x1="0" y1="88" x2="480" y2="88"/>
                  <line x1="0" y1="132" x2="480" y2="132"/><line x1="0" y1="176" x2="480" y2="176"/><line x1="0" y1="220" x2="480" y2="220"/>
                  <line x1="0" y1="264" x2="480" y2="264"/><line x1="0" y1="308" x2="480" y2="308"/><line x1="0" y1="352" x2="480" y2="352"/>
                  <line x1="0" y1="396" x2="480" y2="396"/><line x1="0" y1="440" x2="480" y2="440"/>
                </g>
                <rect class="mr-trace mr-trace--h1" x="0" y="148" width="480" height="2" fill="url(#mr-trace-h)" opacity="0.7"/>
                <rect class="mr-trace mr-trace--h2" x="0" y="240" width="480" height="2.5" fill="url(#mr-trace-h)" opacity="0.9"/>
                <rect class="mr-trace mr-trace--h3" x="0" y="332" width="480" height="2" fill="url(#mr-trace-h)" opacity="0.6"/>
                <rect class="mr-trace mr-trace--v1" x="148" y="0" width="2" height="480" fill="url(#mr-trace-v)" opacity="0.7"/>
                <rect class="mr-trace mr-trace--v2" x="240" y="0" width="2.5" height="480" fill="url(#mr-trace-v)" opacity="0.9"/>
                <rect class="mr-trace mr-trace--v3" x="332" y="0" width="2" height="480" fill="url(#mr-trace-v)" opacity="0.6"/>
                <g fill="none" stroke="#62c8f4" stroke-width="1.2" opacity="0.55">
                  <circle cx="148" cy="148" r="5"/><circle cx="332" cy="148" r="5"/>
                  <circle cx="148" cy="332" r="5"/><circle cx="332" cy="332" r="5"/>
                  <circle cx="240" cy="148" r="4"/><circle cx="240" cy="332" r="4"/>
                  <circle cx="148" cy="240" r="4"/><circle cx="332" cy="240" r="4"/>
                </g>
                <g class="mr-component" fill="#0d3550" stroke="#1a6a90" stroke-width="1">
                  <rect x="58" y="60" width="30" height="20" rx="2"/><rect x="68" y="88" width="20" height="12" rx="2"/>
                </g>
                <g class="mr-component" fill="#0d3550" stroke="#1a6a90" stroke-width="1">
                  <rect x="392" y="60" width="28" height="18" rx="2"/><rect x="396" y="84" width="18" height="11" rx="2"/>
                </g>
                <g class="mr-component" fill="#0d3550" stroke="#1a6a90" stroke-width="1">
                  <rect x="60" y="392" width="26" height="16" rx="2"/>
                </g>
                <g class="mr-component" fill="#0d3550" stroke="#1a6a90" stroke-width="1">
                  <rect x="393" y="396" width="24" height="15" rx="2"/>
                </g>
                <g class="mr-ic-block" filter="url(#mr-glow-sm)">
                  <rect x="172" y="72" width="60" height="46" rx="4" fill="#0a2840" stroke="#2d84b0" stroke-width="1.5"/>
                  <rect x="178" y="70" width="6" height="4" rx="1" fill="#1b6fa0"/><rect x="188" y="70" width="6" height="4" rx="1" fill="#1b6fa0"/>
                  <rect x="198" y="70" width="6" height="4" rx="1" fill="#1b6fa0"/><rect x="208" y="70" width="6" height="4" rx="1" fill="#1b6fa0"/>
                  <rect x="170" y="80" width="4" height="8" rx="1" fill="#1b6fa0"/><rect x="170" y="94" width="4" height="8" rx="1" fill="#1b6fa0"/>
                  <rect x="228" y="80" width="4" height="8" rx="1" fill="#1b6fa0"/><rect x="228" y="94" width="4" height="8" rx="1" fill="#1b6fa0"/>
                </g>
                <g class="mr-ic-block" filter="url(#mr-glow-sm)">
                  <rect x="72" y="192" width="46" height="60" rx="4" fill="#0a2840" stroke="#2d84b0" stroke-width="1.5"/>
                  <rect x="70" y="198" width="4" height="8" rx="1" fill="#1b6fa0"/><rect x="70" y="212" width="4" height="8" rx="1" fill="#1b6fa0"/>
                  <rect x="116" y="198" width="4" height="8" rx="1" fill="#1b6fa0"/><rect x="116" y="212" width="4" height="8" rx="1" fill="#1b6fa0"/>
                </g>
                <g class="mr-ic-block" filter="url(#mr-glow-sm)">
                  <rect x="362" y="192" width="46" height="60" rx="4" fill="#0a2840" stroke="#2d84b0" stroke-width="1.5"/>
                  <rect x="360" y="198" width="4" height="8" rx="1" fill="#1b6fa0"/><rect x="360" y="212" width="4" height="8" rx="1" fill="#1b6fa0"/>
                  <rect x="406" y="198" width="4" height="8" rx="1" fill="#1b6fa0"/><rect x="406" y="212" width="4" height="8" rx="1" fill="#1b6fa0"/>
                </g>
                <!-- Central Apple Silicon IC -->
                <circle cx="240" cy="240" r="78" fill="url(#mr-ic-glow)" opacity="0.6"/>
                <rect class="mr-central-ic" x="182" y="182" width="116" height="116" rx="10" fill="#091f32" stroke="#3eaede" stroke-width="2.5"/>
                <g stroke="#1a5a7a" stroke-width="1" opacity="0.6">
                  <line x1="198" y1="182" x2="198" y2="298"/><line x1="214" y1="182" x2="214" y2="298"/>
                  <line x1="240" y1="182" x2="240" y2="298"/><line x1="266" y1="182" x2="266" y2="298"/>
                  <line x1="182" y1="198" x2="298" y2="198"/><line x1="182" y1="240" x2="298" y2="240"/>
                  <line x1="182" y1="266" x2="298" y2="266"/>
                </g>
                <rect x="207" y="207" width="66" height="66" rx="5" fill="#0e2d46" stroke="#4ab4d8" stroke-width="1.5"/>
                <g fill="#2a8abd">
                  <rect x="188" y="180" width="8" height="4" rx="1"/><rect x="204" y="180" width="8" height="4" rx="1"/>
                  <rect x="220" y="180" width="8" height="4" rx="1"/><rect x="236" y="180" width="8" height="4" rx="1"/>
                  <rect x="252" y="180" width="8" height="4" rx="1"/><rect x="268" y="180" width="8" height="4" rx="1"/>
                  <rect x="188" y="296" width="8" height="4" rx="1"/><rect x="204" y="296" width="8" height="4" rx="1"/>
                  <rect x="220" y="296" width="8" height="4" rx="1"/><rect x="236" y="296" width="8" height="4" rx="1"/>
                  <rect x="252" y="296" width="8" height="4" rx="1"/><rect x="268" y="296" width="8" height="4" rx="1"/>
                  <rect x="180" y="188" width="4" height="8" rx="1"/><rect x="180" y="204" width="4" height="8" rx="1"/>
                  <rect x="180" y="220" width="4" height="8" rx="1"/><rect x="180" y="252" width="4" height="8" rx="1"/>
                  <rect x="180" y="268" width="4" height="8" rx="1"/><rect x="180" y="284" width="4" height="8" rx="1"/>
                  <rect x="296" y="188" width="4" height="8" rx="1"/><rect x="296" y="204" width="4" height="8" rx="1"/>
                  <rect x="296" y="220" width="4" height="8" rx="1"/><rect x="296" y="252" width="4" height="8" rx="1"/>
                  <rect x="296" y="268" width="4" height="8" rx="1"/><rect x="296" y="284" width="4" height="8" rx="1"/>
                </g>
                <!-- Solder point -->
                <circle class="mr-solder-glow" cx="294" cy="215" r="22" fill="url(#mr-solder-glow)"/>
                <line class="mr-tool-tip" x1="318" y1="192" x2="297" y2="217" stroke="#c0cdd8" stroke-width="3.5" stroke-linecap="round"/>
                <circle class="mr-solder-dot" cx="295" cy="216" r="4.5" fill="#f5a623"/>
                <circle cx="295" cy="216" r="2" fill="#ffe08a"/>
                <g class="mr-sparks" stroke="#f5a623" stroke-width="1.5" stroke-linecap="round" opacity="0.75">
                  <line x1="299" y1="210" x2="305" y2="204"/>
                  <line x1="302" y1="215" x2="310" y2="213"/>
                  <line x1="298" y1="220" x2="305" y2="226"/>
                </g>
                <circle class="mr-pulse mr-pulse--h" cx="0" cy="240" r="4" fill="#62c8f4" opacity="0.9"/>
                <circle class="mr-pulse mr-pulse--v" cx="240" cy="0" r="4" fill="#62c8f4" opacity="0.9"/>
              </g>
              <circle cx="240" cy="240" r="226" fill="none" stroke="#1c3d54" stroke-width="8"/>
              <circle cx="240" cy="240" r="230" fill="none" stroke="#0e2333" stroke-width="6"/>
              <g stroke="#4ab3d4" stroke-width="1" opacity="0.18">
                <line x1="240" y1="15" x2="240" y2="465"/>
                <line x1="15" y1="240" x2="465" y2="240"/>
                <circle cx="240" cy="240" r="60" fill="none"/>
                <circle cx="240" cy="240" r="120" fill="none"/>
              </g>
            </svg>
          </div>
          <figcaption>
            <span class="mr-scope-dot"></span>
            <span data-scope-status>Analizando placa lógica</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- TRIAGE -->
  <section class="mr-section mr-triage" id="sintomas">
    <div class="container">
      <div class="mr-heading">
        <p class="mr-section-label">¿Qué le pasa a tu MacBook?</p>
        <h2>Identifica la falla antes de traerla</h2>
        <span>Selecciona el síntoma principal para ver qué revisamos primero.</span>
      </div>
      <div class="mr-symptom-grid" role="list">
        {symptoms.map((s) => (
          <button class="mr-symptom-card" type="button" data-symptom={s.id} role="listitem" aria-expanded="false" id={`symptom-btn-${s.id}`}>
            <i class={`fa-solid ${s.icon}`} aria-hidden="true"></i>
            <span>{s.label}</span>
          </button>
        ))}
      </div>
      <div class="mr-symptom-detail" id="symptom-detail" aria-live="polite">
        <div class="mr-symptom-default">
          <i class="fa-solid fa-arrow-pointer" aria-hidden="true"></i>
          <p>Selecciona un síntoma para ver qué revisamos.</p>
        </div>
        {symptoms.map((s) => (
          <div class="mr-symptom-info" id={`symptom-info-${s.id}`} hidden>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            {s.owner && (
              <a href={s.owner.href} class="mr-symptom-link">{s.owner.label} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            )}
            {!s.owner && (
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="mr-symptom-link">Consultar por WhatsApp <i class="fa-brands fa-whatsapp" aria-hidden="true"></i></a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TYPES -->
  <section class="mr-section mr-repair-types" id="tipos">
    <div class="container">
      <div class="mr-heading">
        <p class="mr-section-label">Según la causa</p>
        <h2>No toda falla necesita el mismo tipo de reparación</h2>
        <span>El diagnóstico determina el camino. Cotizamos solo el alcance real.</span>
      </div>
      <div class="mr-type-grid">
        {repairTypes.map((rt) => (
          <div class="mr-type-card">
            <div class="mr-type-icon"><i class={`fa-solid ${rt.icon}`} aria-hidden="true"></i></div>
            <h3>{rt.label}</h3>
