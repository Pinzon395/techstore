<script>
  const scope = document.querySelector('[data-scope-animation]');
  if (scope) {
    const statusEl = scope.querySelector('[data-scope-status]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const states = ['Analizando placa lógica','Revisando circuitos de alimentación','Verificando módulo de carga','Trazando vías de señal','Diagnóstico en progreso…'];
    let si = 0;
    if (reduced) {
      scope.classList.add('mr-scope--ready');
      if (statusEl) statusEl.textContent = 'Diagnóstico completado';
    } else {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting && e.intersectionRatio >= 0.3)) {
          scope.classList.add('mr-scope--active');
          if (statusEl) {
            const interval = setInterval(() => { si = (si + 1) % states.length; statusEl.textContent = states[si]; }, 2400);
            setTimeout(() => { clearInterval(interval); scope.classList.add('mr-scope--ready'); if (statusEl) statusEl.textContent = 'Diagnóstico completado'; }, 15000);
          }
          observer.disconnect();
        }
      }, { threshold: [0.3] });
      observer.observe(scope);
    }
  }
  const symptomBtns = document.querySelectorAll<HTMLButtonElement>('[data-symptom]');
  const defaultInfo = document.querySelector<HTMLElement>('.mr-symptom-default');
  let activeBtn: HTMLButtonElement | null = null;
  symptomBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = (btn as HTMLButtonElement).dataset.symptom;
      const info = document.getElementById('symptom-info-' + id);
      if (activeBtn === btn) {
        btn.classList.remove('mr-symptom-card--active');
        btn.setAttribute('aria-expanded','false');
        info?.setAttribute('hidden','');
        if (defaultInfo) (defaultInfo as HTMLElement).hidden = false;
        activeBtn = null;
        return;
      }
      if (activeBtn) {
        const prevId = (activeBtn as HTMLButtonElement).dataset.symptom;
        activeBtn.classList.remove('mr-symptom-card--active');
        activeBtn.setAttribute('aria-expanded','false');
        document.getElementById('symptom-info-' + prevId)?.setAttribute('hidden','');
      }
      btn.classList.add('mr-symptom-card--active');
      btn.setAttribute('aria-expanded','true');
      if (defaultInfo) (defaultInfo as HTMLElement).hidden = true;
      info?.removeAttribute('hidden');
      activeBtn = btn;
    });
  });
</script>

