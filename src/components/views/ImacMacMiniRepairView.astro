---
import FaqSection from '../FaqSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import Footer from '../Footer.astro';
import { diagnosticPolicy } from '../../lib/business';

const { service, category } = Astro.props;

const whatsappText = encodeURIComponent(
  'Hola, quiero diagnóstico para iMac o Mac mini en Cancún. Mi equipo presenta falla y quiero cotizar revisión.'
);

const heroStats = [
  { value: 'iMac', label: 'Intel y Apple Silicon' },
  { value: 'Mac mini', label: 'M1, M2 e Intel' },
  { value: '24-72 h', label: 'Diagnóstico común' },
];

const localSeoCards = [
  {
    icon: 'fa-location-dot',
    title: 'Reparación iMac en Cancún Centro y alrededores',
    copy: 'Atendemos iMac lenta, sin imagen, con pantalla negra, ventilador al maximo, macOS dañado o almacenamiento en riesgo. Revisamos antes de cambiar piezas.',
  },
  {
    icon: 'fa-desktop',
    title: 'Servicio Mac mini en Cancún para oficina y home office',
    copy: 'Diagnosticamos Mac mini que no prende, no da video HDMI/USB-C, se calienta, se congela, no arranca macOS o trabaja lento con apps de oficina o diseño.',
  },
  {
    icon: 'fa-temperature-high',
    title: 'Mantenimiento iMac por calor, polvo y humedad de Cancún',
    copy: 'El clima de Cancún acelera polvo, salitre y temperatura. Revisamos ventilación, sensores, pasta térmica, fuente, placa y estabilidad bajo carga.',
  },
  {
    icon: 'fa-microchip',
    title: 'Diagnóstico senior para iMac Intel y Apple Silicon',
    copy: 'Separamos falla de fuente, pantalla, flex, SSD, RAM, placa, sistema macOS, puertos, monitor externo y accesorios antes de entregar una cotización.',
  },
];

const symptoms = [
  'iMac no prende o prende y se apaga',
  'Mac mini no da imagen por HDMI o USB-C',
  'Pantalla negra, rayas, brillo bajo o sin backlight',
  'macOS lento, congelado o con reinicios',
  'Ventilador fuerte, calor excesivo o apagones',
  'Disco lleno, SSD dañado o riesgo de datos',
  'Puertos USB-C, USB-A, Ethernet o audio fallando',
  'Humedad, salitre, polvo o líquido cerca del equipo',
];

const process = [
  {
    step: '01',
    title: 'Recepción técnica del equipo',
    copy: 'Registramos modelo exacto, año, chip, síntomas, accesorios, intentos previos y prioridad de datos.',
  },
  {
    step: '02',
    title: 'Pruebas por módulo',
    copy: 'Probamos energía, video, monitor externo, almacenamiento, macOS, temperatura, puertos, memoria y placa.',
  },
  {
    step: '03',
    title: 'Cotización clara',
    copy: 'Te explicamos causa probable, opciones, riesgo, tiempo, garantía y si conviene reparar o respaldar primero.',
  },
  {
    step: '04',
    title: 'Entrega con evidencia',
    copy: 'Validamos arranque, estabilidad, temperatura, video, red, puertos y funcionamiento antes de cerrar el servicio.',
  },
];

const imageBlocks = [
  {
    image: '/assets/images/mac-mini.webp',
    alt: 'Reparación de Mac mini en Cancún con diagnóstico técnico',
    eyebrow: 'Mac mini Cancún',
    title: 'Mac mini no prende, no da imagen o trabaja lento',
    copy: 'Revisamos energía, HDMI, USB-C, almacenamiento, macOS, red, Bluetooth, temperatura y placa. Ideal para equipos de oficina, estudio, recepción, administración o trabajo remoto.',
  },
  {
    image: '/assets/images/reparacion-mac-cancun.webp',
    alt: 'Reparación de iMac en Cancún con soporte Apple especializado',
    eyebrow: 'iMac Cancún',
    title: 'Reparación iMac con diagnóstico antes de abrir pantalla',
    copy: 'Antes de desmontar una iMac validamos síntomas, salida externa, fuente, sistema, almacenamiento y temperatura para reducir riesgos y cotizar con información real.',
  },
  {
    image: '/assets/images/mantenimiento-macbook-cancun.webp',
    alt: 'Mantenimiento de equipos Apple por calor y polvo en Cancún',
    eyebrow: 'Mantenimiento Apple',
    title: 'Limpieza y mantenimiento para equipos Apple en clima de Cancún',
    copy: 'El polvo, humedad y calor afectan ventilación, sensores y estabilidad. El mantenimiento correcto ayuda a prevenir apagones, lentitud y daño progresivo.',
  },
];

const faqs = [
  {
    question: '¿Reparan iMac y Mac mini en Cancún?',
    answer: 'Sí. Revisamos iMac Intel, iMac Apple Silicon, Mac mini Intel y Mac mini M1/M2 según modelo, síntoma y disponibilidad de piezas.',
  },
  {
    question: '¿Cuánto cuesta diagnosticar una iMac o Mac mini?',
    answer: `El diagnóstico técnico inicia desde $${diagnosticPolicy.startingPriceMXN} MXN y puede variar según la complejidad de la revisión. La reparación o sustitución se cotiza por separado después de confirmar el modelo exacto y la falla.`,
  },
  {
    question: '¿Pueden revisar una iMac que no da imagen?',
    answer: 'Sí. Probamos salida externa, pantalla, backlight, flex, fuente, almacenamiento, macOS y placa para separar falla de video, sistema o hardware.',
  },
  {
    question: '¿Mis datos se pierden durante la reparación?',
    answer: 'No deberían perderse en una reparación física normal. Si detectamos riesgo de SSD, sistema o placa, primero recomendamos respaldo o recuperación.',
  },
  {
    question: '¿Atienden empresas con Mac mini o iMac en Cancún?',
    answer: 'Sí. Podemos revisar equipos de oficina, recepción, diseño, administración y home office, con seguimiento por ticket y factura cuando aplica.',
  },
];
---

<div class="imac-page">
  <section class="imac-hero">
    <div class="imac-bg" aria-hidden="true"></div>
    <div class="imac-container imac-hero-grid">
      <div class="imac-hero-copy">
        <p class="imac-eyebrow">Servicio técnico Apple en Cancún</p>
        <h1>Reparación iMac y Mac mini en Cancún</h1>
        <p class="imac-lead">
          Diagnóstico senior para iMac y Mac mini que no prenden, no dan imagen,
          trabajan lento, se calientan, fallan con macOS o tienen riesgo de datos.
        </p>
        <div class="imac-actions">
          <a class="imac-btn imac-btn-primary" href={`https://wa.me/529986690777?text=${whatsappText}`}>
            Cotizar por WhatsApp
          </a>
          <a class="imac-btn imac-btn-ghost" href="#diagnostico-imac-cancun">
            Ver diagnóstico
          </a>
        </div>
        <div class="imac-stats" aria-label="Resumen del servicio">
          {heroStats.map((item) => (
            <div>
              <strong>{item.value}</strong>
              <span>{item.label}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="imac-visual-card">
        <img src="/assets/images/mac-mini.webp" alt="Mac mini e iMac con diagnóstico especializado en Cancún" loading="eager" />
        <div class="imac-floating-panel">
          <span>Revisión profesional</span>
          <strong>Encendido, video, macOS, SSD, temperatura y puertos</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="imac-section" id="diagnostico-imac-cancun">
    <div class="imac-container">
      <div class="imac-section-head">
        <p class="imac-eyebrow">SEO local y servicio real</p>
        <h2>Diagnóstico iMac en Cancún antes de cambiar piezas</h2>
        <p>
          Una iMac puede fallar por fuente, pantalla, almacenamiento, macOS,
          temperatura, humedad, flex o placa. Por eso primero hacemos pruebas
          por módulo y después te damos una ruta clara de reparación.
        </p>
      </div>
      <div class="imac-card-grid">
        {localSeoCards.map((card) => (
          <article class="imac-info-card">
            <svg class="fa-icon" aria-hidden="true"><use href={`/assets/icons/sprite.svg#${card.icon}`}></use></svg>
            <h2>{card.title}</h2>
            <p>{card.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="imac-section imac-section-dark">
    <div class="imac-container imac-split">
      <div>
        <p class="imac-eyebrow">Fallas comunes</p>
        <h2>Mac mini no prende o iMac no da imagen en Cancún</h2>
        <p>
          Si tu equipo Apple de escritorio falla, evita seguir forzando el
          encendido. Revisamos síntomas críticos sin prometer cambios de pieza
          innecesarios.
        </p>
      </div>
      <div class="imac-symptom-list">
        {symptoms.map((symptom) => (
          <div>
            <span></span>
            <p>{symptom}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {imageBlocks.map((block, index) => (
    <section class={`imac-image-section ${index % 2 === 1 ? 'is-alt' : ''}`}>
      <div class="imac-container imac-image-grid">
        <div class="imac-image-wrap">
          <img src={block.image} alt={block.alt} loading="lazy" />
        </div>
        <div class="imac-image-copy">
          <p class="imac-eyebrow">{block.eyebrow}</p>
          <h2>{block.title}</h2>
          <p>{block.copy}</p>
          <ul>
          <li>Diagnóstico por modelo exacto</li>
            <li>Cotización antes de reparar</li>
            <li>Pruebas de entrega y garantía cuando aplica</li>
          </ul>
        </div>
      </div>
    </section>
  ))}

  <section class="imac-section" id="mantenimiento-imac-cancun">
    <div class="imac-container">
      <div class="imac-section-head">
        <p class="imac-eyebrow">Proceso técnico</p>
        <h2>Mantenimiento iMac y reparación Mac mini con seguimiento</h2>
        <p>
          Nuestro flujo está pensado para que sepas qué se revisó, qué conviene
          reparar y qué riesgo existe antes de autorizar cualquier trabajo.
        </p>
      </div>
      <div class="imac-process">
        {process.map((item) => (
          <article>
            <span>{item.step}</span>
            <h2>{item.title}</h2>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="imac-section imac-local-band">
    <div class="imac-container">
      <p class="imac-eyebrow">Cobertura local</p>
      <h2>Reparación de Mac en Cancún, Huayacán, Cumbres y Zona Hotelera</h2>
      <p>
        Atendemos usuarios particulares, home office, oficinas, hoteles,
        despachos, estudios creativos y negocios que usan iMac o Mac mini para
        trabajo diario. Podemos orientar por WhatsApp antes de recibir el equipo.
      </p>
      <div class="imac-zone-list">
        <span>Cancún Centro</span>
        <span>Zona Hotelera</span>
        <span>Huayacán</span>
        <span>Cumbres</span>
        <span>Bonampak</span>
        <span>Puerto Cancún</span>
      </div>
    </div>
  </section>

  <ServiceTicketSection
    id="ticket"
    defaultDevice="iMac"
    defaultService="Reparación iMac y Mac mini"
    title="Agenda diagnóstico para iMac o Mac mini"
    subtitle="Cuéntanos modelo, año aproximado, síntomas, si no prende, no da imagen, se calienta, va lento o tiene riesgo de datos."
  />

  <RelatedServicesSection category={category} service={service} title="Servicios Apple relacionados" />

  <FaqSection
    title="Preguntas frecuentes sobre reparación iMac y Mac mini en Cancún"
    description="Dudas comunes antes de revisar una iMac o Mac mini con falla de encendido, video, macOS, temperatura o almacenamiento."
    items={faqs}
  />

  <CommentsSection dark={true} viewMoreHref="/comentarios" viewMoreLabel="Ver todas las reseñas" id="comentarios" />
  <ContactSection id="ubicacion" />
  <Footer />
</div>

<style>
  .imac-page {
    background: #07111f;
    color: #e5eefb;
    overflow: hidden;
  }
  .imac-container {
    width: min(1160px, calc(100% - (var(--page-gutter) * 2)));
    margin: 0 auto;
  }
  .imac-hero {
    position: relative;
    padding: 82px 0 76px;
    background:
      radial-gradient(circle at 18% 12%, rgba(14, 165, 233, 0.28), transparent 34%),
      radial-gradient(circle at 88% 18%, rgba(20, 184, 166, 0.22), transparent 34%),
      linear-gradient(135deg, #07111f 0%, #0f172a 54%, #0b3b4a 100%);
  }
  .imac-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(to bottom, #000, transparent 84%);
    pointer-events: none;
  }
  .imac-hero-grid,
  .imac-split,
  .imac-image-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(360px, 0.98fr);
    gap: 42px;
    align-items: center;
    position: relative;
  }
  .imac-eyebrow {
    color: #67e8f9;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.78rem;
    margin: 0 0 10px;
  }
  .imac-hero h1,
  .imac-section h2,
  .imac-image-copy h2,
  .imac-local-band h2 {
    font-family: 'Kanit', sans-serif;
    letter-spacing: -0.035em;
    line-height: 1.03;
  }
  .imac-hero h1 {
    color: #ffffff;
    font-size: clamp(2.55rem, 6vw, 5.25rem);
    margin: 0 0 18px;
    max-width: 760px;
  }
  .imac-lead {
    color: #cbd5e1;
    font-size: clamp(1.05rem, 2vw, 1.24rem);
    line-height: 1.65;
    max-width: 680px;
    margin: 0;
  }
  .imac-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 28px 0 24px;
  }
  .imac-btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 48px;
    padding: 13px 18px;
    border-radius: 999px;
    font-weight: 900;
    text-decoration: none;
  }
  .imac-btn-primary {
    background: #06b6d4;
    color: #06131f;
    box-shadow: 0 20px 46px rgba(6, 182, 212, 0.28);
  }
  .imac-btn-ghost {
    color: #e2e8f0;
    border: 1px solid rgba(226, 232, 240, 0.24);
    background: rgba(255,255,255,0.06);
  }
  .imac-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    max-width: 640px;
  }
  .imac-stats div,
  .imac-visual-card,
  .imac-info-card,
  .imac-process article {
    border: 1px solid rgba(148, 163, 184, 0.18);
    background: rgba(255,255,255,0.07);
    box-shadow: 0 24px 60px rgba(0,0,0,0.22);
    backdrop-filter: blur(16px);
  }
  .imac-stats div {
    border-radius: 18px;
    padding: 14px;
  }
  .imac-stats strong {
    display: block;
    color: #fff;
    font-size: 1.1rem;
  }
  .imac-stats span {
    color: #94a3b8;
    font-size: 0.86rem;
  }
  .imac-visual-card {
    position: relative;
    border-radius: 30px;
    padding: 14px;
  }
  .imac-visual-card img,
  .imac-image-wrap img {
    width: 100%;
    display: block;
    border-radius: 22px;
    object-fit: cover;
  }
  .imac-visual-card img {
    aspect-ratio: 4 / 3;
  }
  .imac-floating-panel {
    position: absolute;
    left: 28px;
    right: 28px;
    bottom: 28px;
    padding: 16px;
    border-radius: 18px;
    background: rgba(7, 17, 31, 0.84);
    border: 1px solid rgba(103, 232, 249, 0.26);
  }
  .imac-floating-panel span {
    display: block;
    color: #67e8f9;
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .imac-floating-panel strong {
    color: #fff;
  }
  .imac-section,
  .imac-image-section {
    padding: 74px 0;
    background: #f8fafc;
    color: #0f172a;
  }
  .imac-section-dark {
    background: #eef6ff;
    color: #0f2a4a;
  }
  .imac-section-head {
    max-width: 860px;
    margin: 0 auto 28px;
    text-align: center;
  }
  .imac-section h2,
  .imac-image-copy h2,
  .imac-local-band h2 {
    font-size: clamp(1.9rem, 4vw, 3.2rem);
    margin: 0 0 12px;
  }
  .imac-section p,
  .imac-image-copy p,
  .imac-local-band p {
    color: #475569;
    line-height: 1.7;
    margin: 0;
  }
  .imac-section-dark p {
    color: #0f2a4a;
  }
  .imac-section-dark .imac-eyebrow,
  .imac-section-dark h2 {
    color: #0f2a4a;
  }
  .imac-card-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  .imac-info-card {
    background: #ffffff;
    border-color: rgba(14, 165, 233, 0.16);
    border-radius: 22px;
    padding: 22px;
  }
  .imac-info-card .fa-icon {
    width: 42px;
    height: 42px;
    color: #0891b2;
    margin-bottom: 14px;
  }
  .imac-info-card h2,
  .imac-process h2 {
    font-size: 1.08rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .imac-info-card p,
  .imac-process p {
    font-size: 0.94rem;
  }
  .imac-symptom-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .imac-symptom-list div {
    display: flex;
    gap: 10px;
    padding: 13px 14px;
    border-radius: 16px;
    background: #ffffff;
    border: 1px solid rgba(15, 42, 74, 0.12);
    box-shadow: 0 16px 34px rgba(15, 42, 74, 0.08);
  }
  .imac-symptom-list span {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: #0f2a4a;
    margin-top: 8px;
    flex: 0 0 auto;
  }
  .imac-symptom-list p {
    color: #0f2a4a;
    margin: 0;
    font-weight: 700;
  }
  .imac-image-section.is-alt {
    background: #eef6ff;
  }
  .imac-image-section.is-alt .imac-image-wrap {
    order: 2;
  }
  .imac-image-wrap img {
    aspect-ratio: 16 / 10;
    box-shadow: 0 22px 58px rgba(15,23,42,0.18);
  }
  .imac-image-copy ul {
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
    display: grid;
    gap: 10px;
  }
  .imac-image-copy li {
    padding: 12px 14px;
    border-radius: 14px;
    background: #fff;
    border: 1px solid rgba(14, 165, 233, 0.16);
    font-weight: 800;
    color: #0f172a;
  }
  .imac-process {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  .imac-process article {
    background: #ffffff;
    border-color: rgba(14, 165, 233, 0.16);
    border-radius: 22px;
    padding: 22px;
  }
  .imac-process span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 16px;
    background: #cffafe;
    color: #0e7490;
    font-weight: 950;
    margin-bottom: 14px;
  }
  .imac-local-band {
    background:
      radial-gradient(circle at 15% 20%, rgba(34, 211, 238, 0.22), transparent 30%),
      linear-gradient(135deg, #0f172a, #082f49);
    color: #fff;
    text-align: center;
  }
  .imac-local-band p {
    color: #cbd5e1;
    max-width: 850px;
    margin: 0 auto;
  }
  .imac-zone-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
  }
  .imac-zone-list span {
    padding: 10px 14px;
    border-radius: 999px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(103,232,249,0.2);
    color: #e0f2fe;
    font-weight: 850;
  }
  .imac-page :global(.faq-page-content) {
    background: #0f2a4a !important;
  }
  .imac-page :global(.faq-page-content h2),
  .imac-page :global(.faq-page-content p),
  .imac-page :global(.faq-page-content .faq-question),
  .imac-page :global(.faq-page-content .faq-answer-inner) {
    color: #ffffff !important;
  }
  .imac-page :global(.faq-page-content .faq-item) {
    background: rgba(255, 255, 255, 0.08) !important;
    border-color: rgba(255, 255, 255, 0.16) !important;
  }
  .imac-page :global(#ubicacion.contact) {
    background: #0f2a4a !important;
    color: #ffffff !important;
  }
  .imac-page :global(#ubicacion.contact h2),
  .imac-page :global(#ubicacion.contact h3),
  .imac-page :global(#ubicacion.contact p),
  .imac-page :global(#ubicacion.contact strong),
  .imac-page :global(#ubicacion.contact a),
  .imac-page :global(#ubicacion.contact .description-text),
  .imac-page :global(#ubicacion.contact .coverage-title),
  .imac-page :global(#ubicacion.contact .coverage-subtitle),
  .imac-page :global(#ubicacion.contact .coverage-zone) {
    color: #ffffff !important;
  }
  .imac-page :global(#ubicacion.contact .contact-form),
  .imac-page :global(#ubicacion.contact .coverage-area),
  .imac-page :global(#ubicacion.contact .contact-details li) {
    background: rgba(255, 255, 255, 0.08) !important;
    border-color: rgba(255, 255, 255, 0.16) !important;
  }
  @media (max-width: 980px) {
    .imac-hero-grid,
    .imac-split,
    .imac-image-grid,
    .imac-card-grid,
    .imac-process {
      grid-template-columns: 1fr;
    }
    .imac-image-section.is-alt .imac-image-wrap {
      order: 0;
    }
