---
import FaqSection from '../FaqSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import Footer from '../Footer.astro';

const { service, category } = Astro.props;

const waMessage = encodeURIComponent(
  'Hola Pixon PC, necesito soporte TI para oficinas en Cancún. Tenemos PCs lentas, impresoras, red, Windows o respaldos pendientes.'
);

const officeAreas = [
  { title: 'Administración y contabilidad', desc: 'Equipos con Windows lento, errores de Office, respaldos y correo corporativo.', icon: 'fa-calculator' },
  { title: 'Recepción y atención', desc: 'PCs, impresoras y red que no pueden detener el flujo de trabajo diario.', icon: 'fa-clipboard-list' },
  { title: 'Ventas y dirección', desc: 'Laptops ejecutivas, agendas, archivos compartidos y coordinación remota.', icon: 'fa-briefcase' },
  { title: 'Operación interna', desc: 'Usuarios, contraseñas, acceso a carpetas, permisos y equipos compartidos.', icon: 'fa-users-gear' },
];

const officeProblems = [
  {
    title: 'PC lenta o Windows dañado',
    h3: 'La computadora tarda en abrir Office, navegar o iniciar sesión',
    desc: 'Revisamos discos lentos, virus, programas al inicio, poca RAM, sobrecarga de temporales y posibles fallas de almacenamiento antes de recomendar formateo.',
  },
  {
    title: 'Impresoras y multifuncionales',
    h3: 'La oficina imprime mal, marca error o deja trabajos atorados',
    desc: 'Corregimos drivers, colas de impresión, conexión WiFi o USB, configuración por usuario y problemas de papel, tinta o tóner.',
  },
  {
    title: 'Red y WiFi de oficina',
    h3: 'Internet inestable, equipo sin red o acceso compartido mal configurado',
    desc: 'Revisamos router, switches, cableado, IP, señal WiFi y separación de red entre usuarios, invitados y equipos críticos.',
  },
  {
    title: 'Respaldos y archivos críticos',
    h3: 'Documentos de trabajo, cotizaciones y carpetas compartidas en riesgo',
    desc: 'Ayudamos a ordenar respaldos locales o externos para reducir pérdida de información cuando un disco o Windows empieza a fallar.',
  },
];

const workflow = [
  {
    step: '01',
    title: 'Levantamiento rápido',
    text: 'Identificamos cuántos equipos hay, qué falla en cada área y qué tan urgente es cada incidente.',
  },
  {
    step: '02',
    title: 'Priorización por operación',
    text: 'Atendemos primero lo que detiene trabajo: caja, administración, impresión, correo, red o acceso a archivos.',
  },
  {
    step: '03',
    title: 'Diagnóstico y acción',
    text: 'Damos el estado técnico real y resolvemos con reparación, limpieza, reinstalación o cambio de equipo cuando conviene.',
  },
  {
    step: '04',
    title: 'Cierre con seguimiento',
    text: 'Dejamos registro claro de lo atendido, lo que quedó pendiente y lo que conviene mantener preventivo.',
  },
];

const localZones = [
  'Cancún Centro',
  'Bonampak',
  'Av. Tulum',
  'Puerto Cancún',
  'Cumbres',
  'Huayacán',
  'Polígono Sur',
  'Supermanzanas',
];

const supportBenefits = [
  'Tickets y seguimiento por equipo',
  'Soporte para PC, laptop e impresora',
  'Respaldo antes de formatear o intervenir',
  'Reportes claros para administración',
  'Atención local en Cancún y zonas cercanas',
  'Diagnóstico antes de recomendar reemplazo',
];

const faqs = [
  {
    question: '¿Atienden soporte para varias computadoras de oficina al mismo tiempo?',
    answer: 'Sí. Podemos organizar atención por prioridad, por lote o por equipo crítico. Eso sirve cuando hay varias PCs, laptops o impresoras que necesitan revisión en la misma jornada.',
  },
  {
    question: '¿También revisan impresoras y red?',
    answer: 'Sí. Revisamos impresoras, drivers, red local, WiFi, cableado básico, accesos compartidos y equipos que dependen de conectividad para trabajar.',
  },
  {
    question: '¿Pueden ayudar antes de formatear una computadora?',
    answer: 'Sí. Primero revisamos si la lentitud viene de Windows, virus, disco, RAM o temperatura. Solo recomendamos formatear cuando realmente ayuda al equipo.',
  },
  {
    question: '¿Manejan respaldo de archivos de trabajo?',
    answer: 'Sí. Si el disco aún responde, respaldamos documentos, carpetas y archivos importantes antes de tocar el sistema o cambiar componentes.',
  },
  {
    question: '¿Dan seguimiento para oficinas y negocios locales?',
    answer: 'Sí. El servicio está pensado para oficinas en Cancún con comunicación clara por WhatsApp, diagnóstico directo y atención enfocada en continuidad operativa.',
  },
];
---

<div class="office-support-page">
  <section class="office-hero">
    <div class="container office-hero-grid">
      <div class="office-copy">
        <span class="office-kicker"><i class="fa-solid fa-building-shield"></i> Servicio técnico local en Cancún</span>
        <h1>Soporte TI para oficinas en Cancún con red, impresoras, Windows y respaldo</h1>
        <p class="office-lead">
          Mantenemos computadoras, laptops, impresoras y red de oficina con diagnóstico claro, tickets por incidencia y atención pensada para que el trabajo no se detenga.
        </p>
        <p class="office-subcopy">
          Si tu oficina tiene PCs lentas, impresoras que no responden, archivos importantes en riesgo o usuarios que no pueden trabajar, revisamos primero la causa real antes de recomendar formateo o cambio de equipo.
        </p>
        <div class="office-actions">
          <a class="office-btn office-btn--primary" href="#ticket-office-support">
            <i class="fa-solid fa-ticket"></i> Crear ticket
          </a>
          <a class="office-btn office-btn--secondary" href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank" rel="noopener">
            <i class="fa-brands fa-whatsapp"></i> Solicitar revisión
          </a>
        </div>
        <ul class="office-bullets" aria-label="Beneficios del servicio">
          {supportBenefits.map((item) => <li><i class="fa-solid fa-circle-check"></i> {item}</li>)}
        </ul>
      </div>

      <aside class="office-hero-panel">
        <div class="office-hero-collage">
          <img src="/assets/images/mantenimiento-pc-escritorio.webp" alt="Soporte TI para oficinas en Cancún revisando computadora de escritorio" class="office-collage-main" loading="eager" fetchpriority="high" decoding="async" />
          <img src="/assets/images/reparacion-impresoras-cancun.webp" alt="Impresora de oficina con mantenimiento y revisión técnica en Cancún" class="office-collage-secondary office-collage-secondary--printer" loading="lazy" decoding="async" />
          <img src="/assets/images/optimizacion-pc-cancun.webp" alt="Optimización de Windows y PC de oficina en Cancún" class="office-collage-secondary office-collage-secondary--windows" loading="lazy" decoding="async" />
        </div>
        <div class="office-hero-meta">
          <strong>{service.fromPrice || 'Cotización según alcance'}</strong>
          <span>{service.eta || 'Tiempo de respuesta según prioridad'}</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="office-section office-section--intro">
    <div class="container office-split">
      <div class="office-copy-block">
        <span class="office-eyebrow">Qué resolvemos</span>
        <h2>Soporte técnico para oficinas que necesitan orden, velocidad y continuidad</h2>
        <p>
          No vendemos soporte genérico. Atendemos computadoras de oficina con fallas reales: Windows dañado, usuarios bloqueados, impresoras sin driver, red inestable, archivos dispersos o equipos que ya no responden al ritmo del trabajo.
        </p>
        <p>
          Cuando una oficina se detiene, el problema no es solo la computadora. También se frena la facturación, el seguimiento, la atención al cliente y la operación interna. Por eso el servicio se organiza por prioridad.
        </p>
      </div>
      <figure class="office-figure">
        <img src="/assets/images/formateo-windows-cancun.webp" alt="Formateo y reinstalación de Windows para computadoras de oficina en Cancún" width="442" height="595" loading="lazy" decoding="async" />
        <figcaption>Si conviene reinstalar Windows, lo hacemos con respaldo previo y revisión de compatibilidad.</figcaption>
      </figure>
    </div>
  </section>

  <section class="office-section">
    <div class="container">
      <div class="office-section-head">
        <span class="office-eyebrow">Problemas frecuentes</span>
        <h2>Fallas de oficina que atendemos todos los días</h2>
      </div>
      <div class="office-problem-grid">
        {officeProblems.map((item) => (
          <article class="office-problem-card">
            <h3>{item.h3}</h3>
            <p class="office-problem-label">{item.title}</p>
            <p>{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="office-section office-section--band">
    <div class="container office-band">
      <figure class="office-band-figure">
        <img src="/assets/images/soporte-hoteles-hero.webp" alt="Infraestructura de red y soporte técnico empresarial en Cancún" width="1024" height="1024" loading="lazy" decoding="async" />
      </figure>
      <div class="office-band-copy">
        <span class="office-eyebrow">Red, usuarios y acceso</span>
        <h2>Qué debe incluir un soporte TI serio para oficinas</h2>
        <h3>PCs y laptops sin lentitud innecesaria</h3>
        <p>
          Revisamos inicio de Windows, almacenamiento, temperatura, virus, actualizaciones y configuración de usuario para que el equipo vuelva a trabajar con estabilidad.
        </p>
        <h3>Impresoras listas para operar</h3>
        <p>
          Corregimos conexión por WiFi o USB, drivers, colas de impresión y errores típicos de impresión compartida entre departamentos.
        </p>
        <h3>Red local y respaldos funcionales</h3>
        <p>
          Dejamos una base técnica para que los archivos importantes no dependan de una sola computadora ni de una sola memoria USB.
        </p>
      </div>
    </div>
  </section>

  <section class="office-section">
    <div class="container office-split office-split--reverse">
      <div class="office-copy-block">
        <span class="office-eyebrow">Proceso de trabajo</span>
        <h2>Cómo damos soporte a oficinas sin interrumpir toda la operación</h2>
        <p>
          Primero entendemos el flujo real del negocio. No es lo mismo revisar un escritorio administrativo, una impresora compartida o una laptop ejecutiva. La prioridad cambia según el impacto sobre la jornada.
        </p>
        <p>
          En vez de improvisar, dejamos un orden: diagnóstico, resolución, prueba y seguimiento. Así evitamos que el mismo problema vuelva al día siguiente.
        </p>
      </div>
      <div class="office-workflow">
        {workflow.map((item) => (
          <article class="office-workflow-step">
            <span>{item.step}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="office-section office-section--intro">
    <div class="container office-split">
      <div class="office-copy-block">
        <span class="office-eyebrow">Cobertura local</span>
        <h2>Soporte TI para oficinas en Cancún con atención natural por zonas</h2>
        <p>
          Atendemos oficinas en Cancún Centro, Bonampak, Av. Tulum, Puerto Cancún, Huayacán, Cumbres, Polígono Sur y Supermanzanas. La ubicación no cambia la calidad del diagnóstico, pero sí ayuda a planear mejor la visita.
        </p>
        <p>
          Cuando la oficina necesita continuidad, la comunicación importa tanto como la reparación. Por eso dejamos clara la causa, el alcance y lo que conviene hacer después.
        </p>
      </div>
      <div class="office-zone-panel">
        <img src="/assets/images/laptop-feliz-limpia.webp" alt="Laptop lista para trabajo de oficina después de soporte y optimización en Cancún" loading="lazy" decoding="async" />
        <ul>
          {localZones.map((zone) => <li><i class="fa-solid fa-map-pin"></i> {zone}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="office-section">
    <div class="container office-pills">
      {officeAreas.map((area) => (
        <article class="office-pill">
          <i class={`fa-solid ${area.icon}`}></i>
          <div>
            <h3>{area.title}</h3>
            <p>{area.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="office-section office-section--band">
    <div class="container office-image-row">
      <figure>
        <img src="/assets/images/actualizacion-windows-cancun.webp" alt="Actualización y soporte de Windows para oficina en Cancún" loading="lazy" decoding="async" />
      </figure>
      <figure>
        <img src="/assets/images/formateo-windows-cancun.webp" alt="Formateo de computadora para oficina con respaldo previo en Cancún" loading="lazy" decoding="async" />
      </figure>
      <figure>
        <img src="/assets/images/pc-gamer-gama-media.webp" alt="Computadora de oficina optimizada después de soporte técnico en Cancún" loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="office-section office-section--seo">
    <div class="container office-seo-copy">
      <span class="office-eyebrow">SEO local</span>
      <h2>Soporte TI para oficinas en Cancún con intención real de servicio</h2>
      <p>
        Este servicio está pensado para oficinas que necesitan resolver algo concreto: una computadora lenta, una impresora que no imprime, una red inestable o archivos que deben respaldarse antes de tocar el sistema. El objetivo es operar mejor, no llenar la página con texto vacío.
      </p>
      <p>
        Si el problema viene de Windows, disco, RAM, temperatura o software mal instalado, te lo decimos con claridad. Si conviene limpiar, optimizar o reinstalar, te explicamos la razón antes de trabajar.
      </p>
    </div>
  </section>

  <ServiceTicketSection
    id="ticket-office-support"
    sourcePage={Astro.url.pathname}
    defaultDevice="Equipo empresarial / B2B"
    defaultService={service.label}
    title="Crear ticket de soporte para oficinas"
    subtitle="Describe el equipo, la falla y la prioridad. Si hace falta, coordinamos revisión por área o por lote."
  />

  <RelatedServicesSection
    category={category}
    service={service}
    light={true}
    title="Servicios relacionados para oficinas"
    eyebrow="Más soluciones B2B"
  />

  <FaqSection
    id="faq-office-support"
    title="Preguntas frecuentes sobre soporte TI para oficinas"
    description="Respuestas directas para administración, operación y seguimiento técnico."
    items={faqs}
    sectionClass="office-faq"
    titleColor="#071F3A"
    descriptionColor="#071F3A"
    questionColor="#071F3A"
  />

  <CommentsSection
    id="comentarios-office-support"
    title="Comentarios de clientes"
    description="Comparte tu experiencia con el soporte para oficinas."
    dark={false}
  />

  <ContactSection id="contacto-office-support" />

  <Footer />
</div>

<style>
  .office-support-page {
    background: #ffffff;
    color: #071F3A;
  }
  .office-support-page h1,
  .office-support-page h2,
  .office-support-page h3,
  .office-support-page p,
  .office-support-page li,
  .office-support-page figcaption,
  .office-support-page span,
  .office-support-page strong,
  .office-support-page small {
    color: #071F3A;
  }
  .office-support-page .office-hero {
    background: linear-gradient(135deg, #061429 0%, #0B2A4A 100%);
    color: #ffffff;
    padding: 72px 0 54px;
  }
  .office-support-page .office-hero * {
    color: inherit;
  }
  .office-support-page .office-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
    gap: 34px;
    align-items: center;
  }
  .office-support-page .office-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #7dd3fc;
    font-weight: 800;
    letter-spacing: 0.02em;
    margin-bottom: 16px;
  }
  .office-support-page h1 {
    font-size: clamp(2rem, 3.3vw, 3.35rem);
    line-height: 1.06;
    margin: 0 0 16px;
    max-width: 12.5ch;
    font-family: 'Kanit', sans-serif;
    color: #ffffff;
  }
  .office-support-page .office-lead {
    font-size: 1.08rem;
    line-height: 1.65;
    max-width: 62ch;
    color: #e2e8f0;
    margin-bottom: 12px;
  }
  .office-support-page .office-subcopy {
    font-size: 0.98rem;
    line-height: 1.7;
    max-width: 64ch;
    color: #cbd5e1;
    margin-bottom: 24px;
  }
  .office-support-page .office-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .office-support-page .office-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 18px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 800;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .office-support-page .office-btn:hover {
    transform: translateY(-1px);
  }
  .office-support-page .office-btn--primary {
    background: #f59e0b;
    color: #0f172a;
  }
  .office-support-page .office-btn--secondary {
    background: rgba(255,255,255,0.04);
    color: #ffffff;
    border: 1px solid rgba(255,255,255,0.18);
  }
  .office-support-page .office-bullets {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 18px;
    padding: 0;
    margin: 0;
  }
  .office-support-page .office-bullets li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    color: #e2e8f0;
    line-height: 1.45;
  }
  .office-support-page .office-bullets i {
    color: #38bdf8;
    margin-top: 3px;
    flex: 0 0 auto;
  }
  .office-support-page .office-hero-panel {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 18px;
    padding: 16px;
    backdrop-filter: blur(10px);
  }
  .office-support-page .office-hero-collage {
    position: relative;
    min-height: 420px;
  }
  .office-support-page .office-hero-collage img {
    position: absolute;
    object-fit: cover;
    box-shadow: 0 24px 60px rgba(0,0,0,0.24);
    border-radius: 16px;
  }
  .office-support-page .office-collage-main {
    inset: 0;
    width: 68%;
    height: 100%;
  }
  .office-support-page .office-collage-secondary {
    width: 42%;
    height: 46%;
  }
  .office-support-page .office-collage-secondary--printer {
    right: 0;
    top: 0;
  }
  .office-support-page .office-collage-secondary--windows {
    right: 0;
    bottom: 0;
  }
  .office-support-page .office-hero-meta {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid rgba(255,255,255,0.14);
  }
  .office-support-page .office-hero-meta strong,
  .office-support-page .office-hero-meta span {
    color: #e2e8f0;
  }
  .office-support-page .office-section {
    padding: 64px 0;
  }
  .office-support-page .office-section--intro,
  .office-support-page .office-section--seo {
    background: #ffffff;
  }
  .office-support-page .office-section--band {
    background: #f8fbff;
  }
  .office-support-page .office-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #1d4ed8;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 14px;
    font-size: 0.82rem;
  }
  .office-support-page .office-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.92fr);
    gap: 30px;
    align-items: center;
  }
  .office-support-page .office-split--reverse {
    grid-template-columns: minmax(320px, 0.92fr) minmax(0, 1fr);
  }
  .office-support-page .office-copy-block h2,
  .office-support-page .office-section-head h2,
  .office-support-page .office-band-copy h2,
  .office-support-page .office-seo-copy h2 {
    font-family: 'Kanit', sans-serif;
    font-size: clamp(1.7rem, 2.4vw, 2.35rem);
    margin: 0 0 14px;
    line-height: 1.15;
  }
  .office-support-page .office-copy-block p,
  .office-support-page .office-band-copy p,
  .office-support-page .office-seo-copy p {
    line-height: 1.7;
    margin: 0 0 12px;
    color: #071F3A;
  }
  .office-support-page .office-figure {
    margin: 0;
  }
  .office-support-page .office-figure img {
    width: 100%;
    border-radius: 18px;
    display: block;
  }
  .office-support-page .office-figure figcaption {
    margin-top: 10px;
    color: #334155;
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .office-support-page .office-section-head {
    margin-bottom: 24px;
  }
  .office-support-page .office-problem-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  .office-support-page .office-problem-card {
    border: 1px solid rgba(7,31,58,0.12);
    border-radius: 16px;
    padding: 22px;
    background: #ffffff;
    box-shadow: 0 8px 24px rgba(7,31,58,0.04);
  }
  .office-support-page .office-problem-card h3 {
    margin: 0 0 8px;
    font-size: 1.06rem;
  }
  .office-support-page .office-problem-label {
    margin: 0 0 10px;
    color: #1d4ed8;
    font-weight: 700;
  }
  .office-support-page .office-band {
    display: grid;
    grid-template-columns: minmax(300px, 0.9fr) minmax(0, 1.1fr);
    gap: 28px;
    align-items: center;
  }
  .office-support-page .office-band-figure img {
    width: 100%;
    border-radius: 18px;
    display: block;
  }
  .office-support-page .office-band-copy h3 {
    font-size: 1.02rem;
    margin: 18px 0 8px;
    color: #071F3A;
  }
  .office-support-page .office-workflow {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .office-support-page .office-workflow-step {
    display: flex;
    gap: 14px;
    border: 1px solid rgba(7,31,58,0.12);
    border-radius: 16px;
    padding: 18px;
