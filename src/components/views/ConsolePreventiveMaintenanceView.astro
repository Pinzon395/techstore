---
import FaqSection from '../FaqSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';

const { service, category } = Astro.props;

const waMessage = encodeURIComponent(
  'Hola, quiero cotizar mantenimiento preventivo de consola en Cancún. Mi consola se calienta y quiero evitar apagados.'
);

const pmFaqs = [
  {
    question: '¿Cuánto cuesta el mantenimiento preventivo de consola en Cancún?',
    answer: 'El servicio preventivo básico inicia en $700 MXN. Depende del modelo exacto (PlayStation 5, Xbox Series X, Nintendo Switch, etc.) y de si requiere materiales térmicos especiales como metal líquido o almohadillas térmicas de alta conductividad para evitar que se apague tu consola.',
  },
  {
    question: '¿La limpieza de consola en Cancún incluye cambio de pasta térmica?',
    answer: 'Sí, incluye desarmado total, remoción de polvo del ventilador, limpieza del disipador de calor y reemplazo de pasta térmica vieja por una premium. Esto previene el sobrecalentamiento y elimina el lag en consola durante partidas exigentes.',
  },
  {
    question: '¿Por qué se traba mi consola Nintendo Switch en Cancún?',
    answer: 'El calor y la humedad de Cancún aceleran el secado de la pasta térmica. Si se traba tu consola, reduce su rendimiento o se apaga sola, requiere limpieza interna y cambio de pasta térmica de inmediato para evitar una pantalla negra en tu consola por daño térmico permanente.',
  },
  {
    question: '¿En el mantenimiento preventivo de PS5 se cambia el metal líquido?',
    answer: 'En la PS5 inspeccionamos visualmente que no haya zonas secas o desplazamientos del metal líquido en el procesador APU. Si es necesario, lo redistribuimos o aplicamos metal líquido nuevo con aislamiento protector para evitar cortocircuitos y sobrecalentamiento severo.',
  },
  {
    question: '¿Qué pasa si no hago mantenimiento preventivo y mi consola tiene lag?',
    answer: 'No realizar la limpieza interna provoca acumulación de polvo pesado y salitre de Cancún. Esto tapa las rejillas, haciendo que el ventilador gire a máximas revoluciones (ruido de turbina), aparezca el lag térmico (caída de FPS), se apague la consola sola para protegerse o incluso sufra un daño total en la placa base.',
  },
  {
    question: '¿El mantenimiento preventivo de consolas en Cancún tiene garantía?',
    answer: 'Garantizamos el ensamble profesional, la correcta aplicación del compuesto térmico y la limpieza profunda del sistema de ventilación. Esto reduce drásticamente las temperaturas y previene que tu consola se apague sola o muestre pantalla negra a futuro.',
  },
];

const pmSymptoms = [
  {
    icon: 'fa-fan',
    title: 'Ventilador ruidoso a tope',
    desc: 'Tu consola suena como avión a punto de despegar. El disipador está tapado de polvo o la pasta térmica se secó, forzando al extractor a trabajar al límite.',
  },
  {
    icon: 'fa-temperature-arrow-up',
    title: 'Sobrecalentamiento extremo',
    desc: 'La carcasa expulsa aire hirviendo o se siente muy caliente. Sin mantenimiento preventivo, el chip gráfico corre riesgo de desoldarse por calor excesivo.',
  },
  {
    icon: 'fa-triangle-exclamation',
    title: 'Se apaga mi consola sola',
    desc: 'La consola se apaga de repente a mitad de la partida. Es el sistema de seguridad térmica previniendo que el procesador se queme por completo.',
  },
  {
    icon: 'fa-gauge-high',
    title: 'Se traba mi consola (Lag)',
    desc: 'Los juegos sufren tirones, caídas drásticas de FPS o se congelan. El procesador baja su velocidad (thermal throttling) en un intento de enfriarse.',
  },
];

const processes = [
  {
    num: '01',
    title: 'Pruebas de estrés y diagnóstico térmico',
    desc: 'Encendemos la consola y corremos un juego exigente para medir la temperatura inicial, verificar si hay lag en la consola o si se traba bajo carga de trabajo.',
  },
  {
    num: '02',
    title: 'Desarmado completo profesional',
    desc: 'Abrimos tu PlayStation, Xbox o Nintendo Switch usando herramientas de precisión antiestáticas para proteger los flexores, clips de plástico y componentes internos.',
  },
  {
    num: '03',
    title: 'Limpieza interna profunda',
    desc: 'Retiramos el polvo acumulado, pelusas, humedad y rastro de salitre de las aspas del ventilador, disipador de cobre, rejillas de ventilación y fuente de poder.',
  },
  {
    num: '04',
    title: 'Renovación de compuesto térmico',
    desc: 'Limpiamos los residuos endurecidos y aplicamos pasta térmica premium de alta conductividad térmica o redistribuimos/reemplazamos el metal líquido (según el modelo de PS5).',
  },
  {
    num: '05',
    title: 'Pruebas de estabilidad final',
    desc: 'Reensamblamos el equipo y realizamos pruebas de juego durante 30-45 minutos para garantizar un funcionamiento silencioso, frío y libre de pantallas negras.',
  },
];
---

<div class="console-preventive-page">
  <!-- HERO SECTION -->
  <section class="cpm-hero">
    <div class="cpm-hero-glow"></div>
    <div class="container cpm-hero-grid">
      <div class="cpm-hero-copy">
        <span class="cpm-kicker"><i class="fa-solid fa-screwdriver-wrench"></i> Servicio técnico de consolas en Cancún</span>
        <h1>Mantenimiento preventivo de consola en Cancún</h1>
        <h2>Prolonga la vida de tu PlayStation, Xbox o Nintendo Switch y evita que se apague sola por sobrecalentamiento.</h2>
        <p>
          El polvo, la pelusa y la humedad salina de Cancún son enemigos directos de tu equipo. Si notas que <strong>se traba tu consola</strong>, tiene lag constante o se apaga sola al jugar, nuestro servicio de <strong>mantenimiento preventivo de consola</strong> elimina la suciedad interna antes de provocar un daño permanente en la placa o la temida pantalla negra.
        </p>
        <div class="cpm-badges">
          <span>Limpieza interna profunda</span>
          <span>Pasta térmica premium</span>
          <span>Redistribución metal líquido</span>
          <span>Pruebas de lag térmico</span>
          <span>Protección anticorrosión</span>
        </div>
        <div class="cpm-actions">
          <a class="cpm-primary" href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank">
            <i class="fa-brands fa-whatsapp"></i> Agendar mantenimiento preventivo
          </a>
          <a class="cpm-secondary" href="#seo-limpieza-consola">Conocer el servicio</a>
        </div>
      </div>

      <aside class="cpm-hero-panel">
        <div class="cpm-visual-img" aria-hidden="true">
          <img src="/assets/images/ps5_xbox.webp" alt="Mantenimiento preventivo de consolas Xbox y PlayStation en Cancún para evitar sobrecalentamiento" class="cpm-img-hero" />
          <div class="cpm-img-overlay"></div>
        </div>
        <div class="cpm-panel-info">
          <span>Servicio garantizado</span>
          <strong>{service.fromPrice || 'Desde $700 MXN'}</strong>
          <small>Incluye desarmado seguro, limpieza interna profunda de disipador y cambio de compuesto térmico.</small>
        </div>
        <ul class="cpm-features-list">
          <li><i class="fa-solid fa-circle-check"></i> Herramientas antiestáticas de precisión</li>
          <li><i class="fa-solid fa-circle-check"></i> Pasta térmica de alto rendimiento / Metal líquido</li>
          <li><i class="fa-solid fa-circle-check"></i> Reporte digital con fotos del antes y después</li>
          <li><i class="fa-solid fa-circle-check"></i> Soporte y asesoría profesional en Cancún</li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- SECCIÓN 1: LIMPIEZA Y SOBRECALENTAMIENTO -->
  <section class="cpm-section cpm-seo-keywords" id="seo-limpieza-consola">
    <div class="container">
      <div class="cpm-split-grid">
        <div class="cpm-split-text">
          <h2>Limpieza profunda de consolas en Cancún: ¿Por qué se traba mi consola?</h2>
          <p class="cpm-large-text">
            Si experimentas <strong>lag en la consola</strong> o notas que los juegos se congelan repentinamente, la causa principal suele ser la acumulación de suciedad.
            Las consolas de videojuegos funcionan como aspiradoras de aire que absorben polvo, pelusa y la humedad característica de Cancún. Esta mezcla obstruye los disipadores de cobre, impidiendo que el procesador se enfríe y provocando que se trabe la consola en momentos clave de tu partida.
          </p>
          <p>
            Realizar un <strong>mantenimiento preventivo de consola</strong> remueve todas las obstrucciones físicas del ventilador y componentes internos. Nuestros técnicos desarman por completo el equipo, limpian las aspas con solventes dieléctricos y aplican alcohol isopropílico para retirar residuos adheridos, previniendo cortocircuitos causados por el polvo húmedo.
          </p>
        </div>
        <div class="cpm-split-text">
          <h2>Evita el sobrecalentamiento: ¿Por qué se apaga mi consola sola?</h2>
          <p class="cpm-large-text">
            El <strong>sobrecalentamiento de consolas en Cancún</strong> es una de las fallas más críticas reportadas en nuestro taller.
            Cuando la pasta térmica se seca y el flujo de aire está bloqueado, la temperatura interna sube drásticamente. Para evitar quemarse, el procesador (APU) activa su protocolo de emergencia: es aquí cuando <strong>se apaga tu consola sola</strong> sin previo aviso o te muestra una pantalla negra.
          </p>
          <p>
            Ignorar estas alertas de temperatura alta puede provocar que el chip procesador se desuelde de la placa base (luz roja de la muerte o pantalla negra consola), requiriendo reparaciones costosas de reballing. El mantenimiento preventivo a tiempo evita que tu consola llegue a este punto de falla general, asegurando un juego silencioso y seguro.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 2: PS5 Y XBOX -->
  <section class="cpm-section cpm-seo-consolas">
    <div class="container">
      <div class="cpm-split-grid">
        <div class="cpm-split-card">
          <div class="card-image-wrapper" aria-hidden="true">
            <img src="/assets/images/mantenimiento-metal-liquido-cancun.webp" alt="Mantenimiento preventivo de PS5 y metal líquido en Cancún" class="card-inline-image" />
          </div>
          <div>
            <h2>Mantenimiento preventivo de PS5: Evita el sobrecalentamiento y la pantalla negra</h2>
            <p class="cpm-large-text">
              El <strong>mantenimiento preventivo de tu PS5</strong> es vital debido a que Sony utiliza metal líquido en lugar de pasta térmica convencional.
              Con el uso prolongado de la consola en posición vertical y las altas temperaturas de Cancún, el metal líquido puede desplazarse del centro del procesador. Esto crea "zonas secas" que causan un sobrecalentamiento localizado, provocando que <strong>se apague la consola sola</strong> a los pocos minutos de iniciar juegos demandantes de PlayStation 5.
            </p>
            <p>
              Nuestro servicio de limpieza y mantenimiento de PS5 en Cancún incluye la inspección detallada del APU, la redistribución profesional del metal líquido existente para asegurar una disipación uniforme, y la limpieza a fondo del ventilador de doble entrada para eliminar el polvo pegajoso que genera lag y ruido excesivo.
            </p>
          </div>
        </div>
        <div class="cpm-split-card">
          <div class="card-image-wrapper" aria-hidden="true">
            <img src="/assets/images/xbox.webp" alt="Limpieza interna de Xbox Series X para evitar lag térmico en Cancún" class="card-inline-image" />
          </div>
          <div>
            <h2>Limpieza profunda de Xbox: Adiós al ruido del ventilador y lag en consola</h2>
            <p class="cpm-large-text">
              La <strong>limpieza de tu Xbox Series X o Series S</strong> es fundamental para mantener su rendimiento silencioso y evitar el lag térmico.
              Su diseño vertical permite un gran flujo de aire, pero también facilita la entrada directa de polvo por las rejillas superiores. Cuando el radiador y la cámara de vapor se llenan de suciedad, el ventilador trabaja a revoluciones máximas para compensar el calor, produciendo ruidos molestos de turbina y apagados por seguridad.
            </p>
            <p>
              En Pixon PC removemos los blindajes metálicos del Xbox, soplamos y limpiamos a fondo la fuente de poder interna (que acumula polvo estático pesado) y reemplazamos la pasta térmica seca por una de alta conductividad térmica, eliminando el riesgo de que la consola se apague sola o sufra de lag extremo al jugar online.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 3: CONSOLAS PORTÁTILES Y NINTENDO SWITCH -->
  <section class="cpm-section cpm-seo-portables">
    <div class="container">
      <div class="cpm-head-center">
        <h2>Limpieza de consola portátil: Alto rendimiento y prevención de lag</h2>
        <p class="cpm-center-desc">
          Las consolas portátiles como la Steam Deck, ROG Ally y Nintendo Switch concentran componentes potentes en espacios muy reducidos. Por esta razón, la falta de mantenimiento preventivo provoca que el polvo bloquee las rejillas rápidamente, resultando en lag térmico severo y apagados repentinos.
        </p>
      </div>

      <div class="cpm-three-columns">
        <article class="cpm-col-card">
          <div class="card-num">01</div>
          <h3>Mantenimiento preventivo en portátiles gamer</h3>
          <p>
            Desarmamos el chasis ultracompacto de consolas portátiles, removemos el polvo de los minúsculos ventiladores turbina y reemplazamos la pasta térmica original por compuestos de alto rendimiento. Esto evita que se trabe tu consola portátil y previene que el calor degrade prematuramente la vida útil de la batería interna.
          </p>
        </article>

        <article class="cpm-col-card">
          <div class="card-num">02</div>
          <h3>Limpieza de Nintendo Switch para evitar sobrecalentamiento</h3>
          <p>
            El servicio de <strong>limpieza de tu Nintendo Switch</strong> (Estándar, OLED o Lite) ayuda a mantener el ventilador girando libre de obstrucciones. Cuando juegas en modo dock, el chip genera más calor y la pasta térmica original se seca rápidamente, provocando bajas de frames (lag consola) o que el sistema se congele a mitad de una partida.
          </p>
        </article>

        <article class="cpm-col-card">
          <div class="card-num">03</div>
          <h3>¿Tu Nintendo se calienta o se apaga sola en Cancún?</h3>
          <p>
            Si tu Nintendo Switch muestra el aviso de sobrecalentamiento o la pantalla se queda negra con apagado repentino, necesita servicio urgente. En Cancún, la combinación de calor y humedad bloquea el pequeño extractor. Limpiamos las aspas, destapamos el radiador de cobre y renovamos el compuesto térmico para resolverlo de raíz.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- SÍNTOMAS DE ALERTA -->
  <section class="cpm-section cpm-symptoms">
    <div class="container">
      <div class="cpm-head-center">
        <h2>Síntomas de que tu consola necesita mantenimiento preventivo urgente</h2>
        <p class="cpm-center-desc">
          No esperes a que tu consola sufra un daño irreversible en la placa base o te muestre pantalla negra permanente. Si identificas uno de los siguientes comportamientos en Cancún, es momento de agendar una limpieza interna completa.
        </p>
      </div>

      <div class="cpm-symptom-grid">
        {pmSymptoms.map((symptom) => (
          <article class="cpm-symptom-card">
            <i class={`fa-solid ${symptom.icon}`}></i>
            <h3>{symptom.title}</h3>
            <p>{symptom.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESO TÉCNICO -->
  <section class="cpm-section cpm-process">
    <div class="container">
      <div class="cpm-head-center">
        <h2>¿Cómo realizamos el mantenimiento preventivo de tu consola en Cancún?</h2>
        <p class="cpm-center-desc">
          En Pixon PC no hacemos limpiezas superficiales con aire comprimido desde el exterior, ya que esto solo empuja el polvo hacia adentro. Desarmamos cada sección con cuidado para dejar el sistema de refrigeración impecable.
        </p>
      </div>

      <div class="cpm-process-timeline">
        {processes.map((step) => (
          <div class="cpm-timeline-item">
            <span class="cpm-timeline-number">{step.num}</span>
            <div class="cpm-timeline-content">
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SEO LOCAL CANCÚN -->
  <section class="cpm-section cpm-cancun-climate">
    <div class="container cpm-cancun-layout">
      <div class="cpm-cancun-text">
        <h2>El factor Cancún: Por qué tu consola se calienta y se apaga sola aquí</h2>
        <p>
          El clima de Cancún es agresivo con los dispositivos electrónicos de alto rendimiento. La humedad relativa supera habitualmente el 80% y arrastra partículas de salitre marino. Al entrar aire en tu consola, el polvo y el salitre se combinan, creando una capa gruesa y pegajosa sobre los componentes.
        </p>
        <p>
          Si no se realiza un <strong>mantenimiento preventivo de consola</strong> regular cada 12 meses, esta acumulación húmeda acelera el sobrecalentamiento, provoca lag térmico severo y desgasta los componentes críticos. Atendemos consolas de todas las marcas en Cancún Centro, Zona Hotelera, Huayacán, Cumbres, Bonfil, Polígono Sur, Puerto Cancún, Av. Tulum, Bonampak, Puerto Juárez, Supermanzanas y Haciendas.
        </p>
        <address class="cpm-address">
          <strong>Pixon PC</strong><br />
          <span><i class="fa-solid fa-location-dot"></i> Cto. Hacienda Chimay, 77539 Cancún, Q.R.</span><br />
          <a href="tel:+529986690777"><i class="fa-solid fa-phone"></i> +52 998 669 0777</a> | 
          <a href="mailto:pixonpc@gmail.com"><i class="fa-solid fa-envelope"></i> pixonpc@gmail.com</a>
        </address>
      </div>
      <div class="cpm-cancun-badges-strip">
        <div class="climate-badge"><i class="fa-solid fa-water"></i> Humedad Salina</div>
        <div class="climate-badge"><i class="fa-solid fa-temperature-high"></i> Calor Costero</div>
        <div class="climate-badge"><i class="fa-solid fa-wind"></i> Polvo Pegajoso</div>
        <div class="climate-badge"><i class="fa-solid fa-box"></i> Poca Ventilación</div>
      </div>
    </div>
  </section>

  <!-- RELATED SERVICES (FONDO BLANCO Y TEXTO AZUL OSCURO #071F3A) -->
  <RelatedServicesSection
    category={category}
    service={service}
    title="Servicios relacionados para consolas"
    eyebrow="Más servicios técnicos"
    includeCategoryServices={true}
    initialLimit={8}
  />

  <!-- PREGUNTAS FRECUENTES -->
  <FaqSection
    id="faq"
    title="Preguntas frecuentes sobre mantenimiento preventivo de consolas en Cancún"
    description="Respuestas honestas sobre limpieza de PS5, Xbox, Nintendo Switch, cambio de pasta térmica, metal líquido y cómo evitar sobrecalentamientos o que se apague sola tu consola en Cancún."
    items={pmFaqs}
    ariaLabel="Preguntas frecuentes sobre mantenimiento preventivo de consolas en Cancún"
    viewMoreHref="/preguntas-frecuentes"
    viewMoreLabel="Ver más preguntas frecuentes"
    sectionClass="faq-section"
    gridClass="faq-grid"
    backgroundColor="#F8FAFC"
    questionColor="#071F3A"
    itemGap="10px"
    questionPadding="18px 20px"
  />

  <!-- COMENTARIOS Y CONTACTO -->
  <CommentsSection dark={false} viewMoreHref="/comentarios" viewMoreLabel="Ver todas las reseñas" id="comentarios" />
  <ContactSection id="ubicacion" />
</div>

<style is:global>
  .console-preventive-page {
    background: #f4f7fb;
    color: #071f3a;
    font-family: 'Inter', sans-serif;
  }

  /* El Hero conserva su fondo oscuro premium */
  .cpm-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(2.25rem, 4.5vw, 4.5rem) 0 clamp(1.75rem, 3.5vw, 3.5rem);
    background:
      radial-gradient(circle at 10% 20%, rgba(99, 102, 241, 0.15), transparent 30%),
      radial-gradient(circle at 90% 20%, rgba(139, 92, 246, 0.12), transparent 30%),
      linear-gradient(135deg, #070e1b 0%, #0b1120 50%, #0f192b 100%);
  }

  .cpm-hero-glow {
    position: absolute;
    bottom: -150px;
    right: -100px;
    width: 450px;
    height: 450px;
    border-radius: 999px;
    background: rgba(139, 92, 246, 0.15);
    filter: blur(40px);
    pointer-events: none;
  }

  .cpm-hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
    gap: 32px;
    align-items: center;
  }

  .cpm-kicker,
  .cpm-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #4f46e5;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cpm-hero .cpm-kicker {
    color: #818cf8;
  }

  .cpm-hero h1 {
    margin: 12px 0;
    color: #ffffff;
    font-family: 'Kanit', sans-serif;
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1.05;
  }

  .cpm-hero h2 {
    margin: 0 0 16px;
    color: #a7f3d0;
    font-family: 'Kanit', sans-serif;
    font-size: clamp(1.1rem, 2.2vw, 1.6rem);
    line-height: 1.25;
    font-weight: 400;
  }

  .cpm-hero p {
    margin: 0 0 20px;
    color: #cbd5e1;
    line-height: 1.65;
    font-weight: 400;
    font-size: 1.05rem;
  }

  .cpm-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0;
  }

  .cpm-badges span {
    color: #e0e7ff;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(129, 140, 248, 0.2);
    border-radius: 999px;
    padding: 6px 12px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .cpm-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }

  .cpm-primary,
  .cpm-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border-radius: 12px;
    padding: 14px 20px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .cpm-primary {
    color: #ffffff !important;
    background: #4f46e5;
    box-shadow: 0 10px 25px rgba(79, 70, 229, 0.3);
  }

  .cpm-primary:hover {
    background: #4338ca;
    transform: translateY(-2px);
  }

  .cpm-primary:active,
  .cpm-secondary:active {
    transform: scale(0.97);
  }

  .cpm-secondary {
    color: #c7d2fe !important;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.05);
  }

  .cpm-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .cpm-hero-panel {
    background: rgba(15, 23, 42, 0.85);
