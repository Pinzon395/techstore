---
import FaqSection from '../FaqSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';

const { service, category } = Astro.props;
const quoteMessage = encodeURIComponent(`Hola Pixon PC. Quiero cotizar mantenimiento preventivo para una consola en Cancún.

Consola / modelo:
Síntoma o motivo:
¿Hace ruido, se calienta o se apaga?:
Último mantenimiento:
Zona:`);
const symptomsMessage = encodeURIComponent(`Hola Pixon PC. Quiero explicar los síntomas de mi consola antes de solicitar mantenimiento.

Consola / modelo:
Síntoma:
¿Cuándo ocurre?:
¿Ya recibió mantenimiento?:`);
const platforms = [
  { icon: 'fa-playstation', title: 'Mantenimiento de PlayStation en Cancún', groups: [['PS5 Fat, Slim y Pro', 'Revisamos ventilación y el procedimiento térmico según la variante.'], ['PS4 y modelos anteriores según evaluación', 'Confirmamos modelo, estado y viabilidad antes de abrir.']] },
  { icon: 'fa-xbox', title: 'Mantenimiento de Xbox en Cancún', groups: [['Xbox Series X y Series S', 'Inspección de ventilación, disipación y condición interna.'], ['Xbox One y generaciones compatibles', 'La compatibilidad y alcance se confirman al recibir la consola.']] },
  { icon: 'fa-gamepad', title: 'Mantenimiento de Nintendo Switch en Cancún', groups: [['Nintendo Switch y Switch OLED', 'Revisamos ventilación, ruido y condición térmica.'], ['Nintendo Switch Lite y Switch 2', 'El procedimiento depende de la arquitectura y el síntoma.']] },
  { icon: 'fa-handheld', title: 'Mantenimiento de consolas portátiles gamer en Cancún', groups: [['Steam Deck', 'Revisión de ventilación y limpieza según condición.'], ['ASUS ROG Ally', 'Evaluación térmica y de flujo de aire por modelo.'], ['Lenovo Legion Go y similares', 'Confirmamos compatibilidad antes de intervenir.']] },
];
const symptoms = [
  ['Consola que se calienta demasiado', 'El calor fuera de lo habitual puede relacionarse con ventilación, polvo, ubicación, compuesto térmico o una falla distinta.'],
  ['Ventilador de consola muy ruidoso', 'El ruido puede venir de suciedad, una obstrucción, el ambiente o desgaste mecánico; primero se revisa.'],
  ['Consola que se apaga durante una partida', 'Puede requerir mantenimiento térmico, pero también diagnóstico de fuente, hardware o software según el comportamiento.'],
  ['Juegos que pierden rendimiento o se congelan', 'El calor puede coincidir con el síntoma, aunque red, almacenamiento, software y hardware también se consideran.'],
  ['Consola con rejillas llenas de polvo', 'Es una señal útil para agendar inspección; la limpieza interna tiene una página específica cuando ese es el alcance principal.'],
];
const included: [string, [string, string][]][] = [
  ['Diagnóstico y prueba inicial', [['Encendido, video y comportamiento', 'Confirmamos el estado inicial y los síntomas reportados.'], ['Ruido y ventilación', 'Revisamos ventilador y rutas de aire visibles.']]],
  ['Desarmado técnico de la consola', [['Control de tornillos, flex y blindajes', 'Organizamos piezas y desmontamos con la herramienta adecuada.'], ['Inspección visual antes de intervenir', 'Documentamos condiciones relevantes antes de cualquier trabajo adicional.']]],
  ['Limpieza interna de ventilador y disipador', [['Polvo y residuos internos', 'Retiramos acumulación según diseño y condición.'], ['Rejillas y conductos de ventilación', 'Revisamos entradas, salidas y zonas de flujo de aire.']]],
  ['Revisión del sistema térmico', [['Pasta térmica según modelo', 'Solo se considera cuando modelo, condición y diagnóstico lo justifican.'], ['Metal líquido únicamente en modelos que lo utilizan', 'En PS5 se inspecciona con procedimiento específico; no se trata como pasta convencional.'], ['Thermal pads o materiales térmicos cuando corresponda', 'Se revisan únicamente las zonas y materiales aplicables.']]],
  ['Reensamble y pruebas finales', [['Ventilación y ruido', 'Comprobamos ensamblaje, giro y comportamiento antes de entregar.'], ['Juego y estabilidad', 'Probamos funciones relevantes sin prometer resolver una falla ajena al mantenimiento.'], ['Resultado documentado', 'Explicamos hallazgos, alcance y recomendaciones por escrito.']]],
];
const zones = ['Cancún Centro', 'Zona Hotelera', 'Puerto Cancún', 'Puerto Juárez', 'Huayacán', 'Cumbres', 'Bonampak', 'Av. Tulum', 'Polígono Sur', 'Supermanzanas', 'Haciendas', 'Bonfil'];
const faqs = [
  { question: '¿Cuánto cuesta el mantenimiento de una consola en Cancún?', answer: 'El costo depende del modelo, condición interna, nivel de suciedad y de si requiere un material o reparación adicional. Te damos una cotización antes de realizar trabajos fuera del alcance preventivo.' },
  { question: '¿Cuándo debo hacer mantenimiento a mi consola?', answer: 'Conviene pedir una revisión si aumenta el ruido, hay polvo visible en rejillas, cambia el comportamiento térmico o no recuerdas el último servicio. La frecuencia depende del uso, ubicación y condición real.' },
  { question: '¿El mantenimiento incluye pasta térmica?', answer: 'No automáticamente. Revisamos modelo, condición y diseño térmico antes de recomendar pasta, pads u otro material. El alcance se confirma antes de intervenir.' },
  { question: '¿Revisan el metal líquido de PS5?', answer: 'En modelos PS5 que lo utilizan, la revisión se realiza con procedimiento específico cuando corresponde. No se asume que sea la causa de cualquier síntoma.' },
  { question: '¿Dan mantenimiento a Xbox Series X y Series S?', answer: 'Sí. Revisamos Xbox Series X, Series S y generaciones compatibles según modelo, condición y disponibilidad de atención.' },
  { question: '¿Atienden Nintendo Switch OLED y Switch 2?', answer: 'Atendemos Switch, Switch OLED, Lite y revisamos compatibilidad para Switch 2 antes de abrir o prometer un procedimiento.' },
  { question: '¿Atienden Steam Deck y ROG Ally?', answer: 'Podemos confirmar la atención de Steam Deck, ASUS ROG Ally y portátiles similares por modelo y síntoma antes de agendar.' },
  { question: '¿Qué pasa si mi consola se sigue apagando después de limpiarla?', answer: 'Un apagado puede tener otra causa. Te explicamos si conviene continuar con diagnóstico de temperatura, ventilador, fuente, placa, software u otra ruta de reparación.' },
  { question: '¿Atienden Zona Hotelera?', answer: 'Coordinamos recepción o recolección mediante cita previa según la zona, disponibilidad y reglas de acceso de la propiedad.' },
  { question: '¿Atienden Costa Mujeres y Playa Mujeres?', answer: 'Podemos confirmar atención coordinada para estas zonas antes de pedir una dirección exacta. La modalidad depende de disponibilidad, propiedad y traslado.' },
  { question: '¿Trabajan únicamente con cita previa?', answer: 'Sí. Confirmamos modelo, síntomas, modalidad y disponibilidad antes de agendar el mantenimiento.' },
];
---

<div class="console-maintenance-page">
  <!-- ==================== 1. HERO SECTION WITH CINEMATIC MOTION DESIGN ==================== -->
  <section class="cmp-hero" aria-labelledby="cmp-title">
    <div class="container cmp-hero__grid">
      <div class="cmp-hero__copy">
        <p class="cmp-kicker"><i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i> Servicio técnico de consolas · Cancún</p>
        <h1 id="cmp-title">Mantenimiento preventivo de consolas en Cancún</h1>
        <p class="cmp-hero__lead">Revisamos polvo, ventilación, temperatura y sistema térmico de PS5, Xbox, Nintendo Switch y consolas portátiles antes de realizar el mantenimiento adecuado para cada modelo.</p>
        <p class="cmp-hero__support">Limpieza interna, ventiladores, disipación y materiales térmicos según la arquitectura de tu consola.</p>
        <div class="cmp-actions">
          <a class="cmp-button cmp-button--primary" href={`https://wa.me/529986690777?text=${quoteMessage}`} target="_blank" rel="noopener noreferrer" data-wa-link>
            <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Cotizar mantenimiento
          </a>
          <a class="cmp-button cmp-button--secondary" href={`https://wa.me/529986690777?text=${symptomsMessage}`} target="_blank" rel="noopener noreferrer" data-wa-link>
            <i class="fa-solid fa-comment-dots" aria-hidden="true"></i> Explicar síntomas por WhatsApp
          </a>
        </div>
        <ul class="cmp-trust" aria-label="Características del servicio">
          <li>PS5 · Xbox · Nintendo</li>
          <li>Diagnóstico inicial</li>
          <li>Cita previa</li>
          <li>Garantía según intervención</li>
        </ul>
      </div>

      <!-- Right Visual Hero: Multi-Console High-End Exploded Maintenance Demonstration -->
      <div class="cmp-hero__visual-wrap" id="cmp-hero-container" data-active-console="ps5">
        
        <!-- Console Switcher Tabs (Accessible Micro-Selector) -->
        <div class="cmp-console-tabs" role="tablist" aria-label="Seleccionar consola">
          <button type="button" role="tab" class="cmp-tab-btn cmp-tab-btn--active" data-console="ps5" id="tab-ps5" aria-selected="true" aria-controls="panel-consoles">
            <i class="fa-brands fa-playstation" aria-hidden="true"></i> PS5
          </button>
          <button type="button" role="tab" class="cmp-tab-btn" data-console="xbox" id="tab-xbox" aria-selected="false" aria-controls="panel-consoles">
            <i class="fa-brands fa-xbox" aria-hidden="true"></i> Xbox Series X
          </button>
          <button type="button" role="tab" class="cmp-tab-btn" data-console="switch" id="tab-switch" aria-selected="false" aria-controls="panel-consoles">
            <i class="fa-solid fa-gamepad" aria-hidden="true"></i> Switch
          </button>
        </div>

        <figure class="cmp-visual" id="panel-consoles" aria-hidden="true">
          <svg viewBox="0 0 640 400" focusable="false" class="cmp-stage-svg">
            <defs>
              <!-- Background Canvas Gradients -->
              <linearGradient id="cmp-bench-bg" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#07223b" />
                <stop offset="50%" stop-color="#041627" />
                <stop offset="100%" stop-color="#020d18" />
              </linearGradient>

              <!-- PS5 Materials -->
              <linearGradient id="ps5-wing-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#f8fafc" />
                <stop offset="60%" stop-color="#e2e8f0" />
                <stop offset="100%" stop-color="#cbd5e1" />
              </linearGradient>
              <linearGradient id="ps5-core-grad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#091829" />
                <stop offset="50%" stop-color="#020810" />
                <stop offset="100%" stop-color="#06121f" />
              </linearGradient>

              <!-- Xbox Materials -->
              <linearGradient id="xbox-body-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#1b2e3d" />
                <stop offset="50%" stop-color="#101e29" />
                <stop offset="100%" stop-color="#09121a" />
              </linearGradient>
              <radialGradient id="xbox-green-glow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#10b981" stop-opacity="0.8" />
                <stop offset="60%" stop-color="#059669" stop-opacity="0.3" />
                <stop offset="100%" stop-color="#047857" stop-opacity="0" />
              </radialGradient>

              <!-- Switch Materials -->
              <linearGradient id="switch-screen-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#0b1e30" />
                <stop offset="100%" stop-color="#030b14" />
              </linearGradient>
              <linearGradient id="joycon-blue-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#38bdf8" />
                <stop offset="100%" stop-color="#0284c7" />
              </linearGradient>
              <linearGradient id="joycon-red-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#f87171" />
                <stop offset="100%" stop-color="#dc2626" />
              </linearGradient>

              <!-- Metallic & Copper Shaders -->
              <linearGradient id="copper-pipe-grad" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#f59e0b" />
                <stop offset="50%" stop-color="#d97706" />
                <stop offset="100%" stop-color="#b45309" />
              </linearGradient>
              <linearGradient id="heatsink-clean-grad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#94a3b8" />
                <stop offset="100%" stop-color="#475569" />
              </linearGradient>
              <linearGradient id="cmp-sheen-sweep" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0" />
                <stop offset="50%" stop-color="#ffffff" stop-opacity="0.45" />
                <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
              </linearGradient>

              <!-- Lighting & Shadows -->
              <filter id="c-shadow" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="12" stdDeviation="12" flood-color="#010811" flood-opacity="0.8" />
              </filter>
              <filter id="c-glow-cyan" x="-30%" y="-30%" width="160%" height="160%">
                <feDropShadow dx="0" dy="0" stdDeviation="7" flood-color="#38bdf8" flood-opacity="0.95" />
              </filter>
              <filter id="c-glow-emerald" x="-30%" y="-30%" width="160%" height="160%">
                <feDropShadow dx="0" dy="0" stdDeviation="7" flood-color="#10b981" flood-opacity="0.95" />
              </filter>
            </defs>

            <!-- Card Enclosure -->
            <rect x="10" y="10" width="620" height="380" rx="20" fill="url(#cmp-bench-bg)" stroke="#1a456b" stroke-width="1.5" stroke-opacity="0.65" />

            <!-- Grid Alignment Lines -->
            <g opacity="0.12">
              <line x1="10" y1="120" x2="630" y2="120" stroke="#38bdf8" stroke-width="0.8" stroke-dasharray="6 8" />
              <line x1="10" y1="260" x2="630" y2="260" stroke="#38bdf8" stroke-width="0.8" stroke-dasharray="6 8" />
              <circle cx="320" cy="200" r="160" stroke="#38bdf8" stroke-width="0.6" stroke-dasharray="4 8" fill="none" />
            </g>

            <!-- Workbench Base Platform -->
            <ellipse cx="320" cy="326" rx="250" ry="22" fill="#01070e" opacity="0.8" />

            <!-- ==================== CONSOLE 1: PLAYSTATION 5 STAGE ==================== -->
            <g class="console-stage console-stage--ps5" id="stage-ps5" transform="translate(320, 200)">
              <!-- Outer Shadow -->
              <ellipse class="c-base-shadow" cx="0" cy="115" rx="140" ry="16" fill="#01070e" opacity="0.6" />

              <!-- Layer 1: Motherboard & Shielding Core -->
              <g class="ps5-layer-pcb">
                <path d="M -30 -115 L 30 -115 L 26 110 L -26 110 Z" fill="#0b243a" stroke="#1d5583" stroke-width="1.2" />
                <!-- Thermal Interface Core (Liquid Metal Seal) -->
                <rect class="ps5-apu-die" x="-16" y="-12" width="32" height="32" rx="3" fill="#082b47" stroke="#f59e0b" stroke-width="1.5" />
                <rect x="-10" y="-6" width="20" height="20" rx="2" fill="#031626" stroke="#38bdf8" stroke-width="1" />
              </g>

              <!-- Layer 2: Heavy Aluminum/Copper Heatsink Block -->
              <g class="ps5-layer-heatsink">
                <rect class="ps5-heatsink-fins" x="-46" y="-65" width="92" height="135" rx="5" fill="#0d2e4a" stroke="#f59e0b" stroke-width="1.2" />
                <!-- Copper Heatpipes across Block -->
                <g class="ps5-heatpipes">
                  <path d="M -38 -45 C -15 -52 15 -52 38 -45" fill="none" stroke="url(#copper-pipe-grad)" stroke-width="5" stroke-linecap="round" />
                  <path d="M -38 0 C -15 -6 15 -6 38 0" fill="none" stroke="url(#copper-pipe-grad)" stroke-width="5" stroke-linecap="round" />
                  <path d="M -38 45 C -15 38 15 38 38 45" fill="none" stroke="url(#copper-pipe-grad)" stroke-width="5" stroke-linecap="round" />
                </g>
              </g>

              <!-- Layer 3: Large 120mm Vortex Turbine Fan -->
              <g class="ps5-layer-fan" transform="translate(0, -25)">
                <circle cx="0" cy="0" r="50" fill="#041220" stroke="#1c4e77" stroke-width="1.8" />
                <circle cx="0" cy="0" r="44" fill="none" stroke="#0e2f4c" stroke-width="1" />
                <!-- 11 Curved Aerodynamic Fan Blades -->
                <g class="c-fan-rotor ps5-fan-rotor">
                  <line x1="0" y1="-42" x2="0" y2="42" stroke="#38bdf8" stroke-width="3" stroke-linecap="round" />
                  <line x1="-42" y1="0" x2="42" y2="0" stroke="#38bdf8" stroke-width="3" stroke-linecap="round" />
                  <line x1="-30" y1="-30" x2="30" y2="30" stroke="#38bdf8" stroke-width="3" stroke-linecap="round" />
                  <line x1="-30" y1="30" x2="30" y2="-30" stroke="#38bdf8" stroke-width="3" stroke-linecap="round" />
                  <line x1="-14" y1="-40" x2="14" y2="40" stroke="#38bdf8" stroke-width="2.2" stroke-linecap="round" />
                </g>
                <circle cx="0" cy="0" r="14" fill="#0c3252" stroke="#38bdf8" stroke-width="1.5" />
                <circle cx="0" cy="0" r="5" fill="#22d3ee" />
              </g>

              <!-- Layer 4: Outer White Curved Wing Panels (Left & Right) -->
              <g class="ps5-layer-wings">
                <!-- Left Wing Panel -->
                <path class="ps5-wing-left" d="M -24 -125 C -75 -70 -75 70 -24 125 C -50 115 -62 45 -48 -115 Z" fill="url(#ps5-wing-grad)" stroke="#94a3b8" stroke-width="1.2" />
                <!-- Center Dark Gloss Core Body -->
                <path class="ps5-center-core" d="M -24 -120 L 24 -120 L 20 120 L -20 120 Z" fill="url(#ps5-core-grad)" stroke="#22d3ee" stroke-width="1" />
                <!-- LED Power Glow Slit -->
                <line x1="-16" y1="-110" x2="-16" y2="105" stroke="#38bdf8" stroke-width="2" filter="url(#c-glow-cyan)" />
                <!-- Right Wing Panel -->
                <path class="ps5-wing-right" d="M 24 -125 C 75 -70 75 70 24 125 C 50 115 62 45 48 -115 Z" fill="url(#ps5-wing-grad)" stroke="#94a3b8" stroke-width="1.2" />
              </g>

              <!-- Dust Particles (PS5) -->
              <g class="c-dust-group ps5-dust" fill="#f59e0b">
                <circle class="c-dust c-dust--1" cx="-25" cy="-55" r="2.8" />
                <circle class="c-dust c-dust--2" cx="18" cy="-40" r="2.5" />
                <circle class="c-dust c-dust--3" cx="-5" cy="-10" r="3" />
                <circle class="c-dust c-dust--4" cx="30" cy="-15" r="2.2" />
                <circle class="c-dust c-dust--5" cx="-32" cy="15" r="2.6" />
                <circle class="c-dust c-dust--6" cx="12" cy="45" r="2.8" />
                <circle class="c-dust c-dust--7" cx="-18" cy="70" r="2.4" />
                <circle class="c-dust c-dust--8" cx="22" cy="80" r="2.2" />
              </g>

              <!-- Clean Airflow Paths (PS5) -->
              <g class="c-airflow-paths ps5-airflow">
                <path class="c-air-stream c-air-stream--1" d="M -60 -70 C -30 -30 -30 30 -60 70" fill="none" stroke="#38bdf8" stroke-width="3" stroke-linecap="round" />
                <path class="c-air-stream c-air-stream--2" d="M 0 -130 C -15 -60 -15 60 0 130" fill="none" stroke="#22d3ee" stroke-width="3.5" stroke-linecap="round" />
                <path class="c-air-stream c-air-stream--3" d="M 60 -70 C 30 -30 30 30 60 70" fill="none" stroke="#38bdf8" stroke-width="3" stroke-linecap="round" />
              </g>
            </g>

            <!-- ==================== CONSOLE 2: XBOX SERIES X STAGE ==================== -->
            <g class="console-stage console-stage--xbox" id="stage-xbox" transform="translate(320, 200)">
              <!-- Outer Shadow -->
              <ellipse class="c-base-shadow" cx="0" cy="115" rx="130" ry="16" fill="#01070e" opacity="0.6" />

              <!-- Layer 1: Split PCB Board & Vapor Chamber Plate -->
              <g class="xbox-layer-pcb">
                <path d="M -50 -75 L 50 -75 L 45 95 L -45 95 Z" fill="#0a263c" stroke="#1d5583" stroke-width="1.2" />
                <!-- APU Core Thermal Zone -->
                <rect class="xbox-apu-die" x="-20" y="-10" width="40" height="40" rx="3" fill="#0c375b" stroke="#f59e0b" stroke-width="1.5" />
                <rect x="-12" y="-2" width="24" height="24" rx="2" fill="#041829" stroke="#10b981" stroke-width="1" />
              </g>

              <!-- Layer 2: Vapor Chamber & Parallel Heatsink Fins -->
              <g class="xbox-layer-heatsink">
                <rect class="xbox-heatsink-fins" x="-58" y="-70" width="116" height="150" rx="4" fill="#0f3454" stroke="#f59e0b" stroke-width="1.2" />
                <!-- Heatsink Fin Strips -->
                <line x1="-40" y1="-65" x2="-40" y2="75" stroke="#38bdf8" stroke-width="1.5" stroke-opacity="0.6" />
                <line x1="-20" y1="-65" x2="-20" y2="75" stroke="#38bdf8" stroke-width="1.5" stroke-opacity="0.6" />
                <line x1="0" y1="-65" x2="0" y2="75" stroke="#38bdf8" stroke-width="1.5" stroke-opacity="0.6" />
                <line x1="20" y1="-65" x2="20" y2="75" stroke="#38bdf8" stroke-width="1.5" stroke-opacity="0.6" />
                <line x1="40" y1="-65" x2="40" y2="75" stroke="#38bdf8" stroke-width="1.5" stroke-opacity="0.6" />
              </g>

              <!-- Layer 3: Top 130mm Exhaust Axial Fan -->
              <g class="xbox-layer-fan" transform="translate(0, -95)">
                <ellipse cx="0" cy="0" rx="56" ry="18" fill="#041220" stroke="#10b981" stroke-width="1.8" />
                <g class="c-fan-rotor xbox-fan-rotor">
                  <line x1="-44" y1="0" x2="44" y2="0" stroke="#10b981" stroke-width="3" stroke-linecap="round" />
                  <line x1="-30" y1="-8" x2="30" y2="8" stroke="#10b981" stroke-width="3" stroke-linecap="round" />
                  <line x1="-30" y1="8" x2="30" y2="-8" stroke="#10b981" stroke-width="3" stroke-linecap="round" />
                </g>
                <circle cx="0" cy="0" r="10" fill="#093123" stroke="#10b981" stroke-width="1.5" />
              </g>

              <!-- Layer 4: Monolithic Dark Chasis with Top Concave Grille -->
              <g class="xbox-layer-chassis">
                <!-- Front & Side Perspective Chasis -->
                <path d="M -65 -90 L 35 -90 L 65 -70 L 65 105 L -35 105 L -65 85 Z" fill="url(#xbox-body-grad)" stroke="#10b981" stroke-width="1.5" />
                <!-- Disc Drive Slot -->
                <rect x="-55" y="0" width="3" height="48" rx="1" fill="#020810" stroke="#38bdf8" stroke-width="0.8" />
                <!-- Power Logo Icon Button -->
                <circle cx="-52" cy="-65" r="5" fill="#ffffff" filter="url(#c-glow-emerald)" />
                <!-- Top Concave Exhaust Mesh Array -->
                <ellipse cx="0" cy="-90" rx="55" ry="16" fill="#04121a" stroke="#10b981" stroke-width="1.5" />
                <ellipse cx="0" cy="-90" rx="42" ry="11" fill="url(#xbox-green-glow)" />
              </g>

              <!-- Dust Particles (Xbox: Upward Direction) -->
              <g class="c-dust-group xbox-dust" fill="#f59e0b">
                <circle class="c-dust c-dust--1" cx="-30" cy="-75" r="2.8" />
                <circle class="c-dust c-dust--2" cx="15" cy="-80" r="2.5" />
                <circle class="c-dust c-dust--3" cx="-10" cy="-40" r="3" />
                <circle class="c-dust c-dust--4" cx="35" cy="-30" r="2.4" />
                <circle class="c-dust c-dust--5" cx="-25" cy="15" r="2.6" />
                <circle class="c-dust c-dust--6" cx="20" cy="45" r="2.8" />
