<script is:inline>
  (() => {
    const container = document.getElementById('cmp-hero-container');
    if (!container) return;

    const tabs = Array.from(container.querySelectorAll('.cmp-tab-btn'));
    const consoles = ['ps5', 'xbox', 'switch'];
    let currentIndex = 0;
    let autoTimer = null;

    function activateConsole(consoleKey, userTriggered = false) {
      container.setAttribute('data-active-console', consoleKey);
      tabs.forEach((tab) => {
        const isMatch = tab.getAttribute('data-console') === consoleKey;
        tab.classList.toggle('cmp-tab-btn--active', isMatch);
        tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });

      if (userTriggered) {
        clearInterval(autoTimer);
        startAutoTimer();
      }
    }

    function nextConsole() {
      currentIndex = (currentIndex + 1) % consoles.length;
      activateConsole(consoles[currentIndex]);
    }

    function startAutoTimer() {
      autoTimer = setInterval(nextConsole, 12500);
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        currentIndex = index;
        activateConsole(tab.getAttribute('data-console'), true);
      });
    });

    startAutoTimer();
  })();
</script>

