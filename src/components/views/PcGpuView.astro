---
import FaqSection from '../FaqSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import Footer from '../Footer.astro';

const waMessage = encodeURIComponent(
  'Hola Pixon PC. Quiero cotizar la reparación/diagnóstico de mi tarjeta gráfica GPU en Cancún.\nMarca y modelo:\nSíntoma:'
);
const whatsappUrl = `https://wa.me/529986690777?text=${waMessage}`;

const zones = [
  'Cancún Centro',
  'Zona Hotelera',
  'Puerto Cancún',
  'Huayacán',
  'Cumbres',
  'Bonampak',
  'Av. Tulum',
  'Puerto Juárez',
  'Polígono Sur',
  'Supermanzanas',
  'Haciendas',
  'Bonfil',
  'Costa Mujeres',
  'Playa Mujeres',
  'Punta Sam',
];

const gpuFaqs = [
  {
    question: '¿Cuánto cuesta revisar una tarjeta gráfica en Cancún?',
    answer: 'El diagnóstico técnico de tarjeta de video inicia desde $600 MXN (pago por adelantado para agendar tu cita previa). Incluye pruebas bajo carga, medición de voltajes, temperaturas de núcleo y hotspot, estabilidad de VRAM e inspección visual. El mantenimiento preventivo o reparación se cotiza de forma clara por escrito según modelo y componentes.'
  },
  {
    question: '¿Cómo saber si mi GPU está dañada?',
    answer: 'Los síntomas más comunes son artefactos visuales (líneas, cuadros de colores), pantalla negra al abrir juegos, reinicios repentinos, ventiladores girando al 100% con ruido excesivo, errores de drivers NVIDIA/AMD o que la PC encienda pero no dé señal de video.'
  },
  {
    question: '¿Por qué mi PC enciende pero no da imagen?',
    answer: 'No siempre es la tarjeta gráfica. La falta de señal puede deberse a la fuente de poder, un módulo de memoria RAM inestable, la ranura PCIe, el cable HDMI/DisplayPort o la BIOS de la placa madre. En nuestro taller aislamos cada componente para confirmar el origen real.'
  },
  {
    question: '¿La fuente puede provocar fallas que parecen de GPU?',
    answer: 'Sí. Una fuente de poder fatigada o con riel de 12V inestable puede apagarse bajo carga, provocar pantallas negras en juegos o reinicios que aparentan ser fallas de la tarjeta gráfica. Por ello siempre probamos la entrega de energía antes de intervenir la GPU.'
  },
  {
    question: '¿Reparan tarjetas NVIDIA RTX y GTX?',
    answer: 'Sí. Diagnosticamos y damos servicio a tarjetas gráficas NVIDIA GeForce RTX series 50, 40, 30 y 20, así como modelos GTX, atendiendo problemas de temperatura, ventiladores, pasta térmica, thermal pads, alimentación y estabilidad gráfica.'
  },
  {
    question: '¿Reparan tarjetas AMD Radeon?',
    answer: 'Sí. Atendemos tarjetas AMD Radeon RX (series 7000, 6000, 5000 y anteriores), diagnosticando crashes, tiempos de espera del controlador, temperaturas de unión (junction temp) y mantenimiento térmico integral.'
  },
  {
    question: '¿Cambian pasta térmica y thermal pads de GPU?',
    answer: 'Sí, cuando el diagnóstico lo justifica. La selección de thermal pads considera el modelo, diseño, especificación disponible, patrón de contacto y presión del disipador; no se usan espesores genéricos.'
  },
  {
    question: '¿Por qué mi GPU se calienta demasiado?',
    answer: 'Puede deberse a acumulación de polvo en el disipador, pasta térmica original seca o cristalizada, thermal pads degradados, ventiladores con rodamientos desgastados o flujo de aire deficiente dentro del gabinete de la PC.'
  },
  {
    question: '¿Por qué aparecen artefactos en pantalla?',
    answer: 'Los artefactos (glitches, líneas o puntos de colores) suelen indicar inestabilidad en los chips de memoria VRAM, sobrecalentamiento extremo, soldaduras de BGA fatigadas o fallas en el controlador gráfico bajo estrés.'
  },
  {
    question: '¿Una GPU con VRAM dañada se puede reparar?',
    answer: 'Depende del modelo y la disponibilidad de componentes. Tras el diagnóstico técnico evaluamos si la intervención es económicamente viable o si resulta más conveniente reemplazar la tarjeta gráfica.'
  },
  {
    question: '¿Atienden en Zona Hotelera de Cancún?',
    answer: 'Sí. Atendemos a residentes, creadores de contenido, gamers y huéspedes en la Zona Hotelera de Cancún mediante cita previa en taller o coordinando recolección del equipo según disponibilidad.'
  },
  {
    question: '¿Trabajan mediante cita previa?',
    answer: 'Sí. Todos nuestros servicios y recepciones se gestionan mediante cita previa para dedicar el tiempo y las pruebas necesarias a cada equipo sin demoras.'
  }
];

const relatedServices = [
  { href: '/servicios/pc/fuente-poder', title: 'Fuente de poder PC', text: 'Revisión de voltajes, watts disponibles, conectores PCIe y estabilidad bajo carga.' },
  { href: '/servicios/pc/diagnostico', title: 'Diagnóstico profesional de PC', text: 'Pruebas por componente para ubicar si la falla es GPU, RAM, fuente, placa o Windows.' },
  { href: '/servicios/pc/instalacion-componentes', title: 'Instalación de componentes', text: 'Montaje de tarjetas de video, SSD, RAM, fuentes y refrigeración en Cancún.' },
  { href: '/mantenimiento-preventivo-computadora', title: 'Mantenimiento preventivo PC', text: 'Limpieza interna de gabinete, ventiladores, filtros y flujo de aire.' },
  { href: '/servicios/pc/refrigeracion', title: 'Refrigeración y temperatura', text: 'Optimización de airflow, disipadores por aire y sistemas AIO de PC.' },
  { href: '/servicios/pc/upgrade', title: 'Upgrade SSD y RAM', text: 'Actualización de almacenamiento y memoria para balancear el rendimiento gamer.' },
];
---

<div class="gpu-page">
  <!-- ==================== 1. HERO SECTION WITH 3-FAN GPU MOTION DESIGN ==================== -->
  <header class="gpu-hero" aria-labelledby="gpu-hero-title">
    <div class="gpu-hero-grid" aria-hidden="true"></div>
    <div class="container gpu-hero-inner">
      <div class="gpu-hero-copy">
        <p class="gpu-kicker">
          <i class="fa-solid fa-microchip" aria-hidden="true"></i> SERVICIO TÉCNICO DE GPU · PC GAMER · CANCÚN
        </p>
        <h1 id="gpu-hero-title">Reparación de Tarjeta Gráfica GPU en Cancún</h1>
        <p class="gpu-lead">
          Diagnosticamos tarjetas NVIDIA y AMD con artefactos, pantalla negra, crashes, temperatura alta o pérdida de rendimiento. Primero aislamos si la falla viene de GPU, fuente, drivers o sistema térmico.
        </p>

        <div class="gpu-hero-actions">
          <a class="gpu-btn gpu-btn-primary" href="#ticket-gpu">
            <i class="fa-solid fa-clipboard-check" aria-hidden="true"></i> Diagnosticar mi GPU
          </a>
          <a class="gpu-btn gpu-btn-secondary" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-wa-link>
            <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Cotizar por WhatsApp
          </a>
        </div>

        <ul class="gpu-badges" aria-label="Garantías del servicio técnico de GPU">
          <li><i class="fa-solid fa-check" aria-hidden="true"></i> NVIDIA y AMD</li>
          <li><i class="fa-solid fa-check" aria-hidden="true"></i> Prueba bajo carga</li>
          <li><i class="fa-solid fa-check" aria-hidden="true"></i> Cita previa</li>
          <li><i class="fa-solid fa-check" aria-hidden="true"></i> Garantía según intervención</li>
        </ul>
      </div>

      <!-- Right Visual Container: 3-Fan High-End GPU Motion Design -->
      <div class="gpu-hero__visual-container">
        <figure class="gpu-visual-stage" aria-hidden="true">
          <svg viewBox="0 0 680 400" focusable="false" class="gpu-story-svg">
            <defs>
              <linearGradient id="gpu-shroud-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#182d44" />
                <stop offset="50%" stop-color="#0e1f32" />
                <stop offset="100%" stop-color="#081422" />
              </linearGradient>
              <linearGradient id="gpu-pcb-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#0b2c4d" />
                <stop offset="100%" stop-color="#06182a" />
              </linearGradient>
              <linearGradient id="gpu-copper-pipe" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#f59e0b" />
                <stop offset="50%" stop-color="#d97706" />
                <stop offset="100%" stop-color="#b45309" />
              </linearGradient>
              <linearGradient id="gpu-metal-shine" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0" />
                <stop offset="50%" stop-color="#ffffff" stop-opacity="0.45" />
                <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
              </linearGradient>

              <filter id="gpu-shadow" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="12" stdDeviation="12" flood-color="#020b14" flood-opacity="0.75" />
              </filter>
              <filter id="gpu-glow-cyan" x="-30%" y="-30%" width="160%" height="160%">
                <feDropShadow dx="0" dy="0" stdDeviation="8" flood-color="#38bdf8" flood-opacity="0.9" />
              </filter>
              <filter id="gpu-glow-amber" x="-30%" y="-30%" width="160%" height="160%">
                <feDropShadow dx="0" dy="0" stdDeviation="10" flood-color="#f59e0b" flood-opacity="0.85" />
              </filter>
              <filter id="gpu-glow-green" x="-30%" y="-30%" width="160%" height="160%">
                <feDropShadow dx="0" dy="0" stdDeviation="8" flood-color="#10b981" flood-opacity="0.95" />
              </filter>
            </defs>

            <!-- Card Background Frame -->
            <rect class="gpu-canvas" x="10" y="10" width="660" height="380" rx="20" fill="#06192d" stroke="#1d4d77" stroke-width="1.5" stroke-opacity="0.7" />

            <!-- Technical Workbench Backdrop Grid -->
            <g class="gpu-grid-decor" opacity="0.15">
              <line x1="10" y1="100" x2="670" y2="100" stroke="#38bdf8" stroke-width="0.75" stroke-dasharray="6 8" />
              <line x1="10" y1="200" x2="670" y2="200" stroke="#38bdf8" stroke-width="0.75" stroke-dasharray="6 8" />
              <line x1="10" y1="300" x2="670" y2="300" stroke="#38bdf8" stroke-width="1" />
              <circle cx="340" cy="200" r="180" stroke="#38bdf8" stroke-width="0.5" stroke-dasharray="4 8" fill="none" />
            </g>

            <!-- Background Monitor Glitch Silhouette (Disappears after diagnosis) -->
            <g class="gpu-glitch-monitor" transform="translate(340, 100)" opacity="0.25">
              <rect x="-140" y="-70" width="280" height="140" rx="10" fill="#041220" stroke="#f59e0b" stroke-width="1" />
              <path class="gpu-glitch-line gpu-glitch-line--1" d="M -120 -20 L -40 -20 L -20 -40 L 40 -10 L 120 -10" fill="none" stroke="#f59e0b" stroke-width="2" />
              <path class="gpu-glitch-line gpu-glitch-line--2" d="M -100 15 L -20 15 L 0 -5 L 60 25 L 100 25" fill="none" stroke="#ef4444" stroke-width="2" />
            </g>

            <!-- Main High-End GPU Assembly (Perspective 3/4) -->
            <g class="gpu-assembly" transform="translate(340, 205)" filter="url(#gpu-shadow)">
              
              <!-- Thermal Halo Glow (15% - 27%) -->
              <ellipse class="gpu-thermal-halo" cx="0" cy="0" rx="270" ry="110" fill="url(#gpu-copper-pipe)" opacity="0" filter="url(#gpu-glow-amber)" />

              <!-- Base Shadow -->
              <ellipse cx="0" cy="115" rx="280" ry="26" fill="#01070e" opacity="0.8" />

              <!-- Layer 1: PCB Backplate & Board Assembly -->
              <g class="gpu-layer-pcb">
                <!-- Main Heavy PCB -->
                <path d="M -260 -75 L 260 -75 L 250 85 L -250 85 Z" fill="url(#gpu-pcb-grad)" stroke="#1e5a8d" stroke-width="1.5" />
                <!-- Gold PCIe 16x Interface Fingers -->
                <path d="M -160 85 L 60 85 L 55 102 L -155 102 Z" fill="#d97706" stroke="#fbbf24" stroke-width="1" />
                <!-- PCIe Retention Notch -->
                <rect x="-60" y="85" width="8" height="17" fill="#06182a" />
                <!-- Metal Rear I/O Bracket -->
                <path d="M -260 -95 L -245 -95 L -235 95 L -250 95 Z" fill="#64748b" stroke="#94a3b8" stroke-width="1.2" />
                <circle cx="-252" cy="-40" r="4" fill="#030b14" />
                <circle cx="-250" cy="20" r="4" fill="#030b14" />
                <!-- 8-Pin / 12VHPWR Power Sockets -->
                <rect x="200" y="-85" width="45" height="14" rx="2" fill="#030b14" stroke="#38bdf8" stroke-width="1.2" />
              </g>

              <!-- Layer 2: Core Components on PCB (Visible during Exploded View 44% - 78%) -->
              <g class="gpu-layer-components">
                <!-- Central GPU Core Silicon Die -->
                <rect class="gpu-die-core" x="-32" y="-18" width="64" height="42" rx="4" fill="#0c3c66" stroke="#f59e0b" stroke-width="2" />
                <rect x="-24" y="-12" width="48" height="30" rx="2" fill="#072037" stroke="#22d3ee" stroke-width="1" />

                <!-- Surrounding VRAM Chips (8 Memory Modules) -->
                <g class="gpu-vram-chips" fill="#08233d" stroke="#f59e0b" stroke-width="1.2">
                  <rect x="-80" y="-22" width="26" height="18" rx="2" />
                  <rect x="-80" y="4" width="26" height="18" rx="2" />
                  <rect x="54" y="-22" width="26" height="18" rx="2" />
                  <rect x="54" y="4" width="26" height="18" rx="2" />
                  <rect x="-36" y="-56" width="30" height="18" rx="2" />
                  <rect x="6" y="-56" width="30" height="18" rx="2" />
                  <rect x="-36" y="38" width="30" height="18" rx="2" />
                  <rect x="6" y="38" width="30" height="18" rx="2" />
                </g>

                <!-- VRM Power Delivery Stages (MOSFETs & Inductor Chokes) -->
                <g class="gpu-vrm-stages" fill="#0a2a47" stroke="#f59e0b" stroke-width="1.2">
                  <rect x="110" y="-45" width="16" height="14" rx="2" />
                  <rect x="110" y="-25" width="16" height="14" rx="2" />
                  <rect x="110" y="-5" width="16" height="14" rx="2" />
                  <rect x="110" y="15" width="16" height="14" rx="2" />
                  <rect x="110" y="35" width="16" height="14" rx="2" />
                  <!-- Choke row -->
                  <rect x="135" y="-45" width="18" height="14" rx="2" fill="#031424" stroke="#38bdf8" />
                  <rect x="135" y="-25" width="18" height="14" rx="2" fill="#031424" stroke="#38bdf8" />
                  <rect x="135" y="-5" width="18" height="14" rx="2" fill="#031424" stroke="#38bdf8" />
                  <rect x="135" y="15" width="18" height="14" rx="2" fill="#031424" stroke="#38bdf8" />
                  <rect x="135" y="35" width="18" height="14" rx="2" fill="#031424" stroke="#38bdf8" />
                </g>
              </g>

              <!-- Layer 3: Heatsink & Copper Heatpipes Assembly -->
              <g class="gpu-layer-heatsink">
                <!-- Dense Aluminum/Copper Fin Array Base -->
                <rect class="gpu-heatsink-fins" x="-240" y="-65" width="480" height="135" rx="6" fill="#0a243d" stroke="#f59e0b" stroke-width="1.2" />
                <!-- 4 Heavy Heatpipes Transiting Cooler -->
                <g class="gpu-heatpipes">
                  <path d="M -220 -40 C -120 -50 120 -50 220 -40" fill="none" stroke="url(#gpu-copper-pipe)" stroke-width="7" stroke-linecap="round" />
                  <path d="M -210 -15 C -100 -25 100 -25 210 -15" fill="none" stroke="url(#gpu-copper-pipe)" stroke-width="6.5" stroke-linecap="round" />
                  <path d="M -210 15 C -100 25 100 25 210 15" fill="none" stroke="url(#gpu-copper-pipe)" stroke-width="6.5" stroke-linecap="round" />
                  <path d="M -220 40 C -120 50 120 50 220 40" fill="none" stroke="url(#gpu-copper-pipe)" stroke-width="7" stroke-linecap="round" />
                </g>
              </g>

              <!-- Layer 4: Outer Shroud with 3 TRIPLE COOLING FANS -->
              <g class="gpu-layer-shroud">
                <!-- Geometric Angular Shroud Structure -->
                <path d="M -255 -75 L 255 -75 L 240 75 L -240 75 Z" fill="url(#gpu-shroud-grad)" stroke="#22d3ee" stroke-width="1.8" />
                
                <!-- Shroud Accent Wings and Geometric Chamfers -->
                <polygon points="-255,-75 -220,-75 -210,-55 -245,-55" fill="#0b3254" stroke="#38bdf8" stroke-width="1" />
                <polygon points="255,-75 220,-75 210,-55 245,-55" fill="#0b3254" stroke="#38bdf8" stroke-width="1" />
                <polygon points="-240,75 -205,75 -195,55 -230,55" fill="#0b3254" stroke="#38bdf8" stroke-width="1" />
                <polygon points="240,75 205,75 195,55 230,55" fill="#0b3254" stroke="#38bdf8" stroke-width="1" />

                <!-- FAN 1: LEFT COOLING FAN (x: -160, y: 0, r: 62) -->
                <g class="gpu-fan-unit gpu-fan-unit--1" transform="translate(-160, 0)">
                  <circle cx="0" cy="0" r="62" fill="#041220" stroke="#1d5583" stroke-width="2" />
                  <circle cx="0" cy="0" r="56" fill="none" stroke="#0e2e4a" stroke-width="1" />
                  <!-- 9 Aerodynamic Fan Blades -->
                  <g class="gpu-fan-rotor gpu-fan-rotor--1">
                    <line x1="0" y1="-54" x2="0" y2="54" stroke="#38bdf8" stroke-width="3.2" stroke-linecap="round" />
                    <line x1="-54" y1="0" x2="54" y2="0" stroke="#38bdf8" stroke-width="3.2" stroke-linecap="round" />
                    <line x1="-38" y1="-38" x2="38" y2="38" stroke="#38bdf8" stroke-width="3.2" stroke-linecap="round" />
                    <line x1="-38" y1="38" x2="38" y2="-38" stroke="#38bdf8" stroke-width="3.2" stroke-linecap="round" />
                    <line x1="-18" y1="-50" x2="18" y2="50" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" />
                  </g>
                  <circle cx="0" cy="0" r="16" fill="#0c3558" stroke="#38bdf8" stroke-width="1.8" />
                  <circle cx="0" cy="0" r="6" fill="#22d3ee" />
                </g>

                <!-- FAN 2: CENTER COOLING FAN (x: 0, y: 0, r: 62) -->
                <g class="gpu-fan-unit gpu-fan-unit--2" transform="translate(0, 0)">
                  <circle cx="0" cy="0" r="62" fill="#041220" stroke="#1d5583" stroke-width="2" />
                  <circle cx="0" cy="0" r="56" fill="none" stroke="#0e2e4a" stroke-width="1" />
                  <!-- 9 Aerodynamic Fan Blades -->
                  <g class="gpu-fan-rotor gpu-fan-rotor--2">
                    <line x1="0" y1="-54" x2="0" y2="54" stroke="#38bdf8" stroke-width="3.2" stroke-linecap="round" />
                    <line x1="-54" y1="0" x2="54" y2="0" stroke="#38bdf8" stroke-width="3.2" stroke-linecap="round" />
                    <line x1="-38" y1="-38" x2="38" y2="38" stroke="#38bdf8" stroke-width="3.2" stroke-linecap="round" />
                    <line x1="-38" y1="38" x2="38" y2="-38" stroke="#38bdf8" stroke-width="3.2" stroke-linecap="round" />
                    <line x1="-18" y1="-50" x2="18" y2="50" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" />
                  </g>
                  <circle cx="0" cy="0" r="16" fill="#0c3558" stroke="#38bdf8" stroke-width="1.8" />
                  <circle cx="0" cy="0" r="6" fill="#22d3ee" />
                </g>

                <!-- FAN 3: RIGHT COOLING FAN (x: 160, y: 0, r: 62) -->
                <g class="gpu-fan-unit gpu-fan-unit--3" transform="translate(160, 0)">
                  <circle cx="0" cy="0" r="62" fill="#041220" stroke="#1d5583" stroke-width="2" />
                  <circle cx="0" cy="0" r="56" fill="none" stroke="#0e2e4a" stroke-width="1" />
                  <!-- 9 Aerodynamic Fan Blades -->
                  <g class="gpu-fan-rotor gpu-fan-rotor--3">
                    <line x1="0" y1="-54" x2="0" y2="54" stroke="#38bdf8" stroke-width="3.2" stroke-linecap="round" />
                    <line x1="-54" y1="0" x2="54" y2="0" stroke="#38bdf8" stroke-width="3.2" stroke-linecap="round" />
                    <line x1="-38" y1="-38" x2="38" y2="38" stroke="#38bdf8" stroke-width="3.2" stroke-linecap="round" />
                    <line x1="-38" y1="38" x2="38" y2="-38" stroke="#38bdf8" stroke-width="3.2" stroke-linecap="round" />
                    <line x1="-18" y1="-50" x2="18" y2="50" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" />
                  </g>
                  <circle cx="0" cy="0" r="16" fill="#0c3558" stroke="#38bdf8" stroke-width="1.8" />
                  <circle cx="0" cy="0" r="6" fill="#22d3ee" />
                </g>
              </g>

              <!-- Diagnostic Scanner Line Beam (36% - 44%) -->
              <line class="gpu-scanner-beam" x1="-270" y1="0" x2="270" y2="0" stroke="#22d3ee" stroke-width="3.5" filter="url(#gpu-glow-cyan)" opacity="0" />

              <!-- Dust Flecks Accumulated (0% - 15% dirty, 55% - 70% dissipate) -->
              <g class="gpu-dust-particles" fill="#f59e0b">
                <circle class="gpu-dust gpu-dust--1" cx="-180" cy="-20" r="3" />
                <circle class="gpu-dust gpu-dust--2" cx="-140" cy="25" r="2.6" />
                <circle class="gpu-dust gpu-dust--3" cx="-210" cy="10" r="2.4" />
                <circle class="gpu-dust gpu-dust--4" cx="-20" cy="-35" r="2.8" />
                <circle class="gpu-dust gpu-dust--5" cx="25" cy="30" r="2.6" />
                <circle class="gpu-dust gpu-dust--6" cx="-5" cy="15" r="2.2" />
                <circle class="gpu-dust gpu-dust--7" cx="140" cy="-25" r="2.8" />
                <circle class="gpu-dust gpu-dust--8" cx="185" cy="20" r="2.5" />
                <circle class="gpu-dust gpu-dust--9" cx="210" cy="-10" r="2.3" />
                <circle class="gpu-dust gpu-dust--10" cx="-90" cy="-45" r="2.5" />
                <circle class="gpu-dust gpu-dust--11" cx="85" cy="-45" r="2.5" />
                <circle class="gpu-dust gpu-dust--12" cx="0" cy="-55" r="2.7" />
              </g>

              <!-- 3 Clean Airflow Paths (85% - 94%) -->
              <g class="gpu-airflow-paths">
                <path class="gpu-air-stream gpu-air-stream--1" d="M -160 -90 C -180 -50 -180 50 -160 90" fill="none" stroke="#38bdf8" stroke-width="3.5" stroke-linecap="round" />
                <path class="gpu-air-stream gpu-air-stream--2" d="M 0 -90 C -20 -50 -20 50 0 90" fill="none" stroke="#22d3ee" stroke-width="3.5" stroke-linecap="round" />
                <path class="gpu-air-stream gpu-air-stream--3" d="M 160 -90 C 140 -50 140 50 160 90" fill="none" stroke="#38bdf8" stroke-width="3.5" stroke-linecap="round" />
              </g>

              <!-- Light Sheen Sweep across Entire GPU (97% - 100%) -->
              <rect class="gpu-sheen-rect" x="-300" y="-120" width="600" height="240" fill="url(#gpu-metal-shine)" opacity="0" />

              <!-- Corner Sparkles (97% - 100%) -->
              <g class="gpu-sparkles">
