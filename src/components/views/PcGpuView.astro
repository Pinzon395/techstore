---
import FaqSection from '../FaqSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import Footer from '../Footer.astro';

const waMessage = encodeURIComponent(
  'Hola, quiero cotizar reparación de tarjeta de video GPU en Cancún. Mi PC no da imagen, muestra artefactos, se calienta o quiero instalar una GPU nueva.'
);

const zones = [
  'Cancún Centro',
  'Huayacán',
  'Zona Hotelera',
  'Cumbres',
  'Av. Tulum',
  'Bonampak',
  'Puerto Cancún',
  'Polígono Sur',
  'Bonfil',
  'Puerto Juárez',
  'Supermanzanas',
  'Haciendas',
];

const heroFacts = [
  { label: 'Diagnóstico desde', value: '$650 MXN' },
  { label: 'Prueba bajo carga', value: 'Benchmark, temperatura y voltajes' },
  { label: 'Tiempo típico', value: '24 a 72 h según falla' },
  { label: 'Garantía', value: 'Por escrito sobre lo intervenido' },
];

const symptoms = [
  {
    icon: 'fa-image',
    title: 'Artefactos, líneas o cuadros en pantalla',
    what: 'La imagen se distorsiona, aparecen bloques de color o líneas al jugar o iniciar Windows.',
    cause: 'Puede venir de VRAM, temperatura alta, driver dañado o una falla física en la tarjeta.',
    check: 'Probamos la GPU bajo carga, salidas HDMI/DisplayPort, temperatura y estabilidad de memoria.',
  },
  {
    icon: 'fa-display',
    title: 'PC enciende pero no da imagen',
    what: 'Los ventiladores giran y la PC prende, pero el monitor queda negro o sin señal.',
    cause: 'Puede ser GPU, fuente de poder, ranura PCIe, cable, monitor, BIOS o RAM.',
    check: 'Descartamos monitor, cable, RAM, fuente, ranura PCIe y salida de video antes de culpar la GPU.',
  },
  {
    icon: 'fa-gamepad',
    title: 'Juegos se cierran solos',
    what: 'El juego se congela, se cierra o Windows regresa al escritorio sin explicación clara.',
    cause: 'Suele relacionarse con temperatura, drivers NVIDIA/AMD, fuente insuficiente o inestabilidad de GPU.',
    check: 'Revisamos visor de eventos, drivers, stress test, consumo y voltajes bajo carga.',
  },
  {
    icon: 'fa-moon',
    title: 'Pantalla negra al jugar',
    what: 'La PC sigue encendida, pero la pantalla se apaga al abrir juegos o renderizar.',
    cause: 'Puede ser protección térmica, fuente degradada, cable PCIe flojo o fallo de alimentación.',
    check: 'Probamos fuente, conectores 8 pines o 12VHPWR, temperatura y carga real de la tarjeta.',
  },
  {
    icon: 'fa-gauge-high',
    title: 'FPS bajos o bajo rendimiento',
    what: 'La tarjeta no rinde como debería o cae mucho el rendimiento después de unos minutos.',
    cause: 'Puede ser thermal throttling, driver incorrecto, cuello de botella o mala configuración.',
    check: 'Comparamos benchmark, uso de GPU, temperatura, drivers, CPU, RAM y configuración de energía.',
  },
  {
    icon: 'fa-fan',
    title: 'Ventiladores de GPU al máximo',
    what: 'Los ventiladores suben al 100%, hacen ruido o cambian de velocidad de forma brusca.',
    cause: 'Pasta térmica seca, polvo, thermal pads vencidos, sensor alterado o mala ventilación.',
    check: 'Inspeccionamos disipador, ventiladores, pasta térmica, pads, curva térmica y flujo de aire.',
  },
  {
    icon: 'fa-triangle-exclamation',
    title: 'Pantalla azul o errores de drivers',
    what: 'Aparecen errores de video, reinicios o mensajes relacionados con NVIDIA o AMD.',
    cause: 'Puede ser driver corrupto, Windows inestable, GPU dañada, RAM o almacenamiento.',
    check: 'Reinstalamos drivers de forma limpia, revisamos Windows y probamos hardware por separado.',
  },
  {
    icon: 'fa-temperature-high',
    title: 'Temperatura alta',
    what: 'La GPU supera temperaturas normales, baja frecuencia o se apaga al exigirla.',
    cause: 'El calor de Cancún, polvo, humedad y pasta térmica seca aceleran el desgaste térmico.',
    check: 'Medimos temperatura en reposo y bajo carga, hotspot, ventilación y condición del disipador.',
  },
];

const diagnosticChecks = [
  'Temperatura en reposo y bajo carga.',
  'Benchmark y stress test para reproducir fallas.',
  'Revisión de drivers NVIDIA o AMD.',
  'Prueba de fuente de poder y consumo bajo carga.',
  'Medición de voltajes principales.',
  'Revisión de ranura PCIe y montaje físico.',
  'Inspección de VRAM, VRM, capacitores y conectores.',
  'Prueba de HDMI, DisplayPort y alimentación de GPU.',
  'Recomendación honesta: reparar, dar mantenimiento, cambiar o no invertir.',
];

const serviceBlocks = [
  {
    title: 'Diagnóstico técnico de GPU en Cancún',
    text: 'Antes de cotizar revisamos si la falla realmente viene de la tarjeta de video o si el origen está en fuente, drivers, RAM, monitor, cableado o ranura PCIe.',
  },
  {
    title: 'Reparación, mantenimiento e instalación de GPU',
    text: 'Atendemos fallas de video, temperatura, ventiladores, conectores, drivers e instalación de tarjetas nuevas en PC gamer o estaciones de trabajo.',
  },
  {
    title: 'Cambio de pasta térmica y thermal pads de GPU',
    text: 'Conviene cuando la tarjeta se calienta, baja rendimiento, hace mucho ruido o no recibe mantenimiento desde hace tiempo. Se revisa antes y después.',
  },
  {
    title: 'Instalación de tarjeta de video para PC gamer',
    text: 'Validamos fuente, gabinete, conectores, drivers oficiales, benchmark final, temperatura, FPS y estabilidad para que la actualización tenga sentido.',
  },
];

const gamerChecks = [
  'Compatibilidad con gabinete y placa madre.',
  'Validación de fuente de poder y watts disponibles.',
  'Revisión de conectores 8 pines, 12VHPWR o PCIe 5.0.',
  'Instalación limpia de drivers oficiales.',
  'Benchmark final y prueba de temperatura.',
  'Revisión de FPS, estabilidad y ruido bajo carga.',
];

const localFactors = [
  'Calor ambiental que eleva la temperatura base del gabinete.',
  'Humedad y salitre que pueden afectar conectores, VRM y soldaduras.',
  'Polvo acumulado en ventiladores, disipador y filtros.',
  'Variaciones eléctricas que castigan fuente de poder y GPU.',
  'Pasta térmica y thermal pads secos por uso prolongado.',
];

const decisionRoutes = [
  {
    label: 'Reparar',
    title: 'Cuando la falla es localizada',
    text: 'Conectores, ventiladores, alimentación o intervención viable después de pruebas. Se cotiza antes de abrir reparación.',
  },
  {
    label: 'Mantener',
    title: 'Cuando el problema es térmico',
    text: 'Pasta seca, pads vencidos, polvo o hotspot alto. Se valida con temperatura antes y después, sin prometer resultados fijos.',
  },
  {
    label: 'Cambiar',
    title: 'Cuando el costo ya no conviene',
    text: 'Si el daño supera el valor útil de la tarjeta, recomendamos reemplazo compatible con fuente, gabinete y procesador.',
  },
  {
    label: 'No invertir',
    title: 'Cuando el riesgo es alto',
    text: 'Si hay daño severo, humedad o falla intermitente costosa, te explicamos por qué conviene detener gasto.',
  },
];

const relatedServices = [
  { href: '/servicios/pc/fuente-poder', title: 'Fuente de poder PC', text: 'Revisión de voltajes, watts disponibles, conectores PCIe y estabilidad bajo carga.' },
  { href: '/servicios/pc/diagnostico', title: 'Diagnóstico profesional de PC', text: 'Pruebas por componente para ubicar si la falla es GPU, RAM, fuente, placa o Windows.' },
  { href: '/servicios/pc/limpieza-profunda', title: 'Limpieza profunda de PC', text: 'Limpieza interna, flujo de aire, polvo acumulado y revisión térmica general.' },
  { href: '/servicios/pc/mantenimiento-correctivo', title: 'Mantenimiento correctivo', text: 'Corrección de fallas de hardware o software después de identificar la causa real.' },
  { href: '/servicios/pc/refrigeracion', title: 'Refrigeración y temperatura', text: 'Mejora de ventilación, pasta térmica, ventiladores y estabilidad térmica.' },
  { href: '/servicios/pc/upgrade', title: 'Upgrade SSD y RAM', text: 'Actualización de almacenamiento y memoria para balancear rendimiento de la PC.' },
  { href: '/ensambles', title: 'Ensambles PC Gamer', text: 'Armado y actualización de equipos gamer con compatibilidad de componentes.' },
];

const gpuFaqs = [
  {
    question: '¿Cuánto cuesta revisar una tarjeta de video en Cancún?',
    answer: 'La revisión inicia desde $650 MXN cuando requiere pruebas técnicas, mantenimiento o intervención. Antes de reparar se confirma la falla y se envía cotización clara.',
  },
  {
    question: '¿Cómo sé si mi GPU está fallando?',
    answer: 'Los síntomas más comunes son artefactos, pantalla negra, cierres de juegos, temperatura alta, ventiladores al máximo, errores de drivers o PC sin imagen.',
  },
  {
    question: '¿Qué pasa si mi PC prende pero no da imagen?',
    answer: 'No siempre es la tarjeta de video. Revisamos monitor, cable, RAM, fuente, ranura PCIe, BIOS y GPU antes de recomendar reparación o cambio.',
  },
  {
    question: '¿Puede ser la fuente de poder y no la GPU?',
    answer: 'Sí. Una fuente degradada o insuficiente puede causar pantalla negra, reinicios y cierres al jugar. Por eso medimos voltajes y consumo bajo carga.',
  },
  {
    question: '¿Reparan tarjetas NVIDIA y AMD?',
    answer: 'Diagnosticamos tarjetas NVIDIA GeForce, RTX, GTX y AMD Radeon. Si la reparación no conviene, te lo decimos antes de invertir.',
  },
  {
    question: '¿Hacen cambio de pasta térmica y thermal pads?',
    answer: 'Sí. Se realiza cuando la temperatura, ruido o mantenimiento pendiente lo justifican. No se prometen milagros: la mejora depende del estado de la tarjeta.',
  },
  {
    question: '¿Pueden instalar una GPU nueva?',
    answer: 'Sí. Revisamos fuente, espacio del gabinete, conectores, drivers, temperatura y estabilidad final para instalarla correctamente.',
  },
  {
    question: '¿El calor de Cancún afecta la GPU?',
    answer: 'Sí. El calor, humedad, polvo y salitre pueden acelerar problemas térmicos, corrosión en conectores y fallas de estabilidad en PC gamer.',
  },
  {
    question: '¿Dan garantía?',
    answer: 'Sí, la garantía se entrega por escrito según la reparación o instalación realizada. No cubre humedad posterior, descargas eléctricas o piezas no intervenidas.',
  },
  {
    question: '¿Conviene reparar o cambiar la tarjeta de video?',
    answer: 'Depende del daño, costo de pieza, antigüedad y uso. Después del diagnóstico recomendamos reparar, dar mantenimiento, cambiar o no invertir.',
  },
];
---

<div class="gpu-page">
  <section class="gpu-hero">
    <div class="gpu-hero-grid" aria-hidden="true"></div>
    <div class="container gpu-hero-inner">
      <div class="gpu-hero-copy">
        <span class="gpu-kicker">Servicio técnico PC gamer en Cancún</span>
        <h1>Reparación de tarjeta de video GPU en Cancún</h1>
        <p>
          Diagnóstico técnico para GPU sin imagen, artefactos en pantalla, temperatura alta, crashes en juegos
          o instalación de tarjeta de video para PC gamer. Primero aislamos la causa, después te decimos si conviene reparar, mantener o cambiar.
        </p>
        <div class="gpu-hero-actions">
          <a class="gpu-btn gpu-btn-primary" href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank" rel="noopener">
            <i class="fa-brands fa-whatsapp"></i>
            Cotizar por WhatsApp
          </a>
          <a class="gpu-btn gpu-btn-secondary" href="#ticket-gpu">
            <i class="fa-solid fa-clipboard-list"></i>
            Generar ticket
          </a>
        </div>
        <div class="gpu-zone-list" aria-label="Zonas de atención en Cancún">
          {zones.map((zone) => <span>{zone}</span>)}
        </div>
      </div>

      <aside class="gpu-hero-card" aria-label="Resumen técnico del diagnóstico de GPU">
        <div class="gpu-visual" aria-hidden="true">
          <div class="gpu-board">
            <span class="gpu-chip"></span>
            <span class="gpu-fan gpu-fan-a"></span>
            <span class="gpu-fan gpu-fan-b"></span>
            <span class="gpu-connector"></span>
            <span class="gpu-scan gpu-scan-a"></span>
            <span class="gpu-scan gpu-scan-b"></span>
          </div>
        </div>
        <div class="gpu-hero-card-head">
          <span>Ruta de diagnóstico</span>
          <strong>GPU, fuente, drivers y temperatura</strong>
        </div>
        <div class="gpu-fact-list">
          {heroFacts.map((fact) => (
            <div>
              <span>{fact.label}</span>
              <strong>{fact.value}</strong>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section id="sintomas-gpu" class="gpu-section">
    <div class="container">
      <div class="gpu-heading">
        <span>Síntomas reales</span>
        <h2>Síntomas de una tarjeta de video dañada</h2>
        <p>Estos signos no siempre significan que la GPU murió. En Pixon PC se revisa la causa antes de cambiar piezas.</p>
      </div>
      <div class="symptom-grid">
        {symptoms.map((item, index) => (
          <article class={`symptom-card ${index < 2 ? 'symptom-card-priority' : ''}`}>
            <div class="symptom-icon"><i class={`fa-solid ${item.icon}`}></i></div>
            <h3>{item.title}</h3>
            <p><strong>Qué pasa:</strong> {item.what}</p>
            <p><strong>Posible causa:</strong> {item.cause}</p>
            <p><strong>Qué revisamos:</strong> {item.check}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="diagnostico-gpu" class="gpu-section gpu-section-soft">
    <div class="container split-layout">
      <div>
        <span class="section-label">Diagnóstico técnico de GPU en Cancún</span>
        <h2>Cómo saber si el problema es la GPU, la fuente o los drivers</h2>
        <p>
          No cambiamos la tarjeta de video por intuición. Una PC gamer puede fallar por fuente de poder,
          drivers, RAM, BIOS, cable, monitor, ranura PCIe o temperatura. El diagnóstico separa cada causa
          para darte una recomendación honesta.
        </p>
        <div class="diagnostic-note">
          <i class="fa-solid fa-circle-info"></i>
          <p>Si no conviene reparar o invertir en esa GPU, se informa antes de hacer gasto en refacciones. La recomendación puede ser mantenimiento, cambio de fuente, cambio de GPU o no invertir.</p>
        </div>
      </div>
      <div class="check-panel">
        <h3>Pruebas que realizamos</h3>
        <ul>
          {diagnosticChecks.map((check) => (
            <li><i class="fa-solid fa-check"></i>{check}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="gpu-section">
    <div class="container">
      <div class="gpu-heading">
        <span>Servicio completo</span>
        <h2>Reparación, mantenimiento e instalación de GPU</h2>
        <p>La vista está pensada para que entiendas qué se revisa, qué se puede corregir y cuándo conviene cambiar la tarjeta.</p>
      </div>
      <div class="service-grid">
        {serviceBlocks.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="gpu-section decision-section">
    <div class="container">
      <div class="gpu-heading">
        <span>Decisión técnica antes de gastar</span>
        <h2>Te decimos si conviene reparar, mantener, cambiar o no invertir</h2>
        <p>Una GPU puede fallar por daño real, temperatura, fuente insuficiente, drivers o mala instalación. El objetivo es evitar compras innecesarias.</p>
      </div>
      <div class="decision-grid">
        {decisionRoutes.map((item) => (
          <article>
            <span>{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
      <div class="mid-cta">
        <p>¿Tu PC prende pero no da imagen o se apaga al jugar?</p>
        <a class="gpu-btn gpu-btn-primary" href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank" rel="noopener">
          <i class="fa-brands fa-whatsapp"></i>
          Enviar síntomas por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <section id="mantenimiento-gpu" class="gpu-section gpu-section-soft">
    <div class="container split-layout">
      <div class="check-panel">
        <h3>Cuándo conviene mantenimiento térmico</h3>
        <ul>
          <li><i class="fa-solid fa-check"></i>Temperatura alta o hotspot elevado.</li>
          <li><i class="fa-solid fa-check"></i>Ventiladores al máximo o ruido excesivo.</li>
          <li><i class="fa-solid fa-check"></i>Rendimiento que cae después de jugar unos minutos.</li>
          <li><i class="fa-solid fa-check"></i>Pasta térmica seca o thermal pads deteriorados.</li>
        </ul>
      </div>
      <div>
        <span class="section-label">Cambio de pasta térmica y thermal pads de GPU</span>
        <h2>Mantenimiento de GPU sin prometer milagros</h2>
        <p>
          Antes de abrir la tarjeta medimos temperatura y revisamos si el mantenimiento tiene sentido.
          Después se valida con prueba de carga. La mejora depende del estado del chip, disipador, pads,
          ventiladores y uso previo.
        </p>
      </div>
    </div>
  </section>

  <section id="instalacion-gpu" class="gpu-section">
    <div class="container split-layout">
      <div>
        <span class="section-label">Instalación de tarjeta de video Cancún</span>
        <h2>Instalación de tarjeta de video para PC gamer</h2>
        <p>
          Si compraste una GPU nueva o quieres actualizar tu PC gamer en Cancún, validamos compatibilidad
          antes de instalar. No basta con que la tarjeta entre en el gabinete: también debe soportarla la fuente,
          el cableado, la ventilación y la plataforma.
        </p>
        <a class="text-link" href="#ticket-gpu">Agendar diagnóstico</a>
      </div>
      <div class="check-panel">
        <h3>Validación de instalación</h3>
        <ul>
          {gamerChecks.map((check) => (
            <li><i class="fa-solid fa-check"></i>{check}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="gpu-section gpu-section-soft">
    <div class="container split-layout">
      <div>
        <span class="section-label">Fallas comunes de GPU por calor, polvo y humedad en Cancún</span>
        <h2>Servicio local para PC gamer en Cancún</h2>
        <p>
          En Cancún Centro, Zona Hotelera, Huayacán, Cumbres, Bonampak, Puerto Cancún, Polígono Sur,
          Bonfil, Puerto Juárez, Av. Tulum, Haciendas, Supermanzanas y alrededores, el calor y la humedad pueden
          afectar GPU, fuente, conectores, ventiladores, pasta térmica y estabilidad del equipo.
        </p>
      </div>
      <div class="check-panel">
        <h3>Factores que revisamos</h3>
        <ul>
          {localFactors.map((factor) => (
            <li><i class="fa-solid fa-check"></i>{factor}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="ticket-gpu-intro" class="gpu-section ticket-intro">
    <div class="container ticket-callout">
      <div>
        <span class="section-label">Crear ticket para diagnóstico de GPU</span>
        <h2>Solicita revisión con datos claros</h2>
        <p>
          Cuéntanos si tu PC no da imagen, muestra artefactos, se apaga al jugar, tiene temperatura alta,
          ventiladores al máximo o si quieres instalar una GPU nueva. Con esa información preparamos el diagnóstico.
        </p>
        <p class="example-text">
          Ejemplo: mi PC gamer prende, pero al abrir juegos la pantalla se pone negra y los ventiladores de la GPU suben al máximo.
        </p>
      </div>
      <a class="gpu-btn gpu-btn-primary" href="#ticket-gpu">Solicitar revisión y cotización</a>
    </div>
  </section>

  <ServiceTicketSection
    id="ticket-gpu"
    defaultDevice="PC de escritorio"
    defaultService="Diagnóstico tarjeta de video GPU"
    sourcePage="/servicios/pc/tarjeta-video-gpu"
    title="Crear ticket para diagnóstico de GPU"
    subtitle="Cuéntanos si tu PC no da imagen, muestra artefactos, se apaga al jugar, tiene temperatura alta, ventiladores al máximo o si quieres instalar una GPU nueva. Ejemplo: mi PC gamer prende, pero al abrir juegos la pantalla se pone negra y los ventiladores de la GPU suben al máximo."
  />

  <section id="relacionados" class="gpu-section">
    <div class="container">
      <div class="gpu-heading">
        <span>Servicios relacionados para PC gamer en Cancún</span>
        <h2>Servicios relacionados para PC gamer en Cancún</h2>
        <p>Servicios internos que suelen cruzarse con fallas de GPU, instalación o bajo rendimiento.</p>
      </div>
      <div class="related-grid">
        {relatedServices.map((item) => (
          <a class="related-card" href={item.href}>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <span>Ver servicio relacionado</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="contacto-gpu" class="gpu-section gpu-section-soft contact-nap">
    <div class="container split-layout">
      <div>
        <span class="section-label">Taller técnico de computadoras en Cancún</span>
        <h2>Taller técnico de computadoras en Cancún</h2>
        <p>
          Atención local para diagnóstico de GPU, reparación de computadoras en Cancún, PC gamer y servicio técnico PC con cita previa.
        </p>
      </div>
      <address>
        <strong>Pixon PC</strong>
        <span>Cto. Hacienda Chimay, 77539 Cancún, Q.R.</span>
        <span>WhatsApp: <a href={`https://wa.me/529986690777?text=${waMessage}`} target="_blank" rel="noopener">+52 998 669 0777</a></span>
        <span>Correo: <a href="mailto:pixonpc@gmail.com">pixonpc@gmail.com</a></span>
        <span>Horario: Lunes a Domingo con cita previa</span>
      </address>
    </div>
  </section>

  <FaqSection
    id="faq-gpu"
    title="Preguntas frecuentes sobre tarjeta de video GPU en Cancún"
    description="Respuestas directas para decidir si necesitas diagnóstico, mantenimiento, instalación o cambio de GPU."
    items={gpuFaqs}
    titleColor="#071F3A"
    descriptionColor="#071F3A"
    questionColor="#071F3A"
  />

  <CommentsSection />
  <ContactSection />
  <Footer />
</div>

<style is:global>
  .gpu-page {
    --azul-oscuro: #071F3A;
    --gpu-blue: #2563eb;
    --gpu-cyan: #38bdf8;
    --gpu-border: #dbe5f0;
    --gpu-soft: #f6f9fd;
    --gpu-ease: cubic-bezier(.23, 1, .32, 1);
    background: #ffffff;
    color: var(--azul-oscuro);
  }

  .gpu-page section:not(.gpu-hero),
  .gpu-page section:not(.gpu-hero) h2,
  .gpu-page section:not(.gpu-hero) h3,
  .gpu-page section:not(.gpu-hero) p,
  .gpu-page section:not(.gpu-hero) li,
