<style is:global>
  /* ==================== GLOBAL PAGE VARIABLES & TYPOGRAPHY ==================== */
  .gpu-page {
    --azul-oscuro: #071F3A;
    --gpu-cyan: #38bdf8;
    --gpu-blue: #0284c7;
    background: #f8fafc;
    color: var(--azul-oscuro);
  }

  .gpu-page section:not(.gpu-hero),
  .gpu-page section:not(.gpu-hero) h2,
  .gpu-page section:not(.gpu-hero) h3,
  .gpu-page section:not(.gpu-hero) h4,
  .gpu-page section:not(.gpu-hero) p,
  .gpu-page section:not(.gpu-hero) li,
  .gpu-page section:not(.gpu-hero) span,
  .gpu-page section:not(.gpu-hero) strong,
  .gpu-page section:not(.gpu-hero) address {
    color: var(--azul-oscuro) !important;
  }

  /* ==================== 1. HERO SECTION ==================== */
  .gpu-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(56px, 7.5vw, 92px) 0 68px;
    background-color: #071F3A !important;
    color: #ffffff;
    isolation: isolate;
  }
  .gpu-hero::before {
    position: absolute;
    top: -240px;
    right: -240px;
    width: 680px;
    height: 680px;
    content: "";
    border: 1px solid rgba(56, 189, 248, 0.18);
    border-radius: 50%;
    box-shadow: 0 0 0 64px rgba(14, 116, 144, 0.1), 0 0 0 128px rgba(14, 116, 144, 0.05);
    pointer-events: none;
    z-index: -1;
  }

  .gpu-hero-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: 0.35;
    pointer-events: none;
  }

  .gpu-hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(330px, 0.95fr);
    gap: clamp(28px, 4.5vw, 56px);
    align-items: center;
  }

  .gpu-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #38bdf8 !important;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .gpu-hero h1 {
    margin: 0 0 18px;
    color: #ffffff !important;
    font-family: 'Kanit', sans-serif;
    font-size: clamp(2.3rem, 4.5vw, 3.8rem);
    font-weight: 900;
    line-height: 1.06;
    letter-spacing: -0.03em;
  }

  .gpu-lead {
    margin: 0 0 24px;
    color: #dbeafe !important;
    font-size: clamp(1.02rem, 1.8vw, 1.2rem);
    line-height: 1.6;
    max-width: 620px;
  }

  .gpu-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }

  .gpu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 48px;
    padding: 12px 20px;
    border-radius: 10px;
    font-weight: 800;
    font-size: 0.92rem;
    text-decoration: none;
    transition: transform 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }
  .gpu-btn:hover {
    transform: translateY(-2px);
  }
  .gpu-btn-primary {
    background: #16a34a;
    color: #ffffff !important;
    box-shadow: 0 10px 22px rgba(22, 163, 74, 0.28);
  }
  .gpu-btn-primary:hover {
    background: #15803d;
  }
  .gpu-btn-secondary {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #ffffff !important;
  }
  .gpu-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .gpu-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gpu-badges li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border: 1px solid rgba(186, 230, 253, 0.24);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: #e0f2fe !important;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .gpu-badges i {
    color: #38bdf8;
    font-size: 0.72rem;
  }

  /* ==================== 3-FAN GPU MOTION DESIGN ==================== */
  .gpu-hero__visual-container {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
  }

  .gpu-visual-stage {
    width: 100%;
    margin: 0;
  }
  .gpu-visual-stage svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 14px 30px rgba(2, 11, 20, 0.5));
  }

  /* Motion Graphic Elements (13.5s narrative loop) */
  .gpu-glitch-monitor {
    animation: gpu-glitch-monitor-fx 13.5s ease-in-out infinite;
  }
  .gpu-thermal-halo {
    animation: gpu-thermal-halo-fx 13.5s ease-in-out infinite;
  }
  .gpu-layer-shroud {
    transform-origin: center bottom;
    animation: gpu-shroud-explode-fx 13.5s cubic-bezier(0.3, 0.05, 0.2, 1) infinite;
  }
  .gpu-layer-heatsink {
    transform-origin: center bottom;
    animation: gpu-heatsink-explode-fx 13.5s cubic-bezier(0.3, 0.05, 0.2, 1) infinite;
  }
  .gpu-die-core {
    animation: gpu-die-thermal-fx 13.5s ease-in-out infinite;
  }
  .gpu-heatsink-fins {
    animation: gpu-fins-contrast-fx 13.5s ease-in-out infinite;
  }
  .gpu-heatpipes path {
    animation: gpu-heatpipes-color-fx 13.5s ease-in-out infinite;
  }

  .gpu-fan-rotor {
    transform-box: fill-box;
    transform-origin: center;
    animation: gpu-triple-fans-spin 13.5s linear infinite;
  }
  .gpu-fan-rotor--2 { animation-delay: 40ms; }
  .gpu-fan-rotor--3 { animation-delay: 80ms; }

  .gpu-scanner-beam {
    animation: gpu-scan-beam-fx 13.5s ease-in-out infinite;
  }
  .gpu-dust-particles {
    animation: gpu-dust-dissipate-fx 13.5s cubic-bezier(0.2, 0.7, 0.3, 1) infinite;
  }

  .gpu-air-stream {
    stroke-dasharray: 40 80;
    stroke-dashoffset: 120;
    animation: gpu-airflow-flow-fx 13.5s linear infinite;
  }
  .gpu-air-stream--2 { animation-delay: 90ms; }
  .gpu-air-stream--3 { animation-delay: 180ms; }

  .gpu-sheen-rect {
    animation: gpu-metal-sheen-fx 13.5s ease-in-out infinite;
  }
  .gpu-sparkle {
    transform-box: fill-box;
    transform-origin: center;
    animation: gpu-sparkle-pop-fx 13.5s ease-in-out infinite;
  }
  .gpu-sparkle--2 { animation-delay: 140ms; }

  .gpu-success-badge {
    transform-box: fill-box;
    transform-origin: center;
    animation: gpu-success-check-fx 13.5s cubic-bezier(0.18, 0.9, 0.32, 1.25) infinite;
  }

  /* 13.5-Second Animation Keyframes */
  @keyframes gpu-glitch-monitor-fx {
    0%, 35% { opacity: 0.25; }
    36%, 100% { opacity: 0; }
  }

  @keyframes gpu-thermal-halo-fx {
    0%, 14% { opacity: 0; transform: scale(0.85); }
    18%, 26% { opacity: 0.75; transform: scale(1.05); }
    30%, 100% { opacity: 0; transform: scale(0.85); }
  }

  /* Triple Fans Rotation */
  @keyframes gpu-triple-fans-spin {
    0%, 14% { transform: rotate(0deg); }
    15%, 27% { transform: rotate(1800deg); }
    28%, 43% { transform: rotate(2340deg); }
    44%, 77% { transform: rotate(2340deg); } /* Stoppage during exploded view */
    78%, 84% { transform: rotate(2520deg); }
    85%, 96% { transform: rotate(4320deg); } /* Smooth stable cooling */
    97%, 100% { transform: rotate(4500deg); }
  }

  /* Exploded View Separation (44% - 55% separates, 78% - 85% reassembles) */
  @keyframes gpu-shroud-explode-fx {
    0%, 43% { transform: translateY(0); opacity: 0.95; }
    48%, 77% { transform: translateY(-38px); opacity: 0.25; }
    84%, 100% { transform: translateY(0); opacity: 0.95; }
  }
  @keyframes gpu-heatsink-explode-fx {
    0%, 43% { transform: translateY(0); opacity: 0.95; }
    48%, 77% { transform: translateY(-16px); opacity: 0.65; }
    84%, 100% { transform: translateY(0); opacity: 0.95; }
  }

  /* Diagnostic Scanner Beam (36% - 44%) */
  @keyframes gpu-scan-beam-fx {
    0%, 35% { opacity: 0; transform: translateY(-50px); }
    37% { opacity: 0.95; }
    42% { opacity: 0.95; transform: translateY(50px); }
    44%, 100% { opacity: 0; transform: translateY(55px); }
