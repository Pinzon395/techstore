---
// DesbloqueoIcloudView.astro — Desbloqueo de iCloud y Remoción de Cuenta iPhone en Cancún
// SEO Local | Pixon PC
const { service, category } = Astro.props;

import FaqSection from '../FaqSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import Footer from '../Footer.astro';

const waMsg = encodeURIComponent('Hola, quiero cotizar el diagnóstico y desbloqueo de iCloud / cuenta Apple ID para mi iPhone en Cancún. Puedo enviar modelo e IMEI.');

// ── DATOS DE LA VISTA ─────────────────────────────────────────────────────────

const stats = [
  { num: '100%', label: 'Diagnóstico transparente', icon: 'fa-magnifying-glass', color: '#3b82f6' },
  { num: '5.0 ★', label: 'Calificación Google', icon: 'fa-star', color: '#f59e0b' },
  { num: 'Cancún', label: 'Taller local físico', icon: 'fa-location-dot', color: '#22c55e' },
  { num: '100%', label: 'Privacidad y seguridad', icon: 'fa-shield-halved', color: '#8b5cf6' },
];

const casosIntencion = [
  {
    icon: 'fa-lock',
    title: 'Pantalla de Activación: "iPhone bloqueado para el propietario"',
    sub: 'Compraste un iPhone usado o restauraste y pide la cuenta del dueño anterior',
