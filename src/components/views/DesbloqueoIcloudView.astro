  }
];

const procesoPasos = [
  {
    step: '01',
    icon: 'fa-barcode',
    title: 'Verificación de IMEI y Estatus',
    desc: 'Ingresamos el IMEI en herramientas de verificación para validar si la unidad está limpia, con reporte o en modo perdido.'
  },
  {
    step: '02',
    icon: 'fa-microchip',
    title: 'Diagnóstico de Modelo y Versión iOS',
    desc: 'Determinamos el chip exacto del iPhone (A11, A12, A13, A14, A15, A16, A17) y la versión instalada de iOS.'
  },
  {
    step: '03',
    icon: 'fa-file-invoice',
    title: 'Cotización Transparente',
    desc: 'Te indicamos con claridad qué método aplica a tu caso particular, tiempo estimado, costo exacto y alcances.'
  },
  {
    step: '04',
    icon: 'fa-bolt',
    title: 'Ejecución del Servicio',
    desc: 'Conectamos el equipo a nuestro software especializado de laboratorio de forma segura sin dañar hardware.'
