  }
];

const modelosFrasesIntencion = [
  { modelo: 'iPhone X / 8 / 8 Plus', frase: 'desbloqueo iCloud iPhone X Cancún', icon: 'fa-mobile-screen', desc: 'Soporte con bypass directo por procesador A11.' },
  { modelo: 'iPhone XR / XS / XS Max', frase: 'quitar iCloud iPhone XR', icon: 'fa-mobile-screen', desc: 'Diagnóstico por servidor e IMEI Clean.' },
  { modelo: 'iPhone 11 / 11 Pro / Pro Max', frase: 'desbloquear iPhone 11 con Apple ID', icon: 'fa-mobile-screen', desc: 'Evaluación técnica para desvinculación o restablecimiento.' },
  { modelo: 'iPhone 12 / 12 Mini / Pro Max', frase: 'quitar cuenta iCloud iPhone 12', icon: 'fa-mobile-screen', desc: 'Verificación de pantalla de activación e IMEI.' },
