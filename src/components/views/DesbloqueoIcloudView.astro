  { modelo: 'iPhone 14 / 14 Plus / Pro Max', frase: 'desbloqueo de activación iPhone 14', icon: 'fa-mobile-screen', desc: 'Revisión técnica especializada de iOS 16/17.' },
  { modelo: 'iPhone 15 / 15 Plus / Pro Max', frase: 'recuperar Apple ID iPhone 15', icon: 'fa-mobile-screen', desc: 'Evaluación de servidor y estatus de cuenta personal.' },
  { modelo: 'iPhone 16 / 16 Plus / Pro Max', frase: 'revisar iCloud iPhone 16', icon: 'fa-mobile-screen', desc: 'Servicio técnico Apple especializado en Cancún.' },
  { modelo: 'iPad Pro (Todas las gens)', frase: 'desbloqueo iPad Pro Cancún', icon: 'fa-tablet-screen-button', desc: 'Atención a tabletas profesionales bloqueadas.' },
  { modelo: 'iPad Air (Todas las gens)', frase: 'quitar iCloud iPad Air', icon: 'fa-tablet-screen-button', desc: 'Restablecimiento e integración de cuenta nueva.' },
  { modelo: 'iPad Mini (Todas las gens)', frase: 'desbloqueo iPad Mini Cancún', icon: 'fa-tablet-screen-button', desc: 'Solución para pantallas de activación en iPadOS.' },
  { modelo: 'Apple Watch (Series 3 - 9 / Ultra)', frase: 'Apple Watch bloqueo de activación Cancún', icon: 'fa-clock', desc: 'Revisión y desvinculación de reloj en taller.' }
];

const zonasCancunCombinadas = [
  { zona: 'Zona Hotelera Cancún', frase: 'desbloqueo iCloud Zona Hotelera Cancún', desc: 'Atención a residentes, ejecutivos y turistas desde Km 0 al 21, Puerto Cancún y Pok Ta Pok.', icon: 'fa-hotel' },
  { zona: 'Av. Huayacán & Cumbres', frase: 'desbloqueo iPhone Huayacán', desc: 'Servicio rápido para Residencial Cumbres, Palmaris, Arbolada, Campestre y Av. Huayacán.', icon: 'fa-tree' },
  { zona: 'Polígono Sur & Av. 135', frase: 'quitar cuenta iCloud Polígono Sur', desc: 'Cobertura para Jardines del Sur, Santa Fe y Supermanzanas del Polígono Sur de Cancún.', icon: 'fa-city' },
  { zona: 'Puerto Cancún & Bonampak', frase: 'servicio técnico iPhone Puerto Cancún', desc: 'Diagnóstico técnico preferente en Av. Bonampak, Nader, Tulum y marina Puerto Cancún.', icon: 'fa-anchor' },
  { zona: 'Cumbres & SM 30-50', frase: 'reparación iPhone Cumbres Cancún', desc: 'Taller cercano para clientes de Residencial Cumbres y avenidas principales.', icon: 'fa-shield-halved' },
  { zona: 'Alfredo V. Bonfil', frase: 'desbloqueo iPad Bonfil', desc: 'Atención especializada para negocios y particulares en la delegación de Bonfil.', icon: 'fa-map-location-dot' },
  { zona: 'Supermanzana 200 & Centro', frase: 'técnico iPhone Supermanzana 200', desc: 'Servicio de revisión y diagnóstico para SM 200, Cancún Centro y zonas aledañas.', icon: 'fa-house-flag' },
  { zona: 'Puerto Juárez & Haciendas', frase: 'servicio iPhone Puerto Juárez', desc: 'Ubicados físicamente en Cto. Hacienda Chimay, atendiendo Puerto Juárez y SM 210-230.', icon: 'fa-building-columns' },
  { zona: 'Plaza Las Américas & Tulum', frase: 'desbloqueo iCloud cerca de Plaza Las Américas', desc: 'A minutos del centro comercial más importante de Cancún sobre Av. Tulum.', icon: 'fa-store' },
  { zona: 'Servicio a Domicilio / Recolección', frase: 'recolección de iPhone a domicilio Cancún', desc: 'Ofrecemos opción de servicio a domicilio e inspección con recolección en Cancún.', icon: 'fa-truck-fast' }
];

const preguntasH3 = [
  {
    question: '¿Qué hago si mi iPhone dice “bloqueado para el propietario”?',
    answer: 'La pantalla "iPhone bloqueado para el propietario" o "Bloqueo de Activación" indica que el dispositivo está vinculado a una cuenta Apple ID anterior. En Pixon PC Cancún ingresamos tu IMEI a diagnóstico técnico para determinar si aplica desvinculación por servidor (Clean IMEI) o bypass local según la versión de iOS y chip de tu iPhone.'
  },
  {
    question: '¿Se puede quitar la cuenta del propietario anterior?',
    answer: 'Sí, dependiendo del estatus del equipo y la generación del chip. Si compraste un equipo de segunda mano y está en estado limpio (Clean IMEI), evaluamos la factibilidad técnica para remover la cuenta anterior de forma definitiva o mediante bypass técnico directo en nuestro taller en Cancún.'
  },
  {
    question: '¿Pueden revisar un iPhone comprado de segunda mano?',
    answer: 'Por supuesto. Realizamos una revisión previa de IMEI para iPhone comprados en Facebook Marketplace, Mercado Libre o de segunda mano en Cancún. Verificamos que el equipo no tenga reportes y confirmamos qué método de servicio aplica antes de realizar cualquier intervención.'
  },
  {
    question: '¿Cuánto cuesta revisar un iPhone bloqueado con iCloud?',
    answer: 'La verificación inicial de IMEI y diagnóstico de factibilidad para desbloqueo de iCloud en Cancún se realiza previa a cualquier trabajo. Te entregamos una cotización transparente según el modelo (iPhone X, 11, 12, 13, 14, 15, 16) y la versión de iOS instalada.'
  },
  {
    question: '¿Necesito factura o comprobante de compra?',
    answer: 'Para procesos de desvinculación oficial en servidor o recuperaciones de acceso con soporte Apple, la documentación o comprobante de compra facilita el trámite. Para diagnósticos en taller y bypass técnico local, evaluamos físicamente el dispositivo e IMEI.'
  },
  {
    question: '¿Cuál es la diferencia entre código olvidado y bloqueo de iCloud?',
    answer: 'El código olvidado es la clave de 6 dígitos para desbloquear la pantalla inicial ("iPhone no disponible" o deshabilitado). El bloqueo de iCloud es la contraseña del Apple ID solicitada tras restaurar el equipo en la Pantalla de Activación. Son dos procesos distintos que atendemos en nuestro taller.'
  },
  {
    question: '¿Se pueden recuperar las fotos de un iPhone bloqueado?',
    answer: 'Al restaurar o bypassear un iPhone con Bloqueo de Activación o código de pantalla olvidado, la memoria interna se restablece de fábrica por seguridad de Apple. Sin embargo, si tenías respaldo automático en iCloud, podrás descargar tus fotos y contactos al ingresar tu cuenta nueva.'
  },
  {
    question: '¿Puedo desbloquear mi iPhone si olvidé el correo?',
    answer: 'Si olvidaste el correo registrado o perdiste acceso a tu autenticación de dos pasos, te orientamos para recuperar el acceso a tu Apple ID o diagnosticar opciones de bypass/desvinculación directa en Cancún.'
  },
  {
    question: '¿Atienden iPad con Bloqueo de activación?',
    answer: 'Sí. Atendemos desbloqueo de iCloud para iPad Pro, iPad Air, iPad Mini y iPad estándar, así como Apple Watch con Bloqueo de Activación retenidos en la configuración inicial en Cancún.'
  },
  {
    question: '¿Ofrecen recolección a domicilio en Cancún?',
    answer: 'Sí, ofrecemos opción de recolección de iPhone a domicilio en Cancún (Zona Hotelera, Huayacán, Cumbres, Polígono Sur, Puerto Cancún y zonas aledañas) para clientes que no puedan trasladarse a nuestro taller físico en Cto. Hacienda Chimay.'
  },
  {
    question: '¿Cómo saber si el IMEI está limpio?',
    answer: 'En Pixon PC consultamos las bases de datos técnicas oficiales del IMEI. Te explicamos de inmediato si el estatus es "Clean" (apto para servicio completo) o si cuenta con reporte que limite las funciones de red móvil.'
  },
  {
    question: '¿Qué pasa si el iPhone fue comprado usado?',
    answer: 'Es una situación muy común en Cancún. Si el vendedor anterior no cerró sesión, realizamos la lectura del IMEI y chip para decirte con total honestidad qué solución técnica (bypass o desvinculación) permitirá volver a usar el equipo.'
  }
];
---

<!-- VISTA PRINCIPAL DESBLOQUEO ICLOUD -->
<div class="icloud-view-wrapper">
  
  <!-- HERO SECTION -->
  <section class="hero-icloud">
    <div class="hero-glow-1" aria-hidden="true"></div>
    <div class="hero-glow-2" aria-hidden="true"></div>
    
    <div class="container hero-inner">
      <!-- Columna Izquierda: Copy y CTAs -->
      <div class="hero-copy">
        <div class="hero-badge">
          <i class="fa-brands fa-apple"></i>
          <span>Servicio Técnico Especializado iPhone en Cancún</span>
        </div>
        
        <!-- H1 ÚNICO EN LA PÁGINA -->
        <h1 class="hero-title">
          Desbloqueo de iCloud y Remoción de Cuenta iPhone en Cancún
        </h1>

        <p class="hero-subtitle">
          Diagnóstico técnico de IMEI, evaluación de cuenta Apple ID y restablecimiento seguro para iPhone y iPad en Cancún.
        </p>

        <!-- CHIPS DESTACADOS -->
        <div class="hero-chips">
          <div class="hero-chip"><i class="fa-solid fa-magnifying-glass"></i> Diagnóstico de IMEI</div>
          <div class="hero-chip"><i class="fa-solid fa-shield-halved"></i> Garantía de Privacidad</div>
          <div class="hero-chip"><i class="fa-solid fa-bolt"></i> Atención Rápida</div>
          <div class="hero-chip"><i class="fa-solid fa-location-dot"></i> Taller Físico Cancún</div>
        </div>

        <!-- BARRA DE CONFIANZA -->
        <div class="hero-trust-bar">
          <span class="trust-item"><i class="fa-solid fa-star" style="color: #f59e0b;"></i> 5.0 en Google</span>
          <span class="trust-item"><i class="fa-solid fa-location-dot" style="color: #22c55e;"></i> Cto. Hacienda Chimay, Cancún</span>
          <span class="trust-item"><i class="fa-solid fa-user-shield" style="color: #8b5cf6;"></i> 100% Confidencial</span>
        </div>

        <!-- BOTONES CTA HERO -->
        <div class="hero-actions">
          <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="btn-primary-wa">
            <i class="fa-brands fa-whatsapp"></i>
            <span>Cotizar por WhatsApp</span>
          </a>
          <a href="#contacto" class="btn-secondary-ticket">
            <i class="fa-solid fa-comments"></i>
            <span>Solicitar Cotización</span>
          </a>
          <a href="#diagnostico-info" class="btn-tertiary-info">
            <i class="fa-solid fa-stethoscope"></i>
            <span>Solicitar Diagnóstico</span>
          </a>
        </div>

        <p class="hero-micro">
          <i class="fa-solid fa-circle-info"></i> Atención presencial en Cancún Centro, Huayacán, Cumbres, Zona Hotelera y Q. Roo.
        </p>
      </div>

      <!-- Columna Derecha: Tarjeta Visual de Evaluación IMEI & Dispositivo -->
      <div class="hero-visual-col">
        <div class="hero-device-card">
          <div class="device-card-header">
            <div class="header-left">
              <i class="fa-brands fa-apple apple-icon"></i>
              <span class="header-title">Diagnóstico IMEI & iCloud</span>
            </div>
            <span class="header-badge"><i class="fa-solid fa-signal"></i> Cancún</span>
          </div>

          <!-- MOCKUP IPHONE -->
          <div class="mock-phone-container">
            <div class="mock-phone-frame">
              <div class="mock-phone-notch"></div>
              <div class="mock-phone-screen">
                <div class="screen-shield-box">
                  <div class="shield-pulse"></div>
                  <i class="fa-solid fa-lock shield-icon"></i>
                </div>
                <div class="screen-status-title">Verificación Técnica Apple ID</div>
                <div class="screen-status-sub">Diagnóstico en Taller Cancún</div>

                <div class="screen-checks-list">
                  <div class="check-row">
                    <i class="fa-solid fa-circle-check check-ok"></i>
                    <span>Verificación Estatus Clean</span>
                    <span class="row-tag tag-green">Elegible</span>
                  </div>
                  <div class="check-row">
                    <i class="fa-solid fa-microchip check-blue"></i>
                    <span>Identificación Chip A11-A17</span>
                    <span class="row-tag tag-blue">Procesado</span>
                  </div>
                  <div class="check-row">
                    <i class="fa-solid fa-user-lock check-purple"></i>
                    <span>Resguardo de Privacidad</span>
                    <span class="row-tag tag-purple">Privado</span>
                  </div>
                </div>
              </div>
              <div class="mock-phone-bar"></div>
            </div>
          </div>

          <!-- FOOTER CARDA VISUAL -->
          <div class="device-card-footer">
            <div class="footer-stat">
              <i class="fa-solid fa-clock-rotate-left"></i>
              <span>Revisión en Taller</span>
            </div>
            <div class="footer-stat">
              <i class="fa-solid fa-file-contract"></i>
              <span>Cotización Transparente</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN AVISO DE TRANSPARENCIA Y DIAGNÓSTICO -->
  <section id="diagnostico-info" class="section-notice">
    <div class="container">
      <div class="notice-box">
        <div class="notice-header">
          <i class="fa-solid fa-shield-halved notice-icon"></i>
          <div>
            <h2 class="notice-title">Política de Diagnóstico Honesto y Verificación de IMEI en Cancún</h2>
            <p class="notice-subtitle">Sin promesas falsas: Evaluamos la factibilidad técnica de tu iPhone o iPad antes de realizar cualquier cobro.</p>
          </div>
        </div>
        <div class="notice-grid">
          <div class="notice-item">
            <i class="fa-solid fa-circle-check item-icon"></i>
            <div>
              <strong>Revisión de Estatus Clean</strong>
              <p>Comprobamos el historial del IMEI en base de datos para confirmar que la unidad es elegible para servicio técnico en Cancún.</p>
            </div>
          </div>
          <div class="notice-item">
            <i class="fa-solid fa-microchip item-icon"></i>
            <div>
              <strong>Diagnóstico de Procesador</strong>
              <p>Evaluamos si tu modelo permite bypass local o si requiere gestión de desvinculación por servidor.</p>
            </div>
          </div>
          <div class="notice-item">
            <i class="fa-solid fa-user-lock item-icon"></i>
            <div>
              <strong>Garantía de Privacidad</strong>
              <p>Tu información y equipo son tratados con absoluta confidencialidad en nuestro taller físico en Cancún.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ESCENARIOS Y CASOS SEGÚN MENSAJE DE PANTALLA -->
  <section class="section-scenarios">
    <div class="container">
      <div class="section-header-center">
        <span class="section-eyebrow">Diagnóstico por Intención y Mensaje en Pantalla</span>
        <h2 class="section-title">¿Qué mensaje o tipo de bloqueo presenta tu iPhone o iPad?</h2>
        <p class="section-desc">Apple diferencia el código de pantalla, la cuenta personal olvidada y el bloqueo de activación. Identifica tu caso para una asesoría exacta en Cancún.</p>
      </div>

      <div class="scenarios-grid">
        {casosIntencion.map(sc => (
          <div class="scenario-card">
            <div class="card-top">
              <div class="icon-wrapper" style={`background-color: ${sc.color}15; color: ${sc.color};`}>
                <i class={`fa-solid ${sc.icon}`}></i>
              </div>
              <span class="card-badge" style={`background-color: ${sc.color}15; color: ${sc.color};`}>
                {sc.badge}
              </span>
            </div>
            <h3 class="card-title">{sc.title}</h3>
            <h4 class="card-sub">{sc.sub}</h4>
            <p class="card-desc">{sc.desc}</p>
            <div class="card-kw-tags">
              {sc.keywords.map(kw => (
                <span class="kw-tag"><i class="fa-solid fa-tag"></i> {kw}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TABLA COMPARATIVA DE MÉTODOS DE ATENCIÓN -->
  <section class="section-comparison">
    <div class="container">
      <div class="section-header-center">
        <span class="section-eyebrow">Transparencia Técnica</span>
        <h2 class="section-title">Opciones y Métodos de Solución para iPhone y iPad</h2>
        <p class="section-desc">Te explicamos con claridad las opciones existentes según la causa del bloqueo de activación o código.</p>
      </div>

      <div class="comparison-grid">
        {comparativaMetodos.map(item => (
          <div class="method-card">
            <div class="method-header" style={`border-top-color: ${item.color};`}>
              <span class="method-tag" style={`color: ${item.color};`}>{item.destacado}</span>
              <h3 class="method-title">{item.titulo}</h3>
              <p class="method-desc">{item.desc}</p>
            </div>
            <div class="method-body">
              <h4 class="sub-heading">Ventajas clave:</h4>
              <ul class="method-advantages">
                {item.ventajas.map(v => (
