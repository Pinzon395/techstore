    badge: 'Bloqueo de Activación',
    color: '#ef4444',
    keywords: ['solo el propietario puede desbloquear este iPhone', 'iPhone bloqueado para el propietario solución', 'iPhone pide cuenta del propietario anterior', 'compré un iPhone y tiene iCloud', 'desbloquear iPhone de segunda mano']
