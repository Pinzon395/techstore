</style>

<script>
  // Script ligero para reiniciar animación de diagnóstico en el simulador
  function initSimulator() {
    const replayBtn = document.getElementById('iar-replay-btn');
    const boardSimulator = document.getElementById('iar-board-simulator');
    if (!replayBtn || !boardSimulator) return;

    replayBtn.addEventListener('click', () => {
      boardSimulator.classList.remove('iar-sim--replay');
      void boardSimulator.offsetWidth; // Force reflow
      boardSimulator.classList.add('iar-sim--replay');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSimulator);
  } else {
    initSimulator();
  }
</script>
