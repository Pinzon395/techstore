  ═════════════════════════════════════════════════════════════════════════ -->
  <section class="iar-related-section" aria-labelledby="related-h2">
    <div class="container">
      <div class="iar-sec-head">
        <span class="iar-kicker"><i class="fa-solid fa-arrows-split-up-and-left"></i> ECOSISTEMA TÉCNICO IPHONE</span>
        <h2 id="related-h2" class="iar-h2">¿Tu falla es más sencilla o modular?</h2>
        <p class="iar-sec-desc">
          Si el problema no radica en la placa lógica, contamos con servicios especializados para cada componente modular:
        </p>
      </div>

      <div class="iar-related-grid">
        {serviciosRelacionados.map((s) => (
          <a href={s.href} class="iar-rel-card">
            <div class="iar-rel-top">
              <div class="iar-rel-icon"><i class={`fa-solid ${s.icon}`}></i></div>
              <span class="iar-rel-badge">{s.badge}</span>
            </div>
            <h3 class="iar-rel-h3">{s.title}</h3>
            <p class="iar-rel-desc">{s.desc}</p>
            <span class="iar-rel-arrow">Ver servicio <i class="fa-solid fa-arrow-right"></i></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═════════════════════════════════════════════════════════════════════════
       SECCIÓN 12 · TICKET DE SERVICIO Y DIAGNÓSTICO
  ═════════════════════════════════════════════════════════════════════════ -->
  <div id="ticket-diagnostico">
    <ServiceTicketSection
      defaultDevice="iPhone"
      defaultService="Diagnóstico / reparación avanzada"
      title="Crear ticket de diagnóstico avanzado para iPhone"
      subtitle="Describe el síntoma exacto, modelo y si tuvo contacto con líquidos o manipulación previa. Te responderemos con la ruta técnica antes de recibir tu equipo."
    />
  </div>

  <!-- ═════════════════════════════════════════════════════════════════════════
       SECCIÓN 13 · PREGUNTAS FRECUENTES (FAQ Completa)
  ═════════════════════════════════════════════════════════════════════════ -->
  <FaqSection
    id="faq-iphone-avanzado"
    title="Preguntas frecuentes — Reparación avanzada de iPhone en Cancún"
    description="Respuestas claras y honestas sobre costos de diagnóstico, microsoldadura, placa dañada y equipos mojados en Cancún."
    items={faqItems}
    backgroundColor="#071F3A"
    questionColor="#f8fafc"
    titleColor="#f8fafc"
    descriptionColor="#cfe7f6"
    faqAccent="#38bdf8"
    sectionClass="iar-faq-dark"
  />

  <!-- ═════════════════════════════════════════════════════════════════════════
       SECCIÓN 14 · OPINIONES DE CLIENTES
  ═════════════════════════════════════════════════════════════════════════ -->
  <section class="iar-comments-section">
    <CommentsSection
      title="Opiniones de clientes — Diagnóstico y reparación de iPhone"
      description="Clientes que recibieron diagnóstico técnico fundamentado y reparación real en Cancún."
      dark={false}
    />
  </section>

  <!-- ═════════════════════════════════════════════════════════════════════════
       SECCIÓN 15 · CTA FINAL DE CONVERSIÓN (Regla 131)
  ═════════════════════════════════════════════════════════════════════════ -->
  <section class="iar-final-cta" aria-labelledby="final-cta-h2">
    <div class="container">
      <div class="iar-fcta-box">
        <span class="iar-kicker iar-kicker--light"><i class="fa-solid fa-stethoscope"></i> ATENCIÓN TÉCNICA PERSONALIZADA</span>
        <h2 id="final-cta-h2" class="iar-fcta-h2">
          ¿Tu iPhone tiene una falla que no parece un simple cambio de pieza?
        </h2>
        <p class="iar-fcta-body">
          Cuéntanos qué ocurrió, si enciende y si tuvo contacto con líquido. Podemos indicarte cuál es el siguiente paso y el costo estimado de diagnóstico antes de recibirlo en taller.
        </p>

        <div class="iar-fcta-buttons">
          <a href="#ticket-diagnostico" class="iar-btn iar-btn--white">
            <i class="fa-solid fa-clipboard-check" aria-hidden="true"></i>
            <span>SOLICITAR DIAGNÓSTICO</span>
          </a>
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="iar-btn iar-btn--whatsapp-solid">
            <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
            <span>CONTAR MI FALLA POR WHATSAPP</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═════════════════════════════════════════════════════════════════════════
       SECCIÓN 16 · CONTACTO Y UBICACIÓN
  ═════════════════════════════════════════════════════════════════════════ -->
  <div class="iar-contact-shell">
    <ContactSection id="ubicacion" />
  </div>

</div>

<Footer />

<!-- ═════════════════════════════════════════════════════════════════════════
     ESTILOS CSS OPTIMIZADOS Y RIGUROSOS SEGÚN AGENTS.MD
═════════════════════════════════════════════════════════════════════════ -->
<style is:global>
/* Variables y tokens de diseño */
.iar-wrapper {
  --azul-oscuro: #071F3A;
  --azul-intermedio: #0d2d52;
  --azul-claro: #38bdf8;
  --azul-acento: #0284c7;
  --gris-fondo: #f8fafc;
  --gris-borde: #e2e8f0;
  --gris-texto: #071F3A;
  --verde-wa: #25d366;
  --verde-wa-hover: #1eb857;
  --rojo-alerta: #ef4444;
  --ambar-aviso: #f59e0b;
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  color: var(--azul-oscuro);
  background: #ffffff;
  line-height: 1.6;
  width: 100%;
  overflow-x: clip;
}

/* Todos los textos fuera del hero usan estrictamente azul oscuro según AGENTS.MD */
.iar-wrapper h2,
.iar-wrapper h3,
.iar-wrapper p,
.iar-wrapper span,
.iar-wrapper strong,
.iar-wrapper div {
  color: var(--azul-oscuro);
}

/* Excepciones de contraste estrictamente permitidas */
.iar-hero * {
  color: #ffffff !important;
}
.iar-fcta-box * {
  color: #ffffff !important;
}
.iar-faq-dark * {
  color: #f8fafc !important;
}

/* Tipografía base y Kickers */
.iar-kicker {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.8rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--azul-acento) !important;
  margin-bottom: 10px;
}
.iar-kicker--light {
  color: #7dd3fc !important;
}
.iar-h2 {
  font-family: 'Kanit', sans-serif;
  font-size: clamp(1.65rem, 3.2vw, 2.35rem);
  font-weight: 800;
  line-height: 1.2;
  margin: 0 0 12px;
  color: var(--azul-oscuro) !important;
  letter-spacing: -0.01em;
}
.iar-sec-head {
  max-width: 800px;
  margin-bottom: 36px;
}
.iar-sec-desc {
  font-size: 1.02rem;
  color: var(--azul-oscuro) !important;
  line-height: 1.7;
  margin: 0;
}

/* ── HERO TÉCNICO ──────────────────────────────────────────────────────── */
.iar-hero {
  position: relative;
  background: radial-gradient(circle at 85% 20%, rgba(2, 132, 199, 0.22), transparent 45%),
              linear-gradient(140deg, #020710 0%, #071F3A 65%, #08213f 100%);
  padding: clamp(64px, 7vw, 92px) 0 64px;
  overflow: hidden;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}
.iar-hero-ambient {
  position: absolute;
  top: -120px;
  right: -120px;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(56, 189, 248, 0.12), transparent 70%);
  pointer-events: none;
}
.iar-hero-grid {
  display: grid;
  grid-template-areas:
    "eyebrow media"
    "title   media"
    "summary media"
    "actions media"
    "trust   media";
  grid-template-columns: 1.15fr 0.85fr;
  grid-template-rows: auto auto auto auto auto;
  gap: 12px 40px;
  align-items: center;
  position: relative;
  z-index: 2;
}
.iar-hero-eyebrow-wrap { grid-area: eyebrow; }
.iar-h1                { grid-area: title; }
.iar-hero-visual       { grid-area: media; align-self: center; }
.iar-hero-summary      { grid-area: summary; }
.iar-hero-ctas         { grid-area: actions; }
.iar-hero-trust-wrap   { grid-area: trust; }
.iar-eyebrow-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  border-radius: 999px;
  background: rgba(2, 132, 199, 0.16);
  border: 1px solid rgba(56, 189, 248, 0.35);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  margin-bottom: 16px;
}
.iar-eyebrow-pill span {
  color: #7dd3fc !important;
}
.iar-pill-pulse {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #38bdf8;
  box-shadow: 0 0 8px #38bdf8;
}
.iar-h1 {
  font-family: 'Kanit', sans-serif;
  font-size: clamp(2rem, 4.4vw, 3.2rem);
  font-weight: 800;
  line-height: 1.1;
  color: #ffffff !important;
  margin: 0 0 14px;
  letter-spacing: -0.02em;
}
.iar-hero-subtitle {
  font-size: 1.12rem;
  font-weight: 700;
  color: #93c5fd !important;
  line-height: 1.45;
  margin: 0 0 14px;
}
.iar-hero-body {
  font-size: 0.98rem;
  color: rgba(255, 255, 255, 0.88) !important;
  line-height: 1.65;
  margin: 0 0 24px;
  max-width: 620px;
}

/* 4 Señales de confianza */
.iar-trust-quad {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  margin-bottom: 28px;
}
.iar-tq-item {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 10px 14px;
  border-radius: 10px;
}
.iar-tq-item i {
  color: #38bdf8 !important;
  font-size: 1rem;
}
.iar-tq-item span {
  font-size: 0.82rem;
  font-weight: 600;
  color: #f1f5f9 !important;
}

/* CTAs del Hero */
.iar-hero-ctas {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 16px;
}
.iar-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 13px 22px;
  border-radius: 10px;
  font-size: 0.92rem;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.2s ease;
  cursor: pointer;
}
.iar-btn--primary {
  background: #0284c7;
  color: #ffffff !important;
  box-shadow: 0 4px 16px rgba(2, 132, 199, 0.35);
}
.iar-btn--primary:hover {
  background: #0369a1;
  transform: translateY(-1px);
}
.iar-btn--whatsapp {
  background: var(--verde-wa);
  color: #ffffff !important;
  box-shadow: 0 4px 16px rgba(37, 211, 102, 0.3);
}
.iar-btn--whatsapp:hover {
  background: var(--verde-wa-hover);
  transform: translateY(-1px);
}
.iar-btn--outline {
  border: 1.5px solid rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.04);
  color: #ffffff !important;
}
.iar-btn--outline:hover {
  border-color: rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.1);
}
.iar-hero-microcopy {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.8rem;
  color: rgba(255, 255, 255, 0.65) !important;
  margin: 0;
}
.iar-hero-microcopy i {
  color: #38bdf8 !important;
}

/* Tarjeta del Simulador de Placa */
.iar-board-card {
  background: rgba(15, 23, 42, 0.85);
  border: 1.5px solid rgba(56, 189, 248, 0.25);
  border-radius: 20px;
  padding: 20px;
  backdrop-filter: blur(14px);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  width: 100%;
}
.iar-sim-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  margin-bottom: 14px;
}
.iar-sim-status {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.06em;
}
.iar-status-led {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #ef4444;
  box-shadow: 0 0 6px #ef4444;
  animation: ledBlink 1.6s infinite;
}
@keyframes ledBlink {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}
.iar-sim-target {
  font-size: 0.72rem;
  color: rgba(255, 255, 255, 0.6) !important;
}
.iar-sim-screen {
  position: relative;
  background: #020617;
  border: 1px solid #1e293b;
  border-radius: 12px;
  padding: 10px;
  overflow: hidden;
}
.iar-board-svg {
  width: 100%;
  height: 260px;
  display: block;
}
.iar-pcb-outline {
  fill: #091322;
  stroke: #1e3a5f;
  stroke-width: 1.5;
}
.iar-trace {
  fill: none;
  stroke: #1e40af;
  stroke-width: 1.6;
  stroke-dasharray: 4 3;
}
.iar-trace--main {
  stroke: #38bdf8;
  animation: tracePulse 2s linear infinite;
}
.iar-trace--vmain {
  stroke: url(#trace-flow);
  stroke-width: 2.2;
}
@keyframes tracePulse {
  to { stroke-dashoffset: -28; }
}
.iar-tp {
  fill: #eab308;
  stroke: #facc15;
  stroke-width: 1;
}
.iar-chip-rect {
  fill: #0f243e;
  stroke: #38bdf8;
  stroke-width: 1.2;
}
.iar-chip-label {
  font-family: 'Kanit', sans-serif;
  font-size: 8.5px;
  font-weight: 800;
  fill: #ffffff;
}
.iar-chip-sub {
  font-size: 6.5px;
  font-weight: 600;
  fill: #7dd3fc;
}
.iar-smd {
  fill: #64748b;
  stroke: #94a3b8;
  stroke-width: 0.8;
}
.iar-smd--short {
  fill: #ef4444;
  stroke: #f87171;
  stroke-width: 1.2;
  filter: drop-shadow(0 0 6px #ef4444);
}
.iar-thermal-spot {
  animation: thermalPulse 2.4s ease-in-out infinite alternate;
}
@keyframes thermalPulse {
  0% { transform: scale(0.85); opacity: 0.7; }
  100% { transform: scale(1.2); opacity: 1; }
}

/* HUD Digital */
.iar-hud-box {
  margin-top: 10px;
  background: rgba(15, 23, 42, 0.92);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 8px;
  padding: 8px 12px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.iar-hud-metric {
  display: flex;
  flex-direction: column;
}
.iar-hud-label {
  font-size: 0.65rem;
  font-weight: 700;
  color: #94a3b8 !important;
}
.iar-hud-val {
  font-family: 'Kanit', sans-serif;
  font-size: 0.85rem;
  font-weight: 800;
  color: #f8fafc !important;
}
.iar-hud-val--alert {
  color: #f87171 !important;
}
.iar-hud-status {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.72rem;
  font-weight: 700;
  color: #fca5a5 !important;
  border-top: 1px dashed rgba(255, 255, 255, 0.1);
  padding-top: 6px;
}
.iar-hud-status i {
  color: #ef4444 !important;
}

/* Pie del simulador con botón de replay */
.iar-sim-footer {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-top: 12px;
}
.iar-sim-replay-btn {
  background: rgba(56, 189, 248, 0.15);
  border: 1px solid rgba(56, 189, 248, 0.3);
  border-radius: 6px;
  padding: 6px 12px;
  font-size: 0.75rem;
  font-weight: 700;
  color: #e0f2fe !important;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  transition: all 0.2s ease;
}
.iar-sim-replay-btn:hover {
  background: rgba(56, 189, 248, 0.3);
  border-color: #38bdf8;
}
.iar-sim-replay-btn i {
  color: #38bdf8 !important;
}
.iar-sim-note {
  font-size: 0.7rem;
  color: #94a3b8 !important;
}

/* ── BANNER ORIENTADOR (< 5 SEG) ────────────────────────────────────────── */
.iar-router-bar {
  background: #f1f5f9;
  padding: 22px 0;
  border-bottom: 1px solid #e2e8f0;
}
.iar-router-grid {
  display: grid;
  grid-template-columns: 1fr 1.15fr 1fr;
  gap: 16px;
  align-items: stretch;
}
.iar-rcard {
  background: #ffffff;
  border: 1.5px solid #cbd5e1;
  border-radius: 12px;
  padding: 16px;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: all 0.2s ease;
}
.iar-rcard:hover {
  border-color: #0284c7;
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
}
.iar-rcard--active {
  background: #ffffff;
  border: 2px solid #0284c7;
  box-shadow: 0 4px 16px rgba(2, 132, 199, 0.12);
  position: relative;
}
.iar-rcard-icon {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: rgba(2, 132, 199, 0.1);
  color: #0284c7 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  margin-bottom: 10px;
}
.iar-rcard-info strong {
  display: block;
  font-size: 0.92rem;
  font-weight: 700;
  margin-bottom: 4px;
}
.iar-rcard-info p {
  font-size: 0.8rem;
  line-height: 1.45;
  margin: 0;
}
.iar-rcard-tag {
  display: inline-block;
  font-size: 0.68rem;
  font-weight: 800;
  text-transform: uppercase;
  background: #0284c7;
  color: #ffffff !important;
  padding: 2px 8px;
  border-radius: 4px;
  margin-bottom: 6px;
}
.iar-rcard-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.78rem;
  font-weight: 700;
  color: #0284c7 !important;
  margin-top: 12px;
}

/* ── POLÍTICA DE DIAGNÓSTICO ───────────────────────────────────────────── */
.iar-policy-section {
  padding: 60px 0;
  background: #ffffff;
}
.iar-policy-box {
  background: #f8fafc;
  border: 1.5px solid #e2e8f0;
  border-left: 5px solid #0284c7;
  border-radius: 16px;
  padding: 36px;
}
.iar-policy-header {
  margin-bottom: 24px;
}
.iar-policy-lead {
  font-size: 1.15rem;
  font-weight: 600;
  line-height: 1.6;
  margin-bottom: 12px;
}
.iar-policy-sub {
  font-size: 0.95rem;
  line-height: 1.65;
  margin-bottom: 28px;
}
.iar-policy-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  border-top: 1px solid #e2e8f0;
  padding-top: 24px;
}
.iar-pitem {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}
.iar-pitem-check {
  color: #10b981 !important;
  font-size: 1.2rem;
  margin-top: 2px;
  flex-shrink: 0;
}
.iar-pitem strong {
  display: block;
  font-size: 0.92rem;
  margin-bottom: 2px;
}
.iar-pitem p {
  font-size: 0.82rem;
  line-height: 1.45;
  margin: 0;
}

/* ── SÍNTOMAS ──────────────────────────────────────────────────────────── */
.iar-symptoms-section {
  padding: 64px 0;
  background: #f8fafc;
}
.iar-symptoms-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 32px;
}
.iar-scard {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  padding: 22px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: all 0.2s ease;
}
.iar-scard:hover {
  transform: translateY(-2px);
  border-color: #0284c7;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
}
.iar-scard--urgent {
  border-top: 4px solid #ef4444;
}
.iar-scard-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}
.iar-scard-badge {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  color: #64748b !important;
  letter-spacing: 0.04em;
}
.iar-scard--urgent .iar-scard-badge {
  color: #dc2626 !important;
}
.iar-scard-icon {
  width: 38px;
  height: 38px;
  border-radius: 9px;
  background: rgba(2, 132, 199, 0.1);
  color: #0284c7 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
}
.iar-scard--urgent .iar-scard-icon {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444 !important;
