<div class="iar-wrapper" id="iphone-advanced-repair-page">

  <!-- ═════════════════════════════════════════════════════════════════════════
       SECCIÓN 1 · HERO TÉCNICO INTERACTIVO (Único H1)
  ═════════════════════════════════════════════════════════════════════════ -->
  <section class="iar-hero" id="hero" aria-labelledby="hero-h1">
    <div class="iar-hero-ambient" aria-hidden="true"></div>
    <div class="container iar-hero-grid">

      <div class="iar-hero-eyebrow-wrap">
        <div class="iar-eyebrow-pill">
          <span class="iar-pill-pulse"></span>
          <span>REPARACIÓN AVANZADA · IPHONE · CANCÚN</span>
        </div>
      </div>

      <h1 id="hero-h1" class="iar-h1">
        Reparación de iPhone en Cancún
      </h1>

      <!-- Columna Visual: Simulación Técnica de Diagnóstico Electrónico -->
      <div class="iar-hero-visual">
        <div class="iar-board-card" id="iar-board-simulator">
          <!-- Cabecera de telemetría de laboratorio -->
          <div class="iar-sim-header">
            <div class="iar-sim-status">
              <span class="iar-status-led"></span>
              <span>BANCO DE PRUEBAS · DIAGNÓSTICO DC</span>
            </div>
            <span class="iar-sim-target">Apple iPhone Logic Board</span>
          </div>

          <!-- Representación de la Placa Lógica y Medición -->
          <div class="iar-sim-screen">
            <svg class="iar-board-svg" viewBox="0 0 340 400" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
              <defs>
                <!-- Gradiente de calor térmico para hotspot de corto -->
                <radialGradient id="thermal-glow" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#ef4444" stop-opacity="0.9" />
                  <stop offset="40%" stop-color="#f97316" stop-opacity="0.6" />
                  <stop offset="75%" stop-color="#eab308" stop-opacity="0.25" />
                  <stop offset="100%" stop-color="#38bdf8" stop-opacity="0" />
                </radialGradient>
                <linearGradient id="trace-flow" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#38bdf8" />
                  <stop offset="50%" stop-color="#ef4444" />
                  <stop offset="100%" stop-color="#f97316" />
                </linearGradient>
              </defs>

              <!-- Silueta esquemática de placa iPhone (Forma en L) -->
              <path class="iar-pcb-outline" d="M 40,30 L 300,30 L 300,160 L 220,160 L 220,370 L 40,370 Z" />

              <!-- Pistas de cobre y buses de alimentación -->
              <path class="iar-trace iar-trace--main" d="M 60,60 L 140,60 L 140,110 L 240,110" />
              <path class="iar-trace iar-trace--vmain" d="M 140,110 L 140,240 L 180,240" />
              <path class="iar-trace iar-trace--sub1" d="M 70,160 L 140,160" />
              <path class="iar-trace iar-trace--sub2" d="M 80,290 L 170,290 L 170,240" />
              <path class="iar-trace iar-trace--sub3" d="M 170,330 L 170,300" />

              <!-- Puntos de prueba / Test Points (TP) -->
              <circle cx="60" cy="60" r="3.5" class="iar-tp" />
              <circle cx="240" cy="110" r="3.5" class="iar-tp" />
              <circle cx="140" cy="180" r="3.5" class="iar-tp" />
              <circle cx="80" cy="290" r="3.5" class="iar-tp" />

              <!-- Microchips principales estilizados -->
              <!-- SoC / CPU A-Series Bionic -->
              <g class="iar-chip-group iar-chip--cpu" transform="translate(60, 80)">
                <rect width="64" height="64" rx="6" class="iar-chip-rect" />
                <text x="32" y="34" class="iar-chip-label" text-anchor="middle">A-BIONIC</text>
                <text x="32" y="47" class="iar-chip-sub" text-anchor="middle">CPU / GPU</text>
              </g>

              <!-- PMIC (Gestión de Energía) -->
              <g class="iar-chip-group iar-chip--pmic" transform="translate(150, 60)">
                <rect width="48" height="38" rx="4" class="iar-chip-rect" />
                <text x="24" y="22" class="iar-chip-label" text-anchor="middle">PMIC</text>
                <text x="24" y="31" class="iar-chip-sub" text-anchor="middle">POWER</text>
              </g>

              <!-- NAND Flash Memory -->
              <g class="iar-chip-group iar-chip--nand" transform="translate(60, 180)">
                <rect width="56" height="74" rx="5" class="iar-chip-rect" />
                <text x="28" y="40" class="iar-chip-label" text-anchor="middle">NAND</text>
                <text x="28" y="52" class="iar-chip-sub" text-anchor="middle">NVMe</text>
              </g>

              <!-- IC de Carga (Tristar / Hydra) -->
              <g class="iar-chip-group iar-chip--charge" transform="translate(60, 290)">
                <rect width="44" height="34" rx="4" class="iar-chip-rect" />
                <text x="22" y="20" class="iar-chip-label" text-anchor="middle">HYDRA</text>
                <text x="22" y="28" class="iar-chip-sub" text-anchor="middle">CHARGER</text>
              </g>

              <!-- Componentes SMD pasivos (Resistencias y Condensadores) -->
              <rect x="135" y="235" width="10" height="6" rx="1.5" class="iar-smd" />
              <rect x="150" y="235" width="10" height="6" rx="1.5" class="iar-smd" />
              <rect x="165" y="235" width="12" height="7" rx="2" class="iar-smd iar-smd--short" />

              <!-- Hotspot térmico infrarrojo sobre el componente en corto -->
              <circle cx="171" cy="238" r="28" fill="url(#thermal-glow)" class="iar-thermal-spot" />

              <!-- Agujas de prueba / Probes del multímetro de precisión -->
              <g class="iar-probe iar-probe--pos" transform="translate(162, 210)">
                <path d="M 0,0 L 8,26" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" />
                <circle cx="8" cy="26" r="2" fill="#ffffff" />
              </g>
              <g class="iar-probe iar-probe--neg" transform="translate(182, 210)">
                <path d="M 0,0 L -8,26" stroke="#000000" stroke-width="2.2" stroke-linecap="round" />
                <circle cx="-8" cy="26" r="2" fill="#ffffff" />
              </g>
            </svg>

            <!-- Medidor Digital HUD Flotante -->
            <div class="iar-hud-box">
              <div class="iar-hud-metric">
                <span class="iar-hud-label">LÍNEA MONITOREADA</span>
                <strong class="iar-hud-val">VDD_MAIN / PP_BATT</strong>
              </div>
              <div class="iar-hud-metric">
                <span class="iar-hud-label">CONSUMO FUENTE</span>
                <strong class="iar-hud-val iar-hud-val--alert">1.85 A (ANORMAL)</strong>
              </div>
              <div class="iar-hud-status">
                <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                <span>Cortocircuito a tierra localizado</span>
              </div>
            </div>
          </div>

          <!-- Pie del simulador con botón de replay interactivo -->
          <div class="iar-sim-footer">
            <button type="button" class="iar-sim-replay-btn" id="iar-replay-btn" aria-label="Reiniciar simulación de diagnóstico">
              <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
              <span>Simular diagnóstico electrónico</span>
            </button>
            <span class="iar-sim-note">Detección por infrarrojo y consumo</span>
          </div>
        </div>
      </div>

      <!-- Columna de Contenido Secundario, CTAs & Confianza -->
      <div class="iar-hero-summary iar-hero-text">
        <p class="iar-hero-subtitle">
          Fallas de placa, cortos, daño por líquido y microsoldadura.
        </p>

        <p class="iar-hero-body">
          Si tu iPhone no enciende, se mojó, huele a quemado, se calienta o presenta una falla electrónica, revisamos alimentación, cortos, corrosión y placa antes de recomendar una reparación.
        </p>
      </div>

      <!-- Grupo de 3 CTAs principales (Regla 7) -->
      <div class="iar-hero-ctas">
        <a href="#ticket-diagnostico" class="iar-btn iar-btn--primary">
