---
// IphoneBatteryReplacementView.astro - Cambio de batería iPhone en Cancún
const { service, category } = Astro.props;

import FaqSection from '../FaqSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';
import Footer from '../Footer.astro';

const waMsg = encodeURIComponent('Hola, quiero cotizar cambio de batería iPhone en Cancún. Puedo enviar modelo, salud de batería y síntomas.');

const heroChecks = [
  'Salud de batería y ciclos',
  'Prueba de carga real',
  'Revision de consumo',
  'Garantia por escrito',
];

const symptoms = [
  { icon: 'fa-battery-quarter', title: 'Dura muy poco', text: 'Baja rapido aun con uso normal o pierde porcentaje durante la noche.' },
  { icon: 'fa-power-off', title: 'Se apaga de golpe', text: 'El iPhone se apaga con batería disponible, al abrir cámara o al usar apps pesadas.' },
  { icon: 'fa-plug-circle-xmark', title: 'Carga inestable', text: 'Conecta y desconecta, tarda demasiado o el porcentaje no sube de forma normal.' },
  { icon: 'fa-temperature-half', title: 'Se calienta', text: 'Sube mucho la temperatura al cargar, jugar, grabar video o usar datos moviles.' },
  { icon: 'fa-triangle-exclamation', title: 'Bateria inflada', text: 'La pantalla se levanta, el marco abre o se siente presion interna.' },
  { icon: 'fa-gauge-high', title: 'Rendimiento limitado', text: 'iOS muestra aviso de servicio, salud baja o reduccion de rendimiento.' },
  { icon: 'fa-mobile-screen', title: 'Porcentaje brinca', text: 'Marca 30%, baja a 10% o se apaga sin una descarga progresiva.' },
  { icon: 'fa-clock-rotate-left', title: 'Ya no aguanta el día', text: 'Necesitas cargar varias veces aunque antes te duraba mucho más.' },
];

const diagnosticChecks = [
  ['01', 'Salud en iOS', 'Revisamos porcentaje, avisos del sistema y comportamiento de descarga.'],
  ['02', 'Carga y cable', 'Probamos puerto, cable, cargador y estabilidad de amperaje antes de abrir.'],
  ['03', 'Consumo interno', 'Si hay drenaje anormal, calentamiento o reinicios, se revisa antes de vender batería.'],
  ['04', 'Estado físico', 'Validamos frame, pantalla levantada, humedad y presión interna por batería inflada.'],
];

const models = [
  'iPhone 16 Pro Max', 'iPhone 16 Pro', 'iPhone 16 Plus', 'iPhone 16',
  'iPhone 15 Pro Max', 'iPhone 15 Pro', 'iPhone 15 Plus', 'iPhone 15',
  'iPhone 14 Pro Max', 'iPhone 14 Pro', 'iPhone 14 Plus', 'iPhone 14',
  'iPhone 13 Pro Max', 'iPhone 13 Pro', 'iPhone 13 Mini', 'iPhone 13',
  'iPhone 12 Pro Max', 'iPhone 12 Pro', 'iPhone 12 Mini', 'iPhone 12',
  'iPhone 11 Pro Max', 'iPhone 11 Pro', 'iPhone 11', 'iPhone XR', 'iPhone XS',
];

const quality = [
  {
    title: 'Bateria compatible premium',
    badge: 'Equilibrada',
    text: 'Opción recomendada para recuperar autonomía estable con buen costo y garantía por escrito.',
    points: ['Uso diario', 'Carga estable', 'Buen balance precio/calidad'],
  },
  {
    title: 'Bateria de alta capacidad',
    badge: 'Segun modelo',
    text: 'Disponible solo en modelos compatibles. Se confirma antes de cotizar para evitar piezas incorrectas.',
    points: ['Más autonomía', 'Disponibilidad variable', 'Validación por modelo'],
  },
  {
    title: 'Diagnostico sin cambio',
    badge: 'Cuando aplica',
    text: 'Si la falla viene del centro de carga, humedad o consumo en placa, te lo decimos antes de instalar.',
    points: ['Evita gastos inutiles', 'Revision de carga', 'Ruta tecnica clara'],
  },
];

const process = [
  { n: '01', title: 'Recepción y síntomas', text: 'Confirmamos modelo, salud de batería, apagados, carga lenta, calentamiento y estado físico.' },
  { n: '02', title: 'Prueba de carga', text: 'Revisamos cable, cargador, puerto, porcentaje, temperatura y comportamiento de consumo.' },
  { n: '03', title: 'Cotización clara', text: 'Te decimos si conviene batería, revisión de carga o diagnóstico adicional antes de avanzar.' },
  { n: '04', title: 'Instalación controlada', text: 'Abrimos con herramienta adecuada, cuidamos flex, retiramos adhesivo viejo y colocamos pieza compatible.' },
  { n: '05', title: 'Sellado y armado', text: 'Colocamos adhesivo nuevo cuando aplica y revisamos que no exista presión interna.' },
  { n: '06', title: 'Pruebas finales', text: 'Validamos encendido, carga, audio, cámaras, temperatura y estabilidad antes de avisarte.' },
];

const safetyItems = [
  { icon: 'fa-ban', title: 'No sigas cargando una batería inflada', text: 'Puede presionar pantalla, frame o componentes internos. Conviene revisarla cuanto antes.' },
  { icon: 'fa-droplet', title: 'Humedad cambia el diagnóstico', text: 'Si hubo líquido, primero revisamos conectores y consumo antes de instalar batería nueva.' },
  { icon: 'fa-plug', title: 'No siempre es batería', text: 'Un puerto sucio, flex de carga o consumo interno puede parecer batería defectuosa.' },
];

const aftercare = [
  'Primeras cargas sin calor excesivo',
  'No usar cargadores dañados',
  'Evitar cargarlo bajo el sol',
  'Revisar si el porcentaje baja normal',
  'Volver si aparece calentamiento raro',
];

const faqItems = [
  { question: '¿Cuánto cuesta cambiar la batería de un iPhone en Cancún?', answer: 'El costo depende del modelo exacto, disponibilidad de batería y estado del equipo. Para cotizar mejor pedimos modelo, porcentaje de salud de batería y síntomas como apagados, calentamiento o carga lenta.' },
  { question: '¿Cuánto tarda el cambio de batería iPhone?', answer: 'En muchos modelos puede realizarse el mismo día, siempre que la batería esté disponible y no exista daño adicional en puerto de carga, frame, humedad o consumo interno.' },
  { question: '¿Conviene cambiarla si la salud está debajo de 80%?', answer: 'Generalmente conviene revisarla cuando la salud baja de 80%, si se apaga, dura poco o iOS muestra aviso de servicio. Aun así confirmamos consumo y carga antes de instalar.' },
  { question: '¿Qué pasa si la batería está inflada?', answer: 'Debe atenderse cuanto antes. No recomendamos seguir cargando el iPhone porque puede presionar pantalla, frame o componentes internos. Primero revisamos seguridad y estado físico.' },
  { question: '¿También revisan si el problema es el centro de carga?', answer: 'Sí. Antes de cambiar batería revisamos puerto, cable, cargador y comportamiento de carga. Si la falla viene del centro de carga o consumo interno, te lo explicamos antes de avanzar.' },
  { question: '¿La reparación tiene garantía?', answer: 'Sí, entregamos garantía por escrito sobre la batería instalada y mano de obra. No cubre golpes, humedad posterior, manipulación externa o fallas no relacionadas con la batería.' },
];
---

<div class="ib-wrapper">
  <section class="ib-hero">
    <div class="container ib-hero-grid">
      <div class="ib-hero-copy">
        <span class="ib-eyebrow"><i class="fa-brands fa-apple"></i> Servicio técnico iPhone Cancún</span>
        <h1>Cambio de batería iPhone en Cancún</h1>
        <p class="ib-sub">Diagnóstico de carga, consumo y autonomía antes de instalar batería nueva.</p>
        <p class="ib-copy">Si tu iPhone dura poco, se apaga, se calienta o carga lento, revisamos primero si la falla viene de batería, puerto de carga, humedad o consumo interno.</p>

        <div class="ib-chips" aria-label="Detalles del servicio">
          <span>iPhone 11 al 16</span>
          <span>Revision antes de cotizar</span>
          <span>Bateria inflada</span>
          <span>Garantia por escrito</span>
        </div>

        <div class="ib-actions">
          <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="ib-btn ib-btn-wa">
            <i class="fa-brands fa-whatsapp"></i> Cotizar por WhatsApp
          </a>
          <a href="#proceso" class="ib-btn ib-btn-outline">Ver proceso <i class="fa-solid fa-arrow-down"></i></a>
        </div>
        <small>Envía modelo, salud de batería y captura del aviso de iOS si aparece.</small>
      </div>

      <aside class="ib-hero-card" aria-label="Revisión de batería iPhone">
        <div class="ib-health-panel">
          <div class="ib-battery-icon" aria-hidden="true">
            <span></span>
            <i style="width:74%"></i>
          </div>
          <div>
            <span>Salud estimada</span>
            <strong>74%</strong>
            <em>Revision recomendada</em>
          </div>
        </div>
        <ul>
          {heroChecks.map((item) => <li><i class="fa-solid fa-circle-check"></i>{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="ib-section ib-light">
    <div class="container">
      <div class="ib-head">
        <span class="ib-eyebrow">Diagnóstico</span>
        <h2>Señales de batería degradada en iPhone</h2>
        <p>No todo apagado es batería. Esta revisión ayuda a decidir si conviene cambio de batería iPhone Cancún, limpieza de puerto, revisión de carga o diagnóstico interno.</p>
      </div>
      <div class="ib-symptom-grid">
        {symptoms.map((item) => (
          <article class="ib-card">
            <i class={`fa-solid ${item.icon}`}></i>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ib-section ib-panel-section">
    <div class="container ib-diagnostic-grid">
      <div class="ib-diagnostic-copy">
        <span class="ib-eyebrow">Prueba antes de cambiar</span>
        <h2>No instalamos batería sin revisar carga y consumo</h2>
        <p>La salud de batería en iOS ayuda, pero no cuenta toda la historia. Medimos comportamiento de carga, temperatura, apagados y consumo para evitar cambios que no resuelven la falla.</p>
        <div class="ib-metrics">
          <div><strong>80%</strong><span>punto común de revisión</span></div>
          <div><strong>1 día</strong><span>si hay pieza disponible</span></div>
          <div><strong>6</strong><span>pruebas antes de entregar</span></div>
        </div>
      </div>
      <div class="ib-check-list">
        {diagnosticChecks.map(([n, title, text]) => (
          <article>
            <span>{n}</span>
            <div>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ib-section ib-light ib-models">
    <div class="container">
      <div class="ib-head">
        <span class="ib-eyebrow">Compatibilidad</span>
        <h2>Batería iPhone 11, 12, 13, 14, 15 y 16 en Cancún</h2>
        <p>Atendemos cambio de batería iPhone Cancún por modelo exacto. Si tienes un modelo anterior, revisamos disponibilidad antes de cotizar.</p>
      </div>
      <div class="ib-model-grid">
        {models.map((model) => <span><i class="fa-brands fa-apple"></i>{model}</span>)}
      </div>
    </div>
  </section>

  <section class="ib-section ib-dark-alt">
    <div class="container">
      <div class="ib-head">
        <span class="ib-eyebrow">Opciones reales</span>
        <h2>Qué batería se usa en la reparación</h2>
        <p>Confirmamos compatibilidad y disponibilidad por modelo. La prioridad es autonomía estable, carga segura y garantía clara.</p>
      </div>
      <div class="ib-quality-grid">
        {quality.map((item) => (
          <article class="ib-quality">
            <span>{item.badge}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <ul>
              {item.points.map((point) => <li><i class="fa-solid fa-check"></i>{point}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ib-section ib-process" id="proceso">
    <div class="container">
      <div class="ib-head">
        <span class="ib-eyebrow">Proceso técnico</span>
        <h2>Proceso de cambio de batería de iPhone en Cancún</h2>
        <p>Trabajamos con revisión previa, instalación cuidada, adhesivo nuevo cuando aplica y pruebas reales de carga antes de entregar.</p>
      </div>
      <div class="ib-timeline">
        {process.map((step) => (
          <article>
            <span>{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ib-section ib-dark-alt">
    <div class="container ib-safety-grid">
      <div>
        <span class="ib-eyebrow">Seguridad</span>
        <h2>Batería inflada, calentamiento o carga rara: primero revisión</h2>
        <p>Una batería inflada o un consumo interno no se debe tratar como cambio rápido sin pruebas. Revisamos el equipo para evitar presión en pantalla, daño por humedad o falla de carga repetida.</p>
      </div>
      <div class="ib-safety-cards">
        {safetyItems.map((item) => (
          <article>
            <i class={`fa-solid ${item.icon}`}></i>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ServiceTicketSection
    defaultDevice="iPhone"
    defaultService="Cambio de batería"
    title="Crear ticket de batería iPhone"
    subtitle="Cuéntanos modelo, salud de batería y síntomas. Te contactaremos para confirmar disponibilidad y cotización."
  />

  <section class="ib-section ib-aftercare">
    <div class="container ib-aftercare-grid">
      <div>
        <span class="ib-eyebrow">Despues del servicio</span>
        <h2>No entregamos sin probar carga y autonomía</h2>
        <p>Validamos que el iPhone encienda, cargue estable, no se caliente de forma anormal y mantenga consumo correcto antes de avisarte por WhatsApp.</p>
      </div>
      <ul>
        {aftercare.map((item) => <li><i class="fa-solid fa-circle-check"></i>{item}</li>)}
      </ul>
      <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="ib-btn ib-btn-wa">
        Agendar revisión
      </a>
    </div>
  </section>

  <section class="ib-related-shell">
    <RelatedServicesSection
      category={category}
      service={service}
      eyebrow="Servicios relacionados"
      title="Otros servicios de iPhone que podrías necesitar"
      compact={true}
      includeCategoryServices={true}
      initialLimit={4}
    />
  </section>

  <FaqSection
    id="faq-bateria-iphone"
    title="Preguntas frecuentes sobre cambio de batería iPhone en Cancún"
    description="Resolvemos dudas sobre precio, salud de batería, tiempos, carga, batería inflada y garantía."
    items={faqItems}
    backgroundColor="#0B1120"
    questionColor="#f8fafc"
    titleColor="#f8fafc"
    descriptionColor="#cfe7f6"
    faqAccent="#3b82f6"
    sectionClass="ib-faq-dark"
  />

  <section class="ib-comments">
    <CommentsSection
      title="Clientes que repararon su iPhone en Pixon PC"
      description="Opiniones de clientes en Cancún que trajeron iPhone con batería degradada, carga inestable o apagados repentinos."
      dark={true}
    />
  </section>

  <section class="ib-contact-shell">
    <ContactSection id="ubicacion" />
  </section>
</div>

<Footer />

<style is:global>
.ib-wrapper {
  --ib-dark: #0B1120;
  --ib-dark-2: #0f172a;
  --ib-dark-3: #111c33;
  --ib-line: rgba(147,197,253,.18);
  --ib-card: rgba(248,250,252,.055);
  --ib-card-strong: rgba(248,250,252,.085);
  --ib-blue: #3b82f6;
  --ib-cyan: #93c5fd;
  --ib-soft: #cfe7f6;
  --ib-white: #f8fafc;
  --ib-muted: #a9bdd6;
  --ib-green: #22c55e;
  background: var(--ib-dark);
  color: var(--ib-white);
  font-family: 'Inter', 'Kanit', sans-serif;
  overflow-x: hidden;
}
.ib-wrapper h1,
.ib-wrapper h2,
.ib-wrapper h3 {
  font-family: 'Kanit', sans-serif;
  line-height: 1.12;
  letter-spacing: 0;
}
.ib-hero {
  padding: 48px 0 42px;
  background:
    radial-gradient(circle at 86% 12%, rgba(59,130,246,.24), transparent 32%),
    linear-gradient(135deg, #050d1f, #0B1120 58%, #0f172a);
}
.ib-hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.12fr) minmax(280px, .68fr);
  gap: 32px;
  align-items: center;
}
.ib-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--ib-cyan);
  font-size: .76rem;
  font-weight: 850;
  text-transform: uppercase;
  letter-spacing: .08em;
  margin-bottom: 10px;
}
.ib-hero h1 {
  max-width: 780px;
  margin: 0 0 10px;
  color: var(--ib-white);
  font-size: clamp(2rem, 4vw, 3.05rem);
}
.ib-sub {
  margin: 0 0 10px;
  max-width: 650px;
  color: #dbeafe;
  font-size: clamp(1rem, 1.8vw, 1.14rem);
  line-height: 1.45;
}
.ib-copy {
  max-width: 680px;
  margin: 0 0 16px;
  color: var(--ib-soft);
  line-height: 1.58;
  font-size: .98rem;
}
.ib-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 0 0 18px;
}
.ib-chips span,
.ib-model-grid span {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  border: 1px solid var(--ib-line);
  background: rgba(248,250,252,.06);
  color: #dbeafe;
  border-radius: 999px;
  padding: 8px 12px;
  font-size: .78rem;
  font-weight: 750;
}
.ib-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 8px;
}
.ib-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  padding: 12px 16px;
  border-radius: 12px;
  text-decoration: none;
  font-weight: 850;
  font-size: .9rem;
  border: 1px solid transparent;
}
.ib-btn-wa {
  background: #16a34a;
  color: var(--ib-white);
  box-shadow: 0 14px 34px rgba(22,163,74,.22);
}
.ib-btn-outline {
  border-color: rgba(147,197,253,.28);
  color: #dbeafe;
  background: rgba(248,250,252,.06);
}
.ib-hero small {
  color: var(--ib-muted);
  display: block;
}
.ib-hero-card {
  background: linear-gradient(180deg, rgba(248,250,252,.1), rgba(248,250,252,.045));
  border: 1px solid var(--ib-line);
  border-radius: 20px;
  padding: 18px;
  box-shadow: 0 24px 54px rgba(2,6,23,.34);
}
.ib-health-panel {
  display: grid;
  grid-template-columns: 112px 1fr;
  gap: 16px;
  align-items: center;
  padding: 14px;
  border-radius: 16px;
  background: rgba(2,6,23,.28);
  border: 1px solid rgba(147,197,253,.14);
  margin-bottom: 14px;
}
.ib-battery-icon {
  position: relative;
  height: 58px;
  border: 3px solid #dbeafe;
  border-radius: 14px;
  padding: 6px;
}
.ib-battery-icon span {
  position: absolute;
  right: -9px;
  top: 18px;
  width: 6px;
  height: 22px;
  border-radius: 0 4px 4px 0;
  background: #dbeafe;
}
.ib-battery-icon i {
  display: block;
  height: 100%;
  border-radius: 9px;
  background: linear-gradient(90deg, #f59e0b, #22c55e);
}
.ib-health-panel span,
.ib-health-panel em {
  display: block;
  color: #bfdbfe;
  font-size: .76rem;
  font-style: normal;
}
.ib-health-panel strong {
  display: block;
  color: var(--ib-white);
  font-size: 2.1rem;
  line-height: 1;
  margin: 4px 0;
}
.ib-hero-card ul,
.ib-quality ul,
.ib-aftercare ul {
  list-style: none;
  padding: 0;
  margin: 0;
}
.ib-hero-card ul {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9px;
}
.ib-hero-card li,
.ib-quality li,
.ib-aftercare li {
  color: #dbeafe;
  font-size: .82rem;
  display: flex;
  gap: 8px;
  align-items: center;
}
.ib-hero-card li i,
.ib-quality li i,
.ib-aftercare li i {
  color: #86efac;
}
.ib-section {
  padding: 62px 0;
}
.ib-dark {
  background: var(--ib-dark);
}
.ib-light,
.ib-process {
  background: #f8fafc;
  color: #0f2a4a;
}
.ib-dark-alt,
.ib-panel-section,
.ib-aftercare {
  background: linear-gradient(180deg, #0f172a, #0B1120);
}
.ib-head {
  max-width: 860px;
  margin-bottom: 30px;
}
.ib-head h2,
.ib-diagnostic-copy h2,
.ib-safety-grid h2,
.ib-aftercare h2 {
  color: var(--ib-white);
  margin: 0 0 10px;
  font-size: clamp(1.65rem, 3vw, 2.35rem);
}
.ib-head p,
.ib-diagnostic-copy p,
.ib-safety-grid p,
.ib-aftercare p {
  color: var(--ib-soft);
  line-height: 1.65;
  margin: 0;
}
.ib-light .ib-eyebrow,
.ib-process .ib-eyebrow {
  color: #2563eb;
}
.ib-light .ib-head h2,
.ib-light .ib-card h3,
.ib-process .ib-head h2,
.ib-process .ib-timeline h3 {
  color: #0f2a4a;
}
.ib-light .ib-head p,
.ib-light .ib-card p,
.ib-process .ib-head p,
.ib-process .ib-timeline p {
  color: #475569;
}
.ib-light .ib-card,
.ib-process .ib-timeline article {
  background: #ffffff;
  border-color: rgba(15,42,74,.12);
  box-shadow: 0 14px 32px rgba(15,42,74,.07);
}
.ib-light .ib-card i {
  background: #eaf3ff;
  color: #2563eb;
}
.ib-light .ib-model-grid span {
  background: #ffffff;
  border-color: rgba(15,42,74,.12);
  color: #0f2a4a;
}
.ib-process .ib-timeline article > span {
  background: #eaf3ff;
  color: #2563eb;
}
.ib-symptom-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}
.ib-card,
.ib-quality,
.ib-timeline article,
.ib-check-list article,
.ib-safety-cards article {
