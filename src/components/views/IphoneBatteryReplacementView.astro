---
// IphoneBatteryReplacementView.astro - Cambio de batería iPhone en Cancún
const { service, category } = Astro.props;

import FaqSection from '../FaqSection.astro';
import CommentsSection from '../CommentsSection.astro';
import ContactSection from '../ContactSection.astro';
import ServiceTicketSection from '../ServiceTicketSection.astro';
import RelatedServicesSection from '../RelatedServicesSection.astro';

const waMsg = encodeURIComponent('Hola, quiero cotizar cambio de batería iPhone en Cancún. Puedo enviar modelo, salud de batería y síntomas.');

const symptoms = [
  { icon: 'fa-battery-quarter', title: 'La batería dura muy poco', text: 'Baja rápido aunque el uso sea normal o marca porcentajes raros.' },
  { icon: 'fa-power-off', title: 'Se apaga de golpe', text: 'El iPhone se apaga con bateria disponible o al abrir apps pesadas.' },
  { icon: 'fa-plug-circle-xmark', title: 'Carga intermitente', text: 'Conecta y desconecta, carga lento o no sube porcentaje correctamente.' },
  { icon: 'fa-temperature-half', title: 'Se calienta al cargar', text: 'Aumenta la temperatura más de lo normal durante carga o uso diario.' },
  { icon: 'fa-triangle-exclamation', title: 'Batería inflada', text: 'Pantalla levantada, marco abierto o presión interna visible.' },
  { icon: 'fa-gauge-high', title: 'Rendimiento limitado', text: 'iOS reduce rendimiento por salud baja o consumo inestable.' },
];

const checks = [
  'Salud de batería en iOS',
  'Ciclos y consumo real',
  'Puerto y cable de carga',
  'Temperatura durante carga',
  'Frame y presion interna',
  'Prueba después de instalar',
];

const models = [
  'iPhone 16 Pro Max', 'iPhone 16 Pro', 'iPhone 16 Plus', 'iPhone 16',
  'iPhone 15 Pro Max', 'iPhone 15 Pro', 'iPhone 15 Plus', 'iPhone 15',
  'iPhone 14 Pro Max', 'iPhone 14 Pro', 'iPhone 14 Plus', 'iPhone 14',
  'iPhone 13 Pro Max', 'iPhone 13 Pro', 'iPhone 13 Mini', 'iPhone 13',
  'iPhone 12 Pro Max', 'iPhone 12 Pro', 'iPhone 12 Mini', 'iPhone 12',
  'iPhone 11 Pro Max', 'iPhone 11 Pro', 'iPhone 11', 'iPhone XR', 'iPhone XS',
];

const process = [
  { n: '01', title: 'Revisión inicial', text: 'Confirmamos modelo, salud de batería, síntomas, estado físico y si existe batería inflada.' },
  { n: '02', title: 'Prueba de carga', text: 'Probamos cable, cargador, puerto, consumo y comportamiento de porcentaje antes de abrir.' },
  { n: '03', title: 'Cotización clara', text: 'Te explicamos disponibilidad, tiempo, garantía y precio final según modelo.' },
  { n: '04', title: 'Instalación cuidada', text: 'Abrimos con herramienta adecuada, retiramos adhesivo viejo y colocamos batería compatible.' },
  { n: '05', title: 'Sellado y armado', text: 'Cerramos con adhesivo nuevo cuando aplica y revisamos que no exista presion interna.' },
  { n: '06', title: 'Pruebas finales', text: 'Validamos carga, encendido, consumo, temperatura, camaras, audio y uso real antes de entregar.' },
];

const quality = [
  { title: 'Batería compatible premium', badge: 'Uso diario', text: 'Buena opción para recuperar autonomía con costo equilibrado y garantía por escrito.' },
  { title: 'Batería de alta capacidad', badge: 'Más autonomía', text: 'Disponible en modelos compatibles. Se confirma antes de cotizar para evitar piezas incorrectas.' },
  { title: 'Diagnóstico antes de pieza', badge: 'Sin suponer', text: 'Si la falla viene de carga, consumo en placa o humedad, te lo decimos antes de cambiar batería.' },
];

const faqItems = [
  { question: '¿Cuánto cuesta cambiar la batería de un iPhone en Cancún?', answer: 'El costo depende del modelo exacto, disponibilidad de batería y estado del equipo. Para cotizar mejor pedimos modelo, porcentaje de salud de batería y síntomas como apagados, calentamiento o carga lenta.' },
  { question: '¿Cuánto tarda el cambio de batería iPhone?', answer: 'En muchos modelos puede realizarse el mismo día, siempre que la batería esté disponible y no exista daño adicional en puerto de carga, frame, humedad o consumo interno.' },
  { question: '¿Conviene cambiarla si la salud está debajo de 80%?', answer: 'Generalmente sí conviene revisarla cuando la salud baja de 80%, si se apaga, dura poco o iOS muestra aviso de servicio. Aun así confirmamos consumo y carga antes de instalar.' },
  { question: '¿Qué pasa si la batería está inflada?', answer: 'Debe atenderse cuanto antes. No recomendamos seguir cargando el iPhone porque puede presionar pantalla, frame o componentes internos. Primero revisamos seguridad y estado físico.' },
  { question: '¿La reparación tiene garantía?', answer: 'Sí, entregamos garantía por escrito sobre la batería instalada y mano de obra. No cubre golpes, humedad posterior, manipulación externa o fallas no relacionadas con la batería.' },
  { question: '¿También revisan si el problema es el centro de carga?', answer: 'Sí. Antes de cambiar batería revisamos puerto, cable, cargador y comportamiento de carga. Si la falla viene del centro de carga o consumo interno, te lo explicamos antes de avanzar.' },
];
---

<div class="ib-wrapper">
  <section class="ib-hero">
    <div class="container ib-hero-grid">
      <div>
        <span class="ib-eyebrow"><i class="fa-brands fa-apple"></i> Servicio técnico de iPhone en Cancún</span>
        <h1>Cambio de batería iPhone en Cancún</h1>
        <p class="ib-sub">Recupera autonomía con diagnóstico de carga, consumo y garantía por escrito.</p>
        <p class="ib-copy">Si tu iPhone se apaga, dura poco, se calienta, carga lento o marca batería degradada, primero revisamos la causa real antes de instalar una batería nueva.</p>
        <div class="ib-chips">
          <span>Salud y ciclos</span>
          <span>Carga y consumo</span>
          <span>Batería inflada</span>
          <span>iPhone 11 al 16</span>
          <span>Servicio local Cancún</span>
        </div>
        <div class="ib-actions">
          <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="ib-btn ib-btn-wa"><i class="fa-brands fa-whatsapp"></i> Cotizar batería por WhatsApp</a>
          <a href="#proceso" class="ib-btn ib-btn-outline">Ver proceso <i class="fa-solid fa-arrow-down"></i></a>
        </div>
        <small>Envía modelo, salud de batería y foto del aviso de iOS si aparece.</small>
      </div>
      <aside class="ib-hero-card" aria-label="Revision de bateria iPhone">
        <div class="ib-phone">
          <div class="ib-notch"></div>
          <div class="ib-battery-widget">
            <span>Battery Health</span>
            <strong>74%</strong>
            <div><i style="width:74%"></i></div>
            <em>Servicio recomendado</em>
          </div>
        </div>
        <ul>
          {checks.map((item) => <li><i class="fa-solid fa-circle-check"></i>{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="ib-section ib-light">
    <div class="container">
      <div class="ib-head">
        <span class="ib-eyebrow">Diagnóstico</span>
        <h2>Señales de que tu iPhone necesita revisión de batería</h2>
        <p>No todo apagado es bateria. Revisamos carga, consumo, temperatura y humedad para evitar cambios innecesarios.</p>
      </div>
      <div class="ib-symptom-grid">
        {symptoms.map((item) => (
          <article class="ib-card">
            <i class={`fa-solid ${item.icon}`}></i>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ib-section ib-health">
    <div class="container ib-health-grid">
      <div>
        <span class="ib-eyebrow">Prueba antes de cambiar</span>
        <h2>Cambio de batería iPhone Cancún con revisión de consumo</h2>
        <p>La salud de bateria ayuda, pero no cuenta toda la historia. Medimos comportamiento de carga, temperatura, apagados y estabilidad para confirmar si realmente conviene reemplazarla.</p>
      </div>
      <div class="ib-metrics">
        <div><strong>80%</strong><span>punto comun de revision</span></div>
        <div><strong>1 dia</strong><span>en modelos con pieza disponible</span></div>
        <div><strong>6</strong><span>pruebas antes de entregar</span></div>
      </div>
    </div>
  </section>

  <section class="ib-section ib-light">
    <div class="container">
      <div class="ib-head">
        <span class="ib-eyebrow">Compatibilidad</span>
        <h2>Batería iPhone 11, 12, 13, 14, 15 y 16 en Cancún</h2>
        <p>Atendemos cambio de bateria iPhone en Cancun por modelo exacto. Si tienes un modelo anterior, revisamos disponibilidad antes de cotizar.</p>
      </div>
      <div class="ib-model-grid">
        {models.map((model) => <span><i class="fa-brands fa-apple"></i>{model}</span>)}
      </div>
    </div>
  </section>

  <section class="ib-section ib-process" id="proceso">
    <div class="container">
      <div class="ib-head ib-head-dark">
        <span class="ib-eyebrow">Proceso tecnico</span>
        <h2>Proceso de cambio de batería de iPhone en Cancún</h2>
        <p>Trabajamos con revisión previa, instalación cuidada, adhesivo nuevo cuando aplica y pruebas reales de carga antes de entregar.</p>
      </div>
      <div class="ib-timeline">
        {process.map((step) => (
          <article>
            <span>{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ib-section ib-light">
    <div class="container">
      <div class="ib-head">
        <span class="ib-eyebrow">Opciones reales</span>
        <h2>Que tipo de bateria se instala</h2>
        <p>Confirmamos compatibilidad y disponibilidad por modelo. La prioridad es autonomia estable, carga segura y garantia clara.</p>
      </div>
      <div class="ib-quality-grid">
        {quality.map((item) => (
          <article class="ib-quality">
            <span>{item.badge}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ServiceTicketSection
    defaultDevice="iPhone"
    defaultService="Cambio de batería"
    title="Crear ticket de batería iPhone"
    subtitle="Cuéntanos modelo, salud de batería y síntomas. Te contactaremos para confirmar disponibilidad y cotización."
  />

  <section class="ib-section ib-care">
    <div class="container ib-care-grid">
      <div>
        <span class="ib-eyebrow">Después del servicio</span>
        <h2>No entregamos sin probar carga y autonomía</h2>
        <p>Validamos que el iPhone encienda, cargue estable, no se caliente de forma anormal y mantenga consumo correcto antes de avisarte por WhatsApp.</p>
      </div>
      <a href={`https://wa.me/529986690777?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="ib-btn ib-btn-wa">Agendar revision</a>
    </div>
  </section>

  <section class="ib-contact-shell">
    <ContactSection id="ubicacion" />
  </section>

  <RelatedServicesSection
    category={category}
    service={service}
    eyebrow="Servicios relacionados"
      title="Otros servicios de iPhone que podrías necesitar"
    compact={true}
    includeCategoryServices={true}
    initialLimit={4}
  />

  <FaqSection
    id="faq-bateria-iphone"
    title="Preguntas frecuentes sobre cambio de batería iPhone en Cancún"
    description="Resolvemos dudas sobre precio, salud de batería, tiempos, carga, batería inflada y garantía."
    items={faqItems}
    backgroundColor="#0B1120"
    questionColor="#f8fafc"
    titleColor="#f8fafc"
    descriptionColor="#cfe7f6"
    faqAccent="#3b82f6"
    sectionClass="ib-faq-dark"
  />

  <section class="ib-comments">
    <CommentsSection
      title="Clientes que repararon su iPhone en Pixon PC"
      description="Opiniones de clientes en Cancún que trajeron iPhone con batería degradada, carga inestable o apagados repentinos."
      dark={true}
    />
  </section>
</div>

<style is:global>
.ib-wrapper {
  --ib-dark: #0B1120;
  --ib-dark-2: #0f172a;
  --ib-light: #f8fafc;
  --ib-soft: #eef6ff;
  --ib-blue: #2563eb;
  --ib-cyan: #60a5fa;
  --ib-green: #22c55e;
  --ib-text: #0f2a4a;
  --ib-muted: #475569;
  background: var(--ib-dark);
  color: #f8fafc;
  font-family: 'Inter', 'Kanit', sans-serif;
}
.ib-wrapper h1,
.ib-wrapper h2,
.ib-wrapper h3 { font-family: 'Kanit', sans-serif; line-height: 1.15; letter-spacing: 0; }
.ib-hero { padding: 68px 0 56px; background: radial-gradient(circle at 75% 15%, rgba(59,130,246,.2), transparent 34%), linear-gradient(135deg, #050d1f, #0f172a); }
.ib-hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(320px, .75fr); gap: 44px; align-items: center; }
.ib-eyebrow { display: inline-flex; align-items: center; gap: 8px; color: #93c5fd; font-size: .78rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; margin-bottom: 12px; }
.ib-hero h1 { font-size: clamp(2rem, 4vw, 3.2rem); margin: 0 0 12px; color: #f8fafc; }
.ib-sub { font-size: 1.08rem; color: #dbeafe; max-width: 650px; margin: 0 0 12px; }
.ib-copy { color: #cfe7f6; line-height: 1.65; max-width: 660px; margin: 0 0 18px; }
.ib-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 20px; }
.ib-chips span { border: 1px solid rgba(147,197,253,.22); background: rgba(248,250,252,.06); color: #dbeafe; border-radius: 999px; padding: 8px 12px; font-size: .78rem; font-weight: 750; }
.ib-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 10px; }
.ib-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 16px; border-radius: 12px; text-decoration: none; font-weight: 850; font-size: .9rem; }
.ib-btn-wa { background: #16a34a; color: #f8fafc; box-shadow: 0 14px 34px rgba(22,163,74,.22); }
.ib-btn-outline { border: 1px solid rgba(147,197,253,.28); color: #dbeafe; background: rgba(248,250,252,.06); }
.ib-hero small { color: #93a4bd; display: block; }
.ib-hero-card { background: rgba(248,250,252,.08); border: 1px solid rgba(147,197,253,.18); border-radius: 22px; padding: 18px; box-shadow: 0 28px 60px rgba(2,6,23,.35); }
.ib-phone { width: min(100%, 280px); aspect-ratio: 9 / 16; margin: 0 auto 18px; border: 10px solid #050d1f; border-radius: 34px; background: linear-gradient(160deg, #13213d, #0b1120); position: relative; display: grid; place-items: center; }
.ib-notch { position: absolute; top: 12px; width: 92px; height: 20px; border-radius: 999px; background: #020617; }
.ib-battery-widget { width: 76%; background: rgba(248,250,252,.08); border: 1px solid rgba(147,197,253,.18); border-radius: 18px; padding: 16px; text-align: center; }
.ib-battery-widget span, .ib-battery-widget em { display: block; color: #bfdbfe; font-size: .74rem; font-style: normal; }
.ib-battery-widget strong { display: block; font-size: 2.4rem; color: #f8fafc; margin: 4px 0; }
.ib-battery-widget div { height: 8px; border-radius: 999px; background: rgba(255,255,255,.14); overflow: hidden; margin: 8px 0; }
.ib-battery-widget i { display: block; height: 100%; background: linear-gradient(90deg, #f59e0b, #22c55e); border-radius: inherit; }
.ib-hero-card ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
.ib-hero-card li { color: #dbeafe; font-size: .82rem; display: flex; gap: 7px; align-items: center; }
.ib-hero-card li i { color: #86efac; }
.ib-section { padding: 64px 0; }
.ib-light { background: var(--ib-light); color: var(--ib-text); }
.ib-head { max-width: 820px; margin-bottom: 30px; }
.ib-head h2, .ib-light h2, .ib-light h3 { color: var(--ib-text); margin: 0 0 10px; }
.ib-head p, .ib-light p { color: var(--ib-muted); line-height: 1.65; margin: 0; }
.ib-symptom-grid, .ib-quality-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.ib-card, .ib-quality { background: #fff; border: 1px solid rgba(15,42,74,.12); border-radius: 16px; padding: 20px; box-shadow: 0 14px 32px rgba(15,42,74,.07); }
.ib-card i { width: 42px; height: 42px; border-radius: 12px; background: #eaf3ff; color: var(--ib-blue); display: grid; place-items: center; margin-bottom: 12px; }
.ib-card h3, .ib-quality h3 { font-size: 1rem; margin: 0 0 8px; }
.ib-card p, .ib-quality p { font-size: .9rem; }
.ib-health { background: #eef6ff; color: var(--ib-text); }
.ib-health-grid { display: grid; grid-template-columns: 1fr auto; gap: 30px; align-items: center; }
.ib-health h2, .ib-health p { color: var(--ib-text); }
.ib-health p { color: var(--ib-muted); max-width: 720px; }
.ib-metrics { display: grid; grid-template-columns: repeat(3, 140px); gap: 10px; }
.ib-metrics div { background: #fff; border: 1px solid rgba(15,42,74,.1); border-radius: 16px; padding: 16px; text-align: center; }
.ib-metrics strong { display: block; color: var(--ib-blue); font-size: 1.5rem; }
.ib-metrics span { color: var(--ib-muted); font-size: .76rem; line-height: 1.35; }
.ib-model-grid { display: flex; flex-wrap: wrap; gap: 9px; }
.ib-model-grid span { display: inline-flex; align-items: center; gap: 7px; border: 1px solid rgba(15,42,74,.12); background: #fff; color: var(--ib-text); border-radius: 999px; padding: 8px 12px; font-weight: 750; font-size: .82rem; }
.ib-process { background: var(--ib-dark); }
.ib-head-dark h2 { color: #f8fafc; }
.ib-head-dark p { color: #cfe7f6; }
.ib-timeline { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; }
.ib-timeline article { position: relative; background: rgba(248,250,252,.055); border: 1px solid rgba(147,197,253,.18); border-radius: 16px; padding: 16px; min-height: 190px; }
.ib-timeline span { display: inline-flex; width: 38px; height: 38px; align-items: center; justify-content: center; border-radius: 12px; background: rgba(96,165,250,.14); color: #93c5fd; font-weight: 900; margin-bottom: 14px; }
.ib-timeline h3 { color: #f8fafc; font-size: .95rem; margin: 0 0 8px; }
.ib-timeline p { color: #cfe7f6; font-size: .82rem; line-height: 1.55; margin: 0; }
.ib-quality span { display: inline-flex; color: var(--ib-blue); background: #eaf3ff; border-radius: 999px; padding: 6px 10px; font-size: .74rem; font-weight: 850; margin-bottom: 12px; }
.ib-care { background: #eef6ff; color: var(--ib-text); }
.ib-care-grid { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px; align-items: center; }
.ib-care h2 { color: var(--ib-text); margin: 0 0 10px; }
.ib-care p { color: var(--ib-muted); margin: 0; max-width: 760px; line-height: 1.65; }
.ib-contact-shell, .ib-contact-shell #ubicacion.contact { background: var(--ib-light) !important; }
.ib-contact-shell #ubicacion.contact h2,
.ib-contact-shell #ubicacion.contact h3,
.ib-contact-shell #ubicacion.contact strong { color: var(--ib-text) !important; }
.ib-contact-shell #ubicacion.contact p,
.ib-contact-shell #ubicacion.contact span,
.ib-contact-shell #ubicacion.contact li { color: var(--ib-muted) !important; }
.ib-faq-dark { background: var(--ib-dark) !important; }
.ib-faq-dark .container { max-width: 900px; }
.ib-faq-dark .faq-item,
.ib-faq-dark .faq-item--open { background: rgba(248,250,252,.045) !important; border-color: rgba(147,197,253,.18) !important; box-shadow: none !important; }
.ib-faq-dark .faq-item:hover { background: rgba(59,130,246,.08) !important; border-color: rgba(96,165,250,.42) !important; }
.ib-faq-dark .faq-question,
.ib-faq-dark .faq-question:hover,
.ib-faq-dark .faq-question:focus,
.ib-faq-dark .faq-page-content .faq-item--open .faq-question { background: transparent !important; color: #f8fafc !important; }
.ib-faq-dark .faq-answer-inner { color: #cfe7f6 !important; }
.ib-comments { background: var(--ib-dark); }

@media (max-width: 980px) {
  .ib-hero-grid,
  .ib-health-grid,
  .ib-care-grid { grid-template-columns: 1fr; }
  .ib-symptom-grid,
  .ib-quality-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ib-timeline { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ib-metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media (max-width: 620px) {
  .ib-hero { padding: 48px 0 42px; }
  .ib-symptom-grid,
  .ib-quality-grid,
  .ib-timeline,
  .ib-metrics { grid-template-columns: 1fr; }
  .ib-actions { flex-direction: column; }
  .ib-btn { width: 100%; }
  .ib-hero-card ul { grid-template-columns: 1fr; }
}
</style>
