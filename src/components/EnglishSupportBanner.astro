---
interface Props {
  href?: string;
}

const { href = '/en' } = Astro.props;
---

<aside class="english-support-banner" aria-label="English support for international visitors">
  <div class="container english-support-banner__inner">
    <span class="english-support-banner__icon" aria-hidden="true">
      <i class="fa-solid fa-globe"></i>
    </span>
    <div class="english-support-banner__copy">
      <strong>Visiting Cancun?</strong>
      <span>English support is available with clear written quotes and repair updates.</span>
    </div>
    <a class="english-support-banner__link" href={href}>
      <span class="english-support-banner__link-full">Switch to English</span>
      <span class="english-support-banner__link-short">English <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
    </a>
  </div>
</aside>

<style>
  .english-support-banner {
    --english-support-navy: #071F3A;
    --english-support-cyan: #0ea5c9;
    margin-top: 58px;
    padding: 12px 0;
    background: #edf8fc;
    border-block: 1px solid #b7dfeb;
    color: var(--english-support-navy);
  }

  .english-support-banner__inner {
    display: flex;
    min-height: 48px;
    align-items: center;
    gap: 12px;
  }

  .english-support-banner__icon {
    display: grid;
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 10px;
    color: var(--english-support-navy);
    background: #d5f1f8;
  }

  .english-support-banner__copy {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 1px;
    line-height: 1.35;
  }

  .english-support-banner__copy strong,
  .english-support-banner__copy span {
    color: var(--english-support-navy) !important;
  }

  .english-support-banner__copy strong { font-size: .92rem; }
  .english-support-banner__copy span { font-size: .8rem; }

  .english-support-banner__link {
    display: inline-flex;
    min-height: 44px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    padding: 10px 14px;
    border: 1px solid #82cfe3;
    border-radius: 10px;
    color: var(--english-support-navy) !important;
    background: #fff;
    font-size: .82rem;
    font-weight: 850;
    text-decoration: none;
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  .english-support-banner__link-short { display: none; }
  .english-support-banner__link:focus-visible { outline: 3px solid var(--english-support-cyan); outline-offset: 3px; }

  @media (hover: hover) and (pointer: fine) {
    .english-support-banner__link:hover {
      border-color: var(--english-support-cyan);
      box-shadow: 0 7px 16px rgba(7, 31, 58, .1);
      transform: translateY(-1px);
    }
  }

  @media (max-width: 520px) {
    .english-support-banner { margin-top: 54px; padding: 9px 0; }
    .english-support-banner__inner { gap: 9px; }
    .english-support-banner__icon { width: 31px; height: 31px; border-radius: 9px; }
    .english-support-banner__copy span { display: none; }
    .english-support-banner__link { min-width: 88px; padding-inline: 10px; }
    .english-support-banner__link-full { display: none; }
    .english-support-banner__link-short { display: inline-flex; align-items: center; gap: 6px; }
  }
</style>
