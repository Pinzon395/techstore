---
import { getLocaleFromPath } from '../../lib/i18n';
import { getLocalizedPath } from '../../lib/english-routes';
interface Props {
  showLauncher?: boolean;
}

const { showLauncher = false } = Astro.props;
const lang = getLocaleFromPath(Astro.originPathname);
---

{showLauncher && (
  <button
    class="store-cart-launcher"
    id="store-cart-launcher"
    type="button"
    data-cart-open
    aria-haspopup="dialog"
    aria-controls="store-cart-drawer"
    aria-label="Abrir carrito, 0 artículos"
  >
    <span class="store-cart-launcher-icon" aria-hidden="true"><i class="fa-solid fa-bag-shopping"></i></span>
    <span class="store-cart-launcher-copy"><small>Tu selección</small><strong>Ver carrito</strong></span>
    <span class="store-cart-launcher-count" id="store-cart-launcher-count" aria-hidden="true">0</span>
  </button>
)}

<aside class="store-cart-drawer" id="store-cart-drawer" aria-labelledby="store-cart-title" aria-hidden="true">
  <button class="store-cart-backdrop" type="button" data-cart-close aria-label="Cerrar carrito"></button>
  <section class="store-cart-panel" role="dialog" aria-modal="true">
    <header>
      <div><p>Compra en Pixon PC</p><h2 id="store-cart-title">Tu carrito</h2></div>
      <button type="button" data-cart-close aria-label="Cerrar"><span aria-hidden="true">×</span></button>
    </header>
    <div id="store-cart-drawer-items" class="store-cart-drawer-items"></div>
    <footer>
      <p><span>Subtotal estimado</span><strong id="store-cart-drawer-total">$0.00</strong></p>
      <a class="store-action store-action-primary" href={getLocalizedPath('/carrito', lang)}>{lang === 'en' ? 'Review cart' : 'Revisar carrito'}</a>
      <button class="store-action store-action-secondary" type="button" data-cart-close>Continuar comprando</button>
    </footer>
  </section>
</aside>
<div class="store-toast-region" id="store-toast-region" aria-live="polite" aria-atomic="true"></div>
