---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;

const t = lang === 'en' ? {
  home: 'Home',
  services: 'Services',
  packages: 'Packages',
  gallery: 'Gallery',
  blog: 'Blog',
  reviews: 'Reviews',
  contact: 'Contact',
  b2b: 'B2B',
  laptop: 'Laptop & PC',
  cellphone: 'Cell Phone',
  console: 'Console & Gaming',
  printer: 'Printer & Tablet',
  other: 'Other Services',
  all: 'All Packages',
  faq: 'FAQ',
  catalog: 'Video Catalog',
  antisulfatation: 'Anti-Sulfatation',
  tracking: 'Repair Tracking',
  referidos: 'Referrals',
  warranty: 'Warranty',
  about: 'About Us',
  zones: 'Service Zones',
  english: 'English Service',
  dropdown: {
    repair: 'General Repair',
    optimization: 'System Optimization',
    consoles: 'Console Cleaning',
    maintenance: 'Preventive Maintenance',
    hinges: 'Hinge Repair',
    controllers: 'Controller Repair',
    windows: 'Windows Installation',
    mac: 'Mac Maintenance',
    liquid: 'Liquid Damage Cleaning',
    builds: 'PC Gamer Builds',
  }
} : {
  home: 'Inicio',
  services: 'Servicios',
  packages: 'Paquetes',
  gallery: 'Galería',
  blog: 'Blog',
  reviews: 'Reseñas',
  contact: 'Contacto',
  b2b: 'B2B',
  laptop: 'Laptop y PC',
  cellphone: 'Celulares',
  console: 'Consolas y Gaming',
  printer: 'Impresoras y Tablets',
  other: 'Otros Servicios',
  all: 'Todos los Paquetes',
  faq: 'Preguntas Frecuentes',
  catalog: 'Catálogo de Videos',
  antisulfatation: 'Antisulfatación',
  tracking: 'Seguimiento Reparación',
  referidos: 'Referidos',
  warranty: 'Garantía',
  about: 'Sobre Nosotros',
  zones: 'Zonas de Servicio',
  english: 'English Service',
  dropdown: {
    repair: 'Reparación General',
    optimization: 'Optimización del Sistema',
    consoles: 'Limpieza de Consolas',
    maintenance: 'Mantenimiento Preventivo',
    hinges: 'Reparación Bisagras',
    controllers: 'Reparación Controles',
    windows: 'Instalación de Windows',
    mac: 'Mantenimiento Mac',
    liquid: 'Limpieza por Líquido',
    builds: 'Ensambles PC Gamer',
  }
};
---

<nav class="navbar navbar2" id="navbar">
  <div class="nav-container">
    <a href={lang === 'en' ? '/en' : '/'} class="logo">
      <img src="/assets/logos/Logo.svg?v=2" alt="Pixon PC Logo" style="height:42px;" id="navbar-logo" class="brand-logo">
    </a>
    <div class="menu-toggle" id="mobile-menu">
      <span class="bar bar-dark"></span>
      <span class="bar bar-dark"></span>
      <span class="bar bar-dark"></span>
    </div>
    <ul class="nav-menu" id="nav-menu">
      <li><a href={lang === 'en' ? '/en' : '/'} class="nav-links">{t.home}</a></li>

      <!-- Servicios mega dropdown -->
      <li class="has-dropdown has-mega-menu">
        <a href="#" class="nav-links">{t.services} <i class="fa-solid fa-chevron-down dropdown-arrow"></i></a>
        <div class="mega-menu">
          <div class="mega-grid">
            <div class="mega-col">
              <span class="mega-col-title"><i class="fa-solid fa-laptop"></i> {t.laptop}</span>
              <a href="/reparaciones" class="mega-link">{t.dropdown.repair}</a>
              <a href="/paquetes?section=paquetes" class="mega-link">{t.dropdown.maintenance}</a>
              <a href="/reparacion-bisagras" class="mega-link">{t.dropdown.hinges}</a>
              <a href="/instalacion-windows" class="mega-link">{t.dropdown.windows}</a>
              <a href="/mantenimiento-mac" class="mega-link">{t.dropdown.mac}</a>
              <a href="/limpieza-laptop-liquido" class="mega-link">{t.dropdown.liquid}</a>
              <a href="/optimizacion" class="mega-link">{t.dropdown.optimization}</a>
              <a href="/ensambles" class="mega-link">{t.dropdown.builds}</a>
            </div>
            <div class="mega-col">
              <span class="mega-col-title"><i class="fa-solid fa-mobile-screen-button"></i> {t.cellphone}</span>
              <a href="/reparacion-iphone-cancun" class="mega-link">Reparación iPhone</a>
              <a href="/reparacion-samsung-cancun" class="mega-link">Reparación Samsung</a>
              <a href="/reparaciones?section=celulares" class="mega-link">Reparación Celular</a>
              <a href="/cambio-pantalla-iphone-cancun" class="mega-link">Cambio de Pantalla</a>
              <a href="/cambio-bateria-iphone-cancun" class="mega-link">Cambio de Batería</a>
            </div>
            <div class="mega-col">
              <span class="mega-col-title"><i class="fa-solid fa-gamepad"></i> {t.console}</span>
              <a href="/reparacion-ps5-cancun" class="mega-link">Reparación PS5</a>
              <a href="/reparacion-xbox-cancun" class="mega-link">Reparación Xbox</a>
              <a href="/reparacion-nintendo-switch-cancun" class="mega-link">Reparación Nintendo Switch</a>
              <a href="/reparacion-controles" class="mega-link">{t.dropdown.controllers}</a>
              <a href="/reparaciones?section=consolas" class="mega-link">{t.dropdown.consoles}</a>
            </div>
            <div class="mega-col">
              <span class="mega-col-title"><i class="fa-solid fa-print"></i> {t.printer}</span>
              <a href="/reparacion-impresoras-cancun" class="mega-link">Reparación Impresoras</a>
              <a href="/reparacion-tablets-cancun" class="mega-link">Reparación Tablets</a>
              <a href="/reparacion-audifonos-cancun" class="mega-link">Reparación Audífonos</a>
              <span class="mega-col-title" style="margin-top:12px;"><i class="fa-solid fa-gear"></i> {t.other}</span>
              <a href="/antisulfatacion" class="mega-link">{t.antisulfatation}</a>
              <a href="/recuperacion-datos-cancun" class="mega-link">Recuperación de Datos</a>
              <a href="/diagnostico-antisulfatacion" class="mega-link">Diagnóstico Anti-Sulfatación</a>
            </div>
          </div>
        </div>
      </li>

      <li class="has-dropdown">
        <a href="#" class="nav-links">{t.packages} <i class="fa-solid fa-chevron-down dropdown-arrow"></i></a>
        <ul class="dropdown-menu">
          <li><a href="/paquetes">{t.all}</a></li>
          <li><a href="/paquetes?section=paquetes">{t.dropdown.maintenance}</a></li>
          <li><a href="/optimizacion?section=paquetes-optimizacion">{t.dropdown.optimization}</a></li>
        </ul>
      </li>

      <li><a href="/galeria-trabajos" class="nav-links">{t.gallery}</a></li>

      <li class="has-dropdown">
        <a href="#" class="nav-links">{t.blog} <i class="fa-solid fa-chevron-down dropdown-arrow"></i></a>
        <ul class="dropdown-menu">
          <li><a href="/blog">Blog</a></li>
          <li><a href="/blog/joystick-drift-que-es-y-como-arreglarlo">Joystick Drift</a></li>
          <li><a href="/blog/por-que-tu-laptop-se-calienta-en-cancun">Laptop se calienta en Cancún</a></li>
          <li><a href="/blog/cuanto-cuesta-reparar-iphone-en-mexico-2025">Precios reparación iPhone</a></li>
          <li><a href="/blog/como-saber-si-mi-disco-duro-esta-dañado">¿Disco duro dañado?</a></li>
        </ul>
      </li>

      <li><a href="/comentarios" class="nav-links">{t.reviews}</a></li>
      <li><a href="/contacto" class="nav-links">{t.contact}</a></li>

      <li>
        <a href="/empresas" class="nav-links b2b-btn-premium">
          <i class="fa-solid fa-building-shield"></i> {t.b2b}
        </a>
      </li>
      <li class="nav-auth-mobile-li" id="nav-auth-mobile-li">
        <div id="nav-auth-area-mobile"></div>
      </li>
    </ul>
    <div class="nav-actions">
      <div id="nav-auth-area"></div>
    </div>
  </div>
</nav>

<style>
  /* Mega Menu Styles */
  .navbar2 .has-mega-menu {
    position: static !important;
  }
  .navbar2 .has-mega-menu > a {
    position: relative;
  }
  .navbar2 .mega-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgba(255,255,255,0.98);
    border-bottom: 3px solid #3b82f6;
    box-shadow: 0 16px 48px rgba(0,0,0,0.12);
    z-index: 1000;
    padding: 24px 20px;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .navbar2 .has-mega-menu:hover .mega-menu,
  .navbar2 .has-mega-menu:focus-within .mega-menu {
    display: block;
  }
  .navbar2 .mega-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .navbar2 .mega-col {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .navbar2 .mega-col-title {
    font-size: .8rem;
    font-weight: 800;
    color: #0f172a;
    text-transform: uppercase;
    letter-spacing: .03em;
    padding-bottom: 6px;
    border-bottom: 2px solid #e2e8f0;
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .navbar2 .mega-col-title i {
    color: #3b82f6;
    font-size: .85rem;
  }
  .navbar2 .mega-link {
    font-size: .85rem;
    font-weight: 600;
    color: #475569;
    text-decoration: none;
    padding: 4px 8px;
    border-radius: 6px;
    transition: all .15s ease;
  }
  .navbar2 .mega-link:hover {
    background: #eff6ff;
    color: #2563eb;
    padding-left: 12px;
  }
  @media (max-width: 750px) {
    .navbar2 .mega-menu {
      position: static;
      box-shadow: none;
      border-bottom: none;
      padding: 0 0 0 16px;
      background: transparent;
    }
    .navbar2 .mega-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .navbar2 .has-mega-menu .mega-menu {
      display: none;
    }
    .navbar2 .has-mega-menu.open .mega-menu {
      display: block;
    }
  }
</style>

<script>
  const mobileMenu = document.getElementById('mobile-menu');
  const navMenu = document.querySelector('.nav-menu');

  mobileMenu?.addEventListener('click', () => {
    mobileMenu.classList.toggle('active');
    navMenu?.classList.toggle('active');
  });

  const dropdowns = document.querySelectorAll('.has-dropdown > a');
  dropdowns.forEach((dropdown) => {
    dropdown.addEventListener('click', (e) => {
      if (window.innerWidth <= 750) {
        e.preventDefault();
        const parent = dropdown.parentElement;
        if (parent) {
          parent.classList.toggle('open');
          const menu = parent.querySelector('.dropdown-menu') || parent.querySelector('.mega-menu');
          menu?.classList.toggle('active');
        }
      }
    });
  });

  let lastScroll = 0;
  const navbar = document.getElementById('navbar');

  window.addEventListener('scroll', () => {
    const currentScroll = window.pageYOffset;

    if (currentScroll > 100) {
      navbar?.classList.add('is-scrolled');
    } else {
      navbar?.classList.remove('is-scrolled');
    }

    if (currentScroll > lastScroll && currentScroll > 200) {
      navbar?.classList.add('is-hidden');
    } else {
      navbar?.classList.remove('is-hidden');
    }

    lastScroll = currentScroll;
  });
</script>
