---
import { commercialCopy } from '../lib/business';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLocaleFromPath } from '../lib/i18n';
interface Props {
  lang?: 'es' | 'en';
}

const { lang = getLocaleFromPath(Astro.originPathname) } = Astro.props;

const footerLinks = lang === 'en' ? {
  pages: {
    title: 'English services',
    home: 'Home',
    services: 'Repair services',
    waterDamage: 'Water damage phone repair',
    battery: 'iPhone battery replacement',
    business: 'Business IT support',
    contact: 'Contact Pixon PC',
  },
  legal: {
    title: 'Legal',
    privacy: 'Privacy policy (Spanish)',
    warranty: 'Warranty policy (Spanish)',
    shippingReturns: 'Delivery & warranty (Spanish)',
  },
  social: 'Follow Us',
  description: 'Repair coordination, written quotes and service updates for devices in Cancun.',
  rights: 'Pixon PC. All rights reserved.',
} : {
  pages: {
    title: 'Páginas',
    home: 'Inicio',
    store: 'Tienda',
    packages: 'Paquetes',
    services: 'Servicios',
    repairs: 'Reparaciones',
    windows: 'Instalación Windows',
    business: 'Soporte empresas',
    builds: 'Ensambles',
    reviews: 'Reseñas',
    contact: 'Contacto',
  },
  legal: {
    title: 'Legal',
    privacy: 'Política de Privacidad',
    warranty: 'Política de Garantía',
    shippingReturns: 'Entregas y garantía',
  },
  social: 'Síguenos',
  description: 'Trabajos reales grabados desde el taller. Especialistas en <strong>reparación de computadoras Cancún</strong>.',
  rights: 'Pixon PC. Todos los derechos reservados.',
};

const currentYear = new Date().getFullYear();
---

<footer class="light-footer">
  <div class="container footer-content">
    <div class="footer-logo">
      <a href="/" class="logo text-dark">
        <img src="/assets/logos/Logo.svg" alt="Pixon PC Logo" height="35" class="brand-logo">
      </a>
      <p set:html={footerLinks.description}></p>
      <address class="footer-nap">
        <strong>Pixon PC</strong><br>
        Cto. Hacienda Chimay<br>
        77539 Cancún, Q.R.<br>
        <a href="tel:+529986690777">+52 998 669 0777</a><br>
        <a href="mailto:pixonpc@gmail.com">pixonpc@gmail.com</a>
      </address>
      <div class="footer-legal" aria-label={lang === 'en' ? 'Pixon PC legal and business information' : 'Datos legales y fiscales de Pixon PC'}>
        <p><strong>Pixon PC</strong></p>
        {lang === 'en' ? (
          <>
            <p>RFC / Mexican invoicing is available when requested for an eligible service.</p>
            <p>Cto. Hacienda Chimay, 77539 Cancún, Q.R.</p>
            <p>Independent technical service with appointments coordinated in advance.</p>
            <p>{commercialCopy.en.payment}</p>
            <p data-payment-methods hidden aria-live="polite"></p>
            <p><a href="/politica-de-garantia">Warranty (Spanish)</a> · <a href="/politica-de-envios-y-devoluciones">Delivery & warranty (Spanish)</a> · <a href="/privacidad">Privacy (Spanish)</a></p>
          </>
        ) : (
          <>
            <p>RFC: disponible para facturación CFDI al solicitar el servicio.</p>
            <p>Cto. Hacienda Chimay, 77539 Cancún, Q.R.</p>
            <p>Registro de actividad comercial: servicio técnico independiente con atención mediante cita previa.</p>
            <p>{commercialCopy.es.payment}</p>
            <p data-payment-methods hidden aria-live="polite"></p>
            <p><a href="/politica-de-garantia">Política de garantía</a> · <a href="/politica-de-envios-y-devoluciones">Entregas y garantía</a> · <a href="/privacidad">Privacidad</a></p>
          </>
        )}
      </div>
    </div>
    <div class="footer-links">
      <p style="font-weight:700; font-size:1.1rem; margin-bottom:15px;">{footerLinks.pages.title}</p>
      <ul>
        {lang === 'en' ? (
          <>
            <li><a href="/en">{footerLinks.pages.home}</a></li>
            <li><a href="/en/services">{footerLinks.pages.services}</a></li>
            <li><a href="/en/liquid-damage">{footerLinks.pages.waterDamage}</a></li>
            <li><a href="/en/iphone-battery-replacement">{footerLinks.pages.battery}</a></li>
            <li><a href="/en/business-it-support">{footerLinks.pages.business}</a></li>
            <li><a href="/en/contact">{footerLinks.pages.contact}</a></li>
          </>
        ) : (
          <>
            <li><a href="/">{footerLinks.pages.home}</a></li>
            <li><a href="/tienda">{footerLinks.pages.store}</a></li>
            <li><a href="/servicios">{footerLinks.pages.services}</a></li>
            <li><a href="/reparaciones">{footerLinks.pages.repairs}</a></li>
            <li><a href="/instalacion-windows">{footerLinks.pages.windows}</a></li>
            <li><a href="/empresas">{footerLinks.pages.business}</a></li>
            <li><a href="/paquetes">{footerLinks.pages.packages}</a></li>
            <li><a href="/ensambles">{footerLinks.pages.builds}</a></li>
            <li><a href="/comentarios">{footerLinks.pages.reviews}</a></li>
            <li><a href="/contacto">{footerLinks.pages.contact}</a></li>
          </>
        )}
      </ul>
    </div>
    <div class="footer-links">
      <p style="font-weight:700; font-size:1.1rem; margin-bottom:15px;">{footerLinks.legal.title}</p>
      <ul>
        <li><a href="/privacidad">{footerLinks.legal.privacy}</a></li>
        <li><a href="/politica-de-garantia">{footerLinks.legal.warranty}</a></li>
        <li><a href="/politica-de-envios-y-devoluciones">{footerLinks.legal.shippingReturns}</a></li>
      </ul>
    </div>
    <div class="footer-social">
      <p style="font-weight:700; font-size:1.1rem; margin-bottom:15px;">{footerLinks.social}</p>
      <div class="social-icons">
        <a href="https://wa.me/529986690777" title="WhatsApp Pixon PC">
          <i class="fa-brands fa-whatsapp"></i>
        </a>
        <a href="https://www.facebook.com/people/Pixon-PC/61556271364935/" aria-label="Facebook Pixon PC" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-facebook-f"></i>
        </a>
        <a href="https://www.instagram.com/pixonpc/" aria-label="Instagram Pixon PC" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-instagram"></i>
        </a>
        <a href="https://www.tiktok.com/@pixonpc" aria-label="TikTok Pixon PC" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-tiktok"></i>
        </a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <LanguageSwitcher />
    <p>&copy; {currentYear} {footerLinks.rights} |
      <a href="/privacidad" style="color:var(--text-muted); text-decoration: underline;">{footerLinks.legal.privacy}</a> ·
      <a href="/politica-de-garantia" style="color:var(--text-muted); text-decoration: underline;">{footerLinks.legal.warranty}</a>
      · <a href="/politica-de-envios-y-devoluciones" style="color:var(--text-muted); text-decoration: underline;">{footerLinks.legal.shippingReturns}</a>
    </p>
  </div>
</footer>


<div id="specialty-overlay" style="position:fixed; inset:0; background:rgba(15,23,42,0.7); backdrop-filter:blur(4px); z-index:9000; opacity:0; pointer-events:none; transition:opacity 0.3s ease;"></div>
