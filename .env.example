# Pixon PC - variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# .env nunca debe subirse a Git.

# Servidor
NODE_ENV=development
PORT=3000

# Sesiones
# Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Google OAuth
# Debe terminar en .apps.googleusercontent.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/auth/google/callback

# Email que recibira rol admin al hacer login con Google
ADMIN_EMAIL=

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pixon_app
DB_PASSWORD=cambia_esta_password
DB_NAME=pixon_db

# Google Places API
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
