# Pixon PC - variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# .env nunca debe subirse a Git.

# Servidor
NODE_ENV=development
PORT=3000

# Persistencia. En VPS deben apuntar a /opt/pixon/shared/data (fuera de releases).
# Si se omiten localmente se conserva server/storage/.
DATA_DIR=
MEDIA_DIR=
UPLOAD_DIR=
CACHE_DIR=
BACKUP_DIR=
TEMP_DIR=
BACKUP_RETENTION_DAYS=95

# Sesiones
# Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Google OAuth
# Debe terminar en .apps.googleusercontent.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/auth/google/callback

# Email que recibira rol admin al hacer login con Google
ADMIN_EMAIL=

# Correos transaccionales de tickets (Resend)
# Crea una API key en Resend y verifica el dominio/correo remitente.
RESEND_API_KEY=
EMAIL_FROM="Pixon PC <tickets@pixon.com.mx>"
EMAIL_REPLY_TO=pixonpc@gmail.com
NOTIFICATION_EMAIL=pixonpc@gmail.com
PUBLIC_SITE_URL=https://pixon.com.mx

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pixon_app
DB_PASSWORD=
DB_NAME=pixon_db
DB_BACKUP_KEY=
# Solo para rotar respaldos existentes; no es necesaria en operación normal.
DB_BACKUP_OLD_KEY=
# Preflight de migraciones (opcionales; estos son los valores predeterminados)
DB_MIGRATION_BACKUP_MAX_AGE_HOURS=24
DB_MIGRATION_LOCK_TIMEOUT_SECONDS=30
COMMERCE_MEDIA_MAX_BYTES=8388608
COMMERCE_PROOF_MAX_BYTES=10485760

# Proveedores de pago externos (opcionales). Mantener vacíos hasta configurar
# cuentas reales y webhooks. Las claves nunca se envían al navegador.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# SANDBOX o LIVE
PAYPAL_MODE=SANDBOX
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Solo para ejecutar el E2E Commerce contra una instancia local/testing.
COMMERCE_E2E_BASE_URL=http://127.0.0.1:3017

# Google Business Profile API — reseñas reales sincronizadas (ver
# server/modules/reviews/). Usa GOOGLE_CLIENT_ID/SECRET de arriba (mismo
# proyecto de Google Cloud), pero requiere consentimiento OAuth aparte con
# scope business.manage: un admin lo autoriza desde /admin → Comentarios.
# BLOQUEADOR EXTERNO: la Business Profile API requiere aprobación de acceso
# de Google (solicitud aparte, no basta con habilitarla en Cloud Console).
# Sin esto configurado, el código queda listo pero inactivo (GOOGLE_EXTERNAL_REQUIRED).
GOOGLE_REVIEWS_OAUTH_CALLBACK_URL=
# accountId y locationId se obtienen llamando accounts.list /
# accounts.locations.list una vez autorizado el OAuth (o desde el propio
# Business Profile). Formato: "accounts/123..." y "locations/456...".
GOOGLE_REVIEWS_ACCOUNT_ID=
GOOGLE_REVIEWS_LOCATION_ID=
# Reconciliación de respaldo (Pub/Sub es el evento principal). Mínimo 1h.
GOOGLE_REVIEWS_SYNC_INTERVAL_HOURS=12
# Token compartido para verificar POST /api/reviews/pubsub (push de Cloud
# Pub/Sub). Genera uno con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# y configúralo como query param (?token=...) en la suscripción push de GCP.
GOOGLE_REVIEWS_PUBSUB_TOKEN=

# PricesAPI para el armador de PC (/ensambles)
# Nunca expongas esta llave en el navegador.
PRICEAPI_KEY=
# Alias compatible para instalaciones antiguas; usar solo una de las dos.
PRICESAPI_KEY=
PC_PRICE_CACHE_HOURS=24
PC_PRICE_REFRESH_LIMIT=6
PC_PRICE_AUTO_REFRESH=true

# Monitor legado local (systemd reemplaza su reinicio/backup en el VPS).
MONITOR_URL=
WHATSAPP_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Solo pruebas aisladas; nunca apuntar a la base de produccion.
PIXON_TEST_DB=
PIXON_TEST_DESTRUCTIVE=0
PIXON_E2E_ALLOW=0
