# ─── Pixon PC — Variables de entorno ─────────────────────────────────────
# Copia este archivo como .env y rellena los valores reales.
# El archivo .env NO debe subirse a git (ver .gitignore).

# ── Servidor ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Sesiones ───────────────────────────────────────────────────────────
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ── Google OAuth ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Email del administrador (recibe rol 'admin' al hacer login)
ADMIN_EMAIL=

# ── MariaDB (nuevo) ────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pixon_app
DB_PASSWORD=
DB_NAME=pixon
