# Pixon PC - variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# .env nunca debe subirse a Git.

# Servidor
NODE_ENV=development
PORT=3000

# Sesiones
# Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Google OAuth
# Debe terminar en .apps.googleusercontent.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/auth/google/callback

# Email que recibira rol admin al hacer login con Google
ADMIN_EMAIL=

# Correos transaccionales de tickets (Resend)
# Crea una API key en Resend y verifica el dominio/correo remitente.
RESEND_API_KEY=
EMAIL_FROM="Pixon PC <tickets@pixon.com.mx>"
EMAIL_REPLY_TO=pixonpc@gmail.com
NOTIFICATION_EMAIL=pixonpc@gmail.com
PUBLIC_SITE_URL=https://pixon.com.mx

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pixon_app
DB_PASSWORD=
DB_NAME=pixon_db
DB_BACKUP_KEY=
# Solo para rotar respaldos existentes; no es necesaria en operación normal.
DB_BACKUP_OLD_KEY=
# Preflight de migraciones (opcionales; estos son los valores predeterminados)
DB_MIGRATION_BACKUP_MAX_AGE_HOURS=24
DB_MIGRATION_LOCK_TIMEOUT_SECONDS=30
COMMERCE_MEDIA_MAX_BYTES=8388608
COMMERCE_PROOF_MAX_BYTES=10485760

# Proveedores de pago externos (opcionales). Mantener vacíos hasta configurar
# cuentas reales y webhooks. Las claves nunca se envían al navegador.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# SANDBOX o LIVE
PAYPAL_MODE=SANDBOX
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Solo para ejecutar el E2E Commerce contra una instancia local/testing.
COMMERCE_E2E_BASE_URL=http://127.0.0.1:3017

# Google Places API
# Habilita Places API (New) y restringe la clave al servidor. GOOGLE_PLACE_ID
# es opcional: si queda vacío, el servidor buscará la ficha de Pixon PC por nombre y dirección.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# PricesAPI para el armador de PC (/ensambles)
# Nunca expongas esta llave en el navegador.
PRICEAPI_KEY=
PC_PRICE_CACHE_HOURS=24
PC_PRICE_REFRESH_LIMIT=6
PC_PRICE_AUTO_REFRESH=true
