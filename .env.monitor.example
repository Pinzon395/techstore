# ============================================================
# Configuración del Monitor de Servidor
# ============================================================
#
# Copia este contenido a tu archivo .env y configura los valores
#
# ============================================================

# URL que monitoreará el monitor
MONITOR_URL=http://localhost:3001

# ============================================================
# ALERTAS - Telegram (recomendado)
# ============================================================
# Para obtener el Bot Token:
# 1. Abre @BotFather en Telegram
# 2. Crea un nuevo bot con /newbot
# 3. Copia el token que te da
# 4. Para obtener el Chat ID:
#    - Abre @userinfobot yenvíale un mensaje
#    - Te dará tu Chat ID

TELEGRAM_BOT_TOKEN=TU_BOT_TOKEN_AQUI
TELEGRAM_CHAT_ID=TU_CHAT_ID_AQUI

# ============================================================
# ALERTAS - WhatsApp (alternativa)
# ============================================================
# Webhook de WhatsApp (Twilio, Ultramsg, etc.)
WHATSAPP_WEBHOOK=

# ============================================================
# BACKUP AUTOMÁTICO
# ============================================================
# Los backups se guardan en: /backups/db/
# Se mantienen los últimos 7 días
# No necesitas configurar nada extra si ya tienes DB en .env